// Payment routing and third-party mechanics (L. 832-1/2/4, L. 842-1/2,
// R. 823-8, L. 823-7): who receives the aid, landlord deduction, information
// and excess duties, L. 824-3 resumption, monthly payment, and the payment
// threshold selector. The monetary terminal stays fr.apl.versement (it reads
// aide_mensuelle/aide_non_versee); this module routes and qualifies.
// CLOSES B-APL-TIERS-PAYANT (09): the landlord channel is now pinned law.
// The regulatory direct-payment cases (L. 832-1 last sentence) are unpinned:
// routing there reads an established case finding (boundary).

language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

