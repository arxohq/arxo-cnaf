@id("urn:fr:corpus:clir:apl#ARR_ART34_ED2023_10")
pub fragment ARR_ART34_ED2023_10 in ARRETE_ED2023_10 {
    kind article;
    locator "article/34";
    text fr official """Article 34
Les montants forfaitaires au titre des charges visés au 4° de l'article D. 842-6 du même code sont fixés comme suit (en euros) :
Désignation | Toutes zones
Bénéficiaire isolé ou couple sans personne à charge | 58,08
Par personne supplémentaire à charge | 13,17
""";
    content_hash "sha256:8c27c1c9baf3b4d97510b92cbab98ff7fce76d27ec461792933e3b3960311e5d";
}

@id("urn:fr:corpus:clir:apl#ARR_ART35_ED2023_10")
