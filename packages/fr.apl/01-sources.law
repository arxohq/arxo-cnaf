// Провенанс §194: три источника расчёта APL в секторе найма и ДВЕ редакции
// барема. Блок фрагментов ниже порождается
// corpus/tools/sources/sync/sync_fr_apl_fragments.py из закреплённых байтов
// sources/fr-apl/legi/**/*.xml (открытые данные LEGI, DILA). Руками не править.
//
// Почему редакций ТРИ. Значения барема живут не в кодексе, а в арретэ, и
// каждая статья арретэ имеет СВОЁ окно действия: NOTA самого арретэ говорит
// «applicables aux prestations dues à compter du …». Окно редакции пакета —
// пересечение окон всех её статей: ED2021 сужена до 01.01.2022 потому, что
// версия ст. 15 (R0) этой редакции начинается 1 января 2022 года.
//
// У редакции 2025 года окно версии и окно применимости РАЗОШЛИСЬ: LEGI
// датирует версии статей 10 сентября 2025 года (день вступления изменяющего
// арретэ от 5 сентября 2025 года), а NOTA каждой из них говорит «applicables
// aux prestations dues à compter du 1er octobre 2025». Барем живёт по второй
// дате: месяц права выбирает значение. Первую хранит `articles.json`
// (`in_force_from`), вторую — он же (`applies_from`), и обе разобраны из
// закреплённых байтов, а не проставлены руками.

language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

@id("urn:fr:source:cch")
source CCH {
    kind code;
    jurisdiction FR;
    label fr official "Code de la construction et de l'habitation";
    label ru unofficial "Кодекс строительства и жилища Франции";
}

@id("urn:fr:source:arrete-2019-09-27")
source ARRETE_2019_09_27 {
    kind order;
    jurisdiction FR;
    number "LOGL1925404A";
    label fr official "Arrêté du 27 septembre 2019 relatif au calcul des aides personnelles au logement et de la prime de déménagement";
    label ru unofficial "Приказ от 27 сентября 2019 года о расчёте персональных жилищных пособий и премии за переезд";
}

@id("urn:fr:source:ordonnance-96-50")
source ORDONNANCE_96_50 {
    kind order;
    jurisdiction FR;
    number "96-50";
    label fr official "Ordonnance n° 96-50 du 24 janvier 1996 relative au remboursement de la dette sociale";
    label ru unofficial "Ордонанс № 96-50 от 24 января 1996 года о погашении социального долга (CRDS)";
}

@id("urn:fr:source:cgct")
source CGCT {
    kind code;
    jurisdiction FR;
    label fr official "Code général des collectivités territoriales";
    label ru unofficial "Общий кодекс территориальных коллективов (CGCT): компетенции Сен-Пьер-и-Микелона";
}

@id("urn:fr:source:decret-2021-1750")
source DECRET_2021_1750 {
    kind decree;
    jurisdiction FR;
    number "2021-1750";
    label fr official "Décret n° 2021-1750 du 21 décembre 2021 portant diverses mesures sur les aides personnelles au logement et relatif aux aides personnelles au logement à Saint-Pierre-et-Miquelon";
    label ru unofficial "Декрет № 2021-1750 от 21 декабря 2021 года о мерах по аидам на жильё и об аидах на жильё в Сен-Пьер-и-Микелоне: ст. 7 — «монтаж» ALspm = ALt × (1 − (2026 − n)/8)";
}

@id("urn:fr:source:decret-2025-1401")
source DECRET_2025_1401 {
    kind decree;
    jurisdiction FR;
    number "2025-1401";
    label fr official "Décret n° 2025-1401 du 28 décembre 2025 relatif au calcul des aides personnelles au logement pour l'année 2026";
    label ru unofficial "Декрет № 2025-1401 от 28 декабря 2025 года о расчёте аид на жильё на 2026 год: дерогация, отменяющая ежегодную переоценку R0";
}

// D-42 FINISH family-housing: CSS L. 542-9, D. 542-35..40 and L. 755-21-1
// (home-improvement loans, module 23). One edition: the latest pinned version
// starts 1 July 2021 (D. 542-35); L. 755-21-1 comes from increment
// LEGI_20260723-224400, the other seven from the global dump.
source CSS {
    kind code;
    jurisdiction FR;
    label fr official "Code de la sécurité sociale";
    label ru unofficial "Кодекс социального обеспечения Франции";
}

// Состояние кодекса ДО 1 сентября 2019 года: отменённые декретом, который
// создал D. 832-25, статьи R. 351-61 и R. 351-61-1 — единственная ТЕКСТОВАЯ
// форма алгебры коэффициента K (в D. 832-25 формула — картинка, README пакета,
// «Коэффициент K»). Окно встык примыкает к CCH_ED2019_09.
edition CCH_ED2006_01 of CCH {
    language fr;
    officiality official;
    materialization_status PINNED_UNOFFICIAL_COPY;
    in_force [@2006-01-01, @2019-09-01);
    label fr official "Code de la construction et de l'habitation, articles R. 351-61 et R. 351-61-1 abrogés le 1er septembre 2019, état en vigueur du 1er janvier 2006 au 1er septembre 2019";
    label ru unofficial "Кодекс строительства и жилья: отменённые R. 351-61 и R. 351-61-1, состояние с 1 января 2006 года по 1 сентября 2019 года";
}

// Кодексная часть расчёта не менялась в окне обеих редакций барема: последняя
// затронутая версия — D. 823-17 с 1 января 2021 года.
@id("urn:fr:source:cch:2021-01-01:fr")
@id("urn:fr:source:arrete-2019-09-27:2020-10-01:fr")
edition CCH_ED2019_09 of CCH {
    language fr;
    officiality official;
    materialization_status PINNED_UNOFFICIAL_COPY;
