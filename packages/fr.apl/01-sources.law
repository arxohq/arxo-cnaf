@id("urn:fr:corpus:clir:apl#ARR_ART43_ED2022_01")
pub fragment ARR_ART43_ED2022_01 in ARRETE_ED2022_01 {
    kind article;
    locator "article/43";
    text fr official """Article 43
L'équivalence de loyer L pour chacune des catégories de personnes mentionnées à l'article D. 842-16 du même code est égal à : 1° Pour les étudiants logés en chambre : a) 84,14 euros lorsqu'il s'agit d'une personne seule ; b) 131,00 euros lorsqu'il s'agit d'un couple ; 2° Pour les étudiants logés dans une chambre ayant fait l'objet d'une réhabilitation : a) 170,12 euros lorsqu'il s'agit d'une personne seule ; b) 264,40 euros lorsqu'il s'agit d'un couple ; 3° Pour les personnes mentionnées au 3° : a) 206,40 euros lorsqu'il s'agit d'une personne seule ; b) 320,73 euros lorsqu'il s'agit d'un couple ; 4° Pour les autres personnes : a) 170,12 euros lorsqu'il s'agit d'une personne seule ; b) 264,40 euros lorsqu'il s'agit d'un couple.
""";
    content_hash "sha256:5c7002409200ffa724cae058cdc20fd26dcf4dcabf4f5573d648eafa56081391";
}

@id("urn:fr:corpus:clir:apl#ARR_ART44_ED2022_01")
