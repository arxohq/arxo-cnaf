// ============================================================================
// КОЭФФИЦИЕНТ K И КОНЕЧНАЯ СУММА СЕКТОРА (08.10.2026, сессия 7)
// ============================================================================
//
// ИСТОЧНИК АЛГЕБРЫ K. Текст D. 832-25 (1° и 2°) в открытых данных LEGI отдаёт
// формулу картинкой (`<p class="cliche">`: «Vous pouvez consulter l'intégralité
// du texte avec ses images…»), поэтому алгебраическая форма берётся из
// ПРЕДШЕСТВУЮЩИХ статей того же кодекса, которые отменил 1 сентября 2019 года тот
// же декрет (JORFTEXT000038812273), создавший D. 832-25, и чей текст в
// глобальном дампе ЕСТЬ (закреплён: `CCH_R351_61`, `CCH_R351_61_1`,
// sources/fr-apl/cch-ante-2019-09.txt):
//
//   R. 351-61   — «K = 0,95-((R-(r X N))/ (CM X N))», K «au plus égal à 0,95»,
//                 «arrondi à deux décimales par défaut» — общий случай, то есть 1°
//                 D. 832-25 (те же R, r, cm, N и та же таблица N: 1,40/1,80/2,50/3/
//                 3,7/4,3, +0,50);
//   R. 351-61-1 — «K = 0,9-(R/ (CM X N))», N = 1,2/1,5/2,5/3/3,7/4,3, +0,5 —
//                 фойе молодых работников и социальные резиденции, то есть 2° D. 832-25.
//
// ЭТО ЧТЕНИЕ, А НЕ ЦИТАТА D. 832-25: тождество формулы картинки и формулы
// отменённой статьи пакет не может проверить по байтам картинки. Его держат три
// независимых свидетельства: (1) набор переменных, их определения и обе таблицы N
// статьи D. 832-25 совпадают с R. 351-61 и R. 351-61-1; (2) ВСЕ ШЕСТЬ значений K,
// которые называют дела Catala (0,41, 0,64, 0,64 и 0,60 для APL; 0,60 и 0,43 для
// аллокаций), воспроизводятся этой алгеброй на значениях r и cm, закреплённых
// ст. 30 арретэ; (3) код OpenFisca-France (`aides_logement_foyer_k_apl` и
// `_k_al`) считает ту же алгебру. Ни одно из трёх не доказательство, все три —
// основание держать чтение рабочим; граница названа в README пакета
// («Коэффициент K»).
//
// ОКРУГЛЕНИЕ. «Arrondi à deux décimales par défaut» (D. 832-25, a) обоих пунктов) —
// K = ⌊(плафон − q) × 100⌋ / 100 при q = (R − r×N)/(cm×N) либо R/(cm×N); так как
// плафон кратен 0,01, это ровно «плафон − q, округлённое ВВЕРХ до сотой»:
// `div_round(…, 2, "CEILING")`. Плафон (0,95 либо 0,90) закреплён тем же
// D. 832-25 как «considéré égal à», и тот же параметр служит константой формулы
// (оба текста называют одно число).
//
// ПОЛА У K НЕТ. Текст не называет нижнюю границу K; при очень больших ресурсах
// расчёт даёт K < 0, и ничего не дописывается. Выплату в таком случае решают
// арифметика и порог ниже (ст. 29 и 42 арретэ), а не молчаливый пол.
//
// АЛЛОКАЦИИ. D. 842-15 2° отсылает к «2° de l'article D. 832-25» БЕЗУСЛОВНО,
// поэтому K аллокаций — ВСЕГДА формула 2° (потолок 0,90, cm второго абзаца,
// таблица N 1,2/1,5/…), независимо от типа фойе.
//
// КОНЕЧНАЯ СУММА (D. 832-24 и D. 842-15): формула → форфейтная минорация
// (ст. 28 и 41 арретэ) → абатмент минимума чистого расхода (D. 832-27 и
// D. 842-17) → [аллокации: не больше redevance] → «montant représentatif des
// contributions sociales» (тот же шаг D. 823-16, функция
// `contributions_selon_territoire`) → порог выплаты (ст. 29 и 42 арретэ, «avant
// application de la contribution» — то же чтение, что у ст. 12 в секторе найма:
// порог сравнивается с результатом шага взносов).
// Выход — `aide_theorique` / `aide_non_versee`, то есть те же головы, что у
// сектора найма: `aide_mensuelle` и стадия CRDS (26-precompte-crds.law) общие.

function ratio_k_par_exces(numerateur: Money, denominateur: Money) -> Decimal =
    div_round(numerateur, denominateur, 2, "CEILING");

function coefficient_k_general(ressources: Money, parts: Decimal) -> Decimal {
    let plafond: Decimal = PlafondCoefficientPriseEnChargeGeneral;
    let calcule: Decimal = plafond - ratio_k_par_exces(
        ressources - CoefficientRFoyer * parts,
        CoefMultiplicateurFoyerGeneral * parts);
    return min(plafond, calcule);
}

function coefficient_k_jeunes_travailleurs(ressources: Money, parts: Decimal) -> Decimal {
    let plafond: Decimal = PlafondCoefficientPriseEnChargeJeunesTravailleurs;
    let calcule: Decimal = plafond - ratio_k_par_exces(
        ressources,
        CoefMultiplicateurFoyerJeunesTravailleurs * parts);
    return min(plafond, calcule);
}

function minoration_forfaitaire_foyer(type_aide: TypeAide) -> Money = match type_aide {
    APL => MinorationForfaitaireFoyerAPL;
    ALF => MinorationForfaitaireFoyerAL;
    ALS => MinorationForfaitaireFoyerAL;
};

function seuil_versement_foyer(type_aide: TypeAide) -> Money = match type_aide {
    APL => SeuilVersementFoyerAPL;
    ALF => SeuilVersementFoyerAL;
    ALS => SeuilVersementFoyerAL;
};

// «Lorsque cette dépense nette … est inférieure à un montant fixé par arrêté,
// l'abattement … est égal à la différence constatée»: dépense nette = base −
// aide (base = E pour APL, L + C pour аллокации), абатмент = max(0, минимум −
// dépense nette).
function aide_apres_abattement_depense_nette(aide: Money, base: Money, minimum: Money) -> Money =
    aide - max(0 EUR, minimum - (base - aide));

pub relation coefficient_prise_en_charge(m: Menage, k: Decimal) kind institutional {
    key(m);
    label fr official "K : coefficient de prise en charge, arrondi à deux décimales par défaut et plafonné";
    label ru unofficial "K: коэффициент покрытия, округлённый до сотых вниз и ограниченный потолком";
}

pub relation aide_foyer_formule(m: Menage, montant: Money) kind institutional {
    key(m);
    label fr official "Af : aide mensuelle issue de la formule de calcul en logement-foyer";
    label ru unofficial "Af: пособие по формуле в logement-foyer";
}

relation aide_foyer_apres_minoration(m: Menage, montant: Money) kind institutional {
    key(m);
    label fr official "aide en logement-foyer après minoration forfaitaire";
    label ru unofficial "пособие в logement-foyer после форфейтной минорации";
}

relation aide_foyer_apres_depense_nette(m: Menage, montant: Money) kind institutional {
    key(m);
    label fr official "aide en logement-foyer après abattement au titre de la dépense nette minimale";
    label ru unofficial "пособие в logement-foyer после абатмента минимума чистого расхода";
}

relation aide_foyer_rapportee_redevance(m: Menage, montant: Money) kind institutional {
    key(m);
    label fr official "allocation en logement-foyer rapportée, si elle la dépasse, au montant de la redevance";
    label ru unofficial "аллокация в logement-foyer, ограниченная redevance";
}

relation aide_foyer_apres_contributions(m: Menage, montant: Money) kind institutional {
    key(m);
    label fr official "aide en logement-foyer après le montant représentatif des contributions sociales";
    label ru unofficial "пособие в logement-foyer после представительной суммы взносов";
}

@source(CCH_D832_25, CCH_D832_25_ED2019_12, CCH_D832_25_ED2020_01,
        CCH_D832_25_ED2021_01, CCH_D832_25_ED2023_04, CCH_D832_25_ED2023_09,
        CCH_D832_25_ED2023_12, CCH_D832_25_ED2026_07, CCH_D842_15,
        CCH_D842_15_ED2019_12, CCH_D842_15_ED2020_01, CCH_D842_15_ED2021_01,
        CCH_D842_15_ED2023_04, CCH_D842_15_ED2023_09, CCH_D842_15_ED2023_12,
        CCH_D842_15_ED2026_07)
rule NombrePartsAllocationALF(m: Menage, situation: SituationFamiliale, pac: Integer) strict {
    label fr official "N représente le nombre de parts déterminé selon le barème du 2° (K des allocations: 2° de l'article D. 832-25)";
    label ru unofficial "N аллокаций (ALF): таблица 2° ст. D. 832-25 (на неё отсылает D. 842-15)";
    when secteur_logement_foyer(m) and aide_demandee(m, ALF)
        and situation_familiale(m, situation) and personnes_a_charge(m, pac);
    then nombre_parts(m, parts_jeunes_travailleurs(situation, pac));
}

@source(CCH_D832_25, CCH_D832_25_ED2019_12, CCH_D832_25_ED2020_01,
        CCH_D832_25_ED2021_01, CCH_D832_25_ED2023_04, CCH_D832_25_ED2023_09,
        CCH_D832_25_ED2023_12, CCH_D832_25_ED2026_07, CCH_D842_15,
        CCH_D842_15_ED2019_12, CCH_D842_15_ED2020_01, CCH_D842_15_ED2021_01,
        CCH_D842_15_ED2023_04, CCH_D842_15_ED2023_09, CCH_D842_15_ED2023_12,
        CCH_D842_15_ED2026_07)
rule NombrePartsAllocationALS(m: Menage, situation: SituationFamiliale, pac: Integer) strict {
    label fr official "N représente le nombre de parts déterminé selon le barème du 2° (K des allocations: 2° de l'article D. 832-25)";
    label ru unofficial "N аллокаций (ALS): таблица 2° ст. D. 832-25 (на неё отсылает D. 842-15)";
    when secteur_logement_foyer(m) and aide_demandee(m, ALS)
        and situation_familiale(m, situation) and personnes_a_charge(m, pac);
    then nombre_parts(m, parts_jeunes_travailleurs(situation, pac));
}

@source(CCH_D832_25, CCH_D832_25_ED2019_12, CCH_D832_25_ED2020_01,
        CCH_D832_25_ED2021_01, CCH_D832_25_ED2023_04, CCH_D832_25_ED2023_09,
        CCH_D832_25_ED2023_12, CCH_D832_25_ED2026_07, CCH_R351_61,
        ARR_ART30_ED2019_10, ARR_ART30_ED2020_01, ARR_ART30_ED2020_10,
        ARR_ART30_ED2021_01, ARR_ART30_ED2021_10, ARR_ART30_ED2022_01,
        ARR_ART30_ED2022_07, ARR_ART30_ED2023_01, ARR_ART30_ED2023_10,
        ARR_ART30_ED2024_01, ARR_ART30_ED2024_10, ARR_ART30_ED2025_01,
        ARR_ART30_ED2025_10, ARR_ART30_ED2026_10)
rule CoefficientPriseEnChargeAPLGeneral(m: Menage, parts: Decimal, ressources: Money) strict {
    label fr official "K = 0,95 − (R − r × N) / (cm × N), arrondi à deux décimales par défaut, au plus égal à 0,95 (1° de l'article D. 832-25)";
    label ru unofficial "K APL фойе, общий случай (1°): 0,95 − (R − r·N)/(cm·N), вниз до сотых, не выше 0,95";
    when secteur_logement_foyer(m) and aide_demandee(m, APL)
        and type_logement_foyer(m, GENERAL)
        and nombre_parts(m, parts) and ressources_retenues(m, ressources);
    then coefficient_prise_en_charge(m, coefficient_k_general(ressources, parts));
}

@source(CCH_D832_25, CCH_D832_25_ED2019_12, CCH_D832_25_ED2020_01,
        CCH_D832_25_ED2021_01, CCH_D832_25_ED2023_04, CCH_D832_25_ED2023_09,
        CCH_D832_25_ED2023_12, CCH_D832_25_ED2026_07, CCH_R351_61_1,
        ARR_ART30_ED2019_10, ARR_ART30_ED2020_01, ARR_ART30_ED2020_10,
        ARR_ART30_ED2021_01, ARR_ART30_ED2021_10, ARR_ART30_ED2022_01,
        ARR_ART30_ED2022_07, ARR_ART30_ED2023_01, ARR_ART30_ED2023_10,
        ARR_ART30_ED2024_01, ARR_ART30_ED2024_10, ARR_ART30_ED2025_01,
        ARR_ART30_ED2025_10, ARR_ART30_ED2026_10)
rule CoefficientPriseEnChargeAPLJeunesTravailleurs(m: Menage, parts: Decimal, ressources: Money) strict {
    label fr official "K = 0,90 − R / (cm × N), arrondi à deux décimales par défaut, au plus égal à 0,90 (2° de l'article D. 832-25)";
    label ru unofficial "K APL фойе молодых работников и социальных резиденций (2°): 0,90 − R/(cm·N), вниз до сотых, не выше 0,90";
    when secteur_logement_foyer(m) and aide_demandee(m, APL)
        and type_logement_foyer(m, JEUNES_TRAVAILLEURS_OU_RESIDENCE_SOCIALE)
        and nombre_parts(m, parts) and ressources_retenues(m, ressources);
    then coefficient_prise_en_charge(m, coefficient_k_jeunes_travailleurs(ressources, parts));
}

@source(CCH_D842_15, CCH_D842_15_ED2019_12, CCH_D842_15_ED2020_01,
        CCH_D842_15_ED2021_01, CCH_D842_15_ED2023_04, CCH_D842_15_ED2023_09,
        CCH_D842_15_ED2023_12, CCH_D842_15_ED2026_07, CCH_D832_25,
        CCH_D832_25_ED2019_12, CCH_D832_25_ED2020_01, CCH_D832_25_ED2021_01,
        CCH_D832_25_ED2023_04, CCH_D832_25_ED2023_09, CCH_D832_25_ED2023_12,
        CCH_D832_25_ED2026_07, CCH_R351_61_1, ARR_ART30_ED2019_10,
        ARR_ART30_ED2020_01, ARR_ART30_ED2020_10, ARR_ART30_ED2021_01,
        ARR_ART30_ED2021_10, ARR_ART30_ED2022_01, ARR_ART30_ED2022_07,
        ARR_ART30_ED2023_01, ARR_ART30_ED2023_10, ARR_ART30_ED2024_01,
        ARR_ART30_ED2024_10, ARR_ART30_ED2025_01, ARR_ART30_ED2025_10,
        ARR_ART30_ED2026_10)
rule CoefficientPriseEnChargeAllocationALF(m: Menage, parts: Decimal, ressources: Money) strict {
    label fr official "K est calculé selon les dispositions du 2° de l'article D. 832-25 : 0,90 − R / (cm × N)";
    label ru unofficial "K аллокаций (ALF) — всегда по 2° ст. D. 832-25: 0,90 − R/(cm·N), вниз до сотых, не выше 0,90";
    when secteur_logement_foyer(m) and aide_demandee(m, ALF)
        and nombre_parts(m, parts) and ressources_retenues(m, ressources);
    then coefficient_prise_en_charge(m, coefficient_k_jeunes_travailleurs(ressources, parts));
}

@source(CCH_D842_15, CCH_D842_15_ED2019_12, CCH_D842_15_ED2020_01,
        CCH_D842_15_ED2021_01, CCH_D842_15_ED2023_04, CCH_D842_15_ED2023_09,
        CCH_D842_15_ED2023_12, CCH_D842_15_ED2026_07, CCH_D832_25,
        CCH_D832_25_ED2019_12, CCH_D832_25_ED2020_01, CCH_D832_25_ED2021_01,
        CCH_D832_25_ED2023_04, CCH_D832_25_ED2023_09, CCH_D832_25_ED2023_12,
        CCH_D832_25_ED2026_07, CCH_R351_61_1, ARR_ART30_ED2019_10,
        ARR_ART30_ED2020_01, ARR_ART30_ED2020_10, ARR_ART30_ED2021_01,
        ARR_ART30_ED2021_10, ARR_ART30_ED2022_01, ARR_ART30_ED2022_07,
        ARR_ART30_ED2023_01, ARR_ART30_ED2023_10, ARR_ART30_ED2024_01,
        ARR_ART30_ED2024_10, ARR_ART30_ED2025_01, ARR_ART30_ED2025_10,
        ARR_ART30_ED2026_10)
rule CoefficientPriseEnChargeAllocationALS(m: Menage, parts: Decimal, ressources: Money) strict {
    label fr official "K est calculé selon les dispositions du 2° de l'article D. 832-25 : 0,90 − R / (cm × N)";
    label ru unofficial "K аллокаций (ALS) — всегда по 2° ст. D. 832-25: 0,90 − R/(cm·N), вниз до сотых, не выше 0,90";
    when secteur_logement_foyer(m) and aide_demandee(m, ALS)
        and nombre_parts(m, parts) and ressources_retenues(m, ressources);
    then coefficient_prise_en_charge(m, coefficient_k_jeunes_travailleurs(ressources, parts));
}

@source(CCH_D832_24, CCH_D832_24_ED2019_12, CCH_D832_24_ED2020_01,
        CCH_D832_24_ED2021_01, CCH_D832_24_ED2023_04, CCH_D832_24_ED2023_09,
        CCH_D832_24_ED2023_12, CCH_D832_24_ED2026_07, CCH_D832_25,
        CCH_D832_25_ED2019_12, CCH_D832_25_ED2020_01, CCH_D832_25_ED2021_01,
        CCH_D832_25_ED2023_04, CCH_D832_25_ED2023_09, CCH_D832_25_ED2023_12,
        CCH_D832_25_ED2026_07)
rule AideFoyerFormuleAPL(m: Menage, k: Decimal, e: Money, e0: Money) strict {
    label fr official "Af = K × (E − E0)";
    label ru unofficial "Af APL фойе: K × (E − E0)";
    when secteur_logement_foyer(m) and aide_demandee(m, APL)
        and coefficient_prise_en_charge(m, k)
        and equivalence_loyer_eligible(m, e) and equivalence_loyer_minimale(m, e0);
    then aide_foyer_formule(m, k * (e - e0));
}

@source(CCH_D842_15, CCH_D842_15_ED2019_12, CCH_D842_15_ED2020_01,
        CCH_D842_15_ED2021_01, CCH_D842_15_ED2023_04, CCH_D842_15_ED2023_09,
        CCH_D842_15_ED2023_12, CCH_D842_15_ED2026_07, CCH_D832_25,
        CCH_D832_25_ED2019_12, CCH_D832_25_ED2020_01, CCH_D832_25_ED2021_01,
        CCH_D832_25_ED2023_04, CCH_D832_25_ED2023_09, CCH_D832_25_ED2023_12,
        CCH_D832_25_ED2026_07)
rule AideFoyerFormuleAllocationALF(m: Menage, k: Decimal, l: Money, c: Money, l0: Money) strict {
    label fr official "Af = K × (L + C − L0)";
    label ru unofficial "Af аллокации (ALF) в фойе: K × (L + C − L0)";
    when secteur_logement_foyer(m) and aide_demandee(m, ALF)
        and coefficient_prise_en_charge(m, k)
        and equivalence_loyer_retenue(m, l) and forfait_charges_foyer(m, c)
        and loyer_minimal(m, l0);
    then aide_foyer_formule(m, k * (l + c - l0));
}

@source(CCH_D842_15, CCH_D842_15_ED2019_12, CCH_D842_15_ED2020_01,
        CCH_D842_15_ED2021_01, CCH_D842_15_ED2023_04, CCH_D842_15_ED2023_09,
        CCH_D842_15_ED2023_12, CCH_D842_15_ED2026_07, CCH_D832_25,
        CCH_D832_25_ED2019_12, CCH_D832_25_ED2020_01, CCH_D832_25_ED2021_01,
        CCH_D832_25_ED2023_04, CCH_D832_25_ED2023_09, CCH_D832_25_ED2023_12,
        CCH_D832_25_ED2026_07)
rule AideFoyerFormuleAllocationALS(m: Menage, k: Decimal, l: Money, c: Money, l0: Money) strict {
    label fr official "Af = K × (L + C − L0)";
    label ru unofficial "Af аллокации (ALS) в фойе: K × (L + C − L0)";
    when secteur_logement_foyer(m) and aide_demandee(m, ALS)
        and coefficient_prise_en_charge(m, k)
        and equivalence_loyer_retenue(m, l) and forfait_charges_foyer(m, c)
        and loyer_minimal(m, l0);
    then aide_foyer_formule(m, k * (l + c - l0));
}

@source(CCH_D832_24, CCH_D832_24_ED2019_12, CCH_D832_24_ED2020_01,
        CCH_D832_24_ED2021_01, CCH_D832_24_ED2023_04, CCH_D832_24_ED2023_09,
        CCH_D832_24_ED2023_12, CCH_D832_24_ED2026_07, CCH_D842_15,
        CCH_D842_15_ED2019_12, CCH_D842_15_ED2020_01, CCH_D842_15_ED2021_01,
        CCH_D842_15_ED2023_04, CCH_D842_15_ED2023_09, CCH_D842_15_ED2023_12,
        CCH_D842_15_ED2026_07, ARR_ART28_ED2019_10, ARR_ART28_ED2020_01,
        ARR_ART28_ED2020_10, ARR_ART28_ED2021_01, ARR_ART28_ED2021_10,
        ARR_ART28_ED2022_01, ARR_ART28_ED2022_07, ARR_ART28_ED2023_01,
        ARR_ART28_ED2023_10, ARR_ART28_ED2024_01, ARR_ART28_ED2024_10,
        ARR_ART28_ED2025_01, ARR_ART28_ED2025_10, ARR_ART28_ED2026_10,
        ARR_ART41_ED2019_10, ARR_ART41_ED2020_01, ARR_ART41_ED2020_10,
        ARR_ART41_ED2021_01, ARR_ART41_ED2021_10, ARR_ART41_ED2022_01,
        ARR_ART41_ED2022_07, ARR_ART41_ED2023_01, ARR_ART41_ED2023_10,
        ARR_ART41_ED2024_01, ARR_ART41_ED2024_10, ARR_ART41_ED2025_01,
        ARR_ART41_ED2025_10, ARR_ART41_ED2026_10)
rule MinorationForfaitaireFoyer(m: Menage, type_aide: TypeAide, aide: Money) strict {
    label fr official "Le montant ainsi calculé est minoré d'un montant fixé forfaitairement par arrêté";
    label ru unofficial "Из результата формулы вычитается форфейтная минорация (ст. 28 арретэ для APL, ст. 41 для аллокаций)";
    when secteur_logement_foyer(m) and aide_demandee(m, type_aide)
        and aide_foyer_formule(m, aide);
    then aide_foyer_apres_minoration(m, aide - minoration_forfaitaire_foyer(type_aide));
}

@source(CCH_D832_24, CCH_D832_24_ED2019_12, CCH_D832_24_ED2020_01,
        CCH_D832_24_ED2021_01, CCH_D832_24_ED2023_04, CCH_D832_24_ED2023_09,
        CCH_D832_24_ED2023_12, CCH_D832_24_ED2026_07, CCH_D832_27,
        CCH_D832_27_ED2019_12, CCH_D832_27_ED2020_01, CCH_D832_27_ED2021_01,
        CCH_D832_27_ED2023_04, CCH_D832_27_ED2023_09, CCH_D832_27_ED2023_12,
        CCH_D832_27_ED2026_07, ARR_ART32_ED2019_10, ARR_ART32_ED2020_01,
        ARR_ART32_ED2020_10, ARR_ART32_ED2021_01, ARR_ART32_ED2021_10,
        ARR_ART32_ED2022_01, ARR_ART32_ED2022_07, ARR_ART32_ED2023_01,
        ARR_ART32_ED2023_10, ARR_ART32_ED2024_01, ARR_ART32_ED2024_10,
        ARR_ART32_ED2025_01, ARR_ART32_ED2025_10, ARR_ART32_ED2026_10)
rule AbattementDepenseNetteAPL(m: Menage, aide: Money, e: Money, minimum: Money) strict {
    label fr official "lorsque la dépense nette de logement (E moins l'aide calculée) est inférieure à un montant fixé par arrêté, l'abattement est égal à la différence constatée";
    label ru unofficial "APL фойе: если чистый расход (E минус пособие) ниже минимума, пособие уменьшается на разницу";
    when secteur_logement_foyer(m) and aide_demandee(m, APL)
        and aide_foyer_apres_minoration(m, aide)
        and equivalence_loyer_eligible(m, e) and depense_nette_minimale(m, minimum);
    then aide_foyer_apres_depense_nette(m,
        aide_apres_abattement_depense_nette(aide, e, minimum));
}

@source(CCH_D842_15, CCH_D842_15_ED2019_12, CCH_D842_15_ED2020_01,
        CCH_D842_15_ED2021_01, CCH_D842_15_ED2023_04, CCH_D842_15_ED2023_09,
        CCH_D842_15_ED2023_12, CCH_D842_15_ED2026_07, CCH_D842_17,
        CCH_D842_17_ED2019_12, CCH_D842_17_ED2020_01, CCH_D842_17_ED2021_01,
        CCH_D842_17_ED2023_04, CCH_D842_17_ED2023_09, CCH_D842_17_ED2023_12,
        CCH_D842_17_ED2026_07, ARR_ART44_ED2019_10, ARR_ART44_ED2020_01,
        ARR_ART44_ED2020_10, ARR_ART44_ED2021_01, ARR_ART44_ED2021_10,
        ARR_ART44_ED2022_01, ARR_ART44_ED2022_07, ARR_ART44_ED2023_01,
        ARR_ART44_ED2023_10, ARR_ART44_ED2024_01, ARR_ART44_ED2024_10,
        ARR_ART44_ED2025_01, ARR_ART44_ED2025_10, ARR_ART44_ED2026_10)
rule AbattementDepenseNetteAllocationALF(m: Menage, aide: Money, l: Money, c: Money,
                                         minimum: Money) strict {
    label fr official "lorsque la dépense nette de logement (L + C moins l'aide calculée) est inférieure à un montant fixé par arrêté, l'abattement est égal à la différence constatée";
    label ru unofficial "Аллокации (ALF) в фойе: если чистый расход (L + C минус пособие) ниже минимума, пособие уменьшается на разницу";
    when secteur_logement_foyer(m) and aide_demandee(m, ALF)
        and aide_foyer_apres_minoration(m, aide)
        and equivalence_loyer_retenue(m, l) and forfait_charges_foyer(m, c)
        and depense_nette_minimale(m, minimum);
    then aide_foyer_apres_depense_nette(m,
        aide_apres_abattement_depense_nette(aide, l + c, minimum));
}

@source(CCH_D842_15, CCH_D842_15_ED2019_12, CCH_D842_15_ED2020_01,
        CCH_D842_15_ED2021_01, CCH_D842_15_ED2023_04, CCH_D842_15_ED2023_09,
        CCH_D842_15_ED2023_12, CCH_D842_15_ED2026_07, CCH_D842_17,
        CCH_D842_17_ED2019_12, CCH_D842_17_ED2020_01, CCH_D842_17_ED2021_01,
        CCH_D842_17_ED2023_04, CCH_D842_17_ED2023_09, CCH_D842_17_ED2023_12,
        CCH_D842_17_ED2026_07, ARR_ART44_ED2019_10, ARR_ART44_ED2020_01,
        ARR_ART44_ED2020_10, ARR_ART44_ED2021_01, ARR_ART44_ED2021_10,
        ARR_ART44_ED2022_01, ARR_ART44_ED2022_07, ARR_ART44_ED2023_01,
        ARR_ART44_ED2023_10, ARR_ART44_ED2024_01, ARR_ART44_ED2024_10,
        ARR_ART44_ED2025_01, ARR_ART44_ED2025_10, ARR_ART44_ED2026_10)
rule AbattementDepenseNetteAllocationALS(m: Menage, aide: Money, l: Money, c: Money,
                                         minimum: Money) strict {
    label fr official "lorsque la dépense nette de logement (L + C moins l'aide calculée) est inférieure à un montant fixé par arrêté, l'abattement est égal à la différence constatée";
    label ru unofficial "Аллокации (ALS) в фойе: если чистый расход (L + C минус пособие) ниже минимума, пособие уменьшается на разницу";
    when secteur_logement_foyer(m) and aide_demandee(m, ALS)
        and aide_foyer_apres_minoration(m, aide)
        and equivalence_loyer_retenue(m, l) and forfait_charges_foyer(m, c)
        and depense_nette_minimale(m, minimum);
    then aide_foyer_apres_depense_nette(m,
        aide_apres_abattement_depense_nette(aide, l + c, minimum));
}

@source(CCH_D842_15, CCH_D842_15_ED2019_12, CCH_D842_15_ED2020_01,
        CCH_D842_15_ED2021_01, CCH_D842_15_ED2023_04, CCH_D842_15_ED2023_09,
        CCH_D842_15_ED2023_12, CCH_D842_15_ED2026_07)
rule AideFoyerRapporteeRedevanceALF(m: Menage, aide: Money, redev: Money) strict {
    label fr official "Si le montant obtenu est supérieur au montant de la redevance supportée par le résident, il est rapporté au montant de cette redevance";
    label ru unofficial "Аллокации (ALF) в фойе: пособие не больше redevance, которую несёт проживающий";
    when secteur_logement_foyer(m) and aide_demandee(m, ALF)
        and aide_foyer_apres_depense_nette(m, aide) and redevance(m, redev);
    then aide_foyer_rapportee_redevance(m, min(aide, redev));
}

@source(CCH_D842_15, CCH_D842_15_ED2019_12, CCH_D842_15_ED2020_01,
        CCH_D842_15_ED2021_01, CCH_D842_15_ED2023_04, CCH_D842_15_ED2023_09,
        CCH_D842_15_ED2023_12, CCH_D842_15_ED2026_07)
rule AideFoyerRapporteeRedevanceALS(m: Menage, aide: Money, redev: Money) strict {
    label fr official "Si le montant obtenu est supérieur au montant de la redevance supportée par le résident, il est rapporté au montant de cette redevance";
    label ru unofficial "Аллокации (ALS) в фойе: пособие не больше redevance, которую несёт проживающий";
    when secteur_logement_foyer(m) and aide_demandee(m, ALS)
        and aide_foyer_apres_depense_nette(m, aide) and redevance(m, redev);
    then aide_foyer_rapportee_redevance(m, min(aide, redev));
}

@source(CCH_D832_24, CCH_D832_24_ED2019_12, CCH_D832_24_ED2020_01,
        CCH_D832_24_ED2021_01, CCH_D832_24_ED2023_04, CCH_D832_24_ED2023_09,
        CCH_D832_24_ED2023_12, CCH_D832_24_ED2026_07,
        ORD9650_ART19_ED2019_09, ORD9650_ART19_ED2020_01, CGCT_LO6414_1)
rule ContributionsSocialesFoyerAPL(m: Menage, aide: Money, zone_geo: Territoire) strict {
    label fr official "Ce dernier résultat est diminué d'un montant représentatif des contributions sociales qui s'y appliquent, arrondi à l'euro inférieur, puis majoré de ce montant représentatif";
    label ru unofficial "APL фойе: результат уменьшается на представительную сумму взносов, округляется к нижнему евро, взносы возвращаются (как D. 823-16)";
    when secteur_logement_foyer(m) and aide_demandee(m, APL)
        and aide_foyer_apres_depense_nette(m, aide) and territoire(m, zone_geo);
    then aide_foyer_apres_contributions(m, contributions_selon_territoire(aide, zone_geo));
}

@source(CCH_D842_15, CCH_D842_15_ED2019_12, CCH_D842_15_ED2020_01,
        CCH_D842_15_ED2021_01, CCH_D842_15_ED2023_04, CCH_D842_15_ED2023_09,
        CCH_D842_15_ED2023_12, CCH_D842_15_ED2026_07,
        ORD9650_ART19_ED2019_09, ORD9650_ART19_ED2020_01, CGCT_LO6414_1)
rule ContributionsSocialesFoyerAllocation(m: Menage, aide: Money, zone_geo: Territoire) strict {
    label fr official "Ce dernier résultat est diminué d'un montant représentatif des contributions sociales qui s'y appliquent, arrondi à l'euro inférieur, puis majoré de ce montant représentatif";
    label ru unofficial "Аллокации в фойе: результат уменьшается на представительную сумму взносов, округляется к нижнему евро, взносы возвращаются (как D. 823-16)";
    when secteur_logement_foyer(m) and aide_foyer_rapportee_redevance(m, aide)
        and territoire(m, zone_geo);
    then aide_foyer_apres_contributions(m, contributions_selon_territoire(aide, zone_geo));
}

@source(CCH_D832_24, CCH_D832_24_ED2019_12, CCH_D832_24_ED2020_01,
        CCH_D832_24_ED2021_01, CCH_D832_24_ED2023_04, CCH_D832_24_ED2023_09,
        CCH_D832_24_ED2023_12, CCH_D832_24_ED2026_07, CCH_D842_15,
        CCH_D842_15_ED2019_12, CCH_D842_15_ED2020_01, CCH_D842_15_ED2021_01,
        CCH_D842_15_ED2023_04, CCH_D842_15_ED2023_09, CCH_D842_15_ED2023_12,
        CCH_D842_15_ED2026_07, ARR_ART29_ED2019_10, ARR_ART29_ED2020_01,
        ARR_ART29_ED2020_10, ARR_ART29_ED2021_01, ARR_ART29_ED2021_10,
        ARR_ART29_ED2022_01, ARR_ART29_ED2022_07, ARR_ART29_ED2023_01,
        ARR_ART29_ED2023_10, ARR_ART29_ED2024_01, ARR_ART29_ED2024_10,
        ARR_ART29_ED2025_01, ARR_ART29_ED2025_10, ARR_ART29_ED2026_10,
        ARR_ART42_ED2019_10, ARR_ART42_ED2020_01, ARR_ART42_ED2020_10,
        ARR_ART42_ED2021_01, ARR_ART42_ED2021_10, ARR_ART42_ED2022_01,
        ARR_ART42_ED2022_07, ARR_ART42_ED2023_01, ARR_ART42_ED2023_10,
        ARR_ART42_ED2024_01, ARR_ART42_ED2024_10, ARR_ART42_ED2025_01,
        ARR_ART42_ED2025_10, ARR_ART42_ED2026_10)
rule AideFoyerVersee(m: Menage, type_aide: TypeAide, aide: Money) strict {
    label fr official "l'aide en logement-foyer est versée lorsque le montant atteint le seuil fixé par arrêté";
    label ru unofficial "Фойе: пособие выплачивается, когда итог не ниже порога (ст. 29 арретэ для APL, ст. 42 для аллокаций)";
    when secteur_logement_foyer(m) and aide_demandee(m, type_aide)
        and aide_foyer_apres_contributions(m, aide)
        and aide >= seuil_versement_foyer(type_aide);
    then aide_theorique(m, aide);
}

@source(CCH_D832_24, CCH_D832_24_ED2019_12, CCH_D832_24_ED2020_01,
        CCH_D832_24_ED2021_01, CCH_D832_24_ED2023_04, CCH_D832_24_ED2023_09,
        CCH_D832_24_ED2023_12, CCH_D832_24_ED2026_07, CCH_D842_15,
        CCH_D842_15_ED2019_12, CCH_D842_15_ED2020_01, CCH_D842_15_ED2021_01,
        CCH_D842_15_ED2023_04, CCH_D842_15_ED2023_09, CCH_D842_15_ED2023_12,
        CCH_D842_15_ED2026_07, ARR_ART29_ED2019_10, ARR_ART29_ED2020_01,
        ARR_ART29_ED2020_10, ARR_ART29_ED2021_01, ARR_ART29_ED2021_10,
        ARR_ART29_ED2022_01, ARR_ART29_ED2022_07, ARR_ART29_ED2023_01,
        ARR_ART29_ED2023_10, ARR_ART29_ED2024_01, ARR_ART29_ED2024_10,
        ARR_ART29_ED2025_01, ARR_ART29_ED2025_10, ARR_ART29_ED2026_10,
        ARR_ART42_ED2019_10, ARR_ART42_ED2020_01, ARR_ART42_ED2020_10,
        ARR_ART42_ED2021_01, ARR_ART42_ED2021_10, ARR_ART42_ED2022_01,
        ARR_ART42_ED2022_07, ARR_ART42_ED2023_01, ARR_ART42_ED2023_10,
        ARR_ART42_ED2024_01, ARR_ART42_ED2024_10, ARR_ART42_ED2025_01,
        ARR_ART42_ED2025_10, ARR_ART42_ED2026_10)
rule AideFoyerNonVersee(m: Menage, type_aide: TypeAide, aide: Money) strict {
    label fr official "Lorsque le montant mensuel de l'aide est inférieur à un montant fixé par arrêté, il n'est pas procédé à son versement";
    label ru unofficial "Фойе: итог ниже порога — выплата не производится";
    when secteur_logement_foyer(m) and aide_demandee(m, type_aide)
        and aide_foyer_apres_contributions(m, aide)
        and aide < seuil_versement_foyer(type_aide);
    then aide_non_versee(m);
}
