        ARR_ART31_ED2023_01, ARR_ART31_ED2023_10, ARR_ART31_ED2024_01,
        ARR_ART31_ED2024_10, ARR_ART31_ED2025_01, ARR_ART31_ED2025_10)
rule LoyerMinimalALF(m: Menage, situation: SituationFamiliale, pac: Integer,
                     ressources: Money) strict {
    label fr official "L0 est le loyer minimal; il est calculé selon les dispositions du deuxième alinéa de l'article D. 832-26, dans lequel il se substitue à E0";
    label ru unofficial "L0: по второму абзацу D. 832-26 (ALF)";
    effective [@2022-07-01, infinity);
    when secteur_logement_foyer(m) and aide_demandee(m, ALF)
        and situation_familiale(m, situation) and personnes_a_charge(m, pac)
        and ressources_retenues(m, ressources);
    then loyer_minimal(m, loyer_minimal_calcule(situation, pac, ressources));
}

