}

@source(CCH_D832_27, CCH_D832_27_ED2019_12, CCH_D832_27_ED2020_01,
        CCH_D832_27_ED2021_01, CCH_D832_27_ED2023_04, CCH_D832_27_ED2023_09,
        CCH_D832_27_ED2023_12, CCH_D832_27_ED2026_07, ARR_ART32_ED2019_10,
        ARR_ART32_ED2020_01, ARR_ART32_ED2020_10, ARR_ART32_ED2021_01,
        ARR_ART32_ED2021_10, ARR_ART32_ED2022_01, ARR_ART32_ED2022_07,
        ARR_ART32_ED2023_01, ARR_ART32_ED2023_10, ARR_ART32_ED2024_01,
        ARR_ART32_ED2024_10, ARR_ART32_ED2025_01, ARR_ART32_ED2025_10)
rule DepenseNetteMinimale(m: Menage, type_foyer: TypeLogementFoyer) strict {
    label fr official "lorsque cette dépense nette de logement est inférieure à un montant fixé par arrêté selon le type de logements-foyer, l'abattement à effectuer sur le montant mensuel de l'aide est égal à la différence constatée";
    label ru unofficial "минимум чистого расхода: ниже него аббатмент равен разнице";
    when secteur_logement_foyer(m) and aide_demandee(m, APL)
        and type_logement_foyer(m, type_foyer);
    then depense_nette_minimale(m, depense_nette_minimale_apl(type_foyer));
}

