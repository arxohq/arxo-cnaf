// --- ст. 27 арретэ: плафон эквивалентности найма и расходов E --------------
//
// Столбцов семь: изолированный получатель, пара без иждивенцев, затем один,
// два, три и четыре иждивенца, и надбавка за каждого следующего. Отдельные
// строки до четырёх иждивенцев — это САМ барем, а не развёртка формулы: у
// locatif их три, здесь семь, и сокращать их до арифметики было бы подгонкой.

function plafond_equivalence_isole(zone: Zone) -> Money = match zone {
    ZONE_I => PlafondEquivalenceZone1Isole;
    ZONE_II => PlafondEquivalenceZone2Isole;
    ZONE_III => PlafondEquivalenceZone3Isole;
};

function plafond_equivalence_couple(zone: Zone) -> Money = match zone {
    ZONE_I => PlafondEquivalenceZone1Couple;
    ZONE_II => PlafondEquivalenceZone2Couple;
    ZONE_III => PlafondEquivalenceZone3Couple;
};

function plafond_equivalence_une_pac(zone: Zone) -> Money = match zone {
    ZONE_I => PlafondEquivalenceZone1UnePac;
    ZONE_II => PlafondEquivalenceZone2UnePac;
    ZONE_III => PlafondEquivalenceZone3UnePac;
};

function plafond_equivalence_deux_pac(zone: Zone) -> Money = match zone {
    ZONE_I => PlafondEquivalenceZone1DeuxPac;
    ZONE_II => PlafondEquivalenceZone2DeuxPac;
    ZONE_III => PlafondEquivalenceZone3DeuxPac;
};

function plafond_equivalence_trois_pac(zone: Zone) -> Money = match zone {
    ZONE_I => PlafondEquivalenceZone1TroisPac;
    ZONE_II => PlafondEquivalenceZone2TroisPac;
    ZONE_III => PlafondEquivalenceZone3TroisPac;
};

function plafond_equivalence_quatre_pac(zone: Zone) -> Money = match zone {
    ZONE_I => PlafondEquivalenceZone1QuatrePac;
    ZONE_II => PlafondEquivalenceZone2QuatrePac;
    ZONE_III => PlafondEquivalenceZone3QuatrePac;
};

function plafond_equivalence_majoration(zone: Zone) -> Money = match zone {
    ZONE_I => PlafondEquivalenceZone1ParPacSup;
    ZONE_II => PlafondEquivalenceZone2ParPacSup;
    ZONE_III => PlafondEquivalenceZone3ParPacSup;
};

function plafond_equivalence_applicable(zone: Zone, situation: SituationFamiliale,
                                        pac: Integer) -> Money {
    let sans_pac: Money = match situation {
        PERSONNE_SEULE => plafond_equivalence_isole(zone);
        COUPLE => plafond_equivalence_couple(zone);
    };
    return if pac == 0 then sans_pac
        else if pac == 1 then plafond_equivalence_une_pac(zone)
        else if pac == 2 then plafond_equivalence_deux_pac(zone)
        else if pac == 3 then plafond_equivalence_trois_pac(zone)
        else if pac == 4 then plafond_equivalence_quatre_pac(zone)
        else plafond_equivalence_quatre_pac(zone)
             + plafond_equivalence_majoration(zone) * max(0, pac - 4);
}

// --- D. 832-25: доли N ----------------------------------------------------

function parts_general(situation: SituationFamiliale, pac: Integer) -> Decimal {
    let sans_pac: Decimal = match situation {
        PERSONNE_SEULE => PartsFoyerGeneralIsole;
        COUPLE => PartsFoyerGeneralCouple;
    };
    return if pac == 0 then sans_pac
        else if pac == 1 then PartsFoyerGeneralUnePac
        else if pac == 2 then PartsFoyerGeneralDeuxPac
        else if pac == 3 then PartsFoyerGeneralTroisPac
        else if pac == 4 then PartsFoyerGeneralQuatrePac
        else PartsFoyerGeneralQuatrePac
             + PartsFoyerGeneralParPacSup * max(0, pac - 4);
}

function parts_jeunes_travailleurs(situation: SituationFamiliale,
                                   pac: Integer) -> Decimal {
    let sans_pac: Decimal = match situation {
        PERSONNE_SEULE => PartsFoyerJeunesTravailleursIsole;
        COUPLE => PartsFoyerJeunesTravailleursCouple;
    };
    return if pac == 0 then sans_pac
        else if pac == 1 then PartsFoyerJeunesTravailleursUnePac
        else if pac == 2 then PartsFoyerJeunesTravailleursDeuxPac
        else if pac == 3 then PartsFoyerJeunesTravailleursTroisPac
        else if pac == 4 then PartsFoyerJeunesTravailleursQuatrePac
        else PartsFoyerJeunesTravailleursQuatrePac
             + PartsFoyerJeunesTravailleursParPacSup * max(0, pac - 4);
}

function parts_applicables(type_foyer: TypeLogementFoyer,
                           situation: SituationFamiliale,
                           pac: Integer) -> Decimal = match type_foyer {
    GENERAL => parts_general(situation, pac);
    JEUNES_TRAVAILLEURS_OU_RESIDENCE_SOCIALE => parts_jeunes_travailleurs(situation, pac);
};

// --- D. 832-26 и ст. 31 арретэ: минимальная эквивалентность E0 ------------
//
// «par application de pourcentages à des tranches de ressources, dont les
// limites inférieures et supérieures sont multipliées par le nombre de parts
// N»: ставка бьёт по СВОЕЙ доле ресурсов, границы траншей масштабируются N.
// «Le résultat est majoré du produit d'un montant forfaitaire par le nombre de
// parts N» (1°) либо «majoré d'un montant forfaitaire» (2° — без N), «le total
// étant divisé par douze».
//
// Деление на двенадцать записано `/ 12.0`: список делимых §58 закрыт и пары
// `Money / Integer` в нём нет, а двенадцать как Decimal даёт `Money / Decimal`
// — тот же вид, что делимое, и громкий INEXACT_DIVISION вместо молчаливого
// округления, если частное непредставимо. Норма округления здесь не названа.
//
// D-82 (08.10.2026): под прочтением ArrondiCentimeHalfUp
// (27-lecture-arrondi-centime.law) E0 считают правила того прочтения —
// `div_round(…, 12.0, 2, "HALF_UP")`; охранное условие not_known(…) в обоих
// правилах E0 ниже гасит базовое правило под выбранным прочтением. Без выбора
// поведение прежнее — отказ. L0 (D. 842-15 5°, «se substitue à E0») прочтение
// не затрагивает: решение D-82 названо для E0.

function tranche_e0(ressources: Money, basse: Money, haute: Money,
                    taux: Decimal) -> Money =
    if ressources <= basse then 0 EUR
    else (min(ressources, haute) - basse) * taux;

function somme_tranches_e0(parts: Decimal, ressources: Money) -> Money {
    let borne1: Money = BorneE0Tranche1 * parts;
    let borne2: Money = BorneE0Tranche2 * parts;
    let borne3: Money = BorneE0Tranche3 * parts;
    let borne4: Money = BorneE0Tranche4 * parts;
    let borne5: Money = BorneE0Tranche5 * parts;
    let derniere: Money = if ressources <= borne5 then 0 EUR
        else (ressources - borne5) * TauxE0Tranche6;
    return tranche_e0(ressources, 0 EUR, borne1, TauxE0Tranche1)
        + tranche_e0(ressources, borne1, borne2, TauxE0Tranche2)
        + tranche_e0(ressources, borne2, borne3, TauxE0Tranche3)
        + tranche_e0(ressources, borne3, borne4, TauxE0Tranche4)
        + tranche_e0(ressources, borne4, borne5, TauxE0Tranche5)
        + derniere;
}

// ДВЕ ЭПОХИ ВТОРОГО АБЗАЦА D. 832-26. Редакция ст. 31 арретэ 2019 года давала
// ОДИН набор транш «mentionnés à l'article D. 832-26» и два форфейта — «aux
// premier et deuxième alinéas … respectivement 45,57 et 76,32»: у фойе молодых
// работников и социальных резиденций те же ставки, границы × N и свой форфейт.
// Редакция, применимая с 1 июля 2022 года, расщепила ставки: «b) Au deuxième
// alinéa» — свои пять транш. Обе эпохи — свои правила с окном `effective`
// (§87, условие 4 §13): до июля 2022 года — первая таблица, с июля — вторая.
// Замер 14.09.2026 конвертером дел Catala: их CasTest5 (май 2022 года,
// résidence sociale) даёт 124,64 € — это ВТОРАЯ таблица, применимая лишь с
// июля; по тексту месяца права — 115,19 € (первая таблица × N + 76,32).

function somme_tranches_second_alinea_depuis_2022(parts: Decimal,
                                                  ressources: Money) -> Money {
    let borne1: Money = BorneL0SecondAlinea1 * parts;
    let borne2: Money = BorneL0SecondAlinea2 * parts;
    let borne3: Money = BorneL0SecondAlinea3 * parts;
    let borne4: Money = BorneL0SecondAlinea4 * parts;
    let derniere: Money = if ressources <= borne4 then 0 EUR
        else (ressources - borne4) * TauxL0SecondAlinea5;
    return tranche_e0(ressources, 0 EUR, borne1, TauxL0SecondAlinea1)
        + tranche_e0(ressources, borne1, borne2, TauxL0SecondAlinea2)
        + tranche_e0(ressources, borne2, borne3, TauxL0SecondAlinea3)
        + tranche_e0(ressources, borne3, borne4, TauxL0SecondAlinea4)
        + derniere;
}

function equivalence_minimale_avant_2022(type_foyer: TypeLogementFoyer,
                                         situation: SituationFamiliale,
                                         pac: Integer,
                                         ressources: Money) -> Money {
    let parts: Decimal = parts_applicables(type_foyer, situation, pac);
    let forfait: Money = match type_foyer {
        GENERAL => ForfaitE0General * parts;
        JEUNES_TRAVAILLEURS_OU_RESIDENCE_SOCIALE => ForfaitE0JeunesTravailleurs;
    };
    return (somme_tranches_e0(parts, ressources) + forfait) / 12.0;
}

function equivalence_minimale_calculee(type_foyer: TypeLogementFoyer,
                                       situation: SituationFamiliale,
                                       pac: Integer,
                                       ressources: Money) -> Money {
    let parts: Decimal = parts_applicables(type_foyer, situation, pac);
    return match type_foyer {
        GENERAL => (somme_tranches_e0(parts, ressources) + ForfaitE0General * parts) / 12.0;
        JEUNES_TRAVAILLEURS_OU_RESIDENCE_SOCIALE =>
            (somme_tranches_second_alinea_depuis_2022(parts, ressources)
                + ForfaitE0JeunesTravailleurs) / 12.0;
    };
}

// D. 842-15 5°: «L0 est le loyer minimal; il est calculé selon les dispositions
// du deuxième alinéa de l'article D. 832-26, dans lequel il se substitue à
// « E0 »». Второй абзац D. 832-26 — ветвь фойе молодых работников: доли N из d
// пункта 2° и форфейт БЕЗ умножения на N. Поэтому у аллокаций L0 считается по
// этой ветви ВСЕГДА, независимо от типа фойе.
//
// У ВТОРОГО АБЗАЦА СВОИ ТРАНШИ, И ЭТО БЫЛО НАШЕЙ ОШИБКОЙ. До 14.09.2026 модуль
// считал второй абзац теми же ставками, что первый: версия ст. 31 арретэ,
// действовавшая с 2019 года, давала ОДИН набор «mentionnés à l'article
// D. 832-26», и другого в закреплённом тексте не было. Версия, применимая с
// 1 июля 2022 года, расщепила их явно — «a) Au premier alinéa … b) Au deuxième
// alinéa», — и у второго абзаца оказались ПЯТЬ своих транш с другими ставками
// (0 %, 2,40 %, 20,80 %, 23,20 %, 32,80 %) и другими границами (1 423,03,
// 2 047,61, 2 629,85, 4 095,05). Именно они воспроизводят все три дела Catala,
// числившиеся расхождением: 307,97 € (фойе CasTest2), 267,90 € (Гваделупа) и
// 296,96 € (Сен-Пьер-и-Микелон) — до цента.
//
// Квалификация прежнего расхождения после находки: класс (а), наш дефект — мы
// применяли ставки первого абзаца ко второму. Остаток у дела CasTest2 — класс
// (б), их дефект: дело датировано апрелем 2022 года, а числа у них те, что
// названы редакцией, применимой лишь с 1 июля 2022 года. Строки этих транш
// заведены только той редакцией, поэтому на апреле 2022 года наш параметр
// отсутствует и оценка отвечает MISSING_PARAMETER_VALUE, а не значением нормы,
// вступившей позже даты дела.

function loyer_minimal_calcule(situation: SituationFamiliale, pac: Integer,
                               ressources: Money) -> Money {
    let parts: Decimal = parts_jeunes_travailleurs(situation, pac);
    return (somme_tranches_second_alinea_depuis_2022(parts, ressources)
        + ForfaitE0JeunesTravailleurs) / 12.0;
}

function loyer_minimal_avant_2022(situation: SituationFamiliale, pac: Integer,
                                  ressources: Money) -> Money {
    let parts: Decimal = parts_jeunes_travailleurs(situation, pac);
    return (somme_tranches_e0(parts, ressources) + ForfaitE0JeunesTravailleurs) / 12.0;
}

// --- ст. 40 и ст. 43 арретэ: C и L сектора аллокаций ---------------------

// Ст. 46 2° a) называет вместе арт. 9, 34 и 40, поэтому заморский форфейт фойе —
// та же пара параметров, что у найма и приобретения.
function forfait_charges_foyer_calcule(pac: Integer, zone_geo: Territoire) -> Money =
    match zone_geo {
        METROPOLE => ForfaitChargesFoyerBase + ForfaitChargesFoyerParPacSup * pac;
        OUTRE_MER => ForfaitChargesBaseOutreMer + ForfaitChargesParPacSupOutreMer * pac;
        SAINT_PIERRE_ET_MIQUELON => ForfaitChargesFoyerBase
            + ForfaitChargesFoyerParPacSup * pac;
    };

function equivalence_loyer_categorie(categorie: CategorieEquivalenceLoyer,
                                     situation: SituationFamiliale) -> Money {
    let seule: Money = match categorie {
        ETUDIANT_CHAMBRE => EquivalenceLoyerEtudiantChambreSeule;
        ETUDIANT_CHAMBRE_REHABILITEE => EquivalenceLoyerEtudiantChambreRehabiliteeSeule;
        PERSONNES_AGEES => EquivalenceLoyerPersonnesAgeesSeule;
        AUTRES_PERSONNES => EquivalenceLoyerAutresPersonnesSeule;
    };
    let couple: Money = match categorie {
        ETUDIANT_CHAMBRE => EquivalenceLoyerEtudiantChambreDeux;
        ETUDIANT_CHAMBRE_REHABILITEE => EquivalenceLoyerEtudiantChambreRehabiliteeDeux;
        PERSONNES_AGEES => EquivalenceLoyerPersonnesAgeesDeux;
        AUTRES_PERSONNES => EquivalenceLoyerAutresPersonnesDeux;
    };
    return match situation {
        PERSONNE_SEULE => seule;
        COUPLE => couple;
    };
}

// --- ст. 32 и ст. 44 арретэ: минимум чистого расхода ---------------------

// Голый параметр в ГОЛОВЕ правила проходит `check`, но заключения на исполнении
// НЕ даёт (замер 14.09.2026, сектор аллокаций приобретения: `truth_status
// NEITHER` при зелёной статике). Поэтому даже одно-параметровый шаг идёт через
// функцию — она читает параметр по оси `legal_time`, как все прочие.
function depense_nette_minimale_al_foyer() -> Money = DepenseNetteMinimaleFoyerAL;

function depense_nette_minimale_apl(type_foyer: TypeLogementFoyer) -> Money = match type_foyer {
    GENERAL => DepenseNetteMinimaleFoyerAPL;
    JEUNES_TRAVAILLEURS_OU_RESIDENCE_SOCIALE => DepenseNetteMinimaleFoyerJeunesTravailleurs;
};

// --- шаги расчёта как заключения норм ------------------------------------

pub relation plafond_equivalence_loyer(m: Menage, plafond: Money) kind institutional {
    key(m);
    label fr official "plafond de l'équivalence de loyer et de charges locatives éligible";
    label ru unofficial "плафон эквивалентности найма и расходов";
}

pub relation equivalence_loyer_eligible(m: Menage, montant: Money) kind institutional {
    key(m);
    label fr official "E: équivalence de loyer et de charges locatives éligible";
    label ru unofficial "E: эквивалентность найма и расходов, взятая в расчёт";
}

pub relation nombre_parts(m: Menage, parts: Decimal) kind institutional {
    key(m);
    label fr official "N: nombre de parts déterminé selon le barème de l'article D. 832-25";
    label ru unofficial "N: число долей по барему ст. D. 832-25";
}

pub relation equivalence_loyer_minimale(m: Menage, montant: Money) kind institutional {
    key(m);
    label fr official "E0: équivalence de loyer et de charges locatives minimale";
    label ru unofficial "E0: минимальная эквивалентность найма и расходов";
}

pub relation forfait_charges_foyer(m: Menage, montant: Money) kind institutional {
    key(m);
    label fr official "C: montant forfaitaire au titre des charges en logement-foyer";
    label ru unofficial "C: форфейт расходов в logement-foyer";
}

pub relation equivalence_loyer_retenue(m: Menage, montant: Money) kind institutional {
    key(m);
    label fr official "L: équivalence de loyer prise en compte pour les allocations de logement";
    label ru unofficial "L: эквивалентность найма, взятая для аллокаций";
}

pub relation loyer_minimal(m: Menage, montant: Money) kind institutional {
    key(m);
    label fr official "L0: loyer minimal des allocations de logement en logement-foyer";
    label ru unofficial "L0: минимальный наём аллокаций в logement-foyer";
}

pub relation depense_nette_minimale(m: Menage, montant: Money) kind institutional {
    key(m);
    label fr official "montant minimum de dépense nette de logement";
    label ru unofficial "минимальный чистый расход на жильё";
}

@source(CCH_D832_24, CCH_D832_24_ED2019_12, CCH_D832_24_ED2020_01,
        CCH_D832_24_ED2021_01, CCH_D832_24_ED2023_04, CCH_D832_24_ED2023_09,
        CCH_D832_24_ED2023_12, CCH_D832_24_ED2026_07, ARR_ART27_ED2019_10,
        ARR_ART27_ED2020_01, ARR_ART27_ED2020_10, ARR_ART27_ED2021_01,
        ARR_ART27_ED2021_10, ARR_ART27_ED2022_01, ARR_ART27_ED2025_10,
        ARR_ART27_ED2026_10)
rule PlafondEquivalenceLoyer(m: Menage, zone: Zone, situation: SituationFamiliale,
                             pac: Integer) strict {
    label fr official "E est prise en compte dans la limite d'un plafond fixé par arrêté en fonction de la zone géographique et de la composition familiale";
    label ru unofficial "плафон E по зоне и составу домохозяйства";
    when secteur_logement_foyer(m) and aide_demandee(m, APL)
        and zone_du_logement(m, zone)
        and situation_familiale(m, situation) and personnes_a_charge(m, pac);
    then plafond_equivalence_loyer(m, plafond_equivalence_applicable(zone, situation, pac));
}

@source(CCH_D832_24, CCH_D832_24_ED2019_12, CCH_D832_24_ED2020_01,
        CCH_D832_24_ED2021_01, CCH_D832_24_ED2023_04, CCH_D832_24_ED2023_09,
        CCH_D832_24_ED2023_12, CCH_D832_24_ED2026_07)
rule EquivalenceLoyerEligible(m: Menage, redev: Money, plafond: Money) strict {
    label fr official "E est l'équivalence de loyer et de charges locatives éligible, prise en compte dans la limite d'un plafond";
    label ru unofficial "E: плата, ограниченная плафоном";
    when redevance(m, redev) and plafond_equivalence_loyer(m, plafond);
    then equivalence_loyer_eligible(m, min(redev, plafond));
}

@source(CCH_D832_25, CCH_D832_25_ED2019_12, CCH_D832_25_ED2020_01,
        CCH_D832_25_ED2021_01, CCH_D832_25_ED2023_04, CCH_D832_25_ED2023_09,
        CCH_D832_25_ED2023_12, CCH_D832_25_ED2026_07)
rule NombreParts(m: Menage, type_foyer: TypeLogementFoyer,
                 situation: SituationFamiliale, pac: Integer) strict {
    label fr official "N représente le nombre de parts déterminé selon le barème suivant";
    label ru unofficial "N: число долей по барему статьи";
    when secteur_logement_foyer(m) and aide_demandee(m, APL)
        and type_logement_foyer(m, type_foyer)
        and situation_familiale(m, situation) and personnes_a_charge(m, pac);
    then nombre_parts(m, parts_applicables(type_foyer, situation, pac));
}

@source(CCH_D832_26, CCH_D832_26_ED2019_12, CCH_D832_26_ED2020_01,
        CCH_D832_26_ED2021_01, CCH_D832_26_ED2023_04,
        CCH_D832_26_ED2023_09, CCH_D832_26_ED2023_12,
        CCH_D832_26_ED2026_07, ARR_ART31_ED2019_10, ARR_ART31_ED2020_01,
        ARR_ART31_ED2020_10, ARR_ART31_ED2021_01, ARR_ART31_ED2021_10,
        ARR_ART31_ED2022_01)
rule EquivalenceLoyerMinimaleAvantJuillet2022(m: Menage, type_foyer: TypeLogementFoyer,
                              situation: SituationFamiliale, pac: Integer,
                              ressources: Money) strict {
    label fr official "E0 est obtenue par application de pourcentages à des tranches de ressources, dont les limites inférieures et supérieures sont multipliées par le nombre de parts N, majorée d'un montant forfaitaire, le total étant divisé par douze";
    label ru unofficial "E0 до июля 2022 года, единая таблица ст. 31: прогрессивные транши ресурсов с границами, умноженными на N, плюс форфейт, всё делится на двенадцать";
    effective [@2019-10-02, @2022-07-01);
    when secteur_logement_foyer(m) and aide_demandee(m, APL)
        and type_logement_foyer(m, type_foyer)
        and situation_familiale(m, situation) and personnes_a_charge(m, pac)
        and ressources_retenues(m, ressources)
        and not_known(arrondi_intermediaire_centime(m));
    then equivalence_loyer_minimale(m,
        equivalence_minimale_avant_2022(type_foyer, situation, pac, ressources));
}

@source(CCH_D832_26, CCH_D832_26_ED2019_12, CCH_D832_26_ED2020_01,
        CCH_D832_26_ED2021_01, CCH_D832_26_ED2023_04,
        CCH_D832_26_ED2023_09, CCH_D832_26_ED2023_12,
        CCH_D832_26_ED2026_07, ARR_ART31_ED2022_07, ARR_ART31_ED2023_01,
        ARR_ART31_ED2023_10, ARR_ART31_ED2024_01, ARR_ART31_ED2024_10,
        ARR_ART31_ED2025_01, ARR_ART31_ED2025_10)
rule EquivalenceLoyerMinimale(m: Menage, type_foyer: TypeLogementFoyer,
                              situation: SituationFamiliale, pac: Integer,
                              ressources: Money) strict {
    label fr official "E0 est obtenue par application de pourcentages à des tranches de ressources, dont les limites inférieures et supérieures sont multipliées par le nombre de parts N, majorée d'un montant forfaitaire, le total étant divisé par douze";
    label ru unofficial "E0: прогрессивные транши ресурсов с границами, умноженными на N, плюс форфейт, всё делится на двенадцать";
    effective [@2022-07-01, infinity);
    when secteur_logement_foyer(m) and aide_demandee(m, APL)
        and type_logement_foyer(m, type_foyer)
        and situation_familiale(m, situation) and personnes_a_charge(m, pac)
        and ressources_retenues(m, ressources)
        and not_known(arrondi_intermediaire_centime(m));
    then equivalence_loyer_minimale(m,
        equivalence_minimale_calculee(type_foyer, situation, pac, ressources));
}

// Сектор аллокаций — это ALF и ALS. «Не APL» в v1 не выражается (сравнение
// перечисления с константой в guard вне объёма), поэтому у каждого шага две
// нормы с одной головой — по члену перечня. Перечень L. 821-1 закрыт.
@source(CCH_D842_15, CCH_D842_15_ED2019_12, CCH_D842_15_ED2020_01,
        CCH_D842_15_ED2021_01, CCH_D842_15_ED2023_04, CCH_D842_15_ED2023_09,
        CCH_D842_15_ED2023_12, CCH_D842_15_ED2026_07, ARR_ART40_ED2019_10,
        ARR_ART40_ED2020_01, ARR_ART40_ED2020_10, ARR_ART40_ED2021_01,
        ARR_ART40_ED2021_10, ARR_ART40_ED2022_01, ARR_ART46_ED2023_01,
        ARR_ART40_ED2025_10, ARR_ART46_ED2025_10,
        ARR_ART40_ED2026_10, ARR_ART46_ED2026_10)
rule ForfaitChargesFoyerALF(m: Menage, pac: Integer, zone_geo: Territoire) strict {
    label fr official "C est le montant forfaitaire au titre des charges, fixé par arrêté en fonction de la composition familiale";
    label ru unofficial "C: форфейт расходов по составу домохозяйства (ALF)";
    when secteur_logement_foyer(m) and aide_demandee(m, ALF)
        and personnes_a_charge(m, pac) and territoire(m, zone_geo);
    then forfait_charges_foyer(m, forfait_charges_foyer_calcule(pac, zone_geo));
}

@source(CCH_D842_15, CCH_D842_15_ED2019_12, CCH_D842_15_ED2020_01,
        CCH_D842_15_ED2021_01, CCH_D842_15_ED2023_04, CCH_D842_15_ED2023_09,
        CCH_D842_15_ED2023_12, CCH_D842_15_ED2026_07, ARR_ART40_ED2019_10,
        ARR_ART40_ED2020_01, ARR_ART40_ED2020_10, ARR_ART40_ED2021_01,
        ARR_ART40_ED2021_10, ARR_ART40_ED2022_01, ARR_ART46_ED2023_01,
        ARR_ART40_ED2025_10, ARR_ART46_ED2025_10,
        ARR_ART40_ED2026_10, ARR_ART46_ED2026_10)
rule ForfaitChargesFoyerALS(m: Menage, pac: Integer, zone_geo: Territoire) strict {
    label fr official "C est le montant forfaitaire au titre des charges, fixé par arrêté en fonction de la composition familiale";
    label ru unofficial "C: форфейт расходов по составу домохозяйства (ALS)";
    when secteur_logement_foyer(m) and aide_demandee(m, ALS)
        and personnes_a_charge(m, pac) and territoire(m, zone_geo);
    then forfait_charges_foyer(m, forfait_charges_foyer_calcule(pac, zone_geo));
}

@source(CCH_D842_15, CCH_D842_15_ED2019_12, CCH_D842_15_ED2020_01,
        CCH_D842_15_ED2021_01, CCH_D842_15_ED2023_04,
        CCH_D842_15_ED2023_09, CCH_D842_15_ED2023_12,
        CCH_D842_15_ED2026_07, CCH_D832_26, CCH_D832_26_ED2019_12,
        CCH_D832_26_ED2020_01, CCH_D832_26_ED2021_01,
        CCH_D832_26_ED2023_04, CCH_D832_26_ED2023_09,
        CCH_D832_26_ED2023_12, CCH_D832_26_ED2026_07, ARR_ART31_ED2019_10,
        ARR_ART31_ED2020_01, ARR_ART31_ED2020_10, ARR_ART31_ED2021_01,
        ARR_ART31_ED2021_10, ARR_ART31_ED2022_01)
rule LoyerMinimalALFAvantJuillet2022(m: Menage, situation: SituationFamiliale, pac: Integer,
                     ressources: Money) strict {
    label fr official "L0 est le loyer minimal; il est calculé selon les dispositions du deuxième alinéa de l'article D. 832-26, dans lequel il se substitue à E0";
    label ru unofficial "L0 до июля 2022 года: единая таблица транш ст. 31 (ALF)";
    effective [@2019-10-02, @2022-07-01);
    when secteur_logement_foyer(m) and aide_demandee(m, ALF)
        and situation_familiale(m, situation) and personnes_a_charge(m, pac)
        and ressources_retenues(m, ressources);
    then loyer_minimal(m, loyer_minimal_avant_2022(situation, pac, ressources));
}

@source(CCH_D842_15, CCH_D842_15_ED2019_12, CCH_D842_15_ED2020_01,
