        ARR_ART44_ED2024_10, ARR_ART44_ED2025_01, ARR_ART44_ED2025_10)
rule DepenseNetteMinimaleALF(m: Menage) strict {
    label fr official "lorsque sa valeur est inférieure à un montant fixé par arrêté, l'abattement sur le montant mensuel de l'aide est égal à la différence constatée";
    label ru unofficial "минимум чистого расхода аллокации: ниже него аббатмент равен разнице (ALF)";
    when secteur_logement_foyer(m) and aide_demandee(m, ALF);
    then depense_nette_minimale(m, depense_nette_minimale_al_foyer());
}

