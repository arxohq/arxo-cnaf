@source(CCH_D842_16, CCH_D842_16_ED2019_12, CCH_D842_16_ED2020_01,
        CCH_D842_16_ED2021_01, CCH_D842_16_ED2023_04, CCH_D842_16_ED2023_09,
        CCH_D842_16_ED2023_12, CCH_D842_16_ED2026_07, ARR_ART43_ED2019_10,
        ARR_ART43_ED2020_01, ARR_ART43_ED2020_10, ARR_ART43_ED2021_01,
        ARR_ART43_ED2021_10, ARR_ART43_ED2022_01, ARR_ART43_ED2025_10,
        ARR_ART43_ED2026_10)
rule EquivalenceLoyerRetenueALF(m: Menage, categorie: CategorieEquivalenceLoyer,
                                situation: SituationFamiliale) strict {
    label fr official "un arrêté fixe l'équivalence de loyer L pour chacune des catégories de personnes résidant dans un logement-foyer";
    label ru unofficial "L: эквивалентность найма по категории проживающего (ALF)";
    when secteur_logement_foyer(m) and aide_demandee(m, ALF)
        and categorie_equivalence_loyer(m, categorie)
        and situation_familiale(m, situation);
    then equivalence_loyer_retenue(m, equivalence_loyer_categorie(categorie, situation));
}

