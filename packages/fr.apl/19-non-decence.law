        CCH_R843_6_ED2026_07)
rule OuvertureMaintienExceptionnelRechercheLogement(m: Menage, o: Organisme) defeasible {
    label fr official "recherche positive ou mediation saisie : maintien possible une fois R. 843-6 5";
    label en unofficial "positive search or seized mediation: maintenance possible once under R. 843-6 5";
    when conservation_en_cours(m) and preuve_recherche_logement_ou_mediation(m)
        and organisme_debiteur(o, m)
        and not_known(allocation_maintenue_exceptionnelle(m));
    then liberty MaintienExceptionnelRechercheLogement {
