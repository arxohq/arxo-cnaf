rule OuvertureMaintienExceptionnelImpayeL8242(m: Menage, o: Organisme) defeasible {
    label fr official "impaye constate par l'organisme avec maintien L. 824-2 : maintien possible une fois R. 843-6 4";
    label en unofficial "organism-established arrears with L. 824-2 maintenance: maintenance possible once under R. 843-6 4";
    when conservation_en_cours(m) and impaye_depense_logement(m)
        and versement_maintenu_impaye(m) and organisme_debiteur(o, m)
        and not_known(allocation_maintenue_exceptionnelle(m));
    then liberty MaintienExceptionnelImpayeL8242 {
        holder o;
        action allocation_maintenue_exceptionnelle(m);
        window [@2021-01-01, infinity);
    };
}

@source(CCH_L843_3, CCH_L843_3_ED2019_12, CCH_L843_3_ED2020_01,
