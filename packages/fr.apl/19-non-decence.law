deadline policy APL_CONSERVATION_MOIS {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}

pub relation constat_non_decence(m: Menage, d: Date) kind empirical {
    label fr official "constat de non-decence L. 822-9 par l'organisme ou habilite (fait date)";
    label en unofficial "L. 822-9 non-decency finding by the body or approved agent (dated fact)";
}

pub relation patrimoine_dix_logements_ou_plus(m: Menage) kind empirical {
    label fr official "logement dans un patrimoine d'au moins dix logements L. 843-7 (constat)";
    label en unofficial "dwelling in a ten-dwelling-or-more portfolio under L. 843-7 (finding)";
}

pub relation proprietaire_gestionnaire_qualifie_843_7(m: Menage) kind empirical {
    label fr official "proprietaire ou gestionnaire HLM, SEM sociale, agree L. 365-1 ou houilleres Nord-Pas-de-Calais L. 843-7 (constat)";
    label en unofficial "HLM, social SEM, L. 365-1 approved or Nord-Pas-de-Calais coal-board owner or manager under L. 843-7 (finding)";
}

pub relation convention_etat_conformite_843_7(m: Menage) kind empirical {
    label fr official "convention avec l'Etat pour rendre le logement decent dans un delai fixe (fait)";
    label en unofficial "State convention to make the dwelling decent within a fixed delay (fact)";
}

pub relation copie_convention_transmise_organisme(m: Menage) kind empirical {
    label fr official "copie de la convention adressee aux organismes payeurs L. 843-7 (execution)";
    label en unofficial "convention copy sent to the paying bodies under L. 843-7 (performance)";
}

pub relation copie_convention_transmise_le(m: Menage, d: Date) kind empirical {
    label fr official "date de transmission de la convention a l'organisme payeur (dossier)";
    label en unofficial "convention transmission date to the paying body (case file)";
}

pub relation continuation_perception_l843_7(m: Menage) kind institutional {
    label fr official "le bailleur continue de percevoir l'allocation par derogation L. 843-7";
    label en unofficial "the landlord keeps receiving the allocation by L. 843-7 derogation";
}

pub relation conservation_en_cours(m: Menage) kind institutional {
    label fr official "allocation conservee par l'organisme L. 843-1";
    label en unofficial "allocation kept by the body under L. 843-1";
}

pub relation allocation_due_conservation(m: Menage, a: Money) kind empirical {
    label fr official "allocation mensuelle due sous conservation (mesure)";
    label en unofficial "monthly allocation due under conservation (measured)";
}

@source(CCH_L843_1, CCH_L843_1_ED2019_12, CCH_L843_1_ED2020_01,
        CCH_L843_1_ED2021_01, CCH_L843_1_ED2023_04, CCH_L843_1_ED2023_09,
        CCH_L843_1_ED2023_12, CCH_L843_1_ED2026_07, CCH_L843_7,
        CCH_L843_7_ED2019_12, CCH_L843_7_ED2020_01, CCH_L843_7_ED2021_01,
        CCH_L843_7_ED2023_04, CCH_L843_7_ED2023_09, CCH_L843_7_ED2023_12,
        CCH_L843_7_ED2026_07)
rule ConservationDeclencheeALF(m: Menage, constat: Date) defeasible {
    label fr official "constat de non-decense : l'ALF est conservee, sauf continuation L. 843-7";
    label en unofficial "non-decency finding: ALF is kept, barring L. 843-7 continuation";
    when constat_non_decence(m, constat) and aide_attribuee(m, ALF);
    unless continuation_perception_l843_7(m);
    then conservation_en_cours(m);
}

@source(CCH_L843_1, CCH_L843_1_ED2019_12, CCH_L843_1_ED2020_01,
        CCH_L843_1_ED2021_01, CCH_L843_1_ED2023_04, CCH_L843_1_ED2023_09,
        CCH_L843_1_ED2023_12, CCH_L843_1_ED2026_07, CCH_L843_7,
        CCH_L843_7_ED2019_12, CCH_L843_7_ED2020_01, CCH_L843_7_ED2021_01,
        CCH_L843_7_ED2023_04, CCH_L843_7_ED2023_09, CCH_L843_7_ED2023_12,
        CCH_L843_7_ED2026_07)
rule ConservationDeclencheeALS(m: Menage, constat: Date) defeasible {
    label fr official "constat de non-decense : l'ALS est conservee, sauf continuation L. 843-7";
    label en unofficial "non-decency finding: ALS is kept, barring L. 843-7 continuation";
    when constat_non_decence(m, constat) and aide_attribuee(m, ALS);
    unless continuation_perception_l843_7(m);
    then conservation_en_cours(m);
}

@source(CCH_L843_7, CCH_L843_7_ED2019_12, CCH_L843_7_ED2020_01,
        CCH_L843_7_ED2021_01, CCH_L843_7_ED2023_04, CCH_L843_7_ED2023_09,
        CCH_L843_7_ED2023_12, CCH_L843_7_ED2026_07)
rule ExceptionContinuationL843_7(m: Menage) strict {
    label fr official "patrimoine de dix logements, qualifie, convention transmise : le bailleur continue de percevoir";
    label en unofficial "ten-dwelling portfolio, qualified, convention sent: the landlord keeps receiving";
    when patrimoine_dix_logements_ou_plus(m) and proprietaire_gestionnaire_qualifie_843_7(m)
        and convention_etat_conformite_843_7(m) and copie_convention_transmise_organisme(m);
    then continuation_perception_l843_7(m);
}

@source(CCH_L843_7, CCH_L843_7_ED2019_12, CCH_L843_7_ED2020_01,
        CCH_L843_7_ED2021_01, CCH_L843_7_ED2023_04, CCH_L843_7_ED2023_09,
        CCH_L843_7_ED2023_12, CCH_L843_7_ED2026_07)
rule TransmissionConventionVautConstat(m: Menage, d: Date) strict {
    label fr official "la transmission de la convention vaut constat de mise en conformite L. 843-1 a L. 843-4";
    label en unofficial "the convention transmission counts as a compliance finding for L. 843-1 to L. 843-4";
    when copie_convention_transmise_organisme(m) and copie_convention_transmise_le(m, d);
    then mise_en_conformite_etablie(m, d);
}

@source(CCH_L843_7, CCH_L843_7_ED2019_12, CCH_L843_7_ED2020_01,
        CCH_L843_7_ED2021_01, CCH_L843_7_ED2023_04, CCH_L843_7_ED2023_09,
        CCH_L843_7_ED2023_12, CCH_L843_7_ED2026_07)
rule DevoirAdresserCopieConvention(m: Menage, b: Bailleur, o: Organisme) strict {
    label fr official "le bailleur adresse une copie de la convention aux organismes payeurs";
    label en unofficial "the landlord sends a convention copy to the paying bodies";
    when convention_etat_conformite_843_7(m) and bailleur_du_menage(b, m)
        and role_tiers(b, BAILLEUR) and organisme_debiteur(o, m);
    then duty AdresserCopieConvention {
        bearer b;
        beneficiary o;
        maintain copie_convention_transmise_organisme(m) during [@2021-01-01, infinity);
    };
}

pub relation proprietaire_notifie_constat(m: Menage) kind empirical {
    label fr official "proprietaire notifie du constat et de la mise en conformite requise (execution)";
    label en unofficial "owner notified of the finding and required compliance (performance)";
}

@source(CCH_L843_1, CCH_L843_1_ED2019_12, CCH_L843_1_ED2020_01,
        CCH_L843_1_ED2021_01, CCH_L843_1_ED2023_04, CCH_L843_1_ED2023_09,
        CCH_L843_1_ED2023_12, CCH_L843_1_ED2026_07)
rule DevoirNotifierProprietaire(m: Menage, o: Organisme, b: Bailleur) strict {
    label fr official "l'organisme notifie le constat au proprietaire et l'informe de la conformite requise";
    label en unofficial "the body notifies the owner of the finding and required compliance";
    when conservation_en_cours(m) and organisme_debiteur(o, m)
        and bailleur_du_menage(b, m) and role_tiers(b, BAILLEUR);
    then duty NotifierProprietaireConstat {
        bearer o;
        beneficiary b;
        maintain proprietaire_notifie_constat(m) during [@2021-01-01, infinity);
    };
}

pub relation locataire_informe_montant(m: Menage) kind empirical {
    label fr official "locataire informe du montant des allocations par l'organisme (execution)";
    label en unofficial "tenant told the allocation amount by the body (performance)";
}

pub relation loyer_du_reduit(m: Menage, r: Money) kind institutional {
    label fr official "loyer et charges diminués du montant des allocations pendant la conservation";
    label en unofficial "rent and charges minus the allocation amount during conservation";
}

pub relation non_resiliation_bail_non_decence(m: Menage) kind institutional {
    label fr official "pas de resiliation pour la diminution legale du loyer (effet d'immunite)";
    label en unofficial "no termination for the lawful rent reduction (immunity effect)";
}

@source(CCH_L843_1, CCH_L843_1_ED2019_12, CCH_L843_1_ED2020_01,
        CCH_L843_1_ED2021_01, CCH_L843_1_ED2023_04, CCH_L843_1_ED2023_09,
        CCH_L843_1_ED2023_12, CCH_L843_1_ED2026_07)
rule LoyerReduitConservation(m: Menage, loyer: Money, charges: Money, allocation: Money) defeasible {
    label fr official "le locataire s'acquitte du loyer et des charges diminues de l'allocation";
    label en unofficial "the tenant pays rent and charges minus the allocation";
    when conservation_en_cours(m) and loyer_principal(m, loyer)
        and charges_recuperables(m, charges) and allocation_due_conservation(m, allocation)
        and locataire_informe_montant(m);
    then loyer_du_reduit(m, loyer + charges - allocation);
}

@source(CCH_L843_1, CCH_L843_1_ED2019_12, CCH_L843_1_ED2020_01,
        CCH_L843_1_ED2021_01, CCH_L843_1_ED2023_04, CCH_L843_1_ED2023_09,
        CCH_L843_1_ED2023_12, CCH_L843_1_ED2026_07)
rule ImmuniteNonResiliation(m: Menage, b: Bailleur, r: Money) strict {
    label fr official "la diminution legale ne fonde aucune resiliation du bail";
    label en unofficial "the lawful reduction founds no lease termination";
    when loyer_du_reduit(m, r) and bailleur_du_menage(b, m);
    then immunity NonResiliationBailNonDecence {
        holder m;
        against b;
        protected_effect non_resiliation_bail_non_decence(m);
        window [@2021-01-01, infinity);
    };
}

pub relation non_decence_persiste(m: Menage) kind empirical {
    label fr official "logement toujours non decent a l'issue du delai (constat)";
    label en unofficial "dwelling still non-decent past the deadline (finding)";
}

pub relation conservation_non_recouvrable(m: Menage) kind institutional {
    label fr official "allocation conservee non recuperee par le proprietaire L. 843-2";
    label en unofficial "kept allocation unrecovered by the owner under L. 843-2";
}

pub relation non_recours_proprietaire_loyer(m: Menage) kind institutional {
    label fr official "pas de demande au locataire de la part de loyer non percue (effet d'immunite)";
    label en unofficial "no owner claim on the tenant for the unpaid rent share (immunity effect)";
}

pub relation travaux_office_police(m: Menage) kind empirical {
    label fr official "travaux realises d'office par mesure de police L. 843-2 al. 2 (constat)";
    label en unofficial "works done officially under a police measure (finding)";
}

@source(CCH_L843_2, CCH_L843_2_ED2019_12, CCH_L843_2_ED2020_01,
        CCH_L843_2_ED2021_01, CCH_L843_2_ED2023_04, CCH_L843_2_ED2023_09,
        CCH_L843_2_ED2023_12, CCH_L843_2_ED2026_07, CCH_R843_2,
        CCH_R843_2_ED2019_12, CCH_R843_2_ED2020_01, CCH_R843_2_ED2021_01,
        CCH_R843_2_ED2023_04, CCH_R843_2_ED2023_09, CCH_R843_2_ED2023_12,
        CCH_R843_2_ED2026_07)
rule NonRecouvrementDelaiExpire(m: Menage, constat: Date, appreciation: Date) defeasible {
    label fr official "delai de dix-huit mois expire sans conformite : non recupere par le proprietaire";
    label en unofficial "eighteen months expired unconformed: unrecovered by the owner";
    when constat_non_decence(m, constat) and date_appreciation(m, appreciation)
        and appreciation >= add_calendar_period(constat, 18 calendar_month)
        and non_decence_persiste(m);
    unless locataire_successeur_843_4(m);
    then conservation_non_recouvrable(m);
}

@source(CCH_L843_2, CCH_L843_2_ED2019_12, CCH_L843_2_ED2020_01,
        CCH_L843_2_ED2021_01, CCH_L843_2_ED2023_04, CCH_L843_2_ED2023_09,
        CCH_L843_2_ED2023_12, CCH_L843_2_ED2026_07)
rule NonRecouvrementTravauxOffice(m: Menage) defeasible {
    label fr official "travaux d'office : meme non recuperation par le proprietaire";
    label en unofficial "official works: same non-recovery by the owner";
    when travaux_office_police(m) and conservation_en_cours(m);
    then conservation_non_recouvrable(m);
}

@source(CCH_L843_2, CCH_L843_2_ED2019_12, CCH_L843_2_ED2020_01,
        CCH_L843_2_ED2021_01, CCH_L843_2_ED2023_04, CCH_L843_2_ED2023_09,
        CCH_L843_2_ED2023_12, CCH_L843_2_ED2026_07)
rule ImmuniteNonRecoursProprietaire(m: Menage, b: Bailleur) strict {
    label fr official "le proprietaire ne peut demander au locataire la part non percue";
    label en unofficial "the owner cannot claim the unpaid share from the tenant";
    when conservation_non_recouvrable(m) and bailleur_du_menage(b, m);
    then immunity NonRecoursProprietaireLoyer {
        holder m;
        against b;
        protected_effect non_recours_proprietaire_loyer(m);
        window [@2021-01-01, infinity);
    };
}

pub relation preuve_travaux_engages_6mois(m: Menage) kind empirical {
    label fr official "le proprietaire prouve des travaux engages en vue d'un achevement en six mois R. 843-6 1 (constat)";
    label en unofficial "the owner proves engaged works toward six-month completion under R. 843-6 1 (finding)";
}

pub relation preuve_travaux_delai_supplementaire(m: Menage) kind empirical {
    label fr official "renouvellement 1 : travaux exigeant un delai superieur ou retard non imputable prouve (constat)";
    label en unofficial "1 renewal: proven longer need or unattributable delay (finding)";
}

pub relation action_justice_article6_en_cours(m: Menage) kind empirical {
    label fr official "action en justice du locataire sur l'article 6 de la loi 89-462 toujours en cours R. 843-6 2 (constat)";
    label en unofficial "tenant court action on 1989 act article 6 still pending under R. 843-6 2 (finding)";
}

pub relation allocation_hors_charges_843(m: Menage, a: Money) kind empirical {
    label fr official "allocation hors charges pour le cas R. 843-6 3 (mesure)";
    label en unofficial "allocation net of charges for the R. 843-6 3 case (measured)";
}

pub relation dernier_loyer_brut_843(m: Menage, l: Money) kind empirical {
    label fr official "dernier loyer brut hors charges connu de l'organisme pour le cas R. 843-6 3 (mesure)";
    label en unofficial "last gross rent net of charges known to the body for the R. 843-6 3 case (measured)";
}

pub relation preuve_incapacite_demarches_2_5(m: Menage) kind empirical {
    label fr official "renouvellement 3 : allocataire manifestement hors d'etat d'entreprendre les demarches 2 ou 5 (constat)";
    label en unofficial "3 renewal: claimant manifestly unable to take the 2 or 5 steps (finding)";
}

pub relation preuve_recherche_logement_ou_mediation(m: Menage) kind empirical {
    label fr official "actes positifs recents de recherche ou saisine de la commission de mediation L. 441-2-3 R. 843-6 5 (constat)";
    label en unofficial "positive recent search acts or L. 441-2-3 mediation seizure under R. 843-6 5 (finding)";
}

pub relation preuve_incapacite_trouver_logement(m: Menage) kind empirical {
    label fr official "locataire manifestement hors d'etat de trouver un logement R. 843-6 5 (constat)";
    label en unofficial "tenant manifestly unable to find a dwelling under R. 843-6 5 (finding)";
}

pub relation loyer_refixe_juge_843(m: Menage) kind empirical {
    label fr official "nouveau loyer fixe par le juge pour le recalcul L. 843-3 (constat)";
    label en unofficial "new judicially fixed rent for the L. 843-3 recalculation (finding)";
}

pub relation montant_loyer_refixe_juge_843(m: Menage, r: Money) kind empirical {
    key(m);
    label fr official "montant du nouveau loyer fixe par le juge pour le recalcul L. 843-3 (mesure)";
    label en unofficial "amount of the new judicially fixed rent for the L. 843-3 recalculation (measured)";
}

pub relation allocation_recalculee_loyer_juge_843(m: Menage) kind institutional {
    label fr official "allocation recalculee sur le loyer fixe par le juge L. 843-3";
    label en unofficial "allocation recalculated on the judicially fixed rent under L. 843-3";
}

pub relation renouvellement_maintien_deja_accorde(m: Menage) kind empirical {
    label fr official "renouvellement du maintien deja accorde une fois L. 843-3 (execution)";
    label en unofficial "maintenance renewal already granted once under L. 843-3 (performance)";
}

pub relation renouvellement_maintien_accorde(m: Menage) kind institutional {
    label fr official "renouvellement unique du maintien de six mois accorde L. 843-3";
    label en unofficial "single six-month maintenance renewal granted under L. 843-3";
}

pub relation renouvellement_accorde_le(m: Menage, d: Date) kind empirical {
    label fr official "date d'effet du renouvellement du maintien (dossier)";
    label en unofficial "maintenance-renewal start date (case file)";
}

pub relation maintien_renouvele_expire_le(m: Menage, d: Date) kind institutional {
    label fr official "echeance du maintien renouvele de six mois";
    label en unofficial "renewed six-month maintenance expiry";
}

pub relation allocation_maintenue_exceptionnelle(m: Menage) kind empirical {
    label fr official "allocation maintenue a titre exceptionnel L. 843-3 (execution)";
    label en unofficial "allocation exceptionally maintained under L. 843-3 (performance)";
}

@source(CCH_L843_3, CCH_L843_3_ED2019_12, CCH_L843_3_ED2020_01,
        CCH_L843_3_ED2021_01, CCH_L843_3_ED2023_04, CCH_L843_3_ED2023_09,
        CCH_L843_3_ED2023_12, CCH_L843_3_ED2026_07, CCH_R843_6,
        CCH_R843_6_ED2019_12, CCH_R843_6_ED2020_01, CCH_R843_6_ED2021_01,
        CCH_R843_6_ED2023_04, CCH_R843_6_ED2023_09, CCH_R843_6_ED2023_12,
        CCH_R843_6_ED2026_07)
rule OuvertureMaintienExceptionnelTravaux(m: Menage, o: Organisme) defeasible {
    label fr official "travaux prouves en vue d'un achevement en six mois : maintien possible une fois R. 843-6 1";
    label en unofficial "proven works toward six-month completion: maintenance possible once under R. 843-6 1";
    when conservation_en_cours(m) and preuve_travaux_engages_6mois(m)
        and organisme_debiteur(o, m)
        and not_known(allocation_maintenue_exceptionnelle(m));
    then liberty MaintienExceptionnelTravaux {
        holder o;
        action allocation_maintenue_exceptionnelle(m);
        window [@2021-01-01, infinity);
    };
}

@source(CCH_L843_3, CCH_L843_3_ED2019_12, CCH_L843_3_ED2020_01,
        CCH_L843_3_ED2021_01, CCH_L843_3_ED2023_04, CCH_L843_3_ED2023_09,
        CCH_L843_3_ED2023_12, CCH_L843_3_ED2026_07, CCH_R843_6,
        CCH_R843_6_ED2019_12, CCH_R843_6_ED2020_01, CCH_R843_6_ED2021_01,
        CCH_R843_6_ED2023_04, CCH_R843_6_ED2023_09, CCH_R843_6_ED2023_12,
        CCH_R843_6_ED2026_07)
rule OuvertureMaintienExceptionnelActionJustice(m: Menage, o: Organisme) defeasible {
    label fr official "action en justice sur l'article 6 en cours : maintien possible une fois R. 843-6 2";
    label en unofficial "pending article-6 court action: maintenance possible once under R. 843-6 2";
    when conservation_en_cours(m) and action_justice_article6_en_cours(m)
        and organisme_debiteur(o, m)
        and not_known(allocation_maintenue_exceptionnelle(m));
    then liberty MaintienExceptionnelActionJustice {
        holder o;
        action allocation_maintenue_exceptionnelle(m);
        window [@2021-01-01, infinity);
    };
}

@source(CCH_L843_3, CCH_L843_3_ED2019_12, CCH_L843_3_ED2020_01,
        CCH_L843_3_ED2021_01, CCH_L843_3_ED2023_04, CCH_L843_3_ED2023_09,
        CCH_L843_3_ED2023_12, CCH_L843_3_ED2026_07, CCH_R843_6,
        CCH_R843_6_ED2019_12, CCH_R843_6_ED2020_01, CCH_R843_6_ED2021_01,
        CCH_R843_6_ED2023_04, CCH_R843_6_ED2023_09, CCH_R843_6_ED2023_12,
        CCH_R843_6_ED2026_07)
rule OuvertureMaintienExceptionnelAllocationPreponderante(m: Menage, o: Organisme, a: Money, l: Money) defeasible {
    label fr official "allocation hors charges de plus de la moitie du dernier loyer brut : maintien possible une fois R. 843-6 3";
    label en unofficial "allocation net of charges above half the last gross rent: maintenance possible once under R. 843-6 3";
    when conservation_en_cours(m) and allocation_hors_charges_843(m, a)
        and dernier_loyer_brut_843(m, l) and a * 2 > l
        and organisme_debiteur(o, m)
        and not_known(allocation_maintenue_exceptionnelle(m));
    then liberty MaintienExceptionnelAllocationPreponderante {
        holder o;
        action allocation_maintenue_exceptionnelle(m);
        window [@2021-01-01, infinity);
    };
}

@source(CCH_L843_3, CCH_L843_3_ED2019_12, CCH_L843_3_ED2020_01,
        CCH_L843_3_ED2021_01, CCH_L843_3_ED2023_04, CCH_L843_3_ED2023_09,
        CCH_L843_3_ED2023_12, CCH_L843_3_ED2026_07, CCH_R843_6,
        CCH_R843_6_ED2019_12, CCH_R843_6_ED2020_01, CCH_R843_6_ED2021_01,
