pub enum CategorieALF {
    label fr official "categories de beneficiaires de l'ALF (art. L. 841-1 1 a 6)";
    label en unofficial "ALF recipient household categories (art. L. 841-1 1-6)";
    ALF_PRESTATIONS_FAMILIALES, ALF_ENFANT_CHARGE_SANS_PF, ALF_NOUVEAUX_MARIES,
    ALF_ASCENDANT_AGE, ALF_PROCHE_HANDICAPE, ALF_GROSSESSE_SEULE
}

pub relation categorie_alf(m: Menage, c: CategorieALF) kind institutional {
    label fr official "le menage releve de la categorie visee de l'article L. 841-1";
    label en unofficial "the household falls under the cited L. 841-1 category";
}

pub relation percoit_allocations_familiales(m: Menage, oui: Boolean) kind empirical {
    label fr official "perception des allocations familiales L. 511-1 2 (constat explicite)";
    label en unofficial "family allowances receipt L. 511-1 2 (explicit finding)";
}

pub relation percoit_complement_familial(m: Menage, oui: Boolean) kind empirical {
    label fr official "perception du complement familial L. 511-1 3 (constat explicite)";
    label en unofficial "complement familial receipt L. 511-1 3 (explicit finding)";
}

pub relation percoit_aeeh(m: Menage, oui: Boolean) kind empirical {
    label fr official "perception de l'AEEH L. 511-1 5 (constat explicite)";
    label en unofficial "AEEH receipt L. 511-1 5 (explicit finding)";
}

pub relation percoit_asf(m: Menage, oui: Boolean) kind empirical {
    label fr official "perception de l'ASF L. 511-1 6 (constat explicite)";
    label en unofficial "ASF receipt L. 511-1 6 (explicit finding)";
}

@source(CCH_L841_1, CCH_L841_1_ED2019_12, CCH_L841_1_ED2020_01,
        CCH_L841_1_ED2021_01, CCH_L841_1_ED2023_04, CCH_L841_1_ED2023_09,
        CCH_L841_1_ED2023_12, CCH_L841_1_ED2026_07)
rule CategorieALFAllocationsFamiliales(m: Menage) strict {
    label fr official "allocataires des allocations familiales : ALF 1 a)";
    label en unofficial "family-allowance recipients: ALF 1 a)";
    when percoit_allocations_familiales(m, true);
    then categorie_alf(m, ALF_PRESTATIONS_FAMILIALES);
}

@source(CCH_L841_1, CCH_L841_1_ED2019_12, CCH_L841_1_ED2020_01,
        CCH_L841_1_ED2021_01, CCH_L841_1_ED2023_04, CCH_L841_1_ED2023_09,
        CCH_L841_1_ED2023_12, CCH_L841_1_ED2026_07)
rule CategorieALFComplementFamilial(m: Menage) strict {
    label fr official "allocataires du complement familial : ALF 1 b)";
    label en unofficial "complement-familial recipients: ALF 1 b)";
    when percoit_complement_familial(m, true);
    then categorie_alf(m, ALF_PRESTATIONS_FAMILIALES);
}

@source(CCH_L841_1, CCH_L841_1_ED2019_12, CCH_L841_1_ED2020_01,
        CCH_L841_1_ED2021_01, CCH_L841_1_ED2023_04, CCH_L841_1_ED2023_09,
        CCH_L841_1_ED2023_12, CCH_L841_1_ED2026_07)
rule CategorieALFAeeh(m: Menage) strict {
    label fr official "allocataires de l'AEEH : ALF 1 c)";
    label en unofficial "AEEH recipients: ALF 1 c)";
    when percoit_aeeh(m, true);
    then categorie_alf(m, ALF_PRESTATIONS_FAMILIALES);
}

@source(CCH_L841_1, CCH_L841_1_ED2019_12, CCH_L841_1_ED2020_01,
        CCH_L841_1_ED2021_01, CCH_L841_1_ED2023_04, CCH_L841_1_ED2023_09,
        CCH_L841_1_ED2023_12, CCH_L841_1_ED2026_07)
rule CategorieALFAsf(m: Menage) strict {
    label fr official "allocataires de l'ASF : ALF 1 d)";
    label en unofficial "ASF recipients: ALF 1 d)";
    when percoit_asf(m, true);
    then categorie_alf(m, ALF_PRESTATIONS_FAMILIALES);
}

pub relation enfant_charge_l512_3(m: Menage) kind empirical {
    label fr official "enfant a charge au sens de l'article L. 512-3 CSS (constat)";
    label en unofficial "dependent child under CSS L. 512-3 (finding)";
}

pub relation sans_droit_prestations_alf1(m: Menage) kind empirical {
    label fr official "aucun droit a l'une des prestations enumerees au 1 de l'art. L. 841-1 (constat juridique : n'ayant pas droit)";
    label en unofficial "no legal right to any L. 841-1 1 benefit (legal finding: n'ayant pas droit)";
}

@source(CCH_L841_1, CCH_L841_1_ED2019_12, CCH_L841_1_ED2020_01,
        CCH_L841_1_ED2021_01, CCH_L841_1_ED2023_04, CCH_L841_1_ED2023_09,
        CCH_L841_1_ED2023_12, CCH_L841_1_ED2026_07)
rule CategorieALFEnfantCharge(m: Menage) strict {
    label fr official "enfant a charge, n'ayant pas droit aux prestations du 1 : ALF 2";
    label en unofficial "dependent child with no legal right to the 1 benefits: ALF 2";
    when enfant_charge_l512_3(m) and sans_droit_prestations_alf1(m);
    then categorie_alf(m, ALF_ENFANT_CHARGE_SANS_PF);
}

pub relation menage_nouveaux_maries(m: Menage) kind empirical {
    label fr official "menage sans enfant a charge nouvellement marie (constat ; duree en 14-dates)";
    label en unofficial "newly married childless household (finding; duration in 14-dates)";
}

@source(CCH_L841_1, CCH_L841_1_ED2019_12, CCH_L841_1_ED2020_01,
        CCH_L841_1_ED2021_01, CCH_L841_1_ED2023_04, CCH_L841_1_ED2023_09,
        CCH_L841_1_ED2023_12, CCH_L841_1_ED2026_07)
rule CategorieALFNouveauxMaries(m: Menage) strict {
    label fr official "menages sans enfant a charge a compter du mariage : ALF 3";
