    label fr official "femme seule sans personne a charge enceinte (constat ; fenetre en 14-dates)";
    label en unofficial "lone pregnant woman with no dependents (finding; window in 14-dates)";
}

@source(CCH_L841_1, CCH_L841_1_ED2019_12, CCH_L841_1_ED2020_01,
        CCH_L841_1_ED2021_01, CCH_L841_1_ED2023_04, CCH_L841_1_ED2023_09,
        CCH_L841_1_ED2023_12, CCH_L841_1_ED2026_07)
rule CategorieALFGrossesse(m: Menage) strict {
    label fr official "femme seule enceinte sans personne a charge : ALF 6";
