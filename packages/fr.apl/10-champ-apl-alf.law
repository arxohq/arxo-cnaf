// --- APL dwelling cases (L. 831-1 1-6) -------------------------------------

@source(CCH_L831_1, CCH_L831_1_ED2019_12, CCH_L831_1_ED2020_01,
        CCH_L831_1_ED2021_01, CCH_L831_1_ED2023_04, CCH_L831_1_ED2023_09,
        CCH_L831_1_ED2023_12, CCH_L831_1_ED2026_07)
pub enum CasAPL_L831_1 {
    label fr official "cas d'application de l'aide personnalisee au logement (art. L. 831-1 1 a 6)";
    label en unofficial "APL scope dwelling cases (art. L. 831-1 1-6)";
    APL_PROPRIETAIRE_AIDE_ETAT, APL_HLM_BAILLEUR_CONVENTIONNE,
    APL_LOCATIF_AIDE_ETAT_CONVENTIONNE, APL_LOCATIF_REGLEMENTAIRE_CONVENTIONNE,
    APL_FOYER_ASSIMILE_CONVENTIONNE, APL_LOCATION_ACCESSION_AIDEE
}

pub relation cas_apl_l831_1(m: Menage, c: CasAPL_L831_1) kind empirical {
    label fr official "le logement releve du cas vise de l'article L. 831-1 (constat de l'organisme)";
    label en unofficial "the dwelling falls under the cited L. 831-1 case (agency finding)";
}

// --- APL occupant cases (R. 831-1 1-4) --------------------------------------

@source(CCH_R831_1, CCH_R831_1_ED2019_12, CCH_R831_1_ED2020_01,
        CCH_R831_1_ED2021_01, CCH_R831_1_ED2023_04, CCH_R831_1_ED2023_09,
        CCH_R831_1_ED2023_12, CCH_R831_1_ED2026_07)
pub enum OccupantAPL_R831_1 {
    label fr official "personnes occupantes attributaires de l'APL (art. R. 831-1 1 a 4)";
    label en unofficial "APL recipient occupant cases (art. R. 831-1 1-4)";
    OCC_PROPRIETAIRE_L8311_1, OCC_LOCATIF_CONVENTIONNE_2_3_4,
    OCC_LOCATION_ACCESSION_6, OCC_FOYER_PRIVATIF_5
}

pub relation occupant_apl_r831_1(m: Menage, k: OccupantAPL_R831_1) kind empirical {
    label fr official "le menage occupe au sens du cas vise de l'article R. 831-1 (constat de l'organisme)";
    label en unofficial "the household occupies under the cited R. 831-1 case (agency finding)";
}

pub relation assimile_proprietaire_apl(m: Menage) kind empirical {
    label fr official "assimile au proprietaire R. 831-1 al. 2, vocation a terme ou parts sociales (constat)";
    label en unofficial "deemed owner under R. 831-1 al. 2, future title or company shares (finding)";
}

pub relation eligible_apl(m: Menage) kind institutional {
    label fr official "le menage remplit les conditions de champ de l'APL";
    label en unofficial "the household meets the APL scope conditions";
}

@source(CCH_L831_1, CCH_L831_1_ED2019_12, CCH_L831_1_ED2020_01,
        CCH_L831_1_ED2021_01, CCH_L831_1_ED2023_04, CCH_L831_1_ED2023_09,
        CCH_L831_1_ED2023_12, CCH_L831_1_ED2026_07, CCH_R831_1,
        CCH_R831_1_ED2019_12, CCH_R831_1_ED2020_01, CCH_R831_1_ED2021_01,
        CCH_R831_1_ED2023_04, CCH_R831_1_ED2023_09, CCH_R831_1_ED2023_12,
        CCH_R831_1_ED2026_07)
rule EligibleAPL(m: Menage, c: CasAPL_L831_1,
    k: OccupantAPL_R831_1) defeasible {
    label fr official "cas L. 831-1 joint au cas d'occupation R. 831-1 : champ de l'APL";
    label en unofficial "L. 831-1 case joined with R. 831-1 occupant case: APL scope";
    when cas_apl_l831_1(m, c) and occupant_apl_r831_1(m, k);
    then eligible_apl(m);
}

// --- Post-2017 loan exclusion (L. 831-2) ------------------------------------
// No APL for loans signed after 31.12.2017, except loans signed before
// 01.01.2020 for an old dwelling in a listed non-tense commune. The three
// defeaters fire on the three ways the exception FAILS (positive premises
// only); when the exception holds, all three stay silent.

pub relation pret_apl_date_signature(m: Menage, d: Date) kind empirical {
    label fr official "date de signature du contrat de pret APL (dossier accession)";
    label en unofficial "APL loan contract signature date (accession cases)";
}

pub relation logement_ancien_l831_2(m: Menage, ancien: Boolean) kind empirical {
    label fr official "logement ancien au sens de l'exception L. 831-2 (constat explicite)";
    label en unofficial "old-stock dwelling under the L. 831-2 exception (explicit finding)";
}

pub relation commune_non_tendue_l831_2(m: Menage, non_tendue: Boolean) kind empirical {
    label fr official "commune sur la liste arretee des communes non tendues (constat explicite)";
    label en unofficial "commune on the listed non-tense communes (explicit finding)";
}

@source(CCH_L831_2, CCH_L831_2_ED2019_12, CCH_L831_2_ED2020_01,
        CCH_L831_2_ED2021_01, CCH_L831_2_ED2023_04, CCH_L831_2_ED2023_09,
        CCH_L831_2_ED2023_12, CCH_L831_2_ED2026_07)
rule ExclusionPretSigneApres2017(m: Menage, d: Date) defeater {
    label fr official "L. 831-2 al. 1 : pret signe apres le 31 decembre 2017, pas d'APL sauf exception etablie";
    label en unofficial "L. 831-2 al. 1: loan signed after 31.12.2017, no APL unless the exception holds";
    when pret_apl_date_signature(m, d) and d > @2017-12-31;
    defeat eligible_apl(m);
}

@source(CCH_L831_2, CCH_L831_2_ED2019_12, CCH_L831_2_ED2020_01,
        CCH_L831_2_ED2021_01, CCH_L831_2_ED2023_04, CCH_L831_2_ED2023_09,
        CCH_L831_2_ED2023_12, CCH_L831_2_ED2026_07)
rule ExceptionPret2018AncienNonTendu(m: Menage, c: CasAPL_L831_1, k: OccupantAPL_R831_1, d: Date) defeasible {
    label fr official "L. 831-2 al. 2 : pret 2018-2019, logement ancien en commune non tendue, droit maintenu";
    label en unofficial "L. 831-2 al. 2: 2018-2019 loan, old dwelling in a non-tense commune, right preserved";
    when cas_apl_l831_1(m, c) and occupant_apl_r831_1(m, k)
        and pret_apl_date_signature(m, d) and d >= @2018-01-01 and d < @2020-01-01
        and logement_ancien_l831_2(m, true) and commune_non_tendue_l831_2(m, true);
    then eligible_apl(m);
}

priority ExceptionPret2018OverExclusion {
    prefer ExceptionPret2018AncienNonTendu over ExclusionPretSigneApres2017;
    reason lex_specialis;
}

// --- ALF household categories (L. 841-1 1-6) --------------------------------

@source(CCH_L841_1, CCH_L841_1_ED2019_12, CCH_L841_1_ED2020_01,
        CCH_L841_1_ED2021_01, CCH_L841_1_ED2023_04, CCH_L841_1_ED2023_09,
