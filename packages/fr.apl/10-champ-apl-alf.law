pub relation eligible_alf(m: Menage) kind institutional {
    label fr official "le menage remplit les conditions de champ de l'ALF";
    label en unofficial "the household meets the ALF scope conditions";
}

@source(CCH_L841_1, CCH_L841_1_ED2019_12, CCH_L841_1_ED2020_01,
        CCH_L841_1_ED2021_01, CCH_L841_1_ED2023_04, CCH_L841_1_ED2023_09,
        CCH_L841_1_ED2023_12, CCH_L841_1_ED2026_07)
rule EligibleALF(m: Menage, c: CategorieALF) defeasible {
    label fr official "toute categorie L. 841-1 ouvre le champ de l'ALF (defeasible : L. 841-4)";
    label en unofficial "any L. 841-1 category opens ALF scope (defeasible: L. 841-4)";
    when categorie_alf(m, c);
    then eligible_alf(m);
}

// --- Residual ALS (L. 841-2) + long-stay assimilation (L. 841-3) -------------

pub relation eligible_als(m: Menage) kind institutional {
    label fr official "le menage remplit les conditions de champ de l'ALS (residuelle)";
    label en unofficial "the household meets the residual ALS scope conditions";
}

@source(CCH_L841_2, CCH_L841_2_ED2019_12, CCH_L841_2_ED2020_01,
        CCH_L841_2_ED2021_01, CCH_L841_2_ED2023_04, CCH_L841_2_ED2023_09,
        CCH_L841_2_ED2023_12, CCH_L841_2_ED2026_07)
rule EligibleALSResiduel(m: Menage) defeasible {
    label fr official "l'ALS demandee est residuelle : le champ de l'APL ou de l'ALF l'ecarte";
    label en unofficial "requested ALS is residual: the APL or ALF scope defeats it";
    when aide_demandee(m, ALS);
    then eligible_als(m);
}

// D-79: L. 841-2 makes the ALS residual: "les personnes ne beneficiant pas
// de l'ALF ou de l'APL". The aid is attributed by the fund under the scope
// the household falls into, not by the label of the request, so the household
// that falls within the APL or ALF scope (eligible_apl/eligible_alf, which do
// not read the request) is outside the ALS. Reading aide_attribuee here would
// close a non-stratifiable cycle (§110); eligibility does not.
@source(CCH_L841_2, CCH_L841_2_ED2019_12, CCH_L841_2_ED2020_01,
        CCH_L841_2_ED2021_01, CCH_L841_2_ED2023_04, CCH_L841_2_ED2023_09,
        CCH_L841_2_ED2023_12, CCH_L841_2_ED2026_07)
rule AplAttribueeExclutALS(m: Menage) defeater {
    label fr official "le champ de l'APL exclut l'ALS residuelle (L. 841-2)";
    label en unofficial "the APL scope excludes the residual ALS (L. 841-2)";
    when eligible_apl(m);
    defeat eligible_als(m);
}

@source(CCH_L841_2, CCH_L841_2_ED2019_12, CCH_L841_2_ED2020_01,
        CCH_L841_2_ED2021_01, CCH_L841_2_ED2023_04, CCH_L841_2_ED2023_09,
        CCH_L841_2_ED2023_12, CCH_L841_2_ED2026_07)
rule AlfAttribueeExclutALS(m: Menage) defeater {
    label fr official "le champ de l'ALF exclut l'ALS residuelle (L. 841-2)";
    label en unofficial "the ALF scope excludes the residual ALS (L. 841-2)";
    when eligible_alf(m);
    defeat eligible_als(m);
}

pub relation resident_usld_l841_3(m: Menage) kind empirical {
    label fr official "resident assimile au sens de l'article L. 841-3 (constat)";
    label en unofficial "resident assimilated under L. 841-3 (finding)";
}

@source(CCH_L841_3, CCH_L841_3_ED2019_12, CCH_L841_3_ED2020_01,
        CCH_L841_3_ED2021_01, CCH_L841_3_ED2023_04, CCH_L841_3_ED2023_09,
        CCH_L841_3_ED2023_12, CCH_L841_3_ED2026_07)
rule AssimilationUSLD(m: Menage) defeasible {
    label fr official "residents assimiles L. 841-3 : champ de l'ALS (defeasible : L. 841-2)";
    label en unofficial "L. 841-3 assimilated residents: ALS scope (defeasible: L. 841-2)";
    when resident_usld_l841_3(m);
    then eligible_als(m);
}

// --- Accession-allocation debts (R. 842-5) + L. 841-4 exclusion ---------------

@source(CCH_R842_5, CCH_R842_5_ED2019_12, CCH_R842_5_ED2020_01,
        CCH_R842_5_ED2021_01, CCH_R842_5_ED2023_04, CCH_R842_5_ED2023_09,
        CCH_R842_5_ED2023_12, CCH_R842_5_ED2026_07)
pub enum DetteAccessionAllocation {
    label fr official "dettes ouvrant le droit a l'allocation en accession (art. R. 842-5 1 a 3)";
    label en unofficial "debts opening allocation rights in accession (art. R. 842-5 1-3)";
    DETTE_ACCESSION_PROPRIETE, DETTE_TRAVAUX_R321_15,
    DETTE_AGRANDISSEMENT_AMENAGEMENT
}

pub relation dette_accession_allocation(m: Menage, d: DetteAccessionAllocation) kind empirical {
    label fr official "dette d'accession relevant du cas vise de l'article R. 842-5 (constat)";
    label en unofficial "accession debt under the cited R. 842-5 case (finding)";
}

pub relation dette_eligible_allocation(m: Menage) kind institutional {
    label fr official "dette eligible a l'allocation en accession";
    label en unofficial "allocation-eligible accession debt";
}

@source(CCH_R842_5, CCH_R842_5_ED2019_12, CCH_R842_5_ED2020_01,
        CCH_R842_5_ED2021_01, CCH_R842_5_ED2023_04, CCH_R842_5_ED2023_09,
        CCH_R842_5_ED2023_12, CCH_R842_5_ED2026_07)
rule DetteEligibleAllocationAccession(m: Menage, d: DetteAccessionAllocation) strict {
    label fr official "tout cas R. 842-5 est une dette eligible (listes externes constatees)";
    label en unofficial "any R. 842-5 case is an eligible debt (external lists as found)";
    when dette_accession_allocation(m, d);
    then dette_eligible_allocation(m);
}

pub relation pret_allocation_date_signature(m: Menage, d: Date) kind empirical {
    label fr official "date de signature du pret d'accession en allocation (dossier)";
    label en unofficial "allocation-accession loan signature date (case file)";
}

@source(CCH_L841_4, CCH_L841_4_ED2019_12, CCH_L841_4_ED2020_01,
        CCH_L841_4_ED2021_01, CCH_L841_4_ED2023_04, CCH_L841_4_ED2023_09,
        CCH_L841_4_ED2023_12, CCH_L841_4_ED2026_07)
rule ExclusionAllocationPretApres2017ALF(m: Menage, ds: Date) defeater {
    label fr official "pret d'accession a la propriete signe apres le 31 decembre 2017 : pas d'ALF (L. 841-4)";
    label en unofficial "ownership-access loan signed after 31.12.2017: no ALF (L. 841-4)";
    when dette_accession_allocation(m, DETTE_ACCESSION_PROPRIETE)
        and pret_allocation_date_signature(m, ds)
        and ds > @2017-12-31;
    defeat eligible_alf(m);
}

@source(CCH_L841_4, CCH_L841_4_ED2019_12, CCH_L841_4_ED2020_01,
        CCH_L841_4_ED2021_01, CCH_L841_4_ED2023_04, CCH_L841_4_ED2023_09,
        CCH_L841_4_ED2023_12, CCH_L841_4_ED2026_07)
rule ExclusionAllocationPretApres2017ALS(m: Menage, ds: Date) defeater {
    label fr official "pret d'accession a la propriete signe apres le 31 decembre 2017 : pas d'ALS (L. 841-4)";
    label en unofficial "ownership-access loan signed after 31.12.2017: no ALS (L. 841-4)";
    when dette_accession_allocation(m, DETTE_ACCESSION_PROPRIETE)
        and pret_allocation_date_signature(m, ds)
        and ds > @2017-12-31;
    defeat eligible_als(m);
}

// --- Family-benefits bridge (L. 821-3) ---------------------------------------

pub relation enfant_beneficiaire_personnel(m: Menage) kind empirical {
    label fr official "un enfant du menage beneficie a titre personnel d'une aide au logement (constat)";
    label en unofficial "a household child personally receives a housing aid (finding)";
}

pub relation exclusion_denombrement_pf(m: Menage) kind institutional {
    label fr official "au moins un enfant du menage est exclu du denombrement des prestations familiales L. 821-3 (resume existentiel, pont pf-core)";
    label en unofficial "at least one household child is out of the family-benefits headcount L. 821-3 (existential summary, pf-core bridge)";
}

pub relation enfant_beneficiaire_aide_personnelle(m: Menage, p: PersonneACharge) kind empirical {
    label fr official "l'enfant p du menage beneficie a titre personnel d'une aide au logement (constat individuel)";
    label en unofficial "household child p personally receives a housing aid (individual finding)";
}

pub relation exclusion_denombrement_pf_enfant(m: Menage, p: PersonneACharge) kind institutional {
    label fr official "l'enfant p n'est pas compte comme enfant a charge pour les prestations familiales (pont pf-core)";
    label en unofficial "child p is not counted as a dependent for family benefits (pf-core bridge)";
}

@source(CCH_L821_3, CCH_L821_3_ED2019_12, CCH_L821_3_ED2020_01,
        CCH_L821_3_ED2021_01, CCH_L821_3_ED2023_04, CCH_L821_3_ED2023_09,
        CCH_L821_3_ED2023_12, CCH_L821_3_ED2026_07)
rule ExclusionDenombrementPF(m: Menage) strict {
    label fr official "un enfant beneficiaire personnel : au moins un enfant exclu du denombrement PF";
    label en unofficial "a personally benefiting child: at least one child out of the PF headcount";
    when enfant_beneficiaire_personnel(m);
    then exclusion_denombrement_pf(m);
}

@source(CCH_L821_3, CCH_L821_3_ED2019_12, CCH_L821_3_ED2020_01,
        CCH_L821_3_ED2021_01, CCH_L821_3_ED2023_04, CCH_L821_3_ED2023_09,
        CCH_L821_3_ED2023_12, CCH_L821_3_ED2026_07)
rule ExclusionDenombrementPFEnfant(m: Menage, p: PersonneACharge) strict {
    label fr official "l'enfant p beneficiaire personnel n'est pas compte pour les prestations familiales";
    label en unofficial "personally benefiting child p is not counted for family benefits";
    when enfant_beneficiaire_aide_personnelle(m, p);
    then exclusion_denombrement_pf_enfant(m, p);
}

@source(CCH_L821_3, CCH_L821_3_ED2019_12, CCH_L821_3_ED2020_01,
        CCH_L821_3_ED2021_01, CCH_L821_3_ED2023_04, CCH_L821_3_ED2023_09,
        CCH_L821_3_ED2023_12, CCH_L821_3_ED2026_07)
rule ExclusionDenombrementPFAgregee(m: Menage, p: PersonneACharge) strict {
    label fr official "un enfant exclu au niveau individuel : le menage porte le resume existentiel (au moins un exclu)";
    label en unofficial "a child excluded at individual level: the household carries the existential summary (at least one excluded)";
    when exclusion_denombrement_pf_enfant(m, p);
    then exclusion_denombrement_pf(m);
}

// --- Pregnancy assimilation for the calculation (R. 841-2) -------------------

pub relation pac_retenues_calcul_alf(m: Menage, n: Integer) kind institutional {
    label fr official "personnes a charge retenues pour le calcul de l'ALF";
    label en unofficial "dependents retained for the ALF calculation";
}

@source(CCH_R841_2, CCH_R841_2_ED2019_12, CCH_R841_2_ED2020_01,
        CCH_R841_2_ED2021_01, CCH_R841_2_ED2023_04, CCH_R841_2_ED2023_09,
        CCH_R841_2_ED2023_12, CCH_R841_2_ED2026_07)
rule PacGrossesseZero(m: Menage) strict {
    label fr official "femme seule enceinte assimilee aux menages sans enfant : zero retenu";
    label en unofficial "lone pregnant woman deemed childless: zero retained";
    when femme_seule_enceinte(m);
    then pac_retenues_calcul_alf(m, 0);
}

@source(CCH_R841_2, CCH_R841_2_ED2019_12, CCH_R841_2_ED2020_01,
        CCH_R841_2_ED2021_01, CCH_R841_2_ED2023_04, CCH_R841_2_ED2023_09,
        CCH_R841_2_ED2023_12, CCH_R841_2_ED2026_07)
rule PacCalculAlfDefaut(m: Menage, n: Integer) strict {
    label fr official "hors grossesse visee : personnes a charge declarees retenues";
    label en unofficial "outside the covered pregnancy: declared dependents retained";
    when personnes_a_charge(m, n) and not_known(femme_seule_enceinte(m));
    then pac_retenues_calcul_alf(m, n);
}