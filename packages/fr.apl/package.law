    label fr official "mensualité déclarée figurant sur le certificat daté des organismes prêteurs";
    label ru unofficial "заявленная мензуальность по сертификату заимодавца";
}

@source(ARR_ART25_ED2019_10, ARR_ART25_ED2020_01, ARR_ART25_ED2020_10,
        ARR_ART25_ED2021_01, ARR_ART25_ED2021_10, ARR_ART25_ED2022_01,
