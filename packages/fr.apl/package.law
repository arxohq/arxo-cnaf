@source(ARR_ART07_ED2021_10, ARR_ART07_ED2022_01, ARR_ART07_ED2025_10)
pub enum Zone {
    label fr official "zone géographique du logement";
    label ru unofficial "географическая зона жилья (I, II, III)";
    ZONE_I, ZONE_II, ZONE_III
}

@source(CCH_L821_1, CCH_L821_1_ED2019_12, CCH_L821_1_ED2020_01,
        CCH_L821_1_ED2021_01, CCH_L821_1_ED2023_04, CCH_L821_1_ED2023_09,
        CCH_L821_1_ED2023_12, CCH_L821_1_ED2026_07)
pub enum TypeAide {
    label fr official "aides personnelles au logement";
    label ru unofficial "виды персональных жилищных пособий";
    APL, ALF, ALS
}

@source(ARR_ART14_ED2021_10, ARR_ART14_ED2022_01, ARR_ART14_ED2025_10)
pub enum SituationFamiliale {
    label fr official "situation familiale retenue par le barème: personne seule ou couple";
    label ru unofficial "состав домохозяйства по барему: одинокое лицо или пара";
    PERSONNE_SEULE, COUPLE
}

@source(CCH_D823_18, CCH_D823_18_ED2019_12, CCH_D823_18_ED2020_01,
        CCH_D823_18_ED2021_01, CCH_D823_18_ED2023_04, CCH_D823_18_ED2023_09,
        CCH_D823_18_ED2023_12, CCH_D823_18_ED2026_07)
pub enum ModeLocation {
    label fr official "location seule ou colocation au sens de l'article D. 823-18";
    label ru unofficial "наём в одиночку или колокация (ст. D. 823-18)";
    LOCATION_SEULE, COLOCATION
}

// Три члена — ровно те случаи, которые различает ст. 8 арретэ: обычное жильё,
// комната и комната пожилого либо взрослого с инвалидностью, размещённого за
// плату у частных лиц. Логическим флагом это не выражается: у комнаты в
// зависимости от размещения РАЗНЫЙ плафон, а у обычного жилья его нет вовсе.
@source(ARR_ART08_ED2021_10, ARR_ART08_ED2022_01, ARR_ART08_ED2025_10)
pub enum FormeLogement {
    label fr official "forme du logement occupé au sens de l'article 8 de l'arrêté";
    label ru unofficial "форма занимаемого жилья по ст. 8 приказа";
    LOGEMENT_ORDINAIRE, CHAMBRE, CHAMBRE_HEBERGEMENT_ONEREUX
}

// Две ветви D. 832-25: общий случай (1°) и фойе молодых работников с
// социальными резиденциями (2°). Различие не логический флаг: у ветвей РАЗНЫЕ
// таблицы долей N, разные множители cm, разный потолок коэффициента K и разный
// минимум чистого расхода. Условие конвенционирования (после 30.09.1990 и
// после 31.12.1994) в модель не введено — оно приходит этим фактом дела.
@source(CCH_D832_25, CCH_D832_25_ED2019_12, CCH_D832_25_ED2020_01,
        CCH_D832_25_ED2021_01, CCH_D832_25_ED2023_04, CCH_D832_25_ED2023_09,
        CCH_D832_25_ED2023_12, CCH_D832_25_ED2026_07)
pub enum TypeLogementFoyer {
    label fr official "logement-foyer relevant du 1° ou du 2° de l'article D. 832-25";
    label ru unofficial "logement-foyer по 1° либо 2° ст. D. 832-25";
    GENERAL, JEUNES_TRAVAILLEURS_OU_RESIDENCE_SOCIALE
}

// Четыре категории D. 842-16, для каждой арретэ называет свою эквивалентность
// найма L: перечень закрыт самой статьёй.
@source(CCH_D842_16, CCH_D842_16_ED2019_12, CCH_D842_16_ED2020_01,
        CCH_D842_16_ED2021_01, CCH_D842_16_ED2023_04, CCH_D842_16_ED2023_09,
        CCH_D842_16_ED2023_12, CCH_D842_16_ED2026_07)
pub enum CategorieEquivalenceLoyer {
    label fr official "catégories de personnes résidant dans un logement-foyer au sens de l'article D. 842-16";
    label ru unofficial "категории проживающих в logement-foyer (ст. D. 842-16)";
    ETUDIANT_CHAMBRE, ETUDIANT_CHAMBRE_REHABILITEE, PERSONNES_AGEES, AUTRES_PERSONNES
}

// Подслучай ст. 18 арретэ выбирается ДАТОЙ ПОДПИСАНИЯ ЗАЙМА — это факт дела, а
// не месяц права, поэтому ось редакций здесь не при чём и винтаж приходит
// перечислением. Перенесены два последних подслучая из восемнадцати; остальные
// в барем не перенесены, и на таком деле плафон не подставится (см. барем).
@source(ARR_ART18_ED2019_10, ARR_ART18_ED2020_01, ARR_ART18_ED2020_10,
        ARR_ART18_ED2021_01, ARR_ART18_ED2021_10, ARR_ART18_ED2022_01,
        ARR_ART18_ED2023_01, ARR_ART18_ED2023_10, ARR_ART18_ED2024_01,
        ARR_ART18_ED2024_10, ARR_ART18_ED2025_01, ARR_ART18_ED2025_10,
        ARR_ART18_ED2022_07)
pub enum SousCasMensualitePlafond {
    label fr official "sous-cas de l'article 18 de l'arrêté selon la date de signature du contrat de prêt";
    label ru unofficial "подслучай ст. 18 приказа по дате подписания займа";
    PRET_APRES_30_09_2017, PRET_APRES_30_09_2019
}

// Три колонки плафонов ст. 18: a) новое, b) расширенное либо приобретённое и
// улучшенное, c) улучшенное собственником-жильцом. Колонка c) есть ТОЛЬКО у
// франковых подслучаев 1°–3°, поэтому у перенесённых винтажей плафона для неё
// нет вовсе — и правило её не производит, а не выдумывает.
@source(ARR_ART18_ED2019_10, ARR_ART18_ED2020_01, ARR_ART18_ED2020_10,
        ARR_ART18_ED2021_01, ARR_ART18_ED2021_10, ARR_ART18_ED2022_01,
        ARR_ART18_ED2023_01, ARR_ART18_ED2023_10, ARR_ART18_ED2024_01,
        ARR_ART18_ED2024_10, ARR_ART18_ED2025_01, ARR_ART18_ED2025_10,
        ARR_ART18_ED2022_07)
pub enum FinaliteOperation {
    label fr official "finalité de l'opération au sens de l'article 18 de l'arrêté";
    label ru unofficial "назначение операции по ст. 18 приказа";
    LOGEMENT_NEUF, LOGEMENT_ACQUIS_AMELIORE, LOGEMENT_AMELIORE_PAR_OCCUPANT
}

// D. 832-15 различает две ветви расчёта L0 по тому, была ли операция связана с
// приобретением: 1° — построенные, расширенные, приобретённые и улучшенные;
// 2° — СУЩЕСТВУЮЩИЕ улучшенные, занимаемые собственником. Признак работ и есть
// этот водораздел, и он независим от колонки плафона.
@source(CCH_D832_15, CCH_D832_15_ED2019_12, CCH_D832_15_ED2020_01,
        CCH_D832_15_ED2021_01, CCH_D832_15_ED2023_04, CCH_D832_15_ED2023_09,
        CCH_D832_15_ED2023_12, CCH_D832_15_ED2026_07)
pub enum TypeTravaux {
    label fr official "nature des travaux au sens de l'article D. 832-15";
    label ru unofficial "характер работ по ст. D. 832-15";
    PAS_DE_TRAVAUX, TRAVAUX_POUR_ACQUISITION, TRAVAUX_SUR_LOGEMENT_DEJA_ACQUIS
}

@source(CCH_D832_16, CCH_D832_16_ED2019_12, CCH_D832_16_ED2020_01,
        CCH_D832_16_ED2021_01, CCH_D832_16_ED2023_04, CCH_D832_16_ED2023_09,
        CCH_D832_16_ED2023_12, CCH_D832_16_ED2026_07)
pub enum ModePropriete {
    label fr official "le demandeur est propriétaire unique ou copropriétaire au sens de l'article D. 832-16";
    label ru unofficial "заявитель — единственный собственник либо сособственник (ст. D. 832-16)";
    PROPRIETAIRE_UNIQUE, COPROPRIETAIRE
}

@source(ARR_ART25_ED2019_10, ARR_ART25_ED2020_01, ARR_ART25_ED2020_10,
        ARR_ART25_ED2021_01, ARR_ART25_ED2021_10, ARR_ART25_ED2022_01,
        ARR_ART25_ED2022_07, ARR_ART25_ED2023_01, ARR_ART25_ED2023_10,
        ARR_ART25_ED2024_01, ARR_ART25_ED2024_10, ARR_ART25_ED2025_01,
        ARR_ART25_ED2025_10)
pub enum VintagePretDepenseNette {
    label fr official "date de souscription du prêt au sens du 2° de l'article 25 de l'arrêté";
    label ru unofficial "дата оформления займа по 2° ст. 25 приказа";
    PRET_AVANT_OCTOBRE_1998, PRET_DEPUIS_OCTOBRE_1998
}

// Плафон аллокаций сектора приобретения выбирается ДАТОЙ «сертификата с датой»
// (`certificat daté` ст. D. 842-7) — это другой факт, чем дата подписания займа
// у ст. 18, и перечисление поэтому своё. Из двадцати одного винтажа ст. 33
// перенесены два последних.
@source(ARR_ART33_ED2020_01, ARR_ART33_ED2020_10, ARR_ART33_ED2021_01,
        ARR_ART33_ED2021_10, ARR_ART33_ED2022_01, ARR_ART33_ED2022_07,
        ARR_ART33_ED2023_01, ARR_ART33_ED2023_10, ARR_ART33_ED2024_01,
        ARR_ART33_ED2024_10, ARR_ART33_ED2025_01, ARR_ART33_ED2025_10)
pub enum VintageCertificatDate {
    label fr official "vintage du tableau de l'article 33 selon la date du certificat daté";
    label ru unofficial "винтаж таблицы ст. 33 по дате сертификата";
    CERTIFICAT_DEPUIS_01_10_2015, CERTIFICAT_DEPUIS_01_10_2017,
    CERTIFICAT_DEPUIS_01_10_2019
}

// D. 842-12 знает ДВЕ базы пола ресурсов, и выбор между ними зависит от того, по
// какому пункту R. 842-5 назначена аллокация: 1° — коэффициент на заявленную
// мензуальность, 2° — фиксированная сумма. Основание назначения в модель не
// вводится, признак приходит фактом дела.
@source(CCH_D842_12, CCH_D842_12_ED2019_12, CCH_D842_12_ED2020_01,
        CCH_D842_12_ED2021_01, CCH_D842_12_ED2023_04, CCH_D842_12_ED2023_09,
        CCH_D842_12_ED2023_12, CCH_D842_12_ED2026_07)
pub enum BasePlancherRessources {
    label fr official "base du plancher de ressources: coefficient sur la mensualité déclarée ou montant forfaitaire";
    label ru unofficial "база пола ресурсов: коэффициент на мензуальность либо форфейт";
    COEFFICIENT_MENSUALITE, MONTANT_FORFAITAIRE
}

// Заморские территории не имеют своих формул: ст. 46 и 47 арретэ ЗАМЕНЯЮТ
// отдельные значения глав III, VI и VII. Поэтому территория — вторая ось барема
// рядом с месяцем права, и она приходит фактом дела: ось `legal_time` её
// выразить не может. Три члена — ровно те группы, которые различает сам арретэ:
// метрополия, семь территорий ст. 46 и Сен-Пьер-и-Микелон ст. 47.
@source(ARR_ART46_ED2023_01, ARR_ART46_ED2025_10)
pub enum Territoire {
    label fr official "territoire d'application: métropole, outre-mer de l'article 46 ou Saint-Pierre-et-Miquelon";
    label ru unofficial "территория применения: метрополия, заморские территории ст. 46 либо Сен-Пьер-и-Микелон";
    METROPOLE, OUTRE_MER, SAINT_PIERRE_ET_MIQUELON
}

pub entity Menage {
    label fr official "ménage demandeur d'une aide personnelle au logement";
    label ru unofficial "домохозяйство, претендующее на жилищное пособие";
}

// --- факты дела -----------------------------------------------------------

relation mois_de_droit(m: Menage, mois: Date) kind empirical {
    key(m);
    label fr official "mois au titre duquel l'aide est due";
    label ru unofficial "месяц, за который причитается пособие (ось редакции барема)";
}

@source(CCH_D823_9, CCH_D823_9_ED2019_12, CCH_D823_9_ED2020_01,
        CCH_D823_9_ED2021_01, CCH_D823_9_ED2023_04, CCH_D823_9_ED2023_09,
        CCH_D823_9_ED2023_12, CCH_D823_9_ED2026_07)
pub relation secteur_locatif(m: Menage) kind empirical {
    label fr official "ménage locataire ou sous-locataire au sens du 1° de l'article D. 823-9";
    label ru unofficial "домохозяйство занимает жильё по найму (1° ст. D. 823-9)";
}

pub relation zone_du_logement(m: Menage, zone: Zone) kind empirical {
    key(m);
    label fr official "zone géographique du logement occupé";
    label ru unofficial "зона, в которой расположено жильё";
}

pub relation aide_demandee(m: Menage, type_aide: TypeAide) kind empirical {
    key(m);
    label fr official "aide personnelle au logement dont le ménage bénéficie";
    label ru unofficial "вид пособия, которое получает домохозяйство";
}

pub relation situation_familiale(m: Menage, situation: SituationFamiliale) kind empirical {
    key(m);
    label fr official "situation familiale du ménage";
    label ru unofficial "состав домохозяйства: одинокое лицо либо пара";
}

pub relation personnes_a_charge(m: Menage, pac: Integer) kind empirical {
    key(m);
    label fr official "nombre de personnes à charge";
    label ru unofficial "число лиц на иждивении";
}

pub relation loyer_principal(m: Menage, loyer: Money) kind empirical {
    key(m);
    label fr official "loyer principal acquitté";
    label ru unofficial "основная плата за наём";
}

@source(CCH_D823_17, CCH_D823_17_ED2019_12, CCH_D823_17_ED2020_01,
        CCH_D823_17_ED2021_01, CCH_D823_17_ED2023_04, CCH_D823_17_ED2023_09,
        CCH_D823_17_ED2023_12, CCH_D823_17_ED2026_07)
