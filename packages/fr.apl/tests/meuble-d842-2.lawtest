// Меблированный наём (D. 842-2 CCH, D-85 09.10.2026): loyer principal — две трети уплаченной цены
//
// ИСТОЧНИК (закреплён 09.10.2026, sources/fr-apl/cch-2023-12.txt, «Article D842-1» и
// «Article D842-2»): D. 842-1 — расчёт AL в найме по D. 823-16 «sous réserve des dispositions
// des articles D. 842-2»; D. 842-2 — «lorsque l'allocataire occupe un logement loué en meublé,
// le prix du loyer est remplacé par les deux tiers du prix effectivement payé dans la limite du
// loyer-plafond». APL — последний абзац D. 823-18 (версия с 11.01.2020): «Lorsque le logement
// est loué ou sous-loué en meublé, les dispositions de l'article D. 842-2 s'appliquent le cas
// échéant pour la détermination des loyers pris en compte».
//
// ДЕЛО — факты LexImpact 2024 ass_01_personne_seule (их прогон): одинокое лицо, зона II,
// ресурсы 0 €, меблированный наём 700 €, ALS, январь 2024 года.
//
// ОЖИДАНИЯ — из независимой реплики на дробях (Fraction) по закреплённому барему пакета
// (bareme/*.lawparam.json, редакция 2024-01), не из их кода:
//   две трети: 700 × 2 / 3 = 466,666… — не конечная дробь; под D-82 (ArrondiCentimeHalfUp)
//   до сантима HALF_UP 466,67; без выбора прочтения — отказ (INEXACT_DIVISION);
//   L = min(466,67; плафон зоны II 278,28) = 278,28; C = 58,08; P0 = max(8,5 % × 336,36; 37,91)
//   = 37,91; R = 0 → Pp = P0; Af = 278,28 + 58,08 − 37,91 = 298,45;
//   плафон дегрессивности 278,28 × 2,5 = 695,70: 466,67 ≤ 695,70 — уменьшения нет;
//   минорация −5 → 293,45; взносы 0,5 % = 1,46725; ⌊291,98275⌋ = 291; 291 + 1,46725 =
//   292,46725 (aide_mensuelle); после удержания CRDS 292,46725 × 0,995 = 291,00491375
//   (aide_nette_precompte_crds).
// Без правила двух третей (наём 700 €): 700 > 695,70 → пропорция → 284,001656 после CRDS.
// Их код: 291,98 = round2(293,45 × 0,995) — две трети у них тоже (round_(700 × 2/3) = 467);
// остаток 0,975 € — их шаг взносов без «arrondi à l'euro inférieur» (класс (б)).
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";
test "urn:query:fr-apl-meuble-als-2024-01-d82" {
    given {
        context { decision_time @2024-01-15T12:00:00Z; knowledge_time @2024-01-15T12:00:00Z; legal_time @2024-01-15; timezone "Europe/Paris"; interpretation PpPlancherFinal; interpretation ArrondiCentimeHalfUp; }
        assert "meuble-als-a-01": secteur_locatif(entity_ref("urn:fr:apl:case:meuble-als-2024-01")) { origin case_input; }
        assert "meuble-als-a-02": aide_demandee(entity_ref("urn:fr:apl:case:meuble-als-2024-01"), ALS) { origin case_input; }
        assert "meuble-als-a-03": zone_du_logement(entity_ref("urn:fr:apl:case:meuble-als-2024-01"), ZONE_II) { origin case_input; }
        assert "meuble-als-a-04": situation_familiale(entity_ref("urn:fr:apl:case:meuble-als-2024-01"), PERSONNE_SEULE) { origin case_input; }
        assert "meuble-als-a-05": personnes_a_charge(entity_ref("urn:fr:apl:case:meuble-als-2024-01"), 0) { origin case_input; }
        assert "meuble-als-a-06": ressources_du_menage(entity_ref("urn:fr:apl:case:meuble-als-2024-01"), 0 EUR) { origin case_input; }
        assert "meuble-als-a-07": prix_paye_logement_meuble(entity_ref("urn:fr:apl:case:meuble-als-2024-01"), 700 EUR) { origin case_input; }
        assert "meuble-als-a-08": mode_location(entity_ref("urn:fr:apl:case:meuble-als-2024-01"), LOCATION_SEULE) { origin case_input; }
        assert "meuble-als-a-09": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:meuble-als-2024-01"), 0 EUR) { origin case_input; }
        assert "meuble-als-a-10": territoire(entity_ref("urn:fr:apl:case:meuble-als-2024-01"), METROPOLE) { origin case_input; }
        assert "meuble-als-a-11": forme_logement(entity_ref("urn:fr:apl:case:meuble-als-2024-01"), LOGEMENT_ORDINAIRE) { origin case_input; }
        assert "meuble-als-a-12": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:meuble-als-2024-01"), false) { origin case_input; }
    }
    evaluate truth(loyer_principal(entity_ref("urn:fr:apl:case:meuble-als-2024-01"), 466.67 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(loyer_eligible(entity_ref("urn:fr:apl:case:meuble-als-2024-01"), 278.28 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(aide_apres_degressivite(entity_ref("urn:fr:apl:case:meuble-als-2024-01"), 298.45 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(aide_mensuelle(entity_ref("urn:fr:apl:case:meuble-als-2024-01"), 292.46725 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(aide_nette_precompte_crds(entity_ref("urn:fr:apl:case:meuble-als-2024-01"), 291.00491375 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

