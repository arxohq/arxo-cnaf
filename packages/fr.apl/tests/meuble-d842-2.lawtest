        assert "meuble-als-d-03": zone_du_logement(entity_ref("urn:fr:apl:case:meuble-als-1050-d82"), ZONE_II) { origin case_input; }
        assert "meuble-als-d-04": situation_familiale(entity_ref("urn:fr:apl:case:meuble-als-1050-d82"), PERSONNE_SEULE) { origin case_input; }
        assert "meuble-als-d-05": personnes_a_charge(entity_ref("urn:fr:apl:case:meuble-als-1050-d82"), 0) { origin case_input; }
        assert "meuble-als-d-06": ressources_du_menage(entity_ref("urn:fr:apl:case:meuble-als-1050-d82"), 0 EUR) { origin case_input; }
        assert "meuble-als-d-07": prix_paye_logement_meuble(entity_ref("urn:fr:apl:case:meuble-als-1050-d82"), 1050 EUR) { origin case_input; }
        assert "meuble-als-d-08": mode_location(entity_ref("urn:fr:apl:case:meuble-als-1050-d82"), LOCATION_SEULE) { origin case_input; }
        assert "meuble-als-d-09": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:meuble-als-1050-d82"), 0 EUR) { origin case_input; }
        assert "meuble-als-d-10": territoire(entity_ref("urn:fr:apl:case:meuble-als-1050-d82"), METROPOLE) { origin case_input; }
        assert "meuble-als-d-11": forme_logement(entity_ref("urn:fr:apl:case:meuble-als-1050-d82"), LOGEMENT_ORDINAIRE) { origin case_input; }
        assert "meuble-als-d-12": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:meuble-als-1050-d82"), false) { origin case_input; }
    }
    evaluate truth(aide_apres_degressivite(entity_ref("urn:fr:apl:case:meuble-als-1050-d82"), 290.76 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(aide_nette_precompte_crds(entity_ref("urn:fr:apl:case:meuble-als-1050-d82"), 284.001656 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

