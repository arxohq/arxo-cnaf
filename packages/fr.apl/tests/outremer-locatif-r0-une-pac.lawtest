// СВОЙ сценарий заморского найма: наёмных дел заморских территорий нет ни у
// Catala, ни у OpenFisca, поэтому шаги выведены из закреплённого текста.
//
// Факты дела нарочно скупые: ни найма, ни ресурсов. Этому шагу они не нужны, а с
// ними сработала бы вся цепочка расчёта, и её отказ в любом звене поразил бы весь
// evaluation-документ.
//
// ШАГ: форфейт R0 домохозяйства с ОДНИМ иждивенцем — 8 181 € по ст. 46 1° вместо
// 8 456 € метрополии (ст. 15, редакция с 1 января 2023 года).
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-outremer-locatif-r0-une-pac" {
    given {
        context { decision_time @2023-03-15T12:00:00Z; knowledge_time @2023-03-15T12:00:00Z; legal_time @2023-03-15; timezone "Europe/Paris"; }
        assert "outremer-locatif-r0-une-pac-01": secteur_locatif(entity_ref("urn:fr:apl:case:om-loc-c")) { origin case_input; }
        assert "outremer-locatif-r0-une-pac-02": aide_demandee(entity_ref("urn:fr:apl:case:om-loc-c"), APL) { origin case_input; }
        assert "outremer-locatif-r0-une-pac-03": zone_du_logement(entity_ref("urn:fr:apl:case:om-loc-c"), ZONE_II) { origin case_input; }
        assert "outremer-locatif-r0-une-pac-04": situation_familiale(entity_ref("urn:fr:apl:case:om-loc-c"), COUPLE) { origin case_input; }
        assert "outremer-locatif-r0-une-pac-05": personnes_a_charge(entity_ref("urn:fr:apl:case:om-loc-c"), 1) { origin case_input; }
        assert "outremer-locatif-r0-une-pac-06": mode_location(entity_ref("urn:fr:apl:case:om-loc-c"), LOCATION_SEULE) { origin case_input; }
        assert "outremer-locatif-r0-une-pac-07": territoire(entity_ref("urn:fr:apl:case:om-loc-c"), OUTRE_MER) { origin case_input; }
    }
    evaluate truth(abattement_r0(entity_ref("urn:fr:apl:case:om-loc-c"), 8181 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
