// Exemple4: пара с одним иждивенцем, зона I, наём 680 €, ресурсы 39 500 € — выплаты нет
// 
// ПРОМЕЖУТОЧНЫЙ ШАГ: личное участие Pp (D. 823-17). Catala утверждает его
// в сантимах; наш точный итог — 1015.68191 €.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-catala-04-participation" {
    given {
        context { decision_time @2022-02-19T12:00:00Z; knowledge_time @2022-02-19T12:00:00Z; legal_time @2022-02-19; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "catala-04-participation-01": secteur_locatif(entity_ref("urn:fr:apl:case:catala-04")) { origin case_input; }
        assert "catala-04-participation-02": zone_du_logement(entity_ref("urn:fr:apl:case:catala-04"), ZONE_I) { origin case_input; }
        assert "catala-04-participation-03": aide_demandee(entity_ref("urn:fr:apl:case:catala-04"), APL) { origin case_input; }
        assert "catala-04-participation-04": situation_familiale(entity_ref("urn:fr:apl:case:catala-04"), COUPLE) { origin case_input; }
        assert "catala-04-participation-05": personnes_a_charge(entity_ref("urn:fr:apl:case:catala-04"), 1) { origin case_input; }
        assert "catala-04-participation-06": loyer_principal(entity_ref("urn:fr:apl:case:catala-04"), 680 EUR) { origin case_input; }
        assert "catala-04-participation-07": ressources_du_menage(entity_ref("urn:fr:apl:case:catala-04"), 39500 EUR) { origin case_input; }
        assert "catala-04-participation-08": mode_location(entity_ref("urn:fr:apl:case:catala-04"), LOCATION_SEULE) { origin case_input; }
        assert "catala-04-participation-09": forme_logement(entity_ref("urn:fr:apl:case:catala-04"), LOGEMENT_ORDINAIRE) { origin case_input; }
        assert "catala-04-participation-10": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:catala-04"), 0 EUR) { origin case_input; }
        assert "catala-04-participation-11": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:catala-04"), false) { origin case_input; }
        assert "catala-04-participation-12": territoire(entity_ref("urn:fr:apl:case:catala-04"), METROPOLE) { origin case_input; }
    }
    evaluate truth(participation_personnelle(entity_ref("urn:fr:apl:case:catala-04"), 1015.68191 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
