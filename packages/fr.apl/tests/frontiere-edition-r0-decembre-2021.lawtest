// ОСЬ РЕДАКЦИЙ, половина пары: 15 декабря 2021 года действует форфейт R0
// версии ст. 15 от 5 января 2020 года (8 015 € на двух иждивенцев), тогда
// как плафоны уже взяты из версии ст. 7 от 1 октября 2021 года. Окна версий
// в этом акте НЕ совпадают, и параметр выбирается по своему окну, а не по
// редакции целиком. Точный итог — 112.56611175 €.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-frontiere-edition-r0-decembre-2021" {
    given {
        context { decision_time @2021-12-15T12:00:00Z; knowledge_time @2021-12-15T12:00:00Z; legal_time @2021-12-15; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "frontiere-edition-r0-decembre-2021-01": secteur_locatif(entity_ref("urn:fr:apl:case:frontiere-edition-r0-decembre-2021")) { origin case_input; }
        assert "frontiere-edition-r0-decembre-2021-02": zone_du_logement(entity_ref("urn:fr:apl:case:frontiere-edition-r0-decembre-2021"), ZONE_II) { origin case_input; }
        assert "frontiere-edition-r0-decembre-2021-03": aide_demandee(entity_ref("urn:fr:apl:case:frontiere-edition-r0-decembre-2021"), APL) { origin case_input; }
        assert "frontiere-edition-r0-decembre-2021-04": situation_familiale(entity_ref("urn:fr:apl:case:frontiere-edition-r0-decembre-2021"), COUPLE) { origin case_input; }
        assert "frontiere-edition-r0-decembre-2021-05": personnes_a_charge(entity_ref("urn:fr:apl:case:frontiere-edition-r0-decembre-2021"), 2) { origin case_input; }
        assert "frontiere-edition-r0-decembre-2021-06": loyer_principal(entity_ref("urn:fr:apl:case:frontiere-edition-r0-decembre-2021"), 400 EUR) { origin case_input; }
        assert "frontiere-edition-r0-decembre-2021-07": ressources_du_menage(entity_ref("urn:fr:apl:case:frontiere-edition-r0-decembre-2021"), 20000 EUR) { origin case_input; }
        assert "frontiere-edition-r0-decembre-2021-08": mode_location(entity_ref("urn:fr:apl:case:frontiere-edition-r0-decembre-2021"), LOCATION_SEULE) { origin case_input; }
        assert "frontiere-edition-r0-decembre-2021-09": forme_logement(entity_ref("urn:fr:apl:case:frontiere-edition-r0-decembre-2021"), LOGEMENT_ORDINAIRE) { origin case_input; }
        assert "frontiere-edition-r0-decembre-2021-10": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:frontiere-edition-r0-decembre-2021"), 0 EUR) { origin case_input; }
        assert "frontiere-edition-r0-decembre-2021-11": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:frontiere-edition-r0-decembre-2021"), false) { origin case_input; }
        assert "frontiere-edition-r0-decembre-2021-12": territoire(entity_ref("urn:fr:apl:case:frontiere-edition-r0-decembre-2021"), METROPOLE) { origin case_input; }
    }
    evaluate truth(aide_mensuelle(entity_ref("urn:fr:apl:case:frontiere-edition-r0-decembre-2021"), 112.56611175 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
