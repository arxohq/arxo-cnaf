// Дело Catala «CasTest2» (logement-foyer, аллокация).
//
// ШАГ: форфейт расходов C (ст. 40 арретэ, редакция 2021 года) — 54,22 €.
// Catala утверждает то же число.//
// ПОЧЕМУ НЕТ ФАКТА РЕСУРСОВ. Этому шагу они не нужны, и поданы намеренно не были:
// с ними дело считает ещё и L0 второго абзаца D. 832-26, чьи транши закреплённый
// текст называет лишь редакцией, применимой с 1 июля 2022 года. На апреле 2022
// года параметра нет, отказ MISSING_PARAMETER_VALUE поражает ВЕСЬ
// evaluation-документ, и сценарий краснел бы не из-за своего шага. Сам отказ
// закреплён сценарием `foyer-al-02-loyer-minimal-hors-couverture`.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-foyer-al-02-forfait-charges" {
    given {
        context { decision_time @2022-04-23T12:00:00Z; knowledge_time @2022-04-23T12:00:00Z; legal_time @2022-04-23; timezone "Europe/Paris"; }
        assert "foyer-al-02-forfait-charges-01": secteur_logement_foyer(entity_ref("urn:fr:apl:case:foyer-al-02")) { origin case_input; }
        assert "foyer-al-02-forfait-charges-02": aide_demandee(entity_ref("urn:fr:apl:case:foyer-al-02"), ALF) { origin case_input; }
        assert "foyer-al-02-forfait-charges-03": zone_du_logement(entity_ref("urn:fr:apl:case:foyer-al-02"), ZONE_III) { origin case_input; }
        assert "foyer-al-02-forfait-charges-04": situation_familiale(entity_ref("urn:fr:apl:case:foyer-al-02"), COUPLE) { origin case_input; }
        assert "foyer-al-02-forfait-charges-05": personnes_a_charge(entity_ref("urn:fr:apl:case:foyer-al-02"), 0) { origin case_input; }
        assert "foyer-al-02-forfait-charges-06": categorie_equivalence_loyer(entity_ref("urn:fr:apl:case:foyer-al-02"), PERSONNES_AGEES) { origin case_input; }
        assert "foyer-al-02-forfait-charges-07": redevance(entity_ref("urn:fr:apl:case:foyer-al-02"), 360 EUR) { origin case_input; }
        assert "foyer-al-02-forfait-charges-08": territoire(entity_ref("urn:fr:apl:case:foyer-al-02"), METROPOLE) { origin case_input; }
    }
    evaluate truth(forfait_charges_foyer(entity_ref("urn:fr:apl:case:foyer-al-02"), 54.22 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
