// МОНТАЖ СЕН-ПЬЕР-И-МИКЕЛОНА — ст. 7 декрета № 2021-1750: «le montant mensuel de
// l'aide due au titre du mois de janvier 2022 jusqu'au mois de décembre 2025 est
// calculé selon la formule ALspm = ALt × (1 − (2026 − n)/8)», ALt — аида по книге
// VIII, n — год. Входы дела Catala «Exemple4» AL найма (Сен-Пьер, зона II,
// одинокий с двумя иждивенцами, наём 500 €, ресурсы 12 500 €).
//
// ШАГ: февраль 2026 года — монтаж завершён (формула ограничена декабрём 2025
// года): аида равна ALt = 417 €.
//
// КАНАРЕЙКА 14.09.2026: раскрытие окна правила монтажа до бесконечности роняет
// ровно этот сценарий (KEY_CONFLICT двух выплат).
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-saint-pierre-montee-en-charge-achevee-2026" {
    given {
        context { decision_time @2026-02-15T12:00:00Z; knowledge_time @2026-02-15T12:00:00Z; legal_time @2026-02-15; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "saint-pierre-montee-en-charge-achevee-2026-01": secteur_locatif(entity_ref("urn:fr:apl:case:spm-montee-2026-02")) { origin case_input; }
        assert "saint-pierre-montee-en-charge-achevee-2026-02": aide_demandee(entity_ref("urn:fr:apl:case:spm-montee-2026-02"), ALF) { origin case_input; }
        assert "saint-pierre-montee-en-charge-achevee-2026-03": zone_du_logement(entity_ref("urn:fr:apl:case:spm-montee-2026-02"), ZONE_II) { origin case_input; }
        assert "saint-pierre-montee-en-charge-achevee-2026-04": situation_familiale(entity_ref("urn:fr:apl:case:spm-montee-2026-02"), PERSONNE_SEULE) { origin case_input; }
        assert "saint-pierre-montee-en-charge-achevee-2026-05": personnes_a_charge(entity_ref("urn:fr:apl:case:spm-montee-2026-02"), 2) { origin case_input; }
        assert "saint-pierre-montee-en-charge-achevee-2026-06": loyer_principal(entity_ref("urn:fr:apl:case:spm-montee-2026-02"), 500 EUR) { origin case_input; }
        assert "saint-pierre-montee-en-charge-achevee-2026-07": ressources_du_menage(entity_ref("urn:fr:apl:case:spm-montee-2026-02"), 12500 EUR) { origin case_input; }
        assert "saint-pierre-montee-en-charge-achevee-2026-08": mode_location(entity_ref("urn:fr:apl:case:spm-montee-2026-02"), LOCATION_SEULE) { origin case_input; }
        assert "saint-pierre-montee-en-charge-achevee-2026-09": forme_logement(entity_ref("urn:fr:apl:case:spm-montee-2026-02"), LOGEMENT_ORDINAIRE) { origin case_input; }
        assert "saint-pierre-montee-en-charge-achevee-2026-10": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:spm-montee-2026-02"), 0 EUR) { origin case_input; }
        assert "saint-pierre-montee-en-charge-achevee-2026-11": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:spm-montee-2026-02"), false) { origin case_input; }
        assert "saint-pierre-montee-en-charge-achevee-2026-12": territoire(entity_ref("urn:fr:apl:case:spm-montee-2026-02"), SAINT_PIERRE_ET_MIQUELON) { origin case_input; }
    }
    evaluate truth(aide_mensuelle(entity_ref("urn:fr:apl:case:spm-montee-2026-02"), 417 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
