// Exemple1: пара с тремя иждивенцами, зона I, наём 700 €, ресурсы 36 000 € — участие превышает L + C, и выплаты нет
// 
// ИСТОЧНИК ОЖИДАНИЯ: Catala, CatalaLang/catala-examples@ebe5e7c2, aides_logement/tests/; их значение — 0 €.
// НАШ ИСХОД: итог расчёта отрицателен (-104.520275 €), и D. 823-16 говорит
// не «ноль», а «il n'est pas procédé à son versement» — поэтому пакет
// заключает непроизводство выплаты, а не нулевую сумму.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-catala-01" {
    given {
        context { decision_time @2022-02-03T12:00:00Z; knowledge_time @2022-02-03T12:00:00Z; legal_time @2022-02-03; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "catala-01-01": secteur_locatif(entity_ref("urn:fr:apl:case:catala-01")) { origin case_input; }
        assert "catala-01-02": zone_du_logement(entity_ref("urn:fr:apl:case:catala-01"), ZONE_I) { origin case_input; }
        assert "catala-01-03": aide_demandee(entity_ref("urn:fr:apl:case:catala-01"), APL) { origin case_input; }
        assert "catala-01-04": situation_familiale(entity_ref("urn:fr:apl:case:catala-01"), COUPLE) { origin case_input; }
        assert "catala-01-05": personnes_a_charge(entity_ref("urn:fr:apl:case:catala-01"), 3) { origin case_input; }
        assert "catala-01-06": loyer_principal(entity_ref("urn:fr:apl:case:catala-01"), 700 EUR) { origin case_input; }
        assert "catala-01-07": ressources_du_menage(entity_ref("urn:fr:apl:case:catala-01"), 36000 EUR) { origin case_input; }
        assert "catala-01-08": mode_location(entity_ref("urn:fr:apl:case:catala-01"), LOCATION_SEULE) { origin case_input; }
        assert "catala-01-09": forme_logement(entity_ref("urn:fr:apl:case:catala-01"), LOGEMENT_ORDINAIRE) { origin case_input; }
        assert "catala-01-10": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:catala-01"), 0 EUR) { origin case_input; }
        assert "catala-01-11": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:catala-01"), false) { origin case_input; }
        assert "catala-01-12": territoire(entity_ref("urn:fr:apl:case:catala-01"), METROPOLE) { origin case_input; }
    }
    evaluate truth(aide_non_versee(entity_ref("urn:fr:apl:case:catala-01")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
