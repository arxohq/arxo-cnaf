// Месяц права — сентябрь 2022 года. Здесь у барема ЗИЯЛА ДЫРА до 14.09.2026:
// версия ст. 15 от 1 августа 2022 года (арретэ от 29 июля 2022 года,
// применяется к престациям с 1 ИЮЛЯ) не была закреплена вовсе. Окно январской
// версии кончалось 1 августа, следующая закреплённая версия применялась лишь с
// 1 января 2023 года — и дело августа—декабря 2022 года отвечало
// MISSING_PARAMETER_VALUE, то есть было NON_EXECUTABLE.
//
// Нашла дыру не статика и не сценарий, а ТРЕТИЙ вопрос сверки версий: «нет ли
// версии внутри покрытого промежутка, не попавшей ни в одно состояние». Первые
// два вопроса её не видели: закреплённые версии были верны сами по себе, а
// последняя версия статьи была на месте.
//
// ШАГ: R0 одинокого лица без иждивенцев — 4 870 € (было 4 683 € с января).
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-frontiere-r0-juillet-2022" {
    given {
        context { decision_time @2022-09-15T12:00:00Z; knowledge_time @2022-09-15T12:00:00Z; legal_time @2022-09-15; timezone "Europe/Paris"; }
        assert "frontiere-r0-juillet-2022-01": secteur_locatif(entity_ref("urn:fr:apl:case:r0-2022-09")) { origin case_input; }
        assert "frontiere-r0-juillet-2022-02": aide_demandee(entity_ref("urn:fr:apl:case:r0-2022-09"), APL) { origin case_input; }
        assert "frontiere-r0-juillet-2022-03": zone_du_logement(entity_ref("urn:fr:apl:case:r0-2022-09"), ZONE_II) { origin case_input; }
        assert "frontiere-r0-juillet-2022-04": situation_familiale(entity_ref("urn:fr:apl:case:r0-2022-09"), PERSONNE_SEULE) { origin case_input; }
        assert "frontiere-r0-juillet-2022-05": personnes_a_charge(entity_ref("urn:fr:apl:case:r0-2022-09"), 0) { origin case_input; }
        assert "frontiere-r0-juillet-2022-06": mode_location(entity_ref("urn:fr:apl:case:r0-2022-09"), LOCATION_SEULE) { origin case_input; }
        assert "frontiere-r0-juillet-2022-07": territoire(entity_ref("urn:fr:apl:case:r0-2022-09"), METROPOLE) { origin case_input; }
    }
    evaluate truth(abattement_r0(entity_ref("urn:fr:apl:case:r0-2022-09"), 4870 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
