// Противовес редакции 2025 года: метрополия — 8 947 € против заморских 8 656 €.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-metropole-locatif-r0-une-pac-2025" {
    given {
        context { decision_time @2025-06-15T12:00:00Z; knowledge_time @2025-06-15T12:00:00Z; legal_time @2025-06-15; timezone "Europe/Paris"; }
        assert "metropole-locatif-r0-une-pac-2025-01": secteur_locatif(entity_ref("urn:fr:apl:case:mt-loc-2025")) { origin case_input; }
        assert "metropole-locatif-r0-une-pac-2025-02": aide_demandee(entity_ref("urn:fr:apl:case:mt-loc-2025"), APL) { origin case_input; }
        assert "metropole-locatif-r0-une-pac-2025-03": zone_du_logement(entity_ref("urn:fr:apl:case:mt-loc-2025"), ZONE_II) { origin case_input; }
        assert "metropole-locatif-r0-une-pac-2025-04": situation_familiale(entity_ref("urn:fr:apl:case:mt-loc-2025"), COUPLE) { origin case_input; }
        assert "metropole-locatif-r0-une-pac-2025-05": personnes_a_charge(entity_ref("urn:fr:apl:case:mt-loc-2025"), 1) { origin case_input; }
        assert "metropole-locatif-r0-une-pac-2025-06": mode_location(entity_ref("urn:fr:apl:case:mt-loc-2025"), LOCATION_SEULE) { origin case_input; }
        assert "metropole-locatif-r0-une-pac-2025-07": territoire(entity_ref("urn:fr:apl:case:mt-loc-2025"), METROPOLE) { origin case_input; }
    }
    evaluate truth(abattement_r0(entity_ref("urn:fr:apl:case:mt-loc-2025"), 8947 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
