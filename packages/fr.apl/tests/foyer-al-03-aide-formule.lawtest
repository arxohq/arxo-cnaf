// Дело Catala «CasTest2» (logement-foyer, аллокация ALF): пара, зона III, категория 3°
// D. 842-16, redevance 360 €, ресурсы 15 000 €; месяц права 15.03.2023 (у Catala
// 23.04.2022, но L0 по таблице ст. 31, применимой с 1 июля 2022 года, на апреле 2022
// года не определён — README пакета).
//
// K аллокаций — ВСЕГДА по 2° D. 832-25: 0,90 − 15 000/(21 420,91·1,5) = 0,4331… → 0,43
// (Catala: 0,43). L = 331,96, C = 56,12, L0 = 307,96573.
// Af = 0,43 × (L + C − L0) = 34,4491361 €.
// K читается из R. 351-61 (общий случай) и R. 351-61-1 (фойе молодых работников и
// социальные резиденции) — алгебра D. 832-25 в закреплённых данных картинка, см.
// блок «КОЭФФИЦИЕНТ K» в 04-calcul-foyer.law и README, «Коэффициент K».
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-foyer-al-03-aide-formule" {
    given {
        context { decision_time @2023-03-15T12:00:00Z; knowledge_time @2023-03-15T12:00:00Z; legal_time @2023-03-15; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "foyer-al-03-aide-formule-01": secteur_logement_foyer(entity_ref("urn:fr:apl:case:foyer-al-03")) { origin case_input; }
        assert "foyer-al-03-aide-formule-02": aide_demandee(entity_ref("urn:fr:apl:case:foyer-al-03"), ALF) { origin case_input; }
        assert "foyer-al-03-aide-formule-03": zone_du_logement(entity_ref("urn:fr:apl:case:foyer-al-03"), ZONE_III) { origin case_input; }
        assert "foyer-al-03-aide-formule-04": situation_familiale(entity_ref("urn:fr:apl:case:foyer-al-03"), COUPLE) { origin case_input; }
        assert "foyer-al-03-aide-formule-05": personnes_a_charge(entity_ref("urn:fr:apl:case:foyer-al-03"), 0) { origin case_input; }
        assert "foyer-al-03-aide-formule-06": categorie_equivalence_loyer(entity_ref("urn:fr:apl:case:foyer-al-03"), PERSONNES_AGEES) { origin case_input; }
        assert "foyer-al-03-aide-formule-07": redevance(entity_ref("urn:fr:apl:case:foyer-al-03"), 360 EUR) { origin case_input; }
        assert "foyer-al-03-aide-formule-08": ressources_du_menage(entity_ref("urn:fr:apl:case:foyer-al-03"), 15000 EUR) { origin case_input; }
        assert "foyer-al-03-aide-formule-09": territoire(entity_ref("urn:fr:apl:case:foyer-al-03"), METROPOLE) { origin case_input; }
    }
    evaluate truth(aide_foyer_formule(entity_ref("urn:fr:apl:case:foyer-al-03"), 34.4491361 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
