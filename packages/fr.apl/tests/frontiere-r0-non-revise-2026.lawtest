// Месяц права — март 2026 года. R0 здесь тот же, что с 1 января 2025 года
// (5 235 €), и это НЕ инерция пакета: ежегодную переоценку на 2026 год ОТМЕНИЛ
// декрет № 2025-1401 от 28 декабря 2025 года — «le montant forfaitaire de
// ressources applicable aux étudiants et le paramètre "R0" ne sont pas révisés
// pour l'année 2026», применяется к престациям с 1 января 2026 года.
//
// Декрет найден сверкой по Journal officiel: в LEGI он не создаёт версий
// (ничего не меняет в тексте), поэтому сверка по консолидации молчала о нём,
// а молчание LEGI за весь 2026 год выглядело просто отсутствием переоценки.
// Теперь он закреплён, объявлен границей (правила из него не выводятся) и
// стоит ЯКОРЕМ у последней строки R0 — провенанс говорит, почему значение
// января 2025 года действует в 2026-м.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-frontiere-r0-non-revise-2026" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "frontiere-r0-non-revise-2026-01": secteur_locatif(entity_ref("urn:fr:apl:case:r0-2026-03")) { origin case_input; }
        assert "frontiere-r0-non-revise-2026-02": aide_demandee(entity_ref("urn:fr:apl:case:r0-2026-03"), APL) { origin case_input; }
        assert "frontiere-r0-non-revise-2026-03": zone_du_logement(entity_ref("urn:fr:apl:case:r0-2026-03"), ZONE_II) { origin case_input; }
        assert "frontiere-r0-non-revise-2026-04": situation_familiale(entity_ref("urn:fr:apl:case:r0-2026-03"), PERSONNE_SEULE) { origin case_input; }
        assert "frontiere-r0-non-revise-2026-05": personnes_a_charge(entity_ref("urn:fr:apl:case:r0-2026-03"), 0) { origin case_input; }
        assert "frontiere-r0-non-revise-2026-06": mode_location(entity_ref("urn:fr:apl:case:r0-2026-03"), LOCATION_SEULE) { origin case_input; }
        assert "frontiere-r0-non-revise-2026-07": territoire(entity_ref("urn:fr:apl:case:r0-2026-03"), METROPOLE) { origin case_input; }
    }
    evaluate truth(abattement_r0(entity_ref("urn:fr:apl:case:r0-2026-03"), 5235 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
