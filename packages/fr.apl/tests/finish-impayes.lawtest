        assert "fret-01": decision_recevabilite_l722_10(entity_ref("urn:fr:apl:case:fret")) { origin case_input; }
        assert "fret-02": versement_suspendu_en_place(entity_ref("urn:fr:apl:case:fret")) { origin case_input; }
    }
    evaluate truth(versement_retabli_l824_3(entity_ref("urn:fr:apl:case:fret")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
