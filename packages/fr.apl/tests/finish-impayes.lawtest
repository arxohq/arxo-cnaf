test "urn:query:fr-apl-finish-devoir-signaler-impaye" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "fsig-01": impaye_depense_logement(entity_ref("urn:fr:apl:case:fsig")) { origin case_input; }
        assert "fsig-02": bailleur_du_menage(entity_ref("urn:fr:apl:bail:fsig"), entity_ref("urn:fr:apl:case:fsig")) { origin case_input; }
        assert "fsig-03": organisme_debiteur(entity_ref("urn:fr:apl:org:caisse-exemple"), entity_ref("urn:fr:apl:case:fsig")) { origin case_input; }
        // D-42: the duty is borne by "le bailleur"; the model keys landlord duties on the
        // D-42: third-party role BAILLEUR (role_tiers), as the sibling suites do; the case
        // D-42: omitted it.
        assert "fsig-04": role_tiers(entity_ref("urn:fr:apl:bail:fsig"), BAILLEUR) { origin case_input; }
        // D-42: L. 824-1 binds "le bailleur ... aupres duquel l'aide personnelle est versee";
        // D-42: the model derives destinataire_aide (17); the case did not say the aid is
        // D-42: paid to the landlord. Built minimally: ALS paid to the landlord on request
        // D-42: (L. 842-1 third-party payment, 17 DestAllocationBailleurALS).
        assert "fsig-05": aide_demandee(entity_ref("urn:fr:apl:case:fsig"), ALS) { origin case_input; }
        // D-42: same: the landlord asked for third-party payment.
        assert "fsig-06": demande_versement_tiers(entity_ref("urn:fr:apl:bail:fsig"), entity_ref("urn:fr:apl:case:fsig")) { origin case_input; }
        // D-42: same: third-party payment of ALS to the landlord requires a decent dwelling.
        assert "fsig-07": logement_decent(entity_ref("urn:fr:apl:case:fsig")) { origin adjudicated; }
    }
    evaluate positions();
    expect position(BailleurSignalerImpaye, ACTIVE);
    expect evaluation_status == COMPUTED;
}

