        assert "fdef3-06": loyer_principal(entity_ref("urn:fr:apl:case:fdef3"), 280 EUR) { origin case_input; }
        assert "fdef3-07": ressources_du_menage(entity_ref("urn:fr:apl:case:fdef3"), 12800 EUR) { origin case_input; }
        assert "fdef3-08": mode_location(entity_ref("urn:fr:apl:case:fdef3"), LOCATION_SEULE) { origin case_input; }
        assert "fdef3-09": forme_logement(entity_ref("urn:fr:apl:case:fdef3"), LOGEMENT_ORDINAIRE) { origin case_input; }
        assert "fdef3-10": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:fdef3"), 0 EUR) { origin case_input; }
        assert "fdef3-11": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:fdef3"), false) { origin case_input; }
        assert "fdef3-12": territoire(entity_ref("urn:fr:apl:case:fdef3"), METROPOLE) { origin case_input; }
        assert "fdef3-13": occupation_residence_principale(entity_ref("urn:fr:apl:case:fdef3")) { origin case_input; }
        assert "fdef3-14": logement_decent(entity_ref("urn:fr:apl:case:fdef3")) { origin adjudicated; }
        assert "fdef3-15": organisme_debiteur(entity_ref("urn:fr:apl:org:caisse-exemple"), entity_ref("urn:fr:apl:case:fdef3")) { origin case_input; }
        assert "fdef3-16": etranger_visa_etudiant_l422(entity_ref("urn:fr:apl:case:fdef3")) { origin case_input; }
        // D-42: the suite named an undeclared predicate (titulaire_aide_exclue_d8220_1,
        // LDC-E2102). L. 822-2 I 3° excludes L. 422-1..7 visa holders "qui ne
        // remplissent pas les conditions ... pour etre titulaires d'une bourse
        // d'enseignement superieur sur criteres sociaux"; the model (13
        // ExcluVisaEtudiantSansBourse) takes that established finding as
        // non_eligible_bourse_criteres_sociaux.
        assert "fdef3-17": non_eligible_bourse_criteres_sociaux(entity_ref("urn:fr:apl:case:fdef3")) { origin case_input; }
    }
    evaluate positions();
    expect not position(VerserAideTheoriqueDue, ACTIVE);
    expect evaluation_status == COMPUTED;
}
