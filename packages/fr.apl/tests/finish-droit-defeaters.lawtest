    given {
        context { decision_time @2026-08-15T12:00:00Z; knowledge_time @2026-08-15T12:00:00Z; legal_time @2026-08-15; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "fdef3-01": secteur_locatif(entity_ref("urn:fr:apl:case:fdef3")) { origin case_input; }
        assert "fdef3-02": zone_du_logement(entity_ref("urn:fr:apl:case:fdef3"), ZONE_III) { origin case_input; }
        assert "fdef3-03": aide_demandee(entity_ref("urn:fr:apl:case:fdef3"), APL) { origin case_input; }
        assert "fdef3-04": situation_familiale(entity_ref("urn:fr:apl:case:fdef3"), PERSONNE_SEULE) { origin case_input; }
