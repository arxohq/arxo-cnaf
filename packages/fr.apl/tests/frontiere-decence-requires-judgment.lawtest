// КАНАЛ СУЖДЕНИЯ §47.3 (L. 822-9): соответствие жилья требованиям
// пристойности оценивает орган, а не дело. Пока ответа нет, право не
// открыто и документ несёт типизированный запрос к органу — это НЕ то же,
// что «право отказано».
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-frontiere-decence-requires-judgment" {
    given {
        context { decision_time @2022-02-15T12:00:00Z; knowledge_time @2022-02-15T12:00:00Z; legal_time @2022-02-15; timezone "Europe/Paris"; }
        assert "frontiere-decence-requires-judgment-01": secteur_locatif(entity_ref("urn:fr:apl:case:frontiere-decence-requires-judgment")) { origin case_input; }
        assert "frontiere-decence-requires-judgment-02": zone_du_logement(entity_ref("urn:fr:apl:case:frontiere-decence-requires-judgment"), ZONE_I) { origin case_input; }
        assert "frontiere-decence-requires-judgment-03": aide_demandee(entity_ref("urn:fr:apl:case:frontiere-decence-requires-judgment"), APL) { origin case_input; }
        assert "frontiere-decence-requires-judgment-04": situation_familiale(entity_ref("urn:fr:apl:case:frontiere-decence-requires-judgment"), PERSONNE_SEULE) { origin case_input; }
        assert "frontiere-decence-requires-judgment-05": personnes_a_charge(entity_ref("urn:fr:apl:case:frontiere-decence-requires-judgment"), 0) { origin case_input; }
        assert "frontiere-decence-requires-judgment-06": loyer_principal(entity_ref("urn:fr:apl:case:frontiere-decence-requires-judgment"), 400 EUR) { origin case_input; }
        assert "frontiere-decence-requires-judgment-07": ressources_du_menage(entity_ref("urn:fr:apl:case:frontiere-decence-requires-judgment"), 7800 EUR) { origin case_input; }
        assert "frontiere-decence-requires-judgment-08": mode_location(entity_ref("urn:fr:apl:case:frontiere-decence-requires-judgment"), LOCATION_SEULE) { origin case_input; }
        assert "frontiere-decence-requires-judgment-09": forme_logement(entity_ref("urn:fr:apl:case:frontiere-decence-requires-judgment"), LOGEMENT_ORDINAIRE) { origin case_input; }
        assert "frontiere-decence-requires-judgment-10": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:frontiere-decence-requires-judgment"), 0 EUR) { origin case_input; }
        assert "frontiere-decence-requires-judgment-11": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:frontiere-decence-requires-judgment"), false) { origin case_input; }
        assert "frontiere-decence-requires-judgment-12": occupation_residence_principale(entity_ref("urn:fr:apl:case:frontiere-decence-requires-judgment")) { origin case_input; }
        assert "frontiere-decence-requires-judgment-13": territoire(entity_ref("urn:fr:apl:case:frontiere-decence-requires-judgment"), METROPOLE) { origin case_input; }
    }
    evaluate truth(droit_ouvert(entity_ref("urn:fr:apl:case:frontiere-decence-requires-judgment")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == REQUIRES_JUDGMENT;
    expect judgment_request(logement_decent, OrganismePayeur);
}
