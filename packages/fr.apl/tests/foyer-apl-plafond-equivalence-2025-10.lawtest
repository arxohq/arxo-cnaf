// Месяц права — ноябрь 2025 года: редакция, применимая «aux prestations dues à
// compter du 1er octobre 2025». Её версии статей пришли ИНКРЕМЕНТОМ DILA
// LEGI_20250911-214911 — в глобальный дамп они попасть не могли, он снят
// 13 июля 2025 года.
//
// ШАГ (глава V): плафон эквивалентности найма и расходов — 532,35 € для пары без
// иждивенцев в зоне II.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-foyer-apl-plafond-equivalence-2025-10" {
    given {
        context { decision_time @2025-11-15T12:00:00Z; knowledge_time @2025-11-15T12:00:00Z; legal_time @2025-11-15; timezone "Europe/Paris"; }
        assert "foyer-apl-plafond-equivalence-2025-10-01": secteur_logement_foyer(entity_ref("urn:fr:apl:case:foyer-2025-10")) { origin case_input; }
        assert "foyer-apl-plafond-equivalence-2025-10-02": aide_demandee(entity_ref("urn:fr:apl:case:foyer-2025-10"), APL) { origin case_input; }
        assert "foyer-apl-plafond-equivalence-2025-10-03": zone_du_logement(entity_ref("urn:fr:apl:case:foyer-2025-10"), ZONE_II) { origin case_input; }
        assert "foyer-apl-plafond-equivalence-2025-10-04": situation_familiale(entity_ref("urn:fr:apl:case:foyer-2025-10"), COUPLE) { origin case_input; }
        assert "foyer-apl-plafond-equivalence-2025-10-05": personnes_a_charge(entity_ref("urn:fr:apl:case:foyer-2025-10"), 0) { origin case_input; }
        assert "foyer-apl-plafond-equivalence-2025-10-06": type_logement_foyer(entity_ref("urn:fr:apl:case:foyer-2025-10"), GENERAL) { origin case_input; }
        assert "foyer-apl-plafond-equivalence-2025-10-07": redevance(entity_ref("urn:fr:apl:case:foyer-2025-10"), 400 EUR) { origin case_input; }
        assert "foyer-apl-plafond-equivalence-2025-10-08": territoire(entity_ref("urn:fr:apl:case:foyer-2025-10"), METROPOLE) { origin case_input; }
    }
    evaluate truth(plafond_equivalence_loyer(entity_ref("urn:fr:apl:case:foyer-2025-10"), 532.35 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
