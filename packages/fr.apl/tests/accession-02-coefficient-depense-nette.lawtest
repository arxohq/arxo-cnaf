// Дело Catala «Exemple2» (сектор приобретения, APL).
//
// ШАГ: коэффициент минимального чистого расхода (ст. 25 арретэ, 2° b) —
// 0,0234 для займов, оформленных с 1 октября 1998 года и не относящихся к
// жилью, улучшенному собственником-жильцом.//
// ПОЧЕМУ В ЭТОМ ДЕЛЕ НЕТ ФАКТА РЕСУРСОВ. Ресурсы этому шагу не нужны, и они здесь
// намеренно не поданы: с ними дело считает ещё и L0, а его деление на двенадцать
// на этом входе неточно и отказывает — а отказ §50 поражает ВЕСЬ
// evaluation-документ (`NON_EXECUTABLE`), не одно заключение. Измерено
// 14.09.2026: с фактом ресурсов этот сценарий краснеет у обоих оценщиков не
// потому, что плафон неверен, а потому, что документ целиком неисполним.
// Отказ закреплён отдельным сценарием `accession-02-mensualite-minimale-inexacte`.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-accession-02-coefficient-depense-nette" {
    given {
        // D-42: G-A13 migration (24-lecture-pp.law) — D. 823-17 "P0 ... ne peut etre
        // inferieure a un montant minimum" has two readings in group SensMinimumPp
        // (selection exactly_one); this hand suite selects the working reading, as
        // the other hand suites do. No expectation changed.
        context { decision_time @2021-09-15T12:00:00Z; knowledge_time @2021-09-15T12:00:00Z; legal_time @2021-09-15; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "accession-02-coefficient-depense-nette-01": secteur_accession(entity_ref("urn:fr:apl:case:accession-02")) { origin case_input; }
        assert "accession-02-coefficient-depense-nette-02": aide_demandee(entity_ref("urn:fr:apl:case:accession-02"), APL) { origin case_input; }
        assert "accession-02-coefficient-depense-nette-03": zone_du_logement(entity_ref("urn:fr:apl:case:accession-02"), ZONE_III) { origin case_input; }
        assert "accession-02-coefficient-depense-nette-04": situation_familiale(entity_ref("urn:fr:apl:case:accession-02"), COUPLE) { origin case_input; }
        assert "accession-02-coefficient-depense-nette-05": personnes_a_charge(entity_ref("urn:fr:apl:case:accession-02"), 2) { origin case_input; }
        assert "accession-02-coefficient-depense-nette-06": sous_cas_mensualite(entity_ref("urn:fr:apl:case:accession-02"), PRET_APRES_30_09_2019) { origin case_input; }
        assert "accession-02-coefficient-depense-nette-07": finalite_operation(entity_ref("urn:fr:apl:case:accession-02"), LOGEMENT_ACQUIS_AMELIORE) { origin case_input; }
        assert "accession-02-coefficient-depense-nette-08": type_travaux(entity_ref("urn:fr:apl:case:accession-02"), TRAVAUX_POUR_ACQUISITION) { origin case_input; }
        assert "accession-02-coefficient-depense-nette-09": mode_propriete(entity_ref("urn:fr:apl:case:accession-02"), PROPRIETAIRE_UNIQUE) { origin case_input; }
        assert "accession-02-coefficient-depense-nette-10": mensualite_declaree(entity_ref("urn:fr:apl:case:accession-02"), 495.73 EUR) { origin case_input; }
        assert "accession-02-coefficient-depense-nette-11": vintage_pret_depense_nette(entity_ref("urn:fr:apl:case:accession-02"), PRET_DEPUIS_OCTOBRE_1998) { origin case_input; }
        assert "accession-02-coefficient-depense-nette-12": situation_r822_11_13_17(entity_ref("urn:fr:apl:case:accession-02"), false) { origin case_input; }
    }
    // D-42 BOUNDARY: the derived value is Decimal (barème parameter / Decimal
    // function), while the query literal in a Decimal slot lowers to Number
    // (law.core 0.2.7 Number domain) and does not match a Decimal value —
    // named outside E-0324 ("Вне правки": Decimal slots are a separate errata
    // candidate). Both lawc and lawref agree; the expectation follows the pinned
    // text and is kept. Not decidable in the package.
    evaluate truth(coefficient_depense_nette(entity_ref("urn:fr:apl:case:accession-02"), 0.0234));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
