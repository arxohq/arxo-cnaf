// Свой сценарий заморского найма: наёмных дел заморских территорий нет ни у
// Catala, ни у OpenFisca. Факты скупые нарочно — этому шагу ни найма, ни ресурсов
// не нужно, а с ними отказ любого другого звена поразил бы весь документ.
//
// ШАГ: своя таблица R0 Сен-Пьера-и-Микелона переоценивается в январе: пара без
// иждивенцев — 7 889 € по редакции 2025 года (7 552 € в 2023-м, 7 643 € в 2024-м)
// против 7 501 € метрополии.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-saint-pierre-locatif-r0-couple-2025" {
    given {
        context { decision_time @2025-06-15T12:00:00Z; knowledge_time @2025-06-15T12:00:00Z; legal_time @2025-06-15; timezone "Europe/Paris"; }
        assert "saint-pierre-locatif-r0-couple-2025-01": secteur_locatif(entity_ref("urn:fr:apl:case:sp-loc-2025")) { origin case_input; }
        assert "saint-pierre-locatif-r0-couple-2025-02": aide_demandee(entity_ref("urn:fr:apl:case:sp-loc-2025"), APL) { origin case_input; }
        assert "saint-pierre-locatif-r0-couple-2025-03": zone_du_logement(entity_ref("urn:fr:apl:case:sp-loc-2025"), ZONE_II) { origin case_input; }
        assert "saint-pierre-locatif-r0-couple-2025-04": situation_familiale(entity_ref("urn:fr:apl:case:sp-loc-2025"), COUPLE) { origin case_input; }
        assert "saint-pierre-locatif-r0-couple-2025-05": personnes_a_charge(entity_ref("urn:fr:apl:case:sp-loc-2025"), 0) { origin case_input; }
        assert "saint-pierre-locatif-r0-couple-2025-06": mode_location(entity_ref("urn:fr:apl:case:sp-loc-2025"), LOCATION_SEULE) { origin case_input; }
        assert "saint-pierre-locatif-r0-couple-2025-07": territoire(entity_ref("urn:fr:apl:case:sp-loc-2025"), SAINT_PIERRE_ET_MIQUELON) { origin case_input; }
    }
    evaluate truth(abattement_r0(entity_ref("urn:fr:apl:case:sp-loc-2025"), 7889 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
