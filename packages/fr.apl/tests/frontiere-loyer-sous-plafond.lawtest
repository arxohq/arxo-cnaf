// ГРАНИЦА ПЛАФОНА, нижняя половина пары: наём 200 € ниже плафона зоны I
// (298,07 €), поэтому L равен самому найму. Верхняя половина —
// catala-09.lawtest: тот же состав и та же зона при найме 400 €, где L
// упирается в плафон. Точный итог здесь — 120.60487285 €.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-frontiere-loyer-sous-plafond" {
    given {
        context { decision_time @2022-02-15T12:00:00Z; knowledge_time @2022-02-15T12:00:00Z; legal_time @2022-02-15; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "frontiere-loyer-sous-plafond-01": secteur_locatif(entity_ref("urn:fr:apl:case:frontiere-loyer-sous-plafond")) { origin case_input; }
        assert "frontiere-loyer-sous-plafond-02": zone_du_logement(entity_ref("urn:fr:apl:case:frontiere-loyer-sous-plafond"), ZONE_I) { origin case_input; }
        assert "frontiere-loyer-sous-plafond-03": aide_demandee(entity_ref("urn:fr:apl:case:frontiere-loyer-sous-plafond"), APL) { origin case_input; }
        assert "frontiere-loyer-sous-plafond-04": situation_familiale(entity_ref("urn:fr:apl:case:frontiere-loyer-sous-plafond"), PERSONNE_SEULE) { origin case_input; }
        assert "frontiere-loyer-sous-plafond-05": personnes_a_charge(entity_ref("urn:fr:apl:case:frontiere-loyer-sous-plafond"), 0) { origin case_input; }
        assert "frontiere-loyer-sous-plafond-06": loyer_principal(entity_ref("urn:fr:apl:case:frontiere-loyer-sous-plafond"), 200 EUR) { origin case_input; }
        assert "frontiere-loyer-sous-plafond-07": ressources_du_menage(entity_ref("urn:fr:apl:case:frontiere-loyer-sous-plafond"), 7800 EUR) { origin case_input; }
        assert "frontiere-loyer-sous-plafond-08": mode_location(entity_ref("urn:fr:apl:case:frontiere-loyer-sous-plafond"), LOCATION_SEULE) { origin case_input; }
        assert "frontiere-loyer-sous-plafond-09": forme_logement(entity_ref("urn:fr:apl:case:frontiere-loyer-sous-plafond"), LOGEMENT_ORDINAIRE) { origin case_input; }
        assert "frontiere-loyer-sous-plafond-10": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:frontiere-loyer-sous-plafond"), 0 EUR) { origin case_input; }
        assert "frontiere-loyer-sous-plafond-11": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:frontiere-loyer-sous-plafond"), false) { origin case_input; }
        assert "frontiere-loyer-sous-plafond-12": territoire(entity_ref("urn:fr:apl:case:frontiere-loyer-sous-plafond"), METROPOLE) { origin case_input; }
    }
    evaluate truth(aide_mensuelle(entity_ref("urn:fr:apl:case:frontiere-loyer-sous-plafond"), 120.60487285 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
