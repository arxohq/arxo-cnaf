        assert "frem-01": pret_accorde_logement(entity_ref("urn:fr:apl:case:frem"), 800.00 EUR) { origin case_input; }
        assert "frem-02": duree_remboursement_mois(entity_ref("urn:fr:apl:case:frem"), 10) { origin case_input; }
        assert "frem-03": organisme_debiteur(entity_ref("urn:fr:apl:org:caisse-exemple"), entity_ref("urn:fr:apl:case:frem")) { origin case_input; }
    }
    evaluate positions();
    expect position(RembourserPretAmelioration, ACTIVE);
    expect evaluation_status == COMPUTED;
}

