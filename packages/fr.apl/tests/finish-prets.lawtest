test "urn:query:fr-apl-finish-premiere-mensualite-due" {
    given {
        // D-42: D. 542-37 first instalment "a compter du sixieme mois" is a month step; it needs the package calendar policy (MISSING_POLICY, E-0029 without it).
        context { decision_time @2023-03-15T12:00:00Z; knowledge_time @2023-03-15T12:00:00Z; legal_time @2023-03-15; timezone "Europe/Paris"; deadline_policy APL_PRET_MOIS; interpretation PpPlancherFinal; }
        assert "fpre-01": pret_accorde_le(entity_ref("urn:fr:apl:case:fpre"), @2023-02-15) { origin case_input; }
    }
    evaluate truth(premiere_mensualite_due_le(entity_ref("urn:fr:apl:case:fpre"), @2023-08-01));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

