// Exemple8: комната, пара без иждивенцев, зона I, наём 310 €, ресурсы 14 800 €
// 
// ИСТОЧНИК ОЖИДАНИЯ: Catala, CatalaLang/catala-examples@ebe5e7c2, aides_logement/tests/; их значение — 11.06 €.
// НАШ ТОЧНЫЙ ИТОГ: 11.05561205 € (округлений сверх трёх предписанных текстом
// пакет не делает — см. шапку 02-calcul-locatif.law).
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-catala-08" {
    given {
        context { decision_time @2022-04-02T12:00:00Z; knowledge_time @2022-04-02T12:00:00Z; legal_time @2022-04-02; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "catala-08-01": secteur_locatif(entity_ref("urn:fr:apl:case:catala-08")) { origin case_input; }
        assert "catala-08-02": zone_du_logement(entity_ref("urn:fr:apl:case:catala-08"), ZONE_I) { origin case_input; }
        assert "catala-08-03": aide_demandee(entity_ref("urn:fr:apl:case:catala-08"), APL) { origin case_input; }
        assert "catala-08-04": situation_familiale(entity_ref("urn:fr:apl:case:catala-08"), COUPLE) { origin case_input; }
        assert "catala-08-05": personnes_a_charge(entity_ref("urn:fr:apl:case:catala-08"), 0) { origin case_input; }
        assert "catala-08-06": loyer_principal(entity_ref("urn:fr:apl:case:catala-08"), 310 EUR) { origin case_input; }
        assert "catala-08-07": ressources_du_menage(entity_ref("urn:fr:apl:case:catala-08"), 14800 EUR) { origin case_input; }
        assert "catala-08-08": mode_location(entity_ref("urn:fr:apl:case:catala-08"), LOCATION_SEULE) { origin case_input; }
        assert "catala-08-09": forme_logement(entity_ref("urn:fr:apl:case:catala-08"), CHAMBRE) { origin case_input; }
        assert "catala-08-10": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:catala-08"), 0 EUR) { origin case_input; }
        assert "catala-08-11": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:catala-08"), false) { origin case_input; }
        assert "catala-08-12": territoire(entity_ref("urn:fr:apl:case:catala-08"), METROPOLE) { origin case_input; }
    }
    evaluate truth(aide_mensuelle(entity_ref("urn:fr:apl:case:catala-08"), 11.05561205 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
