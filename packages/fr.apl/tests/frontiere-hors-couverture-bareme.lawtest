// ВНЕ ПОКРЫТИЯ БАРЕМА: 1 июня 2019 года ни одна версия статей главы III
// ещё не действовала, и параметр не подставляется последним известным
// значением — расчёт не получает плафона вовсе. Пакет отвечает «не
// установлено», а не правдоподобной суммой.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-frontiere-hors-couverture-bareme" {
    given {
        context { decision_time @2019-06-01T12:00:00Z; knowledge_time @2019-06-01T12:00:00Z; legal_time @2019-06-01; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "frontiere-hors-couverture-bareme-01": secteur_locatif(entity_ref("urn:fr:apl:case:frontiere-hors-couverture-bareme")) { origin case_input; }
        assert "frontiere-hors-couverture-bareme-02": zone_du_logement(entity_ref("urn:fr:apl:case:frontiere-hors-couverture-bareme"), ZONE_I) { origin case_input; }
        assert "frontiere-hors-couverture-bareme-03": aide_demandee(entity_ref("urn:fr:apl:case:frontiere-hors-couverture-bareme"), APL) { origin case_input; }
        assert "frontiere-hors-couverture-bareme-04": situation_familiale(entity_ref("urn:fr:apl:case:frontiere-hors-couverture-bareme"), PERSONNE_SEULE) { origin case_input; }
        assert "frontiere-hors-couverture-bareme-05": personnes_a_charge(entity_ref("urn:fr:apl:case:frontiere-hors-couverture-bareme"), 0) { origin case_input; }
        assert "frontiere-hors-couverture-bareme-06": loyer_principal(entity_ref("urn:fr:apl:case:frontiere-hors-couverture-bareme"), 400 EUR) { origin case_input; }
        assert "frontiere-hors-couverture-bareme-07": ressources_du_menage(entity_ref("urn:fr:apl:case:frontiere-hors-couverture-bareme"), 7800 EUR) { origin case_input; }
        assert "frontiere-hors-couverture-bareme-08": mode_location(entity_ref("urn:fr:apl:case:frontiere-hors-couverture-bareme"), LOCATION_SEULE) { origin case_input; }
        assert "frontiere-hors-couverture-bareme-09": forme_logement(entity_ref("urn:fr:apl:case:frontiere-hors-couverture-bareme"), LOGEMENT_ORDINAIRE) { origin case_input; }
        assert "frontiere-hors-couverture-bareme-10": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:frontiere-hors-couverture-bareme"), 0 EUR) { origin case_input; }
        assert "frontiere-hors-couverture-bareme-11": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:frontiere-hors-couverture-bareme"), false) { origin case_input; }
        assert "frontiere-hors-couverture-bareme-12": territoire(entity_ref("urn:fr:apl:case:frontiere-hors-couverture-bareme"), METROPOLE) { origin case_input; }
    }
    evaluate truth(aide_mensuelle(entity_ref("urn:fr:apl:case:frontiere-hors-couverture-bareme"), 211.05532525 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
}
