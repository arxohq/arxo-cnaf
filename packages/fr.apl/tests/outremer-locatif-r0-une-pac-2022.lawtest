// Свой сценарий заморского найма: наёмных дел заморских территорий нет ни у
// Catala, ни у OpenFisca. Факты скупые нарочно: шагу не нужны ни наём, ни ресурсы.
//
// ШАГ: то же по состоянию с 1 января 2022 года — 7 742 € (метрополия: 8 002 €).
// Форфейт R0 изъятий переоценивается в январе, как и метропольный.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-outremer-locatif-r0-une-pac-2022" {
    given {
        context { decision_time @2022-03-15T12:00:00Z; knowledge_time @2022-03-15T12:00:00Z; legal_time @2022-03-15; timezone "Europe/Paris"; }
        assert "outremer-locatif-r0-une-pac-2022-01": secteur_locatif(entity_ref("urn:fr:apl:case:om-loc-2022")) { origin case_input; }
        assert "outremer-locatif-r0-une-pac-2022-02": aide_demandee(entity_ref("urn:fr:apl:case:om-loc-2022"), APL) { origin case_input; }
        assert "outremer-locatif-r0-une-pac-2022-03": zone_du_logement(entity_ref("urn:fr:apl:case:om-loc-2022"), ZONE_II) { origin case_input; }
        assert "outremer-locatif-r0-une-pac-2022-04": situation_familiale(entity_ref("urn:fr:apl:case:om-loc-2022"), COUPLE) { origin case_input; }
        assert "outremer-locatif-r0-une-pac-2022-05": personnes_a_charge(entity_ref("urn:fr:apl:case:om-loc-2022"), 1) { origin case_input; }
        assert "outremer-locatif-r0-une-pac-2022-06": mode_location(entity_ref("urn:fr:apl:case:om-loc-2022"), LOCATION_SEULE) { origin case_input; }
        assert "outremer-locatif-r0-une-pac-2022-07": territoire(entity_ref("urn:fr:apl:case:om-loc-2022"), OUTRE_MER) { origin case_input; }
    }
    evaluate truth(abattement_r0(entity_ref("urn:fr:apl:case:om-loc-2022"), 7742 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
