// Exemple5: одинокое лицо без иждивенцев, зона I, наём 610 € выше плафона, ресурсы 2 700 € ниже R0 — участие равно минимальному
// 
// ИСТОЧНИК ОЖИДАНИЯ: Catala, CatalaLang/catala-examples@ebe5e7c2, aides_logement/tests/; их значение — 311.56 €.
// НАШ ТОЧНЫЙ ИТОГ: 311.5595 € (округлений сверх трёх предписанных текстом
// пакет не делает — см. шапку 02-calcul-locatif.law).
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-catala-05" {
    given {
        context { decision_time @2022-04-05T12:00:00Z; knowledge_time @2022-04-05T12:00:00Z; legal_time @2022-04-05; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "catala-05-01": secteur_locatif(entity_ref("urn:fr:apl:case:catala-05")) { origin case_input; }
        assert "catala-05-02": zone_du_logement(entity_ref("urn:fr:apl:case:catala-05"), ZONE_I) { origin case_input; }
        assert "catala-05-03": aide_demandee(entity_ref("urn:fr:apl:case:catala-05"), APL) { origin case_input; }
        assert "catala-05-04": situation_familiale(entity_ref("urn:fr:apl:case:catala-05"), PERSONNE_SEULE) { origin case_input; }
        assert "catala-05-05": personnes_a_charge(entity_ref("urn:fr:apl:case:catala-05"), 0) { origin case_input; }
        assert "catala-05-06": loyer_principal(entity_ref("urn:fr:apl:case:catala-05"), 610 EUR) { origin case_input; }
        assert "catala-05-07": ressources_du_menage(entity_ref("urn:fr:apl:case:catala-05"), 2700 EUR) { origin case_input; }
        assert "catala-05-08": mode_location(entity_ref("urn:fr:apl:case:catala-05"), LOCATION_SEULE) { origin case_input; }
        assert "catala-05-09": forme_logement(entity_ref("urn:fr:apl:case:catala-05"), LOGEMENT_ORDINAIRE) { origin case_input; }
        assert "catala-05-10": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:catala-05"), 0 EUR) { origin case_input; }
        assert "catala-05-11": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:catala-05"), false) { origin case_input; }
        assert "catala-05-12": territoire(entity_ref("urn:fr:apl:case:catala-05"), METROPOLE) { origin case_input; }
    }
    evaluate truth(aide_mensuelle(entity_ref("urn:fr:apl:case:catala-05"), 311.5595 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
