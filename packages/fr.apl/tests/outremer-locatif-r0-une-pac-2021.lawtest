// Свой сценарий заморского найма: наёмных дел заморских территорий нет ни у
// Catala, ни у OpenFisca. Факты скупые нарочно: шагу не нужны ни наём, ни ресурсы.
//
// ШАГ: форфейт R0 одного иждивенца по состоянию изъятий с 1 октября 2021 года —
// 7 584 € (метрополия того же месяца права: 7 839 €).
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-outremer-locatif-r0-une-pac-2021" {
    given {
        context { decision_time @2021-11-15T12:00:00Z; knowledge_time @2021-11-15T12:00:00Z; legal_time @2021-11-15; timezone "Europe/Paris"; }
        assert "outremer-locatif-r0-une-pac-2021-01": secteur_locatif(entity_ref("urn:fr:apl:case:om-loc-2021")) { origin case_input; }
        assert "outremer-locatif-r0-une-pac-2021-02": aide_demandee(entity_ref("urn:fr:apl:case:om-loc-2021"), APL) { origin case_input; }
        assert "outremer-locatif-r0-une-pac-2021-03": zone_du_logement(entity_ref("urn:fr:apl:case:om-loc-2021"), ZONE_II) { origin case_input; }
        assert "outremer-locatif-r0-une-pac-2021-04": situation_familiale(entity_ref("urn:fr:apl:case:om-loc-2021"), COUPLE) { origin case_input; }
        assert "outremer-locatif-r0-une-pac-2021-05": personnes_a_charge(entity_ref("urn:fr:apl:case:om-loc-2021"), 1) { origin case_input; }
        assert "outremer-locatif-r0-une-pac-2021-06": mode_location(entity_ref("urn:fr:apl:case:om-loc-2021"), LOCATION_SEULE) { origin case_input; }
        assert "outremer-locatif-r0-une-pac-2021-07": territoire(entity_ref("urn:fr:apl:case:om-loc-2021"), OUTRE_MER) { origin case_input; }
    }
    evaluate truth(abattement_r0(entity_ref("urn:fr:apl:case:om-loc-2021"), 7584 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
