// Дело Catala «CasTest1» (logement-foyer, APL).
//
// ШАГ: минимум чистого расхода (ст. 32 арретэ) — 26,68 € в общем случае.
// Чужими делами этот шаг не утверждается; закреплён из текста.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-foyer-apl-01-depense-nette" {
    given {
        context { decision_time @2022-04-23T12:00:00Z; knowledge_time @2022-04-23T12:00:00Z; legal_time @2022-04-23; timezone "Europe/Paris"; }
        assert "foyer-apl-01-depense-nette-01": secteur_logement_foyer(entity_ref("urn:fr:apl:case:foyer-apl-01")) { origin case_input; }
        assert "foyer-apl-01-depense-nette-02": aide_demandee(entity_ref("urn:fr:apl:case:foyer-apl-01"), APL) { origin case_input; }
        assert "foyer-apl-01-depense-nette-03": zone_du_logement(entity_ref("urn:fr:apl:case:foyer-apl-01"), ZONE_III) { origin case_input; }
        assert "foyer-apl-01-depense-nette-04": situation_familiale(entity_ref("urn:fr:apl:case:foyer-apl-01"), COUPLE) { origin case_input; }
        assert "foyer-apl-01-depense-nette-05": personnes_a_charge(entity_ref("urn:fr:apl:case:foyer-apl-01"), 0) { origin case_input; }
        assert "foyer-apl-01-depense-nette-06": type_logement_foyer(entity_ref("urn:fr:apl:case:foyer-apl-01"), GENERAL) { origin case_input; }
        assert "foyer-apl-01-depense-nette-07": redevance(entity_ref("urn:fr:apl:case:foyer-apl-01"), 360 EUR) { origin case_input; }
        assert "foyer-apl-01-depense-nette-08": ressources_du_menage(entity_ref("urn:fr:apl:case:foyer-apl-01"), 15000 EUR) { origin case_input; }
        assert "foyer-apl-01-depense-nette-09": territoire(entity_ref("urn:fr:apl:case:foyer-apl-01"), METROPOLE) { origin case_input; }
    }
    evaluate truth(depense_nette_minimale(entity_ref("urn:fr:apl:case:foyer-apl-01"), 26.68 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
