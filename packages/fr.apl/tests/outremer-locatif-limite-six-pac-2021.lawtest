// ГЛАВНЫЙ СЦЕНАРИЙ ЭТОГО КРУГА: предел шести иждивенцев.
//
// До 30 декабря 2022 года ст. 46 1° арретэ ограничивала надбавку за иждивенца
// ШЕСТЬЮ лицами и перечисляла семейства параметров, которых это касается. При
// ВОСЬМИ иждивенцах форфейт расходов заморского дела 2021 года равен
// 36,40 € + 9,36 € × 6 = 92,56 €, а не × 8 = 111,28 €.
//
// Парный сценарий `outremer-locatif-limite-six-pac-2024` показывает тот же вход
// после исчезновения правила: там надбавка идёт за все восемь. Предел выражен
// НОРМОЙ с окном `effective`, а не значением на оси A3: меняется форма расчёта,
// а не число.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-outremer-locatif-limite-six-pac-2021" {
    given {
        context { decision_time @2021-11-15T12:00:00Z; knowledge_time @2021-11-15T12:00:00Z; legal_time @2021-11-15; timezone "Europe/Paris"; }
        assert "outremer-locatif-limite-six-pac-2021-01": secteur_locatif(entity_ref("urn:fr:apl:case:om-loc-8pac-2021")) { origin case_input; }
        assert "outremer-locatif-limite-six-pac-2021-02": aide_demandee(entity_ref("urn:fr:apl:case:om-loc-8pac-2021"), APL) { origin case_input; }
        assert "outremer-locatif-limite-six-pac-2021-03": zone_du_logement(entity_ref("urn:fr:apl:case:om-loc-8pac-2021"), ZONE_II) { origin case_input; }
        assert "outremer-locatif-limite-six-pac-2021-04": situation_familiale(entity_ref("urn:fr:apl:case:om-loc-8pac-2021"), COUPLE) { origin case_input; }
        assert "outremer-locatif-limite-six-pac-2021-05": personnes_a_charge(entity_ref("urn:fr:apl:case:om-loc-8pac-2021"), 8) { origin case_input; }
        assert "outremer-locatif-limite-six-pac-2021-06": mode_location(entity_ref("urn:fr:apl:case:om-loc-8pac-2021"), LOCATION_SEULE) { origin case_input; }
        assert "outremer-locatif-limite-six-pac-2021-07": territoire(entity_ref("urn:fr:apl:case:om-loc-8pac-2021"), OUTRE_MER) { origin case_input; }
    }
    evaluate truth(forfait_charges(entity_ref("urn:fr:apl:case:om-loc-8pac-2021"), 92.56 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
