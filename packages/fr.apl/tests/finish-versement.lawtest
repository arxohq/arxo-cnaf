// Third-party payment (17): APL landlord routing, ALF landlord routing on
// decency, the 50.00 EUR excess with the deduction duty, the 10.00 EUR
// allocation threshold, and L. 824-3 resumption to the landlord.
// D-42: the given blocks were written with bare `legal_time @D;` and
// `using fr.apl version ...;` lines, which the .lawtest grammar does not
// parse ("test not parsed" on both evaluators). Rewritten to the context
// form of the other hand suites (decision/knowledge time at noon of the
// legal date, Europe/Paris), carrying the suite's deadline_policy and the
// G-A13 working reading PpPlancherFinal (24-lecture-pp.law). Facts, queries
// and expectations are unchanged.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-finish-dest-apl" {
    given {
        context { decision_time @2022-02-15T12:00:00Z; knowledge_time @2022-02-15T12:00:00Z; legal_time @2022-02-15; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "fdst-01": cas_apl_l831_1(entity_ref("urn:fr:apl:case:fdst"), APL_LOCATIF_AIDE_ETAT_CONVENTIONNE) { origin case_input; }
        assert "fdst-02": occupant_apl_r831_1(entity_ref("urn:fr:apl:case:fdst"), OCC_LOCATIF_CONVENTIONNE_2_3_4) { origin case_input; }
        assert "fdst-03": aide_demandee(entity_ref("urn:fr:apl:case:fdst"), APL) { origin case_input; }
        assert "fdst-04": secteur_locatif(entity_ref("urn:fr:apl:case:fdst")) { origin case_input; }
        assert "fdst-05": bailleur_du_menage(entity_ref("urn:fr:apl:bail:fdst"), entity_ref("urn:fr:apl:case:fdst")) { origin case_input; }
        assert "fdst-06": role_tiers(entity_ref("urn:fr:apl:bail:fdst"), BAILLEUR) { origin case_input; }
    }
    evaluate truth(destinataire_aide(entity_ref("urn:fr:apl:case:fdst"), entity_ref("urn:fr:apl:bail:fdst")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

