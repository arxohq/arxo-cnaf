test "urn:query:fr-apl-finish-seuil-alf" {
    given {
        context { decision_time @2022-02-15T12:00:00Z; knowledge_time @2022-02-15T12:00:00Z; legal_time @2022-02-15; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "fseu-01": aide_demandee(entity_ref("urn:fr:apl:case:fseu"), ALF) { origin case_input; }
        // D-42: L. 823-1 4° sets the payment threshold by requester quality (tenant,
        // D-42: co-tenant, sub-tenant, buyer, hostel resident); the model derives
        // D-42: qualite_demandeur (17) from these findings; case built as a plain tenant.
        assert "fseu-02": secteur_locatif(entity_ref("urn:fr:apl:case:fseu")) { origin case_input; }
        // D-42: L. 823-1 4° sets the payment threshold by requester quality (tenant,
        // D-42: co-tenant, sub-tenant, buyer, hostel resident); the model derives
        // D-42: qualite_demandeur (17) from these findings; case built as a plain tenant.
        assert "fseu-03": mode_location(entity_ref("urn:fr:apl:case:fseu"), LOCATION_SEULE) { origin case_input; }
        // D-42: L. 823-1 4° sets the payment threshold by requester quality (tenant,
        // D-42: co-tenant, sub-tenant, buyer, hostel resident); the model derives
        // D-42: qualite_demandeur (17) from these findings; case built as a plain tenant.
        assert "fseu-04": non_sous_locataire_l8231(entity_ref("urn:fr:apl:case:fseu")) { origin case_input; }
    }
    // D-79: the threshold reaches the head through
    // seuil_versement_allocation_logement(q), i.e. as the 10 EUR value of the
    // pinned parameter (bareme/, from 2019-10-02). Blind expectation unchanged.
    evaluate truth(seuil_versement_applicable(entity_ref("urn:fr:apl:case:fseu"), 10.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "urn:query:fr-apl-finish-reprise-bailleur" {
    given {
        context { decision_time @2024-02-15T12:00:00Z; knowledge_time @2024-02-15T12:00:00Z; legal_time @2024-02-15; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "frep-01": decision_recevabilite_l722_10(entity_ref("urn:fr:apl:case:frep")) { origin case_input; }
        assert "frep-02": versement_suspendu_en_place(entity_ref("urn:fr:apl:case:frep")) { origin case_input; }
        assert "frep-03": percoit_asf(entity_ref("urn:fr:apl:case:frep"), true) { origin case_input; }
        assert "frep-04": aide_demandee(entity_ref("urn:fr:apl:case:frep"), ALF) { origin case_input; }
        assert "frep-05": bailleur_du_menage(entity_ref("urn:fr:apl:bail:frep"), entity_ref("urn:fr:apl:case:frep")) { origin case_input; }
        assert "frep-06": role_tiers(entity_ref("urn:fr:apl:bail:frep"), BAILLEUR) { origin case_input; }
        assert "frep-07": logement_decent(entity_ref("urn:fr:apl:case:frep")) { origin adjudicated; }
        // D-42: L. 824-3 restores "les droits ... dont beneficiait le locataire"; for ALF
        // D-42: to the landlord the model (17 RepriseBailleurALF) also needs the positive
        // D-42: finding that third-party payment is not set aside (L. 842-2), omitted.
        assert "frep-08": absence_refus_bailleur_tiers(entity_ref("urn:fr:apl:case:frep")) { origin case_input; }
    }
    evaluate truth(destinataire_aide(entity_ref("urn:fr:apl:case:frep"), entity_ref("urn:fr:apl:bail:frep")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
