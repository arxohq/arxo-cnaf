// Дело Catala «CasTest1» (logement-foyer, APL), конечная сумма.
//
// Цепочка D. 832-24: Af = 17,1685614 € → минорация 5 € (ст. 28 арретэ) = 12,1685614 €
// → чистый расход 360 − 12,17 = 347,83 € выше минимума 26,68 € (абатмента нет) →
// шаг взносов D. 823-16: ⌊A − 0,5 %·A⌋ + 0,5 %·A.
// Итог 12,060842807 €; Catala утверждает 12,06 € — наш итог до цента совпадает с ним.
// K читается из R. 351-61 (общий случай) и R. 351-61-1 (фойе молодых работников и
// социальные резиденции) — алгебра D. 832-25 в закреплённых данных картинка, см.
// блок «КОЭФФИЦИЕНТ K» в 04-calcul-foyer.law и README, «Коэффициент K».
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-foyer-apl-01-aide-mensuelle" {
    given {
        context { decision_time @2022-04-23T12:00:00Z; knowledge_time @2022-04-23T12:00:00Z; legal_time @2022-04-23; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "foyer-apl-01-aide-mensuelle-01": secteur_logement_foyer(entity_ref("urn:fr:apl:case:foyer-apl-01")) { origin case_input; }
        assert "foyer-apl-01-aide-mensuelle-02": aide_demandee(entity_ref("urn:fr:apl:case:foyer-apl-01"), APL) { origin case_input; }
        assert "foyer-apl-01-aide-mensuelle-03": zone_du_logement(entity_ref("urn:fr:apl:case:foyer-apl-01"), ZONE_III) { origin case_input; }
        assert "foyer-apl-01-aide-mensuelle-04": situation_familiale(entity_ref("urn:fr:apl:case:foyer-apl-01"), COUPLE) { origin case_input; }
        assert "foyer-apl-01-aide-mensuelle-05": personnes_a_charge(entity_ref("urn:fr:apl:case:foyer-apl-01"), 0) { origin case_input; }
        assert "foyer-apl-01-aide-mensuelle-06": type_logement_foyer(entity_ref("urn:fr:apl:case:foyer-apl-01"), GENERAL) { origin case_input; }
        assert "foyer-apl-01-aide-mensuelle-07": redevance(entity_ref("urn:fr:apl:case:foyer-apl-01"), 360 EUR) { origin case_input; }
        assert "foyer-apl-01-aide-mensuelle-08": ressources_du_menage(entity_ref("urn:fr:apl:case:foyer-apl-01"), 15000 EUR) { origin case_input; }
        assert "foyer-apl-01-aide-mensuelle-09": territoire(entity_ref("urn:fr:apl:case:foyer-apl-01"), METROPOLE) { origin case_input; }
    }
    evaluate truth(aide_mensuelle(entity_ref("urn:fr:apl:case:foyer-apl-01"), 12.060842807 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
