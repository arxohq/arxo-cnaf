// ПОРОГ ВЫПЛАТЫ, половина пары: итог расчёта
// 6.0316618 € меньше десяти евро, но для APL порог ст. 12
// арретэ равен НУЛЮ, и пособие выплачивается. Вторая половина —
// frontiere-seuil-versement-als.lawtest: те же входы под аллокацией, где
// порог равен десяти евро и выплаты нет.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-frontiere-seuil-versement-apl" {
    given {
        context { decision_time @2022-02-15T12:00:00Z; knowledge_time @2022-02-15T12:00:00Z; legal_time @2022-02-15; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "frontiere-seuil-versement-apl-01": secteur_locatif(entity_ref("urn:fr:apl:case:frontiere-seuil-versement-apl")) { origin case_input; }
        assert "frontiere-seuil-versement-apl-02": zone_du_logement(entity_ref("urn:fr:apl:case:frontiere-seuil-versement-apl"), ZONE_III) { origin case_input; }
        assert "frontiere-seuil-versement-apl-03": aide_demandee(entity_ref("urn:fr:apl:case:frontiere-seuil-versement-apl"), APL) { origin case_input; }
        assert "frontiere-seuil-versement-apl-04": situation_familiale(entity_ref("urn:fr:apl:case:frontiere-seuil-versement-apl"), PERSONNE_SEULE) { origin case_input; }
        assert "frontiere-seuil-versement-apl-05": personnes_a_charge(entity_ref("urn:fr:apl:case:frontiere-seuil-versement-apl"), 0) { origin case_input; }
        assert "frontiere-seuil-versement-apl-06": loyer_principal(entity_ref("urn:fr:apl:case:frontiere-seuil-versement-apl"), 280 EUR) { origin case_input; }
        assert "frontiere-seuil-versement-apl-07": ressources_du_menage(entity_ref("urn:fr:apl:case:frontiere-seuil-versement-apl"), 12800 EUR) { origin case_input; }
        assert "frontiere-seuil-versement-apl-08": mode_location(entity_ref("urn:fr:apl:case:frontiere-seuil-versement-apl"), LOCATION_SEULE) { origin case_input; }
        assert "frontiere-seuil-versement-apl-09": forme_logement(entity_ref("urn:fr:apl:case:frontiere-seuil-versement-apl"), LOGEMENT_ORDINAIRE) { origin case_input; }
        assert "frontiere-seuil-versement-apl-10": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:frontiere-seuil-versement-apl"), 0 EUR) { origin case_input; }
        assert "frontiere-seuil-versement-apl-11": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:frontiere-seuil-versement-apl"), false) { origin case_input; }
        assert "frontiere-seuil-versement-apl-12": territoire(entity_ref("urn:fr:apl:case:frontiere-seuil-versement-apl"), METROPOLE) { origin case_input; }
    }
    evaluate truth(aide_mensuelle(entity_ref("urn:fr:apl:case:frontiere-seuil-versement-apl"), 6.0316618 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
