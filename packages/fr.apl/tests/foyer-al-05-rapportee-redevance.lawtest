// Собственное дело: аллокация ALS, категория 4° D. 842-16, redevance всего 40 €,
// ресурсы 3 000 €, 15.03.2023.
//
// После минорации и абатмента 162,63861088 € больше redevance, и «il est rapporté au
// montant de cette redevance» (D. 842-15): пособие ограничено 40 €. Шаг взносов даёт
// 39,2 €.
// K читается из R. 351-61 (общий случай) и R. 351-61-1 (фойе молодых работников и
// социальные резиденции) — алгебра D. 832-25 в закреплённых данных картинка, см.
// блок «КОЭФФИЦИЕНТ K» в 04-calcul-foyer.law и README, «Коэффициент K».
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-foyer-al-05-rapportee-redevance" {
    given {
        context { decision_time @2023-03-15T12:00:00Z; knowledge_time @2023-03-15T12:00:00Z; legal_time @2023-03-15; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "foyer-al-05-rapportee-redevance-01": secteur_logement_foyer(entity_ref("urn:fr:apl:case:foyer-al-05")) { origin case_input; }
        assert "foyer-al-05-rapportee-redevance-02": aide_demandee(entity_ref("urn:fr:apl:case:foyer-al-05"), ALS) { origin case_input; }
        assert "foyer-al-05-rapportee-redevance-03": zone_du_logement(entity_ref("urn:fr:apl:case:foyer-al-05"), ZONE_II) { origin case_input; }
        assert "foyer-al-05-rapportee-redevance-04": situation_familiale(entity_ref("urn:fr:apl:case:foyer-al-05"), PERSONNE_SEULE) { origin case_input; }
        assert "foyer-al-05-rapportee-redevance-05": personnes_a_charge(entity_ref("urn:fr:apl:case:foyer-al-05"), 0) { origin case_input; }
        assert "foyer-al-05-rapportee-redevance-06": categorie_equivalence_loyer(entity_ref("urn:fr:apl:case:foyer-al-05"), AUTRES_PERSONNES) { origin case_input; }
        assert "foyer-al-05-rapportee-redevance-07": redevance(entity_ref("urn:fr:apl:case:foyer-al-05"), 40 EUR) { origin case_input; }
        assert "foyer-al-05-rapportee-redevance-08": ressources_du_menage(entity_ref("urn:fr:apl:case:foyer-al-05"), 3000 EUR) { origin case_input; }
        assert "foyer-al-05-rapportee-redevance-09": territoire(entity_ref("urn:fr:apl:case:foyer-al-05"), METROPOLE) { origin case_input; }
    }
    evaluate truth(aide_mensuelle(entity_ref("urn:fr:apl:case:foyer-al-05"), 39.2 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
