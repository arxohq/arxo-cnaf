test "urn:query:fr-apl-finish-recouvrement-locataire" {
    given {
        context { decision_time @2023-03-15T12:00:00Z; knowledge_time @2023-03-15T12:00:00Z; legal_time @2023-03-15; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "frecl-01": trop_percu_deduit_bailleur(entity_ref("urn:fr:apl:case:frecl"), 120.00 EUR) { origin case_input; }
        assert "frecl-02": contestation_recouvrement(entity_ref("urn:fr:apl:case:frecl"), false) { origin case_input; }
        // D-42: R. 823-23: recovery from the tenant applies when "le bailleur ... justifie
        // D-42: qu'il a ... deduit les sommes"; the model (22 CibleRecouvrementLocataire)
        // D-42: asks for that finding plus the landlord, its role and the letting mode,
        // D-42: which the case omitted.
        assert "frecl-03": justification_deduction_indu(entity_ref("urn:fr:apl:case:frecl")) { origin case_input; }
        // D-42: same R. 823-23 premise: the landlord of the household.
        assert "frecl-04": bailleur_du_menage(entity_ref("urn:fr:apl:bail:frecl"), entity_ref("urn:fr:apl:case:frecl")) { origin case_input; }
        // D-42: same: its role is BAILLEUR.
        assert "frecl-05": role_tiers(entity_ref("urn:fr:apl:bail:frecl"), BAILLEUR) { origin case_input; }
        // D-42: same: "aupres du locataire" — a letting (mode_location).
        assert "frecl-06": mode_location(entity_ref("urn:fr:apl:case:frecl"), LOCATION_SEULE) { origin case_input; }
    }
    evaluate truth(recouvrement_aupres_locataire(entity_ref("urn:fr:apl:case:frecl"), 120.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
