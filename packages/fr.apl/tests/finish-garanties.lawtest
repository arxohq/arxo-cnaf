// Guarantees and recovery (22): the two recovery exception channels to
// unseizability, the October bareme indexation list, the Q2-IRL selector
// from 18.08.2022, and tenant-side recovery routing for undisputed
// landlord-deducted overpayments.
// D-42: the given blocks were written with bare `legal_time @D;` and
// `using fr.apl version ...;` lines, which the .lawtest grammar does not
// parse ("test not parsed" on both evaluators). Rewritten to the context
// form of the other hand suites (decision/knowledge time at noon of the
// legal date, Europe/Paris), carrying the suite's deadline_policy and the
// G-A13 working reading PpPlancherFinal (24-lecture-pp.law). Facts, queries
// and expectations are unchanged.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-finish-exception-recouvrement-organisme" {
    given {
        context { decision_time @2023-03-15T12:00:00Z; knowledge_time @2023-03-15T12:00:00Z; legal_time @2023-03-15; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "fexr-01": recouvrement_organisme_l553_2(entity_ref("urn:fr:apl:case:fexr")) { origin case_input; }
    }
    evaluate truth(saisie_exception_autorisee(entity_ref("urn:fr:apl:case:fexr"), RECOUVREMENT_ORGANISME_L553_2));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

