// Дело Catala «CasTest3» (logement-foyer, APL): одинокое лицо, зона I, плата
// 350 €, ресурсы 7 500 €, месяц права — сентябрь 2021 года (барем редакции
// 1 октября 2020 года).
//
// ШАГ: E0 при N = 1,4. Catala утверждает 98,95 €; наш точный итог —
// 98,950268 €.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-foyer-apl-03-equivalence-minimale" {
    given {
        context { decision_time @2021-09-15T12:00:00Z; knowledge_time @2021-09-15T12:00:00Z; legal_time @2021-09-15; timezone "Europe/Paris"; }
        assert "foyer-apl-03-equivalence-minimale-01": secteur_logement_foyer(entity_ref("urn:fr:apl:case:foyer-apl-03")) { origin case_input; }
        assert "foyer-apl-03-equivalence-minimale-02": aide_demandee(entity_ref("urn:fr:apl:case:foyer-apl-03"), APL) { origin case_input; }
        assert "foyer-apl-03-equivalence-minimale-03": zone_du_logement(entity_ref("urn:fr:apl:case:foyer-apl-03"), ZONE_I) { origin case_input; }
        assert "foyer-apl-03-equivalence-minimale-04": situation_familiale(entity_ref("urn:fr:apl:case:foyer-apl-03"), PERSONNE_SEULE) { origin case_input; }
        assert "foyer-apl-03-equivalence-minimale-05": personnes_a_charge(entity_ref("urn:fr:apl:case:foyer-apl-03"), 0) { origin case_input; }
        assert "foyer-apl-03-equivalence-minimale-06": type_logement_foyer(entity_ref("urn:fr:apl:case:foyer-apl-03"), GENERAL) { origin case_input; }
        assert "foyer-apl-03-equivalence-minimale-07": redevance(entity_ref("urn:fr:apl:case:foyer-apl-03"), 350 EUR) { origin case_input; }
        assert "foyer-apl-03-equivalence-minimale-08": ressources_du_menage(entity_ref("urn:fr:apl:case:foyer-apl-03"), 7500 EUR) { origin case_input; }
        assert "foyer-apl-03-equivalence-minimale-09": territoire(entity_ref("urn:fr:apl:case:foyer-apl-03"), METROPOLE) { origin case_input; }
    }
    evaluate truth(equivalence_loyer_minimale(entity_ref("urn:fr:apl:case:foyer-apl-03"), 98.950268 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
