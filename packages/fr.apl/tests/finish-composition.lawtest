test "urn:query:fr-apl-finish-verrou-alternee" {
    given {
        context { decision_time @2023-06-15T12:00:00Z; knowledge_time @2023-06-15T12:00:00Z; legal_time @2023-06-15; timezone "Europe/Paris"; deadline_policy APL_PAC_AGE; interpretation PpPlancherFinal; }
        assert "fver-01": designation_alterne_le(entity_ref("urn:fr:apl:case:fver"), @2023-01-15) { origin case_input; }
        assert "fver-02": contestation_alterne_le(entity_ref("urn:fr:apl:case:fver"), @2023-06-01) { origin case_input; }
    }
    evaluate truth(remise_en_cause_irrecevable(entity_ref("urn:fr:apl:case:fver")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
