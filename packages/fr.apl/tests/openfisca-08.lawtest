// Cas 8: пара с четырьмя иждивенцами, зона II, RLS 80,13 €
// 
// ИСТОЧНИК ОЖИДАНИЯ: OpenFisca-France, openfisca/openfisca-france@b2ab9943, tests/formulas/aides_logement_reforme_janvier_2021.yaml.
// ИХ ЧИСЛА ДВА, и они разные: в файле — 417.48 €, а их КОД на
// закреплённом коммите даёт 417.28 € (замер 13.09.2026, openfisca-france
// 176.0.9; допуск их теста relative_error_margin 0,01 расхождение файла с
// собственным кодом скрывает). Сверяться с кодом: tools/compare_openfisca.py.
// ПРИЧИНА РАСХОЖДЕНИЯ С НАМИ: шаг CRDS и порядок вычета RLS (README, «Квалификация расхождений»).
// НАШ ТОЧНЫЙ ИТОГ: 418.9620875 € (округлений сверх трёх предписанных текстом
// пакет не делает — см. шапку 02-calcul-locatif.law).
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-openfisca-08" {
    given {
        context { decision_time @2021-01-15T12:00:00Z; knowledge_time @2021-01-15T12:00:00Z; legal_time @2021-01-15; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "openfisca-08-01": secteur_locatif(entity_ref("urn:fr:apl:case:openfisca-08")) { origin case_input; }
        assert "openfisca-08-02": zone_du_logement(entity_ref("urn:fr:apl:case:openfisca-08"), ZONE_II) { origin case_input; }
        assert "openfisca-08-03": aide_demandee(entity_ref("urn:fr:apl:case:openfisca-08"), APL) { origin case_input; }
        assert "openfisca-08-04": situation_familiale(entity_ref("urn:fr:apl:case:openfisca-08"), COUPLE) { origin case_input; }
        assert "openfisca-08-05": personnes_a_charge(entity_ref("urn:fr:apl:case:openfisca-08"), 4) { origin case_input; }
        assert "openfisca-08-06": loyer_principal(entity_ref("urn:fr:apl:case:openfisca-08"), 545.93 EUR) { origin case_input; }
        assert "openfisca-08-07": ressources_du_menage(entity_ref("urn:fr:apl:case:openfisca-08"), 11400 EUR) { origin case_input; }
        assert "openfisca-08-08": mode_location(entity_ref("urn:fr:apl:case:openfisca-08"), LOCATION_SEULE) { origin case_input; }
        assert "openfisca-08-09": forme_logement(entity_ref("urn:fr:apl:case:openfisca-08"), LOGEMENT_ORDINAIRE) { origin case_input; }
        assert "openfisca-08-10": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:openfisca-08"), 80.13 EUR) { origin case_input; }
        assert "openfisca-08-11": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:openfisca-08"), false) { origin case_input; }
        assert "openfisca-08-12": territoire(entity_ref("urn:fr:apl:case:openfisca-08"), METROPOLE) { origin case_input; }
    }
    evaluate truth(aide_mensuelle(entity_ref("urn:fr:apl:case:openfisca-08"), 418.9620875 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
