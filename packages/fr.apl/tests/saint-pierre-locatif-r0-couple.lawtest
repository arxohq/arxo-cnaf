// СВОЙ сценарий заморского найма: наёмных дел заморских территорий нет ни у
// Catala, ни у OpenFisca, поэтому шаги выведены из закреплённого текста.
//
// Факты дела нарочно скупые: ни найма, ни ресурсов. Этому шагу они не нужны, а с
// ними сработала бы вся цепочка расчёта, и её отказ в любом звене поразил бы весь
// evaluation-документ.
//
// ШАГ: у Сен-Пьера-и-Микелона ст. 47 даёт СВОЮ таблицу R0 целиком, все девять
// строк. Пара без иждивенцев — 7 552 € против 7 090 € метрополии. Это второй вид
// изъятия: ст. 46 меняет одну строку, ст. 47 — весь барем составов.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-saint-pierre-locatif-r0-couple" {
    given {
        context { decision_time @2023-03-15T12:00:00Z; knowledge_time @2023-03-15T12:00:00Z; legal_time @2023-03-15; timezone "Europe/Paris"; }
        assert "saint-pierre-locatif-r0-couple-01": secteur_locatif(entity_ref("urn:fr:apl:case:sp-loc-a")) { origin case_input; }
        assert "saint-pierre-locatif-r0-couple-02": aide_demandee(entity_ref("urn:fr:apl:case:sp-loc-a"), APL) { origin case_input; }
        assert "saint-pierre-locatif-r0-couple-03": zone_du_logement(entity_ref("urn:fr:apl:case:sp-loc-a"), ZONE_II) { origin case_input; }
        assert "saint-pierre-locatif-r0-couple-04": situation_familiale(entity_ref("urn:fr:apl:case:sp-loc-a"), COUPLE) { origin case_input; }
        assert "saint-pierre-locatif-r0-couple-05": personnes_a_charge(entity_ref("urn:fr:apl:case:sp-loc-a"), 0) { origin case_input; }
        assert "saint-pierre-locatif-r0-couple-06": mode_location(entity_ref("urn:fr:apl:case:sp-loc-a"), LOCATION_SEULE) { origin case_input; }
        assert "saint-pierre-locatif-r0-couple-07": territoire(entity_ref("urn:fr:apl:case:sp-loc-a"), SAINT_PIERRE_ET_MIQUELON) { origin case_input; }
    }
    evaluate truth(abattement_r0(entity_ref("urn:fr:apl:case:sp-loc-a"), 7552 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
