// Cas 4: пара с двумя иждивенцами, зона III, наём 579,50 €, ресурсы 21 600 €
// 
// ИСТОЧНИК ОЖИДАНИЯ: OpenFisca-France, openfisca/openfisca-france@b2ab9943, tests/formulas/aides_logement_reforme_janvier_2021.yaml.
// ИХ ЧИСЛА ДВА, и они разные: в файле — 53.64 €, а их КОД на
// закреплённом коммите даёт 53.60 € (замер 13.09.2026, openfisca-france
// 176.0.9; допуск их теста relative_error_margin 0,01 расхождение файла с
// собственным кодом скрывает). Сверяться с кодом: tools/compare_openfisca.py.
// ПРИЧИНА РАСХОЖДЕНИЯ С НАМИ: шаг CRDS (README, «Квалификация расхождений»).
// НАШ ТОЧНЫЙ ИТОГ: 53.26934925 € (округлений сверх трёх предписанных текстом
// пакет не делает — см. шапку 02-calcul-locatif.law).
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-openfisca-04" {
    given {
        context { decision_time @2021-01-15T12:00:00Z; knowledge_time @2021-01-15T12:00:00Z; legal_time @2021-01-15; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "openfisca-04-01": secteur_locatif(entity_ref("urn:fr:apl:case:openfisca-04")) { origin case_input; }
        assert "openfisca-04-02": zone_du_logement(entity_ref("urn:fr:apl:case:openfisca-04"), ZONE_III) { origin case_input; }
        assert "openfisca-04-03": aide_demandee(entity_ref("urn:fr:apl:case:openfisca-04"), ALF) { origin case_input; }
        assert "openfisca-04-04": situation_familiale(entity_ref("urn:fr:apl:case:openfisca-04"), COUPLE) { origin case_input; }
        assert "openfisca-04-05": personnes_a_charge(entity_ref("urn:fr:apl:case:openfisca-04"), 2) { origin case_input; }
        assert "openfisca-04-06": loyer_principal(entity_ref("urn:fr:apl:case:openfisca-04"), 579.50 EUR) { origin case_input; }
        assert "openfisca-04-07": ressources_du_menage(entity_ref("urn:fr:apl:case:openfisca-04"), 21600 EUR) { origin case_input; }
        assert "openfisca-04-08": mode_location(entity_ref("urn:fr:apl:case:openfisca-04"), LOCATION_SEULE) { origin case_input; }
        assert "openfisca-04-09": forme_logement(entity_ref("urn:fr:apl:case:openfisca-04"), LOGEMENT_ORDINAIRE) { origin case_input; }
        assert "openfisca-04-10": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:openfisca-04"), 0 EUR) { origin case_input; }
        assert "openfisca-04-11": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:openfisca-04"), false) { origin case_input; }
        assert "openfisca-04-12": territoire(entity_ref("urn:fr:apl:case:openfisca-04"), METROPOLE) { origin case_input; }
    }
    evaluate truth(aide_mensuelle(entity_ref("urn:fr:apl:case:openfisca-04"), 53.26934925 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
