// Exemple7: пара с шестью иждивенцами, зона II, наём 527 €, ресурсы 32 200 €
// 
// ПРОМЕЖУТОЧНЫЙ ШАГ: личное участие Pp (D. 823-17). Catala утверждает его
// в сантимах; наш точный итог — 496.09695 €.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-catala-07-participation" {
    given {
        context { decision_time @2022-02-13T12:00:00Z; knowledge_time @2022-02-13T12:00:00Z; legal_time @2022-02-13; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "catala-07-participation-01": secteur_locatif(entity_ref("urn:fr:apl:case:catala-07")) { origin case_input; }
        assert "catala-07-participation-02": zone_du_logement(entity_ref("urn:fr:apl:case:catala-07"), ZONE_II) { origin case_input; }
        assert "catala-07-participation-03": aide_demandee(entity_ref("urn:fr:apl:case:catala-07"), APL) { origin case_input; }
        assert "catala-07-participation-04": situation_familiale(entity_ref("urn:fr:apl:case:catala-07"), COUPLE) { origin case_input; }
        assert "catala-07-participation-05": personnes_a_charge(entity_ref("urn:fr:apl:case:catala-07"), 6) { origin case_input; }
        assert "catala-07-participation-06": loyer_principal(entity_ref("urn:fr:apl:case:catala-07"), 527 EUR) { origin case_input; }
        assert "catala-07-participation-07": ressources_du_menage(entity_ref("urn:fr:apl:case:catala-07"), 32200 EUR) { origin case_input; }
        assert "catala-07-participation-08": mode_location(entity_ref("urn:fr:apl:case:catala-07"), LOCATION_SEULE) { origin case_input; }
        assert "catala-07-participation-09": forme_logement(entity_ref("urn:fr:apl:case:catala-07"), LOGEMENT_ORDINAIRE) { origin case_input; }
        assert "catala-07-participation-10": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:catala-07"), 0 EUR) { origin case_input; }
        assert "catala-07-participation-11": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:catala-07"), false) { origin case_input; }
        assert "catala-07-participation-12": territoire(entity_ref("urn:fr:apl:case:catala-07"), METROPOLE) { origin case_input; }
    }
    evaluate truth(participation_personnelle(entity_ref("urn:fr:apl:case:catala-07"), 496.09695 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
