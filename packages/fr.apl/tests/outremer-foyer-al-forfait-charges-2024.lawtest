// Свой сценарий: дел этих секторов на заморских территориях нет ни у Catala, ни
// у OpenFisca. Факт ресурсов не подан намеренно — этому шагу он не нужен, а с ним
// сработал бы расчёт E0 либо L0, чей отказ поразил бы весь документ.
//
// ШАГ: форфейт расходов аллокации в фойе ЗАМЕНЁН ст. 46 2° a) — статья называет
// арт. 9, 34 и 40 вместе: 38,99 € + 10,03 € = 49,02 € вместо 58,08 € + 13,17 € =
// 71,25 € метрополии того же месяца права.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-outremer-foyer-al-forfait-charges-2024" {
    given {
        context { decision_time @2024-06-15T12:00:00Z; knowledge_time @2024-06-15T12:00:00Z; legal_time @2024-06-15; timezone "Europe/Paris"; }
        assert "outremer-foyer-al-forfait-charges-2024-01": secteur_logement_foyer(entity_ref("urn:fr:apl:case:om-foyer-al-2024")) { origin case_input; }
        assert "outremer-foyer-al-forfait-charges-2024-02": aide_demandee(entity_ref("urn:fr:apl:case:om-foyer-al-2024"), ALF) { origin case_input; }
        assert "outremer-foyer-al-forfait-charges-2024-03": zone_du_logement(entity_ref("urn:fr:apl:case:om-foyer-al-2024"), ZONE_III) { origin case_input; }
        assert "outremer-foyer-al-forfait-charges-2024-04": situation_familiale(entity_ref("urn:fr:apl:case:om-foyer-al-2024"), COUPLE) { origin case_input; }
        assert "outremer-foyer-al-forfait-charges-2024-05": personnes_a_charge(entity_ref("urn:fr:apl:case:om-foyer-al-2024"), 1) { origin case_input; }
        assert "outremer-foyer-al-forfait-charges-2024-06": categorie_equivalence_loyer(entity_ref("urn:fr:apl:case:om-foyer-al-2024"), PERSONNES_AGEES) { origin case_input; }
        assert "outremer-foyer-al-forfait-charges-2024-07": redevance(entity_ref("urn:fr:apl:case:om-foyer-al-2024"), 400 EUR) { origin case_input; }
        assert "outremer-foyer-al-forfait-charges-2024-08": territoire(entity_ref("urn:fr:apl:case:om-foyer-al-2024"), OUTRE_MER) { origin case_input; }
    }
    evaluate truth(forfait_charges_foyer(entity_ref("urn:fr:apl:case:om-foyer-al-2024"), 49.02 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
