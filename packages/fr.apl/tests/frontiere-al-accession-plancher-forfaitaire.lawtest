// СВОЙ сценарий, выведенный из закреплённого текста главы VI: дела Catala этого
// сектора заданы для заморских территорий, и их числа проверяются отдельными
// сценариями `*-guadeloupe-*` и `*-saint-pierre-*`.
//
// ШАГ: вторая база пола ресурсов (2° D. 842-12) — 3 900 € без связи с
// мензуальностью. Выбор базы зависит от пункта R. 842-5 и приходит фактом дела.//
// ПОЧЕМУ В ЭТОМ ДЕЛЕ НЕТ ФАКТА РЕСУРСОВ. Этому шагу они не нужны, и поданы
// намеренно не были: с ними дело считает ещё и L0, а его отказ (непредставимое
// частное либо отсутствие транш второго абзаца до 1 июля 2022 года) поражает ВЕСЬ
// evaluation-документ. Измерено 14.09.2026: с фактом ресурсов сценарий краснеет
// не потому, что его шаг неверен, а потому, что документ целиком неисполним.
// L0 закреплён своими сценариями.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-frontiere-al-accession-plancher-forfaitaire" {
    given {
        context { decision_time @2022-05-01T12:00:00Z; knowledge_time @2022-05-01T12:00:00Z; legal_time @2022-05-01; timezone "Europe/Paris"; }
        assert "frontiere-al-accession-plancher-forfaitaire-01": secteur_accession_allocations(entity_ref("urn:fr:apl:case:al-accession-e")) { origin case_input; }
        assert "frontiere-al-accession-plancher-forfaitaire-02": aide_demandee(entity_ref("urn:fr:apl:case:al-accession-e"), ALF) { origin case_input; }
        assert "frontiere-al-accession-plancher-forfaitaire-03": zone_du_logement(entity_ref("urn:fr:apl:case:al-accession-e"), ZONE_II) { origin case_input; }
        assert "frontiere-al-accession-plancher-forfaitaire-04": situation_familiale(entity_ref("urn:fr:apl:case:al-accession-e"), COUPLE) { origin case_input; }
        assert "frontiere-al-accession-plancher-forfaitaire-05": personnes_a_charge(entity_ref("urn:fr:apl:case:al-accession-e"), 2) { origin case_input; }
        assert "frontiere-al-accession-plancher-forfaitaire-06": vintage_certificat(entity_ref("urn:fr:apl:case:al-accession-e"), CERTIFICAT_DEPUIS_01_10_2019) { origin case_input; }
        assert "frontiere-al-accession-plancher-forfaitaire-07": mode_propriete(entity_ref("urn:fr:apl:case:al-accession-e"), PROPRIETAIRE_UNIQUE) { origin case_input; }
        assert "frontiere-al-accession-plancher-forfaitaire-08": territoire(entity_ref("urn:fr:apl:case:al-accession-e"), METROPOLE) { origin case_input; }
        assert "frontiere-al-accession-plancher-forfaitaire-09": mensualite_declaree(entity_ref("urn:fr:apl:case:al-accession-e"), 500 EUR) { origin case_input; }
        assert "frontiere-al-accession-plancher-forfaitaire-10": base_plancher_ressources(entity_ref("urn:fr:apl:case:al-accession-e"), MONTANT_FORFAITAIRE) { origin case_input; }
        assert "frontiere-al-accession-plancher-forfaitaire-11": situation_r822_11_13_17(entity_ref("urn:fr:apl:case:al-accession-e"), false) { origin case_input; }
    }
    evaluate truth(plancher_ressources_al(entity_ref("urn:fr:apl:case:al-accession-e"), 3900 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
