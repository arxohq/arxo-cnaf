// Deontics D1, active duty: same inputs as frontiere-seuil-versement-apl
// (result 6.0316618 € at APL threshold 0 €), plus the opened right
// (résidence principale + décence with the agency's answer) and the
// debtor agency. Position VerserAideTheoriqueDue — ACTIVE.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-devoir-versement-actif" {
    given {
        // D-42: G-A13 migration (24-lecture-pp.law) — D. 823-17 "P0 ... ne peut etre
        // inferieure a un montant minimum" has two readings in group SensMinimumPp
        // (selection exactly_one); this hand suite selects the working reading, as
        // the other hand suites do. No expectation changed.
        context { decision_time @2022-02-15T12:00:00Z; knowledge_time @2022-02-15T12:00:00Z; legal_time @2022-02-15; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "devoir-versement-actif-01": secteur_locatif(entity_ref("urn:fr:apl:case:devoir-versement-actif")) { origin case_input; }
        assert "devoir-versement-actif-02": zone_du_logement(entity_ref("urn:fr:apl:case:devoir-versement-actif"), ZONE_III) { origin case_input; }
        assert "devoir-versement-actif-03": aide_demandee(entity_ref("urn:fr:apl:case:devoir-versement-actif"), APL) { origin case_input; }
        assert "devoir-versement-actif-04": situation_familiale(entity_ref("urn:fr:apl:case:devoir-versement-actif"), PERSONNE_SEULE) { origin case_input; }
        assert "devoir-versement-actif-05": personnes_a_charge(entity_ref("urn:fr:apl:case:devoir-versement-actif"), 0) { origin case_input; }
        assert "devoir-versement-actif-06": loyer_principal(entity_ref("urn:fr:apl:case:devoir-versement-actif"), 280 EUR) { origin case_input; }
        assert "devoir-versement-actif-07": ressources_du_menage(entity_ref("urn:fr:apl:case:devoir-versement-actif"), 12800 EUR) { origin case_input; }
        assert "devoir-versement-actif-08": mode_location(entity_ref("urn:fr:apl:case:devoir-versement-actif"), LOCATION_SEULE) { origin case_input; }
        assert "devoir-versement-actif-09": forme_logement(entity_ref("urn:fr:apl:case:devoir-versement-actif"), LOGEMENT_ORDINAIRE) { origin case_input; }
        assert "devoir-versement-actif-10": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:devoir-versement-actif"), 0 EUR) { origin case_input; }
        assert "devoir-versement-actif-11": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:devoir-versement-actif"), false) { origin case_input; }
        assert "devoir-versement-actif-12": territoire(entity_ref("urn:fr:apl:case:devoir-versement-actif"), METROPOLE) { origin case_input; }
        assert "devoir-versement-actif-13": occupation_residence_principale(entity_ref("urn:fr:apl:case:devoir-versement-actif")) { origin case_input; }
        assert "devoir-versement-actif-14": logement_decent(entity_ref("urn:fr:apl:case:devoir-versement-actif")) { origin adjudicated; }
        assert "devoir-versement-actif-15": organisme_debiteur(entity_ref("urn:fr:apl:org:caisse-exemple"), entity_ref("urn:fr:apl:case:devoir-versement-actif")) { origin case_input; }
    }
    evaluate positions();
    expect position(VerserAideTheoriqueDue, ACTIVE);
    expect evaluation_status == COMPUTED;
}
