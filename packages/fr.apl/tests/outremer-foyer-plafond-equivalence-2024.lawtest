// Свой сценарий: дел этих секторов на заморских территориях нет ни у Catala, ни
// у OpenFisca. Факт ресурсов не подан намеренно — этому шагу он не нужен, а с ним
// сработал бы расчёт E0 либо L0, чей отказ поразил бы весь документ.
//
// ШАГ, ПОКАЗЫВАЮЩИЙ ГРАНИЦУ ИЗЪЯТИЯ. Плафон эквивалентности найма и расходов
// (ст. 27, редакция с 1 октября 2023 года) — 510,24 € для пары без иждивенцев в
// зоне II. Ст. 46 плафонов НЕ заменяет, поэтому заморское дело берёт строку
// метрополии: если бы изъятие читалось шире, это дело дало бы другое число.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-outremer-foyer-plafond-equivalence-2024" {
    given {
        context { decision_time @2024-06-15T12:00:00Z; knowledge_time @2024-06-15T12:00:00Z; legal_time @2024-06-15; timezone "Europe/Paris"; }
        assert "outremer-foyer-plafond-equivalence-2024-01": secteur_logement_foyer(entity_ref("urn:fr:apl:case:om-foyer-2024")) { origin case_input; }
        assert "outremer-foyer-plafond-equivalence-2024-02": aide_demandee(entity_ref("urn:fr:apl:case:om-foyer-2024"), APL) { origin case_input; }
        assert "outremer-foyer-plafond-equivalence-2024-03": zone_du_logement(entity_ref("urn:fr:apl:case:om-foyer-2024"), ZONE_II) { origin case_input; }
        assert "outremer-foyer-plafond-equivalence-2024-04": situation_familiale(entity_ref("urn:fr:apl:case:om-foyer-2024"), COUPLE) { origin case_input; }
        assert "outremer-foyer-plafond-equivalence-2024-05": personnes_a_charge(entity_ref("urn:fr:apl:case:om-foyer-2024"), 0) { origin case_input; }
        assert "outremer-foyer-plafond-equivalence-2024-06": type_logement_foyer(entity_ref("urn:fr:apl:case:om-foyer-2024"), GENERAL) { origin case_input; }
        assert "outremer-foyer-plafond-equivalence-2024-07": redevance(entity_ref("urn:fr:apl:case:om-foyer-2024"), 400 EUR) { origin case_input; }
        assert "outremer-foyer-plafond-equivalence-2024-08": territoire(entity_ref("urn:fr:apl:case:om-foyer-2024"), OUTRE_MER) { origin case_input; }
    }
    evaluate truth(plafond_equivalence_loyer(entity_ref("urn:fr:apl:case:om-foyer-2024"), 510.24 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
