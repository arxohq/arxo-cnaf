// Противовес: тот же состав и месяц права, но метрополия — 8 862 € (ст. 15,
// редакция с 1 января 2024 года). Рядом с заморскими 8 574 € это показывает, что
// ось территории работает на каждой редакции, а не только на первой.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-metropole-locatif-r0-une-pac-2024" {
    given {
        context { decision_time @2024-06-15T12:00:00Z; knowledge_time @2024-06-15T12:00:00Z; legal_time @2024-06-15; timezone "Europe/Paris"; }
        assert "metropole-locatif-r0-une-pac-2024-01": secteur_locatif(entity_ref("urn:fr:apl:case:mt-loc-2024")) { origin case_input; }
        assert "metropole-locatif-r0-une-pac-2024-02": aide_demandee(entity_ref("urn:fr:apl:case:mt-loc-2024"), APL) { origin case_input; }
        assert "metropole-locatif-r0-une-pac-2024-03": zone_du_logement(entity_ref("urn:fr:apl:case:mt-loc-2024"), ZONE_II) { origin case_input; }
        assert "metropole-locatif-r0-une-pac-2024-04": situation_familiale(entity_ref("urn:fr:apl:case:mt-loc-2024"), COUPLE) { origin case_input; }
        assert "metropole-locatif-r0-une-pac-2024-05": personnes_a_charge(entity_ref("urn:fr:apl:case:mt-loc-2024"), 1) { origin case_input; }
        assert "metropole-locatif-r0-une-pac-2024-06": mode_location(entity_ref("urn:fr:apl:case:mt-loc-2024"), LOCATION_SEULE) { origin case_input; }
        assert "metropole-locatif-r0-une-pac-2024-07": territoire(entity_ref("urn:fr:apl:case:mt-loc-2024"), METROPOLE) { origin case_input; }
    }
    evaluate truth(abattement_r0(entity_ref("urn:fr:apl:case:mt-loc-2024"), 8862 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
