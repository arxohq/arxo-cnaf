// Exemple9: одинокое лицо без иждивенцев, зона I, наём 400 €, ресурсы 7 800 €
// 
// ИСТОЧНИК ОЖИДАНИЯ: Catala, CatalaLang/catala-examples@ebe5e7c2, aides_logement/tests/; их значение — 211.06 €.
// НАШ ТОЧНЫЙ ИТОГ: 211.05532525 € (округлений сверх трёх предписанных текстом
// пакет не делает — см. шапку 02-calcul-locatif.law).
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-catala-09" {
    given {
        context { decision_time @2022-06-10T12:00:00Z; knowledge_time @2022-06-10T12:00:00Z; legal_time @2022-06-10; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "catala-09-01": secteur_locatif(entity_ref("urn:fr:apl:case:catala-09")) { origin case_input; }
        assert "catala-09-02": zone_du_logement(entity_ref("urn:fr:apl:case:catala-09"), ZONE_I) { origin case_input; }
        assert "catala-09-03": aide_demandee(entity_ref("urn:fr:apl:case:catala-09"), APL) { origin case_input; }
        assert "catala-09-04": situation_familiale(entity_ref("urn:fr:apl:case:catala-09"), PERSONNE_SEULE) { origin case_input; }
        assert "catala-09-05": personnes_a_charge(entity_ref("urn:fr:apl:case:catala-09"), 0) { origin case_input; }
        assert "catala-09-06": loyer_principal(entity_ref("urn:fr:apl:case:catala-09"), 400 EUR) { origin case_input; }
        assert "catala-09-07": ressources_du_menage(entity_ref("urn:fr:apl:case:catala-09"), 7800 EUR) { origin case_input; }
        assert "catala-09-08": mode_location(entity_ref("urn:fr:apl:case:catala-09"), LOCATION_SEULE) { origin case_input; }
        assert "catala-09-09": forme_logement(entity_ref("urn:fr:apl:case:catala-09"), LOGEMENT_ORDINAIRE) { origin case_input; }
        assert "catala-09-10": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:catala-09"), 0 EUR) { origin case_input; }
        assert "catala-09-11": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:catala-09"), false) { origin case_input; }
        assert "catala-09-12": territoire(entity_ref("urn:fr:apl:case:catala-09"), METROPOLE) { origin case_input; }
    }
    evaluate truth(aide_mensuelle(entity_ref("urn:fr:apl:case:catala-09"), 211.05532525 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
