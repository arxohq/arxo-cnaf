// РАВНО ДО САНТИМА: их 176.57, наше точное 176.57105. Их модель округляет
// промежуточные величины до сантима, текст этого не велит — закреплён НАШ ответ.
// ИСТОЧНИК: OpenFisca-France, openfisca/openfisca-france@b2ab9943, tests/formulas/tests_formulas_aides_logement.yaml.
// ИХ КОД: aide_logement_participation_personnelle = 176.57; их файл: 39.56 + (0.0283 + 0.00107) * 4665.
// Факты сняты с их же прогона (зона, ресурсы, состав семьи, наём).
// Файл порождён corpus/tools/foreign/openfisca_tests.py по tools/foreign-map.json.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-of-personne-isol-e-2026-08-2026-08-aide-logement-participation-personnelle" {
    given {
        context { decision_time @2026-08-15T12:00:00Z; knowledge_time @2026-08-15T12:00:00Z; legal_time @2026-08-15; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "of-personne-isol-e-2026-08-2026-08-01": secteur_locatif(entity_ref("urn:fr:apl:case:of-personne-isol-e-2026-08-2026-08")) { origin case_input; }
        assert "of-personne-isol-e-2026-08-2026-08-02": aide_demandee(entity_ref("urn:fr:apl:case:of-personne-isol-e-2026-08-2026-08"), APL) { origin case_input; }
        assert "of-personne-isol-e-2026-08-2026-08-03": zone_du_logement(entity_ref("urn:fr:apl:case:of-personne-isol-e-2026-08-2026-08"), ZONE_I) { origin case_input; }
        assert "of-personne-isol-e-2026-08-2026-08-04": situation_familiale(entity_ref("urn:fr:apl:case:of-personne-isol-e-2026-08-2026-08"), PERSONNE_SEULE) { origin case_input; }
        assert "of-personne-isol-e-2026-08-2026-08-05": personnes_a_charge(entity_ref("urn:fr:apl:case:of-personne-isol-e-2026-08-2026-08"), 0) { origin case_input; }
        assert "of-personne-isol-e-2026-08-2026-08-06": ressources_du_menage(entity_ref("urn:fr:apl:case:of-personne-isol-e-2026-08-2026-08"), 9900.00 EUR) { origin case_input; }
        assert "of-personne-isol-e-2026-08-2026-08-07": loyer_principal(entity_ref("urn:fr:apl:case:of-personne-isol-e-2026-08-2026-08"), 200.00 EUR) { origin case_input; }
        assert "of-personne-isol-e-2026-08-2026-08-08": mode_location(entity_ref("urn:fr:apl:case:of-personne-isol-e-2026-08-2026-08"), LOCATION_SEULE) { origin case_input; }
        assert "of-personne-isol-e-2026-08-2026-08-09": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:of-personne-isol-e-2026-08-2026-08"), 35.99 EUR) { origin case_input; }
        assert "of-personne-isol-e-2026-08-2026-08-10": territoire(entity_ref("urn:fr:apl:case:of-personne-isol-e-2026-08-2026-08"), METROPOLE) { origin case_input; }
        assert "of-personne-isol-e-2026-08-2026-08-11": forme_logement(entity_ref("urn:fr:apl:case:of-personne-isol-e-2026-08-2026-08"), LOGEMENT_ORDINAIRE) { origin case_input; }
        assert "of-personne-isol-e-2026-08-2026-08-12": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:of-personne-isol-e-2026-08-2026-08"), false) { origin case_input; }
    }
    evaluate truth(participation_personnelle(entity_ref("urn:fr:apl:case:of-personne-isol-e-2026-08-2026-08"), 176.57105 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
