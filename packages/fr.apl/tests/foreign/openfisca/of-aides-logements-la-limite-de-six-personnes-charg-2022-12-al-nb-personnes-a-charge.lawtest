// ИСТОЧНИК: OpenFisca-France, openfisca/openfisca-france@b2ab9943, tests/formulas/tests_formulas_aides_logement.yaml.
// ИХ КОД: al_nb_personnes_a_charge = 6; их файл: 6.
// Факты сняты с их же прогона (зона, ресурсы, состав семьи, наём). все три вида пособия у них нулевые — вид принят по конвенции жилья
// Файл порождён corpus/tools/foreign/openfisca_tests.py по tools/foreign-map.json.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-of-aides-logements-la-limite-de-six-personnes-charg-2022-12-al-nb-personnes-a-charge" {
    given {
        context { decision_time @2022-12-15T12:00:00Z; knowledge_time @2022-12-15T12:00:00Z; legal_time @2022-12-15; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "of-aides-logements-la-limite-de-six-personnes-charg-2022-12-01": secteur_locatif(entity_ref("urn:fr:apl:case:of-aides-logements-la-limite-de-six-personnes-charg-2022-12")) { origin case_input; }
        assert "of-aides-logements-la-limite-de-six-personnes-charg-2022-12-02": aide_demandee(entity_ref("urn:fr:apl:case:of-aides-logements-la-limite-de-six-personnes-charg-2022-12"), ALF) { origin case_input; }
        assert "of-aides-logements-la-limite-de-six-personnes-charg-2022-12-03": zone_du_logement(entity_ref("urn:fr:apl:case:of-aides-logements-la-limite-de-six-personnes-charg-2022-12"), ZONE_II) { origin case_input; }
        assert "of-aides-logements-la-limite-de-six-personnes-charg-2022-12-04": situation_familiale(entity_ref("urn:fr:apl:case:of-aides-logements-la-limite-de-six-personnes-charg-2022-12"), PERSONNE_SEULE) { origin case_input; }
        assert "of-aides-logements-la-limite-de-six-personnes-charg-2022-12-05": personnes_a_charge(entity_ref("urn:fr:apl:case:of-aides-logements-la-limite-de-six-personnes-charg-2022-12"), 6) { origin case_input; }
        assert "of-aides-logements-la-limite-de-six-personnes-charg-2022-12-06": ressources_du_menage(entity_ref("urn:fr:apl:case:of-aides-logements-la-limite-de-six-personnes-charg-2022-12"), 0.00 EUR) { origin case_input; }
        assert "of-aides-logements-la-limite-de-six-personnes-charg-2022-12-07": loyer_principal(entity_ref("urn:fr:apl:case:of-aides-logements-la-limite-de-six-personnes-charg-2022-12"), 0.00 EUR) { origin case_input; }
        assert "of-aides-logements-la-limite-de-six-personnes-charg-2022-12-08": mode_location(entity_ref("urn:fr:apl:case:of-aides-logements-la-limite-de-six-personnes-charg-2022-12"), LOCATION_SEULE) { origin case_input; }
        assert "of-aides-logements-la-limite-de-six-personnes-charg-2022-12-09": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:of-aides-logements-la-limite-de-six-personnes-charg-2022-12"), 0.00 EUR) { origin case_input; }
        assert "of-aides-logements-la-limite-de-six-personnes-charg-2022-12-10": territoire(entity_ref("urn:fr:apl:case:of-aides-logements-la-limite-de-six-personnes-charg-2022-12"), OUTRE_MER) { origin case_input; }
        assert "of-aides-logements-la-limite-de-six-personnes-charg-2022-12-11": forme_logement(entity_ref("urn:fr:apl:case:of-aides-logements-la-limite-de-six-personnes-charg-2022-12"), LOGEMENT_ORDINAIRE) { origin case_input; }
        assert "of-aides-logements-la-limite-de-six-personnes-charg-2022-12-12": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:of-aides-logements-la-limite-de-six-personnes-charg-2022-12"), false) { origin case_input; }
    }
    evaluate truth(personnes_a_charge_retenues(entity_ref("urn:fr:apl:case:of-aides-logements-la-limite-de-six-personnes-charg-2022-12"), 6));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
