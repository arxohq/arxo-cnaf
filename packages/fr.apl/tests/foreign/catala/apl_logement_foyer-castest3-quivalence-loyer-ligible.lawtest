// ИСТОЧНИК: Catala, CatalaLang/catala-examples@2694b17d, aides_logement/tests/tests_calcul_apl_logement_foyer.catala_fr, scope CasTest3.
// ИХ ОЖИДАНИЕ: équivalence_loyer_éligible = 350.
// Файл порождён corpus/tools/foreign/catala_tests.py по tools/foreign-map.json —
// правится таблица, не файл.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-apl_logement_foyer-castest3-quivalence-loyer-ligible" {
    given {
        context { decision_time @2021-09-15T12:00:00Z; knowledge_time @2021-09-15T12:00:00Z; legal_time @2021-09-15; timezone "Europe/Paris"; interpretation PpPlancherFinal; interpretation ArrondiCentimeHalfUp; }
        assert "apl_logement_foyer-castest3-01": secteur_logement_foyer(entity_ref("urn:fr:apl:case:apl_logement_foyer-castest3")) { origin case_input; }
        assert "apl_logement_foyer-castest3-02": aide_demandee(entity_ref("urn:fr:apl:case:apl_logement_foyer-castest3"), APL) { origin case_input; }
        assert "apl_logement_foyer-castest3-03": territoire(entity_ref("urn:fr:apl:case:apl_logement_foyer-castest3"), METROPOLE) { origin case_input; }
        assert "apl_logement_foyer-castest3-04": type_logement_foyer(entity_ref("urn:fr:apl:case:apl_logement_foyer-castest3"), GENERAL) { origin case_input; }
        assert "apl_logement_foyer-castest3-05": redevance(entity_ref("urn:fr:apl:case:apl_logement_foyer-castest3"), 350 EUR) { origin case_input; }
        assert "apl_logement_foyer-castest3-06": ressources_du_menage(entity_ref("urn:fr:apl:case:apl_logement_foyer-castest3"), 7500 EUR) { origin case_input; }
        assert "apl_logement_foyer-castest3-07": personnes_a_charge(entity_ref("urn:fr:apl:case:apl_logement_foyer-castest3"), 0) { origin case_input; }
        assert "apl_logement_foyer-castest3-08": situation_familiale(entity_ref("urn:fr:apl:case:apl_logement_foyer-castest3"), PERSONNE_SEULE) { origin case_input; }
        assert "apl_logement_foyer-castest3-09": zone_du_logement(entity_ref("urn:fr:apl:case:apl_logement_foyer-castest3"), ZONE_I) { origin case_input; }
    }
    evaluate truth(equivalence_loyer_eligible(entity_ref("urn:fr:apl:case:apl_logement_foyer-castest3"), 350 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
