language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-al_locatif-exemple1-montant" {
    given {
        context { decision_time @2021-09-29T12:00:00Z; knowledge_time @2021-09-29T12:00:00Z; legal_time @2021-09-29; timezone "Europe/Paris"; interpretation PpPlancherFinal; interpretation ArrondiCentimeHalfUp; }
        assert "al_locatif-exemple1-01": secteur_locatif(entity_ref("urn:fr:apl:case:al_locatif-exemple1")) { origin case_input; }
        assert "al_locatif-exemple1-02": aide_demandee(entity_ref("urn:fr:apl:case:al_locatif-exemple1"), ALF) { origin case_input; }
        assert "al_locatif-exemple1-03": loyer_principal(entity_ref("urn:fr:apl:case:al_locatif-exemple1"), 425 EUR) { origin case_input; }
        assert "al_locatif-exemple1-04": ressources_du_menage(entity_ref("urn:fr:apl:case:al_locatif-exemple1"), 11500 EUR) { origin case_input; }
        assert "al_locatif-exemple1-05": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:al_locatif-exemple1"), false) { origin case_input; }
        assert "al_locatif-exemple1-06": personnes_a_charge(entity_ref("urn:fr:apl:case:al_locatif-exemple1"), 2) { origin case_input; }
        assert "al_locatif-exemple1-07": situation_familiale(entity_ref("urn:fr:apl:case:al_locatif-exemple1"), COUPLE) { origin case_input; }
        assert "al_locatif-exemple1-08": zone_du_logement(entity_ref("urn:fr:apl:case:al_locatif-exemple1"), ZONE_II) { origin case_input; }
        assert "al_locatif-exemple1-09": territoire(entity_ref("urn:fr:apl:case:al_locatif-exemple1"), METROPOLE) { origin case_input; }
        assert "al_locatif-exemple1-10": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:al_locatif-exemple1"), 0 EUR) { origin case_input; }
        assert "al_locatif-exemple1-11": mode_location(entity_ref("urn:fr:apl:case:al_locatif-exemple1"), LOCATION_SEULE) { origin case_input; }
        assert "al_locatif-exemple1-12": forme_logement(entity_ref("urn:fr:apl:case:al_locatif-exemple1"), LOGEMENT_ORDINAIRE) { origin case_input; }
    }
    evaluate truth(aide_mensuelle(entity_ref("urn:fr:apl:case:al_locatif-exemple1"), 345.733471 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
