// правится таблица, не файл.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-apl_locatif-exemple7-montant-forfaitaire-charges-d823-16" {
    given {
        context { decision_time @2022-02-13T12:00:00Z; knowledge_time @2022-02-13T12:00:00Z; legal_time @2022-02-13; timezone "Europe/Paris"; interpretation PpPlancherFinal; interpretation ArrondiCentimeHalfUp; }
        assert "apl_locatif-exemple7-01": secteur_locatif(entity_ref("urn:fr:apl:case:apl_locatif-exemple7")) { origin case_input; }
        assert "apl_locatif-exemple7-02": aide_demandee(entity_ref("urn:fr:apl:case:apl_locatif-exemple7"), APL) { origin case_input; }
        assert "apl_locatif-exemple7-03": loyer_principal(entity_ref("urn:fr:apl:case:apl_locatif-exemple7"), 527 EUR) { origin case_input; }
        assert "apl_locatif-exemple7-04": zone_du_logement(entity_ref("urn:fr:apl:case:apl_locatif-exemple7"), ZONE_II) { origin case_input; }
        assert "apl_locatif-exemple7-05": situation_familiale(entity_ref("urn:fr:apl:case:apl_locatif-exemple7"), COUPLE) { origin case_input; }
        assert "apl_locatif-exemple7-06": personnes_a_charge(entity_ref("urn:fr:apl:case:apl_locatif-exemple7"), 6) { origin case_input; }
        assert "apl_locatif-exemple7-07": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:apl_locatif-exemple7"), 0 EUR) { origin case_input; }
        assert "apl_locatif-exemple7-08": ressources_du_menage(entity_ref("urn:fr:apl:case:apl_locatif-exemple7"), 32200 EUR) { origin case_input; }
        assert "apl_locatif-exemple7-09": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:apl_locatif-exemple7"), false) { origin case_input; }
        assert "apl_locatif-exemple7-10": territoire(entity_ref("urn:fr:apl:case:apl_locatif-exemple7"), METROPOLE) { origin case_input; }
        assert "apl_locatif-exemple7-11": mode_location(entity_ref("urn:fr:apl:case:apl_locatif-exemple7"), LOCATION_SEULE) { origin case_input; }
        assert "apl_locatif-exemple7-12": forme_logement(entity_ref("urn:fr:apl:case:apl_locatif-exemple7"), LOGEMENT_ORDINAIRE) { origin case_input; }
    }
    evaluate truth(forfait_charges(entity_ref("urn:fr:apl:case:apl_locatif-exemple7"), 127.96 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
