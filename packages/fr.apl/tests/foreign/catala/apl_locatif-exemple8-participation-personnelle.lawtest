// РАВНО ДО САНТИМА: их 306.36, наше точное 306.35759. Их модель округляет
// промежуточные величины до сантима, текст этого не велит — закреплён НАШ ответ.
// ИСТОЧНИК: Catala, CatalaLang/catala-examples@2694b17d, aides_logement/tests/tests_calcul_apl_locatif.catala_fr, scope Exemple8.
// ИХ ОЖИДАНИЕ: participation_personnelle = 306.36.
// Файл порождён corpus/tools/foreign/catala_tests.py по tools/foreign-map.json —
// правится таблица, не файл.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-apl_locatif-exemple8-participation-personnelle" {
    given {
        context { decision_time @2022-04-02T12:00:00Z; knowledge_time @2022-04-02T12:00:00Z; legal_time @2022-04-02; timezone "Europe/Paris"; interpretation PpPlancherFinal; interpretation ArrondiCentimeHalfUp; }
        assert "apl_locatif-exemple8-01": secteur_locatif(entity_ref("urn:fr:apl:case:apl_locatif-exemple8")) { origin case_input; }
        assert "apl_locatif-exemple8-02": aide_demandee(entity_ref("urn:fr:apl:case:apl_locatif-exemple8"), APL) { origin case_input; }
        assert "apl_locatif-exemple8-03": loyer_principal(entity_ref("urn:fr:apl:case:apl_locatif-exemple8"), 310 EUR) { origin case_input; }
        assert "apl_locatif-exemple8-04": zone_du_logement(entity_ref("urn:fr:apl:case:apl_locatif-exemple8"), ZONE_I) { origin case_input; }
        assert "apl_locatif-exemple8-05": situation_familiale(entity_ref("urn:fr:apl:case:apl_locatif-exemple8"), COUPLE) { origin case_input; }
        assert "apl_locatif-exemple8-06": personnes_a_charge(entity_ref("urn:fr:apl:case:apl_locatif-exemple8"), 0) { origin case_input; }
        assert "apl_locatif-exemple8-07": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:apl_locatif-exemple8"), 0 EUR) { origin case_input; }
        assert "apl_locatif-exemple8-08": ressources_du_menage(entity_ref("urn:fr:apl:case:apl_locatif-exemple8"), 14800 EUR) { origin case_input; }
        assert "apl_locatif-exemple8-09": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:apl_locatif-exemple8"), false) { origin case_input; }
        assert "apl_locatif-exemple8-10": territoire(entity_ref("urn:fr:apl:case:apl_locatif-exemple8"), METROPOLE) { origin case_input; }
        assert "apl_locatif-exemple8-11": mode_location(entity_ref("urn:fr:apl:case:apl_locatif-exemple8"), LOCATION_SEULE) { origin case_input; }
        assert "apl_locatif-exemple8-12": forme_logement(entity_ref("urn:fr:apl:case:apl_locatif-exemple8"), CHAMBRE) { origin case_input; }
    }
    evaluate truth(participation_personnelle(entity_ref("urn:fr:apl:case:apl_locatif-exemple8"), 306.35759 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
