language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-apl_accession_propriete-exemple3-mensualit-minimale" {
    given {
        context { decision_time @2022-05-01T12:00:00Z; knowledge_time @2022-05-01T12:00:00Z; legal_time @2022-05-01; timezone "Europe/Paris"; interpretation PpPlancherFinal; interpretation ArrondiCentimeHalfUp; }
        assert "apl_accession_propriete-exemple3-01": secteur_accession(entity_ref("urn:fr:apl:case:apl_accession_propriete-exemple3")) { origin case_input; }
        assert "apl_accession_propriete-exemple3-02": aide_demandee(entity_ref("urn:fr:apl:case:apl_accession_propriete-exemple3"), APL) { origin case_input; }
        assert "apl_accession_propriete-exemple3-03": ressources_du_menage(entity_ref("urn:fr:apl:case:apl_accession_propriete-exemple3"), 18000 EUR) { origin case_input; }
        assert "apl_accession_propriete-exemple3-04": zone_du_logement(entity_ref("urn:fr:apl:case:apl_accession_propriete-exemple3"), ZONE_II) { origin case_input; }
        assert "apl_accession_propriete-exemple3-05": territoire(entity_ref("urn:fr:apl:case:apl_accession_propriete-exemple3"), METROPOLE) { origin case_input; }
        assert "apl_accession_propriete-exemple3-06": mensualite_declaree(entity_ref("urn:fr:apl:case:apl_accession_propriete-exemple3"), 650 EUR) { origin case_input; }
        assert "apl_accession_propriete-exemple3-07": personnes_a_charge(entity_ref("urn:fr:apl:case:apl_accession_propriete-exemple3"), 2) { origin case_input; }
        assert "apl_accession_propriete-exemple3-08": situation_familiale(entity_ref("urn:fr:apl:case:apl_accession_propriete-exemple3"), COUPLE) { origin case_input; }
        assert "apl_accession_propriete-exemple3-09": type_travaux(entity_ref("urn:fr:apl:case:apl_accession_propriete-exemple3"), PAS_DE_TRAVAUX) { origin case_input; }
        assert "apl_accession_propriete-exemple3-10": finalite_operation(entity_ref("urn:fr:apl:case:apl_accession_propriete-exemple3"), LOGEMENT_NEUF) { origin case_input; }
        assert "apl_accession_propriete-exemple3-11": mode_propriete(entity_ref("urn:fr:apl:case:apl_accession_propriete-exemple3"), PROPRIETAIRE_UNIQUE) { origin case_input; }
        assert "apl_accession_propriete-exemple3-12": situation_r822_11_13_17(entity_ref("urn:fr:apl:case:apl_accession_propriete-exemple3"), false) { origin case_input; }
        assert "apl_accession_propriete-exemple3-13": sous_cas_mensualite(entity_ref("urn:fr:apl:case:apl_accession_propriete-exemple3"), PRET_APRES_30_09_2017) { origin case_input; }
        assert "apl_accession_propriete-exemple3-14": vintage_pret_depense_nette(entity_ref("urn:fr:apl:case:apl_accession_propriete-exemple3"), PRET_DEPUIS_OCTOBRE_1998) { origin case_input; }
    }
    evaluate truth(mensualite_minimale(entity_ref("urn:fr:apl:case:apl_accession_propriete-exemple3"), 332.7558 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
