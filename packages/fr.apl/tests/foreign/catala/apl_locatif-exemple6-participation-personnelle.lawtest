// РАВНО ДО САНТИМА: их 477.32, наше точное 477.31905. Их модель округляет
// промежуточные величины до сантима, текст этого не велит — закреплён НАШ ответ.
// ИСТОЧНИК: Catala, CatalaLang/catala-examples@2694b17d, aides_logement/tests/tests_calcul_apl_locatif.catala_fr, scope Exemple6.
// ИХ ОЖИДАНИЕ: participation_personnelle = 477.32.
// Файл порождён corpus/tools/foreign/catala_tests.py по tools/foreign-map.json —
// правится таблица, не файл.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-apl_locatif-exemple6-participation-personnelle" {
    given {
        context { decision_time @2022-05-02T12:00:00Z; knowledge_time @2022-05-02T12:00:00Z; legal_time @2022-05-02; timezone "Europe/Paris"; interpretation PpPlancherFinal; interpretation ArrondiCentimeHalfUp; }
        assert "apl_locatif-exemple6-01": secteur_locatif(entity_ref("urn:fr:apl:case:apl_locatif-exemple6")) { origin case_input; }
        assert "apl_locatif-exemple6-02": aide_demandee(entity_ref("urn:fr:apl:case:apl_locatif-exemple6"), APL) { origin case_input; }
        assert "apl_locatif-exemple6-03": loyer_principal(entity_ref("urn:fr:apl:case:apl_locatif-exemple6"), 436 EUR) { origin case_input; }
        assert "apl_locatif-exemple6-04": zone_du_logement(entity_ref("urn:fr:apl:case:apl_locatif-exemple6"), ZONE_II) { origin case_input; }
        assert "apl_locatif-exemple6-05": situation_familiale(entity_ref("urn:fr:apl:case:apl_locatif-exemple6"), COUPLE) { origin case_input; }
        assert "apl_locatif-exemple6-06": personnes_a_charge(entity_ref("urn:fr:apl:case:apl_locatif-exemple6"), 0) { origin case_input; }
        assert "apl_locatif-exemple6-07": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:apl_locatif-exemple6"), 0 EUR) { origin case_input; }
        assert "apl_locatif-exemple6-08": ressources_du_menage(entity_ref("urn:fr:apl:case:apl_locatif-exemple6"), 19500 EUR) { origin case_input; }
        assert "apl_locatif-exemple6-09": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:apl_locatif-exemple6"), false) { origin case_input; }
        assert "apl_locatif-exemple6-10": territoire(entity_ref("urn:fr:apl:case:apl_locatif-exemple6"), METROPOLE) { origin case_input; }
        assert "apl_locatif-exemple6-11": mode_location(entity_ref("urn:fr:apl:case:apl_locatif-exemple6"), LOCATION_SEULE) { origin case_input; }
        assert "apl_locatif-exemple6-12": forme_logement(entity_ref("urn:fr:apl:case:apl_locatif-exemple6"), LOGEMENT_ORDINAIRE) { origin case_input; }
    }
    evaluate truth(participation_personnelle(entity_ref("urn:fr:apl:case:apl_locatif-exemple6"), 477.31905 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
