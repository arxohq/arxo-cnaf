// ИСТОЧНИК: Catala, CatalaLang/catala-examples@2694b17d, aides_logement/tests/tests_calcul_apl_logement_foyer.catala_fr, scope CasTest1.
// ИХ ОЖИДАНИЕ: équivalence_loyer_minimale = 318.13.
// Файл порождён corpus/tools/foreign/catala_tests.py по tools/foreign-map.json —
// правится таблица, не файл.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-apl_logement_foyer-castest1-quivalence-loyer-minimale" {
    given {
        context { decision_time @2022-04-23T12:00:00Z; knowledge_time @2022-04-23T12:00:00Z; legal_time @2022-04-23; timezone "Europe/Paris"; interpretation PpPlancherFinal; interpretation ArrondiCentimeHalfUp; }
        assert "apl_logement_foyer-castest1-01": secteur_logement_foyer(entity_ref("urn:fr:apl:case:apl_logement_foyer-castest1")) { origin case_input; }
        assert "apl_logement_foyer-castest1-02": aide_demandee(entity_ref("urn:fr:apl:case:apl_logement_foyer-castest1"), APL) { origin case_input; }
        assert "apl_logement_foyer-castest1-03": territoire(entity_ref("urn:fr:apl:case:apl_logement_foyer-castest1"), METROPOLE) { origin case_input; }
        assert "apl_logement_foyer-castest1-04": type_logement_foyer(entity_ref("urn:fr:apl:case:apl_logement_foyer-castest1"), GENERAL) { origin case_input; }
        assert "apl_logement_foyer-castest1-05": redevance(entity_ref("urn:fr:apl:case:apl_logement_foyer-castest1"), 360 EUR) { origin case_input; }
        assert "apl_logement_foyer-castest1-06": ressources_du_menage(entity_ref("urn:fr:apl:case:apl_logement_foyer-castest1"), 15000 EUR) { origin case_input; }
        assert "apl_logement_foyer-castest1-07": personnes_a_charge(entity_ref("urn:fr:apl:case:apl_logement_foyer-castest1"), 0) { origin case_input; }
        assert "apl_logement_foyer-castest1-08": situation_familiale(entity_ref("urn:fr:apl:case:apl_logement_foyer-castest1"), COUPLE) { origin case_input; }
        assert "apl_logement_foyer-castest1-09": zone_du_logement(entity_ref("urn:fr:apl:case:apl_logement_foyer-castest1"), ZONE_III) { origin case_input; }
    }
    evaluate truth(equivalence_loyer_minimale(entity_ref("urn:fr:apl:case:apl_logement_foyer-castest1"), 318.13 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
