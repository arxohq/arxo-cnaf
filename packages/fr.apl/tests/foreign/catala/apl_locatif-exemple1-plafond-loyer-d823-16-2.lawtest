// ИСТОЧНИК: Catala, CatalaLang/catala-examples@2694b17d, aides_logement/tests/tests_calcul_apl_locatif.catala_fr, scope Exemple1.
// ИХ ОЖИДАНИЕ: plafond_loyer_d823_16_2 = 524.20.
// Файл порождён corpus/tools/foreign/catala_tests.py по tools/foreign-map.json —
// правится таблица, не файл.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-apl_locatif-exemple1-plafond-loyer-d823-16-2" {
    given {
        context { decision_time @2022-02-03T12:00:00Z; knowledge_time @2022-02-03T12:00:00Z; legal_time @2022-02-03; timezone "Europe/Paris"; interpretation PpPlancherFinal; interpretation ArrondiCentimeHalfUp; }
        assert "apl_locatif-exemple1-01": secteur_locatif(entity_ref("urn:fr:apl:case:apl_locatif-exemple1")) { origin case_input; }
        assert "apl_locatif-exemple1-02": aide_demandee(entity_ref("urn:fr:apl:case:apl_locatif-exemple1"), APL) { origin case_input; }
        assert "apl_locatif-exemple1-03": loyer_principal(entity_ref("urn:fr:apl:case:apl_locatif-exemple1"), 700 EUR) { origin case_input; }
        assert "apl_locatif-exemple1-04": zone_du_logement(entity_ref("urn:fr:apl:case:apl_locatif-exemple1"), ZONE_I) { origin case_input; }
        assert "apl_locatif-exemple1-05": situation_familiale(entity_ref("urn:fr:apl:case:apl_locatif-exemple1"), COUPLE) { origin case_input; }
        assert "apl_locatif-exemple1-06": personnes_a_charge(entity_ref("urn:fr:apl:case:apl_locatif-exemple1"), 3) { origin case_input; }
        assert "apl_locatif-exemple1-07": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:apl_locatif-exemple1"), 0 EUR) { origin case_input; }
        assert "apl_locatif-exemple1-08": ressources_du_menage(entity_ref("urn:fr:apl:case:apl_locatif-exemple1"), 36000 EUR) { origin case_input; }
        assert "apl_locatif-exemple1-09": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:apl_locatif-exemple1"), false) { origin case_input; }
        assert "apl_locatif-exemple1-10": territoire(entity_ref("urn:fr:apl:case:apl_locatif-exemple1"), METROPOLE) { origin case_input; }
        assert "apl_locatif-exemple1-11": mode_location(entity_ref("urn:fr:apl:case:apl_locatif-exemple1"), LOCATION_SEULE) { origin case_input; }
        assert "apl_locatif-exemple1-12": forme_logement(entity_ref("urn:fr:apl:case:apl_locatif-exemple1"), LOGEMENT_ORDINAIRE) { origin case_input; }
    }
    evaluate truth(plafond_loyer(entity_ref("urn:fr:apl:case:apl_locatif-exemple1"), 524.2 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
