// РАВНО ДО САНТИМА: их 352.77, наше точное 352.7652695. Их модель округляет
// промежуточные величины до сантима, текст этого не велит — закреплён НАШ ответ.
// ИСТОЧНИК: Catala, CatalaLang/catala-examples@2694b17d, aides_logement/tests/tests_calcul_al_locatif.catala_fr, scope Exemple2.
// ИХ ОЖИДАНИЕ: montant = 352.77.
// Файл порождён corpus/tools/foreign/catala_tests.py по tools/foreign-map.json —
// правится таблица, не файл.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-al_locatif-exemple2-montant" {
    given {
        context { decision_time @2022-05-01T12:00:00Z; knowledge_time @2022-05-01T12:00:00Z; legal_time @2022-05-01; timezone "Europe/Paris"; interpretation PpPlancherFinal; interpretation ArrondiCentimeHalfUp; }
        assert "al_locatif-exemple2-01": secteur_locatif(entity_ref("urn:fr:apl:case:al_locatif-exemple2")) { origin case_input; }
        assert "al_locatif-exemple2-02": aide_demandee(entity_ref("urn:fr:apl:case:al_locatif-exemple2"), ALF) { origin case_input; }
        assert "al_locatif-exemple2-03": loyer_principal(entity_ref("urn:fr:apl:case:al_locatif-exemple2"), 425 EUR) { origin case_input; }
        assert "al_locatif-exemple2-04": ressources_du_menage(entity_ref("urn:fr:apl:case:al_locatif-exemple2"), 11500 EUR) { origin case_input; }
        assert "al_locatif-exemple2-05": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:al_locatif-exemple2"), false) { origin case_input; }
        assert "al_locatif-exemple2-06": personnes_a_charge(entity_ref("urn:fr:apl:case:al_locatif-exemple2"), 2) { origin case_input; }
        assert "al_locatif-exemple2-07": situation_familiale(entity_ref("urn:fr:apl:case:al_locatif-exemple2"), COUPLE) { origin case_input; }
        assert "al_locatif-exemple2-08": zone_du_logement(entity_ref("urn:fr:apl:case:al_locatif-exemple2"), ZONE_II) { origin case_input; }
        assert "al_locatif-exemple2-09": territoire(entity_ref("urn:fr:apl:case:al_locatif-exemple2"), METROPOLE) { origin case_input; }
        assert "al_locatif-exemple2-10": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:al_locatif-exemple2"), 0 EUR) { origin case_input; }
        assert "al_locatif-exemple2-11": mode_location(entity_ref("urn:fr:apl:case:al_locatif-exemple2"), LOCATION_SEULE) { origin case_input; }
        assert "al_locatif-exemple2-12": forme_logement(entity_ref("urn:fr:apl:case:al_locatif-exemple2"), LOGEMENT_ORDINAIRE) { origin case_input; }
    }
    evaluate truth(aide_mensuelle(entity_ref("urn:fr:apl:case:al_locatif-exemple2"), 352.7652695 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
