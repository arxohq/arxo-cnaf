// РАВНО у оракула (lawref), но lawc отвечает NEITHER: D-11 — сравнение truth() с Decimal в ядре
// (тот же дефект, что у шести известных отказов набора fr.apl#catala-import и соседних). Файл отложен
// после finalize.py 09.10.2026: в [tests] не входит до исправления D-11 в lawc; класс в REPORT.md — РАВНО.
// ИСТОЧНИК: Catala, CatalaLang/catala-examples@2694b17d, aides_logement/tests/tests_calcul_al_logement_foyer.catala_fr, scope CasTest1.
// ИХ ОЖИДАНИЕ: coefficient_prise_en_charge = 0.6.
// Файл порождён corpus/tools/foreign/catala_tests.py по tools/foreign-map.json —
// правится таблица, не файл.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-al_logement_foyer-castest1-coefficient-prise-en-charge" {
    given {
        context { decision_time @2022-05-01T12:00:00Z; knowledge_time @2022-05-01T12:00:00Z; legal_time @2022-05-01; timezone "Europe/Paris"; interpretation PpPlancherFinal; interpretation ArrondiCentimeHalfUp; }
        assert "al_logement_foyer-castest1-01": secteur_logement_foyer(entity_ref("urn:fr:apl:case:al_logement_foyer-castest1")) { origin case_input; }
        assert "al_logement_foyer-castest1-02": aide_demandee(entity_ref("urn:fr:apl:case:al_logement_foyer-castest1"), ALF) { origin case_input; }
        assert "al_logement_foyer-castest1-03": type_logement_foyer(entity_ref("urn:fr:apl:case:al_logement_foyer-castest1"), JEUNES_TRAVAILLEURS_OU_RESIDENCE_SOCIALE) { origin case_input; }
        assert "al_logement_foyer-castest1-04": redevance(entity_ref("urn:fr:apl:case:al_logement_foyer-castest1"), 350 EUR) { origin case_input; }
        assert "al_logement_foyer-castest1-05": territoire(entity_ref("urn:fr:apl:case:al_logement_foyer-castest1"), METROPOLE) { origin case_input; }
        assert "al_logement_foyer-castest1-06": ressources_du_menage(entity_ref("urn:fr:apl:case:al_logement_foyer-castest1"), 7500 EUR) { origin case_input; }
        assert "al_logement_foyer-castest1-07": personnes_a_charge(entity_ref("urn:fr:apl:case:al_logement_foyer-castest1"), 0) { origin case_input; }
        assert "al_logement_foyer-castest1-08": situation_familiale(entity_ref("urn:fr:apl:case:al_logement_foyer-castest1"), PERSONNE_SEULE) { origin case_input; }
        assert "al_logement_foyer-castest1-09": zone_du_logement(entity_ref("urn:fr:apl:case:al_logement_foyer-castest1"), ZONE_I) { origin case_input; }
        assert "al_logement_foyer-castest1-10": categorie_equivalence_loyer(entity_ref("urn:fr:apl:case:al_logement_foyer-castest1"), PERSONNES_AGEES) { origin case_input; }
    }
    evaluate truth(coefficient_prise_en_charge(entity_ref("urn:fr:apl:case:al_logement_foyer-castest1"), 0.6));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
