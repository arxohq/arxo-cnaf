// правится таблица, не файл.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-apl_logement_foyer-castest5-montant" {
    given {
        context { decision_time @2022-05-01T12:00:00Z; knowledge_time @2022-05-01T12:00:00Z; legal_time @2022-05-01; timezone "Europe/Paris"; interpretation PpPlancherFinal; interpretation ArrondiCentimeHalfUp; }
        assert "apl_logement_foyer-castest5-01": secteur_logement_foyer(entity_ref("urn:fr:apl:case:apl_logement_foyer-castest5")) { origin case_input; }
        assert "apl_logement_foyer-castest5-02": aide_demandee(entity_ref("urn:fr:apl:case:apl_logement_foyer-castest5"), APL) { origin case_input; }
        assert "apl_logement_foyer-castest5-03": territoire(entity_ref("urn:fr:apl:case:apl_logement_foyer-castest5"), METROPOLE) { origin case_input; }
        assert "apl_logement_foyer-castest5-04": type_logement_foyer(entity_ref("urn:fr:apl:case:apl_logement_foyer-castest5"), JEUNES_TRAVAILLEURS_OU_RESIDENCE_SOCIALE) { origin case_input; }
        assert "apl_logement_foyer-castest5-05": redevance(entity_ref("urn:fr:apl:case:apl_logement_foyer-castest5"), 350 EUR) { origin case_input; }
        assert "apl_logement_foyer-castest5-06": ressources_du_menage(entity_ref("urn:fr:apl:case:apl_logement_foyer-castest5"), 7500 EUR) { origin case_input; }
        assert "apl_logement_foyer-castest5-07": personnes_a_charge(entity_ref("urn:fr:apl:case:apl_logement_foyer-castest5"), 0) { origin case_input; }
        assert "apl_logement_foyer-castest5-08": situation_familiale(entity_ref("urn:fr:apl:case:apl_logement_foyer-castest5"), PERSONNE_SEULE) { origin case_input; }
        assert "apl_logement_foyer-castest5-09": zone_du_logement(entity_ref("urn:fr:apl:case:apl_logement_foyer-castest5"), ZONE_I) { origin case_input; }
    }
    evaluate truth(aide_mensuelle(entity_ref("urn:fr:apl:case:apl_logement_foyer-castest5"), 129.65 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
