// СВОЙ сценарий, выведенный из закреплённого текста главы VI: дела Catala этого
// сектора заданы для заморских территорий, и их числа проверяются отдельными
// сценариями `*-guadeloupe-*` и `*-saint-pierre-*`.
//
// ШАГ: ст. 37 1° — у сособственников плафон есть 75 % плафона ст. 33:
// 379,15 € × 0,75 = 284,3625 €.//
// ПОЧЕМУ В ЭТОМ ДЕЛЕ НЕТ ФАКТА РЕСУРСОВ. Этому шагу они не нужны, и поданы
// намеренно не были: с ними дело считает ещё и L0, а его отказ (непредставимое
// частное либо отсутствие транш второго абзаца до 1 июля 2022 года) поражает ВЕСЬ
// evaluation-документ. Измерено 14.09.2026: с фактом ресурсов сценарий краснеет
// не потому, что его шаг неверен, а потому, что документ целиком неисполним.
// L0 закреплён своими сценариями.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-frontiere-al-accession-copropriete" {
    given {
        context { decision_time @2022-05-01T12:00:00Z; knowledge_time @2022-05-01T12:00:00Z; legal_time @2022-05-01; timezone "Europe/Paris"; }
        assert "frontiere-al-accession-copropriete-01": secteur_accession_allocations(entity_ref("urn:fr:apl:case:al-accession-c")) { origin case_input; }
        assert "frontiere-al-accession-copropriete-02": aide_demandee(entity_ref("urn:fr:apl:case:al-accession-c"), ALF) { origin case_input; }
        assert "frontiere-al-accession-copropriete-03": zone_du_logement(entity_ref("urn:fr:apl:case:al-accession-c"), ZONE_II) { origin case_input; }
        assert "frontiere-al-accession-copropriete-04": situation_familiale(entity_ref("urn:fr:apl:case:al-accession-c"), COUPLE) { origin case_input; }
        assert "frontiere-al-accession-copropriete-05": personnes_a_charge(entity_ref("urn:fr:apl:case:al-accession-c"), 2) { origin case_input; }
        assert "frontiere-al-accession-copropriete-06": vintage_certificat(entity_ref("urn:fr:apl:case:al-accession-c"), CERTIFICAT_DEPUIS_01_10_2019) { origin case_input; }
        assert "frontiere-al-accession-copropriete-07": mode_propriete(entity_ref("urn:fr:apl:case:al-accession-c"), COPROPRIETAIRE) { origin case_input; }
        assert "frontiere-al-accession-copropriete-08": territoire(entity_ref("urn:fr:apl:case:al-accession-c"), METROPOLE) { origin case_input; }
        assert "frontiere-al-accession-copropriete-09": nombre_coproprietaires(entity_ref("urn:fr:apl:case:al-accession-c"), 2.0) { origin case_input; }
        assert "frontiere-al-accession-copropriete-10": mensualite_declaree(entity_ref("urn:fr:apl:case:al-accession-c"), 500 EUR) { origin case_input; }
        assert "frontiere-al-accession-copropriete-11": base_plancher_ressources(entity_ref("urn:fr:apl:case:al-accession-c"), COEFFICIENT_MENSUALITE) { origin case_input; }
        assert "frontiere-al-accession-copropriete-12": situation_r822_11_13_17(entity_ref("urn:fr:apl:case:al-accession-c"), false) { origin case_input; }
    }
    evaluate truth(plafond_mensualite_al(entity_ref("urn:fr:apl:case:al-accession-c"), 284.3625 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
