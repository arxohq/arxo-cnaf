// Дело Catala «CasTest1» (logement-foyer, APL): пара без иждивенцев, зона III,
// плата 360 €, ресурсы 15 000 €, месяц права — апрель 2022 года.
//
// ШАГ: плафон эквивалентности найма и расходов E (ст. 27 арретэ, редакция
// 1 октября 2021 года). Catala утверждает то же число: 450,57 €.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-foyer-apl-01-plafond" {
    given {
        context { decision_time @2022-04-23T12:00:00Z; knowledge_time @2022-04-23T12:00:00Z; legal_time @2022-04-23; timezone "Europe/Paris"; }
        assert "foyer-apl-01-plafond-01": secteur_logement_foyer(entity_ref("urn:fr:apl:case:foyer-apl-01")) { origin case_input; }
        assert "foyer-apl-01-plafond-02": aide_demandee(entity_ref("urn:fr:apl:case:foyer-apl-01"), APL) { origin case_input; }
        assert "foyer-apl-01-plafond-03": zone_du_logement(entity_ref("urn:fr:apl:case:foyer-apl-01"), ZONE_III) { origin case_input; }
        assert "foyer-apl-01-plafond-04": situation_familiale(entity_ref("urn:fr:apl:case:foyer-apl-01"), COUPLE) { origin case_input; }
        assert "foyer-apl-01-plafond-05": personnes_a_charge(entity_ref("urn:fr:apl:case:foyer-apl-01"), 0) { origin case_input; }
        assert "foyer-apl-01-plafond-06": type_logement_foyer(entity_ref("urn:fr:apl:case:foyer-apl-01"), GENERAL) { origin case_input; }
        assert "foyer-apl-01-plafond-07": redevance(entity_ref("urn:fr:apl:case:foyer-apl-01"), 360 EUR) { origin case_input; }
        assert "foyer-apl-01-plafond-08": ressources_du_menage(entity_ref("urn:fr:apl:case:foyer-apl-01"), 15000 EUR) { origin case_input; }
        assert "foyer-apl-01-plafond-09": territoire(entity_ref("urn:fr:apl:case:foyer-apl-01"), METROPOLE) { origin case_input; }
    }
    evaluate truth(plafond_equivalence_loyer(entity_ref("urn:fr:apl:case:foyer-apl-01"), 450.57 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
