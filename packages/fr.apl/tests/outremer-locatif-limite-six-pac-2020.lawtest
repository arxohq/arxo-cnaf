// Предел шести иждивенцев в ПЕРВОМ закреплённом состоянии изъятий — с 1 октября
// 2020 года: 36,25 € + 9,32 € × 6 = 92,17 € вместо × 8 = 110,81 €.
//
// ПОЧЕМУ ЭТОТ СЦЕНАРИЙ ЕСТЬ. Канарейка 14.09.2026 показала, что сдвиг предела в
// состоянии 2020 года не ронял НИЧЕГО: восемь иждивенцев проверялись только на
// месяцах права 2021 и 2024 годов, и строка 2020 года оставалась без свидетеля.
// Строка значений без сценария — не закреплённая норма, а надежда.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-outremer-locatif-limite-six-pac-2020" {
    given {
        context { decision_time @2020-11-15T12:00:00Z; knowledge_time @2020-11-15T12:00:00Z; legal_time @2020-11-15; timezone "Europe/Paris"; }
        assert "outremer-locatif-limite-six-pac-2020-01": secteur_locatif(entity_ref("urn:fr:apl:case:om-loc-8pac-2020")) { origin case_input; }
        assert "outremer-locatif-limite-six-pac-2020-02": aide_demandee(entity_ref("urn:fr:apl:case:om-loc-8pac-2020"), APL) { origin case_input; }
        assert "outremer-locatif-limite-six-pac-2020-03": zone_du_logement(entity_ref("urn:fr:apl:case:om-loc-8pac-2020"), ZONE_II) { origin case_input; }
        assert "outremer-locatif-limite-six-pac-2020-04": situation_familiale(entity_ref("urn:fr:apl:case:om-loc-8pac-2020"), COUPLE) { origin case_input; }
        assert "outremer-locatif-limite-six-pac-2020-05": personnes_a_charge(entity_ref("urn:fr:apl:case:om-loc-8pac-2020"), 8) { origin case_input; }
        assert "outremer-locatif-limite-six-pac-2020-06": mode_location(entity_ref("urn:fr:apl:case:om-loc-8pac-2020"), LOCATION_SEULE) { origin case_input; }
        assert "outremer-locatif-limite-six-pac-2020-07": territoire(entity_ref("urn:fr:apl:case:om-loc-8pac-2020"), OUTRE_MER) { origin case_input; }
    }
    evaluate truth(forfait_charges(entity_ref("urn:fr:apl:case:om-loc-8pac-2020"), 92.17 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
