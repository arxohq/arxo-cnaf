// Дело Catala «CasTest1» (logement-foyer, APL).
//
// ШАГ: минимальная эквивалентность E0 (D. 832-26 абз. 1 + ст. 31 арретэ):
// прогрессивные транши ресурсов с границами, умноженными на число долей
// N = 1,8, плюс форфейт 45,57 € × N, всё делённое на двенадцать.
//
// Catala утверждает 318,13 €; наш точный итог — 318,12546 €. Текст округления
// E0 не велит, поэтому их число есть наш итог, округлённый до цента, а не наш
// итог. Класс (б) с той же оговоркой, что у locatif.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-foyer-apl-01-equivalence-minimale" {
    given {
        context { decision_time @2022-04-23T12:00:00Z; knowledge_time @2022-04-23T12:00:00Z; legal_time @2022-04-23; timezone "Europe/Paris"; }
        assert "foyer-apl-01-equivalence-minimale-01": secteur_logement_foyer(entity_ref("urn:fr:apl:case:foyer-apl-01")) { origin case_input; }
        assert "foyer-apl-01-equivalence-minimale-02": aide_demandee(entity_ref("urn:fr:apl:case:foyer-apl-01"), APL) { origin case_input; }
        assert "foyer-apl-01-equivalence-minimale-03": zone_du_logement(entity_ref("urn:fr:apl:case:foyer-apl-01"), ZONE_III) { origin case_input; }
        assert "foyer-apl-01-equivalence-minimale-04": situation_familiale(entity_ref("urn:fr:apl:case:foyer-apl-01"), COUPLE) { origin case_input; }
        assert "foyer-apl-01-equivalence-minimale-05": personnes_a_charge(entity_ref("urn:fr:apl:case:foyer-apl-01"), 0) { origin case_input; }
        assert "foyer-apl-01-equivalence-minimale-06": type_logement_foyer(entity_ref("urn:fr:apl:case:foyer-apl-01"), GENERAL) { origin case_input; }
        assert "foyer-apl-01-equivalence-minimale-07": redevance(entity_ref("urn:fr:apl:case:foyer-apl-01"), 360 EUR) { origin case_input; }
        assert "foyer-apl-01-equivalence-minimale-08": ressources_du_menage(entity_ref("urn:fr:apl:case:foyer-apl-01"), 15000 EUR) { origin case_input; }
        assert "foyer-apl-01-equivalence-minimale-09": territoire(entity_ref("urn:fr:apl:case:foyer-apl-01"), METROPOLE) { origin case_input; }
    }
    evaluate truth(equivalence_loyer_minimale(entity_ref("urn:fr:apl:case:foyer-apl-01"), 318.12546 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
