// Тот же случай, стадия CRDS: сумма после шага взносов минус 0,5 % (не округляется).
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-foyer-al-03-aide-nette-crds" {
    given {
        context { decision_time @2023-03-15T12:00:00Z; knowledge_time @2023-03-15T12:00:00Z; legal_time @2023-03-15; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "foyer-al-03-aide-nette-crds-01": secteur_logement_foyer(entity_ref("urn:fr:apl:case:foyer-al-03")) { origin case_input; }
        assert "foyer-al-03-aide-nette-crds-02": aide_demandee(entity_ref("urn:fr:apl:case:foyer-al-03"), ALF) { origin case_input; }
        assert "foyer-al-03-aide-nette-crds-03": zone_du_logement(entity_ref("urn:fr:apl:case:foyer-al-03"), ZONE_III) { origin case_input; }
        assert "foyer-al-03-aide-nette-crds-04": situation_familiale(entity_ref("urn:fr:apl:case:foyer-al-03"), COUPLE) { origin case_input; }
        assert "foyer-al-03-aide-nette-crds-05": personnes_a_charge(entity_ref("urn:fr:apl:case:foyer-al-03"), 0) { origin case_input; }
        assert "foyer-al-03-aide-nette-crds-06": categorie_equivalence_loyer(entity_ref("urn:fr:apl:case:foyer-al-03"), PERSONNES_AGEES) { origin case_input; }
        assert "foyer-al-03-aide-nette-crds-07": redevance(entity_ref("urn:fr:apl:case:foyer-al-03"), 360 EUR) { origin case_input; }
        assert "foyer-al-03-aide-nette-crds-08": ressources_du_menage(entity_ref("urn:fr:apl:case:foyer-al-03"), 15000 EUR) { origin case_input; }
        assert "foyer-al-03-aide-nette-crds-09": territoire(entity_ref("urn:fr:apl:case:foyer-al-03"), METROPOLE) { origin case_input; }
    }
    evaluate truth(aide_nette_precompte_crds(entity_ref("urn:fr:apl:case:foyer-al-03"), 29.0015094520975 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
