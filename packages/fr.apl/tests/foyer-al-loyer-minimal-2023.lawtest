// ДВЕ ЭПОХИ ВТОРОГО АБЗАЦА D. 832-26 — свидетель ПОЗДНЕЙ эпохи. Одинокий без
// иждивенцев, 7 500 € ресурсов, résidence sociale, месяц права январь 2023 года:
// вторая таблица ст. 31 (0 %, 2,40 %, 20,80 %, 23,20 %, 32,80 %; границы × N = 1,2)
// + форфейт 76,32 €, всё / 12 = 124,644584 €. Тот же вход в мае 2022 года даёт по
// первой таблице 115,18728 € — это дело Catala CasTest5/CasTest1 (класс (б)).
//
// КАНАРЕЙКА 14.09.2026: раскрытие окна `effective` у правила «до июля 2022» до
// бесконечности роняет ровно этот сценарий (KEY_CONFLICT двух эпох), а без него
// мутация проходила незамеченной — окно было засвидетельствовано только
// дефектом, не нормой.
//
// ШАГ (глава VII, D. 842-15 5°): L0 аллокации = E0 второго абзаца.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-foyer-al-loyer-minimal-2023" {
    given {
        context { decision_time @2023-01-15T12:00:00Z; knowledge_time @2023-01-15T12:00:00Z; legal_time @2023-01-15; timezone "Europe/Paris"; }
        assert "foyer-al-loyer-minimal-2023-01": secteur_logement_foyer(entity_ref("urn:fr:apl:case:foyer-al-2023")) { origin case_input; }
        assert "foyer-al-loyer-minimal-2023-02": aide_demandee(entity_ref("urn:fr:apl:case:foyer-al-2023"), ALF) { origin case_input; }
        assert "foyer-al-loyer-minimal-2023-03": zone_du_logement(entity_ref("urn:fr:apl:case:foyer-al-2023"), ZONE_I) { origin case_input; }
        assert "foyer-al-loyer-minimal-2023-04": situation_familiale(entity_ref("urn:fr:apl:case:foyer-al-2023"), PERSONNE_SEULE) { origin case_input; }
        assert "foyer-al-loyer-minimal-2023-05": personnes_a_charge(entity_ref("urn:fr:apl:case:foyer-al-2023"), 0) { origin case_input; }
        assert "foyer-al-loyer-minimal-2023-06": categorie_equivalence_loyer(entity_ref("urn:fr:apl:case:foyer-al-2023"), PERSONNES_AGEES) { origin case_input; }
        assert "foyer-al-loyer-minimal-2023-07": redevance(entity_ref("urn:fr:apl:case:foyer-al-2023"), 350 EUR) { origin case_input; }
        assert "foyer-al-loyer-minimal-2023-08": ressources_du_menage(entity_ref("urn:fr:apl:case:foyer-al-2023"), 7500 EUR) { origin case_input; }
        assert "foyer-al-loyer-minimal-2023-09": territoire(entity_ref("urn:fr:apl:case:foyer-al-2023"), METROPOLE) { origin case_input; }
    }
    evaluate truth(loyer_minimal(entity_ref("urn:fr:apl:case:foyer-al-2023"), 124.644584 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
