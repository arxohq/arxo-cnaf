// Месяц права — ноябрь 2025 года: редакция, применимая «aux prestations dues à
// compter du 1er octobre 2025». Её версии статей пришли ИНКРЕМЕНТОМ DILA
// LEGI_20250911-214911 — в глобальный дамп они попасть не могли, он снят
// 13 июля 2025 года.
//
// ШАГ (глава IV, APL сектора приобретения): форфейт расходов ст. 19 —
// 60,59 € + 13,74 € = 74,33 €.
//
// ПОПУТНО ЗАКРЫТ РАЗРЫВ: ст. 19 и 24 были закреплены лишь редакциями 2020, 2021
// и октября 2025 годов, и у их параметров зияла дыра с июля 2022 по октябрь 2025
// года — дело сектора приобретения в эти месяцы отвечало бы
// MISSING_PARAMETER_VALUE. Промежуточные версии закреплены тем же изменением.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-accession-forfait-charges-2025-10" {
    given {
        context { decision_time @2025-11-15T12:00:00Z; knowledge_time @2025-11-15T12:00:00Z; legal_time @2025-11-15; timezone "Europe/Paris"; }
        assert "accession-forfait-charges-2025-10-01": secteur_accession(entity_ref("urn:fr:apl:case:acc-apl-2025-10")) { origin case_input; }
        assert "accession-forfait-charges-2025-10-02": aide_demandee(entity_ref("urn:fr:apl:case:acc-apl-2025-10"), APL) { origin case_input; }
        assert "accession-forfait-charges-2025-10-03": zone_du_logement(entity_ref("urn:fr:apl:case:acc-apl-2025-10"), ZONE_II) { origin case_input; }
        assert "accession-forfait-charges-2025-10-04": situation_familiale(entity_ref("urn:fr:apl:case:acc-apl-2025-10"), COUPLE) { origin case_input; }
        assert "accession-forfait-charges-2025-10-05": personnes_a_charge(entity_ref("urn:fr:apl:case:acc-apl-2025-10"), 1) { origin case_input; }
        assert "accession-forfait-charges-2025-10-06": sous_cas_mensualite(entity_ref("urn:fr:apl:case:acc-apl-2025-10"), PRET_APRES_30_09_2019) { origin case_input; }
        assert "accession-forfait-charges-2025-10-07": finalite_operation(entity_ref("urn:fr:apl:case:acc-apl-2025-10"), LOGEMENT_NEUF) { origin case_input; }
        assert "accession-forfait-charges-2025-10-08": type_travaux(entity_ref("urn:fr:apl:case:acc-apl-2025-10"), PAS_DE_TRAVAUX) { origin case_input; }
        assert "accession-forfait-charges-2025-10-09": mode_propriete(entity_ref("urn:fr:apl:case:acc-apl-2025-10"), PROPRIETAIRE_UNIQUE) { origin case_input; }
        assert "accession-forfait-charges-2025-10-10": mensualite_declaree(entity_ref("urn:fr:apl:case:acc-apl-2025-10"), 500 EUR) { origin case_input; }
        assert "accession-forfait-charges-2025-10-11": vintage_pret_depense_nette(entity_ref("urn:fr:apl:case:acc-apl-2025-10"), PRET_DEPUIS_OCTOBRE_1998) { origin case_input; }
        assert "accession-forfait-charges-2025-10-12": situation_r822_11_13_17(entity_ref("urn:fr:apl:case:acc-apl-2025-10"), false) { origin case_input; }
        assert "accession-forfait-charges-2025-10-13": territoire(entity_ref("urn:fr:apl:case:acc-apl-2025-10"), METROPOLE) { origin case_input; }
    }
    evaluate truth(forfait_charges_accession(entity_ref("urn:fr:apl:case:acc-apl-2025-10"), 74.33 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
