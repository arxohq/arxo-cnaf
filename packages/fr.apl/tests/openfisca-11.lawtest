// Cas 11: одинокое лицо, зона II, конвенционное жильё, RLS 40,51 €
// 
// ИСТОЧНИК ОЖИДАНИЯ: OpenFisca-France, openfisca/openfisca-france@b2ab9943, tests/formulas/aides_logement_reforme_janvier_2021.yaml.
// ИХ ЧИСЛА ДВА, и они разные: в файле — 134.51 €, а их КОД на
// закреплённом коммите даёт 134.50 € (замер 13.09.2026, openfisca-france
// 176.0.9; допуск их теста relative_error_margin 0,01 расхождение файла с
// собственным кодом скрывает). Сверяться с кодом: tools/compare_openfisca.py.
// ПРИЧИНА РАСХОЖДЕНИЯ С НАМИ: шаг CRDS и порядок вычета RLS (README, «Квалификация расхождений»).
// НАШ ТОЧНЫЙ ИТОГ: 135.174594 € (округлений сверх трёх предписанных текстом
// пакет не делает — см. шапку 02-calcul-locatif.law).
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-openfisca-11" {
    given {
        context { decision_time @2021-01-15T12:00:00Z; knowledge_time @2021-01-15T12:00:00Z; legal_time @2021-01-15; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "openfisca-11-01": secteur_locatif(entity_ref("urn:fr:apl:case:openfisca-11")) { origin case_input; }
        assert "openfisca-11-02": zone_du_logement(entity_ref("urn:fr:apl:case:openfisca-11"), ZONE_II) { origin case_input; }
        assert "openfisca-11-03": aide_demandee(entity_ref("urn:fr:apl:case:openfisca-11"), APL) { origin case_input; }
        assert "openfisca-11-04": situation_familiale(entity_ref("urn:fr:apl:case:openfisca-11"), PERSONNE_SEULE) { origin case_input; }
        assert "openfisca-11-05": personnes_a_charge(entity_ref("urn:fr:apl:case:openfisca-11"), 0) { origin case_input; }
        assert "openfisca-11-06": loyer_principal(entity_ref("urn:fr:apl:case:openfisca-11"), 500 EUR) { origin case_input; }
        assert "openfisca-11-07": ressources_du_menage(entity_ref("urn:fr:apl:case:openfisca-11"), 7700 EUR) { origin case_input; }
        assert "openfisca-11-08": mode_location(entity_ref("urn:fr:apl:case:openfisca-11"), LOCATION_SEULE) { origin case_input; }
        assert "openfisca-11-09": forme_logement(entity_ref("urn:fr:apl:case:openfisca-11"), LOGEMENT_ORDINAIRE) { origin case_input; }
        assert "openfisca-11-10": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:openfisca-11"), 40.51 EUR) { origin case_input; }
        assert "openfisca-11-11": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:openfisca-11"), false) { origin case_input; }
        assert "openfisca-11-12": territoire(entity_ref("urn:fr:apl:case:openfisca-11"), METROPOLE) { origin case_input; }
    }
    evaluate truth(aide_mensuelle(entity_ref("urn:fr:apl:case:openfisca-11"), 135.174594 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
