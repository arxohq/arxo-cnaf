// СВОЙ сценарий, выведенный из закреплённого текста главы VI: дела Catala этого
// сектора заданы для заморских территорий, и их числа проверяются отдельными
// сценариями `*-guadeloupe-*` и `*-saint-pierre-*`.
//
// ИСПОЛНИМАЯ ГРАНИЦА. Трое сособственников: 500 € / 3 = 166,666… € —
// непредставимо. D. 842-10 1° делить велит и округления не называет, поэтому §58
// отказывает вместо молчаливого округления.//
// ПОЧЕМУ В ЭТОМ ДЕЛЕ НЕТ ФАКТА РЕСУРСОВ. Этому шагу они не нужны, и поданы
// намеренно не были: с ними дело считает ещё и L0, а его отказ (непредставимое
// частное либо отсутствие транш второго абзаца до 1 июля 2022 года) поражает ВЕСЬ
// evaluation-документ. Измерено 14.09.2026: с фактом ресурсов сценарий краснеет
// не потому, что его шаг неверен, а потому, что документ целиком неисполним.
// L0 закреплён своими сценариями.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-frontiere-al-accession-copropriete-quotient-inexact" {
    given {
        context { decision_time @2022-05-01T12:00:00Z; knowledge_time @2022-05-01T12:00:00Z; legal_time @2022-05-01; timezone "Europe/Paris"; }
        assert "frontiere-al-accession-copropriete-quotient-inexact-01": secteur_accession_allocations(entity_ref("urn:fr:apl:case:al-accession-g")) { origin case_input; }
        assert "frontiere-al-accession-copropriete-quotient-inexact-02": aide_demandee(entity_ref("urn:fr:apl:case:al-accession-g"), ALF) { origin case_input; }
        assert "frontiere-al-accession-copropriete-quotient-inexact-03": zone_du_logement(entity_ref("urn:fr:apl:case:al-accession-g"), ZONE_II) { origin case_input; }
        assert "frontiere-al-accession-copropriete-quotient-inexact-04": situation_familiale(entity_ref("urn:fr:apl:case:al-accession-g"), COUPLE) { origin case_input; }
        assert "frontiere-al-accession-copropriete-quotient-inexact-05": personnes_a_charge(entity_ref("urn:fr:apl:case:al-accession-g"), 2) { origin case_input; }
        assert "frontiere-al-accession-copropriete-quotient-inexact-06": vintage_certificat(entity_ref("urn:fr:apl:case:al-accession-g"), CERTIFICAT_DEPUIS_01_10_2019) { origin case_input; }
        assert "frontiere-al-accession-copropriete-quotient-inexact-07": mode_propriete(entity_ref("urn:fr:apl:case:al-accession-g"), COPROPRIETAIRE) { origin case_input; }
        assert "frontiere-al-accession-copropriete-quotient-inexact-08": territoire(entity_ref("urn:fr:apl:case:al-accession-g"), METROPOLE) { origin case_input; }
        assert "frontiere-al-accession-copropriete-quotient-inexact-09": nombre_coproprietaires(entity_ref("urn:fr:apl:case:al-accession-g"), 3.0) { origin case_input; }
        assert "frontiere-al-accession-copropriete-quotient-inexact-10": mensualite_declaree(entity_ref("urn:fr:apl:case:al-accession-g"), 500 EUR) { origin case_input; }
        assert "frontiere-al-accession-copropriete-quotient-inexact-11": base_plancher_ressources(entity_ref("urn:fr:apl:case:al-accession-g"), COEFFICIENT_MENSUALITE) { origin case_input; }
        assert "frontiere-al-accession-copropriete-quotient-inexact-12": situation_r822_11_13_17(entity_ref("urn:fr:apl:case:al-accession-g"), false) { origin case_input; }
    }
    evaluate truth(mensualite_eligible_al(entity_ref("urn:fr:apl:case:al-accession-g"), 166.67 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
}
