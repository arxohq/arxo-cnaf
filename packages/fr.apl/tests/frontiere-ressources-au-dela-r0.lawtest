// ГРАНИЦА R0, верхняя половина пары: ресурсы 4 683 € — ровно форфейт R0, —
// но округление ВВЕРХ до сотни даёт R = 4 700 €, и разница 17 € уже
// участвует в формуле: Pp = 35,39 € + 17 € × Tp = 35,93995 €. Пара
// показывает, что округление ресурсов предписано текстом и наблюдаемо.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-frontiere-ressources-au-dela-r0" {
    given {
        context { decision_time @2022-02-15T12:00:00Z; knowledge_time @2022-02-15T12:00:00Z; legal_time @2022-02-15; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "frontiere-ressources-au-dela-r0-01": secteur_locatif(entity_ref("urn:fr:apl:case:frontiere-ressources-au-dela-r0")) { origin case_input; }
        assert "frontiere-ressources-au-dela-r0-02": zone_du_logement(entity_ref("urn:fr:apl:case:frontiere-ressources-au-dela-r0"), ZONE_I) { origin case_input; }
        assert "frontiere-ressources-au-dela-r0-03": aide_demandee(entity_ref("urn:fr:apl:case:frontiere-ressources-au-dela-r0"), APL) { origin case_input; }
        assert "frontiere-ressources-au-dela-r0-04": situation_familiale(entity_ref("urn:fr:apl:case:frontiere-ressources-au-dela-r0"), PERSONNE_SEULE) { origin case_input; }
        assert "frontiere-ressources-au-dela-r0-05": personnes_a_charge(entity_ref("urn:fr:apl:case:frontiere-ressources-au-dela-r0"), 0) { origin case_input; }
        assert "frontiere-ressources-au-dela-r0-06": loyer_principal(entity_ref("urn:fr:apl:case:frontiere-ressources-au-dela-r0"), 400 EUR) { origin case_input; }
        assert "frontiere-ressources-au-dela-r0-07": ressources_du_menage(entity_ref("urn:fr:apl:case:frontiere-ressources-au-dela-r0"), 4683 EUR) { origin case_input; }
        assert "frontiere-ressources-au-dela-r0-08": mode_location(entity_ref("urn:fr:apl:case:frontiere-ressources-au-dela-r0"), LOCATION_SEULE) { origin case_input; }
        assert "frontiere-ressources-au-dela-r0-09": forme_logement(entity_ref("urn:fr:apl:case:frontiere-ressources-au-dela-r0"), LOGEMENT_ORDINAIRE) { origin case_input; }
        assert "frontiere-ressources-au-dela-r0-10": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:frontiere-ressources-au-dela-r0"), 0 EUR) { origin case_input; }
        assert "frontiere-ressources-au-dela-r0-11": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:frontiere-ressources-au-dela-r0"), false) { origin case_input; }
        assert "frontiere-ressources-au-dela-r0-12": territoire(entity_ref("urn:fr:apl:case:frontiere-ressources-au-dela-r0"), METROPOLE) { origin case_input; }
    }
    evaluate truth(participation_personnelle(entity_ref("urn:fr:apl:case:frontiere-ressources-au-dela-r0"), 35.93995 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
