// БАРЕМ С 1 ОКТЯБРЯ 2026 ГОДА, половина пары: те же входы, что у
// catala-09.lawtest (одинокое лицо, зона I, наём 400 €, ресурсы 7 800 €),
// но месяц права — ноябрь 2026 года. Значения новые: плафон 336,97 €
// вместо 333,14 €, форфейт расходов 61,29 € вместо 60,59 €, пол участия
// 40,01 € вместо 39,56 €, форфейт R0 5 235 € — тот же (на 2026 год R0 не
// переоценён, декрет 2025-1401). Точный итог —
// 269,35136125 € против 265,33096125 € по редакции 2025 года.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-frontiere-bareme-2026-octobre" {
    given {
        context { decision_time @2026-11-15T12:00:00Z; knowledge_time @2026-11-15T12:00:00Z; legal_time @2026-11-15; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "frontiere-bareme-2026-octobre-01": secteur_locatif(entity_ref("urn:fr:apl:case:frontiere-bareme-2026-octobre")) { origin case_input; }
        assert "frontiere-bareme-2026-octobre-02": zone_du_logement(entity_ref("urn:fr:apl:case:frontiere-bareme-2026-octobre"), ZONE_I) { origin case_input; }
        assert "frontiere-bareme-2026-octobre-03": aide_demandee(entity_ref("urn:fr:apl:case:frontiere-bareme-2026-octobre"), APL) { origin case_input; }
        assert "frontiere-bareme-2026-octobre-04": situation_familiale(entity_ref("urn:fr:apl:case:frontiere-bareme-2026-octobre"), PERSONNE_SEULE) { origin case_input; }
        assert "frontiere-bareme-2026-octobre-05": personnes_a_charge(entity_ref("urn:fr:apl:case:frontiere-bareme-2026-octobre"), 0) { origin case_input; }
        assert "frontiere-bareme-2026-octobre-06": loyer_principal(entity_ref("urn:fr:apl:case:frontiere-bareme-2026-octobre"), 400 EUR) { origin case_input; }
        assert "frontiere-bareme-2026-octobre-07": ressources_du_menage(entity_ref("urn:fr:apl:case:frontiere-bareme-2026-octobre"), 7800 EUR) { origin case_input; }
        assert "frontiere-bareme-2026-octobre-08": mode_location(entity_ref("urn:fr:apl:case:frontiere-bareme-2026-octobre"), LOCATION_SEULE) { origin case_input; }
        assert "frontiere-bareme-2026-octobre-09": forme_logement(entity_ref("urn:fr:apl:case:frontiere-bareme-2026-octobre"), LOGEMENT_ORDINAIRE) { origin case_input; }
        assert "frontiere-bareme-2026-octobre-10": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:frontiere-bareme-2026-octobre"), 0 EUR) { origin case_input; }
        assert "frontiere-bareme-2026-octobre-11": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:frontiere-bareme-2026-octobre"), false) { origin case_input; }
        assert "frontiere-bareme-2026-octobre-12": territoire(entity_ref("urn:fr:apl:case:frontiere-bareme-2026-octobre"), METROPOLE) { origin case_input; }
    }
    evaluate truth(aide_mensuelle(entity_ref("urn:fr:apl:case:frontiere-bareme-2026-octobre"), 269.35136125 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
