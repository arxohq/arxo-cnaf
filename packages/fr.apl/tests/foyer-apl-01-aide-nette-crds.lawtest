// Дело Catala «CasTest1» (logement-foyer, APL), стадия CRDS.
//
// Сумма после шага взносов 12,060842807 € минус 0,5 % (ст. 14 III и 19 ордонанса
// № 96-50): сумма к перечислению. Удержание НЕ округляется — округления в закреплённом
// тексте нет (26-precompte-crds.law, README «Округление удерживаемой CRDS»).
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-foyer-apl-01-aide-nette-crds" {
    given {
        context { decision_time @2022-04-23T12:00:00Z; knowledge_time @2022-04-23T12:00:00Z; legal_time @2022-04-23; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "foyer-apl-01-aide-nette-crds-01": secteur_logement_foyer(entity_ref("urn:fr:apl:case:foyer-apl-01")) { origin case_input; }
        assert "foyer-apl-01-aide-nette-crds-02": aide_demandee(entity_ref("urn:fr:apl:case:foyer-apl-01"), APL) { origin case_input; }
        assert "foyer-apl-01-aide-nette-crds-03": zone_du_logement(entity_ref("urn:fr:apl:case:foyer-apl-01"), ZONE_III) { origin case_input; }
        assert "foyer-apl-01-aide-nette-crds-04": situation_familiale(entity_ref("urn:fr:apl:case:foyer-apl-01"), COUPLE) { origin case_input; }
        assert "foyer-apl-01-aide-nette-crds-05": personnes_a_charge(entity_ref("urn:fr:apl:case:foyer-apl-01"), 0) { origin case_input; }
        assert "foyer-apl-01-aide-nette-crds-06": type_logement_foyer(entity_ref("urn:fr:apl:case:foyer-apl-01"), GENERAL) { origin case_input; }
        assert "foyer-apl-01-aide-nette-crds-07": redevance(entity_ref("urn:fr:apl:case:foyer-apl-01"), 360 EUR) { origin case_input; }
        assert "foyer-apl-01-aide-nette-crds-08": ressources_du_menage(entity_ref("urn:fr:apl:case:foyer-apl-01"), 15000 EUR) { origin case_input; }
        assert "foyer-apl-01-aide-nette-crds-09": territoire(entity_ref("urn:fr:apl:case:foyer-apl-01"), METROPOLE) { origin case_input; }
    }
    evaluate truth(aide_nette_precompte_crds(entity_ref("urn:fr:apl:case:foyer-apl-01"), 12.000538592965 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
