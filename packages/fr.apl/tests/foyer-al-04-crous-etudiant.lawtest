// Комната CROUS (3° D. 823-9 → D. 842-15), студент, ALS: одиночка, зона II, redevance
// 400 €, ресурсы 4 900 €, 15.02.2021 (по образцу дела OpenFisca «Cas 1, étudiant boursier
// en logement CROUS»). Категория 1° D. 842-16: L = 83,79 €.
//
// K = 0,90 − 4 900/(21 420,91·1,2) = 0,7094… → 0,70. C = 53,99, L0 (до 01.07.2022,
// единая таблица ст. 31) = 52,988944. Af = 59,3537392 → −5 → 54,3537392 €;
// чистый расход 83,4262608 € выше 15 €. Итог после взносов 54,271768696 €.
// K читается из R. 351-61 (общий случай) и R. 351-61-1 (фойе молодых работников и
// социальные резиденции) — алгебра D. 832-25 в закреплённых данных картинка, см.
// блок «КОЭФФИЦИЕНТ K» в 04-calcul-foyer.law и README, «Коэффициент K».
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-foyer-al-04-crous-etudiant" {
    given {
        context { decision_time @2021-02-15T12:00:00Z; knowledge_time @2021-02-15T12:00:00Z; legal_time @2021-02-15; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "foyer-al-04-crous-etudiant-01": secteur_logement_foyer(entity_ref("urn:fr:apl:case:foyer-al-04")) { origin case_input; }
        assert "foyer-al-04-crous-etudiant-02": aide_demandee(entity_ref("urn:fr:apl:case:foyer-al-04"), ALS) { origin case_input; }
        assert "foyer-al-04-crous-etudiant-03": zone_du_logement(entity_ref("urn:fr:apl:case:foyer-al-04"), ZONE_II) { origin case_input; }
        assert "foyer-al-04-crous-etudiant-04": situation_familiale(entity_ref("urn:fr:apl:case:foyer-al-04"), PERSONNE_SEULE) { origin case_input; }
        assert "foyer-al-04-crous-etudiant-05": personnes_a_charge(entity_ref("urn:fr:apl:case:foyer-al-04"), 0) { origin case_input; }
        assert "foyer-al-04-crous-etudiant-06": categorie_equivalence_loyer(entity_ref("urn:fr:apl:case:foyer-al-04"), ETUDIANT_CHAMBRE) { origin case_input; }
        assert "foyer-al-04-crous-etudiant-07": redevance(entity_ref("urn:fr:apl:case:foyer-al-04"), 400 EUR) { origin case_input; }
        assert "foyer-al-04-crous-etudiant-08": ressources_du_menage(entity_ref("urn:fr:apl:case:foyer-al-04"), 4900 EUR) { origin case_input; }
        assert "foyer-al-04-crous-etudiant-09": territoire(entity_ref("urn:fr:apl:case:foyer-al-04"), METROPOLE) { origin case_input; }
    }
    evaluate truth(aide_mensuelle(entity_ref("urn:fr:apl:case:foyer-al-04"), 54.271768696 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
