// Exemple7: пара с шестью иждивенцами, зона II, наём 527 €, ресурсы 32 200 €
// 
// ИСТОЧНИК ОЖИДАНИЯ: Catala, CatalaLang/catala-examples@ebe5e7c2, aides_logement/tests/; их значение — 153.77 €.
// НАШ ТОЧНЫЙ ИТОГ: 153.76931525 € (округлений сверх трёх предписанных текстом
// пакет не делает — см. шапку 02-calcul-locatif.law).
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-catala-07" {
    given {
        context { decision_time @2022-02-13T12:00:00Z; knowledge_time @2022-02-13T12:00:00Z; legal_time @2022-02-13; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "catala-07-01": secteur_locatif(entity_ref("urn:fr:apl:case:catala-07")) { origin case_input; }
        assert "catala-07-02": zone_du_logement(entity_ref("urn:fr:apl:case:catala-07"), ZONE_II) { origin case_input; }
        assert "catala-07-03": aide_demandee(entity_ref("urn:fr:apl:case:catala-07"), APL) { origin case_input; }
        assert "catala-07-04": situation_familiale(entity_ref("urn:fr:apl:case:catala-07"), COUPLE) { origin case_input; }
        assert "catala-07-05": personnes_a_charge(entity_ref("urn:fr:apl:case:catala-07"), 6) { origin case_input; }
        assert "catala-07-06": loyer_principal(entity_ref("urn:fr:apl:case:catala-07"), 527 EUR) { origin case_input; }
        assert "catala-07-07": ressources_du_menage(entity_ref("urn:fr:apl:case:catala-07"), 32200 EUR) { origin case_input; }
        assert "catala-07-08": mode_location(entity_ref("urn:fr:apl:case:catala-07"), LOCATION_SEULE) { origin case_input; }
        assert "catala-07-09": forme_logement(entity_ref("urn:fr:apl:case:catala-07"), LOGEMENT_ORDINAIRE) { origin case_input; }
        assert "catala-07-10": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:catala-07"), 0 EUR) { origin case_input; }
        assert "catala-07-11": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:catala-07"), false) { origin case_input; }
        assert "catala-07-12": territoire(entity_ref("urn:fr:apl:case:catala-07"), METROPOLE) { origin case_input; }
    }
    evaluate truth(aide_mensuelle(entity_ref("urn:fr:apl:case:catala-07"), 153.76931525 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
