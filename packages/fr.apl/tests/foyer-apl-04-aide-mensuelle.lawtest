// Дело Catala «CasTest4» (logement-foyer, APL; передано DGALN/DHUP/FE4 14.07.2022):
// те же факты, что у «CasTest3», но месяц права 01.05.2022 — другая редакция
// барема (плафон E 446,30 €), та же ожидаемая сумма: Catala утверждает 154,78 €.
// K читается из R. 351-61 (общий случай) и R. 351-61-1 (фойе молодых работников и
// социальные резиденции) — алгебра D. 832-25 в закреплённых данных картинка, см.
// блок «КОЭФФИЦИЕНТ K» в 04-calcul-foyer.law и README, «Коэффициент K».
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-foyer-apl-04-aide-mensuelle" {
    given {
        context { decision_time @2022-05-01T12:00:00Z; knowledge_time @2022-05-01T12:00:00Z; legal_time @2022-05-01; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "foyer-apl-04-aide-mensuelle-01": secteur_logement_foyer(entity_ref("urn:fr:apl:case:foyer-apl-04")) { origin case_input; }
        assert "foyer-apl-04-aide-mensuelle-02": aide_demandee(entity_ref("urn:fr:apl:case:foyer-apl-04"), APL) { origin case_input; }
        assert "foyer-apl-04-aide-mensuelle-03": zone_du_logement(entity_ref("urn:fr:apl:case:foyer-apl-04"), ZONE_I) { origin case_input; }
        assert "foyer-apl-04-aide-mensuelle-04": situation_familiale(entity_ref("urn:fr:apl:case:foyer-apl-04"), PERSONNE_SEULE) { origin case_input; }
        assert "foyer-apl-04-aide-mensuelle-05": personnes_a_charge(entity_ref("urn:fr:apl:case:foyer-apl-04"), 0) { origin case_input; }
        assert "foyer-apl-04-aide-mensuelle-06": type_logement_foyer(entity_ref("urn:fr:apl:case:foyer-apl-04"), GENERAL) { origin case_input; }
        assert "foyer-apl-04-aide-mensuelle-07": redevance(entity_ref("urn:fr:apl:case:foyer-apl-04"), 350 EUR) { origin case_input; }
        assert "foyer-apl-04-aide-mensuelle-08": ressources_du_menage(entity_ref("urn:fr:apl:case:foyer-apl-04"), 7500 EUR) { origin case_input; }
        assert "foyer-apl-04-aide-mensuelle-09": territoire(entity_ref("urn:fr:apl:case:foyer-apl-04"), METROPOLE) { origin case_input; }
    }
    evaluate truth(aide_mensuelle(entity_ref("urn:fr:apl:case:foyer-apl-04"), 154.7783591424 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
