// tests_calcul_al_locatif Exemple2: та же пара с двумя иждивенцами, но аллокация (ALF), май 2022 года
// 
// ИСТОЧНИК ОЖИДАНИЯ: Catala, CatalaLang/catala-examples@ebe5e7c2, aides_logement/tests/; их значение — 352.77 €.
// НАШ ТОЧНЫЙ ИТОГ: 352.7652695 € (округлений сверх трёх предписанных текстом
// пакет не делает — см. шапку 02-calcul-locatif.law).
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-catala-al-02" {
    given {
        context { decision_time @2022-05-01T12:00:00Z; knowledge_time @2022-05-01T12:00:00Z; legal_time @2022-05-01; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "catala-al-02-01": secteur_locatif(entity_ref("urn:fr:apl:case:catala-al-02")) { origin case_input; }
        assert "catala-al-02-02": zone_du_logement(entity_ref("urn:fr:apl:case:catala-al-02"), ZONE_II) { origin case_input; }
        assert "catala-al-02-03": aide_demandee(entity_ref("urn:fr:apl:case:catala-al-02"), ALF) { origin case_input; }
        assert "catala-al-02-04": situation_familiale(entity_ref("urn:fr:apl:case:catala-al-02"), COUPLE) { origin case_input; }
        assert "catala-al-02-05": personnes_a_charge(entity_ref("urn:fr:apl:case:catala-al-02"), 2) { origin case_input; }
        assert "catala-al-02-06": loyer_principal(entity_ref("urn:fr:apl:case:catala-al-02"), 425 EUR) { origin case_input; }
        assert "catala-al-02-07": ressources_du_menage(entity_ref("urn:fr:apl:case:catala-al-02"), 11500 EUR) { origin case_input; }
        assert "catala-al-02-08": mode_location(entity_ref("urn:fr:apl:case:catala-al-02"), LOCATION_SEULE) { origin case_input; }
        assert "catala-al-02-09": forme_logement(entity_ref("urn:fr:apl:case:catala-al-02"), LOGEMENT_ORDINAIRE) { origin case_input; }
        assert "catala-al-02-10": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:catala-al-02"), 0 EUR) { origin case_input; }
        assert "catala-al-02-11": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:catala-al-02"), false) { origin case_input; }
        assert "catala-al-02-12": territoire(entity_ref("urn:fr:apl:case:catala-al-02"), METROPOLE) { origin case_input; }
    }
    evaluate truth(aide_mensuelle(entity_ref("urn:fr:apl:case:catala-al-02"), 352.7652695 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
