// Собственное дело (без чужого ожидания): одиночка, зона I, общий тип, redevance
// 50 €, ресурсы 600 €, 23.04.2022.
//
// K: числитель R − r·N = 600 − 1 217,26·1,4 отрицателен, формула даёт больше 0,95 и K = 0,95.
// E = 50 (меньше плафона), E0 = 7,3165: Af = 40,549325, после минорации 35,549325 €.
// Чистый расход 50 − 35,549325 = 14,450675 € ниже минимума 26,68 € (ст. 32 арретэ):
// абатмент равен разнице, и пособие после него — ровно E − 26,68 = 23,32 € (D. 832-27).
// Шаг взносов даёт 23,1166 €.
// K читается из R. 351-61 (общий случай) и R. 351-61-1 (фойе молодых работников и
// социальные резиденции) — алгебра D. 832-25 в закреплённых данных картинка, см.
// блок «КОЭФФИЦИЕНТ K» в 04-calcul-foyer.law и README, «Коэффициент K».
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-foyer-apl-06-abattement-depense-nette" {
    given {
        context { decision_time @2022-04-23T12:00:00Z; knowledge_time @2022-04-23T12:00:00Z; legal_time @2022-04-23; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "foyer-apl-06-abattement-depense-nette-01": secteur_logement_foyer(entity_ref("urn:fr:apl:case:foyer-apl-06")) { origin case_input; }
        assert "foyer-apl-06-abattement-depense-nette-02": aide_demandee(entity_ref("urn:fr:apl:case:foyer-apl-06"), APL) { origin case_input; }
        assert "foyer-apl-06-abattement-depense-nette-03": zone_du_logement(entity_ref("urn:fr:apl:case:foyer-apl-06"), ZONE_I) { origin case_input; }
        assert "foyer-apl-06-abattement-depense-nette-04": situation_familiale(entity_ref("urn:fr:apl:case:foyer-apl-06"), PERSONNE_SEULE) { origin case_input; }
        assert "foyer-apl-06-abattement-depense-nette-05": personnes_a_charge(entity_ref("urn:fr:apl:case:foyer-apl-06"), 0) { origin case_input; }
        assert "foyer-apl-06-abattement-depense-nette-06": type_logement_foyer(entity_ref("urn:fr:apl:case:foyer-apl-06"), GENERAL) { origin case_input; }
        assert "foyer-apl-06-abattement-depense-nette-07": redevance(entity_ref("urn:fr:apl:case:foyer-apl-06"), 50 EUR) { origin case_input; }
        assert "foyer-apl-06-abattement-depense-nette-08": ressources_du_menage(entity_ref("urn:fr:apl:case:foyer-apl-06"), 600 EUR) { origin case_input; }
        assert "foyer-apl-06-abattement-depense-nette-09": territoire(entity_ref("urn:fr:apl:case:foyer-apl-06"), METROPOLE) { origin case_input; }
    }
    evaluate truth(aide_mensuelle(entity_ref("urn:fr:apl:case:foyer-apl-06"), 23.1166 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
