// КОЛОКАЦИЯ (ст. 16 арретэ): плафон найма и форфейт расходов берутся из
// собственных таблиц колокаторов — 223,55 € и 27,10 € против 298,07 € и
// 54,22 € у одиночного найма. Точный итог — 114.577516 €.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-frontiere-colocation" {
    given {
        context { decision_time @2022-02-15T12:00:00Z; knowledge_time @2022-02-15T12:00:00Z; legal_time @2022-02-15; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "frontiere-colocation-01": secteur_locatif(entity_ref("urn:fr:apl:case:frontiere-colocation")) { origin case_input; }
        assert "frontiere-colocation-02": zone_du_logement(entity_ref("urn:fr:apl:case:frontiere-colocation"), ZONE_I) { origin case_input; }
        assert "frontiere-colocation-03": aide_demandee(entity_ref("urn:fr:apl:case:frontiere-colocation"), APL) { origin case_input; }
        assert "frontiere-colocation-04": situation_familiale(entity_ref("urn:fr:apl:case:frontiere-colocation"), PERSONNE_SEULE) { origin case_input; }
        assert "frontiere-colocation-05": personnes_a_charge(entity_ref("urn:fr:apl:case:frontiere-colocation"), 0) { origin case_input; }
        assert "frontiere-colocation-06": loyer_principal(entity_ref("urn:fr:apl:case:frontiere-colocation"), 300 EUR) { origin case_input; }
        assert "frontiere-colocation-07": ressources_du_menage(entity_ref("urn:fr:apl:case:frontiere-colocation"), 7800 EUR) { origin case_input; }
        assert "frontiere-colocation-08": mode_location(entity_ref("urn:fr:apl:case:frontiere-colocation"), COLOCATION) { origin case_input; }
        assert "frontiere-colocation-09": forme_logement(entity_ref("urn:fr:apl:case:frontiere-colocation"), LOGEMENT_ORDINAIRE) { origin case_input; }
        assert "frontiere-colocation-10": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:frontiere-colocation"), 0 EUR) { origin case_input; }
        assert "frontiere-colocation-11": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:frontiere-colocation"), false) { origin case_input; }
        assert "frontiere-colocation-12": territoire(entity_ref("urn:fr:apl:case:frontiere-colocation"), METROPOLE) { origin case_input; }
    }
    evaluate truth(aide_mensuelle(entity_ref("urn:fr:apl:case:frontiere-colocation"), 114.577516 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
