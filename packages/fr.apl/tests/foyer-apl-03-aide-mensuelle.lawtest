// Дело Catala «CasTest3» (logement-foyer, APL; пример из публикации министерства,
// «Les aides personnelles au logement — éléments de calcul», сентябрь 2021, с. 34):
// одиночка, зона I, общий тип, redevance 350 €, ресурсы 7 500 €, 15.09.2021.
//
// K = 0,95 − (7 500 − 1 217,26·1,4)/(13 393,40·1,4) = 0,6409… → 0,64 (Catala: 0,64).
// E = 350, E0 = 98,950268 (Catala 98,95).
// Af = 160,67182848 → −5 → 155,67182848 → итог 154,7783591424 €; Catala утверждает 154,78 €.
// K читается из R. 351-61 (общий случай) и R. 351-61-1 (фойе молодых работников и
// социальные резиденции) — алгебра D. 832-25 в закреплённых данных картинка, см.
// блок «КОЭФФИЦИЕНТ K» в 04-calcul-foyer.law и README, «Коэффициент K».
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-foyer-apl-03-aide-mensuelle" {
    given {
        context { decision_time @2021-09-15T12:00:00Z; knowledge_time @2021-09-15T12:00:00Z; legal_time @2021-09-15; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "foyer-apl-03-aide-mensuelle-01": secteur_logement_foyer(entity_ref("urn:fr:apl:case:foyer-apl-03")) { origin case_input; }
        assert "foyer-apl-03-aide-mensuelle-02": aide_demandee(entity_ref("urn:fr:apl:case:foyer-apl-03"), APL) { origin case_input; }
        assert "foyer-apl-03-aide-mensuelle-03": zone_du_logement(entity_ref("urn:fr:apl:case:foyer-apl-03"), ZONE_I) { origin case_input; }
        assert "foyer-apl-03-aide-mensuelle-04": situation_familiale(entity_ref("urn:fr:apl:case:foyer-apl-03"), PERSONNE_SEULE) { origin case_input; }
        assert "foyer-apl-03-aide-mensuelle-05": personnes_a_charge(entity_ref("urn:fr:apl:case:foyer-apl-03"), 0) { origin case_input; }
        assert "foyer-apl-03-aide-mensuelle-06": type_logement_foyer(entity_ref("urn:fr:apl:case:foyer-apl-03"), GENERAL) { origin case_input; }
        assert "foyer-apl-03-aide-mensuelle-07": redevance(entity_ref("urn:fr:apl:case:foyer-apl-03"), 350 EUR) { origin case_input; }
        assert "foyer-apl-03-aide-mensuelle-08": ressources_du_menage(entity_ref("urn:fr:apl:case:foyer-apl-03"), 7500 EUR) { origin case_input; }
        assert "foyer-apl-03-aide-mensuelle-09": territoire(entity_ref("urn:fr:apl:case:foyer-apl-03"), METROPOLE) { origin case_input; }
    }
    evaluate truth(aide_mensuelle(entity_ref("urn:fr:apl:case:foyer-apl-03"), 154.7783591424 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
