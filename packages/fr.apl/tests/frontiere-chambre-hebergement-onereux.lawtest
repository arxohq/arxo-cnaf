// КОМНАТА ЗА ПЛАТУ У ЧАСТНЫХ ЛИЦ (ст. 8, вторая строка): плафон равен 75 %
// плафона одинокого лица, то есть 223,55 € вместо 268,26 € общего случая
// комнаты. Парный сценарий общего случая — catala-08.lawtest. Точный итог — 141.713116 €.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-frontiere-chambre-hebergement-onereux" {
    given {
        context { decision_time @2022-02-15T12:00:00Z; knowledge_time @2022-02-15T12:00:00Z; legal_time @2022-02-15; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "frontiere-chambre-hebergement-onereux-01": secteur_locatif(entity_ref("urn:fr:apl:case:frontiere-chambre-hebergement-onereux")) { origin case_input; }
        assert "frontiere-chambre-hebergement-onereux-02": zone_du_logement(entity_ref("urn:fr:apl:case:frontiere-chambre-hebergement-onereux"), ZONE_I) { origin case_input; }
        assert "frontiere-chambre-hebergement-onereux-03": aide_demandee(entity_ref("urn:fr:apl:case:frontiere-chambre-hebergement-onereux"), APL) { origin case_input; }
        assert "frontiere-chambre-hebergement-onereux-04": situation_familiale(entity_ref("urn:fr:apl:case:frontiere-chambre-hebergement-onereux"), PERSONNE_SEULE) { origin case_input; }
        assert "frontiere-chambre-hebergement-onereux-05": personnes_a_charge(entity_ref("urn:fr:apl:case:frontiere-chambre-hebergement-onereux"), 0) { origin case_input; }
        assert "frontiere-chambre-hebergement-onereux-06": loyer_principal(entity_ref("urn:fr:apl:case:frontiere-chambre-hebergement-onereux"), 300 EUR) { origin case_input; }
        assert "frontiere-chambre-hebergement-onereux-07": ressources_du_menage(entity_ref("urn:fr:apl:case:frontiere-chambre-hebergement-onereux"), 7800 EUR) { origin case_input; }
        assert "frontiere-chambre-hebergement-onereux-08": mode_location(entity_ref("urn:fr:apl:case:frontiere-chambre-hebergement-onereux"), LOCATION_SEULE) { origin case_input; }
        assert "frontiere-chambre-hebergement-onereux-09": forme_logement(entity_ref("urn:fr:apl:case:frontiere-chambre-hebergement-onereux"), CHAMBRE_HEBERGEMENT_ONEREUX) { origin case_input; }
        assert "frontiere-chambre-hebergement-onereux-10": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:frontiere-chambre-hebergement-onereux"), 0 EUR) { origin case_input; }
        assert "frontiere-chambre-hebergement-onereux-11": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:frontiere-chambre-hebergement-onereux"), false) { origin case_input; }
        assert "frontiere-chambre-hebergement-onereux-12": territoire(entity_ref("urn:fr:apl:case:frontiere-chambre-hebergement-onereux"), METROPOLE) { origin case_input; }
    }
    evaluate truth(aide_mensuelle(entity_ref("urn:fr:apl:case:frontiere-chambre-hebergement-onereux"), 141.713116 EUR));
    expect result_kind == PROPOSITION;
