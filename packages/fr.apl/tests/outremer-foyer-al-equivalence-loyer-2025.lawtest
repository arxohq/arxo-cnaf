// Свой сценарий: дел этих секторов на заморских территориях нет ни у Catala, ни
// у OpenFisca. Факт ресурсов не подан намеренно — этому шагу он не нужен, а с ним
// сработал бы расчёт E0 либо L0, чей отказ поразил бы весь документ.
//
// ШАГ, ВТОРАЯ ГРАНИЦА ИЗЪЯТИЯ. Эквивалентность найма L по категории «пожилые
// лица» (ст. 43, редакция с 1 октября 2024 года) — 354,78 € для пары. Ст. 46 её
// НЕ заменяет: изъятие касается форфейтов расходов, а не самой эквивалентности.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-outremer-foyer-al-equivalence-loyer-2025" {
    given {
        context { decision_time @2025-06-15T12:00:00Z; knowledge_time @2025-06-15T12:00:00Z; legal_time @2025-06-15; timezone "Europe/Paris"; }
        assert "outremer-foyer-al-equivalence-loyer-2025-01": secteur_logement_foyer(entity_ref("urn:fr:apl:case:om-foyer-al-2025")) { origin case_input; }
        assert "outremer-foyer-al-equivalence-loyer-2025-02": aide_demandee(entity_ref("urn:fr:apl:case:om-foyer-al-2025"), ALF) { origin case_input; }
        assert "outremer-foyer-al-equivalence-loyer-2025-03": zone_du_logement(entity_ref("urn:fr:apl:case:om-foyer-al-2025"), ZONE_III) { origin case_input; }
        assert "outremer-foyer-al-equivalence-loyer-2025-04": situation_familiale(entity_ref("urn:fr:apl:case:om-foyer-al-2025"), COUPLE) { origin case_input; }
        assert "outremer-foyer-al-equivalence-loyer-2025-05": personnes_a_charge(entity_ref("urn:fr:apl:case:om-foyer-al-2025"), 1) { origin case_input; }
        assert "outremer-foyer-al-equivalence-loyer-2025-06": categorie_equivalence_loyer(entity_ref("urn:fr:apl:case:om-foyer-al-2025"), PERSONNES_AGEES) { origin case_input; }
        assert "outremer-foyer-al-equivalence-loyer-2025-07": redevance(entity_ref("urn:fr:apl:case:om-foyer-al-2025"), 400 EUR) { origin case_input; }
        assert "outremer-foyer-al-equivalence-loyer-2025-08": territoire(entity_ref("urn:fr:apl:case:om-foyer-al-2025"), OUTRE_MER) { origin case_input; }
    }
    evaluate truth(equivalence_loyer_retenue(entity_ref("urn:fr:apl:case:om-foyer-al-2025"), 354.78 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
