// Месяц права — ноябрь 2025 года: редакция, применимая «aux prestations dues à
// compter du 1er octobre 2025». Её версии статей пришли ИНКРЕМЕНТОМ DILA
// LEGI_20250911-214911 — в глобальный дамп они попасть не могли, он снят
// 13 июля 2025 года.
//
// ШАГ (глава VII): форфейт расходов аллокации в фойе — 60,59 € + 13,74 € =
// 74,33 €.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-foyer-al-forfait-charges-2025-10" {
    given {
        context { decision_time @2025-11-15T12:00:00Z; knowledge_time @2025-11-15T12:00:00Z; legal_time @2025-11-15; timezone "Europe/Paris"; }
        assert "foyer-al-forfait-charges-2025-10-01": secteur_logement_foyer(entity_ref("urn:fr:apl:case:foyer-al-2025-10")) { origin case_input; }
        assert "foyer-al-forfait-charges-2025-10-02": aide_demandee(entity_ref("urn:fr:apl:case:foyer-al-2025-10"), ALF) { origin case_input; }
        assert "foyer-al-forfait-charges-2025-10-03": zone_du_logement(entity_ref("urn:fr:apl:case:foyer-al-2025-10"), ZONE_III) { origin case_input; }
        assert "foyer-al-forfait-charges-2025-10-04": situation_familiale(entity_ref("urn:fr:apl:case:foyer-al-2025-10"), COUPLE) { origin case_input; }
        assert "foyer-al-forfait-charges-2025-10-05": personnes_a_charge(entity_ref("urn:fr:apl:case:foyer-al-2025-10"), 1) { origin case_input; }
        assert "foyer-al-forfait-charges-2025-10-06": categorie_equivalence_loyer(entity_ref("urn:fr:apl:case:foyer-al-2025-10"), PERSONNES_AGEES) { origin case_input; }
        assert "foyer-al-forfait-charges-2025-10-07": redevance(entity_ref("urn:fr:apl:case:foyer-al-2025-10"), 400 EUR) { origin case_input; }
        assert "foyer-al-forfait-charges-2025-10-08": territoire(entity_ref("urn:fr:apl:case:foyer-al-2025-10"), METROPOLE) { origin case_input; }
    }
    evaluate truth(forfait_charges_foyer(entity_ref("urn:fr:apl:case:foyer-al-2025-10"), 74.33 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
