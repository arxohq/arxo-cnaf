// Собственное дело: ресурсы 1 200 € ниже r·N (1 217,26·1,4 = 1 704,16), числитель
// формулы K отрицателен, формула даёт 0,97, и «lorsque le calcul le porte à une valeur
// supérieure à 0,95, il est considéré égal à 0,95» (D. 832-25 a) 1°).
//
// Af = 0,95 × (350 − 9,3165) = 323,649325 €.
// K читается из R. 351-61 (общий случай) и R. 351-61-1 (фойе молодых работников и
// социальные резиденции) — алгебра D. 832-25 в закреплённых данных картинка, см.
// блок «КОЭФФИЦИЕНТ K» в 04-calcul-foyer.law и README, «Коэффициент K».
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-foyer-apl-07-plafond-k" {
    given {
        context { decision_time @2022-04-23T12:00:00Z; knowledge_time @2022-04-23T12:00:00Z; legal_time @2022-04-23; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "foyer-apl-07-plafond-k-01": secteur_logement_foyer(entity_ref("urn:fr:apl:case:foyer-apl-07")) { origin case_input; }
        assert "foyer-apl-07-plafond-k-02": aide_demandee(entity_ref("urn:fr:apl:case:foyer-apl-07"), APL) { origin case_input; }
        assert "foyer-apl-07-plafond-k-03": zone_du_logement(entity_ref("urn:fr:apl:case:foyer-apl-07"), ZONE_I) { origin case_input; }
        assert "foyer-apl-07-plafond-k-04": situation_familiale(entity_ref("urn:fr:apl:case:foyer-apl-07"), PERSONNE_SEULE) { origin case_input; }
        assert "foyer-apl-07-plafond-k-05": personnes_a_charge(entity_ref("urn:fr:apl:case:foyer-apl-07"), 0) { origin case_input; }
        assert "foyer-apl-07-plafond-k-06": type_logement_foyer(entity_ref("urn:fr:apl:case:foyer-apl-07"), GENERAL) { origin case_input; }
        assert "foyer-apl-07-plafond-k-07": redevance(entity_ref("urn:fr:apl:case:foyer-apl-07"), 350 EUR) { origin case_input; }
        assert "foyer-apl-07-plafond-k-08": ressources_du_menage(entity_ref("urn:fr:apl:case:foyer-apl-07"), 1200 EUR) { origin case_input; }
        assert "foyer-apl-07-plafond-k-09": territoire(entity_ref("urn:fr:apl:case:foyer-apl-07"), METROPOLE) { origin case_input; }
    }
    evaluate truth(aide_foyer_formule(entity_ref("urn:fr:apl:case:foyer-apl-07"), 323.649325 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
