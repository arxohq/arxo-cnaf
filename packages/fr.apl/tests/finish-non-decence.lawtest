// Non-decency (19): conservation triggered for ALF on a finding, the
// reduced rent during conservation, the owner-notification duty, the
// eighteen-month non-recovery, and energy compliance by produced DPE.
// L. 843-7 continuation (positive, missing-copy, conservation-blocked),
// the five R. 843-6 maintenance grounds with once-only renewal, L. 843-4
// successor conservation and expiry, the L. 843-5 above-rent excess and
// owner refund duty, R. 843-1 hotel notices with gated extension, R. 843-3
// tenant notice, and R. 843-7 simultaneous-procedure suspension.
// D-42: the given blocks were written with bare `legal_time @D;` and
// `using fr.apl version ...;` lines, which the .lawtest grammar does not
// parse ("test not parsed" on both evaluators). Rewritten to the context
// form of the other hand suites (decision/knowledge time at noon of the
// legal date, Europe/Paris), carrying the suite's deadline_policy and the
// G-A13 working reading PpPlancherFinal (24-lecture-pp.law). Facts, queries
// and expectations are unchanged.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-finish-conservation-declenchee" {
    given {
        context { decision_time @2023-05-15T12:00:00Z; knowledge_time @2023-05-15T12:00:00Z; legal_time @2023-05-15; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "fcon-01": constat_non_decence(entity_ref("urn:fr:apl:case:fcon"), @2023-04-10) { origin case_input; }
        assert "fcon-02": percoit_allocations_familiales(entity_ref("urn:fr:apl:case:fcon"), true) { origin case_input; }
        assert "fcon-03": aide_demandee(entity_ref("urn:fr:apl:case:fcon"), ALF) { origin case_input; }
    }
    evaluate truth(conservation_en_cours(entity_ref("urn:fr:apl:case:fcon")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

