// Дело Catala «Exemple2» (сектор приобретения, APL): заём подписан 2 декабря
// 2019 года, зона III, пара с двумя иждивенцами, жильё приобретено и улучшено.
//
// ШАГ: плафон по подслучаю 18° ст. 18, колонка b): 349,34 € + 49,86 € =
// 399,20 €.
//
// ЭТО ТОЧКА, В КОТОРОЙ CATALA САМА СПОРИТ С ОФИЦИАЛЬНЫМ ДОКУМЕНТОМ. В своём
// файле они пишут: «Ici nous sommes en désaccord avec la valeur finale, car la
// mensualité plafond est déterminée dans le cas d'un logement ancien acquis et
// amélioré par le 18° b° de l'article 18 de l'arrêté du 27 septembre 2019, et
// non par le 18° a). Ce qui donne une mensualité éligible de 399,20 € et non de
// 495,73 €». Наш расчёт по закреплённому тексту даёт ровно 399,20 € — то есть
// подтверждает ИХ чтение против методички DGALN/DHUP.//
// ПОЧЕМУ В ЭТОМ ДЕЛЕ НЕТ ФАКТА РЕСУРСОВ. Ресурсы этому шагу не нужны, и они здесь
// намеренно не поданы: с ними дело считает ещё и L0, а его деление на двенадцать
// на этом входе неточно и отказывает — а отказ §50 поражает ВЕСЬ
// evaluation-документ (`NON_EXECUTABLE`), не одно заключение. Измерено
// 14.09.2026: с фактом ресурсов этот сценарий краснеет у обоих оценщиков не
// потому, что плафон неверен, а потому, что документ целиком неисполним.
// Отказ закреплён отдельным сценарием `accession-02-mensualite-minimale-inexacte`.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-accession-02-plafond-mensualite" {
    given {
        context { decision_time @2021-09-15T12:00:00Z; knowledge_time @2021-09-15T12:00:00Z; legal_time @2021-09-15; timezone "Europe/Paris"; }
        assert "accession-02-plafond-mensualite-01": secteur_accession(entity_ref("urn:fr:apl:case:accession-02")) { origin case_input; }
        assert "accession-02-plafond-mensualite-02": aide_demandee(entity_ref("urn:fr:apl:case:accession-02"), APL) { origin case_input; }
        assert "accession-02-plafond-mensualite-03": zone_du_logement(entity_ref("urn:fr:apl:case:accession-02"), ZONE_III) { origin case_input; }
        assert "accession-02-plafond-mensualite-04": situation_familiale(entity_ref("urn:fr:apl:case:accession-02"), COUPLE) { origin case_input; }
        assert "accession-02-plafond-mensualite-05": personnes_a_charge(entity_ref("urn:fr:apl:case:accession-02"), 2) { origin case_input; }
        assert "accession-02-plafond-mensualite-06": sous_cas_mensualite(entity_ref("urn:fr:apl:case:accession-02"), PRET_APRES_30_09_2019) { origin case_input; }
        assert "accession-02-plafond-mensualite-07": finalite_operation(entity_ref("urn:fr:apl:case:accession-02"), LOGEMENT_ACQUIS_AMELIORE) { origin case_input; }
        assert "accession-02-plafond-mensualite-08": type_travaux(entity_ref("urn:fr:apl:case:accession-02"), TRAVAUX_POUR_ACQUISITION) { origin case_input; }
        assert "accession-02-plafond-mensualite-09": mode_propriete(entity_ref("urn:fr:apl:case:accession-02"), PROPRIETAIRE_UNIQUE) { origin case_input; }
        assert "accession-02-plafond-mensualite-10": mensualite_declaree(entity_ref("urn:fr:apl:case:accession-02"), 495.73 EUR) { origin case_input; }
        assert "accession-02-plafond-mensualite-11": vintage_pret_depense_nette(entity_ref("urn:fr:apl:case:accession-02"), PRET_DEPUIS_OCTOBRE_1998) { origin case_input; }
        assert "accession-02-plafond-mensualite-12": situation_r822_11_13_17(entity_ref("urn:fr:apl:case:accession-02"), false) { origin case_input; }
    }
    evaluate truth(plafond_mensualite(entity_ref("urn:fr:apl:case:accession-02"), 399.20 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
