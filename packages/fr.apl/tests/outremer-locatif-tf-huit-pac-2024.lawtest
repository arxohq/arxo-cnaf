// Вторая половина пары о форме таблицы TF (см. `*-2021`).
//
// ШАГ: с 2023 года у заморской таблицы появились строка семи иждивенцев (1,67 %)
// и надбавка (−0,06 %), поэтому при восьми иждивенцах ставка равна
// 1,67 % − 0,06 % = 1,61 %, а не 1,62 % прежних лет.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-outremer-locatif-tf-huit-pac-2024" {
    given {
        context { decision_time @2024-06-15T12:00:00Z; knowledge_time @2024-06-15T12:00:00Z; legal_time @2024-06-15; timezone "Europe/Paris"; }
        assert "outremer-locatif-tf-huit-pac-2024-01": secteur_locatif(entity_ref("urn:fr:apl:case:om-loc-8pac-2024")) { origin case_input; }
        assert "outremer-locatif-tf-huit-pac-2024-02": aide_demandee(entity_ref("urn:fr:apl:case:om-loc-8pac-2024"), APL) { origin case_input; }
        assert "outremer-locatif-tf-huit-pac-2024-03": zone_du_logement(entity_ref("urn:fr:apl:case:om-loc-8pac-2024"), ZONE_II) { origin case_input; }
        assert "outremer-locatif-tf-huit-pac-2024-04": situation_familiale(entity_ref("urn:fr:apl:case:om-loc-8pac-2024"), COUPLE) { origin case_input; }
        assert "outremer-locatif-tf-huit-pac-2024-05": personnes_a_charge(entity_ref("urn:fr:apl:case:om-loc-8pac-2024"), 8) { origin case_input; }
        assert "outremer-locatif-tf-huit-pac-2024-06": mode_location(entity_ref("urn:fr:apl:case:om-loc-8pac-2024"), LOCATION_SEULE) { origin case_input; }
        assert "outremer-locatif-tf-huit-pac-2024-07": territoire(entity_ref("urn:fr:apl:case:om-loc-8pac-2024"), OUTRE_MER) { origin case_input; }
    }
    evaluate truth(taux_composition_familiale(entity_ref("urn:fr:apl:case:om-loc-8pac-2024"), 0.0161));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
