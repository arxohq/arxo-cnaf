// Свой сценарий заморского найма: наёмных дел заморских территорий нет ни у
// Catala, ни у OpenFisca. Факты скупые нарочно: шагу не нужны ни наём, ни ресурсы.
//
// ШАГ: заморский форфейт расходов по состоянию с 1 октября 2020 года:
// 36,25 € + 9,32 € = 45,57 € (метрополия: 53,99 € + 12,24 € = 66,23 €). Это
// первое закреплённое состояние изъятий — раньше начинается барем главы III.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-outremer-locatif-forfait-charges-2020" {
    given {
        context { decision_time @2020-11-15T12:00:00Z; knowledge_time @2020-11-15T12:00:00Z; legal_time @2020-11-15; timezone "Europe/Paris"; }
        assert "outremer-locatif-forfait-charges-2020-01": secteur_locatif(entity_ref("urn:fr:apl:case:om-loc-2020")) { origin case_input; }
        assert "outremer-locatif-forfait-charges-2020-02": aide_demandee(entity_ref("urn:fr:apl:case:om-loc-2020"), APL) { origin case_input; }
        assert "outremer-locatif-forfait-charges-2020-03": zone_du_logement(entity_ref("urn:fr:apl:case:om-loc-2020"), ZONE_II) { origin case_input; }
        assert "outremer-locatif-forfait-charges-2020-04": situation_familiale(entity_ref("urn:fr:apl:case:om-loc-2020"), COUPLE) { origin case_input; }
        assert "outremer-locatif-forfait-charges-2020-05": personnes_a_charge(entity_ref("urn:fr:apl:case:om-loc-2020"), 1) { origin case_input; }
        assert "outremer-locatif-forfait-charges-2020-06": mode_location(entity_ref("urn:fr:apl:case:om-loc-2020"), LOCATION_SEULE) { origin case_input; }
        assert "outremer-locatif-forfait-charges-2020-07": territoire(entity_ref("urn:fr:apl:case:om-loc-2020"), OUTRE_MER) { origin case_input; }
    }
    evaluate truth(forfait_charges(entity_ref("urn:fr:apl:case:om-loc-2020"), 45.57 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
