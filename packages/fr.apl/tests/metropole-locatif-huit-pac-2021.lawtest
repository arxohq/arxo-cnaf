// Противовес пределу: в МЕТРОПОЛИИ надбавка не ограничивалась никогда.
//
// ШАГ: восемь иждивенцев в 2021 году — 54,22 € + 12,29 € × 8 = 152,54 €. Если бы
// предел был заведён осью значений, а не нормой с территорией в посылке, это
// дело считалось бы по заморскому правилу.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-metropole-locatif-huit-pac-2021" {
    given {
        context { decision_time @2021-11-15T12:00:00Z; knowledge_time @2021-11-15T12:00:00Z; legal_time @2021-11-15; timezone "Europe/Paris"; }
        assert "metropole-locatif-huit-pac-2021-01": secteur_locatif(entity_ref("urn:fr:apl:case:mt-loc-8pac-2021")) { origin case_input; }
        assert "metropole-locatif-huit-pac-2021-02": aide_demandee(entity_ref("urn:fr:apl:case:mt-loc-8pac-2021"), APL) { origin case_input; }
        assert "metropole-locatif-huit-pac-2021-03": zone_du_logement(entity_ref("urn:fr:apl:case:mt-loc-8pac-2021"), ZONE_II) { origin case_input; }
        assert "metropole-locatif-huit-pac-2021-04": situation_familiale(entity_ref("urn:fr:apl:case:mt-loc-8pac-2021"), COUPLE) { origin case_input; }
        assert "metropole-locatif-huit-pac-2021-05": personnes_a_charge(entity_ref("urn:fr:apl:case:mt-loc-8pac-2021"), 8) { origin case_input; }
        assert "metropole-locatif-huit-pac-2021-06": mode_location(entity_ref("urn:fr:apl:case:mt-loc-8pac-2021"), LOCATION_SEULE) { origin case_input; }
        assert "metropole-locatif-huit-pac-2021-07": territoire(entity_ref("urn:fr:apl:case:mt-loc-8pac-2021"), METROPOLE) { origin case_input; }
    }
    evaluate truth(forfait_charges(entity_ref("urn:fr:apl:case:mt-loc-8pac-2021"), 152.54 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
