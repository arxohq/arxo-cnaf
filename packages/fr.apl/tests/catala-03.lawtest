// Exemple3: одинокое лицо с тремя иждивенцами, зона III, наём 408 €, ресурсы 14 300 €
// 
// ИСТОЧНИК ОЖИДАНИЯ: Catala, CatalaLang/catala-examples@ebe5e7c2, aides_logement/tests/; их значение — 321.61 €.
// НАШ ТОЧНЫЙ ИТОГ: 321.60933775 € (округлений сверх трёх предписанных текстом
// пакет не делает — см. шапку 02-calcul-locatif.law).
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-catala-03" {
    given {
        context { decision_time @2022-01-18T12:00:00Z; knowledge_time @2022-01-18T12:00:00Z; legal_time @2022-01-18; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "catala-03-01": secteur_locatif(entity_ref("urn:fr:apl:case:catala-03")) { origin case_input; }
        assert "catala-03-02": zone_du_logement(entity_ref("urn:fr:apl:case:catala-03"), ZONE_III) { origin case_input; }
        assert "catala-03-03": aide_demandee(entity_ref("urn:fr:apl:case:catala-03"), APL) { origin case_input; }
        assert "catala-03-04": situation_familiale(entity_ref("urn:fr:apl:case:catala-03"), PERSONNE_SEULE) { origin case_input; }
        assert "catala-03-05": personnes_a_charge(entity_ref("urn:fr:apl:case:catala-03"), 3) { origin case_input; }
        assert "catala-03-06": loyer_principal(entity_ref("urn:fr:apl:case:catala-03"), 408 EUR) { origin case_input; }
        assert "catala-03-07": ressources_du_menage(entity_ref("urn:fr:apl:case:catala-03"), 14300 EUR) { origin case_input; }
        assert "catala-03-08": mode_location(entity_ref("urn:fr:apl:case:catala-03"), LOCATION_SEULE) { origin case_input; }
        assert "catala-03-09": forme_logement(entity_ref("urn:fr:apl:case:catala-03"), LOGEMENT_ORDINAIRE) { origin case_input; }
        assert "catala-03-10": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:catala-03"), 0 EUR) { origin case_input; }
        assert "catala-03-11": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:catala-03"), false) { origin case_input; }
        assert "catala-03-12": territoire(entity_ref("urn:fr:apl:case:catala-03"), METROPOLE) { origin case_input; }
    }
    evaluate truth(aide_mensuelle(entity_ref("urn:fr:apl:case:catala-03"), 321.60933775 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
