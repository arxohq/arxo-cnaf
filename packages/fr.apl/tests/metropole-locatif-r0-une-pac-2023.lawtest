// Сценарий-противовес: тот же состав и тот же месяц права, но МЕТРОПОЛИЯ.
//
// ШАГ: R0 домохозяйства с одним иждивенцем — 8 456 € (ст. 15, редакция с
// 1 января 2023 года). Рядом с `outremer-locatif-r0-une-pac` (8 181 €) это и
// показывает, что ось территории работает: вход и дата совпадают, различается
// только территория.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-metropole-locatif-r0-une-pac-2023" {
    given {
        context { decision_time @2023-03-15T12:00:00Z; knowledge_time @2023-03-15T12:00:00Z; legal_time @2023-03-15; timezone "Europe/Paris"; }
        assert "metropole-locatif-r0-une-pac-2023-01": secteur_locatif(entity_ref("urn:fr:apl:case:mt-loc-a")) { origin case_input; }
        assert "metropole-locatif-r0-une-pac-2023-02": aide_demandee(entity_ref("urn:fr:apl:case:mt-loc-a"), APL) { origin case_input; }
        assert "metropole-locatif-r0-une-pac-2023-03": zone_du_logement(entity_ref("urn:fr:apl:case:mt-loc-a"), ZONE_II) { origin case_input; }
        assert "metropole-locatif-r0-une-pac-2023-04": situation_familiale(entity_ref("urn:fr:apl:case:mt-loc-a"), COUPLE) { origin case_input; }
        assert "metropole-locatif-r0-une-pac-2023-05": personnes_a_charge(entity_ref("urn:fr:apl:case:mt-loc-a"), 1) { origin case_input; }
        assert "metropole-locatif-r0-une-pac-2023-06": mode_location(entity_ref("urn:fr:apl:case:mt-loc-a"), LOCATION_SEULE) { origin case_input; }
        assert "metropole-locatif-r0-une-pac-2023-07": territoire(entity_ref("urn:fr:apl:case:mt-loc-a"), METROPOLE) { origin case_input; }
    }
    evaluate truth(abattement_r0(entity_ref("urn:fr:apl:case:mt-loc-a"), 8456 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
