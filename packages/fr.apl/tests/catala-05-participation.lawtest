// Exemple5: одинокое лицо без иждивенцев, зона I, наём 610 € выше плафона, ресурсы 2 700 € ниже R0 — участие равно минимальному
// 
// ПРОМЕЖУТОЧНЫЙ ШАГ: личное участие Pp (D. 823-17). Catala утверждает его
// в сантимах; наш точный итог — 35.39 €.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-catala-05-participation" {
    given {
        context { decision_time @2022-04-05T12:00:00Z; knowledge_time @2022-04-05T12:00:00Z; legal_time @2022-04-05; timezone "Europe/Paris"; interpretation PpPlancherFinal; }
        assert "catala-05-participation-01": secteur_locatif(entity_ref("urn:fr:apl:case:catala-05")) { origin case_input; }
        assert "catala-05-participation-02": zone_du_logement(entity_ref("urn:fr:apl:case:catala-05"), ZONE_I) { origin case_input; }
        assert "catala-05-participation-03": aide_demandee(entity_ref("urn:fr:apl:case:catala-05"), APL) { origin case_input; }
        assert "catala-05-participation-04": situation_familiale(entity_ref("urn:fr:apl:case:catala-05"), PERSONNE_SEULE) { origin case_input; }
        assert "catala-05-participation-05": personnes_a_charge(entity_ref("urn:fr:apl:case:catala-05"), 0) { origin case_input; }
        assert "catala-05-participation-06": loyer_principal(entity_ref("urn:fr:apl:case:catala-05"), 610 EUR) { origin case_input; }
        assert "catala-05-participation-07": ressources_du_menage(entity_ref("urn:fr:apl:case:catala-05"), 2700 EUR) { origin case_input; }
        assert "catala-05-participation-08": mode_location(entity_ref("urn:fr:apl:case:catala-05"), LOCATION_SEULE) { origin case_input; }
        assert "catala-05-participation-09": forme_logement(entity_ref("urn:fr:apl:case:catala-05"), LOGEMENT_ORDINAIRE) { origin case_input; }
        assert "catala-05-participation-10": reduction_loyer_solidarite(entity_ref("urn:fr:apl:case:catala-05"), 0 EUR) { origin case_input; }
        assert "catala-05-participation-11": beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:case:catala-05"), false) { origin case_input; }
        assert "catala-05-participation-12": territoire(entity_ref("urn:fr:apl:case:catala-05"), METROPOLE) { origin case_input; }
    }
    evaluate truth(participation_personnelle(entity_ref("urn:fr:apl:case:catala-05"), 35.39 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
