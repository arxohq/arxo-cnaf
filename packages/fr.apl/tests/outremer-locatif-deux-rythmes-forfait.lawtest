// НАХОДКА, КОТОРУЮ ЗАКРЕПЛЯЕТ ЭТА ПАРА СЦЕНАРИЕВ.
//
// Внутри ОДНОЙ статьи 46 две группы значений переоцениваются в РАЗНЫЕ даты:
// форфейты расходов — 1 октября, вместе с баремом главы III, а форфейт R0 —
// 1 января. Поэтому у статьи ПЯТЬ версий на три года, а не три, и месяц права
// ноября 2024 года берёт октябрьские форфейты при ЯНВАРСКОМ R0.
//
// ШАГ: форфейт расходов в ноябре 2024 года — 40,26 € + 10,36 € = 50,62 €, то есть
// УЖЕ переоценённый октябрём. Парный сценарий `*-deux-rythmes-r0` показывает, что
// R0 в тот же месяц ещё прежний.
language "law.core" version "0.2";
package fr.apl version "0.1.0";
namespace "urn:fr:corpus:clir:apl";

test "urn:query:fr-apl-outremer-locatif-deux-rythmes-forfait" {
    given {
        context { decision_time @2024-11-15T12:00:00Z; knowledge_time @2024-11-15T12:00:00Z; legal_time @2024-11-15; timezone "Europe/Paris"; }
        assert "outremer-locatif-deux-rythmes-forfait-01": secteur_locatif(entity_ref("urn:fr:apl:case:om-loc-nov2024")) { origin case_input; }
        assert "outremer-locatif-deux-rythmes-forfait-02": aide_demandee(entity_ref("urn:fr:apl:case:om-loc-nov2024"), APL) { origin case_input; }
        assert "outremer-locatif-deux-rythmes-forfait-03": zone_du_logement(entity_ref("urn:fr:apl:case:om-loc-nov2024"), ZONE_II) { origin case_input; }
        assert "outremer-locatif-deux-rythmes-forfait-04": situation_familiale(entity_ref("urn:fr:apl:case:om-loc-nov2024"), COUPLE) { origin case_input; }
        assert "outremer-locatif-deux-rythmes-forfait-05": personnes_a_charge(entity_ref("urn:fr:apl:case:om-loc-nov2024"), 1) { origin case_input; }
        assert "outremer-locatif-deux-rythmes-forfait-06": mode_location(entity_ref("urn:fr:apl:case:om-loc-nov2024"), LOCATION_SEULE) { origin case_input; }
        assert "outremer-locatif-deux-rythmes-forfait-07": territoire(entity_ref("urn:fr:apl:case:om-loc-nov2024"), OUTRE_MER) { origin case_input; }
    }
    evaluate truth(forfait_charges(entity_ref("urn:fr:apl:case:om-loc-nov2024"), 50.62 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
