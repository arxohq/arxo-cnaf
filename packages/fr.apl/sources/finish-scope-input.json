    "declared": {
      "CCH_D822_21_ED2021_01": {"reason": "индексация сумм arrêté — мета-норма построителя барема, не правило на дело (FINISH housing despite)"},
      "CCH_L821_7": {"reason": "renvoi: давность по L. 553-1, механика у fr.pf.core (FINISH housing despite)"},
      "CCH_L821_8": {"reason": "мост: исключение из доходов, эффект в tax/PF/AAH (FINISH housing despite)"},
      "CCH_L823_5": {"reason": "указатель на R. 823-10..14, исполнено там (FINISH housing despite)"},
      "CCH_L823_9": {"reason": "взыскание по L. 161-1-5/L. 553-2, механика у versement/pf-core (FINISH housing despite)"},
      "CCH_L832_3": {"reason": "доля RLS регламентна; вычет в расчёте через пинованный барем (FINISH housing despite)", "despite": "«entre 90 % et 98 %» — пределы доли RLS, саму долю «fixée par voie réglementaire»; на дело вычет действует через пинованный барем, статья числа на дело не даёт"},
      "CCH_R822_24": {"reason": "décence по декрету 2002-120 — внешние техстандарты (FINISH housing despite)", "despite": "«doit répondre aux caractéristiques de décence» — требование к жилью, содержание которого задаёт внешний декрет 2002-120 (техстандарты вне пакета); последствия недецентности исполнены в модуле 19"},
      "CCH_R823_24": {"reason": "применимые статьи CSS — механика внешняя (FINISH housing despite)"},
      "CSS_D542_39": {"reason": "avances CAF — внутренняя бухгалтерия касс (FINISH family-housing despite)", "despite": "«ne devront pas excéder 0,50 %» / «ne peut … entraîner un dépassement» — лимит фонда кассы за 12 месяцев: адресат — касса как бухгалтерия, а не займ на дело"},
      "CSS_D542_40": {"reason": "arrêté + agrément — нет исполнимого содержания на дело (FINISH family-housing despite)"}
    }
  },
