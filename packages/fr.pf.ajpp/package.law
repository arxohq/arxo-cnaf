pub relation motif_non_cumul_2018(p: fr.pf.core::Personne, motif: MotifNonCumul2018) kind empirical {
    label fr official "cause de non-cumul 2018 constatée pour le bénéficiaire (L. 544-9 2018, fait du dossier)";
    label en unofficial "2018 non-cumulation ground recorded for the beneficiary (L. 544-9 2018, case fact)";
}

pub relation motif_non_cumul_2025(p: fr.pf.core::Personne, motif: MotifNonCumul2025) kind empirical {
    label fr official "cause de non-cumul 2025 constatée pour le bénéficiaire (L. 544-9 2025, fait du dossier)";
