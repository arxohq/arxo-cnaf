    CSS_D544_6_ED2026_06)
rule MontantMensuelDemiCalcule(e: fr.pf.core::Enfant, mois: Date, demies: Integer, t: Money) strict {
    effective [@2022-01-01, infinity);
    label fr official "mensuel à la demi-journée calculée : demies par demi-taux";
    label en unofficial "monthly at the computed half-day: halves times half-rate";
    when ajpp_droit_ouvert(e) and demies_journees_mois(e, mois, demies)
        and taux_demi_journee_calcule(e, t) and enveloppe_ajpp_qualifiee(e);
    then ajpp_montant_mois(e, mois, t * demies);
}

@source(
    CSS_D544_6_PRE2022,
    CSS_D544_6_PRE2022_ED2021_11)
rule MontantMensuelDemi2021(e: fr.pf.core::Enfant, mois: Date, demies: Integer, t: Money) strict {
    effective [@2021-01-01, @2022-01-01);
    label fr official "mensuel 2021 à la demi-journée : demies par demi-taux BMAF";
    label en unofficial "2021 monthly at the half-day: halves times BMAF half-rate";
    when ajpp_droit_ouvert(e) and demies_journees_mois(e, mois, demies)
        and taux_demi_journee_2021(e, t) and enveloppe_ajpp_qualifiee(e);
    then ajpp_montant_mois(e, mois, t * demies);
}

@source(
