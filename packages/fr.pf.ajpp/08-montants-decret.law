rule MontantTempsPartielCalcule(e: fr.pf.core::Enfant, mois: Date, j: Decimal, t: Money) strict {
    effective [@2022-01-01, infinity);
    label fr official "temps partiel au taux calculé : journées non travaillées par taux";
    label en unofficial "part-time at the computed rate: days not worked times rate";
    when ajpp_droit_ouvert(e) and jours_non_travailles_temps_partiel(e, mois, j)
        and taux_journalier_calcule(e, t) and enveloppe_ajpp_qualifiee(e);
    then ajpp_montant_mois(e, mois, t * j);
}

// The part-time paragraph is identical in both versions: the retained-rate
