    CSS_D544_7_ED2026_01,
    CSS_D544_7_ED2026_06)
rule SeuilComplementConstruit(e: fr.pf.core::Enfant, b: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "seuil du complément construit : 27,19 % de la BMAF retenue";
    label en unofficial "built supplement threshold: 27.19% of the retained BMAF";
    when bmaf_retenue_ajpp(e, b);
    then seuil_complement_calcule(e, taux_seuil_complement() * b);
}

@source(
    CSS_D544_7_ED2020_09,
    CSS_D544_7_ED2021_11,
    CSS_D544_7_ED2022_01,
    CSS_D544_7_ED2022_04,
    CSS_D544_7_ED2022_07,
    CSS_D544_7_ED2022_10,
    CSS_D544_7_ED2023_01,
    CSS_D544_7_ED2023_07,
    CSS_D544_7_ED2024_02,
    CSS_D544_7_ED2024_07,
    CSS_D544_7_ED2025_12,
    CSS_D544_7_ED2026_01,
    CSS_D544_7_ED2026_06)
rule ComplementFraisDecret(e: fr.pf.core::Enfant, res: Money, plaf: Money, dep: Money, s: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "dépenses au moins égales au seuil construit, ressources sous plafond : complément";
    label en unofficial "expenses at or above the built threshold, resources under the ceiling: supplement";
    when ajpp_droit_ouvert(e) and ressources_complement(e, res) and plafond_ressources(e, plaf)
        and depenses_complement(e, dep) and seuil_complement_calcule(e, s)
        and res <= plaf and dep >= s;
    then complement_frais_attribue(e);
}

@source(
    CSS_D544_7_ED2020_09,
    CSS_D544_7_ED2021_11,
    CSS_D544_7_ED2022_01,
    CSS_D544_7_ED2022_04,
    CSS_D544_7_ED2022_07,
    CSS_D544_7_ED2022_10,
    CSS_D544_7_ED2023_01,
    CSS_D544_7_ED2023_07,
    CSS_D544_7_ED2024_02,
    CSS_D544_7_ED2024_07,
    CSS_D544_7_ED2025_12,
    CSS_D544_7_ED2026_01,
    CSS_D544_7_ED2026_06)
rule MontantComplementDecret(e: fr.pf.core::Enfant, s: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "complément attribué : montant égal au seuil construit";
    label en unofficial "supplement awarded: amount equal to the built threshold";
    when complement_frais_attribue(e) and seuil_complement_calcule(e, s);
    then ajpp_montant_complement(e, s);
}

// --- D. 544-8: job-seeker flat 22 outside the exception -----------------

@source(
    CSS_D544_8,
    CSS_D544_8_ED2025_12,
    CSS_D544_8_ED2026_01,
    CSS_D544_8_ED2026_06,
    CSS_D544_8_PRE2024,
    CSS_D544_8_PRE2024_ED2021_11,
    CSS_D544_8_PRE2024_ED2022_01,
    CSS_D544_8_PRE2024_ED2022_04,
    CSS_D544_8_PRE2024_ED2022_07,
    CSS_D544_8_PRE2024_ED2022_10,
    CSS_D544_8_PRE2024_ED2023_01,
    CSS_D544_8_PRE2024_ED2023_07,
    CSS_D544_8_PRE2024_ED2024_02)
rule ExceptionForfait(e: fr.pf.core::Enfant, p: fr.pf.core::Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "activité occasionnelle et congé : forfait écarté, L. 544-1 hors champ";
    label en unofficial "occasional work and leave: flat rate set aside, L. 544-1 out of scope";
    when activite_occasionnelle_remuneree(p) and conge_presence_parentale(p, e);
    then exception_forfait_l544_1(p, e);
}

@source(
    CSS_D544_8,
    CSS_D544_8_ED2025_12,
    CSS_D544_8_ED2026_01,
    CSS_D544_8_ED2026_06,
    CSS_D544_8_PRE2024,
    CSS_D544_8_PRE2024_ED2021_11,
    CSS_D544_8_PRE2024_ED2022_01,
    CSS_D544_8_PRE2024_ED2022_04,
    CSS_D544_8_PRE2024_ED2022_07,
    CSS_D544_8_PRE2024_ED2022_10,
    CSS_D544_8_PRE2024_ED2023_01,
    CSS_D544_8_PRE2024_ED2023_07,
    CSS_D544_8_PRE2024_ED2024_02)
rule Forfait22Conforme(e: fr.pf.core::Enfant, mois: Date, jours: Integer, p: fr.pf.core::Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "forfait du demandeur égal aux 22 décret, hors exception";
    label en unofficial "claimant flat days equal to the decree 22, outside the exception";
    when ajpp_droit_ouvert(e) and demandeur_emploi_ajpp(p)
        and jours_forfaitaires(e, mois, jours) and jours == JoursForfaitairesDemandeur
        // D-42: D. 544-8 sets the flat 22 aside only for the established
        // occasional-activity exception; no negative holder (§69,
        // LDC-E4113) — the exception reads not_known §67.
        and not_known(exception_forfait_l544_1(p, e));
    then forfait_22_conforme(e, mois);
}

@source(
    CSS_D544_8,
    CSS_D544_8_ED2025_12,
    CSS_D544_8_ED2026_01,
    CSS_D544_8_ED2026_06,
    CSS_D544_8_PRE2024,
    CSS_D544_8_PRE2024_ED2021_11,
    CSS_D544_8_PRE2024_ED2022_01,
    CSS_D544_8_PRE2024_ED2022_04,
    CSS_D544_8_PRE2024_ED2022_07,
    CSS_D544_8_PRE2024_ED2022_10,
    CSS_D544_8_PRE2024_ED2023_01,
    CSS_D544_8_PRE2024_ED2023_07,
    CSS_D544_8_PRE2024_ED2024_02)
rule MontantForfaitDecret(e: fr.pf.core::Enfant, mois: Date, jours: Integer, t: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "mensuel au forfait décret : 22 conformes par taux retenu";
    label en unofficial "monthly at the decree flat: conforming 22 times retained rate";
    when forfait_22_conforme(e, mois) and jours_forfaitaires(e, mois, jours)
        and montant_journalier_retenu(e, t) and enveloppe_ajpp_qualifiee(e);
    then ajpp_montant_mois(e, mois, t * jours);
}
