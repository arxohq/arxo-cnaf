rule MontantTempsPartielRetenu(e: fr.pf.core::Enfant, mois: Date, j: Decimal, t: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "temps partiel au taux retenu : journées non travaillées par taux";
    label en unofficial "part-time at the retained rate: days not worked times rate";
    when ajpp_droit_ouvert(e) and jours_non_travailles_temps_partiel(e, mois, j)
        and montant_journalier_retenu(e, t) and enveloppe_ajpp_qualifiee(e);
    then ajpp_montant_mois(e, mois, t * j);
}

// --- D. 544-7: 27.19 % threshold and amount -----------------------------

function taux_seuil_complement() -> Decimal = TauxSeuilComplementFrais;

@source(
    CSS_D544_7_ED2020_09,
    CSS_D544_7_ED2021_11,
    CSS_D544_7_ED2022_01,
    CSS_D544_7_ED2022_04,
