};

// --- D. 544-4: 22-day monthly cap, decree rule --------------------------

@source(
    CSS_D544_4_ED2020_09,
    CSS_D544_4_ED2021_11,
    CSS_D544_4_ED2022_01,
    CSS_D544_4_ED2022_04,
    CSS_D544_4_ED2022_07,
    CSS_D544_4_ED2022_10,
    CSS_D544_4_ED2023_01,
    CSS_D544_4_ED2023_07,
    CSS_D544_4_ED2024_02,
    CSS_D544_4_ED2024_07,
    CSS_D544_4_ED2025_12,
    CSS_D544_4_ED2026_01,
    CSS_D544_4_ED2026_06)
rule MensuelDansLimiteDecret(e: fr.pf.core::Enfant, mois: Date, jours: Integer) strict {
    effective [@2021-01-01, infinity);
    label fr official "jours du mois dans le maximum décret de 22, sans maximum retenu";
    label en unofficial "month days within the decree maximum of 22, no retained maximum";
    when jours_ajpp_mois(e, mois, jours) and jours <= PlafondMensuel22Jours;
    then mensuel_dans_limite(e, mois);
}

// --- D. 544-6: the SMIC formula -----------------------------------------
// The HALF_UP argument is mechanical: round() requires a mode, and on
// non-tie inputs every nearest-mode agrees (source-derived). Exact ties
// never surface as legal assertions: the build rule is gated by
// `not taux_tie_en_attente` (D75, B-PFAJPP-TIE-ARRONDI).

// D-42: the quotient (7*shn)/(1-a) is non-terminating on ordinary inputs
// (56/0.995): `/` refuses with INEXACT_DIVISION before `round` sees a
// value (§58). div_round §50 (E-0036) rounds the exact quotient once —
// the text's «arrondi au centième d'euro» (B-PFAJPP-FORMULE-DIVISION).
function ajpp_taux_formule(s: Money, a: Decimal) -> Money =
    div_round(s * 7, 1.0 - a, 2, "HALF_UP");

@source(
    CSS_D544_6,
    CSS_D544_6_ED2022_04,
    CSS_D544_6_ED2022_07,
    CSS_D544_6_ED2022_10,
    CSS_D544_6_ED2023_01,
    CSS_D544_6_ED2023_07,
    CSS_D544_6_ED2024_02,
    CSS_D544_6_ED2024_07,
    CSS_D544_6_ED2025_12,
    CSS_D544_6_ED2026_01,
    CSS_D544_6_ED2026_06)
rule TauxJournalierFormule(e: fr.pf.core::Enfant, s: Money, a: Decimal) strict {
    effective [@2022-01-01, infinity);
    label fr official "taux journalier construit : (7*shn)/(1-a), arrondi au centième, hors tie exact";
    label en unofficial "built daily rate: (7*shn)/(1-a), rounded to the cent, except exact ties";
    when smic_horaire_net_retenu(e, s) and taux_crds_retenu(e, a)
        // D-42: «arrondi au centième d'euro» with exact ties pending (D75):
        // the tie flag is case-asserted, never negated (no negative holder,
        // §69/LDC-E4113) — "except an established tie" is not_known §67.
        and not_known(taux_tie_en_attente(e));
    then taux_journalier_calcule(e, ajpp_taux_formule(s, a));
}

// --- D. 544-6: exact half-cent ties stay pending ---------------------------
// The pin sets rounding to the cent with no tie-breaking mode (D75):
// a case-flagged exact tie yields the pending head, never a rounded
// rate, until the owner records a tie policy.

@source(
    CSS_D544_6,
    CSS_D544_6_ED2022_04,
    CSS_D544_6_ED2022_07,
    CSS_D544_6_ED2022_10,
    CSS_D544_6_ED2023_01,
    CSS_D544_6_ED2023_07,
    CSS_D544_6_ED2024_02,
    CSS_D544_6_ED2024_07,
    CSS_D544_6_ED2025_12,
    CSS_D544_6_ED2026_01,
    CSS_D544_6_ED2026_06)
rule TieTauxEnAttente(e: fr.pf.core::Enfant, s: Money, a: Decimal) strict {
    effective [@2022-01-01, infinity);
    label fr official "tie exact au demi-centime : taux arrondi en attente de la politique de départage";
    label en unofficial "exact half-cent tie: rounded rate pending the tie-breaking policy";
    when smic_horaire_net_retenu(e, s) and taux_crds_retenu(e, a)
        and tie_formule_taux(e);
    then taux_tie_en_attente(e);
}

// --- D. 544-6: L. 5421-1 half-day exclusion ------------------------------

@source(
    CSS_D544_6,
    CSS_D544_6_ED2022_04,
    CSS_D544_6_ED2022_07,
    CSS_D544_6_ED2022_10,
    CSS_D544_6_ED2023_01,
    CSS_D544_6_ED2023_07,
    CSS_D544_6_ED2024_02,
    CSS_D544_6_ED2024_07,
    CSS_D544_6_ED2025_12,
    CSS_D544_6_ED2026_01,
    CSS_D544_6_ED2026_06,
    CSS_D544_6_PRE2022,
    CSS_D544_6_PRE2022_ED2021_11)
rule StatutChomeur(p: fr.pf.core::Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "statut L. 5421-1 établi, intermédiaire d'exclusion";
    label en unofficial "established L. 5421-1 status, exclusion intermediate";
    when chomeur_l5421(p);
    then statut_chomeur_l5421(p);
}

@source(
    CSS_D544_6,
    CSS_D544_6_ED2022_04,
    CSS_D544_6_ED2022_07,
    CSS_D544_6_ED2022_10,
    CSS_D544_6_ED2023_01,
    CSS_D544_6_ED2023_07,
    CSS_D544_6_ED2024_02,
    CSS_D544_6_ED2024_07,
    CSS_D544_6_ED2025_12,
    CSS_D544_6_ED2026_01,
    CSS_D544_6_ED2026_06)
rule TauxDemiJourneeFormule(e: fr.pf.core::Enfant, t: Money, p: fr.pf.core::Personne) strict {
    effective [@2022-01-01, infinity);
    label fr official "demi-journée : moitié du taux calculé, hors L. 5421-1";
    label en unofficial "half-day: half the computed rate, except L. 5421-1";
    // D-42: «A l'exception des personnes mentionnées à l'article L. 5421-1»
    // (D. 544-6): the status is a case fact with no negative holder (§69,
    // LDC-E4113) — the exception reads not_known §67.
    when taux_journalier_calcule(e, t) and fr.pf.core::parent_charge(p, e)
        and not_known(statut_chomeur_l5421(p));
    then taux_demi_journee_calcule(e, t / 2.0);
}

// --- D. 544-6, 2021: BMAF percentage rates ------------------------------

function taux_couple_2021() -> Decimal = TauxJournalierCouple2021;

function taux_isole_2021() -> Decimal = TauxJournalierIsole2021;

function taux_demi_couple_2021() -> Decimal = TauxDemiJourneeCouple2021;

function taux_demi_isole_2021() -> Decimal = TauxDemiJourneeIsole2021;

@source(
    CSS_D544_6_PRE2022,
    CSS_D544_6_PRE2022_ED2021_11)
rule TauxCouple2021(e: fr.pf.core::Enfant, b: Money) strict {
    effective [@2021-01-01, @2022-01-01);
    label fr official "taux journalier 2021 : 10,63 % de la BMAF retenue";
    label en unofficial "2021 daily rate: 10.63% of the retained BMAF";
    // D-42: «Lorsque la charge ... est assumée par une personne seule, le
    // montant ... est fixé à 12,63 %» (D. 544-6 2020): the 10.63 % rate
    // stands only outside the single-person case, else both rates fired
    // on one key(e) (NON_EXECUTABLE). Child-level intermediate, not_known §67.
    when bmaf_retenue_ajpp(e, b) and not_known(charge_isolee_2021(e));
    then taux_journalier_2021(e, taux_couple_2021() * b);
}

@source(
    CSS_D544_6_PRE2022,
    CSS_D544_6_PRE2022_ED2021_11)
rule TauxIsole2021(e: fr.pf.core::Enfant, b: Money, p: fr.pf.core::Personne) strict {
    effective [@2021-01-01, @2022-01-01);
    label fr official "taux journalier 2021 personne seule : 12,63 % de la BMAF";
    label en unofficial "2021 single-person daily rate: 12.63% of BMAF";
    when bmaf_retenue_ajpp(e, b) and charge_personne_seule(p, e);
    then taux_journalier_2021(e, taux_isole_2021() * b);
}

// D-42: child-level single-person marker for the 2021 couple/single split
// (D. 544-6 2020 «assumée par une personne seule»).

@source(
    CSS_D544_6_PRE2022,
    CSS_D544_6_PRE2022_ED2021_11)
rule ChargeIsolee2021(e: fr.pf.core::Enfant, p: fr.pf.core::Personne) strict {
    effective [@2021-01-01, @2022-01-01);
    label fr official "charge de l'enfant assumée par une personne seule : taux personne seule 2021";
    label en unofficial "child in the care of a single person: 2021 single-person rates";
    when charge_personne_seule(p, e);
    then charge_isolee_2021(e);
}

@source(
    CSS_D544_6_PRE2022,
    CSS_D544_6_PRE2022_ED2021_11)
rule DemiCouple2021(e: fr.pf.core::Enfant, b: Money, p: fr.pf.core::Personne) strict {
    effective [@2021-01-01, @2022-01-01);
    label fr official "demi-journée 2021 : 5,315 % de la BMAF, hors L. 5421-1";
    label en unofficial "2021 half-day: 5.315% of BMAF, except L. 5421-1";
    // D-42: L. 5421-1 exception and single-person split as in the daily
    // rates (D. 544-6 2020): not_known §67, no negative holder (§69).
    when bmaf_retenue_ajpp(e, b) and fr.pf.core::parent_charge(p, e)
        and not_known(charge_isolee_2021(e))
        and not_known(statut_chomeur_l5421(p));
    then taux_demi_journee_2021(e, taux_demi_couple_2021() * b);
}

@source(
    CSS_D544_6_PRE2022,
    CSS_D544_6_PRE2022_ED2021_11)
rule DemiIsole2021(e: fr.pf.core::Enfant, b: Money, p: fr.pf.core::Personne) strict {
    effective [@2021-01-01, @2022-01-01);
    label fr official "demi-journée 2021 personne seule : 6,315 % de la BMAF, hors L. 5421-1";
    label en unofficial "2021 single-person half-day: 6.315% of BMAF, except L. 5421-1";
    // D-42: «A l'exception des personnes mentionnées à l'article L. 5421-1»
    // — not_known §67 (no negative holder, §69, LDC-E4113).
    when bmaf_retenue_ajpp(e, b) and charge_personne_seule(p, e)
        and not_known(statut_chomeur_l5421(p));
    then taux_demi_journee_2021(e, taux_demi_isole_2021() * b);
}

// --- D. 544-6: monthly totals from the built rates -----------------------

@source(
    CSS_D544_6,
    CSS_D544_6_ED2022_04,
    CSS_D544_6_ED2022_07,
    CSS_D544_6_ED2022_10,
    CSS_D544_6_ED2023_01,
    CSS_D544_6_ED2023_07,
    CSS_D544_6_ED2024_02,
    CSS_D544_6_ED2024_07,
    CSS_D544_6_ED2025_12,
    CSS_D544_6_ED2026_01,
    CSS_D544_6_ED2026_06)
rule MontantMensuelTauxCalcule(e: fr.pf.core::Enfant, mois: Date, jours: Integer, t: Money) strict {
    effective [@2022-01-01, infinity);
    label fr official "mensuel au taux calculé : jours par taux formule";
    label en unofficial "monthly at the computed rate: days times formula rate";
    when ajpp_droit_ouvert(e) and jours_ajpp_mois(e, mois, jours)
        and taux_journalier_calcule(e, t)
        and mensuel_dans_limite(e, mois) and enveloppe_ajpp_qualifiee(e);
    then ajpp_montant_mois(e, mois, t * jours);
}

@source(
    CSS_D544_6_PRE2022,
    CSS_D544_6_PRE2022_ED2021_11)
rule MontantMensuelTaux2021(e: fr.pf.core::Enfant, mois: Date, jours: Integer, t: Money) strict {
    effective [@2021-01-01, @2022-01-01);
    label fr official "mensuel 2021 : jours par taux BMAF construit";
    label en unofficial "2021 monthly: days times built BMAF rate";
    when ajpp_droit_ouvert(e) and jours_ajpp_mois(e, mois, jours)
        and taux_journalier_2021(e, t)
        and mensuel_dans_limite(e, mois) and enveloppe_ajpp_qualifiee(e);
    then ajpp_montant_mois(e, mois, t * jours);
}

@source(
