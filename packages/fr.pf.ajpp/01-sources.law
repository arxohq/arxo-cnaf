@id("urn:fr:corpus:clir:pf-ajpp#CSS_D544_5")
pub fragment CSS_D544_5 in CSS_ED2006_06 {
    kind article;
    locator "article/D544-5";
    text fr official """Article D544-5
En cas de nouvelle pathologie de l'enfant, un nouveau droit est ouvert dans les conditions prévues à l'article D. 544-1.
