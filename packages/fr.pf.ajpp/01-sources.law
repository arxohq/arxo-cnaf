@id("urn:fr:corpus:clir:pf-ajpp#CSS_L544_4")
pub fragment CSS_L544_4 in CSS_ED2005_12 {
    kind article;
    locator "article/L544-4";
    text fr official """Article L544-4
Le nombre d'allocations journalières versées au titre d'un même enfant au cours d'un mois civil à l'un ou aux deux membres du couple ne peut être supérieur à un nombre maximal fixé par décret.
""";
    content_hash "sha256:eecec3016a5ea7ba0fba3163a70a66f2cd80ae2eb1f93b339c8d6423dae4a0a0";
}

