    CSS_D544_10_ED2024_07,
    CSS_D544_10_ED2025_12,
    CSS_D544_10_ED2026_01,
    CSS_D544_10_ED2026_06)
rule DevoirDeclarerDepensesComplement(o: fr.pf.core::Organisme, p: fr.pf.core::Personne, e: fr.pf.core::Enfant, mois: Date) strict {
    label fr official "l'allocataire du complément déclare les dépenses sur l'honneur pour le mois considéré";
    label en unofficial "the supplement allocataire declares the expenses on oath for the concerned month";
    when complement_frais_attribue(e) and fr.pf.core::parent_charge(p, e)
        and fr.pf.core::organisme_debiteur_pf(o, p)
        and mois_concerne_ajpp(p, mois);
    then duty DeclarerDepensesComplement {
        bearer p;
        beneficiary o;
        maintain declaration_depenses_transmise(p, e, mois) during [@2021-01-01, infinity);
    };
}

@source(
    CSS_D544_10_ED2020_09,
    CSS_D544_10_ED2021_11,
    CSS_D544_10_ED2022_01,
    CSS_D544_10_ED2022_04,
    CSS_D544_10_ED2022_07,
    CSS_D544_10_ED2022_10,
    CSS_D544_10_ED2023_01,
    CSS_D544_10_ED2023_07,
    CSS_D544_10_ED2024_02,
    CSS_D544_10_ED2024_07,
    CSS_D544_10_ED2025_12,
    CSS_D544_10_ED2026_01,
    CSS_D544_10_ED2026_06)
rule DevoirProduirePiecesDepenses(o: fr.pf.core::Organisme, p: fr.pf.core::Personne, e: fr.pf.core::Enfant, mois: Date) strict {
    label fr official "à la demande de l'organisme, l'allocataire produit les justificatifs de dépenses du mois considéré";
    label en unofficial "on the body's demand, the allocataire produces the expense proof for the concerned month";
    when demande_pieces_organisme(o, p) and declaration_depenses_transmise(p, e, mois)
        and mois_concerne_ajpp(p, mois);
    then duty ProduirePiecesDepenses {
        bearer p;
        beneficiary o;
        maintain pieces_depenses_produites(p, e, mois) during [@2021-01-01, infinity);
    };
}

// --- R. 544-1: complete files -------------------------------------------

@source(
    CSS_R544_1,
    CSS_R544_1_ED2024_07,
    CSS_R544_1_ED2025_12,
    CSS_R544_1_ED2026_01,
    CSS_R544_1_ED2026_06,
    CSS_R544_1_PRE2022_ED2020_09,
