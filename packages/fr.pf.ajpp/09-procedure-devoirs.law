// --- D. 544-8, para. 3: declare the days taken to France Travail ------

@source(
    CSS_D544_8,
    CSS_D544_8_ED2025_12,
    CSS_D544_8_ED2026_01,
    CSS_D544_8_ED2026_06,
    CSS_D544_8_PRE2024,
    CSS_D544_8_PRE2024_ED2021_11,
    CSS_D544_8_PRE2024_ED2022_01,
    CSS_D544_8_PRE2024_ED2022_04,
    CSS_D544_8_PRE2024_ED2022_07,
    CSS_D544_8_PRE2024_ED2022_10,
    CSS_D544_8_PRE2024_ED2023_01,
    CSS_D544_8_PRE2024_ED2023_07,
    CSS_D544_8_PRE2024_ED2024_02)
rule DeclarerJoursFranceTravail(o: fr.pf.core::Organisme, p: fr.pf.core::Personne, e: fr.pf.core::Enfant) strict {
    label fr official "le chômeur L. 5421-1 porte à France Travail les jours pris";
    label en unofficial "the L. 5421-1 job-seeker reports the days taken to France Travail";
    when chomeur_l5421(p) and fr.pf.core::parent_charge(p, e)
        and france_travail_operateur(o);
    then duty DeclarerJoursPrisFT {
        bearer p;
        beneficiary o;
        maintain jours_pris_declares_ft(p, e) during [@2021-01-01, infinity);
    };
}

// --- D. 544-9: five monthly supporting-document duties -----------------

