    CSS_R544_1_PRE2024_ED2023_01,
    CSS_R544_1_PRE2024_ED2023_07)
rule DossierReexamenComplet(e: fr.pf.core::Enfant) strict {
    effective [@2021-01-01, infinity);
    label fr official "réexamen : demande recevable et nouveau certificat sous pli";
    label en unofficial "re-examination: admissible request and new sealed certificate";
    when reexamen_demande_recevable(e) and certificat_transmis_sous_pli(e);
    then dossier_reexamen_complet(e);
}

@source(
    CSS_R544_1,
    CSS_R544_1_ED2024_07,
    CSS_R544_1_ED2025_12,
    CSS_R544_1_ED2026_01,
    CSS_R544_1_ED2026_06)
rule DossierRenouvellementComplet(e: fr.pf.core::Enfant) strict {
    effective [@2024-02-05, infinity);
    label fr official "renouvellement : nouveau certificat d'indispensable poursuite sous pli";
    label en unofficial "renewal: new sealed certificate of indispensable continuation";
    when demande_renouvellement(e) and nouveau_certificat(e)
        and certificat_transmis_sous_pli(e);
    then dossier_renouvellement_complet(e);
}

