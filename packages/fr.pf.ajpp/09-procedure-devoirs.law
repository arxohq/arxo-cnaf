    CSS_D544_9_PRE2022_ED2022_01,
    CSS_D544_9_PRE2022_ED2022_04,
    CSS_D544_9_PRE2022_ED2022_07)
rule DevoirTransmettreAttestationConge(o: fr.pf.core::Organisme, p: fr.pf.core::Personne, e: fr.pf.core::Enfant, mois: Date) strict {
    label fr official "le salarié en congé transmet l'attestation visée de congé du mois considéré";
    label en unofficial "the employee on leave sends the stamped leave attestation for the concerned month";
    when conge_presence_parentale(p, e) and fr.pf.core::organisme_debiteur_pf(o, p)
        and mois_concerne_ajpp(p, mois);
    then duty TransmettreAttestationConge {
        bearer p;
        beneficiary o;
        maintain attestation_conge_employeur_transmise(p, e, mois) during [@2021-01-01, infinity);
    };
}

