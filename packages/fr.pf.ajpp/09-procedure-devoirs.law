    CSS_R544_1_PRE2024_ED2022_07,
    CSS_R544_1_PRE2024_ED2022_10,
    CSS_R544_1_PRE2024_ED2023_01,
    CSS_R544_1_PRE2024_ED2023_07)
rule DossierDemandeComplet(e: fr.pf.core::Enfant) strict {
    effective [@2021-01-01, infinity);
    label fr official "demande : attestation de congé et certificat sous pli au contrôle";
    label en unofficial "claim: leave attestation and sealed certificate to the control";
    when attestation_conge_employeur(e) and certificat_transmis_sous_pli(e);
    then dossier_demande_complet(e);
}

