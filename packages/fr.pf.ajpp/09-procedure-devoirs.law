// --- D. 544-10: monthly expense declaration, proof on demand ------------

@source(
    CSS_D544_10_ED2020_09,
    CSS_D544_10_ED2021_11,
    CSS_D544_10_ED2022_01,
    CSS_D544_10_ED2022_04,
    CSS_D544_10_ED2022_07,
