rule ControleCompetent(e: fr.pf.core::Enfant, o: fr.pf.core::Organisme) strict {
    effective [@2021-01-01, infinity);
    label fr official "contrôle compétent : le service de la prise en charge santé de l'enfant";
    label en unofficial "competent control: the child's health-cost service";
    when organisme_prise_en_charge_sante(e, o);
    then controle_medical_competent(e, o);
}

// --- R. 544-3: elapsed silence built from the recorded months -----------

@source(
    CSS_R544_3,
    CSS_R544_3_ED2024_07,
    CSS_R544_3_ED2025_12,
    CSS_R544_3_ED2026_01,
    CSS_R544_3_ED2026_06,
    CSS_R544_3_PRE2022_ED2020_09,
    CSS_R544_3_PRE2022_ED2021_11,
    CSS_R544_3_PRE2022_ED2022_01,
    CSS_R544_3_PRE2024,
    CSS_R544_3_PRE2024_ED2022_07,
    CSS_R544_3_PRE2024_ED2022_10,
    CSS_R544_3_PRE2024_ED2023_01,
    CSS_R544_3_PRE2024_ED2023_07)
rule SilenceEcouleConstruit(e: fr.pf.core::Enfant, reception: Integer, observe: Integer) strict {
    effective [@2021-01-01, infinity);
    label fr official "mois de silence écoulés depuis la réception, construits";
    label en unofficial "built months of silence since receipt";
    when demande_recue_mois(e, reception) and silence_observe_jusqu_mois(e, observe);
    then mois_silence_ecoules(e, observe - reception);
}

// --- R. 544-3: silence deemed favourable --------------------------------

@source(
    CSS_R544_3,
    CSS_R544_3_ED2024_07,
    CSS_R544_3_ED2025_12,
    CSS_R544_3_ED2026_01,
    CSS_R544_3_ED2026_06,
    CSS_R544_3_PRE2022_ED2020_09,
    CSS_R544_3_PRE2022_ED2021_11,
    CSS_R544_3_PRE2022_ED2022_01,
    CSS_R544_3_PRE2024,
    CSS_R544_3_PRE2024_ED2022_07,
    CSS_R544_3_PRE2024_ED2022_10,
    CSS_R544_3_PRE2024_ED2023_01,
    CSS_R544_3_PRE2024_ED2023_07)
rule AvisSilenceFavorable(e: fr.pf.core::Enfant, mois: Integer) strict {
    effective [@2021-01-01, infinity);
    label fr official "demande initiale, silence du contrôle jusqu'au deuxième mois : avis favorable réputé";
    label en unofficial "initial claim, control silence through the second month: deemed favourable opinion";
    when demande_initiale(e) and mois_silence_ecoules(e, mois)
        and mois >= DelaiSilenceControleMois;
    then avis_silence_repute_favorable(e);
}

@source(
    CSS_R544_3,
    CSS_R544_3_ED2024_07,
    CSS_R544_3_ED2025_12,
    CSS_R544_3_ED2026_01,
    CSS_R544_3_ED2026_06,
    CSS_R544_3_PRE2022_ED2020_09,
    CSS_R544_3_PRE2022_ED2021_11,
    CSS_R544_3_PRE2022_ED2022_01,
    CSS_R544_3_PRE2024,
    CSS_R544_3_PRE2024_ED2022_07,
    CSS_R544_3_PRE2024_ED2022_10,
    CSS_R544_3_PRE2024_ED2023_01,
    CSS_R544_3_PRE2024_ED2023_07)
rule DecisionSilenceFavorable(e: fr.pf.core::Enfant, mois: Integer) strict {
    effective [@2021-01-01, infinity);
    label fr official "demande initiale, silence de l'organisme jusqu'au troisième mois : décision favorable réputée";
    label en unofficial "initial claim, body silence through the third month: deemed favourable decision";
    when demande_initiale(e) and mois_silence_ecoules(e, mois)
        and mois >= DelaiSilenceOrganismeMois;
    then decision_silence_reputee_favorable(e);
}

@source(
    CSS_R544_3,
    CSS_R544_3_ED2024_07,
    CSS_R544_3_ED2025_12,
    CSS_R544_3_ED2026_01,
    CSS_R544_3_ED2026_06,
    CSS_R544_3_PRE2022_ED2020_09,
    CSS_R544_3_PRE2022_ED2021_11,
    CSS_R544_3_PRE2022_ED2022_01,
    CSS_R544_3_PRE2024,
    CSS_R544_3_PRE2024_ED2022_07,
    CSS_R544_3_PRE2024_ED2022_10,
    CSS_R544_3_PRE2024_ED2023_01,
    CSS_R544_3_PRE2024_ED2023_07)
rule DroitAjppOuvertSilence(e: fr.pf.core::Enfant, p: fr.pf.core::Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "certificat, avis réputé favorable et congé : droit ouvert";
    label en unofficial "certificate, deemed favourable opinion and leave: right opened";
    when certificat_gravite(e) and avis_silence_repute_favorable(e)
        and conge_presence_parentale(p, e);
    then ajpp_droit_ouvert(e);
}

// --- R. 544-3, 2022-2024: renewal silence deemed unfavourable -----------

@source(
    CSS_R544_3_PRE2024,
    CSS_R544_3_PRE2024_ED2022_07,
    CSS_R544_3_PRE2024_ED2022_10,
    CSS_R544_3_PRE2024_ED2023_01,
    CSS_R544_3_PRE2024_ED2023_07)
rule RenouvellementSilenceDefavorable(e: fr.pf.core::Enfant, mois: Integer) strict {
    effective [@2022-04-30, @2024-02-05);
    label fr official "2022-2024, renouvellement : silence du contrôle vaut avis défavorable";
    label en unofficial "2022-2024, renewal: control silence is an unfavourable opinion";
    when demande_renouvellement(e) and mois_silence_ecoules(e, mois)
        and mois >= DelaiSilenceControleMois;
    then avis_silence_repute_defavorable(e);
}

@source(
    CSS_R544_3_PRE2024,
    CSS_R544_3_PRE2024_ED2022_07,
    CSS_R544_3_PRE2024_ED2022_10,
    CSS_R544_3_PRE2024_ED2023_01,
    CSS_R544_3_PRE2024_ED2023_07)
rule RenouvellementSilenceRejet(e: fr.pf.core::Enfant, mois: Integer) strict {
    effective [@2022-04-30, @2024-02-05);
    label fr official "2022-2024, renouvellement : silence de l'organisme vaut rejet";
    label en unofficial "2022-2024, renewal: body silence is a rejection";
    when demande_renouvellement(e) and mois_silence_ecoules(e, mois)
        and mois >= DelaiSilenceOrganismeMois;
    then decision_silence_rejet(e);
}

@source(
    CSS_R544_3_PRE2024,
    CSS_R544_3_PRE2024_ED2022_07,
    CSS_R544_3_PRE2024_ED2022_10,
    CSS_R544_3_PRE2024_ED2023_01,
    CSS_R544_3_PRE2024_ED2023_07)
rule DevoirNotifierAvisRenouvellement(o: fr.pf.core::Organisme, p: fr.pf.core::Personne, e: fr.pf.core::Enfant) strict {
    effective [@2022-04-30, @2024-02-05);
    label fr official "2022-2024 : l'organisme notifie au demandeur l'avis favorable connu";
    label en unofficial "2022-2024: the body notifies the known favourable opinion to the claimant";
    when demande_renouvellement(e) and accord_controle_renouvellement(e)
        and organisme_connait_avis(o, e) and conge_presence_parentale(p, e)
        and fr.pf.core::organisme_debiteur_pf(o, p);
    then duty NotifierAvisRenouvellement {
        bearer o;
        beneficiary p;
        maintain avis_renouvellement_notifie(p, e) during [@2022-04-30, @2024-02-05);
    };
}

// --- R. 544-3, from 2024: renewal silence deemed favourable -------------

@source(
    CSS_R544_3,
    CSS_R544_3_ED2024_07,
    CSS_R544_3_ED2025_12,
    CSS_R544_3_ED2026_01,
    CSS_R544_3_ED2026_06)
