// Complete re-examination file: admissible request (point 128,
// request 127) plus the new sealed certificate (R. 544-1 para. 4).
language "law.core" version "0.2";
package fr.pf.ajpp version "0.1.0";
namespace "urn:fr:corpus:clir:pf-ajpp";

test "urn:query:fr-pf-ajpp-dossier-reexamen-complet" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "ajpp-drc-01": debut_traitement_mois(entity_ref("urn:fr:pf-ajpp:case:enfant-drc"), 120) { origin case_input; }
        assert "ajpp-drc-02": duree_previsible_mois(entity_ref("urn:fr:pf-ajpp:case:enfant-drc"), 8) { origin case_input; }
        assert "ajpp-drc-03": demande_reexamen_mois(entity_ref("urn:fr:pf-ajpp:case:enfant-drc"), 127) { origin case_input; }
        assert "ajpp-drc-04": certificat_transmis_sous_pli(entity_ref("urn:fr:pf-ajpp:case:enfant-drc")) { origin case_input; }
    }
    evaluate truth(dossier_reexamen_complet(entity_ref("urn:fr:pf-ajpp:case:enfant-drc")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
