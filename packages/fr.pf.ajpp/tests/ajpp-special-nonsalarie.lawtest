// Special worker without standard leave: non-salarié who stopped
// working, certificate and agreement established — the right opens
// through the L. 544-8 channel.
language "law.core" version "0.2";
package fr.pf.ajpp version "0.1.0";
namespace "urn:fr:corpus:clir:pf-ajpp";

test "urn:query:fr-pf-ajpp-special-nonsalarie" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "ajpp-sn-01": certificat_gravite(entity_ref("urn:fr:pf-ajpp:case:enfant-sn")) { origin adjudicated; }
        assert "ajpp-sn-02": avis_favorable_controle(entity_ref("urn:fr:pf-ajpp:case:enfant-sn")) { origin adjudicated; }
        assert "ajpp-sn-03": cesse_activite_non_salarie(entity_ref("urn:fr:pf-ajpp:case:parent-sn")) { origin case_input; }
    }
    evaluate truth(ajpp_droit_ouvert(entity_ref("urn:fr:pf-ajpp:case:enfant-sn")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
