// Expense complement: household resources 20000 under the 30000
// ceiling, condition expenses 5000 above the 3000 set amount. The flat
// monthly complement retained is 150.00.
language "law.core" version "0.2";
package fr.pf.ajpp version "0.1.0";
namespace "urn:fr:corpus:clir:pf-ajpp";

test "urn:query:fr-pf-ajpp-complement-frais" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "ajpp-cf-01": certificat_gravite(entity_ref("urn:fr:pf-ajpp:case:enfant-cf")) { origin adjudicated; }
        assert "ajpp-cf-02": avis_favorable_controle(entity_ref("urn:fr:pf-ajpp:case:enfant-cf")) { origin adjudicated; }
        assert "ajpp-cf-03": conge_presence_parentale(entity_ref("urn:fr:pf-ajpp:case:parent-cf"), entity_ref("urn:fr:pf-ajpp:case:enfant-cf")) { origin case_input; }
        assert "ajpp-cf-04": ressources_complement(entity_ref("urn:fr:pf-ajpp:case:enfant-cf"), 20000 EUR) { origin case_input; }
        assert "ajpp-cf-05": plafond_ressources(entity_ref("urn:fr:pf-ajpp:case:enfant-cf"), 30000 EUR) { origin case_input; }
        assert "ajpp-cf-06": depenses_exposees(entity_ref("urn:fr:pf-ajpp:case:enfant-cf"), 5000 EUR) { origin case_input; }
        assert "ajpp-cf-07": seuil_depenses(entity_ref("urn:fr:pf-ajpp:case:enfant-cf"), 3000 EUR) { origin case_input; }
        assert "ajpp-cf-08": montant_complement_retenu(entity_ref("urn:fr:pf-ajpp:case:enfant-cf"), 150.00 EUR) { origin case_input; }
    }
    evaluate truth(complement_frais_attribue(entity_ref("urn:fr:pf-ajpp:case:enfant-cf")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(ajpp_montant_complement(entity_ref("urn:fr:pf-ajpp:case:enfant-cf"), 150.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
