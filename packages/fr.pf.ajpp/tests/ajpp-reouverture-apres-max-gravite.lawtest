// Reopening past the maximum on persistent gravity: right
// established, gravity still requiring presence and care, four
// elapsed years — the original duration expired (L. 544-3 para. 3,
// «Au-delà de la durée maximale»), the right reopens and payment
// runs beyond the maximum in a fresh application (D. 544-3 2°,
// which keys on the whole of para. 3).
language "law.core" version "0.2";
package fr.pf.ajpp version "0.1.0";
namespace "urn:fr:corpus:clir:pf-ajpp";

test "urn:query:fr-pf-ajpp-reouverture-apres-max-gravite" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "ajpp-gam-01": certificat_gravite(entity_ref("urn:fr:pf-ajpp:case:enfant-gam")) { origin adjudicated; }
        assert "ajpp-gam-02": avis_favorable_controle(entity_ref("urn:fr:pf-ajpp:case:enfant-gam")) { origin adjudicated; }
        assert "ajpp-gam-03": conge_presence_parentale(entity_ref("urn:fr:pf-ajpp:case:parent-gam"), entity_ref("urn:fr:pf-ajpp:case:enfant-gam")) { origin case_input; }
        assert "ajpp-gam-04": gravite_persistante(entity_ref("urn:fr:pf-ajpp:case:enfant-gam")) { origin case_input; }
        assert "ajpp-gam-05": duree_versement_ajpp(entity_ref("urn:fr:pf-ajpp:case:enfant-gam"), MALADIE, 4) { origin case_input; }
    }
    evaluate truth(duree_maximale_expiree(entity_ref("urn:fr:pf-ajpp:case:enfant-gam")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(droit_rouvert(entity_ref("urn:fr:pf-ajpp:case:enfant-gam")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(versement_au_dela_max(entity_ref("urn:fr:pf-ajpp:case:enfant-gam")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
