// Job-seeker flat days checked against the decree: right open,
// job-seeker recorded, 22 flat days for March 2024, no occasional
// activity — conforming to the pinned 22 (D. 544-8).
language "law.core" version "0.2";
package fr.pf.ajpp version "0.1.0";
namespace "urn:fr:corpus:clir:pf-ajpp";

test "urn:query:fr-pf-ajpp-forfait-22-conforme" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "ajpp-f22-01": certificat_gravite(entity_ref("urn:fr:pf-ajpp:case:enfant-f22")) { origin adjudicated; }
        assert "ajpp-f22-02": avis_favorable_controle(entity_ref("urn:fr:pf-ajpp:case:enfant-f22")) { origin adjudicated; }
        assert "ajpp-f22-03": conge_presence_parentale(entity_ref("urn:fr:pf-ajpp:case:parent-f22"), entity_ref("urn:fr:pf-ajpp:case:enfant-f22")) { origin case_input; }
        assert "ajpp-f22-04": demandeur_emploi_ajpp(entity_ref("urn:fr:pf-ajpp:case:parent-f22")) { origin case_input; }
        assert "ajpp-f22-05": jours_forfaitaires(entity_ref("urn:fr:pf-ajpp:case:enfant-f22"), @2024-03-01, 22) { origin case_input; }
    }
    evaluate truth(forfait_22_conforme(entity_ref("urn:fr:pf-ajpp:case:enfant-f22"), @2024-03-01));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
