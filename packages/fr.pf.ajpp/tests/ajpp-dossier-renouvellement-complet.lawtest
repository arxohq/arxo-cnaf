// Complete renewal file (from 2024): renewal requested, new
// certificate of indispensable continuation, sealed transmission
// (R. 544-1 para. 5).
language "law.core" version "0.2";
package fr.pf.ajpp version "0.1.0";
namespace "urn:fr:corpus:clir:pf-ajpp";

test "urn:query:fr-pf-ajpp-dossier-renouvellement-complet" {
    given {
        context { decision_time @2024-05-15T12:00:00Z; knowledge_time @2024-05-15T12:00:00Z; legal_time @2024-05-15; timezone "Europe/Paris"; }
        assert "ajpp-drnc-01": demande_renouvellement(entity_ref("urn:fr:pf-ajpp:case:enfant-drnc")) { origin case_input; }
        assert "ajpp-drnc-02": nouveau_certificat(entity_ref("urn:fr:pf-ajpp:case:enfant-drnc")) { origin adjudicated; }
        assert "ajpp-drnc-03": certificat_transmis_sous_pli(entity_ref("urn:fr:pf-ajpp:case:enfant-drnc")) { origin case_input; }
    }
    evaluate truth(dossier_renouvellement_complet(entity_ref("urn:fr:pf-ajpp:case:enfant-drnc")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
