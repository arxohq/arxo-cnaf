// Monthly cap met: 20 days in March 2024 against a retained maximum
// of 22 (OpenFisca frozen figure as assumed input, B-PFAJPP-D544).
language "law.core" version "0.2";
package fr.pf.ajpp version "0.1.0";
namespace "urn:fr:corpus:clir:pf-ajpp";

test "urn:query:fr-pf-ajpp-mensuel-plafond" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "ajpp-men-01": certificat_gravite(entity_ref("urn:fr:pf-ajpp:case:enfant-men")) { origin adjudicated; }
        assert "ajpp-men-02": avis_favorable_controle(entity_ref("urn:fr:pf-ajpp:case:enfant-men")) { origin adjudicated; }
        assert "ajpp-men-03": conge_presence_parentale(entity_ref("urn:fr:pf-ajpp:case:parent-men"), entity_ref("urn:fr:pf-ajpp:case:enfant-men")) { origin case_input; }
        assert "ajpp-men-04": jours_ajpp_mois(entity_ref("urn:fr:pf-ajpp:case:enfant-men"), @2024-03-01, 20) { origin case_input; }
        assert "ajpp-men-05": plafond_mensuel_retenu(entity_ref("urn:fr:pf-ajpp:case:enfant-men"), 22) { origin case_input; }
    }
    evaluate truth(mensuel_dans_limite(entity_ref("urn:fr:pf-ajpp:case:enfant-men"), @2024-03-01));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
