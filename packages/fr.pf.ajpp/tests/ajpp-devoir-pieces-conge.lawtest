// Monthly pieces duty, leave-takers (D3 active): leave,
// debtor-body link and the concerned month recorded — the
// TransmettreAttestationConge position is ACTIVE.
language "law.core" version "0.2";
package fr.pf.ajpp version "0.1.0";
namespace "urn:fr:corpus:clir:pf-ajpp";

test "urn:query:fr-pf-ajpp-devoir-pieces-conge" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "ajpp-dpc-01": conge_presence_parentale(entity_ref("urn:fr:pf-ajpp:case:parent-dpc"), entity_ref("urn:fr:pf-ajpp:case:enfant-dpc")) { origin case_input; }
        assert "ajpp-dpc-02": fr.pf.core::organisme_debiteur_pf(entity_ref("urn:fr:pf-ajpp:org:caisse"), entity_ref("urn:fr:pf-ajpp:case:parent-dpc")) { origin case_input; }
        assert "ajpp-dpc-03": mois_concerne_ajpp(entity_ref("urn:fr:pf-ajpp:case:parent-dpc"), @2024-03-01) { origin case_input; }
    }
    evaluate positions();
    expect position(TransmettreAttestationConge, ACTIVE);
    expect evaluation_status == COMPUTED;
}
