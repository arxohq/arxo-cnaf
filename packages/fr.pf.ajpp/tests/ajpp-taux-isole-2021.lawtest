// 2021 single-person daily rate: 12.63 % of the retained BMAF
// 400.00 — 50.52 (D. 544-6 2020).
language "law.core" version "0.2";
package fr.pf.ajpp version "0.1.0";
namespace "urn:fr:corpus:clir:pf-ajpp";

test "urn:query:fr-pf-ajpp-taux-isole-2021" {
    given {
        context { decision_time @2021-06-15T12:00:00Z; knowledge_time @2021-06-15T12:00:00Z; legal_time @2021-06-15; timezone "Europe/Paris"; }
        assert "ajpp-ti-01": bmaf_retenue_ajpp(entity_ref("urn:fr:pf-ajpp:case:enfant-ti"), 400.00 EUR) { origin case_input; }
        assert "ajpp-ti-02": charge_personne_seule(entity_ref("urn:fr:pf-ajpp:case:parent-ti"), entity_ref("urn:fr:pf-ajpp:case:enfant-ti")) { origin case_input; }
    }
    evaluate truth(taux_journalier_2021(entity_ref("urn:fr:pf-ajpp:case:enfant-ti"), 50.52 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
