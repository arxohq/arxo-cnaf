// Formula half-day: half of the computed 56.28 — 28.14, the carer
// outside L. 5421-1 (D. 544-6).
language "law.core" version "0.2";
package fr.pf.ajpp version "0.1.0";
namespace "urn:fr:corpus:clir:pf-ajpp";

test "urn:query:fr-pf-ajpp-demi-journee-formule" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "ajpp-djf-01": smic_horaire_net_retenu(entity_ref("urn:fr:pf-ajpp:case:enfant-djf"), 8.00 EUR) { origin case_input; }
        assert "ajpp-djf-02": taux_crds_retenu(entity_ref("urn:fr:pf-ajpp:case:enfant-djf"), 0.005) { origin case_input; }
        assert "ajpp-djf-03": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-ajpp:case:parent-djf"), entity_ref("urn:fr:pf-ajpp:case:enfant-djf")) { origin case_input; }
    }
    evaluate truth(taux_demi_journee_calcule(entity_ref("urn:fr:pf-ajpp:case:enfant-djf"), 28.14 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
