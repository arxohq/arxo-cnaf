// Right opened: detailed certificate, favourable control agreement and
// parental leave taken. The L. 544-1 base right is a boundary quote;
// the head is grounded on L. 544-2.
language "law.core" version "0.2";
package fr.pf.ajpp version "0.1.0";
namespace "urn:fr:corpus:clir:pf-ajpp";

test "urn:query:fr-pf-ajpp-droit-ouvert" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "ajpp-droit-01": certificat_gravite(entity_ref("urn:fr:pf-ajpp:case:enfant-1")) { origin adjudicated; }
        assert "ajpp-droit-02": avis_favorable_controle(entity_ref("urn:fr:pf-ajpp:case:enfant-1")) { origin adjudicated; }
        assert "ajpp-droit-03": conge_presence_parentale(entity_ref("urn:fr:pf-ajpp:case:parent-1"), entity_ref("urn:fr:pf-ajpp:case:enfant-1")) { origin case_input; }
    }
    evaluate truth(ajpp_droit_ouvert(entity_ref("urn:fr:pf-ajpp:case:enfant-1")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
