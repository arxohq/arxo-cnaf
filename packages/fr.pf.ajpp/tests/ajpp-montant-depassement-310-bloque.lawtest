// F05-01 cumulative block: 311 first-envelope days spent, no renewal.
// The month qualifies (10 days within 22), so the spent envelope alone
// blocks the amount: the 600.00 query stays NEITHER.
language "law.core" version "0.2";
package fr.pf.ajpp version "0.1.0";
namespace "urn:fr:corpus:clir:pf-ajpp";

test "urn:query:fr-pf-ajpp-montant-depassement-310-bloque" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "ajpp-mq311-01": certificat_gravite(entity_ref("urn:fr:pf-ajpp:case:enfant-mq311")) { origin adjudicated; }
        assert "ajpp-mq311-02": avis_favorable_controle(entity_ref("urn:fr:pf-ajpp:case:enfant-mq311")) { origin adjudicated; }
        assert "ajpp-mq311-03": conge_presence_parentale(entity_ref("urn:fr:pf-ajpp:case:parent-mq311"), entity_ref("urn:fr:pf-ajpp:case:enfant-mq311")) { origin case_input; }
        assert "ajpp-mq311-04": jours_ajpp_mois(entity_ref("urn:fr:pf-ajpp:case:enfant-mq311"), @2024-03-01, 10) { origin case_input; }
        assert "ajpp-mq311-05": montant_journalier_retenu(entity_ref("urn:fr:pf-ajpp:case:enfant-mq311"), 60.00 EUR) { origin case_input; }
        assert "ajpp-mq311-06": jours_ajpp_verses(entity_ref("urn:fr:pf-ajpp:case:enfant-mq311"), 311) { origin case_input; }
        assert "ajpp-mq311-07": duree_versement_ajpp(entity_ref("urn:fr:pf-ajpp:case:enfant-mq311"), MALADIE, 1) { origin case_input; }
    }
    evaluate truth(mensuel_dans_limite(entity_ref("urn:fr:pf-ajpp:case:enfant-mq311"), @2024-03-01));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(ajpp_dans_limite(entity_ref("urn:fr:pf-ajpp:case:enfant-mq311")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(enveloppe_ajpp_qualifiee(entity_ref("urn:fr:pf-ajpp:case:enfant-mq311")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(ajpp_montant_mois(entity_ref("urn:fr:pf-ajpp:case:enfant-mq311"), @2024-03-01, 600.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
