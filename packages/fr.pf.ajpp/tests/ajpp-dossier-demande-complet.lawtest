// Complete claim file: employer leave attestation plus the sealed
// medical certificate to the control (R. 544-1 1°-2°).
language "law.core" version "0.2";
package fr.pf.ajpp version "0.1.0";
namespace "urn:fr:corpus:clir:pf-ajpp";

test "urn:query:fr-pf-ajpp-dossier-demande-complet" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "ajpp-ddc-01": attestation_conge_employeur(entity_ref("urn:fr:pf-ajpp:case:enfant-ddc")) { origin case_input; }
        assert "ajpp-ddc-02": certificat_transmis_sous_pli(entity_ref("urn:fr:pf-ajpp:case:enfant-ddc")) { origin case_input; }
    }
    evaluate truth(dossier_demande_complet(entity_ref("urn:fr:pf-ajpp:case:enfant-ddc")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
