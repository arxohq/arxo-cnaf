// F05-01 unknown history: open right, 10 month days, retained rate,
// but no cumulative counter and no recorded duration. The month
// qualifies; the envelope cannot be established, so the amount stays
// NEITHER — a meaningful control with no negative from unknown.
language "law.core" version "0.2";
package fr.pf.ajpp version "0.1.0";
namespace "urn:fr:corpus:clir:pf-ajpp";

test "urn:query:fr-pf-ajpp-montant-sans-historique" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "ajpp-mqsh-01": certificat_gravite(entity_ref("urn:fr:pf-ajpp:case:enfant-mqsh")) { origin adjudicated; }
        assert "ajpp-mqsh-02": avis_favorable_controle(entity_ref("urn:fr:pf-ajpp:case:enfant-mqsh")) { origin adjudicated; }
        assert "ajpp-mqsh-03": conge_presence_parentale(entity_ref("urn:fr:pf-ajpp:case:parent-mqsh"), entity_ref("urn:fr:pf-ajpp:case:enfant-mqsh")) { origin case_input; }
        assert "ajpp-mqsh-04": jours_ajpp_mois(entity_ref("urn:fr:pf-ajpp:case:enfant-mqsh"), @2024-03-01, 10) { origin case_input; }
        assert "ajpp-mqsh-05": montant_journalier_retenu(entity_ref("urn:fr:pf-ajpp:case:enfant-mqsh"), 60.00 EUR) { origin case_input; }
    }
    evaluate truth(mensuel_dans_limite(entity_ref("urn:fr:pf-ajpp:case:enfant-mqsh"), @2024-03-01));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(ajpp_dans_limite(entity_ref("urn:fr:pf-ajpp:case:enfant-mqsh")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(enveloppe_ajpp_qualifiee(entity_ref("urn:fr:pf-ajpp:case:enfant-mqsh")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(ajpp_montant_mois(entity_ref("urn:fr:pf-ajpp:case:enfant-mqsh"), @2024-03-01, 600.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
