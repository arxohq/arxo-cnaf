// No right without the control agreement: certificate and leave alone
// carry no record either way. Boundary of the L. 544-2 channel.
language "law.core" version "0.2";
package fr.pf.ajpp version "0.1.0";
namespace "urn:fr:corpus:clir:pf-ajpp";

test "urn:query:fr-pf-ajpp-droit-sans-avis" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "ajpp-droitna-01": certificat_gravite(entity_ref("urn:fr:pf-ajpp:case:enfant-na")) { origin adjudicated; }
        assert "ajpp-droitna-02": conge_presence_parentale(entity_ref("urn:fr:pf-ajpp:case:parent-na"), entity_ref("urn:fr:pf-ajpp:case:enfant-na")) { origin case_input; }
    }
    evaluate truth(ajpp_droit_ouvert(entity_ref("urn:fr:pf-ajpp:case:enfant-na")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
