// New pathology: a handicap distinct from the opened illness, with
// the medical channel — a new right opens (D. 544-5).
language "law.core" version "0.2";
package fr.pf.ajpp version "0.1.0";
namespace "urn:fr:corpus:clir:pf-ajpp";

test "urn:query:fr-pf-ajpp-nouvelle-pathologie" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "ajpp-np-01": nouvelle_pathologie(entity_ref("urn:fr:pf-ajpp:case:enfant-np"), HANDICAP) { origin case_input; }
        assert "ajpp-np-02": certificat_gravite(entity_ref("urn:fr:pf-ajpp:case:enfant-np")) { origin adjudicated; }
        assert "ajpp-np-03": avis_favorable_controle(entity_ref("urn:fr:pf-ajpp:case:enfant-np")) { origin adjudicated; }
    }
    evaluate truth(droit_nouvelle_pathologie(entity_ref("urn:fr:pf-ajpp:case:enfant-np")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
