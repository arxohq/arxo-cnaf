// 2023 single majoration window: 10 days at the retained increased
// rate 70.00 in March 2023 = 700.00 (L. 544-6 2023-01, six months).
// F05-01: envelope history (120 cumulative days, 1 recorded year).
language "law.core" version "0.2";
package fr.pf.ajpp version "0.1.0";
namespace "urn:fr:corpus:clir:pf-ajpp";

test "urn:query:fr-pf-ajpp-montant-isole-2023" {
    given {
        context { decision_time @2023-03-15T12:00:00Z; knowledge_time @2023-03-15T12:00:00Z; legal_time @2023-03-15; timezone "Europe/Paris"; }
        assert "ajpp-mt23-01": certificat_gravite(entity_ref("urn:fr:pf-ajpp:case:enfant-mt23")) { origin adjudicated; }
        assert "ajpp-mt23-02": avis_favorable_controle(entity_ref("urn:fr:pf-ajpp:case:enfant-mt23")) { origin adjudicated; }
        assert "ajpp-mt23-03": conge_presence_parentale(entity_ref("urn:fr:pf-ajpp:case:parent-mt23"), entity_ref("urn:fr:pf-ajpp:case:enfant-mt23")) { origin case_input; }
        assert "ajpp-mt23-04": jours_ajpp_mois(entity_ref("urn:fr:pf-ajpp:case:enfant-mt23"), @2023-03-01, 10) { origin case_input; }
        assert "ajpp-mt23-05": montant_journalier_majore_retenu(entity_ref("urn:fr:pf-ajpp:case:enfant-mt23"), 70.00 EUR) { origin case_input; }
        assert "ajpp-mt23-06": jours_ajpp_verses(entity_ref("urn:fr:pf-ajpp:case:enfant-mt23"), 120) { origin case_input; }
        assert "ajpp-mt23-07": duree_versement_ajpp(entity_ref("urn:fr:pf-ajpp:case:enfant-mt23"), MALADIE, 1) { origin case_input; }
    }
    evaluate truth(ajpp_montant_mois(entity_ref("urn:fr:pf-ajpp:case:enfant-mt23"), @2023-03-01, 700.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
