// 310-day ceiling met: 300 daily allowances paid, first envelope,
// within the ceiling.
language "law.core" version "0.2";
package fr.pf.ajpp version "0.1.0";
namespace "urn:fr:corpus:clir:pf-ajpp";

test "urn:query:fr-pf-ajpp-plafond-310" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "ajpp-plaf-01": certificat_gravite(entity_ref("urn:fr:pf-ajpp:case:enfant-plaf")) { origin adjudicated; }
        assert "ajpp-plaf-02": avis_favorable_controle(entity_ref("urn:fr:pf-ajpp:case:enfant-plaf")) { origin adjudicated; }
        assert "ajpp-plaf-03": conge_presence_parentale(entity_ref("urn:fr:pf-ajpp:case:parent-plaf"), entity_ref("urn:fr:pf-ajpp:case:enfant-plaf")) { origin case_input; }
        assert "ajpp-plaf-04": jours_ajpp_verses(entity_ref("urn:fr:pf-ajpp:case:enfant-plaf"), 300) { origin case_input; }
    }
    evaluate truth(ajpp_dans_limite(entity_ref("urn:fr:pf-ajpp:case:enfant-plaf")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
