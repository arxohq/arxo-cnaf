// --- Проверка: построенное = опубликованному ----------------------------------

@source(ARR20210927_ART2, ARR20220419_ART2, ARR20220729_ART2, ARR20230426_ART2)
rule SmicConstruitConformePublie(t: Travailleur, construit: Money, publie: Money) strict {
    effective [@2021-10-01, @2024-01-01);
    label fr official "le taux construit par la majoration de l'article 1 coïncide avec le montant publié à l'article 2";
    label ru unofficial "ставка, построенная по проценту ст. 1, совпала с суммой, опубликованной в ст. 2";
    when smic_horaire(t, construit) and smic_horaire_publie(t, publie) and construit == publie;
    then smic_conforme_publie(t);
}
