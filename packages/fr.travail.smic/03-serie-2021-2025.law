// Ряд SMIC 2021–2025 (метрополия+ и Майотта) и minimum garanti — из девяти
// закреплённых актов о relèvement (декреты 2020-1598, 2021-1741, 2022-1608,
// 2023-1216, 2024-951 и arrêtés 27.09.2021, 19.04.2022, 29.07.2022,
// 26.04.2023; байты — глобальный дамп LEGI DILA, см. 01-sources.law).
// Окна подряд, без пропусков: [2021-01-01, 2026-01-01), далее — 02-montants.law.
//
// DECISION-0452 (сначала строит, потом проверяет). Декрет сам называет
// абсолютную ставку (1° и 2° ст. 1) — правило несёт её литералом. Arrêté,
// напротив, в ст. 1 называет не сумму, а ПРОЦЕНТ («le taux du salaire minimum
// de croissance, tel qu'il résulte du décret/de l'arrêté … est majoré de
// X %»), и только ст. 2 пересказывает результат в евро. Поэтому ставка окна
// arrêté СТРОИТСЯ: предыдущая закреплённая ставка (ст. 1 декрета либо ст. 2
// предыдущего arrêté) × (1 + X %), округление до сантима HALF_UP; опубликованная
// сумма ст. 2 попадает в `smic_horaire_publie` и служит ПРОВЕРКОЙ
// (`SmicConstruitConformePublie`), а не подставленным ответом. Все восемь
// построений (4 arrêtés × метрополия+/Майотта) совпали с опубликованными
// суммами до сантима.
//
// 2025 год отдельного акта не имеет: ставка декрета 2024-951 (с 01.11.2024)
// действует до 01.01.2026 (декрет 2025-1228). Дамп LEGI кончается 13.07.2025;
// отсутствие промежуточного акта после этой даты закреплёнными байтами не
// доказано, окно закрыто следующим закреплённым актом (граница в README).

language "law.core" version "0.2";
package fr.travail.smic version "0.1.0";
namespace "urn:fr:corpus:clir:smic";

use self::{
    Travailleur,
    TerritoireSmic,
    territoire_smic,
    smic_horaire,
    smic_horaire_publie,
    smic_conforme_publie,
    minimum_garanti,
    DEC20201598_ART1,
    DEC20201598_ART2,
    ARR20210927_ART1,
    ARR20210927_ART2,
    ARR20210927_ART3,
    DEC20211741_ART1,
    DEC20211741_ART2,
    ARR20220419_ART1,
    ARR20220419_ART2,
    ARR20220419_ART3,
    ARR20220729_ART1,
    ARR20220729_ART2,
    ARR20220729_ART3,
    DEC20221608_ART1,
    DEC20221608_ART2,
    ARR20230426_ART1,
    ARR20230426_ART2,
    ARR20230426_ART3,
    DEC20231216_ART1,
    DEC20231216_ART2,
    DEC20240951_ART1,
    DEC20240951_ART2,
};

// --- 1er janvier 2021: décret DEC20201598 ---

@source(DEC20201598_ART1)
rule SmicHoraireMetropole2021(t: Travailleur) strict {
    effective [@2021-01-01, @2021-10-01);
    label fr official "à compter du 1er janvier 2021, le SMIC est porté à 10,25 euros l'heure (1°)";
    label ru unofficial "с 01.01.2021 SMIC — 10,25 €/ч (метрополия+, 1°)";
    when territoire_smic(t, METROPOLE_ET_DOM);
    then smic_horaire(t, 10.25 EUR);
}

@source(DEC20201598_ART1)
rule SmicHoraireMayotte2021(t: Travailleur) strict {
    effective [@2021-01-01, @2021-10-01);
    label fr official "à compter du 1er janvier 2021, à Mayotte le SMIC est fixé à 7,74 euros l'heure (2°)";
    label ru unofficial "с 01.01.2021 на Майотте SMIC — 7,74 €/ч (2°)";
    when territoire_smic(t, MAYOTTE);
    then smic_horaire(t, 7.74 EUR);
}

@source(DEC20201598_ART2)
rule MinimumGaranti2021(t: Travailleur) strict {
    effective [@2021-01-01, @2021-10-01);
    label fr official "à compter du 1er janvier 2021, le minimum garanti est fixé à 3,65 euros";
    label ru unofficial "с 01.01.2021 минимум garanti — 3,65 €";
    when territoire_smic(t, METROPOLE_ET_DOM) or territoire_smic(t, MAYOTTE);
    then minimum_garanti(t, 3.65 EUR);
}

// --- 1er octobre 2021: arrêté ARR20210927 ---

@source(ARR20210927_ART1, DEC20201598_ART1)
rule SmicHoraireMetropole2021_10(t: Travailleur) strict {
    effective [@2021-10-01, @2022-01-01);
    label fr official "à compter du 1er octobre 2021, le taux du SMIC est majoré de 2,20 % (art. 1) : 10,25 euros × 1.0220, arrondi au centime";
    label ru unofficial "с 01.10.2021 SMIC построен: 10,25 € × 1.0220 (+2,20 %, ст. 1), округление до сантима HALF_UP; опубликованное 10,48 € проверяет SmicConstruitConformePublie";
    when territoire_smic(t, METROPOLE_ET_DOM);
    then smic_horaire(t, round(10.25 EUR * 1.0220, 2, "HALF_UP"));
}

@source(ARR20210927_ART1, DEC20201598_ART1)
rule SmicHoraireMayotte2021_10(t: Travailleur) strict {
    effective [@2021-10-01, @2022-01-01);
