// Arrêtés — majoration en pourcentage (27.09.2021, 19.04.2022, 29.07.2022,
// 26.04.2023): ст. 1 даёт процент, ст. 2 — итог. Ставка СТРОИТСЯ из предыдущей
// закреплённой ставки × (1 + %), округление HALF_UP до сантима (DECISION-0452);
// сумма ст. 2 — проверка (`smic_conforme_publie`). Построение совпало с
// публикацией для метрополии+ и Майотты во всех четырёх arrêtés.
language "law.core" version "0.2";
package fr.travail.smic version "0.1.0";
namespace "urn:fr:corpus:clir:smic";

// 10,25 × 1,0220 = 10,4755 → 10,48; 7,74 × 1,0220 = 7,91028 → 7,91.
test "urn:query:fr-smic-conforme-arr-2021-09-27" {
    given {
        context { decision_time @2021-10-01T12:00:00Z; knowledge_time @2021-10-01T12:00:00Z; legal_time @2021-10-01; timezone "Europe/Paris"; }
        assert "conforme-arr-2021-09-27-01": territoire_smic(entity_ref("urn:fr:smic:case:conforme-arr-2021-09-27:metropole"), METROPOLE_ET_DOM) { origin case_input; }
        assert "conforme-arr-2021-09-27-02": territoire_smic(entity_ref("urn:fr:smic:case:conforme-arr-2021-09-27:mayotte"), MAYOTTE) { origin case_input; }
    }
    evaluate truth(smic_horaire_publie(entity_ref("urn:fr:smic:case:conforme-arr-2021-09-27:metropole"), 10.48 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(smic_conforme_publie(entity_ref("urn:fr:smic:case:conforme-arr-2021-09-27:metropole")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(smic_horaire_publie(entity_ref("urn:fr:smic:case:conforme-arr-2021-09-27:mayotte"), 7.91 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(smic_conforme_publie(entity_ref("urn:fr:smic:case:conforme-arr-2021-09-27:mayotte")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

