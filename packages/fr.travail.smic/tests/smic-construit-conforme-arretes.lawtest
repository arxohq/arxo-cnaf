// Построение — не подстановка: сумма, не совпавшая с построенной ставкой
// (10,47 вместо 10,48 с 01.10.2021), не устанавливается.
test "urn:query:fr-smic-conforme-ecart-2021-10" {
    given {
        context { decision_time @2021-10-01T12:00:00Z; knowledge_time @2021-10-01T12:00:00Z; legal_time @2021-10-01; timezone "Europe/Paris"; }
        assert "conforme-ecart-2021-10-01": territoire_smic(entity_ref("urn:fr:smic:case:conforme-ecart-2021-10"), METROPOLE_ET_DOM) { origin case_input; }
    }
    evaluate truth(smic_horaire(entity_ref("urn:fr:smic:case:conforme-ecart-2021-10"), 10.47 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
