// Границы ряда 2021–2025: последний день ПЕРЕД сменой ставки — ещё прежняя
// ставка (окна полуоткрытые [с, до)). Ожидания — из закреплённых текстов.

language "law.core" version "0.2";
package fr.travail.smic version "0.1.0";
namespace "urn:fr:corpus:clir:smic";


// 2021-09-30 (накануне 2021-10-01): decret-2020-1598.txt (с 2021-01-01).
test "urn:query:fr-smic-veille-2021-10-01" {
    given {
        context { decision_time @2021-09-30T12:00:00Z; knowledge_time @2021-09-30T12:00:00Z; legal_time @2021-09-30; timezone "Europe/Paris"; }
        assert "veille-2021-10-01-01": territoire_smic(entity_ref("urn:fr:smic:case:veille-2021-10-01:metropole"), METROPOLE_ET_DOM) { origin case_input; }
        assert "veille-2021-10-01-02": territoire_smic(entity_ref("urn:fr:smic:case:veille-2021-10-01:mayotte"), MAYOTTE) { origin case_input; }
    }
    evaluate truth(smic_horaire(entity_ref("urn:fr:smic:case:veille-2021-10-01:metropole"), 10.25 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(smic_horaire(entity_ref("urn:fr:smic:case:veille-2021-10-01:mayotte"), 7.74 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(minimum_garanti(entity_ref("urn:fr:smic:case:veille-2021-10-01:metropole"), 3.65 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

