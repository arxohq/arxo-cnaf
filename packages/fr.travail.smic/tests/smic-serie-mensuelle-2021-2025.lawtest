// Ряд SMIC 2021–2025, первое число каждого месяца: метрополия+, Майотта,
// minimum garanti. Ожидания читаются из закреплённых текстов актов
// (tools/gen_serie_tests.py), не набраны руками.

language "law.core" version "0.2";
package fr.travail.smic version "0.1.0";
namespace "urn:fr:corpus:clir:smic";


// 2021-01-01: decret-2020-1598.txt (с 2021-01-01).
test "urn:query:fr-smic-serie-2021-01" {
    given {
        context { decision_time @2021-01-01T12:00:00Z; knowledge_time @2021-01-01T12:00:00Z; legal_time @2021-01-01; timezone "Europe/Paris"; }
        assert "serie-2021-01-01": territoire_smic(entity_ref("urn:fr:smic:case:serie-2021-01:metropole"), METROPOLE_ET_DOM) { origin case_input; }
        assert "serie-2021-01-02": territoire_smic(entity_ref("urn:fr:smic:case:serie-2021-01:mayotte"), MAYOTTE) { origin case_input; }
    }
    evaluate truth(smic_horaire(entity_ref("urn:fr:smic:case:serie-2021-01:metropole"), 10.25 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(smic_horaire(entity_ref("urn:fr:smic:case:serie-2021-01:mayotte"), 7.74 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(minimum_garanti(entity_ref("urn:fr:smic:case:serie-2021-01:metropole"), 3.65 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

