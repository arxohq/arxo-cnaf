@id("urn:fr:corpus:clir:pf-core#CSS_L522_1")
pub fragment CSS_L522_1 in CSS_ED2021_01 {
    kind article;
    locator "article/L522-1";
    text fr official """Article L522-1
Le complément familial est attribué au ménage ou à la personne dont les ressources n'excèdent pas un plafond et qui assume la charge d'un nombre déterminé d'enfants ayant tous un âge supérieur à l'âge limite visé au premier alinéa de l'article L. 531-1.
""";
    content_hash "sha256:3f430e5bbf4c2dfaf3e6796b29b1e72b2f7c175e661b37d29df6d2b1a05d8069";
}

@id("urn:fr:corpus:clir:pf-core#CSS_L522_1_CSS_ED2021_05")
