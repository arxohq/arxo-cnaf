@id("urn:fr:corpus:clir:pf-core#CSS_L513_1")
pub fragment CSS_L513_1 in CSS_ED2021_01 {
    kind article;
    locator "article/L513-1";
    text fr official """Article L513-1
Les prestations familiales sont, sous réserve des règles particulières à chaque prestation, dues à la personne physique qui assume la charge effective et permanente de l'enfant.
""";
    content_hash "sha256:7790724077f5080b1576f6aa8b30d29b7e37bc35f0eadafaab74bfc6fba4d49f";
}

