// Voluntary contributions refused: request made but benefit is housing allowance (no hors-logement fact) - no recovery (L. 553-4 I, PC-R03-03).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-cotisations-logement-exclu" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "cotisations-log-01": parent_charge(entity_ref("urn:fr:pf:case:cotisant-log"), entity_ref("urn:fr:pf:case:enfant-log")) { origin case_input; }
        assert "cotisations-log-02": charge_effective_permanente(entity_ref("urn:fr:pf:case:cotisant-log"), entity_ref("urn:fr:pf:case:enfant-log")) { origin adjudicated; }
        assert "cotisations-log-03": avant_fin_scolarite(entity_ref("urn:fr:pf:case:enfant-log")) { origin case_input; }
        assert "cotisations-log-04": reside_france_stable(entity_ref("urn:fr:pf:case:cotisant-log")) { origin case_input; }
        assert "cotisations-log-05": enfant_reside_france(entity_ref("urn:fr:pf:case:enfant-log")) { origin case_input; }
        assert "cotisations-log-06": organisme_debiteur_pf(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:cotisant-log")) { origin case_input; }
        assert "cotisations-log-07": demande_cotisations_volontaires(entity_ref("urn:fr:pf:case:cotisant-log")) { origin case_input; }
    }
    evaluate positions();
    expect not position(PrelevementCotisationsVolontaires, ACTIVE);
    expect evaluation_status == COMPUTED;
}
