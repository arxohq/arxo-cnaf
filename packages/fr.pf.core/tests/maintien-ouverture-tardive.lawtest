// No maintien when death predates the R. 552-4 gate: right opened 2026-03-01, death 2026-03-10 before the first day of the following month - L. 552-7 does not apply, no maintien endpoint (R. 552-3 IV 1, R. 552-4, PC-R08-07).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-maintien-ouverture-tardive" {
    given {
        context { decision_time @2026-07-15T12:00:00Z; knowledge_time @2026-07-15T12:00:00Z; legal_time @2026-07-15; timezone "Europe/Paris"; deadline_policy SERVICE_MOIS; }
        assert "maintien-ouverture-tardive-01": deces_le(entity_ref("urn:fr:pf:case:enfant-tardive"), @2026-03-10) { origin case_input; }
        assert "maintien-ouverture-tardive-02": deces_enfant_charge(entity_ref("urn:fr:pf:case:enfant-tardive")) { origin case_input; }
        assert "maintien-ouverture-tardive-03": ouverture_droit_mois(entity_ref("urn:fr:pf:case:enfant-tardive"), @2026-03-01) { origin case_input; }
    }
    evaluate truth(maintien_prestations_fin(entity_ref("urn:fr:pf:case:enfant-tardive"), @2026-06-30));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
