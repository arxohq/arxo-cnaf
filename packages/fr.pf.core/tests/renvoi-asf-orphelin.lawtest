// ASF orphan: child orphaned of both parents - ASF entitlement opens (L. 523-1 I 1°).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-renvoi-asf-orphelin" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "renvoi-asf-orphelin-01": asf_cas_orphelin(entity_ref("urn:fr:pf:case:enfant-orphelin")) { origin case_input; }
    }
    evaluate truth(asf_ouvre_droit(entity_ref("urn:fr:pf:case:enfant-orphelin")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
