// CAF subrogation capped: 1500 EUR social-fund advance by a CAF - subrogation as of right up to 1500 EUR (L. 581-9, PC-R07-21).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-creance-subrogation-caf" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "creance-subrogation-caf-01": avance_fonds_sociaux(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:creance-sub")) { origin case_input; }
        assert "creance-subrogation-caf-02": caisse_allocations_familiales(entity_ref("urn:fr:pf:org:caisse-exemple")) { origin case_input; }
        assert "creance-subrogation-caf-03": avance_fonds_sociaux_montant(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:creance-sub"), 1500 EUR) { origin case_input; }
    }
    evaluate truth(subrogation_plein_droit_montant(entity_ref("urn:fr:pf:case:creance-sub"), 1500 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
