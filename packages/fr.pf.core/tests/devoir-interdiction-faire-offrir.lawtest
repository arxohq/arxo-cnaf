// Caused-offer prohibition: convicted intermediary and an allocataire - causing a third party to offer paid services is prohibited (L. 554-2 "fait offrir").
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-devoir-interdiction-faire-offrir" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "devoir-interdiction-faire-offrir-01": intermediaire_convaincu(entity_ref("urn:fr:pf:case:intermediaire-tiers")) { origin case_input; }
        assert "devoir-interdiction-faire-offrir-02": parent_charge(entity_ref("urn:fr:pf:case:demarche-tiers"), entity_ref("urn:fr:pf:case:enfant-demarche-tiers")) { origin case_input; }
        assert "devoir-interdiction-faire-offrir-03": charge_effective_permanente(entity_ref("urn:fr:pf:case:demarche-tiers"), entity_ref("urn:fr:pf:case:enfant-demarche-tiers")) { origin adjudicated; }
        assert "devoir-interdiction-faire-offrir-04": avant_fin_scolarite(entity_ref("urn:fr:pf:case:enfant-demarche-tiers")) { origin case_input; }
        assert "devoir-interdiction-faire-offrir-05": reside_france_stable(entity_ref("urn:fr:pf:case:demarche-tiers")) { origin case_input; }
        assert "devoir-interdiction-faire-offrir-06": enfant_reside_france(entity_ref("urn:fr:pf:case:enfant-demarche-tiers")) { origin case_input; }
    }
    evaluate positions();
    expect position(FaireOffrirServicesRemuneres, ACTIVE);
    expect evaluation_status == COMPUTED;
}
