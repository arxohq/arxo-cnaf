// Unseizable benefits: allocataire with a debtor fund - the immunity position is active (L. 553-4).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-recouvrement-insaisissabilite" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "recouvrement-insaisissabilite-01": parent_charge(entity_ref("urn:fr:pf:case:insaisissable"), entity_ref("urn:fr:pf:case:enfant-insaisissable")) { origin case_input; }
        assert "recouvrement-insaisissabilite-02": charge_effective_permanente(entity_ref("urn:fr:pf:case:insaisissable"), entity_ref("urn:fr:pf:case:enfant-insaisissable")) { origin adjudicated; }
        assert "recouvrement-insaisissabilite-03": avant_fin_scolarite(entity_ref("urn:fr:pf:case:enfant-insaisissable")) { origin case_input; }
        assert "recouvrement-insaisissabilite-04": reside_france_stable(entity_ref("urn:fr:pf:case:insaisissable")) { origin case_input; }
        assert "recouvrement-insaisissabilite-05": enfant_reside_france(entity_ref("urn:fr:pf:case:enfant-insaisissable")) { origin case_input; }
        assert "recouvrement-insaisissabilite-06": organisme_debiteur_pf(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:insaisissable")) { origin case_input; }
    }
    evaluate positions();
    expect position(InsaisissabilitePrestations, ACTIVE);
    expect evaluation_status == COMPUTED;
}
