// Out-of-section bareme (PC-R05-04/05/PC-R06-01): vehicle 12000 EUR with date+amount-bearing evidence but no PAJE/CF/ARS scope - no apport (R. 553-3 chapeau).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-tdv-hors-section-bareme" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "tdv-hors-section-bareme-01": vehicule_bien_valeur(entity_ref("urn:fr:pf:case:hors-section"), entity_ref("urn:fr:pf:case:auto-hs"), 12000.00 EUR, 1.0) { origin case_input; }
        assert "tdv-hors-section-bareme-02": vehicule_bien_date(entity_ref("urn:fr:pf:case:hors-section"), entity_ref("urn:fr:pf:case:auto-hs"), @2026-02-10) { origin case_input; }
        assert "tdv-hors-section-bareme-03": vehicule_bien_preuve_assurance(entity_ref("urn:fr:pf:case:hors-section"), entity_ref("urn:fr:pf:case:auto-hs"), 11500.00 EUR) { origin case_input; }
    }
    evaluate truth(apport_forfaitaire(entity_ref("urn:fr:pf:case:hors-section"), 3000.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
