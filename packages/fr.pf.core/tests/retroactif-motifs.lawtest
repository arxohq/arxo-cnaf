// Retroactivity: late certificate, delay beyond control - retroactive payment possible (L. 552-4 al. 2).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-retroactif-motifs" {
    given {
        context { decision_time @2026-10-01T12:00:00Z; knowledge_time @2026-10-01T12:00:00Z; legal_time @2026-10-01; timezone "Europe/Paris"; }
        assert "retroactif-motifs-01": certificat_inscription_le(entity_ref("urn:fr:pf:case:retard"), entity_ref("urn:fr:pf:case:enfant-retard"), @2026-09-20) { origin case_input; }
        assert "retroactif-motifs-02": retard_independant_volonte(entity_ref("urn:fr:pf:case:retard"), entity_ref("urn:fr:pf:case:enfant-retard")) { origin adjudicated; }
        assert "retroactif-motifs-03": avant_fin_scolarite(entity_ref("urn:fr:pf:case:enfant-retard")) { origin case_input; }
    }
    evaluate truth(versement_retroactif_possible(entity_ref("urn:fr:pf:case:retard"), entity_ref("urn:fr:pf:case:enfant-retard")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
