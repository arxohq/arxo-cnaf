// Procedure information: evaluation contemplated - the fund must inform by registered letter (R. 553-3-4).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-tdv-informer-procedure" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "tdv-informer-procedure-01": organisme_debiteur_pf(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:examine")) { origin case_input; }
        assert "tdv-informer-procedure-02": procedure_train_vie_envisagee(entity_ref("urn:fr:pf:case:examine")) { origin case_input; }
        assert "tdv-informer-procedure-03": prestation_soumise_section(entity_ref("urn:fr:pf:case:examine")) { origin case_input; }
    }
    evaluate positions();
    expect position(InformerProcedureTrainVie, ACTIVE);
    expect evaluation_status == COMPUTED;
}
