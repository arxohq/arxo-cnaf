// No IJ transmission without due allowances: no L. 431-1 2° amount due by the scheme - no communication duty (L. 583-4, PC-R07-26 negative control).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-creance-transmettre-ij-sans-du" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "creance-transmettre-ij-sans-du-01": not ij_l4311_dues(entity_ref("urn:fr:pf:org:regime-maladie"), entity_ref("urn:fr:pf:case:assure-sans-ij"), 800 EUR) { origin case_input; }
    }
    evaluate positions();
    expect not position(TransmettreIndemnitesJournalieres, ACTIVE);
    expect evaluation_status == COMPUTED;
}
