// Reimbursement ends with service: transfer settled 15 April, appreciation 1 May - no reimbursement liberty (R. 552-1, PC-R03-08).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-remboursement-apres-regularisation" {
    given {
        context { decision_time @2026-05-15T12:00:00Z; knowledge_time @2026-05-15T12:00:00Z; legal_time @2026-05-15; timezone "Europe/Paris"; }
        assert "remboursement-apres-01": transfert_regime(entity_ref("urn:fr:pf:case:transfere-remb")) { origin case_input; }
        assert "remboursement-apres-02": regularisation_administrative_le(entity_ref("urn:fr:pf:case:transfere-remb"), @2026-04-15) { origin case_input; }
        assert "remboursement-apres-03": date_appreciation(entity_ref("urn:fr:pf:case:transfere-remb"), @2026-05-01) { origin case_input; }
        assert "remboursement-apres-04": organisme_debiteur_pf(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:transfere-remb")) { origin case_input; }
    }
    evaluate positions();
    expect not position(PoursuivreRemboursementRegime, ACTIVE);
    expect evaluation_status == COMPUTED;
}
