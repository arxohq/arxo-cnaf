// Conforming refusal: motivated refusal notified by registered letter with acknowledgement of receipt - the refusal notice is conforming (R. 553-3-6).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-tdv-refus-conforme" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "tdv-refus-conforme-01": refus_motive_notifie(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:refuse-ar")) { origin case_input; }
        assert "tdv-refus-conforme-02": refus_accuse_reception(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:refuse-ar")) { origin case_input; }
        assert "tdv-refus-conforme-03": prestation_soumise_section(entity_ref("urn:fr:pf:case:refuse-ar")) { origin case_input; }
    }
    evaluate truth(refus_motive_notifie_conforme(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:refuse-ar")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
