// 1985 text: home-schooling certificate produced 5 September 2021 - due from that date (L. 552-4 prev).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-dues-scolarite-prev-famille" {
    given {
        context { decision_time @2022-03-01T12:00:00Z; knowledge_time @2022-03-01T12:00:00Z; legal_time @2022-03-01; timezone "Europe/Paris"; }
        assert "dues-scolarite-prev-famille-01": certificat_instruction_famille_le(entity_ref("urn:fr:pf:case:scolaire-prev"), entity_ref("urn:fr:pf:case:enfant-scolaire-prev"), @2021-09-05) { origin case_input; }
        assert "dues-scolarite-prev-famille-02": avant_fin_scolarite(entity_ref("urn:fr:pf:case:enfant-scolaire-prev")) { origin case_input; }
    }
    evaluate truth(prestations_dues_scolarite(entity_ref("urn:fr:pf:case:scolaire-prev"), entity_ref("urn:fr:pf:case:enfant-scolaire-prev"), @2021-09-05));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
