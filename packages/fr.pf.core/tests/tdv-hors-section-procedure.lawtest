// Out-of-section procedure: evaluation contemplated but no PAJE/CF/ARS scope - no information duty (R. 553-3 chapeau, PC-R03-05).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-tdv-hors-section-procedure" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "tdv-hors-section-procedure-01": organisme_debiteur_pf(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:hors-proc")) { origin case_input; }
        assert "tdv-hors-section-procedure-02": procedure_train_vie_envisagee(entity_ref("urn:fr:pf:case:hors-proc")) { origin case_input; }
    }
    evaluate positions();
    expect not position(InformerProcedureTrainVie, ACTIVE);
    expect evaluation_status == COMPUTED;
}
