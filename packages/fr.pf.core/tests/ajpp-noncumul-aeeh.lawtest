// AJPP non-cumul item 7: AJPP beneficiary receiving the same-child AEEH complement - combination refused (L. 544-9 I 7°, PC-R07-10).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-ajpp-noncumul-aeeh" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "ajpp-noncumul-aeeh-01": beneficie_ajpp(entity_ref("urn:fr:pf:case:ajpp-nc-aeeh")) { origin case_input; }
        assert "ajpp-noncumul-aeeh-02": percoit_complement_aeeh_meme_enfant(entity_ref("urn:fr:pf:case:ajpp-nc-aeeh")) { origin case_input; }
    }
    evaluate truth(cumul_ajpp_refuse(entity_ref("urn:fr:pf:case:ajpp-nc-aeeh")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
