// Competent title issuer by creditor fallback: no allocataire-residence body identified, the body serves the creditor parent's residence - it delivers the title (L. 582-2 « ou, à défaut », PC-R08-05).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-creance-titre-competent-creancier-defaut" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "creance-titre-competent-creancier-defaut-01": titre_organisme_residence_creancier(entity_ref("urn:fr:pf:org:caisse-creancier"), entity_ref("urn:fr:pf:case:creance-defaut")) { origin case_input; }
        assert "creance-titre-competent-creancier-defaut-02": sans_organisme_residence_allocataire(entity_ref("urn:fr:pf:case:creance-defaut")) { origin case_input; }
    }
    evaluate truth(organisme_competent_titre(entity_ref("urn:fr:pf:org:caisse-creancier"), entity_ref("urn:fr:pf:case:creance-defaut")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
