// No contrainte without the notice chain: eligible establishment and registered demand with elapsed month, but no notification and no rejection of observations - no contrainte (L. 553-2-1 al. 2-3, PC-R07-04).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-recouvrement-contrainte-sans-notification" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; deadline_policy RECOUVREMENT_DELAI; }
        assert "recouvrement-contrainte-sans-notification-01": etablissement_service_eligible_l5532_1(entity_ref("urn:fr:pf:case:indu-sans-notif")) { origin case_input; }
        assert "recouvrement-contrainte-sans-notification-02": mise_en_demeure_adressee_le(entity_ref("urn:fr:pf:case:indu-sans-notif"), @2026-01-10) { origin case_input; }
        assert "recouvrement-contrainte-sans-notification-03": mise_en_demeure_sans_effet(entity_ref("urn:fr:pf:case:indu-sans-notif"), @2026-01-10) { origin case_input; }
        assert "recouvrement-contrainte-sans-notification-04": date_appreciation(entity_ref("urn:fr:pf:case:indu-sans-notif"), @2026-03-15) { origin case_input; }
    }
    evaluate truth(contrainte_possible(entity_ref("urn:fr:pf:case:indu-sans-notif")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
