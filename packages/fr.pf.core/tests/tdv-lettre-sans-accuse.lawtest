// Procedure letter without acknowledgement of receipt: all six content items present but no AR - the notice is not conforming (R. 553-3-4, PC-R02-03).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-tdv-lettre-sans-accuse" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "tdv-lettre-sans-accuse-01": lettre_procedure_adressee(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:sans-accuse")) { origin case_input; }
        assert "tdv-lettre-sans-accuse-02": lettre_contenu_procedure(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:sans-accuse")) { origin case_input; }
        assert "tdv-lettre-sans-accuse-03": lettre_contenu_audition_conseil(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:sans-accuse")) { origin case_input; }
        assert "tdv-lettre-sans-accuse-04": lettre_contenu_sanctions(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:sans-accuse")) { origin case_input; }
        assert "tdv-lettre-sans-accuse-05": lettre_contenu_transmission(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:sans-accuse")) { origin case_input; }
        assert "tdv-lettre-sans-accuse-06": lettre_contenu_questionnaire(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:sans-accuse")) { origin case_input; }
        assert "tdv-lettre-sans-accuse-07": lettre_contenu_pieces_l5833(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:sans-accuse")) { origin case_input; }
        assert "tdv-lettre-sans-accuse-08": prestation_soumise_section(entity_ref("urn:fr:pf:case:sans-accuse")) { origin case_input; }
    }
    evaluate truth(lettre_procedure_conforme(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:sans-accuse")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
