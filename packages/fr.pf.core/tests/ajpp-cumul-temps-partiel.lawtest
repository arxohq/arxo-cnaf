// AJPP part-time item-3 exception: concurrent indemnity but partial AJPP with part-time item-3 indemnity and no other item - refusal defeated (L. 544-9 final sentence, PC-R07-10).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-ajpp-cumul-temps-partiel" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "ajpp-cumul-temps-partiel-01": beneficie_ajpp(entity_ref("urn:fr:pf:case:ajpp-tp")) { origin case_input; }
        assert "ajpp-cumul-temps-partiel-02": percoit_indemnite_concurrente(entity_ref("urn:fr:pf:case:ajpp-tp")) { origin case_input; }
        assert "ajpp-cumul-temps-partiel-03": ajpp_cumul_temps_partiel_item3(entity_ref("urn:fr:pf:case:ajpp-tp")) { origin case_input; }
    }
    evaluate truth(cumul_ajpp_refuse(entity_ref("urn:fr:pf:case:ajpp-tp")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
