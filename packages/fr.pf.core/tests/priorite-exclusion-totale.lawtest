// Full priority consumption: same child, listed increase, 500 EUR PF against 300 EUR - increases excluded to zero (L. 553-3 al. 1, PC-R03-02).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-priorite-exclusion-totale" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "priorite-exclusion-totale-01": montant_prestations_familiales(entity_ref("urn:fr:pf:case:priorite-totale"), 500 EUR) { origin case_input; }
        assert "priorite-exclusion-totale-02": montant_majorations_concurrentes(entity_ref("urn:fr:pf:case:priorite-totale"), 300 EUR) { origin case_input; }
        assert "priorite-exclusion-totale-03": meme_enfant_pf_majoration(entity_ref("urn:fr:pf:case:priorite-totale"), entity_ref("urn:fr:pf:case:enfant-totale")) { origin case_input; }
        assert "priorite-exclusion-totale-04": majoration_enumereree_l5533(entity_ref("urn:fr:pf:case:priorite-totale"), entity_ref("urn:fr:pf:case:enfant-totale")) { origin case_input; }
        assert "priorite-exclusion-totale-05": not cumul_logement_handicape_exception(entity_ref("urn:fr:pf:case:priorite-totale"), entity_ref("urn:fr:pf:case:enfant-totale")) { origin case_input; }
        assert "priorite-exclusion-totale-06": not asf_en_cause_l5533(entity_ref("urn:fr:pf:case:priorite-totale"), entity_ref("urn:fr:pf:case:enfant-totale")) { origin case_input; }
    }
    evaluate truth(majorations_reduites(entity_ref("urn:fr:pf:case:priorite-totale"), 0.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
