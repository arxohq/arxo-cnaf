// Vehicle retained insurance-different (PC-R06-01): valeur 12 000 EUR with date, insurance 11 000 EUR same Bien - retained 12 000, apport 3 000 EUR, no forced equality (R. 553-3-1 5 + II 2° a).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-tdv-valeur-retenue-assurance-differente" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "tdv-retenue-assurance-01": vehicule_bien_valeur(entity_ref("urn:fr:pf:case:retenue-assurance"), entity_ref("urn:fr:pf:case:auto-1"), 12000.00 EUR, 1.0) { origin case_input; }
        assert "tdv-retenue-assurance-02": vehicule_bien_date(entity_ref("urn:fr:pf:case:retenue-assurance"), entity_ref("urn:fr:pf:case:auto-1"), @2026-02-10) { origin case_input; }
        assert "tdv-retenue-assurance-03": vehicule_bien_preuve_assurance(entity_ref("urn:fr:pf:case:retenue-assurance"), entity_ref("urn:fr:pf:case:auto-1"), 11000.00 EUR) { origin case_input; }
        assert "tdv-retenue-assurance-04": prestation_soumise_section(entity_ref("urn:fr:pf:case:retenue-assurance")) { origin case_input; }
    }
    evaluate truth(apport_forfaitaire(entity_ref("urn:fr:pf:case:retenue-assurance"), 3000.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
