// Earlier cohort after 2025: PreParE plus a family-complement claim in 2026 - no cumulation under the 2018 text (L. 532-2 I prev, PC-A06).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-cumul-cf-prev-2026" {
    given {
        context { decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; }
        assert "cumul-cf-prev-2026-01": beneficie_prepare(entity_ref("urn:fr:pf:case:prepare-cf-prev-2026"), entity_ref("urn:fr:pf:case:enfant-2024c")) { origin case_input; }
        assert "cumul-cf-prev-2026-02": demande_complement_familial(entity_ref("urn:fr:pf:case:prepare-cf-prev-2026")) { origin case_input; }
        assert "cumul-cf-prev-2026-03": cohorte_avant_2026(entity_ref("urn:fr:pf:case:enfant-2024c")) { origin case_input; }
    }
    evaluate truth(cumul_prepare_cf_refuse(entity_ref("urn:fr:pf:case:prepare-cf-prev-2026"), entity_ref("urn:fr:pf:case:enfant-2024c")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
