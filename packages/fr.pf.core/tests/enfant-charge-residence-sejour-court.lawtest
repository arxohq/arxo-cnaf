// Short stays abroad: two months outside in the year - residence maintained (R. 512-1).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-enfant-charge-residence-sejour-court" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "enfant-charge-residence-sejour-court-01": reside_france_metropolitaine(entity_ref("urn:fr:pf:case:enfant-sejour-court")) { origin case_input; }
        assert "enfant-charge-residence-sejour-court-02": duree_sejours_exterieur_annee(entity_ref("urn:fr:pf:case:enfant-sejour-court"), 2) { origin case_input; }
    }
    evaluate truth(residence_maintenue(entity_ref("urn:fr:pf:case:enfant-sejour-court")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
