// Delegate costs excluded in DOM prime-only multi: several benefits but no eligible non-prime one, prime present - no DOM cost duty (L. 755-4 al. 2-3, PC-R04-05).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-devoir-delegue-frais-prime-plusieurs" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "devoir-delegue-frais-prime-plusieurs-01": delegue_percoit(entity_ref("urn:fr:pf:case:budget-prime-multi")) { origin case_input; }
        assert "devoir-delegue-frais-prime-plusieurs-02": plusieurs_prestations_delegue(entity_ref("urn:fr:pf:case:budget-prime-multi")) { origin case_input; }
        assert "devoir-delegue-frais-prime-plusieurs-03": organisme_montant_le_plus_eleve(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:budget-prime-multi")) { origin case_input; }
        assert "devoir-delegue-frais-prime-plusieurs-04": delegue_percoit_prime_forfaitaire(entity_ref("urn:fr:pf:case:budget-prime-multi")) { origin case_input; }
        assert "devoir-delegue-frais-prime-plusieurs-05": beneficiaire_dom_l7554(entity_ref("urn:fr:pf:case:budget-prime-multi")) { origin case_input; }
    }
    evaluate positions();
    expect not position(SupporterFraisMesure, ACTIVE);
    expect not position(SupporterFraisMesureDOM, ACTIVE);
    expect evaluation_status == COMPUTED;
}
