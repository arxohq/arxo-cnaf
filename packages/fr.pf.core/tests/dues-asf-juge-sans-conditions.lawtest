// ASF judicial claim without conditions: recovery chain complete but opening conditions explicitly unmet - nothing due (R. 552-2 III, PC-R07-29).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-dues-asf-juge-sans-conditions" {
    given {
        context { decision_time @2026-07-15T12:00:00Z; knowledge_time @2026-07-15T12:00:00Z; legal_time @2026-07-15; timezone "Europe/Paris"; deadline_policy SERVICE_MOIS; }
        assert "dues-asf-juge-sans-conditions-01": fixation_judiciaire_apres_recouvrement(entity_ref("urn:fr:pf:case:asf-scond")) { origin case_input; }
        assert "dues-asf-juge-sans-conditions-02": cessation_defaut_mois(entity_ref("urn:fr:pf:case:asf-scond"), @2026-02-01) { origin case_input; }
        assert "dues-asf-juge-sans-conditions-03": plancher_3_mois_demande(entity_ref("urn:fr:pf:case:asf-scond"), @2026-01-01) { origin case_input; }
        assert "dues-asf-juge-sans-conditions-04": not conditions_asf_reunies(entity_ref("urn:fr:pf:case:asf-scond")) { origin case_input; }
    }
    evaluate truth(prestations_dues_a_compter(entity_ref("urn:fr:pf:case:asf-scond"), @2026-03-01));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
