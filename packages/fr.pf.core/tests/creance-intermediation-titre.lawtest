// Intermediation via II title: stable creditor and debtor, not hors d'etat, pension fixed by a 373-2-2 II title - intermediation in place (L. 582-1 I 1°, PC-R07-22).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-creance-intermediation-titre" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "creance-intermediation-titre-01": stabilite_residence_creancier(entity_ref("urn:fr:pf:case:creance-int2")) { origin case_input; }
        assert "creance-intermediation-titre-02": debiteur_stable(entity_ref("urn:fr:pf:case:creance-int2")) { origin case_input; }
        assert "creance-intermediation-titre-03": not debiteur_hors_etat(entity_ref("urn:fr:pf:case:creance-int2")) { origin case_input; }
        assert "creance-intermediation-titre-04": intermediation_titre_3732_2_ii(entity_ref("urn:fr:pf:case:creance-int2")) { origin case_input; }
    }
    evaluate truth(intermediation_mise_en_oeuvre(entity_ref("urn:fr:pf:case:creance-int2")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
