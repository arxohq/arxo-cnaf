// NOTA expected-date cohort: child born in December 2025 but expected from January 2026 - 2026 text applies, no cumulation with the family complement (L. 532-2 I + NOTA).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-cumul-cf-nota-terme" {
    given {
        context { decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; }
        assert "cumul-cf-nota-terme-01": beneficie_prepare(entity_ref("urn:fr:pf:case:prepare-cf-terme"), entity_ref("urn:fr:pf:case:enfant-terme")) { origin case_input; }
        assert "cumul-cf-nota-terme-02": demande_complement_familial(entity_ref("urn:fr:pf:case:prepare-cf-terme")) { origin case_input; }
        assert "cumul-cf-nota-terme-03": cohorte_2026(entity_ref("urn:fr:pf:case:enfant-terme")) { origin case_input; }
    }
    evaluate truth(cumul_prepare_cf_refuse(entity_ref("urn:fr:pf:case:prepare-cf-terme"), entity_ref("urn:fr:pf:case:enfant-terme")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
