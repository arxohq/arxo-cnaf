// Earlier cohort: partial-rate PreParE opening with concurrent indemnities - no cumulation at opening (L. 532-2 III prev).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-cumul-partiel-ouverture-prev" {
    given {
        context { decision_time @2023-06-15T12:00:00Z; knowledge_time @2023-06-15T12:00:00Z; legal_time @2023-06-15; timezone "Europe/Paris"; }
        assert "cumul-partiel-ouverture-prev-01": beneficie_prepare_taux_partiel(entity_ref("urn:fr:pf:case:partiel-prev"), entity_ref("urn:fr:pf:case:enfant-2021")) { origin case_input; }
        assert "cumul-partiel-ouverture-prev-02": prepare_ouverture(entity_ref("urn:fr:pf:case:partiel-prev"), entity_ref("urn:fr:pf:case:enfant-2021")) { origin case_input; }
        assert "cumul-partiel-ouverture-prev-03": indemnites_concurrentes_1_5(entity_ref("urn:fr:pf:case:partiel-prev")) { origin case_input; }
        assert "cumul-partiel-ouverture-prev-04": cohorte_avant_2026(entity_ref("urn:fr:pf:case:enfant-2021")) { origin case_input; }
    }
    evaluate truth(cumul_prepare_partiel_ouverture_refuse(entity_ref("urn:fr:pf:case:partiel-prev"), entity_ref("urn:fr:pf:case:enfant-2021")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
