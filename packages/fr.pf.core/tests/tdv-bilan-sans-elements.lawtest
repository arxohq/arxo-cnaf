// National review without elements: bilan transmitted to the minister but the evaluation elements not carried over - the bilan is not conforming (R. 553-3-7 al. 2, PC-R02-05).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-tdv-bilan-sans-elements" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "tdv-bilan-sans-elements-01": bilan_transmis_ministre(entity_ref("urn:fr:pf:org:cnaf"), entity_ref("urn:fr:pf:org:ministre")) { origin case_input; }
    }
    evaluate truth(bilan_ministre_conforme(entity_ref("urn:fr:pf:org:cnaf"), entity_ref("urn:fr:pf:org:ministre")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
