// Suspension on refused checks: allocataire refusing L. 583-3 checks - the fund may suspend payment.
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-devoir-suspension-controle" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "devoir-suspension-controle-01": parent_charge(entity_ref("urn:fr:pf:case:controle-refuse"), entity_ref("urn:fr:pf:case:enfant-controle")) { origin case_input; }
        assert "devoir-suspension-controle-02": charge_effective_permanente(entity_ref("urn:fr:pf:case:controle-refuse"), entity_ref("urn:fr:pf:case:enfant-controle")) { origin adjudicated; }
        assert "devoir-suspension-controle-03": avant_fin_scolarite(entity_ref("urn:fr:pf:case:enfant-controle")) { origin case_input; }
        assert "devoir-suspension-controle-04": reside_france_stable(entity_ref("urn:fr:pf:case:controle-refuse")) { origin case_input; }
        assert "devoir-suspension-controle-05": enfant_reside_france(entity_ref("urn:fr:pf:case:enfant-controle")) { origin case_input; }
        assert "devoir-suspension-controle-06": organisme_debiteur_pf(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:controle-refuse")) { origin case_input; }
        assert "devoir-suspension-controle-07": controle_refuse(entity_ref("urn:fr:pf:case:controle-refuse")) { origin case_input; }
    }
    evaluate positions();
    expect position(SuspendreVersementControle, ACTIVE);
    expect evaluation_status == COMPUTED;
}
