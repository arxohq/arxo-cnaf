// No transmission duty without a new agreement: change modifying the L. 523-1 I 4° right but explicitly no new agreement concluded - no transmission duty (L. 582-2, PC-R08-04).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-creance-nouvel-accord-sans-accord" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "creance-nouvel-accord-sans-accord-01": changement_modifie_droit_l5231_4(entity_ref("urn:fr:pf:case:creance-saccord")) { origin case_input; }
        assert "creance-nouvel-accord-sans-accord-02": not nouvel_accord_parents_conclu(entity_ref("urn:fr:pf:case:creance-saccord")) { origin case_input; }
        assert "creance-nouvel-accord-sans-accord-03": organisme_debiteur_pf(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:creance-saccord")) { origin case_input; }
    }
    evaluate positions();
    expect not position(TransmettreNouvelAccordContribution, ACTIVE);
    expect evaluation_status == COMPUTED;
}
