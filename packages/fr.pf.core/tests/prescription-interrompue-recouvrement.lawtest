// Interrupted limitation: recovery procedure running - the two-year clock does not run out (L. 553-1 paragraph 3).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-prescription-interrompue-recouvrement" {
    given {
        context { decision_time @2025-01-01T12:00:00Z; knowledge_time @2025-01-01T12:00:00Z; legal_time @2025-01-01; timezone "Europe/Paris"; deadline_policy PRESCRIPTION_ANNEES; }
        assert "prescription-interrompue-recouvrement-01": creance_exigible_le(entity_ref("urn:fr:pf:case:prescription-interrompue"), @2022-01-01) { origin case_input; }
        assert "prescription-interrompue-recouvrement-02": date_appreciation(entity_ref("urn:fr:pf:case:prescription-interrompue"), @2025-01-01) { origin case_input; }
        assert "prescription-interrompue-recouvrement-03": procedure_recouvrement_indu_en_cours(entity_ref("urn:fr:pf:case:prescription-interrompue")) { origin case_input; }
    }
    evaluate truth(action_prescrite(entity_ref("urn:fr:pf:case:prescription-interrompue")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
