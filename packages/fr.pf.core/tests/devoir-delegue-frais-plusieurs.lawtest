// Delegate costs, several benefits: the fund pays the highest amount among the delegate-received benefits - the fund bears the costs (L. 552-6 al. 2).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-devoir-delegue-frais-plusieurs" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "devoir-delegue-frais-plusieurs-01": delegue_percoit(entity_ref("urn:fr:pf:case:budget-multi")) { origin case_input; }
        assert "devoir-delegue-frais-plusieurs-02": plusieurs_prestations_delegue(entity_ref("urn:fr:pf:case:budget-multi")) { origin case_input; }
        assert "devoir-delegue-frais-plusieurs-03": organisme_montant_le_plus_eleve(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:budget-multi")) { origin case_input; }
        assert "devoir-delegue-frais-plusieurs-04": not prestation_delegue_unique(entity_ref("urn:fr:pf:case:budget-multi")) { origin case_input; }
        assert "devoir-delegue-frais-plusieurs-05": not beneficiaire_dom_l7554(entity_ref("urn:fr:pf:case:budget-multi")) { origin case_input; }
    }
    evaluate positions();
    expect position(SupporterFraisMesure, ACTIVE);
    expect evaluation_status == COMPUTED;
}
