// Refusal without acknowledgement of receipt: motivated refusal notified but no AR - the refusal notice is not conforming (R. 553-3-6, PC-R02-04).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-tdv-refus-sans-accuse" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "tdv-refus-sans-accuse-01": refus_motive_notifie(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:refuse-sans-ar")) { origin case_input; }
        assert "tdv-refus-sans-accuse-02": prestation_soumise_section(entity_ref("urn:fr:pf:case:refuse-sans-ar")) { origin case_input; }
    }
    evaluate truth(refus_motive_notifie_conforme(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:refuse-sans-ar")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
