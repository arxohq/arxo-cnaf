// Intermediation ends on a notified new title: full II-title chain, new title notified suppressing the pension or ending intermediation - status removed (L. 582-1 VII 3°, PC-R08-08).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-creance-intermediation-nouveau-titre" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "creance-intermediation-nouveau-titre-01": stabilite_residence_creancier(entity_ref("urn:fr:pf:case:creance-ntitre")) { origin case_input; }
        assert "creance-intermediation-nouveau-titre-02": debiteur_stable(entity_ref("urn:fr:pf:case:creance-ntitre")) { origin case_input; }
        assert "creance-intermediation-nouveau-titre-03": not debiteur_hors_etat(entity_ref("urn:fr:pf:case:creance-ntitre")) { origin case_input; }
        assert "creance-intermediation-nouveau-titre-04": intermediation_titre_3732_2_ii(entity_ref("urn:fr:pf:case:creance-ntitre")) { origin case_input; }
        assert "creance-intermediation-nouveau-titre-05": nouveau_titre_notifie_fin_pension_ou_intermediation(entity_ref("urn:fr:pf:case:creance-ntitre")) { origin case_input; }
    }
    evaluate truth(intermediation_mise_en_oeuvre(entity_ref("urn:fr:pf:case:creance-ntitre")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
