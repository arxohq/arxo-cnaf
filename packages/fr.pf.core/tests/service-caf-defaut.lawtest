// Debtor body default: plain allocataire - service falls on the CAF of residence (R. 514-1).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-service-caf-defaut" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "service-caf-defaut-01": parent_charge(entity_ref("urn:fr:pf:case:rattache"), entity_ref("urn:fr:pf:case:enfant-rattache")) { origin case_input; }
        assert "service-caf-defaut-02": charge_effective_permanente(entity_ref("urn:fr:pf:case:rattache"), entity_ref("urn:fr:pf:case:enfant-rattache")) { origin adjudicated; }
        assert "service-caf-defaut-03": avant_fin_scolarite(entity_ref("urn:fr:pf:case:enfant-rattache")) { origin case_input; }
        assert "service-caf-defaut-04": reside_france_stable(entity_ref("urn:fr:pf:case:rattache")) { origin case_input; }
        assert "service-caf-defaut-05": enfant_reside_france(entity_ref("urn:fr:pf:case:enfant-rattache")) { origin case_input; }
    }
    evaluate truth(service_caf_residence(entity_ref("urn:fr:pf:case:rattache")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
