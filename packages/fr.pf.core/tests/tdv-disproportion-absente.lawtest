// No disproportion: schedule 44 000 below twice the ceiling plus excluded 45 000 (R. 553-3-5).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-tdv-disproportion-absente" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "tdv-disproportion-absente-01": evaluation_forfaitaire_train_vie(entity_ref("urn:fr:pf:case:proportion"), 44000.00 EUR) { origin case_input; }
        assert "tdv-disproportion-absente-02": plafond_prestation(entity_ref("urn:fr:pf:case:proportion"), 20000.00 EUR) { origin case_input; }
        assert "tdv-disproportion-absente-03": revenus_exclus_evaluation(entity_ref("urn:fr:pf:case:proportion"), 5000.00 EUR) { origin case_input; }
        assert "tdv-disproportion-absente-04": prestation_soumise_section(entity_ref("urn:fr:pf:case:proportion")) { origin case_input; }
    }
    evaluate truth(disproportion_reglementaire_constatee(entity_ref("urn:fr:pf:case:proportion")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
