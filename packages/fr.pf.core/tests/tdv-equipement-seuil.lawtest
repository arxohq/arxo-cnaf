// Equipment band (PC-R05-05): spending 1 500 EUR, household/period, full private - apport 1 200 EUR (R. 553-3-1 6).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-tdv-equipement-seuil" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "tdv-equipement-seuil-01": depenses_equipement(entity_ref("urn:fr:pf:case:equipe"), 1500.00 EUR, 1.0) { origin case_input; }
        assert "tdv-equipement-seuil-02": prestation_soumise_section(entity_ref("urn:fr:pf:case:equipe")) { origin case_input; }
        assert "tdv-equipement-seuil-03": depenses_foyer_periode_reference(entity_ref("urn:fr:pf:case:equipe")) { origin case_input; }
    }
    evaluate truth(apport_forfaitaire(entity_ref("urn:fr:pf:case:equipe"), 1200.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
