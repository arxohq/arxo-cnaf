// Schooling piece: enrolment certificate produced 5 September 2026 - due from that date (L. 552-4).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-dues-scolarite-inscription" {
    given {
        context { decision_time @2026-10-01T12:00:00Z; knowledge_time @2026-10-01T12:00:00Z; legal_time @2026-10-01; timezone "Europe/Paris"; }
        assert "dues-scolarite-inscription-01": certificat_inscription_le(entity_ref("urn:fr:pf:case:scolaire"), entity_ref("urn:fr:pf:case:enfant-scolaire"), @2026-09-05) { origin case_input; }
        assert "dues-scolarite-inscription-02": avant_fin_scolarite(entity_ref("urn:fr:pf:case:enfant-scolaire")) { origin case_input; }
    }
    evaluate truth(prestations_dues_scolarite(entity_ref("urn:fr:pf:case:scolaire"), entity_ref("urn:fr:pf:case:enfant-scolaire"), @2026-09-05));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
