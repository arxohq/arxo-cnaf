// PreParE single child: due from the first day of the conditions month itself (R. 552-2 II 1).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-dues-prepare-meme-mois" {
    given {
        context { decision_time @2026-04-15T12:00:00Z; knowledge_time @2026-04-15T12:00:00Z; legal_time @2026-04-15; timezone "Europe/Paris"; deadline_policy SERVICE_MOIS; }
        assert "dues-prepare-meme-mois-01": conditions_reunies_mois(entity_ref("urn:fr:pf:case:prepare"), @2026-03-01) { origin case_input; }
        assert "dues-prepare-meme-mois-02": prepare_enfant_unique_ou_option(entity_ref("urn:fr:pf:case:prepare")) { origin case_input; }
    }
    evaluate truth(prestations_dues_a_compter(entity_ref("urn:fr:pf:case:prepare"), @2026-03-01));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
