// Enforceable title full chain: joint request by separating parents, no claim and no steps attested, threshold and information - title issued (L. 582-2 al. 1, 1°-3°, PC-R07-23).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-creance-titre-executoire" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "creance-titre-executoire-01": demande_conjointe_parents_separes(entity_ref("urn:fr:pf:case:creance-titre")) { origin case_input; }
        assert "creance-titre-executoire-02": attestation_absence_creance(entity_ref("urn:fr:pf:case:creance-titre")) { origin case_input; }
        assert "creance-titre-executoire-03": attestation_absence_demarche(entity_ref("urn:fr:pf:case:creance-titre")) { origin case_input; }
        assert "creance-titre-executoire-04": contribution_seuil_atteint(entity_ref("urn:fr:pf:case:creance-titre")) { origin case_input; }
        assert "creance-titre-executoire-05": infos_contribution_precisees(entity_ref("urn:fr:pf:case:creance-titre")) { origin case_input; }
    }
    evaluate truth(titre_executoire_delivre(entity_ref("urn:fr:pf:case:creance-titre")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
