// Cohort gate: PreParE plus a family-complement claim with no cohort fact - neither text fires (L. 532-2 I, cohort gating).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-cumul-sans-cohorte" {
    given {
        context { decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; }
        assert "cumul-sans-cohorte-01": beneficie_prepare(entity_ref("urn:fr:pf:case:prepare-sans-cohorte"), entity_ref("urn:fr:pf:case:enfant-sans-cohorte")) { origin case_input; }
        assert "cumul-sans-cohorte-02": demande_complement_familial(entity_ref("urn:fr:pf:case:prepare-sans-cohorte")) { origin case_input; }
    }
    evaluate truth(cumul_prepare_cf_refuse(entity_ref("urn:fr:pf:case:prepare-sans-cohorte"), entity_ref("urn:fr:pf:case:enfant-sans-cohorte")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
