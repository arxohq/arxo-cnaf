// No schooling piece: nothing produced - no benefit may be paid (L. 552-4 al. 2).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-versement-bloque-sans-piece" {
    given {
        context { decision_time @2026-10-01T12:00:00Z; knowledge_time @2026-10-01T12:00:00Z; legal_time @2026-10-01; timezone "Europe/Paris"; }
        assert "versement-bloque-sans-piece-01": pieces_scolarite_absentes(entity_ref("urn:fr:pf:case:sans-piece"), entity_ref("urn:fr:pf:case:enfant-sans-piece")) { origin case_input; }
        assert "versement-bloque-sans-piece-02": avant_fin_scolarite(entity_ref("urn:fr:pf:case:enfant-sans-piece")) { origin case_input; }
    }
    evaluate truth(versement_bloque_pieces(entity_ref("urn:fr:pf:case:sans-piece"), entity_ref("urn:fr:pf:case:enfant-sans-piece")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
