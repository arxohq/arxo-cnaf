// Earlier cohort, 2024 evaluation: full-rate PreParE plus a concurrent 2018-listed indemnity - no cumulation under the 2018 text (L. 532-2 II prev).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-cumul-indemnite-prev" {
    given {
        context { decision_time @2024-06-15T12:00:00Z; knowledge_time @2024-06-15T12:00:00Z; legal_time @2024-06-15; timezone "Europe/Paris"; }
        assert "cumul-indemnite-prev-01": beneficie_prepare_taux_plein(entity_ref("urn:fr:pf:case:prepare-ind-prev"), entity_ref("urn:fr:pf:case:enfant-2022")) { origin case_input; }
        assert "cumul-indemnite-prev-02": percoit_indemnite_concurrente(entity_ref("urn:fr:pf:case:prepare-ind-prev")) { origin case_input; }
        assert "cumul-indemnite-prev-03": cohorte_avant_2026(entity_ref("urn:fr:pf:case:enfant-2022")) { origin case_input; }
    }
    evaluate truth(cumul_prepare_indemnite_refuse(entity_ref("urn:fr:pf:case:prepare-ind-prev")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
