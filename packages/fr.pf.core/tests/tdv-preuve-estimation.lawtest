// Vehicle evidence estimate (PC-R05-04/PC-R06-01): one vehicle with amount-bearing professional estimate - justified (R. 553-3-1 II 2° b).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-tdv-preuve-estimation" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "tdv-preuve-estimation-01": prestation_soumise_section(entity_ref("urn:fr:pf:case:preuve-estimation")) { origin case_input; }
        assert "tdv-preuve-estimation-02": vehicule_bien_preuve_estimation(entity_ref("urn:fr:pf:case:preuve-estimation"), entity_ref("urn:fr:pf:case:auto-1"), 11800.00 EUR) { origin case_input; }
    }
    evaluate truth(vehicule_bien_justifie(entity_ref("urn:fr:pf:case:preuve-estimation"), entity_ref("urn:fr:pf:case:auto-1")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
