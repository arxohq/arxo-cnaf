// Justified long stay: studies abroad under the joint arretee - residence maintained (R. 512-1 2°-3°).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-enfant-charge-residence-sejour-long" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "enfant-charge-residence-sejour-long-01": reside_france_metropolitaine(entity_ref("urn:fr:pf:case:enfant-sejour-long")) { origin case_input; }
        assert "enfant-charge-residence-sejour-long-02": sejour_justifie_arrete(entity_ref("urn:fr:pf:case:enfant-sejour-long")) { origin case_input; }
    }
    evaluate truth(residence_maintenue(entity_ref("urn:fr:pf:case:enfant-sejour-long")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
