// Exceptional circumstances: no-entitlement evaluation but exceptional circumstances found - grant kept (R. 553-3-6).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-tdv-circonstances" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "tdv-circonstances-01": evaluation_sans_droit(entity_ref("urn:fr:pf:case:exceptionnel")) { origin case_input; }
        assert "tdv-circonstances-02": circonstances_exceptionnelles(entity_ref("urn:fr:pf:case:exceptionnel")) { origin adjudicated; }
        assert "tdv-circonstances-03": prestation_soumise_section(entity_ref("urn:fr:pf:case:exceptionnel")) { origin case_input; }
    }
    evaluate truth(attribution_maintenue_exceptionnelle(entity_ref("urn:fr:pf:case:exceptionnel")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
