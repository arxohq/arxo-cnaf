// Maintien applicability: opened January, death 10 March - L. 552-7 applies (R. 552-4).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-maintien-ouverture-condition" {
    given {
        context { decision_time @2026-07-15T12:00:00Z; knowledge_time @2026-07-15T12:00:00Z; legal_time @2026-07-15; timezone "Europe/Paris"; deadline_policy SERVICE_MOIS; }
        assert "maintien-ouverture-condition-01": ouverture_droit_mois(entity_ref("urn:fr:pf:case:enfant-decede"), @2026-01-01) { origin case_input; }
        assert "maintien-ouverture-condition-02": deces_le(entity_ref("urn:fr:pf:case:enfant-decede"), @2026-03-10) { origin case_input; }
    }
    evaluate truth(maintien_applicable(entity_ref("urn:fr:pf:case:enfant-decede")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
