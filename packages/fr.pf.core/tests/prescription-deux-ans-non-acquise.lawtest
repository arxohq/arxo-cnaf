// Two-year limitation not yet acquired: claim due 2022-06-01 assessed 2024-05-31 - action alive (L. 553-1).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-prescription-deux-ans-non-acquise" {
    given {
        context { decision_time @2024-05-31T12:00:00Z; knowledge_time @2024-05-31T12:00:00Z; legal_time @2024-05-31; timezone "Europe/Paris"; deadline_policy PRESCRIPTION_ANNEES; }
        assert "prescription-deux-ans-non-acquise-01": creance_exigible_le(entity_ref("urn:fr:pf:case:prescription-2ans-nok"), @2022-06-01) { origin case_input; }
        assert "prescription-deux-ans-non-acquise-02": date_appreciation(entity_ref("urn:fr:pf:case:prescription-2ans-nok"), @2024-05-31) { origin case_input; }
    }
    evaluate truth(action_prescrite(entity_ref("urn:fr:pf:case:prescription-2ans-nok")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
