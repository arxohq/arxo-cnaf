language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

// Generated witness scenarios of the question catalog (DECISION-0190):
// the world fulfils the rule premises, the query asks its conclusion.
// Built by corpus/tools/questions_catalog/build_catalog.py from the package CLIR;
// hand edits — only together with the catalog.

// 
// D-42: witness world completed by hand - rule ForfaitDecesEligible (09a) requires
// deces_enfant_avant_limite_age (L. 545-1 decree age limit) since generation; card and test id unchanged.
test "CATALOG-FORFAITDECESELIGIBLE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": forfait_deces_demande(entity_ref("urn:law:catalog:forfaitdeceseligible:v0"), entity_ref("urn:law:catalog:forfaitdeceseligible:v1")) { origin case_input; }
        assert "cat-1": charge_effective_permanente(entity_ref("urn:law:catalog:forfaitdeceseligible:v0"), entity_ref("urn:law:catalog:forfaitdeceseligible:v1")) { origin case_input; }
        assert "cat-2": deces_enfant_avant_limite_age(entity_ref("urn:law:catalog:forfaitdeceseligible:v1")) { origin case_input; }
    }
    evaluate truth(forfait_deces_eligible(entity_ref("urn:law:catalog:forfaitdeceseligible:v0"), entity_ref("urn:law:catalog:forfaitdeceseligible:v1")));
    expect truth_status == TRUE_ONLY;
}
