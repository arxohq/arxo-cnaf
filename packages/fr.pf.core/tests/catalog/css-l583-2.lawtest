language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

// Generated witness scenarios of the question catalog (DECISION-0190):
// the world fulfils the rule premises, the query asks its conclusion.
// Built by corpus/tools/questions_catalog/build_catalog.py from the package CLIR;
// hand edits — only together with the catalog.

// 
// D-42: witness world completed by hand - rule AvanceFondsSociaux (09b) requires the solicited benefit,
// reimbursement from legal-benefit funds and established rights (L. 583-2); card and test id unchanged.
test "CATALOG-AVANCEFONDSSOCIAUX" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": allocataire(entity_ref("urn:law:catalog:avancefondssociaux:v1")) { origin case_input; }
        assert "cat-1": organisme_debiteur_pf(entity_ref("urn:law:catalog:avancefondssociaux:v0"), entity_ref("urn:law:catalog:avancefondssociaux:v1")) { origin case_input; }
        assert "cat-2": prestation_sollicitee_merites_evaluables(entity_ref("urn:law:catalog:avancefondssociaux:v1")) { origin case_input; }
        assert "cat-3": avance_remboursable_fonds_legaux(entity_ref("urn:law:catalog:avancefondssociaux:v0"), entity_ref("urn:law:catalog:avancefondssociaux:v1")) { origin case_input; }
        assert "cat-4": droits_etablis_existant(entity_ref("urn:law:catalog:avancefondssociaux:v1")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(AccorderAvanceFondsSociaux, ACTIVE);
}
