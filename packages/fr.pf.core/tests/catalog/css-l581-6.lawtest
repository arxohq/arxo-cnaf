test "CATALOG-AIDERECOUVREMENTSANSASF" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": creance_alimentaire_titre(entity_ref("urn:law:catalog:aiderecouvrementsansasf:v0")) { origin case_input; }
        assert "cat-1": creance_enfant_avant_limite_age(entity_ref("urn:law:catalog:aiderecouvrementsansasf:v0")) { origin case_input; }
        assert "cat-2": conditions_asf_non_remplies(entity_ref("urn:law:catalog:aiderecouvrementsansasf:v0")) { origin case_input; }
        assert "cat-3": aide_recouvrement_demandee(entity_ref("urn:law:catalog:aiderecouvrementsansasf:v0")) { origin case_input; }
    }
    evaluate truth(aide_recouvrement_accordee(entity_ref("urn:law:catalog:aiderecouvrementsansasf:v0")));
    expect truth_status == TRUE_ONLY;
