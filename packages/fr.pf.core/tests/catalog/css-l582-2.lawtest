        assert "cat-2": infos_contribution_precisees(entity_ref("urn:law:catalog:titreexecutoiredelivre:v0")) { origin case_input; }
        assert "cat-3": demande_conjointe_parents_separes(entity_ref("urn:law:catalog:titreexecutoiredelivre:v0")) { origin case_input; }
        assert "cat-4": attestation_absence_demarche(entity_ref("urn:law:catalog:titreexecutoiredelivre:v0")) { origin case_input; }
