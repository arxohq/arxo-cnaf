language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

// Generated witness scenarios of the question catalog (DECISION-0190):
// the world fulfils the rule premises, the query asks its conclusion.
// Built by corpus/tools/questions_catalog/build_catalog.py from the package CLIR;
// hand edits — only together with the catalog.

// 
// D-42: witness world rebuilt by hand - rule DevoirTransmettreContribution (09b) binds the title-issuing
// body (v0), the competent tax administration (v1), the person (v2) and the agreement amount
// (L. 583-5); the rule does not read organisme_debiteur_pf. Card and test id unchanged.
test "CATALOG-DEVOIRTRANSMETTRECONTRIBUTION" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": titre_delivre_par_organisme_competent(entity_ref("urn:law:catalog:devoirtransmettrecontribution:v0"), entity_ref("urn:law:catalog:devoirtransmettrecontribution:v2")) { origin case_input; }
        assert "cat-1": administration_fiscale_competente(entity_ref("urn:law:catalog:devoirtransmettrecontribution:v1"), entity_ref("urn:law:catalog:devoirtransmettrecontribution:v2")) { origin case_input; }
        assert "cat-2": accord_parents_contribution_montant(entity_ref("urn:law:catalog:devoirtransmettrecontribution:v2"), 350 EUR) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(TransmettreContributionFisc, ACTIVE);
}
