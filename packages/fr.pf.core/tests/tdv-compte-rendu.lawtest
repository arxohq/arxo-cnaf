// Reporting chain: evaluation carried out - the fund must report to the national body (R. 553-3-7).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-tdv-compte-rendu" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "tdv-compte-rendu-01": organisme_debiteur_pf(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:evalue")) { origin case_input; }
        assert "tdv-compte-rendu-02": evaluation_effectuee(entity_ref("urn:fr:pf:case:evalue")) { origin case_input; }
        assert "tdv-compte-rendu-03": releve_organisme_national(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:org:cnaf")) { origin case_input; }
        assert "tdv-compte-rendu-04": prestation_soumise_section(entity_ref("urn:fr:pf:case:evalue")) { origin case_input; }
    }
    evaluate positions();
    expect position(RendreCompteEvaluation, ACTIVE);
    expect evaluation_status == COMPUTED;
}
