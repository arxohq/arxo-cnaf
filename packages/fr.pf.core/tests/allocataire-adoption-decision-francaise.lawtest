// Adoption by French decision: the L. 512-4 1° condition holds (L. 512-4).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-allocataire-adoption-decision-francaise" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "allocataire-adoption-decision-francaise-01": adoption_decision_francaise(entity_ref("urn:fr:pf:case:enfant-adopte")) { origin case_input; }
    }
    evaluate truth(adoption_conforme(entity_ref("urn:fr:pf:case:enfant-adopte")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
