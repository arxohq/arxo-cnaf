// Conforming local report with a false-statement sanction: timely reply, refusal direction, evaluated items and a 300 EUR false-statement sanction - the report is conforming (R. 553-3-7 1/2/4).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-tdv-compte-rendu-sanction-fausse-declaration" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "tdv-compte-rendu-sanction-fausse-declaration-01": compte_rendu_transmis(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:org:cnaf")) { origin case_input; }
        assert "tdv-compte-rendu-sanction-fausse-declaration-02": compte_rendu_transmis_sans_delai(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:org:cnaf")) { origin case_input; }
        assert "tdv-compte-rendu-sanction-fausse-declaration-03": compte_rendu_anonymise(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:evalue-fausse")) { origin case_input; }
        assert "tdv-compte-rendu-sanction-fausse-declaration-04": compte_rendu_reponse_dans_delai(entity_ref("urn:fr:pf:case:evalue-fausse")) { origin case_input; }
        assert "tdv-compte-rendu-sanction-fausse-declaration-05": compte_rendu_decision_refus(entity_ref("urn:fr:pf:case:evalue-fausse")) { origin case_input; }
        assert "tdv-compte-rendu-sanction-fausse-declaration-06": compte_rendu_elements_evalues(entity_ref("urn:fr:pf:case:evalue-fausse")) { origin case_input; }
        assert "tdv-compte-rendu-sanction-fausse-declaration-07": compte_rendu_sanction_fausse_declaration(entity_ref("urn:fr:pf:case:evalue-fausse"), 300.00 EUR) { origin case_input; }
        assert "tdv-compte-rendu-sanction-fausse-declaration-08": prestation_soumise_section(entity_ref("urn:fr:pf:case:evalue-fausse")) { origin case_input; }
    }
    evaluate truth(compte_rendu_evaluation_conforme(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:org:cnaf"), entity_ref("urn:fr:pf:case:evalue-fausse")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
