// Intermediation ends on joint request with consent: full II-title chain, one parent's request plus the other's consent, explicitly no alleged violence - status removed (L. 582-1 VII 4°, PC-R08-08).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-creance-intermediation-demande-conjointe" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "creance-intermediation-demande-conjointe-01": stabilite_residence_creancier(entity_ref("urn:fr:pf:case:creance-dconjointe")) { origin case_input; }
        assert "creance-intermediation-demande-conjointe-02": debiteur_stable(entity_ref("urn:fr:pf:case:creance-dconjointe")) { origin case_input; }
        assert "creance-intermediation-demande-conjointe-03": not debiteur_hors_etat(entity_ref("urn:fr:pf:case:creance-dconjointe")) { origin case_input; }
        assert "creance-intermediation-demande-conjointe-04": intermediation_titre_3732_2_ii(entity_ref("urn:fr:pf:case:creance-dconjointe")) { origin case_input; }
        assert "creance-intermediation-demande-conjointe-05": demande_fin_intermediation_conjointe(entity_ref("urn:fr:pf:case:creance-dconjointe")) { origin case_input; }
        assert "creance-intermediation-demande-conjointe-06": consentement_autre_parent_fin(entity_ref("urn:fr:pf:case:creance-dconjointe")) { origin case_input; }
        assert "creance-intermediation-demande-conjointe-07": not violences_alleguees_procedure_37322(entity_ref("urn:fr:pf:case:creance-dconjointe")) { origin case_input; }
    }
    evaluate truth(intermediation_mise_en_oeuvre(entity_ref("urn:fr:pf:case:creance-dconjointe")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
