// Judgment alone insufficient in section: PAJE scope and organ judgment but no schedule/threshold facts - no forfait (L. 553-5 via R. 553-3-5, PC-R03-04).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-forfait-jugement-section-insuffisant" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "forfait-insuffisant-01": prestation_soumise_section(entity_ref("urn:fr:pf:case:forfait-insuff")) { origin case_input; }
        assert "forfait-insuffisant-02": disproportion_train_de_vie(entity_ref("urn:fr:pf:case:forfait-insuff")) { origin case_input; }
    }
    evaluate truth(evaluation_forfaitaire_possible(entity_ref("urn:fr:pf:case:forfait-insuff")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
