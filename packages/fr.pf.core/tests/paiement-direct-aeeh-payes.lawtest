// No direct AEEH payment: education entity bears charge but costs are paid (no unpaid fact) - no direct-payment liberty (L. 553-4 I 2, PC-R03-03).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-paiement-direct-aeeh-payes" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "paiement-direct-payes-01": parent_charge(entity_ref("urn:fr:pf:case:direct-payes"), entity_ref("urn:fr:pf:case:enfant-payes")) { origin case_input; }
        assert "paiement-direct-payes-02": charge_effective_permanente(entity_ref("urn:fr:pf:case:direct-payes"), entity_ref("urn:fr:pf:case:enfant-payes")) { origin adjudicated; }
        assert "paiement-direct-payes-03": avant_fin_scolarite(entity_ref("urn:fr:pf:case:enfant-payes")) { origin case_input; }
        assert "paiement-direct-payes-04": reside_france_stable(entity_ref("urn:fr:pf:case:direct-payes")) { origin case_input; }
        assert "paiement-direct-payes-05": enfant_reside_france(entity_ref("urn:fr:pf:case:enfant-payes")) { origin case_input; }
        assert "paiement-direct-payes-06": organisme_debiteur_pf(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:direct-payes")) { origin case_input; }
        assert "paiement-direct-payes-07": assume_charge_education_speciale(entity_ref("urn:fr:pf:case:entite-payes"), entity_ref("urn:fr:pf:case:direct-payes")) { origin case_input; }
    }
    evaluate positions();
    expect not position(PaiementDirectAeeh, ACTIVE);
    expect evaluation_status == COMPUTED;
}
