// General rule yields to the ASF derogation: March conditions with an ASF evasion-only trigger - no next-month general date (R. 552-2 I / II 5).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-dues-general-exclu-asf" {
    given {
        context { decision_time @2026-04-15T12:00:00Z; knowledge_time @2026-04-15T12:00:00Z; legal_time @2026-04-15; timezone "Europe/Paris"; deadline_policy SERVICE_MOIS; }
        assert "dues-general-exclu-asf-01": conditions_reunies_mois(entity_ref("urn:fr:pf:case:exclu-asf"), @2026-03-01) { origin case_input; }
        assert "dues-general-exclu-asf-02": asf_cas3_soustrait_seul(entity_ref("urn:fr:pf:case:exclu-asf")) { origin case_input; }
    }
    evaluate truth(prestations_dues_a_compter(entity_ref("urn:fr:pf:case:exclu-asf"), @2026-04-01));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
