// Regulatory forfait: PAJE scope, schedule 50 000 vs twice 20 000 + 5 000 - forfait counts without organ judgment (L. 553-5 via R. 553-3-5, PC-R03-04).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-forfait-reglementaire-section" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "forfait-reglementaire-01": prestation_soumise_section(entity_ref("urn:fr:pf:case:forfait-reg")) { origin case_input; }
        assert "forfait-reglementaire-02": evaluation_forfaitaire_train_vie(entity_ref("urn:fr:pf:case:forfait-reg"), 50000.00 EUR) { origin case_input; }
        assert "forfait-reglementaire-03": plafond_prestation(entity_ref("urn:fr:pf:case:forfait-reg"), 20000.00 EUR) { origin case_input; }
        assert "forfait-reglementaire-04": revenus_exclus_evaluation(entity_ref("urn:fr:pf:case:forfait-reg"), 5000.00 EUR) { origin case_input; }
    }
    evaluate truth(evaluation_forfaitaire_possible(entity_ref("urn:fr:pf:case:forfait-reg")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
