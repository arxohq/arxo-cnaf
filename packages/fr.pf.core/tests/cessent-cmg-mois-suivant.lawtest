// CMG cessation: conditions end in May - CMG ceases from 1 June (R. 552-3 II 1).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-cessent-cmg-mois-suivant" {
    given {
        context { decision_time @2026-07-15T12:00:00Z; knowledge_time @2026-07-15T12:00:00Z; legal_time @2026-07-15; timezone "Europe/Paris"; deadline_policy SERVICE_MOIS; }
        assert "cessent-cmg-mois-suivant-01": conditions_cessent_mois(entity_ref("urn:fr:pf:case:cmg-cesse"), @2026-05-01) { origin case_input; }
        assert "cessent-cmg-mois-suivant-02": prestation_cmg(entity_ref("urn:fr:pf:case:cmg-cesse")) { origin case_input; }
    }
    evaluate truth(prestations_cessent_a_compter(entity_ref("urn:fr:pf:case:cmg-cesse"), @2026-06-01));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
