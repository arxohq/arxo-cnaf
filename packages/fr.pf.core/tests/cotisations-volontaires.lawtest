// Voluntary contributions: allocataire requests L. 742-1 recovery on non-housing L. 511-1 benefit - recovery permitted (L. 553-4 I, PC-R03-03).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-cotisations-volontaires" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "cotisations-01": parent_charge(entity_ref("urn:fr:pf:case:cotisant"), entity_ref("urn:fr:pf:case:enfant-cotisant")) { origin case_input; }
        assert "cotisations-02": charge_effective_permanente(entity_ref("urn:fr:pf:case:cotisant"), entity_ref("urn:fr:pf:case:enfant-cotisant")) { origin adjudicated; }
        assert "cotisations-03": avant_fin_scolarite(entity_ref("urn:fr:pf:case:enfant-cotisant")) { origin case_input; }
        assert "cotisations-04": reside_france_stable(entity_ref("urn:fr:pf:case:cotisant")) { origin case_input; }
        assert "cotisations-05": enfant_reside_france(entity_ref("urn:fr:pf:case:enfant-cotisant")) { origin case_input; }
        assert "cotisations-06": organisme_debiteur_pf(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:cotisant")) { origin case_input; }
        assert "cotisations-07": demande_cotisations_volontaires(entity_ref("urn:fr:pf:case:cotisant")) { origin case_input; }
        assert "cotisations-08": prestation_l5111_hors_logement(entity_ref("urn:fr:pf:case:cotisant")) { origin case_input; }
    }
    evaluate positions();
    expect position(PrelevementCotisationsVolontaires, ACTIVE);
    expect evaluation_status == COMPUTED;
}
