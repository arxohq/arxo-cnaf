// ASF evasion-only: June filing - due from 1 July (R. 552-2 II 5).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-dues-asf-mois-suivant" {
    given {
        context { decision_time @2026-07-15T12:00:00Z; knowledge_time @2026-07-15T12:00:00Z; legal_time @2026-07-15; timezone "Europe/Paris"; deadline_policy SERVICE_MOIS; }
        assert "dues-asf-mois-suivant-01": demande_deposee_mois(entity_ref("urn:fr:pf:case:asf"), @2026-06-01) { origin case_input; }
        assert "dues-asf-mois-suivant-02": asf_cas3_soustrait_seul(entity_ref("urn:fr:pf:case:asf")) { origin case_input; }
    }
    evaluate truth(prestations_dues_a_compter(entity_ref("urn:fr:pf:case:asf"), @2026-07-01));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
