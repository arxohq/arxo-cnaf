// No subrogation outside CAF: 1500 EUR advance by a non-CAF body explicitly - no subrogation as of right (L. 581-9 actor scope, PC-R07-21).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-creance-subrogation-hors-caf" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "creance-subrogation-hors-caf-01": avance_fonds_sociaux(entity_ref("urn:fr:pf:org:mutuelle-exemple"), entity_ref("urn:fr:pf:case:creance-hcaf")) { origin case_input; }
        assert "creance-subrogation-hors-caf-02": not caisse_allocations_familiales(entity_ref("urn:fr:pf:org:mutuelle-exemple")) { origin case_input; }
        assert "creance-subrogation-hors-caf-03": avance_fonds_sociaux_montant(entity_ref("urn:fr:pf:org:mutuelle-exemple"), entity_ref("urn:fr:pf:case:creance-hcaf"), 1500 EUR) { origin case_input; }
    }
    evaluate truth(subrogation_plein_droit(entity_ref("urn:fr:pf:case:creance-hcaf")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
