// Contrainte after mise en demeure: eligible establishment, notice, rejected observations, registered letter 2026-01-10 without effect by 2026-03-15 - contrainte available (L. 553-2-1, PC-R07-04 full chain).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-recouvrement-mise-en-demeure-delai" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; deadline_policy RECOUVREMENT_DELAI; }
        assert "recouvrement-mise-en-demeure-delai-01": mise_en_demeure_adressee_le(entity_ref("urn:fr:pf:case:indu-mise-en-demeure"), @2026-01-10) { origin case_input; }
        assert "recouvrement-mise-en-demeure-delai-02": date_appreciation(entity_ref("urn:fr:pf:case:indu-mise-en-demeure"), @2026-03-15) { origin case_input; }
        assert "recouvrement-mise-en-demeure-delai-03": etablissement_service_eligible_l5532_1(entity_ref("urn:fr:pf:case:indu-mise-en-demeure")) { origin case_input; }
        assert "recouvrement-mise-en-demeure-delai-04": notification_recouvrement_adressee(entity_ref("urn:fr:pf:case:indu-mise-en-demeure")) { origin case_input; }
        assert "recouvrement-mise-en-demeure-delai-05": observations_interesse_rejetees(entity_ref("urn:fr:pf:case:indu-mise-en-demeure")) { origin case_input; }
        assert "recouvrement-mise-en-demeure-delai-06": mise_en_demeure_sans_effet(entity_ref("urn:fr:pf:case:indu-mise-en-demeure"), @2026-01-10) { origin case_input; }
    }
    evaluate truth(contrainte_possible(entity_ref("urn:fr:pf:case:indu-mise-en-demeure")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
