// 2026 cohort: full-rate PreParE, indemnities ending this month, L. 531-4 VI option - cumulation admitted (L. 532-2 V).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-cumul-option-2026" {
    given {
        context { decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; }
        assert "cumul-option-2026-01": beneficie_prepare_taux_plein(entity_ref("urn:fr:pf:case:option-2026"), entity_ref("urn:fr:pf:case:enfant-2026c")) { origin case_input; }
        assert "cumul-option-2026-02": fin_indemnites_mois(entity_ref("urn:fr:pf:case:option-2026")) { origin case_input; }
        assert "cumul-option-2026-03": option_l5314_vi(entity_ref("urn:fr:pf:case:option-2026")) { origin case_input; }
        assert "cumul-option-2026-04": cohorte_2026(entity_ref("urn:fr:pf:case:enfant-2026c")) { origin case_input; }
    }
    evaluate truth(cumul_prepare_option_admis(entity_ref("urn:fr:pf:case:option-2026"), entity_ref("urn:fr:pf:case:enfant-2026c")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
