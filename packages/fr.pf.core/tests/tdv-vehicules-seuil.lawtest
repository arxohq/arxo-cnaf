// Vehicle band (PC-R05-04/PC-R06-01): one vehicle 12 000 EUR retained, insurance 11 500 EUR same Bien, full private use - apport 3 000 EUR, no forced equality (R. 553-3-1 5 + II 2° a).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-tdv-vehicules-seuil" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "tdv-vehicules-seuil-01": vehicule_bien_valeur(entity_ref("urn:fr:pf:case:automobiliste"), entity_ref("urn:fr:pf:case:auto-1"), 12000.00 EUR, 1.0) { origin case_input; }
        assert "tdv-vehicules-seuil-02": prestation_soumise_section(entity_ref("urn:fr:pf:case:automobiliste")) { origin case_input; }
        assert "tdv-vehicules-seuil-03": vehicule_bien_date(entity_ref("urn:fr:pf:case:automobiliste"), entity_ref("urn:fr:pf:case:auto-1"), @2026-02-10) { origin case_input; }
        assert "tdv-vehicules-seuil-04": vehicule_bien_preuve_assurance(entity_ref("urn:fr:pf:case:automobiliste"), entity_ref("urn:fr:pf:case:auto-1"), 11500.00 EUR) { origin case_input; }
    }
    evaluate truth(apport_forfaitaire(entity_ref("urn:fr:pf:case:automobiliste"), 3000.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
