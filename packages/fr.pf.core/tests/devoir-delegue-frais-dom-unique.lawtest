// DOM delegate costs, single eligible benefit: non-prime benefit served in DOM - the serving body bears costs (L. 755-4 al. 2-3, PC-R04-05 benefit-specific).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-devoir-delegue-frais-dom-unique" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "devoir-dom-unique-01": delegue_percoit(entity_ref("urn:fr:pf:case:budget-dom")) { origin case_input; }
        assert "devoir-dom-unique-02": organisme_verse_prestation_delegue_eligible(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:budget-dom")) { origin case_input; }
        assert "devoir-dom-unique-03": beneficiaire_dom_l7554(entity_ref("urn:fr:pf:case:budget-dom")) { origin case_input; }
        assert "devoir-dom-unique-04": delegue_percoit_prestation_eligible(entity_ref("urn:fr:pf:case:budget-dom")) { origin case_input; }
        assert "devoir-dom-unique-05": prestation_delegue_unique(entity_ref("urn:fr:pf:case:budget-dom")) { origin case_input; }
        assert "devoir-dom-unique-06": not plusieurs_prestations_delegue(entity_ref("urn:fr:pf:case:budget-dom")) { origin case_input; }
        assert "devoir-dom-unique-07": not delegue_percoit_prime_forfaitaire(entity_ref("urn:fr:pf:case:budget-dom")) { origin case_input; }
    }
    evaluate positions();
    expect position(SupporterFraisMesureDOM, ACTIVE);
    expect evaluation_status == COMPUTED;
}
