// Death cessation: death in April - benefits cease from 1 May (R. 552-3 III).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-cessent-deces-mois-suivant" {
    given {
        context { decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; deadline_policy SERVICE_MOIS; }
        assert "cessent-deces-mois-suivant-01": deces_proche_mois(entity_ref("urn:fr:pf:case:deces"), @2026-04-01) { origin case_input; }
    }
    evaluate truth(prestations_cessent_a_compter(entity_ref("urn:fr:pf:case:deces"), @2026-05-01));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
