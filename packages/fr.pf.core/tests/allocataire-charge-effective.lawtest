// Full allocataire: effective permanent care assessed by the fund, both residing in France, child opening entitlement - benefits due (L. 513-1).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-allocataire-charge-effective" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "allocataire-charge-effective-01": parent_charge(entity_ref("urn:fr:pf:case:allocataire-ok"), entity_ref("urn:fr:pf:case:enfant-allocataire-ok")) { origin case_input; }
        assert "allocataire-charge-effective-02": charge_effective_permanente(entity_ref("urn:fr:pf:case:allocataire-ok"), entity_ref("urn:fr:pf:case:enfant-allocataire-ok")) { origin adjudicated; }
        assert "allocataire-charge-effective-03": avant_fin_scolarite(entity_ref("urn:fr:pf:case:enfant-allocataire-ok")) { origin case_input; }
        assert "allocataire-charge-effective-04": reside_france_stable(entity_ref("urn:fr:pf:case:allocataire-ok")) { origin case_input; }
        assert "allocataire-charge-effective-05": enfant_reside_france(entity_ref("urn:fr:pf:case:enfant-allocataire-ok")) { origin case_input; }
    }
    evaluate truth(allocataire(entity_ref("urn:fr:pf:case:allocataire-ok")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
