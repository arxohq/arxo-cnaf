// Art retained insurance-different (PC-R06-01): valeur 20 000 EUR with date, insurance 19 800 EUR same Bien - retained 20 000, apport 600 EUR, no forced equality (R. 553-3-1 7 + II 2° a).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-tdv-art-valeur-retenue-assurance" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "tdv-art-retenue-assurance-01": art_bien_valeur(entity_ref("urn:fr:pf:case:art-retenue-assurance"), entity_ref("urn:fr:pf:case:art-1"), 20000.00 EUR, 1.0) { origin case_input; }
        assert "tdv-art-retenue-assurance-02": art_bien_date(entity_ref("urn:fr:pf:case:art-retenue-assurance"), entity_ref("urn:fr:pf:case:art-1"), @2026-01-12) { origin case_input; }
        assert "tdv-art-retenue-assurance-03": art_bien_preuve_assurance(entity_ref("urn:fr:pf:case:art-retenue-assurance"), entity_ref("urn:fr:pf:case:art-1"), 19800.00 EUR) { origin case_input; }
        assert "tdv-art-retenue-assurance-04": prestation_soumise_section(entity_ref("urn:fr:pf:case:art-retenue-assurance")) { origin case_input; }
    }
    evaluate truth(apport_forfaitaire(entity_ref("urn:fr:pf:case:art-retenue-assurance"), 600.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
