// No increase without the opening notice: eligible establishment, rejected observations, registered demand, notice-sourced sums unpaid past exigibility, but no opening notification - no 10% (L. 553-2-1 al. 2-4, PC-R08-02).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-recouvrement-majoration-sans-notification" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "recouvrement-majoration-sans-notification-01": etablissement_service_eligible_l5532_1(entity_ref("urn:fr:pf:case:indu-sans-notif")) { origin case_input; }
        assert "recouvrement-majoration-sans-notification-02": mise_en_demeure_adressee_le(entity_ref("urn:fr:pf:case:indu-sans-notif"), @2026-01-10) { origin case_input; }
        assert "recouvrement-majoration-sans-notification-03": sommes_mise_issues_notification(entity_ref("urn:fr:pf:case:indu-sans-notif"), 2000 EUR) { origin case_input; }
        assert "recouvrement-majoration-sans-notification-04": sommes_non_reglees(entity_ref("urn:fr:pf:case:indu-sans-notif"), 2000 EUR) { origin case_input; }
        assert "recouvrement-majoration-sans-notification-05": date_exigibilite_mise_le(entity_ref("urn:fr:pf:case:indu-sans-notif"), @2026-02-10) { origin case_input; }
        assert "recouvrement-majoration-sans-notification-06": date_appreciation(entity_ref("urn:fr:pf:case:indu-sans-notif"), @2026-03-15) { origin case_input; }
        assert "recouvrement-majoration-sans-notification-07": observations_interesse_rejetees(entity_ref("urn:fr:pf:case:indu-sans-notif")) { origin case_input; }
    }
    evaluate truth(majoration_mise_en_demeure(entity_ref("urn:fr:pf:case:indu-sans-notif"), 200 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
