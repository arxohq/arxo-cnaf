// Maintained amount: 500 EUR due for the death month - maintained at 500 EUR (R. 552-4).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-montant-maintenu-egal" {
    given {
        context { decision_time @2026-07-15T12:00:00Z; knowledge_time @2026-07-15T12:00:00Z; legal_time @2026-07-15; timezone "Europe/Paris"; deadline_policy SERVICE_MOIS; }
        assert "montant-maintenu-egal-01": maintien_applicable(entity_ref("urn:fr:pf:case:enfant-decede")) { origin case_input; }
        assert "montant-maintenu-egal-02": montant_mois_deces(entity_ref("urn:fr:pf:case:enfant-decede"), 500.00 EUR) { origin case_input; }
    }
    evaluate truth(montant_maintenu(entity_ref("urn:fr:pf:case:enfant-decede"), 500.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
