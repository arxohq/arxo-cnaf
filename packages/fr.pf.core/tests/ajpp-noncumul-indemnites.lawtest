// AJPP non-cumul items 1-5: AJPP beneficiary receiving a concurrent L. 532-2 II indemnity - combination refused (L. 544-9 I 1°-5°, PC-R07-10).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-ajpp-noncumul-indemnites" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "ajpp-noncumul-indemnites-01": beneficie_ajpp(entity_ref("urn:fr:pf:case:ajpp-nc-ind")) { origin case_input; }
        assert "ajpp-noncumul-indemnites-02": percoit_indemnite_concurrente(entity_ref("urn:fr:pf:case:ajpp-nc-ind")) { origin case_input; }
    }
    evaluate truth(cumul_ajpp_refuse(entity_ref("urn:fr:pf:case:ajpp-nc-ind")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
