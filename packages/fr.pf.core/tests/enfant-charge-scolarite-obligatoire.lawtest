// Before the end of compulsory schooling: entitlement opens with no pay test (L. 512-3 1°).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-enfant-charge-scolarite-obligatoire" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "enfant-charge-scolarite-obligatoire-01": avant_fin_scolarite(entity_ref("urn:fr:pf:case:enfant-scolarite")) { origin case_input; }
    }
    evaluate truth(enfant_ouvre_droit(entity_ref("urn:fr:pf:case:enfant-scolarite")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
