// No creditor fallback without the explicit default: the body serves the creditor's residence but allocataire-residence status is unknown - no competent issuer derived (L. 582-2 « ou, à défaut », PC-R08-05).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-creance-titre-competent-sans-repli" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "creance-titre-competent-sans-repli-01": titre_organisme_residence_creancier(entity_ref("urn:fr:pf:org:caisse-creancier"), entity_ref("urn:fr:pf:case:creance-sansrepli")) { origin case_input; }
    }
    evaluate truth(organisme_competent_titre(entity_ref("urn:fr:pf:org:caisse-creancier"), entity_ref("urn:fr:pf:case:creance-sansrepli")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
