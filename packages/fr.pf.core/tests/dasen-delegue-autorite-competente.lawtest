// DASEN delegate authority: schooling child in charge - the DASEN delegate is the alternative competent authority, both branches competent (D. 552-6 al. 1 "ou son delegue", PC-R04-02).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-dasen-delegue-autorite-competente" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "dasen-delegue-01": parent_charge(entity_ref("urn:fr:pf:case:scolarise-delegue"), entity_ref("urn:fr:pf:case:enfant-scolarise-delegue")) { origin case_input; }
    }
    evaluate truth(delegue_dasen_autorite_competente(entity_ref("urn:fr:pf:case:enfant-scolarise-delegue")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
