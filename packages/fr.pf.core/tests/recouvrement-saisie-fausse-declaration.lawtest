// False-declaration attachment: overpayment following the allocataire's false declaration - the fund may attach (L. 553-4 I, second branch, PC-R07-05).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-recouvrement-saisie-fausse-declaration" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "recouvrement-saisie-fausse-declaration-01": parent_charge(entity_ref("urn:fr:pf:case:fausse-declaration"), entity_ref("urn:fr:pf:case:enfant-fausse-declaration")) { origin case_input; }
        assert "recouvrement-saisie-fausse-declaration-02": charge_effective_permanente(entity_ref("urn:fr:pf:case:fausse-declaration"), entity_ref("urn:fr:pf:case:enfant-fausse-declaration")) { origin adjudicated; }
        assert "recouvrement-saisie-fausse-declaration-03": avant_fin_scolarite(entity_ref("urn:fr:pf:case:enfant-fausse-declaration")) { origin case_input; }
        assert "recouvrement-saisie-fausse-declaration-04": reside_france_stable(entity_ref("urn:fr:pf:case:fausse-declaration")) { origin case_input; }
        assert "recouvrement-saisie-fausse-declaration-05": enfant_reside_france(entity_ref("urn:fr:pf:case:enfant-fausse-declaration")) { origin case_input; }
        assert "recouvrement-saisie-fausse-declaration-06": organisme_debiteur_pf(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:fausse-declaration")) { origin case_input; }
        assert "recouvrement-saisie-fausse-declaration-07": indu_fausse_declaration(entity_ref("urn:fr:pf:case:fausse-declaration")) { origin case_input; }
    }
    evaluate positions();
    expect position(SaisieInduFausseDeclaration, ACTIVE);
    expect evaluation_status == COMPUTED;
}
