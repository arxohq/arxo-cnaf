// AEEH by CDAPH decision: favourable commission decision - entitlement opens (L. 541-1, L. 541-2).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-renvoi-aeeh-cdaph" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "renvoi-aeeh-cdaph-01": decision_cdaph_favorable(entity_ref("urn:fr:pf:case:enfant-handicape")) { origin case_input; }
    }
    evaluate truth(aeeh_ouvre_droit(entity_ref("urn:fr:pf:case:enfant-handicape")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
