// Cessation yields to the AEEH renvoi: May cessation for an AEEH case - no same-month general cessation (R. 552-3 I / II 2).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-cessent-general-exclu-aeeh" {
    given {
        context { decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; deadline_policy SERVICE_MOIS; }
        assert "cessent-general-exclu-aeeh-01": conditions_cessent_mois(entity_ref("urn:fr:pf:case:cesse-aeeh"), @2026-05-01) { origin case_input; }
        assert "cessent-general-exclu-aeeh-02": prestation_aeeh(entity_ref("urn:fr:pf:case:cesse-aeeh")) { origin case_input; }
    }
    evaluate truth(prestations_cessent_a_compter(entity_ref("urn:fr:pf:case:cesse-aeeh"), @2026-05-01));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
