// Direct AEEH payment: unpaid 2° costs, education entity bears charge - entity obtains direct payment (L. 553-4 I 2, PC-R03-03).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-paiement-direct-aeeh" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "paiement-direct-aeeh-01": parent_charge(entity_ref("urn:fr:pf:case:direct-aeeh"), entity_ref("urn:fr:pf:case:enfant-direct")) { origin case_input; }
        assert "paiement-direct-aeeh-02": charge_effective_permanente(entity_ref("urn:fr:pf:case:direct-aeeh"), entity_ref("urn:fr:pf:case:enfant-direct")) { origin adjudicated; }
        assert "paiement-direct-aeeh-03": avant_fin_scolarite(entity_ref("urn:fr:pf:case:enfant-direct")) { origin case_input; }
        assert "paiement-direct-aeeh-04": reside_france_stable(entity_ref("urn:fr:pf:case:direct-aeeh")) { origin case_input; }
        assert "paiement-direct-aeeh-05": enfant_reside_france(entity_ref("urn:fr:pf:case:enfant-direct")) { origin case_input; }
        assert "paiement-direct-aeeh-06": organisme_debiteur_pf(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:direct-aeeh")) { origin case_input; }
        assert "paiement-direct-aeeh-07": frais_aeeh_impayes(entity_ref("urn:fr:pf:case:direct-aeeh")) { origin case_input; }
        assert "paiement-direct-aeeh-08": assume_charge_education_speciale(entity_ref("urn:fr:pf:case:entite-educ"), entity_ref("urn:fr:pf:case:direct-aeeh")) { origin case_input; }
    }
    evaluate positions();
    expect position(PaiementDirectAeeh, ACTIVE);
    expect evaluation_status == COMPUTED;
}
