// Direct recovery allowed again after termination: prefet seized for 3000 EUR but procedure end notified - the bar is lifted (L. 581-10 al. 3 « jusqu'à », PC-R07-20).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-creance-directe-apres-cessation" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "creance-directe-apres-cessation-01": saisine_prefet(entity_ref("urn:fr:pf:case:creance-cess")) { origin case_input; }
        assert "creance-directe-apres-cessation-02": organisme_debiteur_pf(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:creance-cess")) { origin case_input; }
        assert "creance-directe-apres-cessation-03": sommes_objet_demande_recouvrement(entity_ref("urn:fr:pf:case:creance-cess"), 3000 EUR) { origin case_input; }
        assert "creance-directe-apres-cessation-04": cessation_procedure_recouvrement_notifiee(entity_ref("urn:fr:pf:case:creance-cess")) { origin case_input; }
    }
    evaluate positions();
    expect not position(PoursuivreRecouvrementDirect, ACTIVE);
    expect evaluation_status == COMPUTED;
}
