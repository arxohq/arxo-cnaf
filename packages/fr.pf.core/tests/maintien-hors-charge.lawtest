// No maintien outside care: death 10 March but the child explicitly not in care at death - no maintien endpoint (R. 552-3 IV, PC-R07-34).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-maintien-hors-charge" {
    given {
        context { decision_time @2026-07-15T12:00:00Z; knowledge_time @2026-07-15T12:00:00Z; legal_time @2026-07-15; timezone "Europe/Paris"; deadline_policy SERVICE_MOIS; }
        assert "maintien-hors-charge-01": deces_le(entity_ref("urn:fr:pf:case:enfant-hors-charge"), @2026-03-10) { origin case_input; }
        assert "maintien-hors-charge-02": not deces_enfant_charge(entity_ref("urn:fr:pf:case:enfant-hors-charge")) { origin case_input; }
        assert "maintien-hors-charge-03": ouverture_droit_mois(entity_ref("urn:fr:pf:case:enfant-hors-charge"), @2025-06-01) { origin case_input; }
    }
    evaluate truth(maintien_prestations_fin(entity_ref("urn:fr:pf:case:enfant-hors-charge"), @2026-06-30));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
