// No suspension past the start of compulsory-school age: certificates missing but below-age status explicitly denied - the L. 552-2 liberty does not arise (L. 552-2, PC-R07-06 explicit negative).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-devoir-suspension-certificats-scolaire" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "devoir-suspension-certificats-scolaire-01": parent_charge(entity_ref("urn:fr:pf:case:certificats-scolaire"), entity_ref("urn:fr:pf:case:enfant-scolaire")) { origin case_input; }
        assert "devoir-suspension-certificats-scolaire-02": charge_effective_permanente(entity_ref("urn:fr:pf:case:certificats-scolaire"), entity_ref("urn:fr:pf:case:enfant-scolaire")) { origin adjudicated; }
        assert "devoir-suspension-certificats-scolaire-03": not enfant_avant_age_scolaire(entity_ref("urn:fr:pf:case:enfant-scolaire")) { origin case_input; }
        assert "devoir-suspension-certificats-scolaire-04": reside_france_stable(entity_ref("urn:fr:pf:case:certificats-scolaire")) { origin case_input; }
        assert "devoir-suspension-certificats-scolaire-05": enfant_reside_france(entity_ref("urn:fr:pf:case:enfant-scolaire")) { origin case_input; }
        assert "devoir-suspension-certificats-scolaire-06": organisme_debiteur_pf(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:certificats-scolaire")) { origin case_input; }
        assert "devoir-suspension-certificats-scolaire-07": certificat_sante_manquant(entity_ref("urn:fr:pf:case:enfant-scolaire")) { origin case_input; }
    }
    evaluate positions();
    expect not position(SuspendreVersementCertificats, ACTIVE);
    expect evaluation_status == COMPUTED;
}
