// DASEN authority: schooling child in charge - DASEN under rector delegation competent, four-minister order (D. 552-6 al. 1-2, PC-R03-07).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-dasen-autorite-competente" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "dasen-autorite-01": parent_charge(entity_ref("urn:fr:pf:case:scolarise"), entity_ref("urn:fr:pf:case:enfant-scolarise")) { origin case_input; }
    }
    evaluate truth(dasen_autorite_competente(entity_ref("urn:fr:pf:case:enfant-scolarise")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
