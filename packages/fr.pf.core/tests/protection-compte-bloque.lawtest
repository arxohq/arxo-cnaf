// Blocked account: allocataire with blocked current account - immunity preserved (L. 553-4 III al. 1, PC-R03-03).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-protection-compte-bloque" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "compte-bloque-01": parent_charge(entity_ref("urn:fr:pf:case:compte-bloque"), entity_ref("urn:fr:pf:case:enfant-bloque")) { origin case_input; }
        assert "compte-bloque-02": charge_effective_permanente(entity_ref("urn:fr:pf:case:compte-bloque"), entity_ref("urn:fr:pf:case:enfant-bloque")) { origin adjudicated; }
        assert "compte-bloque-03": avant_fin_scolarite(entity_ref("urn:fr:pf:case:enfant-bloque")) { origin case_input; }
        assert "compte-bloque-04": reside_france_stable(entity_ref("urn:fr:pf:case:compte-bloque")) { origin case_input; }
        assert "compte-bloque-05": enfant_reside_france(entity_ref("urn:fr:pf:case:enfant-bloque")) { origin case_input; }
        assert "compte-bloque-06": compte_courant_bloque(entity_ref("urn:fr:pf:case:compte-bloque")) { origin case_input; }
    }
    evaluate truth(protection_compte_maintenue(entity_ref("urn:fr:pf:case:compte-bloque")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
