// Singleton unknown (PC-R05-09, PC-R07-01 interface): delegate receives, serving body known, metro, but neither unique nor multiple attested; no cost position derives (unknown control: absence of derivation, pure unknown not default single).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-delegue-nombre-inconnu-neither" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "dn-01": delegue_percoit(entity_ref("urn:fr:pf:case:delegue-inconnu")) { origin case_input; }
        assert "dn-02": organisme_verse_prestation_delegue(entity_ref("urn:fr:pf:case:caf"), entity_ref("urn:fr:pf:case:delegue-inconnu")) { origin case_input; }
        assert "dn-03": not beneficiaire_dom_l7554(entity_ref("urn:fr:pf:case:delegue-inconnu")) { origin case_input; }
    }
    evaluate positions();
    expect not position(SupporterFraisMesure, ACTIVE);
    expect not position(SupporterFraisMesureDOM, ACTIVE);
    expect evaluation_status == COMPUTED;
}
