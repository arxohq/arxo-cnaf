// 2026 cohort: full-rate PreParE plus the L. 623-2 indemnity - no cumulation under the 2026-only 2 item (L. 532-2 II 2 réd. 2026).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-cumul-indemnite-2026-l6232" {
    given {
        context { decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; }
        assert "cumul-indemnite-2026-l6232-01": beneficie_prepare_taux_plein(entity_ref("urn:fr:pf:case:prepare-l6232"), entity_ref("urn:fr:pf:case:enfant-2026")) { origin case_input; }
        assert "cumul-indemnite-2026-l6232-02": percoit_indemnite_l623_2(entity_ref("urn:fr:pf:case:prepare-l6232")) { origin case_input; }
        assert "cumul-indemnite-2026-l6232-03": cohorte_2026(entity_ref("urn:fr:pf:case:enfant-2026")) { origin case_input; }
    }
    evaluate truth(cumul_prepare_indemnite_refuse(entity_ref("urn:fr:pf:case:prepare-l6232")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
