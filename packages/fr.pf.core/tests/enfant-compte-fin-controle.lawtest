// Control: death 10 March - AF/CF counting to same-day 10 June is NOT derived; only 30 June holds (R. 552-3 IV 2, PC-R03-01).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-enfant-compte-fin-controle" {
    given {
        context { decision_time @2026-07-15T12:00:00Z; knowledge_time @2026-07-15T12:00:00Z; legal_time @2026-07-15; timezone "Europe/Paris"; deadline_policy SERVICE_MOIS; }
        assert "enfant-compte-fin-controle-01": deces_le(entity_ref("urn:fr:pf:case:enfant-decede"), @2026-03-10) { origin case_input; }
        assert "enfant-compte-fin-controle-02": deces_enfant_charge(entity_ref("urn:fr:pf:case:enfant-decede")) { origin case_input; }
        assert "enfant-compte-fin-controle-03": ouverture_droit_mois(entity_ref("urn:fr:pf:case:enfant-decede"), @2025-06-01) { origin case_input; }
    }
    evaluate truth(enfant_compte_fin(entity_ref("urn:fr:pf:case:enfant-decede"), @2026-06-10));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
