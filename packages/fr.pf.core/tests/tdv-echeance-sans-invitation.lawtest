// No questionnaire invitation: letter sent with a dispatch date but without the return invitation - no thirty-day deadline (R. 553-3-4 2).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-tdv-echeance-sans-invitation" {
    given {
        context { decision_time @2026-04-15T12:00:00Z; knowledge_time @2026-04-15T12:00:00Z; legal_time @2026-04-15; timezone "Europe/Paris"; deadline_policy TRAIN_VIE_DELAI; }
        assert "tdv-echeance-sans-invitation-01": lettre_procedure_adressee(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:sans-invitation")) { origin case_input; }
        assert "tdv-echeance-sans-invitation-02": lettre_procedure_le(entity_ref("urn:fr:pf:org:caisse-exemple"), entity_ref("urn:fr:pf:case:sans-invitation"), @2026-03-01) { origin case_input; }
        assert "tdv-echeance-sans-invitation-03": prestation_soumise_section(entity_ref("urn:fr:pf:case:sans-invitation")) { origin case_input; }
    }
    evaluate truth(echeance_questionnaire(entity_ref("urn:fr:pf:case:sans-invitation"), @2026-03-31));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
