// Five-year fraud limitation: established fraudulent scheme, claim due 2021-02-01 assessed 2026-02-01 (L. 553-1).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-prescription-fraude-cinq-ans" {
    given {
        context { decision_time @2026-02-01T12:00:00Z; knowledge_time @2026-02-01T12:00:00Z; legal_time @2026-02-01; timezone "Europe/Paris"; deadline_policy PRESCRIPTION_ANNEES; }
        assert "prescription-fraude-cinq-ans-01": creance_exigible_le(entity_ref("urn:fr:pf:case:prescription-fraude"), @2021-02-01) { origin case_input; }
        assert "prescription-fraude-cinq-ans-02": date_appreciation(entity_ref("urn:fr:pf:case:prescription-fraude"), @2026-02-01) { origin case_input; }
        assert "prescription-fraude-cinq-ans-03": manoeuvre_frauduleuse(entity_ref("urn:fr:pf:case:prescription-fraude"), true) { origin case_input; }
    }
    evaluate truth(action_prescrite(entity_ref("urn:fr:pf:case:prescription-fraude")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
