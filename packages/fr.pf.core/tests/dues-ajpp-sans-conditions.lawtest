// AJPP filing without conditions: May filing but opening conditions explicitly unmet at filing - nothing due (R. 552-2 II 3°, PC-R07-28).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-dues-ajpp-sans-conditions" {
    given {
        context { decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; deadline_policy SERVICE_MOIS; }
        assert "dues-ajpp-sans-conditions-01": demande_deposee_mois(entity_ref("urn:fr:pf:case:ajpp-scond"), @2026-05-01) { origin case_input; }
        assert "dues-ajpp-sans-conditions-02": prestation_ajpp(entity_ref("urn:fr:pf:case:ajpp-scond")) { origin case_input; }
        assert "dues-ajpp-sans-conditions-03": not conditions_ajpp_reunies_depot(entity_ref("urn:fr:pf:case:ajpp-scond"), @2026-05-01) { origin case_input; }
    }
    evaluate truth(prestations_dues_a_compter(entity_ref("urn:fr:pf:case:ajpp-scond"), @2026-05-01));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
