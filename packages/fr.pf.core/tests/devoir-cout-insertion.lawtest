// Insertion cost ceiling: convicted person - insertion costs no more than 150 EUR (L. 554-3).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-devoir-cout-insertion" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "devoir-cout-insertion-01": personne_condamnee(entity_ref("urn:fr:pf:case:condamne")) { origin case_input; }
    }
    evaluate truth(cout_insertion_plafond(entity_ref("urn:fr:pf:case:condamne"), 150 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
