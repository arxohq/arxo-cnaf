// Non-enumerated increase: same child and amounts but increase not listed 1-4 - no reduction (L. 553-3 al. 1, PC-R03-02).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-priorite-non-enumereree" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "priorite-non-enumereree-01": montant_prestations_familiales(entity_ref("urn:fr:pf:case:priorite-non"), 300 EUR) { origin case_input; }
        assert "priorite-non-enumereree-02": montant_majorations_concurrentes(entity_ref("urn:fr:pf:case:priorite-non"), 500 EUR) { origin case_input; }
        assert "priorite-non-enumereree-03": meme_enfant_pf_majoration(entity_ref("urn:fr:pf:case:priorite-non"), entity_ref("urn:fr:pf:case:enfant-non")) { origin case_input; }
    }
    evaluate truth(majorations_reduites(entity_ref("urn:fr:pf:case:priorite-non"), 200 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
