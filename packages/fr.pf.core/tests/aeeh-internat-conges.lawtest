// AEEH internat leave period: CDAPH favourable, full-cover care but current leave period of the coverage - entitlement stands (L. 541-1 al. 4 exception, PC-R07-14).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-aeeh-internat-conges" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "aeeh-internat-conges-01": decision_cdaph_favorable(entity_ref("urn:fr:pf:case:aeeh-conges")) { origin case_input; }
        assert "aeeh-internat-conges-02": prise_en_charge_integrale_internat(entity_ref("urn:fr:pf:case:aeeh-conges")) { origin case_input; }
        assert "aeeh-internat-conges-03": periode_conge_suspension_prise_en_charge(entity_ref("urn:fr:pf:case:aeeh-conges")) { origin case_input; }
    }
    evaluate truth(aeeh_ouvre_droit(entity_ref("urn:fr:pf:case:aeeh-conges")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
