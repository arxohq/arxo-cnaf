// Death maintien forfait item: deceased child in care, decree period fixed, L. 521-1 lump sum paid for the child - forfait maintained and rollup holds (L. 552-7 al. 1, PC-R07-17).
// D-42: the context lacked deadline_policy SERVICE_MOIS (B-PFCORE-POLICY-CONTEXT): the R. 552-4
// gate MaintienOuvertureCondition steps one calendar_month (MISSING_POLICY without it). Expectation unchanged.
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-maintien-deces-forfait" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; deadline_policy SERVICE_MOIS; }
        assert "maintien-deces-forfait-01": deces_enfant_charge(entity_ref("urn:fr:pf:case:deces-forfait")) { origin case_input; }
        assert "maintien-deces-forfait-02": duree_maintien_fixee(entity_ref("urn:fr:pf:case:deces-forfait")) { origin case_input; }
        assert "maintien-deces-forfait-03": forfait_l5211_verse_enfant(entity_ref("urn:fr:pf:case:deces-forfait")) { origin case_input; }
        assert "maintien-deces-forfait-04": deces_le(entity_ref("urn:fr:pf:case:deces-forfait"), @2026-02-10) { origin case_input; }
        assert "maintien-deces-forfait-05": ouverture_droit_mois(entity_ref("urn:fr:pf:case:deces-forfait"), @2025-06-01) { origin case_input; }
    }
    evaluate truth(maintien_forfait_deces(entity_ref("urn:fr:pf:case:deces-forfait")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
