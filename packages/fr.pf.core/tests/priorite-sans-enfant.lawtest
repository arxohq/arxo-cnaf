// Missing same-child nexus: amounts and listed increase but no same-child fact - no reduction (L. 553-3 al. 1, PC-R03-02).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-priorite-sans-enfant" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "priorite-sans-enfant-01": montant_prestations_familiales(entity_ref("urn:fr:pf:case:priorite-sans"), 300 EUR) { origin case_input; }
        assert "priorite-sans-enfant-02": montant_majorations_concurrentes(entity_ref("urn:fr:pf:case:priorite-sans"), 500 EUR) { origin case_input; }
        assert "priorite-sans-enfant-03": majoration_enumereree_l5533(entity_ref("urn:fr:pf:case:priorite-sans"), entity_ref("urn:fr:pf:case:enfant-sans")) { origin case_input; }
    }
    evaluate truth(majorations_reduites(entity_ref("urn:fr:pf:case:priorite-sans"), 200 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
