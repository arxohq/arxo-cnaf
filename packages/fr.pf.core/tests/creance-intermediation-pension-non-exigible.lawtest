// Intermediation ends when the pension is no longer exigible: full II-title chain, pension no longer exigible - status removed (L. 582-1 VII 2°, PC-R08-08).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-creance-intermediation-pension-non-exigible" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "creance-intermediation-pension-non-exigible-01": stabilite_residence_creancier(entity_ref("urn:fr:pf:case:creance-nonexig")) { origin case_input; }
        assert "creance-intermediation-pension-non-exigible-02": debiteur_stable(entity_ref("urn:fr:pf:case:creance-nonexig")) { origin case_input; }
        assert "creance-intermediation-pension-non-exigible-03": not debiteur_hors_etat(entity_ref("urn:fr:pf:case:creance-nonexig")) { origin case_input; }
        assert "creance-intermediation-pension-non-exigible-04": intermediation_titre_3732_2_ii(entity_ref("urn:fr:pf:case:creance-nonexig")) { origin case_input; }
        assert "creance-intermediation-pension-non-exigible-05": pension_alimentaire_non_exigible(entity_ref("urn:fr:pf:case:creance-nonexig")) { origin case_input; }
    }
    evaluate truth(intermediation_mise_en_oeuvre(entity_ref("urn:fr:pf:case:creance-nonexig")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
