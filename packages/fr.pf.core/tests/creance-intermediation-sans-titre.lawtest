// No intermediation without a route: stable parties but neither II title nor III conditions - no intermediation (L. 582-1 I 1°-2°, PC-R07-22).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-creance-intermediation-sans-titre" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "creance-intermediation-sans-titre-01": stabilite_residence_creancier(entity_ref("urn:fr:pf:case:creance-stit")) { origin case_input; }
        assert "creance-intermediation-sans-titre-02": debiteur_stable(entity_ref("urn:fr:pf:case:creance-stit")) { origin case_input; }
        assert "creance-intermediation-sans-titre-03": not debiteur_hors_etat(entity_ref("urn:fr:pf:case:creance-stit")) { origin case_input; }
        assert "creance-intermediation-sans-titre-04": not intermediation_titre_3732_2_ii(entity_ref("urn:fr:pf:case:creance-stit")) { origin case_input; }
        assert "creance-intermediation-sans-titre-05": not intermediation_conditions_3732_2_iii(entity_ref("urn:fr:pf:case:creance-stit")) { origin case_input; }
    }
    evaluate truth(intermediation_mise_en_oeuvre(entity_ref("urn:fr:pf:case:creance-stit")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
