// No maintien without a known opening: death 10 March of a child in care, but no right-opening date - R. 552-4 applicability unknown, no maintien endpoint (R. 552-3 IV 1, R. 552-4, PC-R08-07).
language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

test "urn:query:fr-pf-core-maintien-sans-ouverture" {
    given {
        context { decision_time @2026-07-15T12:00:00Z; knowledge_time @2026-07-15T12:00:00Z; legal_time @2026-07-15; timezone "Europe/Paris"; deadline_policy SERVICE_MOIS; }
        assert "maintien-sans-ouverture-01": deces_le(entity_ref("urn:fr:pf:case:enfant-sans-ouverture"), @2026-03-10) { origin case_input; }
        assert "maintien-sans-ouverture-02": deces_enfant_charge(entity_ref("urn:fr:pf:case:enfant-sans-ouverture")) { origin case_input; }
    }
    evaluate truth(maintien_prestations_fin(entity_ref("urn:fr:pf:case:enfant-sans-ouverture"), @2026-06-30));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
