    label fr official "Décès: ASF versée au titre de l'enfant maintenue pendant la durée du décret, droit ouvert avant le mois du décès (L. 552-7 al. 1, R. 552-4)";
    label en unofficial "Death: ASF paid for the child maintained for the decree period, right opened before the death month (L. 552-7 para. 1, R. 552-4)";
    when deces_enfant_charge(e) and duree_maintien_fixee(e) and asf_versee_enfant(e)
        and maintien_applicable(e);
    then maintien_asf_deces(e);
}

@source(CSS_L552_7, CSS_L552_7_CSS_ED2022_02, CSS_L552_7_CSS_ED2022_03, CSS_L552_7_CSS_ED2022_09,
        CSS_L552_7_CSS_ED2023_07, CSS_L552_7_CSS_ED2024_01, CSS_L552_7_CSS_ED2025_02,
        CSS_L552_7_CSS_ED2025_09, CSS_L552_7_CSS_ED2025_12, CSS_L552_7_CSS_ED2026_01,
        CSS_L552_7_CSS_ED2026_04, CSS_L552_7_CSS_ED2026_06)
rule MaintienDecesAgregat(e: Enfant) strict {
    effective [@2022-01-01, infinity);
    label fr official "Agrégat: au moins un des six items maintenu (forfait, majoration, AEEH, PreParE, base, ASF)";
    label en unofficial "Rollup: at least one of the six items maintained (lump sum, increase, AEEH, PreParE, base, ASF)";
    when maintien_forfait_deces(e) or maintien_majoration_af(e) or maintien_aeeh_deces(e)
        or maintien_prepare_deces(e) or maintien_base_deces(e) or maintien_asf_deces(e);
    then prestations_maintenues_deces(e);
}
