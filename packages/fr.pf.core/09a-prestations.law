    effective [@2022-01-01, infinity);
    label fr official "Décès: allocation forfaitaire L. 521-1 versée au titre de l'enfant maintenue pendant la durée du décret, droit ouvert avant le mois du décès (L. 552-7 al. 1, R. 552-4)";
    label en unofficial "Death: L. 521-1 lump-sum allowance paid for the child maintained for the decree period, right opened before the death month (L. 552-7 para. 1, R. 552-4)";
    when deces_enfant_charge(e) and duree_maintien_fixee(e) and forfait_l5211_verse_enfant(e)
