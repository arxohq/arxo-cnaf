// --- D. 552-6: competent authority and order authorship (PC-R03-07, PC-R04-02 delegate) ---

relation dasen_autorite_competente(e: Enfant) kind institutional {
    key(e);
    label fr official "autorité compétente de l'Etat pour L. 552-4 al. 1: le directeur académique agissant sur délégation du recteur (D. 552-6 al. 1, première branche)";
    label en unofficial "competent State authority for L. 552-4 para. 1: the DASEN acting under rector delegation (D. 552-6 para. 1, first branch)";
}

relation delegue_dasen_autorite_competente(e: Enfant) kind institutional {
    key(e);
    label fr official "autorité compétente de l'Etat pour L. 552-4 al. 1: le délégué du directeur académique, « ou son délégué » (D. 552-6 al. 1, seconde branche)";
    label en unofficial "competent State authority for L. 552-4 para. 1: the DASEN delegate, 'ou son delegue' (D. 552-6 para. 1, second branch)";
}

relation arrete_l5524_quatre_ministres(e: Enfant) kind institutional {
    key(e);
    label fr official "arrêté d'application L. 552-4 al. 3 pris par les ministres de l'éducation, de l'agriculture, du budget et de la sécurité sociale (D. 552-6 al. 2)";
    label en unofficial "L. 552-4 para. 3 implementation order made by the education, agriculture, budget and social-security ministers (D. 552-6 para. 2)";
}

relation arrete_l5525_deux_ministres(p: Personne) kind institutional {
    key(p);
    label fr official "arrêté L. 552-5 pris par les ministres de l'éducation et de la sécurité sociale (D. 552-6 al. 3; L. 552-5 hors groupe payment-core)";
    label en unofficial "L. 552-5 order made by the education and social-security ministers (D. 552-6 para. 3; L. 552-5 outside payment-core)";
}

@source(CSS_D552_6, CSS_D552_6_CSS_ED2021_05, CSS_D552_6_CSS_ED2021_11, CSS_D552_6_CSS_ED2021_12,
        CSS_D552_6_CSS_ED2022_01, CSS_D552_6_CSS_ED2022_02, CSS_D552_6_CSS_ED2022_03,
        CSS_D552_6_CSS_ED2022_09, CSS_D552_6_CSS_ED2023_07, CSS_D552_6_CSS_ED2024_01,
        CSS_D552_6_CSS_ED2025_02, CSS_D552_6_CSS_ED2025_09, CSS_D552_6_CSS_ED2025_12,
        CSS_D552_6_CSS_ED2026_01, CSS_D552_6_CSS_ED2026_04, CSS_D552_6_CSS_ED2026_06)
rule AutoriteDasenCompetente(p: Personne, e: Enfant) strict {
    effective [@2021-01-01, infinity);
    label fr official "Scolarité: le DASEN sous délégation du recteur est l'autorité compétente (D. 552-6 al. 1)";
    label en unofficial "Schooling: the DASEN under rector delegation is the competent authority (D. 552-6 para. 1)";
    when parent_charge(p, e);
    then dasen_autorite_competente(e);
}

@source(CSS_D552_6, CSS_D552_6_CSS_ED2021_05, CSS_D552_6_CSS_ED2021_11, CSS_D552_6_CSS_ED2021_12,
        CSS_D552_6_CSS_ED2022_01, CSS_D552_6_CSS_ED2022_02, CSS_D552_6_CSS_ED2022_03,
        CSS_D552_6_CSS_ED2022_09, CSS_D552_6_CSS_ED2023_07, CSS_D552_6_CSS_ED2024_01,
        CSS_D552_6_CSS_ED2025_02, CSS_D552_6_CSS_ED2025_09, CSS_D552_6_CSS_ED2025_12,
        CSS_D552_6_CSS_ED2026_01, CSS_D552_6_CSS_ED2026_04, CSS_D552_6_CSS_ED2026_06)
rule AutoriteDelegueCompetente(p: Personne, e: Enfant) strict {
    effective [@2021-01-01, infinity);
    label fr official "Scolarité: le délégué du DASEN est l'autorité compétente alternative, « ou son délégué » (D. 552-6 al. 1)";
    label en unofficial "Schooling: the DASEN delegate is the alternative competent authority, 'ou son delegue' (D. 552-6 para. 1)";
    when parent_charge(p, e);
    then delegue_dasen_autorite_competente(e);
}

@source(CSS_D552_6, CSS_D552_6_CSS_ED2021_05, CSS_D552_6_CSS_ED2021_11, CSS_D552_6_CSS_ED2021_12,
        CSS_D552_6_CSS_ED2022_01, CSS_D552_6_CSS_ED2022_02, CSS_D552_6_CSS_ED2022_03,
        CSS_D552_6_CSS_ED2022_09, CSS_D552_6_CSS_ED2023_07, CSS_D552_6_CSS_ED2024_01,
