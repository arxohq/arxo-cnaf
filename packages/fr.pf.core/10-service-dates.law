        CSS_R552_4_CSS_ED2026_04, CSS_R552_4_CSS_ED2026_06)
rule AeehTiersMaintenue(e: Enfant, deces: Date) strict {
    effective [@2022-01-31, infinity);
    label fr official "Enfant à charge décédé: AEEH au tiers maintenue jusqu'au dernier jour du troisième mois, frais dus et sans demande d'interruption, droit ouvert avant le mois du décès";
    label en unofficial "Deceased child in care: AEEH to the third party maintained up to the last day of the third month, costs owed and no termination asked, right opened before the death month";
    when deces_le(e, deces) and deces_enfant_charge(e) and frais_tiers_restent_dus(e)
        and not interruption_versement_demandee(e) and maintien_applicable(e);
    then aeeh_tiers_maintenue_fin(e, month_end_of(add_calendar_period(deces, 3 calendar_month)));
}

@source(CSS_R552_3_PREV, CSS_R552_3_PREV_CSS_ED2021_05, CSS_R552_3_PREV_CSS_ED2021_11,
        CSS_R552_3_PREV_CSS_ED2021_12, CSS_R552_3_PREV_CSS_ED2022_01)
rule CessentMoisMemePrev(p: Personne, ancre: Date) strict {
    effective [@2021-01-01, @2022-01-31);
    label fr official "Cessation au mois même (rédaction 2015, I inchangé)";
    label en unofficial "Same-month cessation (2015 text, I unchanged)";
    when conditions_cessent_mois(p, ancre) and not prestation_cmg(p) and not prestation_ajpp(p)
        and not prestation_aeeh(p);
    then prestations_cessent_a_compter(p, ancre);
}

@source(CSS_R552_3_PREV, CSS_R552_3_PREV_CSS_ED2021_05, CSS_R552_3_PREV_CSS_ED2021_11,
        CSS_R552_3_PREV_CSS_ED2021_12, CSS_R552_3_PREV_CSS_ED2022_01)
rule CessentCmgMoisSuivantPrev(p: Personne, ancre: Date) strict {
    effective [@2021-01-01, @2022-01-31);
    label fr official "CMG cessant au mois suivant (rédaction 2015, II 1° inchangé)";
    label en unofficial "CMG ceasing the next month (2015 text, II 1 unchanged)";
    when conditions_cessent_mois(p, ancre) and prestation_cmg(p);
    then prestations_cessent_a_compter(p, add_calendar_period(ancre, 1 calendar_month));
}

@source(CSS_R552_3_PREV, CSS_R552_3_PREV_CSS_ED2021_05, CSS_R552_3_PREV_CSS_ED2021_11,
