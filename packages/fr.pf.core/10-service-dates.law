rule CessentAjppMoisSuivantPrev(p: Personne, ancre: Date) strict {
    effective [@2021-01-01, @2022-01-31);
    label fr official "AJPP cessant au mois suivant (rédaction 2015, II 3° inchangé)";
    label en unofficial "AJPP ceasing the next month (2015 text, II 3 unchanged)";
    when conditions_cessent_mois(p, ancre) and prestation_ajpp(p);
    then prestations_cessent_a_compter(p, add_calendar_period(ancre, 1 calendar_month));
}

@source(CSS_R552_3_PREV, CSS_R552_3_PREV_CSS_ED2021_05, CSS_R552_3_PREV_CSS_ED2021_11,
        CSS_R552_3_PREV_CSS_ED2021_12, CSS_R552_3_PREV_CSS_ED2022_01)
rule CessentDecesPrevL5310(p: Personne, deces: Date) strict {
    effective [@2021-01-01, @2022-01-31);
    label fr official "Décès: cessation au mois suivant, sauf cas L. 531-10 (rédaction 2015)";
    label en unofficial "Death: next-month cessation unless the L. 531-10 case (2015 text)";
    when deces_proche_mois(p, deces) and not cas_exception_l531_10(p);
    then prestations_cessent_a_compter(p, add_calendar_period(deces, 1 calendar_month));
}

@source(CSS_R552_4, CSS_R552_4_CSS_ED2022_02, CSS_R552_4_CSS_ED2022_03, CSS_R552_4_CSS_ED2022_09,
        CSS_R552_4_CSS_ED2023_07, CSS_R552_4_CSS_ED2024_01, CSS_R552_4_CSS_ED2025_02,
        CSS_R552_4_CSS_ED2025_09, CSS_R552_4_CSS_ED2025_12, CSS_R552_4_CSS_ED2026_01,
        CSS_R552_4_CSS_ED2026_04, CSS_R552_4_CSS_ED2026_06)
rule MaintienOuvertureCondition(e: Enfant, ouverture: Date, deces: Date) strict {
    effective [@2022-01-31, infinity);
    label fr official "Maintien si le décès intervient au plus tôt le mois suivant le premier jour d'ouverture";
    label en unofficial "Maintien where death falls no earlier than the month after opening day";
    when ouverture_droit_mois(e, ouverture) and deces_le(e, deces)
        and deces >= add_calendar_period(ouverture, 1 calendar_month);
    then maintien_applicable(e);
}

@source(CSS_R552_4, CSS_R552_4_CSS_ED2022_02, CSS_R552_4_CSS_ED2022_03, CSS_R552_4_CSS_ED2022_09,
        CSS_R552_4_CSS_ED2023_07, CSS_R552_4_CSS_ED2024_01, CSS_R552_4_CSS_ED2025_02,
        CSS_R552_4_CSS_ED2025_09, CSS_R552_4_CSS_ED2025_12, CSS_R552_4_CSS_ED2026_01,
        CSS_R552_4_CSS_ED2026_04, CSS_R552_4_CSS_ED2026_06)
rule MontantMaintenuEgal(e: Enfant, montant: Money) strict {
    effective [@2022-01-31, infinity);
    label fr official "Le montant maintenu est celui dû au titre du mois du décès (sous R. 541-1, fr.pf.aeeh)";
    label en unofficial "Maintained amount equals the month-of-death amount (under R. 541-1, fr.pf.aeeh)";
    when maintien_applicable(e) and montant_mois_deces(e, montant);
    then montant_maintenu(e, montant);
}

@source(CSS_R552_4, CSS_R552_4_CSS_ED2022_02, CSS_R552_4_CSS_ED2022_03, CSS_R552_4_CSS_ED2022_09,
        CSS_R552_4_CSS_ED2023_07, CSS_R552_4_CSS_ED2024_01, CSS_R552_4_CSS_ED2025_02,
        CSS_R552_4_CSS_ED2025_09, CSS_R552_4_CSS_ED2025_12, CSS_R552_4_CSS_ED2026_01,
        CSS_R552_4_CSS_ED2026_04, CSS_R552_4_CSS_ED2026_06)
rule ConditionsMaintienApplicables(e: Enfant) strict {
    effective [@2022-01-31, infinity);
    label fr official "Conditions d'ouverture et règles propres maintenues pendant le maintien (sous L. 552-7 dernier al.)";
    label en unofficial "Opening conditions and benefit rules kept during maintien (under L. 552-7 last para.)";
    when maintien_applicable(e);
    then conditions_maintien_applicables(e);
}

@source(CSS_L552_7, CSS_L552_7_CSS_ED2022_02, CSS_L552_7_CSS_ED2022_03, CSS_L552_7_CSS_ED2022_09,
        CSS_L552_7_CSS_ED2023_07, CSS_L552_7_CSS_ED2024_01, CSS_L552_7_CSS_ED2025_02,
        CSS_L552_7_CSS_ED2025_09, CSS_L552_7_CSS_ED2025_12, CSS_L552_7_CSS_ED2026_01,
        CSS_L552_7_CSS_ED2026_04, CSS_L552_7_CSS_ED2026_06)
rule EnfantCompteAutresPrestations(e: Enfant) strict {
    // Applicability follows the 2022-01-28 decree (NOTA loi 2020-692):
    // deaths from 2022-01-31. Existing ArsDecesApresJuin (09a) opens at
    // 2022-01-01 and is preserved untouched; the 30-day difference is
    // journaled (F-01) for reviewer qualification.
    effective [@2022-01-31, infinity);
    label fr official "L'enfant décédé compte pour les prestations dues au titre des autres enfants";
    label en unofficial "The deceased child counts for benefits due for the other children";
    when deces_enfant_charge(e) and maintien_applicable(e);
    then enfant_compte_apres_deces(e);
}

@source(CSS_L552_7, CSS_L552_7_CSS_ED2022_02, CSS_L552_7_CSS_ED2022_03, CSS_L552_7_CSS_ED2022_09,
        CSS_L552_7_CSS_ED2023_07, CSS_L552_7_CSS_ED2024_01, CSS_L552_7_CSS_ED2025_02,
        CSS_L552_7_CSS_ED2025_09, CSS_L552_7_CSS_ED2025_12, CSS_L552_7_CSS_ED2026_01,
        CSS_L552_7_CSS_ED2026_04, CSS_L552_7_CSS_ED2026_06)
rule AsfAvanceAcquise(p: Personne, e: Enfant) strict {
    effective [@2022-01-31, infinity);
    label fr official "L'avance ASF demeure acquise au parent créancier pendant le maintien";
    label en unofficial "The ASF advance stays with the creditor parent during maintien";
    when asf_avance_creance(p, e) and maintien_applicable(e);
    then asf_avance_non_recouvree(p, e);
}

@source(CSS_L552_4, CSS_L552_4_CSS_ED2023_07, CSS_L552_4_CSS_ED2024_01,
        CSS_L552_4_CSS_ED2025_02, CSS_L552_4_CSS_ED2025_09, CSS_L552_4_CSS_ED2025_12,
        CSS_L552_4_CSS_ED2026_01, CSS_L552_4_CSS_ED2026_04, CSS_L552_4_CSS_ED2026_06)
rule DuesScolariteInscription(p: Personne, e: Enfant, date: Date) strict {
    effective [@2022-09-01, infinity);
    label fr official "Enfant soumis à l'obligation scolaire: prestations dues à compter du certificat d'inscription scolaire";
    label en unofficial "Child subject to compulsory schooling: benefits due from the school enrolment certificate";
    when certificat_inscription_le(p, e, date) and avant_fin_scolarite(e);
    then prestations_dues_scolarite(p, e, date);
}

