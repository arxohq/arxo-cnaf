        CSS_R514_1_CSS_ED2026_01, CSS_R514_1_CSS_ED2026_04, CSS_R514_1_CSS_ED2026_06)
rule ServiceMSAAgricoles(p: Personne) defeasible {
    effective [@2021-01-01, infinity);
    label fr official "Professions agricoles: le service incombe à la MSA du lieu de résidence habituelle";
    label en unofficial "Agricultural professions: service falls on the MSA of the usual residence";
    when allocataire(p) and releve_professions_agricoles(p);
    then service_msa(p);
}

@source(CSS_R514_1, CSS_R514_1_CSS_ED2021_05, CSS_R514_1_CSS_ED2021_11, CSS_R514_1_CSS_ED2021_12,
        CSS_R514_1_CSS_ED2022_01, CSS_R514_1_CSS_ED2022_02, CSS_R514_1_CSS_ED2022_03,
        CSS_R514_1_CSS_ED2022_09, CSS_R514_1_CSS_ED2023_07, CSS_R514_1_CSS_ED2024_01,
        CSS_R514_1_CSS_ED2025_02, CSS_R514_1_CSS_ED2025_09, CSS_R514_1_CSS_ED2025_12,
        CSS_R514_1_CSS_ED2026_01, CSS_R514_1_CSS_ED2026_04, CSS_R514_1_CSS_ED2026_06)
rule ServiceEtatGuerre(p: Personne) defeasible {
    effective [@2021-01-01, infinity);
    label fr official "Victimes de guerre: les prestations sont servies par l'Etat";
    label en unofficial "War victims: benefits are served by the State";
    when allocataire(p) and victime_guerre_ou_ayant_cause(p);
    then service_etat(p);
}

@source(CSS_R552_1, CSS_R552_1_CSS_ED2021_05, CSS_R552_1_CSS_ED2021_11, CSS_R552_1_CSS_ED2021_12,
        CSS_R552_1_CSS_ED2022_01, CSS_R552_1_CSS_ED2022_02, CSS_R552_1_CSS_ED2022_03,
        CSS_R552_1_CSS_ED2022_09, CSS_R552_1_CSS_ED2023_07, CSS_R552_1_CSS_ED2024_01,
        CSS_R552_1_CSS_ED2025_02, CSS_R552_1_CSS_ED2025_09, CSS_R552_1_CSS_ED2025_12,
        CSS_R552_1_CSS_ED2026_01, CSS_R552_1_CSS_ED2026_04, CSS_R552_1_CSS_ED2026_06)
rule RegularisationIntervenue(p: Personne, date: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "Régularisation administrative datée: le transfert est régularisé (R. 552-1)";
    label en unofficial "Dated administrative settlement: the transfer is settled (R. 552-1)";
    when regularisation_administrative_le(p, date);
    then regularisation_intervenue(p);
}

@source(CSS_R552_1, CSS_R552_1_CSS_ED2021_05, CSS_R552_1_CSS_ED2021_11, CSS_R552_1_CSS_ED2021_12,
        CSS_R552_1_CSS_ED2022_01, CSS_R552_1_CSS_ED2022_02, CSS_R552_1_CSS_ED2022_03,
        CSS_R552_1_CSS_ED2022_09, CSS_R552_1_CSS_ED2023_07, CSS_R552_1_CSS_ED2024_01,
        CSS_R552_1_CSS_ED2025_02, CSS_R552_1_CSS_ED2025_09, CSS_R552_1_CSS_ED2025_12,
        CSS_R552_1_CSS_ED2026_01, CSS_R552_1_CSS_ED2026_04, CSS_R552_1_CSS_ED2026_06)
rule RegularisationNonIntervenue(p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "Transfert sans régularisation attestée: la régularisation n'est pas intervenue (R. 552-1)";
    label en unofficial "Transfer without attested settlement: settlement has not occurred (R. 552-1)";
    when transfert_regime(p) and transfert_non_regularise_atteste(p);
    then not regularisation_intervenue(p);
}

@source(CSS_R552_1, CSS_R552_1_CSS_ED2021_05, CSS_R552_1_CSS_ED2021_11, CSS_R552_1_CSS_ED2021_12,
        CSS_R552_1_CSS_ED2022_01, CSS_R552_1_CSS_ED2022_02, CSS_R552_1_CSS_ED2022_03,
        CSS_R552_1_CSS_ED2022_09, CSS_R552_1_CSS_ED2023_07, CSS_R552_1_CSS_ED2024_01,
        CSS_R552_1_CSS_ED2025_02, CSS_R552_1_CSS_ED2025_09, CSS_R552_1_CSS_ED2025_12,
        CSS_R552_1_CSS_ED2026_01, CSS_R552_1_CSS_ED2026_04, CSS_R552_1_CSS_ED2026_06)
rule ServiceRegimePrimitifSansRegularisation(p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "Transfert non régularisé: le service incombe au régime primitif";
    label en unofficial "Unsettled transfer: service falls on the original scheme";
    when transfert_regime(p) and transfert_non_regularise_atteste(p)
        and not regularisation_intervenue(p);
    then service_incombe_regime_primitif(p);
}

@source(CSS_R552_1, CSS_R552_1_CSS_ED2021_05, CSS_R552_1_CSS_ED2021_11, CSS_R552_1_CSS_ED2021_12,
        CSS_R552_1_CSS_ED2022_01, CSS_R552_1_CSS_ED2022_02, CSS_R552_1_CSS_ED2022_03,
        CSS_R552_1_CSS_ED2022_09, CSS_R552_1_CSS_ED2023_07, CSS_R552_1_CSS_ED2024_01,
        CSS_R552_1_CSS_ED2025_02, CSS_R552_1_CSS_ED2025_09, CSS_R552_1_CSS_ED2025_12,
        CSS_R552_1_CSS_ED2026_01, CSS_R552_1_CSS_ED2026_04, CSS_R552_1_CSS_ED2026_06)
rule ServiceRegimePrimitifAvantRegularisation(p: Personne, regul: Date, date: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "Transfert régularisé: le service incombe au primitif avant la date de régularisation";
    label en unofficial "Settled transfer: service falls on the original scheme before the settlement date";
    when transfert_regime(p) and regularisation_administrative_le(p, regul)
        and date_appreciation(p, date) and date < regul;
    then service_incombe_regime_primitif(p);
}

@source(CSS_R552_1, CSS_R552_1_CSS_ED2021_05, CSS_R552_1_CSS_ED2021_11, CSS_R552_1_CSS_ED2021_12,
        CSS_R552_1_CSS_ED2022_01, CSS_R552_1_CSS_ED2022_02, CSS_R552_1_CSS_ED2022_03,
        CSS_R552_1_CSS_ED2022_09, CSS_R552_1_CSS_ED2023_07, CSS_R552_1_CSS_ED2024_01,
        CSS_R552_1_CSS_ED2025_02, CSS_R552_1_CSS_ED2025_09, CSS_R552_1_CSS_ED2025_12,
        CSS_R552_1_CSS_ED2026_01, CSS_R552_1_CSS_ED2026_04, CSS_R552_1_CSS_ED2026_06)
rule RemboursementEntreRegimes(o: Organisme, p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "Service au primitif: il poursuit le remboursement auprès de l'autre régime";
    label en unofficial "Service on the original scheme: it claims reimbursement from the other scheme";
    when service_incombe_regime_primitif(p) and organisme_debiteur_pf(o, p);
    then liberty PoursuivreRemboursementRegime {
        holder o;
        action remboursement_regimes_action(o, p);
        window [@2021-01-01, infinity);
    };
}

@source(CSS_R552_2, CSS_R552_2_CSS_ED2021_05, CSS_R552_2_CSS_ED2021_11, CSS_R552_2_CSS_ED2021_12,
        CSS_R552_2_CSS_ED2022_01, CSS_R552_2_CSS_ED2022_02, CSS_R552_2_CSS_ED2022_03,
        CSS_R552_2_CSS_ED2022_09, CSS_R552_2_CSS_ED2023_07, CSS_R552_2_CSS_ED2024_01,
        CSS_R552_2_CSS_ED2025_02, CSS_R552_2_CSS_ED2025_09, CSS_R552_2_CSS_ED2025_12,
        CSS_R552_2_CSS_ED2026_01, CSS_R552_2_CSS_ED2026_04, CSS_R552_2_CSS_ED2026_06)
rule DuesCompterMoisSuivant(p: Personne, ancre: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "Prestations mensuelles dues à partir du premier jour du mois civil suivant les conditions, hors cas dérogatoires du II";
    label en unofficial "Monthly benefits due from the first day of the month after the conditions month, outside the II derogation cases";
    when conditions_reunies_mois(p, ancre) and not prepare_enfant_unique_ou_option(p)
        and not prestation_cmg(p) and not prestation_ajpp(p) and not prestation_aeeh(p)
        and not asf_cas3_soustrait_seul(p) and not fixation_judiciaire_apres_recouvrement(p);
    then prestations_dues_a_compter(p, add_calendar_period(ancre, 1 calendar_month));
}

@source(CSS_R552_2, CSS_R552_2_CSS_ED2021_05, CSS_R552_2_CSS_ED2021_11, CSS_R552_2_CSS_ED2021_12,
        CSS_R552_2_CSS_ED2022_01, CSS_R552_2_CSS_ED2022_02, CSS_R552_2_CSS_ED2022_03,
        CSS_R552_2_CSS_ED2022_09, CSS_R552_2_CSS_ED2023_07, CSS_R552_2_CSS_ED2024_01,
        CSS_R552_2_CSS_ED2025_02, CSS_R552_2_CSS_ED2025_09, CSS_R552_2_CSS_ED2025_12,
        CSS_R552_2_CSS_ED2026_01, CSS_R552_2_CSS_ED2026_04, CSS_R552_2_CSS_ED2026_06)
rule DuesPrepareMemeMois(p: Personne, ancre: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "PreParE enfant unique ou option: due dès le premier jour du mois des conditions";
    label en unofficial "Single-child or option PreParE: due from the first day of the conditions month";
    when conditions_reunies_mois(p, ancre) and prepare_enfant_unique_ou_option(p);
    then prestations_dues_a_compter(p, ancre);
}

@source(CSS_R552_2, CSS_R552_2_CSS_ED2021_05, CSS_R552_2_CSS_ED2021_11, CSS_R552_2_CSS_ED2021_12,
        CSS_R552_2_CSS_ED2022_01, CSS_R552_2_CSS_ED2022_02, CSS_R552_2_CSS_ED2022_03,
        CSS_R552_2_CSS_ED2022_09, CSS_R552_2_CSS_ED2023_07, CSS_R552_2_CSS_ED2024_01,
        CSS_R552_2_CSS_ED2025_02, CSS_R552_2_CSS_ED2025_09, CSS_R552_2_CSS_ED2025_12,
        CSS_R552_2_CSS_ED2026_01, CSS_R552_2_CSS_ED2026_04, CSS_R552_2_CSS_ED2026_06)
rule DuesCmgMoisPrecedent(p: Personne, depot: Date, precedent: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "CMG dû dès le premier jour du mois précédant le dépôt (conditions réunies), hors dépôt le même mois et droit ouvert pour un autre enfant";
    label en unofficial "CMG due from the first day of the month before filing (conditions met), unless filed the same month or a right is open for another child";
    when demande_deposee_mois(p, depot) and mois_precedent_demande(p, precedent)
        and not demande_meme_mois(p) and not droit_ouvert_autre_enfant(p);
    then prestations_dues_a_compter(p, precedent);
}

@source(CSS_R552_2, CSS_R552_2_CSS_ED2021_05, CSS_R552_2_CSS_ED2021_11, CSS_R552_2_CSS_ED2021_12,
        CSS_R552_2_CSS_ED2022_01, CSS_R552_2_CSS_ED2022_02, CSS_R552_2_CSS_ED2022_03,
        CSS_R552_2_CSS_ED2022_09, CSS_R552_2_CSS_ED2023_07, CSS_R552_2_CSS_ED2024_01,
        CSS_R552_2_CSS_ED2025_02, CSS_R552_2_CSS_ED2025_09, CSS_R552_2_CSS_ED2025_12,
        CSS_R552_2_CSS_ED2026_01, CSS_R552_2_CSS_ED2026_04, CSS_R552_2_CSS_ED2026_06)
rule DuesCmgMoisMeme(p: Personne, ancre: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "CMG: demande du même mois — droit ouvert dès le mois des conditions";
    label en unofficial "CMG: same-month filing - right open from the conditions month";
    when conditions_reunies_mois(p, ancre) and demande_meme_mois(p);
    then prestations_dues_a_compter(p, ancre);
}

@source(CSS_R552_2, CSS_R552_2_CSS_ED2021_05, CSS_R552_2_CSS_ED2021_11, CSS_R552_2_CSS_ED2021_12,
        CSS_R552_2_CSS_ED2022_01, CSS_R552_2_CSS_ED2022_02, CSS_R552_2_CSS_ED2022_03,
        CSS_R552_2_CSS_ED2022_09, CSS_R552_2_CSS_ED2023_07, CSS_R552_2_CSS_ED2024_01,
        CSS_R552_2_CSS_ED2025_02, CSS_R552_2_CSS_ED2025_09, CSS_R552_2_CSS_ED2025_12,
        CSS_R552_2_CSS_ED2026_01, CSS_R552_2_CSS_ED2026_04, CSS_R552_2_CSS_ED2026_06)
rule DuesCmgDroitOuvert(p: Personne, ancre: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "CMG: droit déjà ouvert pour un autre enfant — dès le mois des conditions";
    label en unofficial "CMG: right already open for another child - from the conditions month";
    when conditions_reunies_mois(p, ancre) and droit_ouvert_autre_enfant(p);
    then prestations_dues_a_compter(p, ancre);
}

