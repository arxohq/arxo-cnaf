rule DuesAsfMoisSuivant(p: Personne, depot: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "ASF défaillance seule: due dès le premier jour du mois suivant le dépôt";
    label en unofficial "ASF evasion-only: due from the first day of the month after filing";
    when demande_deposee_mois(p, depot) and asf_cas3_soustrait_seul(p);
    then prestations_dues_a_compter(p, add_calendar_period(depot, 1 calendar_month));
}

@source(CSS_R552_2, CSS_R552_2_CSS_ED2021_05, CSS_R552_2_CSS_ED2021_11, CSS_R552_2_CSS_ED2021_12,
        CSS_R552_2_CSS_ED2022_01, CSS_R552_2_CSS_ED2022_02, CSS_R552_2_CSS_ED2022_03,
        CSS_R552_2_CSS_ED2022_09, CSS_R552_2_CSS_ED2023_07, CSS_R552_2_CSS_ED2024_01,
        CSS_R552_2_CSS_ED2025_02, CSS_R552_2_CSS_ED2025_09, CSS_R552_2_CSS_ED2025_12,
        CSS_R552_2_CSS_ED2026_01, CSS_R552_2_CSS_ED2026_04, CSS_R552_2_CSS_ED2026_06)
rule DuesAsfJugeRecouvrement(p: Personne, cessation: Date, plancher: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "ASF créance judiciaire après recouvrement, conditions réunies: dès le mois suivant la cessation quand il est postérieur ou égal au plancher";
    label en unofficial "ASF judicial claim after recovery, conditions met: from the month after cessation when it is later than or equal to the floor";
    when fixation_judiciaire_apres_recouvrement(p) and cessation_defaut_mois(p, cessation)
        and plancher_3_mois_demande(p, plancher) and conditions_asf_reunies(p)
        and plancher <= add_calendar_period(cessation, 1 calendar_month);
    then prestations_dues_a_compter(p, add_calendar_period(cessation, 1 calendar_month));
}

@source(CSS_R552_2, CSS_R552_2_CSS_ED2021_05, CSS_R552_2_CSS_ED2021_11, CSS_R552_2_CSS_ED2021_12,
        CSS_R552_2_CSS_ED2022_01, CSS_R552_2_CSS_ED2022_02, CSS_R552_2_CSS_ED2022_03,
