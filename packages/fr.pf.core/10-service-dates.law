rule DuesAjppMoisDemande(p: Personne, depot: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "AJPP due dès le premier jour du mois du dépôt, conditions réunies au dépôt (R. 552-2 II 3°)";
    label en unofficial "AJPP due from the first day of the filing month, conditions met at filing (R. 552-2 II 3)";
    when demande_deposee_mois(p, depot) and conditions_ajpp_reunies_depot(p, depot);
    then prestations_dues_a_compter(p, depot);
}

@source(CSS_R552_2, CSS_R552_2_CSS_ED2021_05, CSS_R552_2_CSS_ED2021_11, CSS_R552_2_CSS_ED2021_12,
