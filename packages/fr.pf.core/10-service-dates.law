rule ArreteL5524Ministres(p: Personne, e: Enfant) strict {
    effective [@2021-01-01, infinity);
    label fr official "Scolarité: arrêté interministériel éducation/agriculture/budget/sécurité sociale (D. 552-6 al. 2)";
    label en unofficial "Schooling: joint education/agriculture/budget/social-security order (D. 552-6 para. 2)";
    when parent_charge(p, e);
    then arrete_l5524_quatre_ministres(e);
}

@source(CSS_D552_6, CSS_D552_6_CSS_ED2021_05, CSS_D552_6_CSS_ED2021_11, CSS_D552_6_CSS_ED2021_12,
        CSS_D552_6_CSS_ED2022_01, CSS_D552_6_CSS_ED2022_02, CSS_D552_6_CSS_ED2022_03,
        CSS_D552_6_CSS_ED2022_09, CSS_D552_6_CSS_ED2023_07, CSS_D552_6_CSS_ED2024_01,
        CSS_D552_6_CSS_ED2025_02, CSS_D552_6_CSS_ED2025_09, CSS_D552_6_CSS_ED2025_12,
        CSS_D552_6_CSS_ED2026_01, CSS_D552_6_CSS_ED2026_04, CSS_D552_6_CSS_ED2026_06)
rule ArreteL5525Ministres(p: Personne) defeasible {
    effective [@2021-01-01, infinity);
    label fr official "Arrêté L. 552-5: ministres de l'éducation et de la sécurité sociale (D. 552-6 al. 3)";
    label en unofficial "L. 552-5 order: education and social-security ministers (D. 552-6 para. 3)";
    when allocataire(p);
    then arrete_l5525_deux_ministres(p);
}

@source(CSS_D552_7, CSS_D552_7_CSS_ED2022_02, CSS_D552_7_CSS_ED2022_03, CSS_D552_7_CSS_ED2022_09,
        CSS_D552_7_CSS_ED2023_07, CSS_D552_7_CSS_ED2024_01, CSS_D552_7_CSS_ED2025_02,
        CSS_D552_7_CSS_ED2025_09, CSS_D552_7_CSS_ED2025_12, CSS_D552_7_CSS_ED2026_01,
        CSS_D552_7_CSS_ED2026_04, CSS_D552_7_CSS_ED2026_06,
        CSS_R552_4, CSS_R552_4_CSS_ED2022_02, CSS_R552_4_CSS_ED2022_03, CSS_R552_4_CSS_ED2022_09,
        CSS_R552_4_CSS_ED2023_07, CSS_R552_4_CSS_ED2024_01, CSS_R552_4_CSS_ED2025_02,
        CSS_R552_4_CSS_ED2025_09, CSS_R552_4_CSS_ED2025_12, CSS_R552_4_CSS_ED2026_01,
        CSS_R552_4_CSS_ED2026_04, CSS_R552_4_CSS_ED2026_06)
rule ArsDecesSeuilDecret(e: Enfant, deces: Date, seuil: Date) strict {
    // Decree-anchored companion of ArsDecesApresJuin (09a): the 1 June
    // threshold of D. 552-7 in force 2022-01-31. Both rules conclude the
    // same head; conclusions agree. R. 552-4 gates both producers.
    effective [@2022-01-31, infinity);
    label fr official "ARS due au titre de la rentrée postérieure, décès à compter du 1er juin, droit ouvert avant le mois du décès (D. 552-7, R. 552-4)";
    label en unofficial "ARS for the following school year, death on/after 1 June, right opened before the death month (D. 552-7, R. 552-4)";
    when deces_le(e, deces) and seuil_juin_rentree(e, seuil) and deces >= seuil
        and maintien_applicable(e);
    then ars_due_exceptionnellement(e);
}

@source(CSS_R553_2, CSS_R553_2_CSS_ED2021_05, CSS_R553_2_CSS_ED2021_11, CSS_R553_2_CSS_ED2021_12,
        CSS_R553_2_CSS_ED2022_01, CSS_R553_2_CSS_ED2022_02, CSS_R553_2_CSS_ED2022_03,
        CSS_R553_2_CSS_ED2022_09, CSS_R553_2_CSS_ED2023_07, CSS_R553_2_CSS_ED2024_01,
        CSS_R553_2_CSS_ED2025_02, CSS_R553_2_CSS_ED2025_09, CSS_R553_2_CSS_ED2025_12,
        CSS_R553_2_CSS_ED2026_01, CSS_R553_2_CSS_ED2026_04, CSS_R553_2_CSS_ED2026_06)
rule RessourcesPacs(p: Personne, premier: Money, second: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "Pacs: il est tenu compte du total des ressources des deux partenaires, comme concubins";
    label en unofficial "Civil pact: both partners' total resources count, as concubins";
    when ressources_pacs(p, premier, second);
    then ressources_totales(p, premier + second);
}
