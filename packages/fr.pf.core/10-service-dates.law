        CSS_R552_2_CSS_ED2026_01, CSS_R552_2_CSS_ED2026_04, CSS_R552_2_CSS_ED2026_06)
rule DuesAsfJugePlancher(p: Personne, cessation: Date, plancher: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "ASF créance judiciaire après recouvrement, conditions réunies: au plancher des trois mois quand il est postérieur au mois suivant la cessation";
    label en unofficial "ASF judicial claim after recovery, conditions met: at the three-month floor when it is later than the month after cessation";
    when fixation_judiciaire_apres_recouvrement(p) and cessation_defaut_mois(p, cessation)
        and plancher_3_mois_demande(p, plancher) and conditions_asf_reunies(p)
        and plancher > add_calendar_period(cessation, 1 calendar_month);
    then prestations_dues_a_compter(p, plancher);
}

@source(CSS_R552_3, CSS_R552_3_CSS_ED2022_02, CSS_R552_3_CSS_ED2022_03, CSS_R552_3_CSS_ED2022_09,
