rule CessentMoisMeme(p: Personne, ancre: Date) strict {
    effective [@2022-01-31, infinity);
    label fr official "Prestations mensuelles cessant dès le premier jour du mois de cessation des conditions";
    label en unofficial "Monthly benefits ceasing from the first day of the conditions-cessation month";
    when conditions_cessent_mois(p, ancre) and not prestation_cmg(p) and not prestation_ajpp(p)
        and not prestation_aeeh(p);
    then prestations_cessent_a_compter(p, ancre);
}

@source(CSS_R552_3, CSS_R552_3_CSS_ED2022_02, CSS_R552_3_CSS_ED2022_03, CSS_R552_3_CSS_ED2022_09,
