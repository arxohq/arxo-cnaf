rule CessentCmgMoisSuivant(p: Personne, ancre: Date) strict {
    effective [@2022-01-31, infinity);
    label fr official "CMG cessant le premier jour du mois suivant la cessation des conditions";
    label en unofficial "CMG ceasing on the first day of the month after the conditions end";
    when conditions_cessent_mois(p, ancre) and prestation_cmg(p);
    then prestations_cessent_a_compter(p, add_calendar_period(ancre, 1 calendar_month));
}

@source(CSS_R552_3, CSS_R552_3_CSS_ED2022_02, CSS_R552_3_CSS_ED2022_03, CSS_R552_3_CSS_ED2022_09,
