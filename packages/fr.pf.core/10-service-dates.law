        CSS_R514_1_CSS_ED2026_01, CSS_R514_1_CSS_ED2026_04, CSS_R514_1_CSS_ED2026_06)
rule DerogationEtat(p: Personne) defeater {
    effective [@2021-01-01, infinity);
    label fr official "Victimes de guerre: le rattachement CAF ne s'applique pas";
    label en unofficial "War victims: CAF attachment does not apply - status removed";
    when victime_guerre_ou_ayant_cause(p);
    defeat service_caf_residence(p);
}

@source(CSS_R514_1, CSS_R514_1_CSS_ED2021_05, CSS_R514_1_CSS_ED2021_11, CSS_R514_1_CSS_ED2021_12,
        CSS_R514_1_CSS_ED2022_01, CSS_R514_1_CSS_ED2022_02, CSS_R514_1_CSS_ED2022_03,
        CSS_R514_1_CSS_ED2022_09, CSS_R514_1_CSS_ED2023_07, CSS_R514_1_CSS_ED2024_01,
        CSS_R514_1_CSS_ED2025_02, CSS_R514_1_CSS_ED2025_09, CSS_R514_1_CSS_ED2025_12,
        CSS_R514_1_CSS_ED2026_01, CSS_R514_1_CSS_ED2026_04, CSS_R514_1_CSS_ED2026_06)
rule DerogationL2121(p: Personne) defeater {
    effective [@2021-01-01, infinity);
    label fr official "Catégories L. 212-1: le rattachement CAF ne s'applique pas (organisme déterminé par l'article extérieur)";
    label en unofficial "L. 212-1 categories: CAF attachment does not apply (body set by the external article) - status removed";
    when categorie_l212_1(p);
    defeat service_caf_residence(p);
}

@source(CSS_R514_1, CSS_R514_1_CSS_ED2021_05, CSS_R514_1_CSS_ED2021_11, CSS_R514_1_CSS_ED2021_12,
        CSS_R514_1_CSS_ED2022_01, CSS_R514_1_CSS_ED2022_02, CSS_R514_1_CSS_ED2022_03,
        CSS_R514_1_CSS_ED2022_09, CSS_R514_1_CSS_ED2023_07, CSS_R514_1_CSS_ED2024_01,
        CSS_R514_1_CSS_ED2025_02, CSS_R514_1_CSS_ED2025_09, CSS_R514_1_CSS_ED2025_12,
        CSS_R514_1_CSS_ED2026_01, CSS_R514_1_CSS_ED2026_04, CSS_R514_1_CSS_ED2026_06)
rule DerogationArrete(p: Personne) defeater {
    effective [@2021-01-01, infinity);
    label fr official "Dérogation par arrêté: le rattachement CAF ne s'applique pas";
    label en unofficial "Arrete derogation: CAF attachment does not apply - status removed";
    when derogation_arrete_rattachement(p);
    defeat service_caf_residence(p);
}

@source(CSS_R514_1, CSS_R514_1_CSS_ED2021_05, CSS_R514_1_CSS_ED2021_11, CSS_R514_1_CSS_ED2021_12,
