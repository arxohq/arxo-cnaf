        CSS_R552_4_CSS_ED2023_07, CSS_R552_4_CSS_ED2024_01, CSS_R552_4_CSS_ED2025_02,
        CSS_R552_4_CSS_ED2025_09, CSS_R552_4_CSS_ED2025_12, CSS_R552_4_CSS_ED2026_01,
        CSS_R552_4_CSS_ED2026_04, CSS_R552_4_CSS_ED2026_06)
rule EnfantCompteFinTroisiemeMois(e: Enfant, deces: Date) strict {
    effective [@2022-01-31, infinity);
    label fr official "Enfant à charge décédé: AF et CF versés en tenant compte de l'enfant jusqu'au dernier jour du troisième mois, droit ouvert avant le mois du décès";
    label en unofficial "Deceased child in care: AF and CF paid counting the child up to the last day of the third month, right opened before the death month";
    when deces_le(e, deces) and deces_enfant_charge(e) and maintien_applicable(e);
    then enfant_compte_fin(e, month_end_of(add_calendar_period(deces, 3 calendar_month)));
}

@source(CSS_R552_3, CSS_R552_3_CSS_ED2022_02, CSS_R552_3_CSS_ED2022_03, CSS_R552_3_CSS_ED2022_09,
