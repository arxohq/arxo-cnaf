// Policy for month steps (section 86) - FORWARD only.
deadline policy SERVICE_MOIS {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}

// --- R. 514-1: debtor body ---

relation releve_professions_agricoles(p: Personne) kind empirical {
    label fr official "personne soumise aux dispositions relatives aux professions agricoles, ou conjoint/concubin allocataire sans activité (R. 514-1 1°)";
    label en unofficial "person under agricultural-profession rules, or non-working allocataire spouse/partner (R. 514-1 1)";
}

relation victime_guerre_ou_ayant_cause(p: Personne) kind empirical {
    label fr official "victime de guerre ou ayant cause de victime de guerre (R. 514-1 2°)";
    label en unofficial "war victim or war-victim successor (R. 514-1 2)";
}

relation categorie_l212_1(p: Personne) kind empirical {
    label fr official "catégorie en activité ou en retraite du deuxième alinéa de L. 212-1 (article extérieur, fait d'entrée — R. 514-1 3°)";
    label en unofficial "working or retired category of L. 212-1 para. 2 (external article, input fact - R. 514-1 3)";
}

relation derogation_arrete_rattachement(p: Personne) kind empirical {
    label fr official "dérogation de rattachement par arrêté ministériel (activité, dispersion, déplacements — arrêté non épinglé, R. 514-1 al. 5)";
    label en unofficial "attachment derogation by ministerial arrete (unpinned arrete, R. 514-1 para. 5)";
}

relation service_caf_residence(p: Personne) kind institutional {
    key(p);
    label fr official "le service incombe à la CAF du lieu de résidence habituelle de la famille (R. 514-1)";
    label en unofficial "service falls on the CAF of the family's usual residence (R. 514-1)";
}

relation service_msa(p: Personne) kind institutional {
    key(p);
    label fr official "le service incombe à la MSA du lieu de résidence habituelle (R. 514-1 1°)";
    label en unofficial "service falls on the MSA of the usual residence (R. 514-1 1)";
}

relation service_etat(p: Personne) kind institutional {
    key(p);
    label fr official "les prestations sont servies par l'Etat (R. 514-1 2°)";
    label en unofficial "benefits are served by the State (R. 514-1 2)";
}

// --- R. 552-1: regime transfer ---

relation transfert_regime(p: Personne) kind empirical {
    label fr official "allocataire temporairement ou définitivement transféré à un autre régime (R. 552-1)";
    label en unofficial "allocataire temporarily or permanently transferred to another scheme (R. 552-1)";
}

relation service_incombe_regime_primitif(p: Personne) kind institutional {
    key(p);
    label fr official "le service incombe au régime primitif jusqu'à régularisation administrative (R. 552-1)";
    label en unofficial "service falls on the original scheme until administrative settlement (R. 552-1)";
}

relation regularisation_administrative_le(p: Personne, date: Date) kind empirical {
    key(p);
    label fr official "régularisation administrative du transfert intervenue à cette date (R. 552-1 « jusqu'à régularisation »)";
    label en unofficial "administrative settlement of the transfer occurring on this date (R. 552-1 'until settlement')";
}

relation transfert_non_regularise_atteste(p: Personne) kind empirical {
    label fr official "transfert sans régularisation administrative intervenue, attesté (R. 552-1 « jusqu'à régularisation »)";
    label en unofficial "transfer without administrative settlement having occurred, attested (R. 552-1 'until settlement')";
}

relation regularisation_intervenue(p: Personne) kind institutional {
    key(p);
    label fr official "la régularisation administrative du transfert est intervenue (R. 552-1)";
    label en unofficial "administrative settlement of the transfer has occurred (R. 552-1)";
}

relation remboursement_regimes_action(o: Organisme, p: Personne) kind empirical {
    key(o, p);
    label fr official "action: poursuivre le remboursement auprès de l'autre régime";
    label en unofficial "action: claiming reimbursement from the other scheme";
}

// --- R. 552-2: due-from dates ---

relation conditions_reunies_mois(p: Personne, premier_jour: Date) kind empirical {
    key(p);
    label fr official "premier jour du mois civil au cours duquel les conditions d'ouverture sont réunies (ancre mensuelle déclarée)";
    label en unofficial "first day of the month in which opening conditions are met (stated month anchor)";
}

relation demande_deposee_mois(p: Personne, premier_jour: Date) kind empirical {
    key(p);
    label fr official "premier jour du mois civil du dépôt de la demande (ancre mensuelle déclarée)";
    label en unofficial "first day of the month the claim was filed (stated month anchor)";
}

relation conditions_ajpp_reunies_depot(p: Personne, premier_jour: Date) kind empirical {
    key(p);
    label fr official "conditions d'ouverture AJPP réunies à la date du dépôt, fait constaté (R. 552-2 II 3°, branche AJPP)";
    label en unofficial "AJPP opening conditions met at the filing date, stated fact (R. 552-2 II 3, AJPP branch)";
}

relation conditions_asf_reunies(p: Personne) kind empirical {
    label fr official "conditions d'ouverture ASF réunies, fait constaté (R. 552-2 III, branches juge)";
    label en unofficial "ASF opening conditions met, stated fact (R. 552-2 III, judicial branches)";
}

relation prepare_enfant_unique_ou_option(p: Personne) kind empirical {
    label fr official "PreParE à enfant unique ou option L. 531-4 VI exercée (mécanique de l'option: paquet fr.pf.paje — R. 552-2 II 1°)";
    label en unofficial "single-child PreParE or L. 531-4 VI option taken (option mechanics: fr.pf.paje - R. 552-2 II 1)";
}

relation mois_precedent_demande(p: Personne, date: Date) kind empirical {
    key(p);
    label fr official "premier jour du mois civil précédant le dépôt CMG, conditions réunies (pas de recul mensuel calculé — R. 552-2 II 2°)";
    label en unofficial "first day of the month before the CMG filing, conditions met (no computed backward step - R. 552-2 II 2)";
}

relation demande_meme_mois(p: Personne) kind empirical {
    label fr official "demande CMG déposée au cours du mois des conditions (R. 552-2 II 2°)";
    label en unofficial "CMG claim filed within the conditions month (R. 552-2 II 2)";
}

relation droit_ouvert_autre_enfant(p: Personne) kind empirical {
    label fr official "droit CMG déjà ouvert au titre d'un autre enfant (R. 552-2 II 2°)";
    label en unofficial "CMG right already open for another child (R. 552-2 II 2)";
}

relation asf_cas3_soustrait_seul(p: Personne) kind empirical {
    label fr official "un parent au moins se soustrait à l'entretien sans être hors d'état (ASF L. 523-1 I 3° — R. 552-2 II 5°)";
    label en unofficial "at least one parent evading maintenance without being unable (ASF L. 523-1 I 3 - R. 552-2 II 5)";
}

relation fixation_judiciaire_apres_recouvrement(p: Personne) kind empirical {
    label fr official "créance fixée par le juge à l'issue d'une procédure de recouvrement contre le parent défaillant (R. 552-2 II 5°)";
    label en unofficial "claim set by the judge after recovery proceedings against the defaulting parent (R. 552-2 II 5)";
}

relation cessation_defaut_mois(p: Personne, premier_jour: Date) kind empirical {
    key(p);
    label fr official "premier jour du mois de cessation du défaut d'entretien (ancre mensuelle déclarée — R. 552-2 II 5°)";
    label en unofficial "first day of the maintenance-default cessation month (stated anchor - R. 552-2 II 5)";
}

relation plancher_3_mois_demande(p: Personne, date: Date) kind empirical {
    key(p);
    label fr official "premier jour du mois, trois mois avant le dépôt (plancher déclaré, pas de recul calculé — R. 552-2 II 5°)";
    label en unofficial "first day of the month three months before filing (stated floor, no computed step - R. 552-2 II 5)";
}

relation prestations_dues_a_compter(p: Personne, date: Date) kind institutional {
    key(p);
    label fr official "prestations mensuelles dues à compter de cette date (R. 552-2)";
    label en unofficial "monthly benefits due from this date (R. 552-2)";
}

// --- R. 552-3: cessation dates ---

relation conditions_cessent_mois(p: Personne, premier_jour: Date) kind empirical {
    key(p);
    label fr official "premier jour du mois civil de cessation des conditions (ancre mensuelle déclarée — R. 552-3 I/II)";
    label en unofficial "first day of the conditions-cessation month (stated anchor - R. 552-3 I/II)";
}

relation prestation_cmg(p: Personne) kind empirical {
    label fr official "la prestation en cause est le CMG (entrée II 1° — R. 552-3 II 1°)";
    label en unofficial "the benefit at issue is the CMG (II 1 entry - R. 552-3 II 1)";
}

relation prestation_ajpp(p: Personne) kind empirical {
    label fr official "la prestation en cause est l'AJPP (entrée II 3° — R. 552-3 II 3°)";
    label en unofficial "the benefit at issue is the AJPP (II 3 entry - R. 552-3 II 3)";
}

relation prestation_aeeh(p: Personne) kind empirical {
    label fr official "la prestation en cause est l'AEEH, service et cessation régis par renvoi (R. 552-2 II 3°, R. 552-3 II 2°, R. 552-4)";
    label en unofficial "the benefit at issue is the AEEH, service and cessation governed by renvoi (R. 552-2 II 3, R. 552-3 II 2, R. 552-4)";
}

relation deces_proche_mois(p: Personne, premier_jour: Date) kind empirical {
    key(p);
    label fr official "premier jour du mois civil du décès (allocataire, conjoint, enfant — ancre déclarée — R. 552-3 III)";
    label en unofficial "first day of the death month (allocataire, spouse, child - stated anchor - R. 552-3 III)";
}

relation cas_exception_l531_10(p: Personne) kind empirical {
    label fr official "cas de l'article L. 531-10 excepté de la cessation-décès (rédaction 2015, paquet fr.pf.paje — R. 552-3 III prev)";
    label en unofficial "L. 531-10 case exempt from death-cessation (2015 text, fr.pf.paje - R. 552-3 III prev)";
}

relation prestations_cessent_a_compter(p: Personne, date: Date) kind institutional {
    key(p);
    label fr official "prestations mensuelles cessant d'être dues à compter de cette date (R. 552-3)";
    label en unofficial "monthly benefits ceasing to be due from this date (R. 552-3)";
}

relation maintien_prestations_fin(e: Enfant, date: Date) kind institutional {
    key(e);
    label fr official "prestations maintenues jusqu'à cette date incluse (dernier jour du 3e mois — R. 552-3 IV 1°)";
    label en unofficial "benefits maintained up to and including this date (last day of the 3rd month - R. 552-3 IV 1)";
}

relation enfant_compte_fin(e: Enfant, date: Date) kind institutional {
    key(e);
    label fr official "enfant décédé compté jusqu'à cette date incluse (R. 552-3 IV 2°)";
    label en unofficial "deceased child counted up to and including this date (R. 552-3 IV 2)";
}

relation frais_tiers_restent_dus(e: Enfant) kind empirical {
    label fr official "des frais L. 553-4 I 2° restent dus à la personne percevant l'AEEH (R. 552-3 IV 3°)";
    label en unofficial "L. 553-4 I 2 costs still owed to the AEEH recipient (R. 552-3 IV 3)";
}

relation interruption_versement_demandee(e: Enfant) kind empirical {
    label fr official "la personne demande l'interruption du versement AEEH (R. 552-3 IV 3°)";
    label en unofficial "person requests termination of the AEEH payment (R. 552-3 IV 3)";
}

relation aeeh_tiers_maintenue_fin(e: Enfant, date: Date) kind institutional {
    key(e);
    label fr official "AEEH au tiers maintenue jusqu'à cette date incluse (R. 552-3 IV 3°)";
    label en unofficial "AEEH to the third party maintained up to and including this date (R. 552-3 IV 3)";
}

// --- R. 552-4: maintien conditions ---

relation ouverture_droit_mois(e: Enfant, premier_jour: Date) kind empirical {
    key(e);
    label fr official "premier jour d'ouverture du droit aux prestations (ancre mensuelle déclarée — R. 552-4)";
    label en unofficial "right-opening first day (stated month anchor - R. 552-4)";
}

relation maintien_applicable(e: Enfant) kind institutional {
    key(e);
    label fr official "L. 552-7 applicable: décès au plus tôt le mois suivant l'ouverture (R. 552-4)";
    label en unofficial "L. 552-7 applies: death no earlier than the month after opening (R. 552-4)";
}

relation montant_mois_deces(e: Enfant, montant: Money) kind empirical {
    key(e);
    label fr official "montant dû au titre du mois du décès (R. 552-4)";
    label en unofficial "amount due for the month of death (R. 552-4)";
}

relation montant_maintenu(e: Enfant, montant: Money) kind institutional {
    key(e);
    label fr official "montant des prestations maintenues (R. 552-4, sous R. 541-1 — fr.pf.aeeh)";
    label en unofficial "maintained benefits amount (R. 552-4, under R. 541-1 - fr.pf.aeeh)";
}

relation conditions_maintien_applicables(e: Enfant) kind institutional {
    key(e);
    label fr official "conditions d'ouverture et règles propres maintenues pendant le maintien (R. 552-4, sous L. 552-7 dernier al.)";
    label en unofficial "opening conditions and benefit rules kept during maintien (R. 552-4, under L. 552-7 last para.)";
}

// --- L. 552-7: deceased child counts, ASF advance ---

relation enfant_compte_apres_deces(e: Enfant) kind institutional {
    key(e);
    label fr official "l'enfant décédé compte pour les conditions des prestations des autres enfants (L. 552-7 phr. 2 et 5, article à alinéa unique)";
    label en unofficial "deceased child counts for other children's benefit conditions (L. 552-7 sentences 2 and 5, single-paragraph article)";
}

relation asf_avance_creance(p: Personne, e: Enfant) kind empirical {
    key(p, e);
    label fr official "ASF servie à titre d'avance sur créance alimentaire impayée (L. 552-7 phr. 3, article à alinéa unique)";
    label en unofficial "ASF paid as an advance on an unpaid maintenance claim (L. 552-7 sentence 3, single-paragraph article)";
}

relation asf_avance_non_recouvree(p: Personne, e: Enfant) kind institutional {
    key(p, e);
    label fr official "l'avance ASF n'est pas recouvrée auprès du parent débiteur et demeure acquise au parent créancier pendant le maintien (L. 552-7 phr. 3)";
    label en unofficial "ASF advance not recovered from the debtor parent, kept by the creditor parent during maintien (L. 552-7 sentence 3)";
}

// --- L. 552-4: schooling pieces ---

relation certificat_inscription_le(p: Personne, e: Enfant, date: Date) kind empirical {
    key(p, e);
    label fr official "certificat d'inscription scolaire produit à cette date (L. 552-4 al. 1)";
    label en unofficial "school enrolment certificate produced on this date (L. 552-4 para. 1)";
}

relation autorisation_l1315_le(p: Personne, e: Enfant, date: Date) kind empirical {
    key(p, e);
    label fr official "autorisation L. 131-5 du code de l'éducation produite à cette date (rédaction 2022 — L. 552-4 al. 1)";
    label en unofficial "L. 131-5 education-code authorisation produced on this date (2022 text - L. 552-4 para. 1)";
}

relation certificat_instruction_famille_le(p: Personne, e: Enfant, date: Date) kind empirical {
    key(p, e);
    label fr official "certificat d'instruction en famille produit à cette date (rédaction 1985 — L. 552-4 al. 1 prev)";
    label en unofficial "home-schooling certificate produced on this date (1985 text - L. 552-4 para. 1 prev)";
}

relation certificat_medical_le(p: Personne, e: Enfant, date: Date) kind empirical {
    key(p, e);
    label fr official "certificat médical d'impossibilité de fréquentation produit à cette date (rédaction 1985 — L. 552-4 al. 1 prev)";
    label en unofficial "medical certificate of non-attendance produced on this date (1985 text - L. 552-4 para. 1 prev)";
}

relation pieces_scolarite_absentes(p: Personne, e: Enfant) kind empirical {
    key(p, e);
    label fr official "aucune pièce de scolarité produite (absence déclarée — L. 552-4 al. 2, rédaction 2022)";
    label en unofficial "no schooling piece produced (stated absence - L. 552-4 para. 2, 2022 text)";
}

@source(CSS_L552_4, CSS_L552_4_CSS_ED2023_07, CSS_L552_4_CSS_ED2024_01,
        CSS_L552_4_CSS_ED2025_02, CSS_L552_4_CSS_ED2025_09, CSS_L552_4_CSS_ED2025_12,
        CSS_L552_4_CSS_ED2026_01, CSS_L552_4_CSS_ED2026_04, CSS_L552_4_CSS_ED2026_06,
        CSS_L552_4_PREV, CSS_L552_4_PREV_CSS_ED2021_05, CSS_L552_4_PREV_CSS_ED2021_11,
        CSS_L552_4_PREV_CSS_ED2021_12, CSS_L552_4_PREV_CSS_ED2022_01,
        CSS_L552_4_PREV_CSS_ED2022_02, CSS_L552_4_PREV_CSS_ED2022_03)
external judgment relation retard_independant_volonte(p: Personne, e: Enfant) {
    authority Organisme;
    label fr official "le retard de production résulte de motifs indépendants de la volonté (L. 552-4 al. 2)";
    label en unofficial "production delay caused by reasons beyond control (L. 552-4 para. 2)";
}

relation prestations_dues_scolarite(p: Personne, e: Enfant, date: Date) kind institutional {
    key(p, e);
    label fr official "prestations dues à compter de la production de la pièce (L. 552-4 al. 2)";
    label en unofficial "benefits due from production of the piece (L. 552-4 para. 2)";
}

relation versement_bloque_pieces(p: Personne, e: Enfant) kind institutional {
    key(p, e);
    label fr official "aucune des prestations afférentes à l'enfant soumis à l'obligation scolaire ne peut être versée sans pièce (L. 552-4 al. 1-2, rédaction 2022)";
    label en unofficial "none of the benefits relating to the child subject to compulsory schooling may be paid without a piece (L. 552-4 paras. 1-2, 2022 text)";
}

relation versement_retroactif_possible(p: Personne, e: Enfant) kind institutional {
    key(p, e);
    label fr official "prestations rétroactivement payées ou rétablies (L. 552-4 al. 2)";
    label en unofficial "benefits retroactively paid or restored (L. 552-4 para. 2)";
}

// --- R. 553-2: pacs assimilation ---

relation ressources_pacs(p: Personne, premier: Money, second: Money) kind empirical {
    key(p);
    label fr official "ressources de chacun des partenaires de pacs durant l'année de référence (R. 553-2, comme concubins)";
    label en unofficial "resources of each civil-pact partner for the reference year (R. 553-2, as concubins)";
}

@source(CSS_R514_1, CSS_R514_1_CSS_ED2021_05, CSS_R514_1_CSS_ED2021_11, CSS_R514_1_CSS_ED2021_12,
        CSS_R514_1_CSS_ED2022_01, CSS_R514_1_CSS_ED2022_02, CSS_R514_1_CSS_ED2022_03,
        CSS_R514_1_CSS_ED2022_09, CSS_R514_1_CSS_ED2023_07, CSS_R514_1_CSS_ED2024_01,
        CSS_R514_1_CSS_ED2025_02, CSS_R514_1_CSS_ED2025_09, CSS_R514_1_CSS_ED2025_12,
        CSS_R514_1_CSS_ED2026_01, CSS_R514_1_CSS_ED2026_04, CSS_R514_1_CSS_ED2026_06)
rule ServiceCafResidence(p: Personne) defeasible {
    effective [@2021-01-01, infinity);
    label fr official "Le service incombe à la CAF du lieu de résidence habituelle de la famille";
    label en unofficial "Service falls on the CAF of the family's usual residence";
    when allocataire(p);
    then service_caf_residence(p);
}

@source(CSS_R514_1, CSS_R514_1_CSS_ED2021_05, CSS_R514_1_CSS_ED2021_11, CSS_R514_1_CSS_ED2021_12,
        CSS_R514_1_CSS_ED2022_01, CSS_R514_1_CSS_ED2022_02, CSS_R514_1_CSS_ED2022_03,
        CSS_R514_1_CSS_ED2022_09, CSS_R514_1_CSS_ED2023_07, CSS_R514_1_CSS_ED2024_01,
        CSS_R514_1_CSS_ED2025_02, CSS_R514_1_CSS_ED2025_09, CSS_R514_1_CSS_ED2025_12,
        CSS_R514_1_CSS_ED2026_01, CSS_R514_1_CSS_ED2026_04, CSS_R514_1_CSS_ED2026_06)
rule DerogationMSA(p: Personne) defeater {
    effective [@2021-01-01, infinity);
    label fr official "Professions agricoles: le rattachement CAF ne s'applique pas";
    label en unofficial "Agricultural professions: CAF attachment does not apply - status removed";
    when releve_professions_agricoles(p);
    defeat service_caf_residence(p);
}

@source(CSS_R514_1, CSS_R514_1_CSS_ED2021_05, CSS_R514_1_CSS_ED2021_11, CSS_R514_1_CSS_ED2021_12,
        CSS_R514_1_CSS_ED2022_01, CSS_R514_1_CSS_ED2022_02, CSS_R514_1_CSS_ED2022_03,
