        CSS_R552_3_CSS_ED2026_04, CSS_R552_3_CSS_ED2026_06)
rule CessentDecesMoisSuivant(p: Personne, deces: Date) strict {
    effective [@2022-01-31, infinity);
    label fr official "Décès: prestations cessant au premier jour du mois civil qui suit le décès";
    label en unofficial "Death: benefits ceasing on the first day of the month after death";
    when deces_proche_mois(p, deces);
    then prestations_cessent_a_compter(p, add_calendar_period(deces, 1 calendar_month));
}

@source(CSS_R552_3, CSS_R552_3_CSS_ED2022_02, CSS_R552_3_CSS_ED2022_03, CSS_R552_3_CSS_ED2022_09,
        CSS_R552_3_CSS_ED2023_07, CSS_R552_3_CSS_ED2024_01, CSS_R552_3_CSS_ED2025_02,
        CSS_R552_3_CSS_ED2025_09, CSS_R552_3_CSS_ED2025_12, CSS_R552_3_CSS_ED2026_01,
        CSS_R552_3_CSS_ED2026_04, CSS_R552_3_CSS_ED2026_06,
        CSS_R552_4, CSS_R552_4_CSS_ED2022_02, CSS_R552_4_CSS_ED2022_03, CSS_R552_4_CSS_ED2022_09,
        CSS_R552_4_CSS_ED2023_07, CSS_R552_4_CSS_ED2024_01, CSS_R552_4_CSS_ED2025_02,
        CSS_R552_4_CSS_ED2025_09, CSS_R552_4_CSS_ED2025_12, CSS_R552_4_CSS_ED2026_01,
        CSS_R552_4_CSS_ED2026_04, CSS_R552_4_CSS_ED2026_06)
rule MaintienFinTroisiemeMois(e: Enfant, deces: Date) strict {
    // Source endpoint: last day of the third following civil month
    // (E-0084 month_end_of of the +3-month step; PC-R03-01).
    effective [@2022-01-31, infinity);
    label fr official "Enfant à charge décédé: prestations maintenues jusqu'au dernier jour du troisième mois civil qui suit le décès, droit ouvert avant le mois du décès";
    label en unofficial "Deceased child in care: benefits maintained up to the last day of the third month after death, right opened before the death month";
    when deces_le(e, deces) and deces_enfant_charge(e) and maintien_applicable(e);
    then maintien_prestations_fin(e, month_end_of(add_calendar_period(deces, 3 calendar_month)));
}

@source(CSS_R552_3, CSS_R552_3_CSS_ED2022_02, CSS_R552_3_CSS_ED2022_03, CSS_R552_3_CSS_ED2022_09,
