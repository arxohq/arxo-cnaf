        CSS_R553_3_3_CSS_ED2024_01, CSS_R553_3_3_CSS_ED2025_02, CSS_R553_3_3_CSS_ED2025_09,
        CSS_R553_3_3_CSS_ED2025_12, CSS_R553_3_3_CSS_ED2026_01, CSS_R553_3_3_CSS_ED2026_04,
        CSS_R553_3_3_CSS_ED2026_06)
rule ArtBienValeurRetenueAssurance(p: Personne, b: Bien, valeur: Money, part: Decimal, date: Date, preuve: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "Objet d'art retenu: valeur réelle à la disposition étayée par l'assurance chiffrée du même bien, sans égalité imposée (R. 553-3-1 7° + II 2° a)";
    label en unofficial "Art item retained: real disposal value supported by the same-item insurance amount, no forced equality (R. 553-3-1 7 + II 2 a)";
    when art_bien_valeur(p, b, valeur, part) and art_bien_date(p, b, date)
        and art_bien_preuve_assurance(p, b, preuve)
        and section_train_vie_applicable(p);
    then art_bien_valeur_retenue(p, b, valeur, part, date);
}

