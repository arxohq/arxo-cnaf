        CSS_R553_3_3_CSS_ED2026_06)
rule ArtBienJustifieAssurance(p: Personne, b: Bien, preuve: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "Objet d'art étayé par le montant garanti d'assurance chiffré du même bien (R. 553-3-1 II 2° a)";
    label en unofficial "Art item supported by the same-item amount-bearing insurance guarantee (R. 553-3-1 II 2 a)";
    when art_bien_preuve_assurance(p, b, preuve)
        and section_train_vie_applicable(p);
    then art_bien_justifie(p, b);
}

