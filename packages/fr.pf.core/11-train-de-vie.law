        CSS_R553_3_3_CSS_ED2026_06)
rule NonBatieBienRetenuDirect(p: Personne, b: Bien, montant: Money, part: Decimal) strict {
    effective [@2021-01-01, infinity);
    label fr official "Non bâtie directe par bien: valeur locative applicable et connue retenue (R. 553-3-1 2°)";
    label en unofficial "Direct unbuilt per item: applicable and known rental value retained (R. 553-3-1 2)";
    when non_batie_bien_valeur(p, b, montant, part) and not_known(non_batie_bien_inapplicable(p, b))
        and section_train_vie_applicable(p);
    then non_batie_bien_retenue(p, b, montant, part);
}

