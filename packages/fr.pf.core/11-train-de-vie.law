        CSS_R553_3_3_CSS_ED2026_06)
rule ApportForfaitairePoste(p: Personne, k: PosteTrainVie, m: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "Apport d'un poste de dépenses ou de capitaux: apport au forfait du train de vie (R. 553-3-1 3°, 4°, 6°, 8°, 9°, 10°)";
    label en unofficial "Spending or capital line contribution: contribution to the lifestyle schedule (R. 553-3-1 3, 4, 6, 8, 9, 10)";
    when apport_poste(p, k, m);
    then apport_forfaitaire(p, m);
}

@source(CSS_R553_3_1, CSS_R553_3_1_CSS_ED2021_05, CSS_R553_3_1_CSS_ED2021_11,
        CSS_R553_3_1_CSS_ED2021_12, CSS_R553_3_1_CSS_ED2022_01, CSS_R553_3_1_CSS_ED2022_02,
        CSS_R553_3_1_CSS_ED2022_03, CSS_R553_3_1_CSS_ED2022_09, CSS_R553_3_1_CSS_ED2023_07,
        CSS_R553_3_1_CSS_ED2024_01, CSS_R553_3_1_CSS_ED2025_02, CSS_R553_3_1_CSS_ED2025_09,
        CSS_R553_3_1_CSS_ED2025_12, CSS_R553_3_1_CSS_ED2026_01, CSS_R553_3_1_CSS_ED2026_04,
        CSS_R553_3_1_CSS_ED2026_06,
        CSS_R553_3_3, CSS_R553_3_3_CSS_ED2021_05, CSS_R553_3_3_CSS_ED2021_11,
        CSS_R553_3_3_CSS_ED2021_12, CSS_R553_3_3_CSS_ED2022_01, CSS_R553_3_3_CSS_ED2022_02,
        CSS_R553_3_3_CSS_ED2022_03, CSS_R553_3_3_CSS_ED2022_09, CSS_R553_3_3_CSS_ED2023_07,
        CSS_R553_3_3_CSS_ED2024_01, CSS_R553_3_3_CSS_ED2025_02, CSS_R553_3_3_CSS_ED2025_09,
        CSS_R553_3_3_CSS_ED2025_12, CSS_R553_3_3_CSS_ED2026_01, CSS_R553_3_3_CSS_ED2026_04,
        CSS_R553_3_3_CSS_ED2026_06)
rule EvaluationForfaitaireTotale(p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "Evaluation forfaitaire: somme des apports par bien et par poste, inventaire complet (R. 553-3-1, II 1° aux dépenses, II 2° aux valeurs vénales)";
    label en unofficial "Scheduled evaluation: sum of the per-item and per-category apports, complete inventory (R. 553-3-1, II 1 for spending, II 2 for market values)";
    when section_train_vie_applicable(p) and inventaire_tdv_complet(p);
    then evaluation_forfaitaire_train_vie(p,
            sum(collect all m: Money, b: Bien where apport_bien(p, b, m), empty: 0.00 EUR)
            + sum(collect all m: Money, k: PosteTrainVie where apport_poste(p, k, m), empty: 0.00 EUR));
}

@source(CSS_R553_3_4, CSS_R553_3_4_CSS_ED2021_05, CSS_R553_3_4_CSS_ED2021_11,
        CSS_R553_3_4_CSS_ED2021_12, CSS_R553_3_4_CSS_ED2022_01, CSS_R553_3_4_CSS_ED2022_02,
        CSS_R553_3_4_CSS_ED2022_03, CSS_R553_3_4_CSS_ED2022_09, CSS_R553_3_4_CSS_ED2023_07,
        CSS_R553_3_4_CSS_ED2024_01, CSS_R553_3_4_CSS_ED2025_02, CSS_R553_3_4_CSS_ED2025_09,
        CSS_R553_3_4_CSS_ED2025_12, CSS_R553_3_4_CSS_ED2026_01, CSS_R553_3_4_CSS_ED2026_04,
        CSS_R553_3_4_CSS_ED2026_06)
rule InformerProcedure(o: Organisme, p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "L'organisme informe par lettre recommandée avec accusé de réception et tout le contenu obligatoire du 1° et du 2°";
    label en unofficial "The body informs by registered letter with acknowledgement of receipt and all mandatory 1 and 2 content";
    when organisme_debiteur_pf(o, p) and procedure_train_vie_envisagee(p)
        and section_train_vie_applicable(p);
    then duty InformerProcedureTrainVie {
        bearer o;
        beneficiary p;
        maintain lettre_procedure_conforme(o, p) during [@2021-01-01, infinity);
    };
}

@source(CSS_R553_3_4, CSS_R553_3_4_CSS_ED2021_05, CSS_R553_3_4_CSS_ED2021_11,
        CSS_R553_3_4_CSS_ED2021_12, CSS_R553_3_4_CSS_ED2022_01, CSS_R553_3_4_CSS_ED2022_02,
        CSS_R553_3_4_CSS_ED2022_03, CSS_R553_3_4_CSS_ED2022_09, CSS_R553_3_4_CSS_ED2023_07,
        CSS_R553_3_4_CSS_ED2024_01, CSS_R553_3_4_CSS_ED2025_02, CSS_R553_3_4_CSS_ED2025_09,
        CSS_R553_3_4_CSS_ED2025_12, CSS_R553_3_4_CSS_ED2026_01, CSS_R553_3_4_CSS_ED2026_04,
        CSS_R553_3_4_CSS_ED2026_06)
rule LettreConforme(o: Organisme, p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "Lettre conforme: recommandée avec accusé de réception et six mentions obligatoires (procédure, audition et conseil, sanctions, transmission, questionnaire, pièces et avertissement L. 583-3)";
    label en unofficial "Conforming letter: registered with acknowledgement of receipt and the six mandatory items (procedure, hearing and counsel, sanctions, transmission, questionnaire, documents and L. 583-3 warning)";
    when lettre_procedure_adressee(o, p) and lettre_procedure_accuse_reception(o, p)
        and lettre_contenu_procedure(o, p) and lettre_contenu_audition_conseil(o, p)
        and lettre_contenu_sanctions(o, p) and lettre_contenu_transmission(o, p)
        and lettre_contenu_questionnaire(o, p) and lettre_contenu_pieces_l5833(o, p)
        and section_train_vie_applicable(p);
    then lettre_procedure_conforme(o, p);
}

@source(CSS_R553_3_4, CSS_R553_3_4_CSS_ED2021_05, CSS_R553_3_4_CSS_ED2021_11,
        CSS_R553_3_4_CSS_ED2021_12, CSS_R553_3_4_CSS_ED2022_01, CSS_R553_3_4_CSS_ED2022_02,
        CSS_R553_3_4_CSS_ED2022_03, CSS_R553_3_4_CSS_ED2022_09, CSS_R553_3_4_CSS_ED2023_07,
        CSS_R553_3_4_CSS_ED2024_01, CSS_R553_3_4_CSS_ED2025_02, CSS_R553_3_4_CSS_ED2025_09,
        CSS_R553_3_4_CSS_ED2025_12, CSS_R553_3_4_CSS_ED2026_01, CSS_R553_3_4_CSS_ED2026_04,
        CSS_R553_3_4_CSS_ED2026_06)
rule EcheanceQuestionnaire(o: Organisme, p: Personne, envoi: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "Le questionnaire est rempli et renvoyé dans les trente jours de l'envoi de la lettre qui l'exige";
    label en unofficial "The questionnaire is completed and returned within thirty days of the letter requiring it";
    when lettre_procedure_adressee(o, p) and lettre_contenu_questionnaire(o, p)
        and lettre_procedure_le(o, p, envoi) and section_train_vie_applicable(p);
    then echeance_questionnaire(p, add_calendar_period(envoi, 30 calendar_day));
}

@source(CSS_R553_3_5, CSS_R553_3_5_CSS_ED2021_05, CSS_R553_3_5_CSS_ED2021_11,
        CSS_R553_3_5_CSS_ED2021_12, CSS_R553_3_5_CSS_ED2022_01, CSS_R553_3_5_CSS_ED2022_02,
        CSS_R553_3_5_CSS_ED2022_03, CSS_R553_3_5_CSS_ED2022_09, CSS_R553_3_5_CSS_ED2023_07,
        CSS_R553_3_5_CSS_ED2024_01, CSS_R553_3_5_CSS_ED2025_02, CSS_R553_3_5_CSS_ED2025_09,
        CSS_R553_3_5_CSS_ED2025_12, CSS_R553_3_5_CSS_ED2026_01, CSS_R553_3_5_CSS_ED2026_04,
        CSS_R553_3_5_CSS_ED2026_06)
rule DisproportionReglementaire(p: Personne, evaluation: Money, plafond: Money, exclus: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "Disproportion si le forfait est au moins égal au double du plafond, revenus exclus ajoutés";
    label en unofficial "Disproportion where the schedule is at least twice the ceiling, excluded incomes added";
    when evaluation_forfaitaire_train_vie(p, evaluation) and plafond_prestation(p, plafond)
        and revenus_exclus_evaluation(p, exclus)
        and evaluation >= seuil_disproportion(plafond, exclus)
        and section_train_vie_applicable(p);
    then disproportion_reglementaire_constatee(p);
}

@source(CSS_R553_3_6, CSS_R553_3_6_CSS_ED2021_05, CSS_R553_3_6_CSS_ED2021_11,
        CSS_R553_3_6_CSS_ED2021_12, CSS_R553_3_6_CSS_ED2022_01, CSS_R553_3_6_CSS_ED2022_02,
