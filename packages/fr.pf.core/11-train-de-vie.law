        CSS_R553_3_3_CSS_ED2026_06)
rule BatieBienRetenuFallback(p: Personne, b: Bien, montant: Money, part: Decimal) strict {
    effective [@2021-01-01, infinity);
    label fr official "Bâtie repli par bien: aucune valeur applicable/connue, valeur du logement occupé retenue (R. 553-3-1 1°)";
    label en unofficial "Built fallback per item: no applicable/known value, occupied-dwelling value retained (R. 553-3-1 1)";
    when batie_bien_inapplicable(p, b) and valeur_locative_batie_fallback_logement(p, montant, part)
        and section_train_vie_applicable(p);
    then batie_bien_retenue(p, b, montant, part);
}

