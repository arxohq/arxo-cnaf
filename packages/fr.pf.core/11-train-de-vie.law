        CSS_R553_3_6_CSS_ED2026_06)
rule AttributionMaintenueExceptionnelle(p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "L'évaluation ne fait pas obstacle à l'attribution en cas de circonstances exceptionnelles";
    label en unofficial "The evaluation does not bar grant in exceptional circumstances";
    when evaluation_sans_droit(p) and circonstances_exceptionnelles(p)
        and section_train_vie_applicable(p);
    then attribution_maintenue_exceptionnelle(p);
}

@source(CSS_R553_3_6, CSS_R553_3_6_CSS_ED2021_05, CSS_R553_3_6_CSS_ED2021_11,
        CSS_R553_3_6_CSS_ED2021_12, CSS_R553_3_6_CSS_ED2022_01, CSS_R553_3_6_CSS_ED2022_02,
