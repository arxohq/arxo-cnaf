        CSS_R553_3_3_CSS_ED2025_12, CSS_R553_3_3_CSS_ED2026_01, CSS_R553_3_3_CSS_ED2026_04,
        CSS_R553_3_3_CSS_ED2026_06)
rule ApportForfaitaireBien(p: Personne, b: Bien, m: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "Apport d'un bien: apport au forfait du train de vie (R. 553-3-1 1°, 2°, 5°, 7°)";
    label en unofficial "Item contribution: contribution to the lifestyle schedule (R. 553-3-1 1, 2, 5, 7)";
    when apport_bien(p, b, m);
    then apport_forfaitaire(p, m);
}

