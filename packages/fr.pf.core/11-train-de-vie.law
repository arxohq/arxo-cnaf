        CSS_R553_3_6_CSS_ED2026_06)
rule AttributionNonRefuseeCessation(p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "L'attribution ou le renouvellement n'est pas refusé s'il est établi que la disproportion marquée a cessé";
    label en unofficial "Grant or renewal is not refused where the marked disproportion is established to have ceased";
    when evaluation_sans_droit(p) and disproportion_cessee_etablie(p)
        and section_train_vie_applicable(p);
    then attribution_non_refusee_cessation(p);
}

@source(CSS_R553_3_6, CSS_R553_3_6_CSS_ED2021_05, CSS_R553_3_6_CSS_ED2021_11,
        CSS_R553_3_6_CSS_ED2021_12, CSS_R553_3_6_CSS_ED2022_01, CSS_R553_3_6_CSS_ED2022_02,
        CSS_R553_3_6_CSS_ED2022_03, CSS_R553_3_6_CSS_ED2022_09, CSS_R553_3_6_CSS_ED2023_07,
        CSS_R553_3_6_CSS_ED2024_01, CSS_R553_3_6_CSS_ED2025_02, CSS_R553_3_6_CSS_ED2025_09,
        CSS_R553_3_6_CSS_ED2025_12, CSS_R553_3_6_CSS_ED2026_01, CSS_R553_3_6_CSS_ED2026_04,
        CSS_R553_3_6_CSS_ED2026_06)
rule NotifierRefus(o: Organisme, p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "Le refus est motivé et notifié par lettre recommandée avec accusé de réception et voies de recours";
    label en unofficial "Refusal is motivated and notified by registered letter with acknowledgement of receipt and remedies";
    when organisme_debiteur_pf(o, p) and refus_train_vie_decide(p)
        and section_train_vie_applicable(p);
    then duty NotifierRefusMotive {
        bearer o;
        beneficiary p;
        maintain refus_motive_notifie_conforme(o, p) during [@2021-01-01, infinity);
    };
}

@source(CSS_R553_3_6, CSS_R553_3_6_CSS_ED2021_05, CSS_R553_3_6_CSS_ED2021_11,
        CSS_R553_3_6_CSS_ED2021_12, CSS_R553_3_6_CSS_ED2022_01, CSS_R553_3_6_CSS_ED2022_02,
        CSS_R553_3_6_CSS_ED2022_03, CSS_R553_3_6_CSS_ED2022_09, CSS_R553_3_6_CSS_ED2023_07,
        CSS_R553_3_6_CSS_ED2024_01, CSS_R553_3_6_CSS_ED2025_02, CSS_R553_3_6_CSS_ED2025_09,
