// Policy for the 30-day questionnaire deadline (section 86).
deadline policy TRAIN_VIE_DELAI {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}

relation prestation_soumise_section(p: Personne) kind empirical {
    label fr official "prestation demandée: PAJE, complément familial ou ARS (champ R. 553-3)";
    label en unofficial "benefit claimed: PAJE, family complement or ARS (R. 553-3 scope)";
}

relation prestation_hors_section(p: Personne) kind empirical {
    label fr official "prestation en cause hors section R. 553-3, autre prestation du livre V (L. 553-5, hors allocation logement L. 821-1 CCH)";
    label en unofficial "benefit at issue outside the R. 553-3 section, other Livre V benefit (L. 553-5, except L. 821-1 CCH housing allowance)";
}

relation section_train_vie_applicable(p: Personne) kind institutional {
    key(p);
    label fr official "la section train de vie s'applique à l'examen (R. 553-3)";
    label en unofficial "the lifestyle section applies to the examination (R. 553-3)";
}

relation valeur_locative_batie(p: Personne, montant: Money, part_privee: Decimal) kind empirical {
    key(p);
    label fr official "DEPRECATED PC-R05-03: remplacé par batie_bien_valeur par bien (R. 553-3-1 1°)";
    label en unofficial "DEPRECATED PC-R05-03: replaced by per-item batie_bien_valeur (R. 553-3-1 1)";
}

relation valeur_locative_non_batie(p: Personne, montant: Money, part_privee: Decimal) kind empirical {
    key(p);
    label fr official "DEPRECATED PC-R05-03: remplacé par non_batie_bien_valeur par bien (R. 553-3-1 2°)";
    label en unofficial "DEPRECATED PC-R05-03: replaced by per-item non_batie_bien_valeur (R. 553-3-1 2)";
}

relation depenses_travaux(p: Personne, montant: Money, part_privee: Decimal) kind empirical {
    key(p);
    label fr official "travaux, charges et frais d'entretien des immeubles, montant des dépenses, part privée (R. 553-3-1 3° + R. 553-3-3; foyer/période en II 1° attestés séparément)";
    label en unofficial "works, charges and maintenance costs of buildings, spending amount, private share (R. 553-3-1 3 + R. 553-3-3; II 1 household/period attested separately)";
}

relation depenses_domestiques(p: Personne, montant: Money, part_privee: Decimal) kind empirical {
    key(p);
    label fr official "personnels et services domestiques, montant des dépenses, part privée (R. 553-3-1 4° + R. 553-3-3; foyer/période en II 1° attestés séparément)";
    label en unofficial "domestic staff and services, spending amount, private share (R. 553-3-1 4 + R. 553-3-3; II 1 household/period attested separately)";
}

relation valeur_venale_vehicules(p: Personne, montant: Money, part_privee: Decimal) kind empirical {
    key(p);
    label fr official "DEPRECATED PC-R05-04: remplacé par vehicule_bien_valeur par bien (R. 553-3-1 5°)";
    label en unofficial "DEPRECATED PC-R05-04: replaced by per-item vehicule_bien_valeur (R. 553-3-1 5)";
}

relation depenses_equipement(p: Personne, montant: Money, part_privee: Decimal) kind empirical {
    key(p);
    label fr official "appareils électroménagers, équipements son-hifi-vidéo, matériels informatiques, montant des dépenses, part privée (R. 553-3-1 6° + R. 553-3-3; foyer/période en II 1° attestés séparément)";
    label en unofficial "household appliances, audio-hifi-video, computer equipment, spending amount, private share (R. 553-3-1 6 + R. 553-3-3; II 1 household/period attested separately)";
}

relation valeur_venale_art(p: Personne, montant: Money, part_privee: Decimal) kind empirical {
    key(p);
    label fr official "DEPRECATED PC-R05-03/04: remplacé par art_bien_valeur par bien (R. 553-3-1 7°)";
    label en unofficial "DEPRECATED PC-R05-03/04: replaced by per-item art_bien_valeur (R. 553-3-1 7)";
}

relation batie_bien_valeur(p: Personne, b: Bien, montant: Money, part_privee: Decimal) kind empirical {
    key(p, b);
    label fr official "propriété bâtie b: valeur locative annuelle directe CGI 1494-1508 et 1516-1518 B, part privée (R. 553-3-1 1° + R. 553-3-3)";
    label en unofficial "built property b: direct annual rental value CGI 1494-1508 and 1516-1518 B, private share (R. 553-3-1 1 + R. 553-3-3)";
}

relation batie_bien_inapplicable(p: Personne, b: Bien) kind empirical {
    label fr official "propriété bâtie b sur un territoire sans valeur applicable ou connaissable, repli logement occupé (R. 553-3-1 1° seconde phrase)";
    label en unofficial "built property b in a territory with no applicable or knowable value, occupied-dwelling fallback (R. 553-3-1 1 second sentence)";
}

relation batie_bien_retenue(p: Personne, b: Bien, montant: Money, part_privee: Decimal) kind institutional {
    key(p, b);
    label fr official "propriété bâtie b: valeur locative retenue, directe ou repli logement occupé (R. 553-3-1 1°)";
    label en unofficial "built property b: retained rental value, direct or occupied-dwelling fallback (R. 553-3-1 1)";
}

relation non_batie_bien_valeur(p: Personne, b: Bien, montant: Money, part_privee: Decimal) kind empirical {
    key(p, b);
    label fr official "propriété non bâtie b: valeur locative annuelle directe CGI 1509-1518 A, part privée (R. 553-3-1 2° + R. 553-3-3)";
    label en unofficial "unbuilt property b: direct annual rental value CGI 1509-1518 A, private share (R. 553-3-1 2 + R. 553-3-3)";
}

relation non_batie_bien_inapplicable(p: Personne, b: Bien) kind empirical {
    label fr official "propriété non bâtie b sur un territoire sans valeur applicable ou connaissable, repli logement occupé (R. 553-3-1 2° seconde phrase)";
    label en unofficial "unbuilt property b in a territory with no applicable or knowable value, occupied-dwelling fallback (R. 553-3-1 2 second sentence)";
}

relation non_batie_bien_retenue(p: Personne, b: Bien, montant: Money, part_privee: Decimal) kind institutional {
    key(p, b);
    label fr official "propriété non bâtie b: valeur locative retenue, directe ou repli logement occupé (R. 553-3-1 2°)";
    label en unofficial "unbuilt property b: retained rental value, direct or occupied-dwelling fallback (R. 553-3-1 2)";
}

relation vehicule_bien_valeur(p: Personne, b: Bien, montant: Money, part_privee: Decimal) kind empirical {
    key(p, b);
    label fr official "véhicule b (auto, bateau, moto): valeur réelle attestée par expertise/organisme à la date de disposition, part privée, avant retenue institutionnelle étayée (R. 553-3-1 5° + R. 553-3-3 + II 2°)";
    label en unofficial "vehicle b (car, boat, bike): expert/body-stated real value on disposal date, private share, before supported institutional retention (R. 553-3-1 5 + R. 553-3-3 + II 2)";
}

relation vehicule_bien_date(p: Personne, b: Bien, date: Date) kind empirical {
    key(p, b);
    label fr official "véhicule b: date de la disposition pour la valeur vénale réelle (R. 553-3-1 II 2°)";
    label en unofficial "vehicle b: disposal date for the real market value (R. 553-3-1 II 2)";
}

relation vehicule_bien_preuve_assurance(p: Personne, b: Bien, montant: Money) kind empirical {
    key(p, b);
    label fr official "véhicule b: montant garanti par le contrat d'assurance retenu à fin d'évaluation, lorsqu'il existe (R. 553-3-1 II 2° a)";
    label en unofficial "vehicle b: insurance-guaranteed amount retained for evaluation, where available (R. 553-3-1 II 2 a)";
}

relation vehicule_bien_preuve_estimation(p: Personne, b: Bien, montant: Money) kind empirical {
    key(p, b);
    label fr official "véhicule b: montant de l'estimation particulière effectuée par un professionnel, retenu à fin d'évaluation, lorsqu'il existe (R. 553-3-1 II 2° b)";
    label en unofficial "vehicle b: professional-estimate amount retained for evaluation, where available (R. 553-3-1 II 2 b)";
}

relation vehicule_bien_preuve_publication(p: Personne, b: Bien, montant: Money) kind empirical {
    key(p, b);
    label fr official "véhicule b: valeur de référence issue d'une publication professionnelle faisant autorité, retenue à fin d'évaluation, lorsqu'elle existe (R. 553-3-1 II 2° c)";
    label en unofficial "vehicle b: authoritative professional-publication reference value retained for evaluation, where available (R. 553-3-1 II 2 c)";
}

relation vehicule_bien_sans_preuve(p: Personne, b: Bien) kind empirical {
    label fr official "véhicule b: aucune preuve assurance/estimation/publication disponible, attesté (R. 553-3-1 II 2°)";
    label en unofficial "vehicle b: no insurance/estimate/publication evidence available, attested (R. 553-3-1 II 2)";
}

relation vehicule_bien_justifie(p: Personne, b: Bien) kind institutional {
    key(p, b);
    label fr official "véhicule b: preuve chiffrée disponible ou absence attestée, valeur étayée (R. 553-3-1 II 2° a/b/c)";
    label en unofficial "vehicle b: available amount-bearing evidence or attested absence, value supported (R. 553-3-1 II 2 a/b/c)";
}

relation vehicule_bien_valeur_retenue(p: Personne, b: Bien, montant: Money, part_privee: Decimal, date: Date) kind institutional {
    key(p, b);
    label fr official "véhicule b: valeur réelle à la date de disposition retenue par appréciation étayée d'une preuve chiffrée disponible ou d'une absence attestée (R. 553-3-1 5° + II 2° a/b/c)";
    label en unofficial "vehicle b: real disposal-date value retained by supported appreciation of one available amount-bearing evidence or attested absence (R. 553-3-1 5 + II 2 a/b/c)";
}

relation art_bien_valeur(p: Personne, b: Bien, montant: Money, part_privee: Decimal) kind empirical {
    key(p, b);
    label fr official "objet d'art b: valeur réelle attestée par expertise/organisme à la date de disposition, part privée, avant retenue institutionnelle étayée (R. 553-3-1 7° + R. 553-3-3 + II 2°)";
    label en unofficial "art item b: expert/body-stated real value on disposal date, private share, before supported institutional retention (R. 553-3-1 7 + R. 553-3-3 + II 2)";
}

relation art_bien_date(p: Personne, b: Bien, date: Date) kind empirical {
    key(p, b);
    label fr official "objet d'art b: date de la disposition pour la valeur vénale réelle (R. 553-3-1 II 2°)";
    label en unofficial "art item b: disposal date for the real market value (R. 553-3-1 II 2)";
}

relation art_bien_preuve_assurance(p: Personne, b: Bien, montant: Money) kind empirical {
    key(p, b);
    label fr official "objet d'art b: montant garanti par le contrat d'assurance retenu à fin d'évaluation, lorsqu'il existe (R. 553-3-1 II 2° a)";
    label en unofficial "art item b: insurance-guaranteed amount retained for evaluation, where available (R. 553-3-1 II 2 a)";
}

relation art_bien_preuve_estimation(p: Personne, b: Bien, montant: Money) kind empirical {
    key(p, b);
    label fr official "objet d'art b: montant de l'estimation particulière effectuée par un professionnel, retenu à fin d'évaluation, lorsqu'il existe (R. 553-3-1 II 2° b)";
    label en unofficial "art item b: professional-estimate amount retained for evaluation, where available (R. 553-3-1 II 2 b)";
}

relation art_bien_preuve_publication(p: Personne, b: Bien, montant: Money) kind empirical {
    key(p, b);
    label fr official "objet d'art b: valeur de référence issue d'une publication professionnelle faisant autorité, retenue à fin d'évaluation, lorsqu'elle existe (R. 553-3-1 II 2° c)";
    label en unofficial "art item b: authoritative professional-publication reference value retained for evaluation, where available (R. 553-3-1 II 2 c)";
}

relation art_bien_sans_preuve(p: Personne, b: Bien) kind empirical {
    label fr official "objet d'art b: aucune preuve assurance/estimation/publication disponible, attesté (R. 553-3-1 II 2°)";
    label en unofficial "art item b: no insurance/estimate/publication evidence available, attested (R. 553-3-1 II 2)";
}

relation art_bien_justifie(p: Personne, b: Bien) kind institutional {
    key(p, b);
    label fr official "objet d'art b: preuve chiffrée disponible ou absence attestée, valeur étayée (R. 553-3-1 II 2° a/b/c)";
    label en unofficial "art item b: available amount-bearing evidence or attested absence, value supported (R. 553-3-1 II 2 a/b/c)";
}

relation art_bien_valeur_retenue(p: Personne, b: Bien, montant: Money, part_privee: Decimal, date: Date) kind institutional {
    key(p, b);
    label fr official "objet d'art b: valeur réelle à la date de disposition retenue par appréciation étayée d'une preuve chiffrée disponible ou d'une absence attestée (R. 553-3-1 7° + II 2° a/b/c)";
    label en unofficial "art item b: real disposal-date value retained by supported appreciation of one available amount-bearing evidence or attested absence (R. 553-3-1 7 + II 2 a/b/c)";
}

relation apport_forfaitaire(p: Personne, montant: Money) kind institutional {
    label fr official "apport d'un poste au forfait du train de vie, prorata appliqué (R. 553-3-1)";
    label en unofficial "item contribution to the lifestyle schedule, prorata applied (R. 553-3-1)";
}

// D-42 (12.10.2026): R. 553-3-1 I sums every element ("prend en compte les
// éléments et barèmes suivants"). The total used to collect the amounts of
// apport_forfaitaire(p, m): a relation holds one tuple per value, so two
// equal contributions (8° 1 000 x 0.5 x 80 % = 400 and 9° 500 x 80 % = 400)
// were one solution and the sum undercounted (SPEC 52.1: only a binder
// distinguishes equal values; measured: tdv-total 12 200 instead of 12 600).
// Each contribution now carries its line - the item for 1°, 2°, 5°, 7°
// (apport_bien) and the spending/capital line for 3°, 4°, 6°, 8°, 9°, 10°
// (apport_poste) - and the total sums both lists. apport_forfaitaire(p, m)
// stays derived from both for per-amount questions.
enum PosteTrainVie { label fr official "postes du barème du train de vie évalués sans bien individualisé (R. 553-3-1 3°, 4°, 6°, 8°, 9°, 10°)"; label en unofficial "lifestyle-schedule lines assessed without an individual item (R. 553-3-1 3, 4, 6, 8, 9, 10)"; TRAVAUX, DOMESTIQUES, EQUIPEMENT, LOISIRS, CLUBS, CAPITAUX }

relation apport_bien(p: Personne, b: Bien, montant: Money) kind institutional {
    label fr official "apport d'un bien au forfait du train de vie, prorata appliqué (R. 553-3-1 1°, 2°, 5°, 7°)";
    label en unofficial "item contribution to the lifestyle schedule, prorata applied (R. 553-3-1 1, 2, 5, 7)";
}

relation apport_poste(p: Personne, k: PosteTrainVie, montant: Money) kind institutional {
    label fr official "apport d'un poste de dépenses ou de capitaux au forfait du train de vie, prorata appliqué (R. 553-3-1 3°, 4°, 6°, 8°, 9°, 10°)";
    label en unofficial "spending or capital line contribution to the lifestyle schedule, prorata applied (R. 553-3-1 3, 4, 6, 8, 9, 10)";
}

relation inventaire_tdv_complet(p: Personne) kind empirical {
    label fr official "inventaire des éléments de train de vie complet, aucun poste omis (R. 553-3-1)";
    label en unofficial "lifestyle items inventory complete, no item omitted (R. 553-3-1)";
}

relation depenses_loisirs(p: Personne, montant: Money, part_privee: Decimal) kind empirical {
    key(p);
    label fr official "voyages, séjours hôtels et locations saisonnières, restaurants, frais de réception, biens et services culturels, éducatifs, de communication ou de loisirs, part privée (R. 553-3-1 8° + R. 553-3-3; foyer/période en II 1° attestés séparément)";
    label en unofficial "travel, hotel stays and seasonal rentals, restaurants, reception costs, cultural, educational, communications or leisure goods and services, private share (R. 553-3-1 8 + R. 553-3-3; II 1 household/period attested separately)";
}

relation depenses_clubs(p: Personne, montant: Money, part_privee: Decimal) kind empirical {
    key(p);
    label fr official "clubs de sports et de loisirs, droits de chasse, montant des dépenses, part privée (R. 553-3-1 9° + R. 553-3-3; foyer/période en II 1° attestés séparément)";
    label en unofficial "sports and leisure clubs, hunting rights, spending amount, private share (R. 553-3-1 9 + R. 553-3-3; II 1 household/period attested separately)";
}

relation capitaux_fin_periode(p: Personne, montant: Money, part_privee: Decimal) kind empirical {
