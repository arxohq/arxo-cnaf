        CSS_R553_3_6_CSS_ED2026_06)
rule RefusNotifieConforme(o: Organisme, p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "Refus conforme: motivé, notifié par lettre recommandée avec accusé de réception et voies de recours";
    label en unofficial "Conforming refusal: motivated, notified by registered letter with acknowledgement of receipt and remedies";
    when refus_motive_notifie(o, p) and refus_accuse_reception(o, p)
        and section_train_vie_applicable(p);
    then refus_motive_notifie_conforme(o, p);
}

@source(CSS_R553_3_7, CSS_R553_3_7_CSS_ED2021_05, CSS_R553_3_7_CSS_ED2021_11,
        CSS_R553_3_7_CSS_ED2021_12, CSS_R553_3_7_CSS_ED2022_01, CSS_R553_3_7_CSS_ED2022_02,
        CSS_R553_3_7_CSS_ED2022_03, CSS_R553_3_7_CSS_ED2022_09, CSS_R553_3_7_CSS_ED2023_07,
        CSS_R553_3_7_CSS_ED2024_01, CSS_R553_3_7_CSS_ED2025_02, CSS_R553_3_7_CSS_ED2025_09,
        CSS_R553_3_7_CSS_ED2025_12, CSS_R553_3_7_CSS_ED2026_01, CSS_R553_3_7_CSS_ED2026_04,
        CSS_R553_3_7_CSS_ED2026_06)
rule RendreCompte(o: Organisme, n: OrganismeNational, p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "L'organisme rend compte sans délai et anonymement à l'organisme national, en précisant réponse, sens, éléments et sanction";
    label en unofficial "The body reports without delay and anonymously to the national body, stating reply, direction, items and sanction";
    when organisme_debiteur_pf(o, p) and evaluation_effectuee(p) and releve_organisme_national(o, n)
        and section_train_vie_applicable(p);
    then duty RendreCompteEvaluation {
        bearer o;
        beneficiary n;
        maintain compte_rendu_evaluation_conforme(o, n, p) during [@2021-01-01, infinity);
    };
}

@source(CSS_R553_3_7, CSS_R553_3_7_CSS_ED2021_05, CSS_R553_3_7_CSS_ED2021_11,
        CSS_R553_3_7_CSS_ED2021_12, CSS_R553_3_7_CSS_ED2022_01, CSS_R553_3_7_CSS_ED2022_02,
        CSS_R553_3_7_CSS_ED2022_03, CSS_R553_3_7_CSS_ED2022_09, CSS_R553_3_7_CSS_ED2023_07,
        CSS_R553_3_7_CSS_ED2024_01, CSS_R553_3_7_CSS_ED2025_02, CSS_R553_3_7_CSS_ED2025_09,
        CSS_R553_3_7_CSS_ED2025_12, CSS_R553_3_7_CSS_ED2026_01, CSS_R553_3_7_CSS_ED2026_04,
        CSS_R553_3_7_CSS_ED2026_06)
rule SanctionFraudePrecisee(p: Personne, montant: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "Sanction pour fraude précisée au compte rendu, nature et montant";
    label en unofficial "Fraud sanction stated in the report, kind and amount";
    when compte_rendu_sanction_fraude(p, montant) and section_train_vie_applicable(p);
    then compte_rendu_sanction_precisee(p);
}

@source(CSS_R553_3_7, CSS_R553_3_7_CSS_ED2021_05, CSS_R553_3_7_CSS_ED2021_11,
        CSS_R553_3_7_CSS_ED2021_12, CSS_R553_3_7_CSS_ED2022_01, CSS_R553_3_7_CSS_ED2022_02,
