rule VehiculeBienValeurRetenueSansPreuve(p: Personne, b: Bien, valeur: Money, part: Decimal, date: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "Véhicule retenu: valeur réelle à la disposition avec absence attestée de preuve du même bien (R. 553-3-1 5° + II 2° lorsqu'ils existent)";
    label en unofficial "Vehicle retained: real disposal value with attested absence of evidence for the same item (R. 553-3-1 5 + II 2 where available)";
    when vehicule_bien_valeur(p, b, valeur, part) and vehicule_bien_date(p, b, date)
        and vehicule_bien_sans_preuve(p, b)
        and section_train_vie_applicable(p);
    then vehicule_bien_valeur_retenue(p, b, valeur, part, date);
}

