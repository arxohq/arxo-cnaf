    label fr official "seuil de 10 000 euros par véhicule (R. 553-3-1 5°)";
    label en unofficial "EUR 10,000 threshold per vehicle (R. 553-3-1 5)";
}

const SeuilEquipement: Money = 1000.00 EUR {
    label fr official "seuil de 1 000 euros de dépenses d'équipement (R. 553-3-1 6°)";
    label en unofficial "EUR 1,000 equipment-spending threshold (R. 553-3-1 6)";
}

const ZeroTrainVie: Money = 0.00 EUR {
    label fr official "contribution nulle sous les seuils (R. 553-3-1 5°/6°)";
    label en unofficial "zero contribution below thresholds (R. 553-3-1 5/6)";
}

function contribution_bareme(montant: Money, part: Decimal, taux: Decimal) -> Money =
    montant * part * taux;

function seuil_disproportion(plafond: Money, exclus: Money) -> Money =
    plafond * 2.0 + exclus;

@source(CSS_R553_3, CSS_R553_3_CSS_ED2021_05, CSS_R553_3_CSS_ED2021_11, CSS_R553_3_CSS_ED2021_12,
        CSS_R553_3_CSS_ED2022_01, CSS_R553_3_CSS_ED2022_02, CSS_R553_3_CSS_ED2022_03,
        CSS_R553_3_CSS_ED2022_09, CSS_R553_3_CSS_ED2023_07, CSS_R553_3_CSS_ED2024_01,
        CSS_R553_3_CSS_ED2025_02, CSS_R553_3_CSS_ED2025_09, CSS_R553_3_CSS_ED2025_12,
        CSS_R553_3_CSS_ED2026_01, CSS_R553_3_CSS_ED2026_04, CSS_R553_3_CSS_ED2026_06)
rule SectionTrainVieApplicable(p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "La section s'applique aux demandes de PAJE, complément familial et ARS";
    label en unofficial "The section applies to PAJE, family complement and ARS claims";
    when prestation_soumise_section(p);
    then section_train_vie_applicable(p);
}

@source(CSS_R553_3, CSS_R553_3_CSS_ED2021_05, CSS_R553_3_CSS_ED2021_11, CSS_R553_3_CSS_ED2021_12,
        CSS_R553_3_CSS_ED2022_01, CSS_R553_3_CSS_ED2022_02, CSS_R553_3_CSS_ED2022_03,
        CSS_R553_3_CSS_ED2022_09, CSS_R553_3_CSS_ED2023_07, CSS_R553_3_CSS_ED2024_01,
        CSS_R553_3_CSS_ED2025_02, CSS_R553_3_CSS_ED2025_09, CSS_R553_3_CSS_ED2025_12,
        CSS_R553_3_CSS_ED2026_01, CSS_R553_3_CSS_ED2026_04, CSS_R553_3_CSS_ED2026_06)
rule SectionTrainVieHorsChamp(p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "La section ne s'applique pas aux autres prestations du livre V (L. 553-5 hors section)";
    label en unofficial "The section does not apply to the other Livre V benefits (L. 553-5 outside the section)";
    when prestation_hors_section(p);
    then not section_train_vie_applicable(p);
}

