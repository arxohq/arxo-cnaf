        CSS_R553_3_7_CSS_ED2026_06)
rule SanctionFausseDeclarationPrecisee(p: Personne, montant: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "Sanction pour fausse déclaration précisée au compte rendu, nature et montant";
    label en unofficial "False-statement sanction stated in the report, kind and amount";
    when compte_rendu_sanction_fausse_declaration(p, montant) and section_train_vie_applicable(p);
    then compte_rendu_sanction_precisee(p);
}

@source(CSS_R553_3_7, CSS_R553_3_7_CSS_ED2021_05, CSS_R553_3_7_CSS_ED2021_11,
        CSS_R553_3_7_CSS_ED2021_12, CSS_R553_3_7_CSS_ED2022_01, CSS_R553_3_7_CSS_ED2022_02,
        CSS_R553_3_7_CSS_ED2022_03, CSS_R553_3_7_CSS_ED2022_09, CSS_R553_3_7_CSS_ED2023_07,
        CSS_R553_3_7_CSS_ED2024_01, CSS_R553_3_7_CSS_ED2025_02, CSS_R553_3_7_CSS_ED2025_09,
        CSS_R553_3_7_CSS_ED2025_12, CSS_R553_3_7_CSS_ED2026_01, CSS_R553_3_7_CSS_ED2026_04,
        CSS_R553_3_7_CSS_ED2026_06)
rule AucuneSanctionPrecisee(p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "Absence de sanction pour fraude ou fausse déclaration précisée au compte rendu";
    label en unofficial "Absence of any fraud or false-statement sanction stated in the report";
    when compte_rendu_aucune_sanction(p) and section_train_vie_applicable(p);
    then compte_rendu_sanction_precisee(p);
}

@source(CSS_R553_3_7, CSS_R553_3_7_CSS_ED2021_05, CSS_R553_3_7_CSS_ED2021_11,
        CSS_R553_3_7_CSS_ED2021_12, CSS_R553_3_7_CSS_ED2022_01, CSS_R553_3_7_CSS_ED2022_02,
        CSS_R553_3_7_CSS_ED2022_03, CSS_R553_3_7_CSS_ED2022_09, CSS_R553_3_7_CSS_ED2023_07,
        CSS_R553_3_7_CSS_ED2024_01, CSS_R553_3_7_CSS_ED2025_02, CSS_R553_3_7_CSS_ED2025_09,
        CSS_R553_3_7_CSS_ED2025_12, CSS_R553_3_7_CSS_ED2026_01, CSS_R553_3_7_CSS_ED2026_04,
        CSS_R553_3_7_CSS_ED2026_06)
rule CompteRenduConforme(o: Organisme, n: OrganismeNational, p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "Compte rendu conforme: transmis sans délai, anonymisé, avec réponse dans ou hors délai, sens de la décision, éléments évalués et sanction précisée";
    label en unofficial "Conforming report: transmitted without delay, anonymised, with timely or late reply, decision direction, evaluated items and stated sanction";
    when compte_rendu_transmis(o, n) and compte_rendu_transmis_sans_delai(o, n)
        and compte_rendu_anonymise(o, p)
        and (compte_rendu_reponse_dans_delai(p) or compte_rendu_reponse_hors_delai(p))
        and (compte_rendu_decision_attribution(p) or compte_rendu_decision_refus(p))
        and compte_rendu_elements_evalues(p) and compte_rendu_sanction_precisee(p)
        and section_train_vie_applicable(p);
    then compte_rendu_evaluation_conforme(o, n, p);
}

@source(CSS_R553_3_7, CSS_R553_3_7_CSS_ED2021_05, CSS_R553_3_7_CSS_ED2021_11,
        CSS_R553_3_7_CSS_ED2021_12, CSS_R553_3_7_CSS_ED2022_01, CSS_R553_3_7_CSS_ED2022_02,
        CSS_R553_3_7_CSS_ED2022_03, CSS_R553_3_7_CSS_ED2022_09, CSS_R553_3_7_CSS_ED2023_07,
        CSS_R553_3_7_CSS_ED2024_01, CSS_R553_3_7_CSS_ED2025_02, CSS_R553_3_7_CSS_ED2025_09,
        CSS_R553_3_7_CSS_ED2025_12, CSS_R553_3_7_CSS_ED2026_01, CSS_R553_3_7_CSS_ED2026_04,
        CSS_R553_3_7_CSS_ED2026_06)
rule TransmettreBilan(n: OrganismeNational, m: Ministre) strict {
    effective [@2021-01-01, infinity);
    label fr official "L'organisme national transmet périodiquement au ministre un bilan des éléments des évaluations";
    label en unofficial "The national body periodically transmits to the minister a review of the evaluation elements";
    when bilan_periodique_du(n) and ministre_tutelle(m);
    then duty TransmettreBilanMinistre {
        bearer n;
        beneficiary m;
        maintain bilan_ministre_conforme(n, m) during [@2021-01-01, infinity);
    };
}

@source(CSS_R553_3_7, CSS_R553_3_7_CSS_ED2021_05, CSS_R553_3_7_CSS_ED2021_11,
        CSS_R553_3_7_CSS_ED2021_12, CSS_R553_3_7_CSS_ED2022_01, CSS_R553_3_7_CSS_ED2022_02,
        CSS_R553_3_7_CSS_ED2022_03, CSS_R553_3_7_CSS_ED2022_09, CSS_R553_3_7_CSS_ED2023_07,
        CSS_R553_3_7_CSS_ED2024_01, CSS_R553_3_7_CSS_ED2025_02, CSS_R553_3_7_CSS_ED2025_09,
        CSS_R553_3_7_CSS_ED2025_12, CSS_R553_3_7_CSS_ED2026_01, CSS_R553_3_7_CSS_ED2026_04,
        CSS_R553_3_7_CSS_ED2026_06)
rule BilanConforme(n: OrganismeNational, m: Ministre) strict {
    effective [@2021-01-01, infinity);
    label fr official "Bilan conforme: transmis au ministre avec les éléments des évaluations";
    label en unofficial "Conforming review: transmitted to the minister with the evaluation elements";
    when bilan_transmis_ministre(n, m) and bilan_elements_transmis(n);
    then bilan_ministre_conforme(n, m);
}
