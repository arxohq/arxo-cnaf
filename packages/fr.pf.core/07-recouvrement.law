        CSS_L553_4_CSS_ED2026_01, CSS_L553_4_CSS_ED2026_04, CSS_L553_4_CSS_ED2026_06)
rule RetraitMensuelLimite(p: Personne, montant: Money) defeasible {
    effective [@2021-01-01, infinity);
    label fr official "III: retrait mensuel autorisé malgré opposition, dans la limite des prestations versées au compte";
    label en unofficial "III: monthly withdrawal allowed despite opposition, up to the benefits paid into the account";
    when allocataire(p) and prestations_versees_compte(p, montant);
    then retrait_mensuel_autorise_limite(p, montant);
}

