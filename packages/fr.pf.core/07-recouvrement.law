rule LiberteRetraitFonds(p: Personne, montant: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "III: l'allocataire peut retirer chaque mois les fonds dans la limite des prestations";
    label en unofficial "III: allocataire may monthly withdraw funds up to the benefits";
    when retrait_mensuel_autorise_limite(p, montant);
    then liberty RetraitFondsCompte {
        holder p;
        action retrait_fonds_action(p);
        window [@2021-01-01, infinity);
    };
}

@source(CSS_L553_5, CSS_L553_5_CSS_ED2021_05, CSS_L553_5_CSS_ED2021_11, CSS_L553_5_CSS_ED2021_12,
        CSS_L553_5_CSS_ED2022_01, CSS_L553_5_CSS_ED2022_02, CSS_L553_5_CSS_ED2022_03,
