rule CotisationsVolontairesSurPrestations(o: Organisme, p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "Sur demande: cotisations volontaires L. 742-1 recouvrées sur les prestations L. 511-1 hors logement";
    label en unofficial "On request: voluntary L. 742-1 contributions recovered from L. 511-1 benefits except housing";
    when allocataire(p) and organisme_debiteur_pf(o, p)
        and demande_cotisations_volontaires(p) and prestation_l5111_hors_logement(p);
    then liberty PrelevementCotisationsVolontaires {
        holder o;
        action recouvrement_cotisations_action(o, p);
        window [@2021-01-01, infinity);
    };
}

@source(CSS_L553_4, CSS_L553_4_CSS_ED2021_05, CSS_L553_4_CSS_ED2021_11, CSS_L553_4_CSS_ED2021_12,
