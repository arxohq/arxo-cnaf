        CSS_L553_4_CSS_ED2026_01, CSS_L553_4_CSS_ED2026_04, CSS_L553_4_CSS_ED2026_06)
rule ProtectionCompteBloque(p: Personne) defeasible {
    effective [@2021-01-01, infinity);
    label fr official "III: le blocage du compte courant ne fait pas obstacle à l'insaisissabilité et à l'incessibilité";
    label en unofficial "III: current-account blocking does not defeat unseizability and unassignability";
    when allocataire(p) and compte_courant_bloque(p);
    then protection_compte_maintenue(p);
}

@source(CSS_L553_4, CSS_L553_4_CSS_ED2021_05, CSS_L553_4_CSS_ED2021_11, CSS_L553_4_CSS_ED2021_12,
