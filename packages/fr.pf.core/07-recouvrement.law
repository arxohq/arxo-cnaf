    CSS_L553_3_CSS_ED2026_06,
    CSS_L553_4,
    CSS_L553_4_CSS_ED2021_05,
    CSS_L553_4_CSS_ED2021_11,
    CSS_L553_4_CSS_ED2021_12,
    CSS_L553_4_CSS_ED2022_01,
    CSS_L553_4_CSS_ED2022_02,
    CSS_L553_4_CSS_ED2022_03,
    CSS_L553_4_CSS_ED2022_09,
    CSS_L553_4_CSS_ED2023_07,
    CSS_L553_4_CSS_ED2024_01,
    CSS_L553_4_CSS_ED2025_02,
    CSS_L553_4_CSS_ED2025_09,
    CSS_L553_4_CSS_ED2025_12,
    CSS_L553_4_CSS_ED2026_01,
    CSS_L553_4_CSS_ED2026_04,
    CSS_L553_4_CSS_ED2026_06,
    CSS_L553_5,
    CSS_L553_5_CSS_ED2021_05,
    CSS_L553_5_CSS_ED2021_11,
    CSS_L553_5_CSS_ED2021_12,
    CSS_L553_5_CSS_ED2022_01,
    CSS_L553_5_CSS_ED2022_02,
    CSS_L553_5_CSS_ED2022_03,
    CSS_L553_5_CSS_ED2022_09,
    CSS_L553_5_CSS_ED2023_07,
    CSS_L553_5_CSS_ED2024_01,
    CSS_L553_5_CSS_ED2025_02,
    CSS_L553_5_CSS_ED2025_09,
    CSS_L553_5_CSS_ED2025_12,
    CSS_L553_5_CSS_ED2026_01,
    CSS_L553_5_CSS_ED2026_04,
    CSS_L553_5_CSS_ED2026_06,
    CSS_R553_3_5,
    CSS_R553_3_5_CSS_ED2021_05,
    CSS_R553_3_5_CSS_ED2021_11,
    CSS_R553_3_5_CSS_ED2021_12,
    CSS_R553_3_5_CSS_ED2022_01,
    CSS_R553_3_5_CSS_ED2022_02,
    CSS_R553_3_5_CSS_ED2022_03,
    CSS_R553_3_5_CSS_ED2022_09,
    CSS_R553_3_5_CSS_ED2023_07,
    CSS_R553_3_5_CSS_ED2024_01,
    CSS_R553_3_5_CSS_ED2025_02,
    CSS_R553_3_5_CSS_ED2025_09,
    CSS_R553_3_5_CSS_ED2025_12,
    CSS_R553_3_5_CSS_ED2026_01,
    CSS_R553_3_5_CSS_ED2026_04,
    CSS_R553_3_5_CSS_ED2026_06,
    Enfant,
    Organisme,
    Personne,
    allocataire,
    date_appreciation,
    disproportion_reglementaire_constatee,
    fraude_reiteree,
    indemnite_frais_gestion,
    indu_constate,
    indu_fausse_declaration,
    indu_frauduleux,
    indu_recupere_retenues,
    option_remboursement_unique,
    organisme_debiteur_pf,
    prestation_hors_section,
    section_train_vie_applicable,
};

// Policy for add_calendar_period (section 86) - FORWARD only.
deadline policy RECOUVREMENT_DELAI {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}

relation indu_rembourse_unique(p: Personne) kind institutional {
    key(p);
    label fr official "l'indu est remboursé intégralement en un seul versement";
    label en unofficial "overpayment fully repaid in a single payment";
}

relation premiere_majoration_notifiee_le(p: Personne, date: Date) kind empirical {
    key(p);
    label fr official "date de notification de l'indu ayant donné lieu à majoration de la retenue (L. 553-2 al. 3)";
    label en unofficial "date of notification of the overpayment that raised the deduction (L. 553-2 para. 3)";
}

relation nouvelle_fraude_le(p: Personne, date: Date) kind empirical {
    key(p);
    label fr official "date de la fraude nouvelle (réitération éventuelle)";
    label en unofficial "date of the new fraud (possible repeat)";
}

relation mise_en_demeure_adressee_le(p: Personne, date: Date) kind empirical {
    key(p);
    label fr official "date de la mise en demeure adressée par lettre recommandée (L. 553-2-1 al. 3)";
    label en unofficial "date the mise en demeure was sent by registered letter (L. 553-2-1 para. 3)";
}

relation etablissement_service_eligible_l5532_1(p: Personne) kind empirical {
    label fr official "établissement ou service L. 2324-1 CSP n'ayant pas respecté le dernier alinéa de L. 531-6, manquement constaté (L. 553-2-1 al. 1, p = débiteur établissement/service)";
    label en unofficial "L. 2324-1 CSP establishment or service in breach of the last paragraph of L. 531-6, breach established (L. 553-2-1 para. 1, p = establishment/service debtor)";
}

relation notification_recouvrement_adressee(p: Personne) kind empirical {
    label fr official "action en recouvrement ouverte par notification de payer ou de produire des observations (L. 553-2-1 al. 2)";
    label en unofficial "recovery action opened by notice to pay or to submit observations (L. 553-2-1 para. 2)";
}

relation observations_interesse_rejetees(p: Personne) kind empirical {
    label fr official "rejet total ou partiel des observations de l'intéressé (L. 553-2-1 al. 3)";
    label en unofficial "total or partial rejection of the observations (L. 553-2-1 para. 3)";
}

relation mise_en_demeure_sans_effet(p: Personne, mise: Date) kind empirical {
    key(p);
    label fr official "mise en demeure restée sans effet à la date d'appréciation (L. 553-2-1 al. 4)";
    label en unofficial "mise en demeure without effect at the appreciation date (L. 553-2-1 para. 4)";
}

relation sommes_mise_issues_notification(p: Personne, montant: Money) kind empirical {
    key(p);
    label fr official "sommes de la mise en demeure mentionnées sur la notification initiale (L. 553-2-1 al. 3 « ne peut concerner que »)";
    label en unofficial "mise en demeure sums taken from the initial notice (L. 553-2-1 para. 3 'only')";
}

relation date_exigibilite_mise_le(p: Personne, echeance: Date) kind empirical {
    key(p);
    label fr official "date d'exigibilité des sommes mentionnée dans la mise en demeure (L. 553-2-1 al. 4)";
    label en unofficial "due date of the sums stated in the mise en demeure (L. 553-2-1 para. 4)";
}

relation remettre_majoration_action(o: Organisme, p: Personne) kind empirical {
    key(o, p);
    label fr official "action: remise de la majoration de 10 % (L. 553-2-1 al. 4 « peut faire l'objet d'une remise »)";
    label en unofficial "action: remitting the 10% increase (L. 553-2-1 para. 4 'may be remitted')";
}

relation contrainte_possible(p: Personne) kind institutional {
    key(p);
    label fr official "la mise en demeure restée sans effet: le directeur peut délivrer une contrainte (L. 553-2-1 al. 4)";
    label en unofficial "mise en demeure without effect: the director may issue a contrainte (L. 553-2-1 para. 4)";
}

relation sommes_non_reglees(p: Personne, montant: Money) kind empirical {
    key(p);
    label fr official "sommes réclamées non réglées aux dates d'exigibilité de la mise en demeure";
    label en unofficial "claimed amounts unpaid by the mise en demeure deadlines";
}

relation majoration_mise_en_demeure(p: Personne, montant: Money) kind institutional {
    key(p);
    label fr official "majoration de 10 % des sommes non réglées (L. 553-2-1 al. 4)";
    label en unofficial "10% increase on unpaid amounts (L. 553-2-1 para. 4)";
}

relation montant_majorations_concurrentes(p: Personne, montant: Money) kind empirical {
    key(p);
    label fr official "montant des majorations d'allocations concurrentes (chômage, réfugiés, militaires, retraites — L. 553-3)";
    label en unofficial "amount of competing increases (unemployment, refugees, military, pensions - L. 553-3)";
}

relation montant_prestations_familiales(p: Personne, montant: Money) kind empirical {
    key(p);
    label fr official "montant des prestations familiales dues pour le même enfant (L. 553-3)";
    label en unofficial "amount of family benefits due for the same child (L. 553-3)";
}

relation majorations_reduites(p: Personne, montant: Money) kind institutional {
    key(p);
    label fr official "majorations réduites à due concurrence des prestations familiales (L. 553-3 al. 2)";
    label en unofficial "increases reduced by the amount of family benefits (L. 553-3 para. 2)";
}

relation meme_enfant_pf_majoration(p: Personne, e: Enfant) kind empirical {
    key(p, e);
    label fr official "un même enfant ouvre droit aux prestations familiales et à la majoration concurrente (L. 553-3 al. 1)";
    label en unofficial "the same child opens both the family-benefit right and the competing increase (L. 553-3 para. 1)";
}

relation majoration_enumereree_l5533(p: Personne, e: Enfant) kind empirical {
    key(p, e);
    label fr official "la majoration concurrente est l'une des allocations énumérées: chômage, réfugiés, militaires, retraites/pensions Etat/collectivités/prévoyance obligatoire (L. 553-3 al. 1 1°-4°)";
    label en unofficial "the competing increase is one of the listed kinds: unemployment, refugees, military, State/collectivity/compulsory-provision pensions (L. 553-3 para. 1 1-4)";
}

relation cumul_logement_handicape_exception(p: Personne, e: Enfant) kind empirical {
    key(p, e);
    label fr official "allocation de logement pour enfant infirme au-delà des limites d'âge AF, cumulable avec les majorations de retraites/pensions du chef de cet enfant (L. 553-3 al. 3)";
    label en unofficial "housing allowance for a disabled child past AF age limits, cumulable with pension increases for that child (L. 553-3 para. 3)";
}

relation asf_en_cause_l5533(p: Personne, e: Enfant) kind empirical {
    key(p, e);
    label fr official "la prestation familiale en cause est l'allocation de soutien familial, article inapplicable (L. 553-3 al. 4)";
    label en unofficial "the family benefit at issue is ASF, article does not apply (L. 553-3 para. 4)";
}

pub relation saisie_alimentaire_possible(p: Personne) kind empirical {
    label fr official "cas de saisissabilité du 1°/2° du I de l'article L. 553-4 (dettes alimentaires, frais de soins/hébergement/éducation)";
    label en unofficial "seizable case under 1/2 of I of article L. 553-4 (maintenance debts, care/accommodation/education costs)";
}

relation saisie_action(p: Personne) kind empirical {
    key(p);
    label fr official "action: saisie des prestations familiales dans un cas du 1°/2° de L. 553-4";
    label en unofficial "action: attaching family benefits in a 1/2 case of L. 553-4";
}

relation creance_1degre_alimentaire_l581(p: Personne) kind empirical {
    label fr official "dettes alimentaires, contribution aux charges du mariage liées à l'entretien des enfants, ou créances L. 581-1/L. 581-3 (L. 553-4 I 1°)";
    label en unofficial "maintenance debts, marriage-charge contribution for children, or L. 581-1/L. 581-3 claims (L. 553-4 I 1)";
}

relation frais_2degre_soins_hebergement(p: Personne) kind empirical {
    label fr official "frais de soins, hébergement, éducation ou formation, notamment établissements L. 541-1 (L. 553-4 I 2°)";
    label en unofficial "care, accommodation, education or training costs, notably L. 541-1 establishments (L. 553-4 I 2)";
}

relation prestation_listee_1degre(p: Personne) kind empirical {
    label fr official "prestation en cause: allocation de base, PreParE, AF, CF, ARS ou ASF (L. 553-4 I 1°)";
    label en unofficial "benefit at issue: base allowance, PreParE, AF, CF, ARS or ASF (L. 553-4 I 1)";
}

relation prestation_aeeh_2degre(p: Personne) kind empirical {
    label fr official "prestation en cause: allocation d'éducation de l'enfant handicapé (L. 553-4 I 2°)";
    label en unofficial "benefit at issue: disabled-child education allowance (L. 553-4 I 2)";
}

relation frais_aeeh_impayes(p: Personne) kind empirical {
    label fr official "frais L. 553-4 I 2° non payés à la personne assumant l'éducation spéciale, la formation ou l'entretien";
    label en unofficial "L. 553-4 I 2 costs unpaid to the person bearing special education, training or upkeep";
}

relation assume_charge_education_speciale(e: Personne, p: Personne) kind empirical {
    key(e, p);
    label fr official "la personne physique ou morale assume la charge de l'éducation spéciale, de la formation ou de l'entretien de l'enfant (L. 553-4 I 2°)";
    label en unofficial "natural or legal person bears the child's special education, training or upkeep charge (L. 553-4 I 2)";
}

relation versement_direct_aeeh_action(o: Organisme, e: Personne, p: Personne) kind empirical {
    key(o, e, p);
    label fr official "action: versement direct de l'AEEH à la personne assumant la charge, par l'organisme débiteur";
    label en unofficial "action: direct AEEH payment to the charge-bearing person by the debtor body";
}

relation parent_debiteur_beneficiaire_pf(p: Personne) kind empirical {
    label fr official "le parent débiteur est bénéficiaire de prestations familiales (L. 553-4 I, intermédiation L. 582-1)";
    label en unofficial "the debtor parent receives family benefits (L. 553-4 I, L. 582-1 intermediation)";
}

relation intermediation_financiere_l5821(p: Personne) kind empirical {
    label fr official "intermédiation financière de la pension alimentaire prévue à L. 582-1 en cours (fait constaté)";
    label en unofficial "L. 582-1 maintenance-payment intermediation in course (stated fact)";
}

relation accord_paiement_pension_pf(p: Personne) kind empirical {
    label fr official "le parent débiteur consent au paiement de la pension sur ses prestations familiales (L. 553-4 I)";
    label en unofficial "the debtor parent agrees to pension payment from family benefits (L. 553-4 I)";
}

relation prelevement_pension_intermediation_action(o: Organisme, p: Personne) kind empirical {
    key(o, p);
    label fr official "action: paiement de la pension alimentaire sur les prestations familiales via l'intermédiation";
    label en unofficial "action: maintenance payment from family benefits through intermediation";
}

relation demande_cotisations_volontaires(p: Personne) kind empirical {
    label fr official "l'allocataire demande le recouvrement des cotisations d'assurance volontaire L. 742-1 sur ses prestations (L. 553-4 I)";
    label en unofficial "allocataire requests L. 742-1 voluntary-insurance contributions from benefits (L. 553-4 I)";
}

relation prestation_l5111_hors_logement(p: Personne) kind empirical {
    label fr official "prestation visée à L. 511-1, autre que l'allocation de logement (L. 553-4 I)";
    label en unofficial "L. 511-1 benefit other than housing allowance (L. 553-4 I)";
}

relation recouvrement_cotisations_action(o: Organisme, p: Personne) kind empirical {
    key(o, p);
    label fr official "action: recouvrement des cotisations volontaires L. 742-1 sur les prestations familiales";
    label en unofficial "action: recovering voluntary L. 742-1 contributions from family benefits";
}

relation compte_courant_bloque(p: Personne) kind empirical {
    label fr official "blocage d'un compte courant de dépôts ou d'avances recevant les prestations (L. 553-4 III)";
    label en unofficial "blocking of a deposit or advance current account receiving benefits (L. 553-4 III)";
}

relation protection_compte_maintenue(p: Personne) kind institutional {
    key(p);
    label fr official "le blocage ne fait pas obstacle à l'insaisissabilité et à l'incessibilité (L. 553-4 III al. 1)";
    label en unofficial "blocking does not defeat unseizability and unassignability (L. 553-4 III para. 1)";
}

relation prestations_versees_compte(p: Personne, montant: Money) kind empirical {
    key(p);
    label fr official "prestations familiales servies par versement à un compte courant, montant mensuel (L. 553-4 III al. 2)";
    label en unofficial "family benefits paid into a current account, monthly amount (L. 553-4 III para. 2)";
}

relation retrait_mensuel_autorise_limite(p: Personne, montant: Money) kind institutional {
    key(p);
    label fr official "retrait mensuel autorisé malgré opposition, dans la limite des prestations versées (L. 553-4 III al. 2)";
    label en unofficial "monthly withdrawal allowed despite opposition, up to the paid benefits (L. 553-4 III para. 2)";
}

relation retrait_fonds_action(p: Personne) kind empirical {
    key(p);
    label fr official "action: retrait mensuel de fonds du compte courant malgré opposition";
    label en unofficial "action: monthly fund withdrawal from the current account despite opposition";
}

@source(CSS_L553_4, CSS_L553_4_CSS_ED2021_05, CSS_L553_4_CSS_ED2021_11, CSS_L553_4_CSS_ED2021_12,
        CSS_L553_4_CSS_ED2022_01, CSS_L553_4_CSS_ED2022_02, CSS_L553_4_CSS_ED2022_03,
        CSS_L553_4_CSS_ED2022_09, CSS_L553_4_CSS_ED2023_07, CSS_L553_4_CSS_ED2024_01,
        CSS_L553_4_CSS_ED2025_02, CSS_L553_4_CSS_ED2025_09, CSS_L553_4_CSS_ED2025_12,
        CSS_L553_4_CSS_ED2026_01, CSS_L553_4_CSS_ED2026_04, CSS_L553_4_CSS_ED2026_06)
external judgment relation disproportion_train_de_vie(p: Personne) {
    authority Organisme;
    label fr official "disproportion marquée entre le train de vie et les ressources déclarées (L. 553-5 al. 1)";
    label en unofficial "marked disproportion between lifestyle and declared resources (L. 553-5 para. 1)";
}

relation evaluation_forfaitaire_possible(p: Personne) kind institutional {
    key(p);
    label fr official "une évaluation forfaitaire des éléments de train de vie peut être prise en compte (L. 553-5 al. 1)";
    label en unofficial "lump-sum assessment of lifestyle items may be counted (L. 553-5 para. 1)";
}

function indemnite_dix_pourcent(sommes: Money) -> Money =
    sommes * 0.10;

function majorations_apres_priorite(majorations: Money, prestations: Money) -> Money =
    majorations - prestations;

const ZeroMajorations: Money = 0.00 EUR {
    label fr official "majorations entièrement exclues par priorité (L. 553-3 al. 1)";
    label en unofficial "increases fully excluded by priority (L. 553-3 para. 1)";
}

@source(CSS_L553_2, CSS_L553_2_CSS_ED2025_02, CSS_L553_2_CSS_ED2025_09, CSS_L553_2_CSS_ED2025_12,
        CSS_L553_2_CSS_ED2026_01, CSS_L553_2_CSS_ED2026_04, CSS_L553_2_CSS_ED2026_06)
rule InduRetenues(p: Personne, montant: Money) strict {
    effective [@2024-01-01, infinity);
    label fr official "Tout indu est récupéré par retenues sur les prestations à venir, sauf option du remboursement unique";
    label en unofficial "Every indu is recovered by deductions from future benefits, absent the single-repayment option";
    when indu_constate(p, montant) and not option_remboursement_unique(p);
    then indu_recupere_retenues(p);
}

@source(CSS_L553_2, CSS_L553_2_CSS_ED2025_02, CSS_L553_2_CSS_ED2025_09, CSS_L553_2_CSS_ED2025_12,
        CSS_L553_2_CSS_ED2026_01, CSS_L553_2_CSS_ED2026_04, CSS_L553_2_CSS_ED2026_06)
rule InduRemboursementUnique(p: Personne, montant: Money) strict {
    effective [@2024-01-01, infinity);
    label fr official "Si l'allocataire opte pour cette solution: remboursement intégral en un seul versement";
    label en unofficial "At the allocataire's option: full repayment in a single payment";
    when indu_constate(p, montant) and option_remboursement_unique(p);
    then indu_rembourse_unique(p);
}

@source(CSS_L553_2, CSS_L553_2_CSS_ED2025_02, CSS_L553_2_CSS_ED2025_09, CSS_L553_2_CSS_ED2025_12,
        CSS_L553_2_CSS_ED2026_01, CSS_L553_2_CSS_ED2026_04, CSS_L553_2_CSS_ED2026_06)
rule IndemniteFraisGestion(p: Personne, sommes: Money) strict {
    effective [@2024-01-01, infinity);
    label fr official "En cas de fraude: indemnité de 10 % des sommes réclamées au titre des prestations versées à tort";
    label en unofficial "In case of fraud: 10% indemnity on amounts wrongly paid";
    when indu_constate(p, sommes) and indu_frauduleux(p);
    then indemnite_frais_gestion(p, indemnite_dix_pourcent(sommes));
}

@source(CSS_L553_2, CSS_L553_2_CSS_ED2025_02, CSS_L553_2_CSS_ED2025_09, CSS_L553_2_CSS_ED2025_12,
        CSS_L553_2_CSS_ED2026_01, CSS_L553_2_CSS_ED2026_04, CSS_L553_2_CSS_ED2026_06)
rule ReiterationFraude(p: Personne, premiere: Date, nouvelle: Date) strict {
    effective [@2024-01-01, infinity);
    label fr official "Réitération de la fraude dans les cinq ans de la notification: le taux de majoration est doublé";
    label en unofficial "Repeat fraud within five years of notification: the increase rate is doubled";
    when premiere_majoration_notifiee_le(p, premiere) and nouvelle_fraude_le(p, nouvelle)
        and nouvelle < add_calendar_period(premiere, 5 calendar_year);
    then fraude_reiteree(p);
}

@source(CSS_L553_2_1, CSS_L553_2_1_CSS_ED2025_09, CSS_L553_2_1_CSS_ED2025_12,
        CSS_L553_2_1_CSS_ED2026_01, CSS_L553_2_1_CSS_ED2026_04, CSS_L553_2_1_CSS_ED2026_06)
rule ContrainteApresMiseEnDemeure(p: Personne, mise: Date, date: Date) strict {
    effective [@2025-02-28, infinity);
    label fr official "Etablissement éligible, notification, rejet des observations, mise en demeure recommandée restée sans effet après un mois: contrainte à effets de jugement (opposition non requise pour la délivrance)";
    label en unofficial "Eligible establishment, notice, rejected observations, registered demand without effect after one month: contrainte with judgment effect (no opposition needed for issue)";
    when etablissement_service_eligible_l5532_1(p) and notification_recouvrement_adressee(p)
        and observations_interesse_rejetees(p) and mise_en_demeure_adressee_le(p, mise)
        and mise_en_demeure_sans_effet(p, mise) and date_appreciation(p, date)
        and date >= add_calendar_period(mise, 1 calendar_month);
    then contrainte_possible(p);
}

@source(CSS_L553_2_1, CSS_L553_2_1_CSS_ED2025_09, CSS_L553_2_1_CSS_ED2025_12,
        CSS_L553_2_1_CSS_ED2026_01, CSS_L553_2_1_CSS_ED2026_04, CSS_L553_2_1_CSS_ED2026_06)
rule MajorationMiseEnDemeure(p: Personne, sommes: Money, mise: Date, echeance: Date, date: Date) strict {
    effective [@2025-02-28, infinity);
    label fr official "Etablissement éligible, notification initiale, rejet des observations, mise en demeure recommandée: majoration de 10 % des sommes issues de la notification, non réglées à l'exigibilité échue (remise possible)";
    label en unofficial "Eligible establishment, initial notice, rejected observations, registered demand: 10% increase on notice-sourced sums unpaid at the passed due date (remission possible)";
    when etablissement_service_eligible_l5532_1(p) and notification_recouvrement_adressee(p)
        and observations_interesse_rejetees(p) and mise_en_demeure_adressee_le(p, mise)
        and sommes_mise_issues_notification(p, sommes) and sommes_non_reglees(p, sommes)
        and date_exigibilite_mise_le(p, echeance) and date_appreciation(p, date)
        and date >= echeance;
    then majoration_mise_en_demeure(p, indemnite_dix_pourcent(sommes));
}

@source(CSS_L553_2_1, CSS_L553_2_1_CSS_ED2025_09, CSS_L553_2_1_CSS_ED2025_12,
        CSS_L553_2_1_CSS_ED2026_01, CSS_L553_2_1_CSS_ED2026_04, CSS_L553_2_1_CSS_ED2026_06)
rule RemiseMajorationMiseEnDemeure(o: Organisme, p: Personne, montant: Money) strict {
    effective [@2025-02-28, infinity);
    label fr official "La majoration de 10 % appliquée peut faire l'objet d'une remise par l'organisme";
    label en unofficial "The applied 10% increase may be remitted by the body";
    when majoration_mise_en_demeure(p, montant) and organisme_debiteur_pf(o, p);
    then liberty RemettreMajorationMiseEnDemeure {
        holder o;
        action remettre_majoration_action(o, p);
        window [@2025-02-28, infinity);
    };
}

@source(CSS_L553_3, CSS_L553_3_CSS_ED2021_05, CSS_L553_3_CSS_ED2021_11, CSS_L553_3_CSS_ED2021_12,
        CSS_L553_3_CSS_ED2022_01, CSS_L553_3_CSS_ED2022_02, CSS_L553_3_CSS_ED2022_03,
        CSS_L553_3_CSS_ED2022_09, CSS_L553_3_CSS_ED2023_07, CSS_L553_3_CSS_ED2024_01,
        CSS_L553_3_CSS_ED2025_02, CSS_L553_3_CSS_ED2025_09, CSS_L553_3_CSS_ED2025_12,
        CSS_L553_3_CSS_ED2026_01, CSS_L553_3_CSS_ED2026_04, CSS_L553_3_CSS_ED2026_06)
rule PrioritePrestations(p: Personne, e: Enfant, prestations: Money, majorations: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "Même enfant et majoration énumérée, hors logement-handicapé et hors ASF: prestations par priorité, majorations réduites à due concurrence";
    label en unofficial "Same child and listed increase, outside housing-disabled and ASF exclusions: priority benefits, increases reduced accordingly";
    when montant_prestations_familiales(p, prestations) and montant_majorations_concurrentes(p, majorations)
        and meme_enfant_pf_majoration(p, e) and majoration_enumereree_l5533(p, e)
        and not cumul_logement_handicape_exception(p, e) and not asf_en_cause_l5533(p, e)
        and prestations < majorations;
    then majorations_reduites(p, majorations_apres_priorite(majorations, prestations));
}

@source(CSS_L553_3, CSS_L553_3_CSS_ED2021_05, CSS_L553_3_CSS_ED2021_11, CSS_L553_3_CSS_ED2021_12,
        CSS_L553_3_CSS_ED2022_01, CSS_L553_3_CSS_ED2022_02, CSS_L553_3_CSS_ED2022_03,
        CSS_L553_3_CSS_ED2022_09, CSS_L553_3_CSS_ED2023_07, CSS_L553_3_CSS_ED2024_01,
        CSS_L553_3_CSS_ED2025_02, CSS_L553_3_CSS_ED2025_09, CSS_L553_3_CSS_ED2025_12,
        CSS_L553_3_CSS_ED2026_01, CSS_L553_3_CSS_ED2026_04, CSS_L553_3_CSS_ED2026_06)
rule PrioritePrestationsExclusionTotale(p: Personne, e: Enfant, prestations: Money, majorations: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "Priorité absorbant toute la majoration: majorations exclues, ramenées à zéro";
    label en unofficial "Priority consuming the whole increase: increases excluded, reduced to zero";
    when montant_prestations_familiales(p, prestations) and montant_majorations_concurrentes(p, majorations)
        and meme_enfant_pf_majoration(p, e) and majoration_enumereree_l5533(p, e)
        and not cumul_logement_handicape_exception(p, e) and not asf_en_cause_l5533(p, e)
        and prestations >= majorations;
    then majorations_reduites(p, ZeroMajorations);
}

@source(CSS_L553_4, CSS_L553_4_CSS_ED2021_05, CSS_L553_4_CSS_ED2021_11, CSS_L553_4_CSS_ED2021_12,
        CSS_L553_4_CSS_ED2022_01, CSS_L553_4_CSS_ED2022_02, CSS_L553_4_CSS_ED2022_03,
        CSS_L553_4_CSS_ED2022_09, CSS_L553_4_CSS_ED2023_07, CSS_L553_4_CSS_ED2024_01,
        CSS_L553_4_CSS_ED2025_02, CSS_L553_4_CSS_ED2025_09, CSS_L553_4_CSS_ED2025_12,
        CSS_L553_4_CSS_ED2026_01, CSS_L553_4_CSS_ED2026_04, CSS_L553_4_CSS_ED2026_06)
rule Insaisissabilite(p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "Les prestations familiales sont incessibles et insaisissables";
    label en unofficial "Family benefits are unassignable and unseizable";
    when allocataire(p);
    then immunity InsaisissabilitePrestations {
        holder p;
        protected_effect saisie_action(p);
        window [@2021-01-01, infinity);
    };
}

@source(CSS_L553_4, CSS_L553_4_CSS_ED2021_05, CSS_L553_4_CSS_ED2021_11, CSS_L553_4_CSS_ED2021_12,
