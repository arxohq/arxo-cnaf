rule PensionIntermediationAccord(o: Organisme, p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "Parent débiteur bénéficiaire: pension via l'intermédiation L. 582-1 prélevée sur les prestations avec son accord";
    label en unofficial "Debtor parent on benefits: pension through L. 582-1 intermediation taken from benefits with agreement";
    when parent_debiteur_beneficiaire_pf(p) and organisme_debiteur_pf(o, p)
        and intermediation_financiere_l5821(p) and accord_paiement_pension_pf(p);
    then liberty PrelevementPensionIntermediation {
        holder o;
        action prelevement_pension_intermediation_action(o, p);
        window [@2021-01-01, infinity);
    };
}

