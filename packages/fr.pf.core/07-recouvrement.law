rule SaisiePrestation1Degre(o: Organisme, p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "1° du I: saisie possible d'une prestation listée (base, PreParE, AF, CF, ARS, ASF) pour dette alimentaire ou créance L. 581";
    label en unofficial "I 1: listed benefit (base, PreParE, AF, CF, ARS, ASF) attachable for maintenance or L. 581 claim";
    when allocataire(p) and organisme_debiteur_pf(o, p) and saisie_alimentaire_possible(p)
        and creance_1degre_alimentaire_l581(p) and prestation_listee_1degre(p);
    then liberty SaisieCas1Degre {
        holder o;
        action saisie_action(p);
        window [@2021-01-01, infinity);
    };
}

