// Indu recovery and immunities: L. 553-2 (retenues, single repayment,
// 10% indemnity for fraude), L. 553-2-1 (mise en demeure 1 month, contrainte,
// 10% majoration), L. 553-3 (PF priority over majorations), L. 553-4
// (incessibilite/insaisissabilite + exceptions), L. 553-5 (train de vie -
// organ judgment channel).
//
// DEONTIC MAP:
// - L. 553-2 para. 1 "est recupere" - organ duty to recover (duty,
//   maintain indu_recupere); choice of means - allocataire liberty
//   (single repayment) with a case window.
// - Retenues scale (decree, D. 553-1 out of scope) - boundary: rate not derived.
//   Majoration <= 50% and doubling on repeat - decree rate (boundary),
//   repeat condition (5 years) executable.
// - L. 553-4 I - immunity (incessibilite/insaisissabilite), defeater - fraude;
//   1/2 - permission to attach (creditor/organ liberty) by the named
//   means (L. 553-2 para. 3).
// - L. 553-5 "disproportion marquee" - two channels (PC-R03-04): outside the
//   R. 553-3 section (other benefits) the organ judgment enables the forfait;
//   inside the section (PAJE/CF/ARS) only the R. 553-3-5 regulatory finding
//   (twice the ceiling) enables it, via EvaluationForfaitaireReglementaire.

language "law.core" version "0.2";
package fr.pf.core version "0.1.0";
namespace "urn:fr:corpus:clir:pf-core";

use self::{
    CSS_L553_2,
    CSS_L553_2_1,
    CSS_L553_2_1_CSS_ED2025_09,
    CSS_L553_2_1_CSS_ED2025_12,
    CSS_L553_2_1_CSS_ED2026_01,
    CSS_L553_2_1_CSS_ED2026_04,
    CSS_L553_2_1_CSS_ED2026_06,
    CSS_L553_2_CSS_ED2025_02,
    CSS_L553_2_CSS_ED2025_09,
    CSS_L553_2_CSS_ED2025_12,
    CSS_L553_2_CSS_ED2026_01,
    CSS_L553_2_CSS_ED2026_04,
    CSS_L553_2_CSS_ED2026_06,
    CSS_L553_3,
    CSS_L553_3_CSS_ED2021_05,
    CSS_L553_3_CSS_ED2021_11,
    CSS_L553_3_CSS_ED2021_12,
    CSS_L553_3_CSS_ED2022_01,
    CSS_L553_3_CSS_ED2022_02,
    CSS_L553_3_CSS_ED2022_03,
    CSS_L553_3_CSS_ED2022_09,
