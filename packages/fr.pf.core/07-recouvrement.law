rule SaisieFraudePossible(o: Organisme, p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "Sauf pour le recouvrement des indus versés à la suite d'une manoeuvre frauduleuse: saisie possible (L. 553-4 I, première branche)";
    label en unofficial "Except recovery of overpayments following a fraudulent scheme: attachment possible (L. 553-4 I, first branch)";
    when allocataire(p) and organisme_debiteur_pf(o, p) and indu_frauduleux(p);
    then liberty SaisieInduFrauduleux {
        holder o;
        action saisie_action(p);
        window [@2021-01-01, infinity);
    };
}

