        CSS_R553_3_5_CSS_ED2026_06)
rule EvaluationForfaitaireReglementaire(p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "Section R. 553-3: disproportion réglementaire au double du plafond, forfait pris en compte pour le droit (L. 553-5 via R. 553-3-5)";
    label en unofficial "R. 553-3 section: regulatory disproportion at twice the ceiling, schedule counts (L. 553-5 via R. 553-3-5)";
    when disproportion_reglementaire_constatee(p);
    then evaluation_forfaitaire_possible(p);
}
