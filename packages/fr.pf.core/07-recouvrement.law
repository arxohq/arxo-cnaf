        CSS_L553_5_CSS_ED2025_02, CSS_L553_5_CSS_ED2025_09, CSS_L553_5_CSS_ED2025_12,
        CSS_L553_5_CSS_ED2026_01, CSS_L553_5_CSS_ED2026_04, CSS_L553_5_CSS_ED2026_06)
rule EvaluationForfaitaireTrainDeVie(p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "Hors section R. 553-3 (autres prestations): disproportion marquée constatée par l'organisme, forfait pris en compte (L. 553-5)";
    label en unofficial "Outside the R. 553-3 section (other benefits): organ-found marked disproportion, schedule counts (L. 553-5)";
    when disproportion_train_de_vie(p) and prestation_hors_section(p)
        and not section_train_vie_applicable(p);
    then evaluation_forfaitaire_possible(p);
}

