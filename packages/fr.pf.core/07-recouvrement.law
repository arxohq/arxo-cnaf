rule PaiementDirectAeehFraisImpayes(o: Organisme, e: Personne, p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "2° du I: frais impayés, la personne assumant la charge obtient le versement direct de l'AEEH";
    label en unofficial "I 2: unpaid costs, the charge-bearing person obtains direct AEEH payment";
    when allocataire(p) and organisme_debiteur_pf(o, p)
        and frais_aeeh_impayes(p) and assume_charge_education_speciale(e, p);
    then liberty PaiementDirectAeeh {
        holder e;
        action versement_direct_aeeh_action(o, e, p);
        window [@2021-01-01, infinity);
    };
}

