@source(CSS_L554_2, CSS_L554_2_CSS_ED2021_05, CSS_L554_2_CSS_ED2021_11, CSS_L554_2_CSS_ED2021_12,
        CSS_L554_2_CSS_ED2022_01, CSS_L554_2_CSS_ED2022_02, CSS_L554_2_CSS_ED2022_03,
        CSS_L554_2_CSS_ED2022_09, CSS_L554_2_CSS_ED2023_07, CSS_L554_2_CSS_ED2024_01,
        CSS_L554_2_CSS_ED2025_02, CSS_L554_2_CSS_ED2025_09, CSS_L554_2_CSS_ED2025_12,
        CSS_L554_2_CSS_ED2026_01, CSS_L554_2_CSS_ED2026_04, CSS_L554_2_CSS_ED2026_06)
rule InterdireOffreServices(i: Personne, p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "Interdiction d'offrir directement à un allocataire des services rémunérés pour obtenir des prestations";
    label en unofficial "No directly offering an allocataire paid services to obtain benefits";
    when intermediaire_convaincu(i) and allocataire(p);
    then prohibition OffrirServicesRemuneres {
        bearer i;
        beneficiary p;
        action offrir_services_action(i, p);
        window [@2021-01-01, infinity);
    };
}

@source(CSS_L554_2, CSS_L554_2_CSS_ED2021_05, CSS_L554_2_CSS_ED2021_11, CSS_L554_2_CSS_ED2021_12,
        CSS_L554_2_CSS_ED2022_01, CSS_L554_2_CSS_ED2022_02, CSS_L554_2_CSS_ED2022_03,
        CSS_L554_2_CSS_ED2022_09, CSS_L554_2_CSS_ED2023_07, CSS_L554_2_CSS_ED2024_01,
        CSS_L554_2_CSS_ED2025_02, CSS_L554_2_CSS_ED2025_09, CSS_L554_2_CSS_ED2025_12,
        CSS_L554_2_CSS_ED2026_01, CSS_L554_2_CSS_ED2026_04, CSS_L554_2_CSS_ED2026_06)
rule InterdireFaireOffrirServices(i: Personne, p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "Interdiction de faire offrir par un tiers à un allocataire des services rémunérés pour obtenir des prestations";
    label en unofficial "No causing a third party to offer an allocataire paid services to obtain benefits";
    when intermediaire_convaincu(i) and allocataire(p);
    then prohibition FaireOffrirServicesRemuneres {
        bearer i;
        beneficiary p;
        action faire_offrir_services_action(i, p);
        window [@2021-01-01, infinity);
    };
}

@source(CSS_L554_2, CSS_L554_2_CSS_ED2021_05, CSS_L554_2_CSS_ED2021_11, CSS_L554_2_CSS_ED2021_12,
        CSS_L554_2_CSS_ED2022_01, CSS_L554_2_CSS_ED2022_02, CSS_L554_2_CSS_ED2022_03,
        CSS_L554_2_CSS_ED2022_09, CSS_L554_2_CSS_ED2023_07, CSS_L554_2_CSS_ED2024_01,
        CSS_L554_2_CSS_ED2025_02, CSS_L554_2_CSS_ED2025_09, CSS_L554_2_CSS_ED2025_12,
        CSS_L554_2_CSS_ED2026_01, CSS_L554_2_CSS_ED2026_04, CSS_L554_2_CSS_ED2026_06)
rule AmendeIntermediaireConvaincu(i: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "Sera puni d'une amende de 4 500 euros tout intermédiaire convaincu";
    label en unofficial "Every convicted intermediary is punished by a EUR 4,500 fine";
    when intermediaire_convaincu(i);
    then amende_encourue(i, AmendeIntermediaire);
}

@source(CSS_L554_3, CSS_L554_3_CSS_ED2021_05, CSS_L554_3_CSS_ED2021_11, CSS_L554_3_CSS_ED2021_12,
