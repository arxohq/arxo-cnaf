        CSS_L554_3_CSS_ED2022_09, CSS_L554_3_CSS_ED2023_07, CSS_L554_3_CSS_ED2024_01,
        CSS_L554_3_CSS_ED2025_02, CSS_L554_3_CSS_ED2025_09, CSS_L554_3_CSS_ED2025_12,
        CSS_L554_3_CSS_ED2026_01, CSS_L554_3_CSS_ED2026_04, CSS_L554_3_CSS_ED2026_06)
rule PlafondCoutInsertionCondamne(p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "Le coût de l'insertion, aux frais du condamné, ne peut dépasser 150 euros";
    label en unofficial "Insertion cost, charged to the convicted person, capped at EUR 150";
    when personne_condamnee(p);
    then cout_insertion_plafond(p, PlafondInsertion);
}
