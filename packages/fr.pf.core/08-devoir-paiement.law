rule DevoirSupporterFraisMesureDOM(o: Organisme, p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "DOM: l'organisme désigné supporte les frais de la mesure (L. 755-4 al. 2-3)";
    label en unofficial "DOM: the designated body bears the cost of the measure (L. 755-4 paras. 2-3)";
    when frais_mesure_a_charge_dom(o, p);
    then duty SupporterFraisMesureDOM {
        bearer o;
        beneficiary p;
        maintain frais_mesure_supportes(o, p) during [@2021-01-01, infinity);
