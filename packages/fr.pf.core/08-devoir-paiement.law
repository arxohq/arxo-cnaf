        CSS_L554_3_CSS_ED2026_01, CSS_L554_3_CSS_ED2026_04, CSS_L554_3_CSS_ED2026_06)
rule InsertionJugementTribunal(j: Juridiction, p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "En cas de condamnation le tribunal pourra ordonner l'insertion du jugement";
    label en unofficial "On conviction the court may order insertion of the judgment";
    when condamnation_prononcee(j, p);
    then liberty OrdonnerInsertionJugement {
        holder j;
        action inserer_jugement_action(j, p);
        window [@2021-01-01, infinity);
    };
}

@source(CSS_L554_3, CSS_L554_3_CSS_ED2021_05, CSS_L554_3_CSS_ED2021_11, CSS_L554_3_CSS_ED2021_12,
