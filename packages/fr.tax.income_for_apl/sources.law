// Провенанс §194: одна статья CGI (ст. 83 3°, вычет за профессиональные
// расходы), закреплённая семью редакциями с 1 января 2020 года по настоящее
// время — ровно те окна, где меняется закреплённое значение потолка либо
// пола. Байты — открытые данные LEGI (DILA), тот же дамп, что закрепляет
// fr.apl (Freemium_legi_global_20250713-140000.tar.gz,
// sha256 f862b4a2238e11ec3c48ec70f3b1c68bac0bb1985907841666b98608653d4eca).
//
// СТАТЬЯ 83 ЦЕЛИКОМ не закреплена: она несёт больше десяти пунктов (взносы
// соцстраха, PER, мутуали и т.д.), из которых пакет читает только пункт 3°
// (форфейтный вычет 10% с потолком и полом). Остальные пункты — граница
// объёма, названная в README.
//
// ПОЧЕМУ РЕДАКЦИЙ СЕМЬ, А НЕ ДЕСЯТЬ. LEGI даёт десять версий статьи в этом
// окне, но пункт 3° меняется РЕЖЕ — другие части статьи 83 менялись отдельно
// (переносы года и потолка публикуются одним законом о бюджете, но LEGI
// заводит новую версию статьи при любой правке любого пункта). Соседние
// версии с байтово тождественным пунктом 3° объединены в одну редакцию
// здесь; расхождение подтверждено сравнением text_sha256 (см. отчёт фазы 1).

language "law.core" version "0.2";
package fr.tax.income_for_apl version "0.1.0";
namespace "urn:fr:tax:clir:income-for-apl";

