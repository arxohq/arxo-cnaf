@id("urn:fr:corpus:clir:revalorisation#DSS_SD2B_2016_396_REVAL")
pub fragment DSS_SD2B_2016_396_REVAL in DSS_SD2B_2016_396_TEXT {
    kind guidance;
    locator "instruction/dss-sd2b-2016-396/reconduction";
    text fr official """  Or compte tenu de la stabilité des prix en 2015, les différents plafonds et montants, pour la
période du 1er janvier 2016 au 31 décembre 2016, sont reconduits à l’identique pour la période
du 1er janvier 2017 au 31 décembre 2017.
""";
    content_hash "sha256:08e071af898da91ec490c1f1cdc650a90c44883538d49fbb3185ee74784bb130";
}

@id("urn:fr:corpus:clir:revalorisation#DSS_SD2B_2016_396_PLAFOND_AF")
pub fragment DSS_SD2B_2016_396_PLAFOND_AF in DSS_SD2B_2016_396_TEXT {
    kind table;
    locator "instruction/dss-sd2b-2016-396/section/I/plafonds-allocations-familiales";
    text fr official """  Plafonds de ressources applicables pour l’attribution du montant modulé des allocations familiales,
de la majoration pour âge et de l’allocation forfaitaire, du 1er janvier 2017 au 31 décembre 2017 (à
comparer au revenu net catégoriel de l’année 2015).

    NOMBRE D’ENFANTS À CHARGE                             TRANCHE 1                       TRANCHE 2                      TRANCHE 3
                    2 enfants                                 ≤ 67 408                     ≤ 89 847                           > 89 847
                    3 enfants                                 ≤ 73 025                     ≤ 95 464                           > 95 464
                    4 enfants                                 ≤ 78 642                     ≤ 101 081                         > 101 081
                    5 enfants                                 ≤ 84 259                     ≤ 106 698                         > 106 698
            Par enfant supplémentaire                         + 5 617                        + 5 617                           + 5 617
Nota bene : La première tranche est celle dont les revenus sont inférieurs ou égaux à un plafond de base de 56 174 € majoré de 5 617 € par
enfant à charge. La deuxième tranche est celle dont les revenus sont supérieurs à un plafond de base de 56 174 € majoré de 5 617 € par enfant
à charge mais inférieurs ou égaux au plafond de base de 78 613 € majoré de 5 617 € par enfant à charge. La troisième tranche est celle dont les
revenus sont supérieurs au plafond de base de 78 613 € majoré de 5 617 € par enfant à charge.
""";
    content_hash "sha256:9aa3a93e3ce9807fa36f593ab4cae97b5bab50c6b931135ed1bfd51f442f4d5a";
}

@id("urn:fr:corpus:clir:revalorisation#DSS_SD2B_2016_396_PLAFOND_CF")
pub fragment DSS_SD2B_2016_396_PLAFOND_CF in DSS_SD2B_2016_396_TEXT {
    kind table;
    locator "instruction/dss-sd2b-2016-396/section/II.1/plafonds-complement-familial";
    text fr official """1. Plafonds de ressources applicables pour l’attribution du complément familial, du 1er janvier 2017
  au 31 décembre 2017 et du complément pour frais de l’allocation journalière de présence parentale
  (à comparer au revenu net catégoriel de l’année 2015).
  Plafond de base : 20 947 €
  Majorations :
    25 % par enfant à charge :                5 237 €
    30 % par enfant à charge à partir du 3e : 6 284 €
    pour double activité ou pour isolement : 8 420 €
""";
    content_hash "sha256:2955c94f32a0b7b60fff656ee438afdbc9759d1fe3b1c88b642948e8ea806073";
}

