@id("urn:fr:corpus:clir:revalorisation#DSS_2B_2021_247_PLAFOND_AF")
pub fragment DSS_2B_2021_247_PLAFOND_AF in DSS_2B_2021_247_TEXT {
    kind table;
    locator "instruction/dss-2b-2021-247/section/1/plafonds-allocations-familiales";
    text fr official """Plafonds de ressources applicables pour l’attribution du montant modulé des allocations
familiales, de la majoration pour âge et de l’allocation forfaitaire, du 1er janvier 2022 au
31 décembre 2022 (à comparer au revenu net catégoriel de l'année 2020)

                                                  Tranche 1                Tranche 2                 Tranche 3
     Nombre d'enfants à charge
                                                  (en euros)               (en euros)                (en euros)
                 2 enfants                         ≤ 70 074                 ≤ 93 399                  > 93 399
                 3 enfants                         ≤ 75 913                 ≤ 99 238                  > 99 238
                 4 enfants                         ≤ 81 752                 ≤ 105 077                > 105 077
                 5 enfants                         ≤ 87 591                 ≤ 110 916                > 110 916

       Par enfant supplémentaire                    + 5 839                  + 5 839                   + 5 839
NB : La première tranche est celle dont les revenus sont inférieurs ou égaux à un plafond de base de 58 396 euros majoré de
5 839 euros par enfant à charge. La deuxième tranche est celle dont les revenus sont supérieurs à un plafond de base d e
58 396 euros majoré de 5 839 euros par enfant à charge mais inférieurs ou égaux au plafond de base de 81 721 euros majoré
de 5 839 euros par enfant à charge. La troisième tranche est celle dont les revenus sont supérieurs au plafond de base de
81 721 euros majoré de 5 839 euros par enfant à charge.
""";
    content_hash "sha256:ee0a04fc6ce75e9deb1260123f38c9749f0ae5bc3b1de452ecd912286e7d5ad5";
}

@id("urn:fr:corpus:clir:revalorisation#DSS_2B_2021_247_PLAFOND_CF")
pub fragment DSS_2B_2021_247_PLAFOND_CF in DSS_2B_2021_247_TEXT {
    kind table;
    locator "instruction/dss-2b-2021-247/section/2.1/plafonds-complement-familial";
    text fr official """2.1 - Plafonds de ressources applicables pour l'attribution du complément familial et du
complément pour frais de l’allocation journalière de présence parentale, du 1er janvier 2022
au 31 décembre 2022 (à comparer au revenu net catégoriel de l'année 2020)

Plafond de base : 21 775 €
Majorations :
- 25 % par enfant à charge                                                                5 444 €
- 30 % par enfant à charge à partir du 3ème                                               6 533 €
- pour double activité ou pour isolement                                                  8 752 €
""";
    content_hash "sha256:b8039fa221ef418ffc09ef83360ad5307d86eaab184d515f07c5dd08ab479237";
}

