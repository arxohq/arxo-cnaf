@id("urn:fr:corpus:clir:revalorisation#DSS_2B_2024_181_PLAFOND_AF")
pub fragment DSS_2B_2024_181_PLAFOND_AF in DSS_2B_2024_181_TEXT {
    kind table;
    locator "instruction/dss-2b-2024-181/section/1/plafonds-allocations-familiales";
    text fr official """Plafonds de ressources applicables pour l’attribution du montant modulé des allocations
familiales, de la majoration pour âge et de l’allocation forfaitaire, du 1er janvier 2025 au
31 décembre 2025 (à comparer au revenu net catégoriel de l'année 2023).

                                                Tranche 1                 Tranche 2                 Tranche 3
 Nombre d'enfants à charge
                                                (en euros)                (en euros)                (en euros)
              2 enfants                          ≤ 78 565                  ≤ 104 719                 > 104 719
              3 enfants                          ≤ 85 111                  ≤ 111 265                 > 111 265
              4 enfants                          ≤ 91 657                  ≤ 117 811                 > 117 811
              5 enfants                          ≤ 98 203                  ≤ 124 357                 > 124 357

   Par enfant supplémentaire                      + 6 546                   + 6 546                   + 6 546
NB : la première tranche est celle dont les revenus sont inférieurs ou égaux à un plafond de base de 65 473 euros majoré
de 6 546 euros par enfant à charge. La deuxième tranche est celle dont les revenus sont supérieurs à un plafond de base
de 65 473 euros majoré de 6 546 euros par enfant à charge, mais inférieurs ou égaux au plafond de base de
91 627 euros majoré de 6 546 euros par enfant à charge. La troisième tranche est celle dont les revenus sont supérieurs
au plafond de base de 91 627 euros majoré de 6 546 euros par enfant à charge.
""";
    content_hash "sha256:77282ad8a779131089538b091996077cdf60d7b45ef369dc81e834c17122df75";
}

@id("urn:fr:corpus:clir:revalorisation#DSS_2B_2024_181_PLAFOND_CF")
