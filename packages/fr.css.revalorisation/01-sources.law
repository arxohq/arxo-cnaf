    kind table;
    locator "instruction/dss-2b-2023-41/annexe/table/BMAF";
    text fr official """Base mensuelle de calcul des allocations familiales à compter du 1er avril 2023 : 445,93 €
""";
    content_hash "sha256:b0222a1dc03b4a1ad6f68d9e6fb4db783026196ad470663aaba7bcb125d9bd47";
}

