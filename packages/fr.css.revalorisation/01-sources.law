@id("urn:fr:corpus:clir:revalorisation#DSS_SD2B_2020_33_COEFF")
pub fragment DSS_SD2B_2020_33_COEFF in DSS_SD2B_2020_33_TEXT {
    kind guidance;
    locator "instruction/dss-sd2b-2020-33/coefficient";
    text fr official """Au titre de l’année 2020, l’article 81 de la loi du 24 décembre 2019 de financement de la sécurité
sociale a prévu, par dérogation aux dispositions de l’article L. 161-25, une revalorisation de 0,3 %
du montant des prestations relevant de cet article.
   Le montant précité de la base mensuelle de calcul des allocations familiales (BMAF), en pourcen-
tage duquel sont fixés les montants des prestations familiales, est ainsi porté de 413,16 € à 414,4 €
au 1er avril 2020.
""";
    content_hash "sha256:30203bc31e0b46ec177a182e45334c5e037595a6e4423f527463f7f51f381ded";
}

@id("urn:fr:corpus:clir:revalorisation#DSS_SD2B_2020_33_BMAF")
pub fragment DSS_SD2B_2020_33_BMAF in DSS_SD2B_2020_33_TEXT {
    kind table;
    locator "instruction/dss-sd2b-2020-33/annexe/table/BMAF";
    text fr official """  Base mensuelle de calcul des allocations familiales à compter du 1er avril 2020 : 414,4 €.
""";
    content_hash "sha256:61058b34145b0b8ed55f126f7bedbbb4a5ccbf5a68fca99f20ce95044051d753";
}

