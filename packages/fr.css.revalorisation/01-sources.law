@id("urn:fr:corpus:clir:revalorisation#DSS_SD2B_2019_65_COEFF")
pub fragment DSS_SD2B_2019_65_COEFF in DSS_SD2B_2019_65_TEXT {
    kind guidance;
    locator "instruction/dss-sd2b-2019-65/coefficient";
    text fr official """Au titre de l’année 2019, l’article 68 de la loi du 22 décembre 2018 de financement de la sécurité
sociale a prévu, par dérogation aux dispositions de l’article L. 161-25, une revalorisation de 0,3 % du
montant des prestations relevant de cet article.
  Le montant précité de la base mensuelle de calcul des allocations familiales (BMAF), en pourcen-
tage duquel sont fixés les montants des prestations familiales, est ainsi porté de 411,92 € à 413,16 €
au 1er avril 2019.
""";
    content_hash "sha256:ec188e9862b0cf0017365f8ddc521f39675b6f5d2d59f1da076771f1956b497e";
}

@id("urn:fr:corpus:clir:revalorisation#DSS_SD2B_2019_65_BMAF")
