@id("urn:fr:corpus:clir:revalorisation#DSS_SD2B_2015_92_COEFF")
pub fragment DSS_SD2B_2015_92_COEFF in DSS_SD2B_2015_92_TEXT {
    kind guidance;
    locator "instruction/dss-sd2b-2015-92/coefficient";
    text fr official """   Or, compte tenu de l’inflation constatée pour 2014 et de l’inflation prévisionnelle pour 2015, le
coefficent théorique qui devrait s’appliquer au 1er avril 2015 serait négatif.
   Afin de ne pas pénaliser les familles allocataires par une baisse du montant des prestations
familiales, le montant de la base mensuelle de calcul des allocations familiales sera maintenu à
406,21 € à compter du 1er avril 2015. Le montant des prestations familiales calculées en fonction de
cette base reste donc inchangé.
""";
    content_hash "sha256:309b57086f9ef84ed14583682f6cef8b6747b46b9acbbdf3c41226d5cfbbd6f8";
}

@id("urn:fr:corpus:clir:revalorisation#DSS_SD2B_2015_92_BMAF")
