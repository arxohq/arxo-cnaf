@id("urn:fr:corpus:clir:revalorisation#DSS_SD2B_2014_345_REVAL")
pub fragment DSS_SD2B_2014_345_REVAL in DSS_SD2B_2014_345_TEXT {
    kind guidance;
    locator "instruction/dss-sd2b-2014-345/revalorisation";
    text fr official """   Ces différents plafonds et montants, pour la période du 1er janvier 2015 au 31 décembre 2015,
sont revalorisés de 0,7 % correspondant à l’évolution en moyenne annuelle des prix hors tabac de
l’année 2013.
""";
    content_hash "sha256:f5753fb253d74cbeca8e0b7f7a1118c172839bd616ded587a389d0b3d53b2821";
}

@id("urn:fr:corpus:clir:revalorisation#DSS_SD2B_2014_345_PLAFOND_CF")
pub fragment DSS_SD2B_2014_345_PLAFOND_CF in DSS_SD2B_2014_345_TEXT {
    kind table;
    locator "instruction/dss-sd2b-2014-345/section/I.1/plafonds-complement-familial";
    text fr official """1. Plafonds de ressources applicables pour l’attribution du complément familial, du 1er janvier 2015
  au 31 décembre 2015, et du complément pour frais de l’allocation journalière de présence
  parentale (à comparer au revenu net catégoriel de l’année 2013)
  Base : 20 864 €
  Majorations :
  25 % par enfant à charge 5 216 €
  30 % par enfant à charge à partir du 3e                     6 259 €
  pour double activité ou pour isolement 8 386 €
""";
    content_hash "sha256:97bb107380b21ba7da1da289a550fdab323220a50e6ed0744c5fdf50e8761785";
}

