@id("urn:fr:corpus:clir:revalorisation#DSS_SD2B_2017_97_COEFF")
pub fragment DSS_SD2B_2017_97_COEFF in DSS_SD2B_2017_97_TEXT {
    kind guidance;
    locator "instruction/dss-sd2b-2017-97/coefficient";
    text fr official """  Au 1er avril 2017, le coefficient de revalorisation de la BMAF est ainsi fixé à 1,003, soit un taux de
revalorisation de 0,3 %. Le montant de cette base mensuelle, en pourcentage duquel sont fixées les
prestations familiales, est donc porté de 406,62 € au 1er avril 2016 à 407,84 € au 1er avril 2017.
""";
    content_hash "sha256:54583be0a5c5d95e0e8b89ddcf094bacb3d93dfc822b826e028c6a8d04b6acc7";
}

