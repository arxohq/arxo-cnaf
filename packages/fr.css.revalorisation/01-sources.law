    text fr official """  Base mensuelle de calcul des allocations familiales à compter du 1er avril 2015 : 406,21 €.
""";
    content_hash "sha256:f03d288156956eb05fdf384de46ed03f450b1c637ecb9fdd4c1fbc1452417e87";
}

