    text fr official """ Base mensuelle de calcul des allocations familiales à compter du 1er avril 2019 : 413,16 €.
""";
    content_hash "sha256:bbea14edb0ec501fdbaeffcf72ee93b2e10bb082e644a22907dcf1c9fdbb13b3";
}

