// BMAF 2024 chain (DSS/2B/2024/43, COEFF fragment): previous base
// 445.93, coefficient 1.046 -> 445.93 x 1.046 = 466.44278, rounded to the
// centime -> 466.44, the published 1 April 2024 base. Coefficient 1.046 is
// at/above one, retained nominally.
language "law.core" version "0.2";
package fr.css.revalorisation version "0.1.0";
namespace "urn:fr:corpus:clir:revalorisation";

test "urn:query:fr-revalorisation-bmaf-chaine-2024" {
    given {
        context { deadline_policy REVALO_EXERCICE; decision_time @2024-04-01T12:00:00Z; knowledge_time @2024-04-01T12:00:00Z; legal_time @2024-04-01; timezone "Europe/Paris"; }
        assert "bmaf-01": annee_exercice(entity_ref("urn:fr:revalorisation:exercice:2024"), 2024) { origin case_input; }
        assert "bmaf-02": bmaf_precedente(entity_ref("urn:fr:revalorisation:exercice:2024"), 445.93 EUR) { origin case_input; }
        assert "bmaf-03": coefficient_annee(entity_ref("urn:fr:revalorisation:exercice:2024"), 1.046) { origin case_input; }
    }
    evaluate truth(coefficient_retenu(entity_ref("urn:fr:revalorisation:exercice:2024"), 1.046));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(bmaf_revalorisee(entity_ref("urn:fr:revalorisation:exercice:2024"), 466.44 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
