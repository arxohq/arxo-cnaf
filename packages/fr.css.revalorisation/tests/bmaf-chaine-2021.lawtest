// BMAF 2021 chain (DSS/2B/2021/65, COEFF fragment): previous base 414.40
// (printed 414,4), published coefficient 1.001 (rate 0.1 %) -> 414.40 x 1.001
// = 414.8144, rounded to the centime -> 414.81, the published 1 April 2021
// base. Coefficient 1.001 is at/above one, retained nominally.
language "law.core" version "0.2";
package fr.css.revalorisation version "0.1.0";
namespace "urn:fr:corpus:clir:revalorisation";

test "urn:query:fr-revalorisation-bmaf-chaine-2021" {
    given {
        context { deadline_policy REVALO_EXERCICE; decision_time @2021-04-01T12:00:00Z; knowledge_time @2021-04-01T12:00:00Z; legal_time @2021-04-01; timezone "Europe/Paris"; }
        assert "bmaf-01": annee_exercice(entity_ref("urn:fr:revalorisation:exercice:2021"), 2021) { origin case_input; }
        assert "bmaf-02": bmaf_precedente(entity_ref("urn:fr:revalorisation:exercice:2021"), 414.40 EUR) { origin case_input; }
        assert "bmaf-03": coefficient_annee(entity_ref("urn:fr:revalorisation:exercice:2021"), 1.001) { origin case_input; }
    }
    evaluate truth(coefficient_retenu(entity_ref("urn:fr:revalorisation:exercice:2021"), 1.001));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(bmaf_revalorisee(entity_ref("urn:fr:revalorisation:exercice:2021"), 414.81 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
