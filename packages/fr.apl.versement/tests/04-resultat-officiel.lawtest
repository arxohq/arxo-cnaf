language "law.core" version "0.2";
package fr.apl.versement version "0.1.0";
namespace "urn:fr:corpus:clir:apl:versement";

// Exemple imprimé p. 24. La base 346,53 € reste un témoin du guide; la
// réplique locale des étapes antérieures donne 346,69420 € et l'écart demeure ouvert.
// D-42 (08.10.2026): working reading of fr.apl (G-A13, PpPlancherFinal now pub) selected in context.
test "urn:query:fr-apl-versement-exemple-officiel" {
    given {
        context { decision_time @2021-01-15T12:00:00Z; knowledge_time @2021-01-15T12:00:00Z; legal_time @2021-01-15; timezone "Europe/Paris"; interpretation fr.apl::PpPlancherFinal; }
        assert "base": assiette_crds_auditee_openfisca(entity_ref("urn:fr:apl:versement:officiel"), 346.53 EUR) { origin case_input; }
        assert "territoire": fr.apl::territoire(entity_ref("urn:fr:apl:versement:officiel"), fr.apl::METROPOLE) { origin case_input; }
    }
    evaluate truth(montant_verse(entity_ref("urn:fr:apl:versement:officiel"), 344 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
