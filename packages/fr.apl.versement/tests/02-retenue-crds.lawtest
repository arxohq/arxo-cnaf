language "law.core" version "0.2";
package fr.apl.versement version "0.1.0";
namespace "urn:fr:corpus:clir:apl:versement";

// D-42 (08.10.2026): working reading of fr.apl (G-A13, PpPlancherFinal now pub) selected in context.
test "urn:query:fr-apl-versement-retenue-crds" {
    given {
        context { decision_time @2021-01-15T12:00:00Z; knowledge_time @2021-01-15T12:00:00Z; legal_time @2021-01-15; timezone "Europe/Paris"; interpretation fr.apl::PpPlancherFinal; }
        assert "base": assiette_crds_auditee_openfisca(entity_ref("urn:fr:apl:versement:retenue"), 346.53 EUR) { origin case_input; }
        assert "territoire": fr.apl::territoire(entity_ref("urn:fr:apl:versement:retenue"), fr.apl::METROPOLE) { origin case_input; }
    }
    evaluate truth(crds_precomptee(entity_ref("urn:fr:apl:versement:retenue"), 1.73 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
