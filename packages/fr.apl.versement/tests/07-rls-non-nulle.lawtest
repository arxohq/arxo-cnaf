language "law.core" version "0.2";
package fr.apl.versement version "0.1.0";
namespace "urn:fr:corpus:clir:apl:versement";

// Cas 8 parcouru depuis les faits fr.apl: la RLS de 80,13 € est déduite en
// amont; le pont consomme donc le résultat Arxo 418,9620875 €, pas la base
// OpenFisca 419,3725891113281 €. Le versement de cette chaîne est 416 €.
// L'écart de 0,41 € entre les deux bases est l'étape « diminué d'un montant
// représentatif des contributions sociales, arrondi à l'euro inférieur, puis
// majoré » de D. 823-16, que fr.apl applique AVANT la RLS (497,8975 → 497,4895
// → − 78,5274 = 418,9621) et qu'OpenFisca n'applique pas (497,90 − 78,5274 =
// 419,3726). Ce n'est pas un défaut du pont : différence connue n° 1 de la
// comparaison Ф8 (`verify/ci/tools/compare_openfisca_bank.py`).
// D-42 (08.10.2026): working reading of fr.apl (G-A13, PpPlancherFinal now pub) selected in context.
test "urn:query:fr-apl-versement-rls-non-nulle" {
    given {
        context { decision_time @2021-01-15T12:00:00Z; knowledge_time @2021-01-15T12:00:00Z; legal_time @2021-01-15; timezone "Europe/Paris"; interpretation fr.apl::PpPlancherFinal; }
        assert "01": fr.apl::secteur_locatif(entity_ref("urn:fr:apl:versement:rls")) { origin case_input; }
        assert "02": fr.apl::zone_du_logement(entity_ref("urn:fr:apl:versement:rls"), fr.apl::ZONE_II) { origin case_input; }
        assert "03": fr.apl::aide_demandee(entity_ref("urn:fr:apl:versement:rls"), fr.apl::APL) { origin case_input; }
        assert "04": fr.apl::situation_familiale(entity_ref("urn:fr:apl:versement:rls"), fr.apl::COUPLE) { origin case_input; }
        assert "05": fr.apl::personnes_a_charge(entity_ref("urn:fr:apl:versement:rls"), 4) { origin case_input; }
        assert "06": fr.apl::loyer_principal(entity_ref("urn:fr:apl:versement:rls"), 545.93 EUR) { origin case_input; }
        assert "07": fr.apl::ressources_du_menage(entity_ref("urn:fr:apl:versement:rls"), 11400 EUR) { origin case_input; }
        assert "08": fr.apl::mode_location(entity_ref("urn:fr:apl:versement:rls"), fr.apl::LOCATION_SEULE) { origin case_input; }
        assert "09": fr.apl::forme_logement(entity_ref("urn:fr:apl:versement:rls"), fr.apl::LOGEMENT_ORDINAIRE) { origin case_input; }
        assert "10": fr.apl::reduction_loyer_solidarite(entity_ref("urn:fr:apl:versement:rls"), 80.13 EUR) { origin case_input; }
        assert "11": fr.apl::beneficiaire_aah_ou_aeeh(entity_ref("urn:fr:apl:versement:rls"), false) { origin case_input; }
        assert "12": fr.apl::territoire(entity_ref("urn:fr:apl:versement:rls"), fr.apl::METROPOLE) { origin case_input; }
    }
    evaluate truth(montant_verse(entity_ref("urn:fr:apl:versement:rls"), 416 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
