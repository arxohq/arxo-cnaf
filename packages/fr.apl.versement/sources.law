fragment GUIDE_P22_DEGRESSIVITE_RLS in GUIDE_MINISTERE_2021_FR {
    kind section;
    locator "page/22#degressivite-rls";
    text fr official """L’aide résultant de la formule APL ou AL = L+C-Pp devient, après application de la mesure dégressivité :
APL ou AL = (L + C - Pp) * (cs – (Lréel / Lplafond)) / (cs - cd)""";
    content_hash "sha256:f6563a88edac935c3cfe3351723e5c4997de91617c1b7ff056e9f633c2e15de5";
}

fragment GUIDE_P23_CRDS_ARRONDI in GUIDE_MINISTERE_2021_FR {
    kind section;
    locator "page/23#crds-arrondi";
    text fr official """Le montant effectivement versé au ménage diffère légèrement du montant obtenu par les calculs précédents. Une contribution au remboursement de la dette sociale est prélevée et le montant d’aide, net de cette contribution, est arrondi à l’euro inférieur.""";
    content_hash "sha256:03be0bd68655fb982140d7e021f00cd67c63b59877f4a4b945ca9a9eeb430faa";
}

fragment GUIDE_P24_EXEMPLE in GUIDE_MINISTERE_2021_FR {
    kind section;
    locator "page/24#exemple-metropole";
    text fr official """Aide brute = 346,53 € (la dégressivité de l’aide pour loyer élevé ne s’applique pas car 425 € < 2,5 x 408,16 €)
Aide nette = 346,53 € (seuil de 10 € vérifié)
Aide versée = 344 € (CRDS tronquée au centime, puis application de l’arrondi de l’aide à verser à l’euro inférieur)""";
    content_hash "sha256:a8dbb1c832794f0e97d8c46cb3e82ee31602876eb9fe115b23a5c412b34ddd73";
}

fragment GUIDE_P50_ARRONDIS in GUIDE_MINISTERE_2021_FR {
    kind section;
    locator "page/50#regles-arrondis";
    text fr official """Par défaut, les paramètres du barème des aides personnelles au logement sont arrondis au centime d’euro le plus proche. Aucun arrondi intermédiaire ne doit être réalisé par ailleurs.
CRDS : La CRDS prélevée mensuellement sur l’aide calculée est arrondie au centime inférieur.
Aide versée : Arrondie à l’euro inférieur.""";
    content_hash "sha256:31cbe7bddf758ebc86b47e63514515d704876c5041c532a251c43f58e1b99af3";
}
