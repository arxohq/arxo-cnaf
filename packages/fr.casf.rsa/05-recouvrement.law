// --- Prescription, recovery, appeals ---
@source(
CASF_L262_46,
CASF_L262_46_ED2024_07,
CASF_L262_46_ED2025_01,
CASF_L262_46_ED2025_06,
CASF_L262_46_ED2026_06,
CASF_L262_46_PRE2024,
CASF_L262_46_PRE2024_ED2021_03,
CASF_L262_46_PRE2024_ED2021_04,
CASF_L262_46_PRE2024_ED2023_01,
CASF_R262_92,
CASF_R262_92_ED2021_03,
CASF_R262_92_ED2021_04,
CASF_R262_92_ED2023_01,
CASF_R262_92_ED2024_01,
CASF_R262_92_ED2024_07,
CASF_R262_92_ED2025_01,
CASF_R262_92_ED2025_06,
CASF_R262_92_ED2026_06)
rule InduSousSeuil(p: fr.minima.ressources::Personne, m: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "indu sous 77 € : pas de répétition (L. 262-46 ; R. 262-92)";
    label en unofficial "overpayment below 77 euros: no recovery (L. 262-46; R. 262-92)";
    when indu_montant(p, m)
        and m < SeuilNonRecouvrement;
    then indu_non_recupere(p);
}


@source(
CASF_L262_45,
CASF_L262_45_ED2021_03,
CASF_L262_45_ED2021_04,
CASF_L262_45_ED2023_01,
CASF_L262_45_ED2024_01,
CASF_L262_45_ED2024_07,
CASF_L262_45_ED2025_01,
CASF_L262_45_ED2025_06,
CASF_L262_45_ED2026_06)
rule InduPrescrit(p: fr.minima.ressources::Personne, m: Money, a: Integer) strict {
    effective [@2021-01-01, infinity);
    label fr official "action de deux ans accomplie sans interruption ni fraude : prescrit (L. 262-45 al. 1-2)";
    label en unofficial "two-year action completed with no interruption or fraud: time-barred (L. 262-45 al. 1-2)";
    when indu_montant(p, m)
        and prescription_cours(p, a)
        and a >= 2
        and not_known(interruption_prescription(p))
        and not_known(indu_fraude(p));
    then indu_non_recupere(p);
}


@source(
CASF_L262_46,
CASF_L262_46_ED2024_07,
CASF_L262_46_ED2025_01,
CASF_L262_46_ED2025_06,
CASF_L262_46_ED2026_06,
CASF_L262_46_PRE2024,
CASF_L262_46_PRE2024_ED2021_03,
CASF_L262_46_PRE2024_ED2021_04,
CASF_L262_46_PRE2024_ED2023_01,
CASF_R262_92_1,
CASF_R262_92_1_ED2021_04,
CASF_R262_92_1_ED2023_01,
CASF_R262_92_1_ED2024_01,
CASF_R262_92_1_ED2024_07,
CASF_R262_92_1_ED2025_01,
CASF_R262_92_1_ED2025_06,
CASF_R262_92_1_ED2026_06)
rule InduRecouvrableDelai(p: fr.minima.ressources::Personne, m: Money, a: Integer) strict {
    effective [@2021-03-25, infinity);
    label fr official "indu notifié de 77 € ou plus, dans les deux ans, sans recours suspensif : recouvrable (L. 262-46 ; R. 262-92/92-1)";
    label en unofficial "notified overpayment of 77 euros or more, within two years, no suspensive appeal: recoverable (L. 262-46; R. 262-92/92-1)";
    when indu_montant(p, m)
        and m >= SeuilNonRecouvrement
        and prescription_cours(p, a)
        and a < 2
        and notification_indu(p)
        and not_known(recours_suspensif(p));
    then indu_recouvrable(p, m);
}


@source(
CASF_L262_46,
CASF_L262_46_ED2024_07,
CASF_L262_46_ED2025_01,
CASF_L262_46_ED2025_06,
