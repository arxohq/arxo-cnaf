CASF_R262_93_ED2023_01,
CASF_R262_93_ED2024_01,
CASF_R262_93_ED2025_01,
CASF_R262_93_ED2025_06,
CASF_R262_93_ED2026_06,
CASF_R262_94,
CASF_R262_94_ED2021_03,
CASF_R262_94_ED2023_01,
CASF_R262_94_ED2024_01,
CASF_R262_94_ED2025_01,
CASF_R262_94_ED2025_06,
CASF_R262_94_ED2026_06)
rule RecouvrementRetenues(p: fr.minima.ressources::Personne, m: Money) strict {
    effective [@2021-03-25, infinity);
    label fr official "indu recouvrable sans option unique : retenues sur les montants à échoir (L. 262-46 al. 3 ; R. 262-93/94)";
    label en unofficial "recoverable overpayment without a one-shot option: withholding from future amounts (L. 262-46 al. 3; R. 262-93/94)";
    when indu_recouvrable(p, m)
        and not_known(remboursement_unique(p));
    then recouvrement_retenues_echeoir(p);
}
