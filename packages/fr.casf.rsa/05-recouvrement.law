CASF_R262_90_ED2023_01,
CASF_R262_90_ED2024_01,
CASF_R262_90_ED2025_01,
CASF_R262_90_ED2025_06,
CASF_R262_90_ED2026_06)
rule InduSuspendu(p: fr.minima.ressources::Personne, m: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "réclamation, remise ou recours en cours contre la récupération : caractère suspensif (L. 262-46 al. 2 ; L. 262-47 ; R. 262-88 à R. 262-90)";
    label en unofficial "ongoing claim, remission or appeal against the recovery: suspensive (L. 262-46 al. 2; L. 262-47; R. 262-88 to R. 262-90)";
    when indu_montant(p, m)
        and recours_suspensif(p);
    then indu_non_recupere(p);
}


@source(
CASF_L262_46,
CASF_L262_46_ED2025_01,
CASF_L262_46_ED2025_06,
CASF_L262_46_ED2026_06,
CASF_L262_46_PRE2024,
CASF_L262_46_PRE2024_ED2021_03,
CASF_L262_46_PRE2024_ED2023_01)
rule RemisePresident(p: fr.minima.ressources::Personne, m: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "remise ou réduction présidentielle (bonne foi, précarité, hors fraude) : créance éteinte à hauteur remise (L. 262-46)";
    label en unofficial "presidential remission or reduction (good faith, hardship, fraud excluded): debt cleared as remitted (L. 262-46)";
    when indu_montant(p, m)
        and remise_president(p)
        and not_known(indu_fraude(p));
    then indu_non_recupere(p);
}


@source(
CASF_L262_46,
CASF_L262_46_ED2025_01,
CASF_L262_46_ED2025_06,
CASF_L262_46_ED2026_06)
rule IndemniteFraude(p: fr.minima.ressources::Personne, m: Money) strict {
    effective [@2024-01-01, infinity);
    label fr official "fraude : indemnité de 10 % des sommes réclamées, recouvrée comme l'indu (L. 262-46 al. 1, depuis 2024-01-01)";
    label en unofficial "fraud: 10 % indemnity on the sums claimed, recovered like the overpayment (L. 262-46 al. 1, from 2024-01-01)";
    when indu_montant(p, m)
        and indu_fraude(p);
    then indemnite_fraude(p, m * 0.10);
}


@source(
CASF_L262_46,
CASF_L262_46_ED2025_01,
CASF_L262_46_ED2025_06,
CASF_L262_46_ED2026_06,
CASF_L262_46_PRE2024,
CASF_L262_46_PRE2024_ED2021_03,
CASF_L262_46_PRE2024_ED2023_01,
