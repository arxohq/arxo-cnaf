CASF_R262_92_1_ED2023_01,
CASF_R262_92_1_ED2024_01,
CASF_R262_92_1_ED2024_07,
CASF_R262_92_1_ED2025_01,
CASF_R262_92_1_ED2025_06,
CASF_R262_92_1_ED2026_06)
rule InduRecouvrableInterrompu(p: fr.minima.ressources::Personne, m: Money) strict {
    effective [@2021-03-25, infinity);
    label fr official "prescription interrompue (civil ou recommandé) : recouvrable malgré le délai (L. 262-45 al. 2 ; L. 262-46 ; R. 262-92/92-1)";
    label en unofficial "limitation interrupted (civil cause or registered letter): recoverable despite the delay (L. 262-45 al. 2; L. 262-46; R. 262-92/92-1)";
    when indu_montant(p, m)
        and m >= SeuilNonRecouvrement
        and interruption_prescription(p)
        and notification_indu(p)
        and not_known(recours_suspensif(p));
    then indu_recouvrable(p, m);
}


@source(
CASF_L262_46,
CASF_L262_46_ED2025_01,
CASF_L262_46_ED2025_06,
CASF_L262_46_ED2026_06,
CASF_L262_46_PRE2024,
CASF_L262_46_PRE2024_ED2021_03,
CASF_L262_46_PRE2024_ED2023_01,
CASF_R262_92_1,
CASF_R262_92_1_ED2023_01,
CASF_R262_92_1_ED2024_01,
CASF_R262_92_1_ED2025_01,
CASF_R262_92_1_ED2025_06,
CASF_R262_92_1_ED2026_06)
rule InduRecouvrableFraude(p: fr.minima.ressources::Personne, m: Money) strict {
    effective [@2021-03-25, infinity);
    label fr official "fraude ou fausse déclaration : pas de prescription biennale, recouvrable (L. 262-45 al. 1 ; L. 262-46 ; R. 262-92/92-1)";
    label en unofficial "fraud or false declaration: no two-year limit, recoverable (L. 262-45 al. 1; L. 262-46; R. 262-92/92-1)";
    when indu_montant(p, m)
        and m >= SeuilNonRecouvrement
        and indu_fraude(p)
        and notification_indu(p)
        and not_known(recours_suspensif(p));
    then indu_recouvrable(p, m);
}


