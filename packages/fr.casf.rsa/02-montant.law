    CASF_R262_2_ED2021_04,
    CASF_R262_2_ED2023_01,
    CASF_R262_2_ED2024_01,
    CASF_R262_2_ED2024_07,
    CASF_R262_2_ED2025_01,
    CASF_R262_2_ED2025_06,
    CASF_R262_2_ED2026_06)
rule MajoreProlongeEnfant3Ans(p: fr.minima.ressources::Personne, terme: Date, mois: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "durée majorée prolongée tant que le plus jeune enfant n'a pas trois ans";
    label en unofficial "increased period extended while the youngest child is under three";
    when isole_majore(p) and majore_terme_3ans(p, terme) and mois_droit(p, mois)
        and add_calendar_period(mois, 1 calendar_month) <= terme;
    then majore_prolonge_3ans(p);
}

// --- Lone-parent increase: amount (L.262-9, R.262-1 al.2) ---

@source(
    CASF_L262_9,
    CASF_L262_9_ED2021_03,
    CASF_L262_9_ED2021_04,
    CASF_L262_9_ED2023_01,
    CASF_L262_9_ED2024_01,
    CASF_L262_9_ED2024_07,
    CASF_L262_9_ED2025_01,
    CASF_L262_9_ED2025_06,
    CASF_L262_9_ED2026_06,
    CASF_R262_1,
    CASF_R262_1_ED2021_03,
    CASF_R262_1_ED2021_04,
    CASF_R262_1_ED2023_01,
    CASF_R262_1_ED2024_01,
    CASF_R262_1_ED2024_07,
    CASF_R262_1_ED2025_01,
    CASF_R262_1_ED2025_06,
    CASF_R262_1_ED2026_06)
rule MfMajore(p: fr.minima.ressources::Personne, base: Money, e: Integer) strict {
    effective [@2021-01-01, infinity);
    label fr official "majoré : 128,412 % de la base + 42,804 % par enfant à charge (R. 262-1 al. 2 ; L. 262-9)";
    label en unofficial "increased amount: 128.412 % of the base + 42.804 % per dependent child (R. 262-1 al. 2; L. 262-9)";
    when isole_majore(p)
        and mf_base_retenue(p, base)
        and majore_nb_enfants(p, e);
    then mf_majore(p, base * TauxMajoreIsole + base * TauxMajoreEnfant * e);
}

// The service period starts with the established month of the increased
// allowance claim. The generating event and filing delay remain distinct facts.
@source(
    CASF_L262_9,
    CASF_L262_9_ED2021_03,
