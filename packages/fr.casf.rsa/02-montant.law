rule MfComposition2(p: fr.minima.ressources::Personne, m: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "contrat minima : composition taille 2 (R. 262-1)";
    label en unofficial "minima contract: size-2 composition (R. 262-1)";
    when mf_menage(p, m)
        and foyer_nb_personnes(p, 2);
    then mf_composition(p, 2, m);
}

