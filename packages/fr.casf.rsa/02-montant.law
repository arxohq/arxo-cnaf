    CASF_L262_20,
    CASF_L262_20_ED2021_03,
    CASF_L262_20_ED2021_04,
    CASF_L262_20_ED2023_01,
    CASF_L262_20_ED2024_01,
    CASF_L262_20_ED2024_07,
    CASF_L262_20_ED2025_01,
    CASF_L262_20_ED2025_06,
    CASF_L262_20_ED2026_06,
    CASF_R262_39,
    CASF_R262_39_ED2021_03,
    CASF_R262_39_ED2021_04,
    CASF_R262_39_ED2023_01,
    CASF_R262_39_ED2024_01,
    CASF_R262_39_ED2024_07,
    CASF_R262_39_ED2025_01,
    CASF_R262_39_ED2025_06,
    CASF_R262_39_ED2026_06)
rule AllocVersee(p: fr.minima.ressources::Personne, mois: Date, du: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "allocation servie : montant dû, à partir de 6 € (L. 262-2 al. 2 via R. 262-7 I ; L. 262-20 ; R. 262-39 ; D-44)";
    label en unofficial "allowance paid: amount due, from 6 euros up (L. 262-2 al. 2 via R. 262-7 I; R. 262-39; D-44)";
    when droit_rsa(p, mois)
        and fr.minima.ressources::montant_du_trimestre(p, du)
        and du >= SeuilNonVersement;
    then allocation_mensuelle(p, mois, du);
}

