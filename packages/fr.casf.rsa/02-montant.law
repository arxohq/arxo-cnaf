    CASF_R262_39_ED2025_01,
    CASF_R262_39_ED2025_06,
    CASF_R262_39_ED2026_06)
rule AllocNonVersee(p: fr.minima.ressources::Personne, mois: Date, du: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "montant dû sous 6 € : non versé (L. 262-2 al. 2 via R. 262-7 I ; L. 262-20 ; R. 262-39 ; D-44)";
    label en unofficial "amount due below 6 euros: not paid (L. 262-2 al. 2 via R. 262-7 I; R. 262-39; D-44)";
    when droit_rsa(p, mois)
        and fr.minima.ressources::montant_du_trimestre(p, du)
        and du < SeuilNonVersement;
    then allocation_non_versee(p, mois);
}

// --- Minima contract: the household MF reaches fr.minima.ressources ---
//
// fr.minima.ressources::mf_composition (size classes 1, 2, 3+ for the housing
// flat-rate, R.262-9) and ::mf_mois (the MF of each month of the reference
// quarter, R.262-7 I) were case inputs "equal to the fr.casf.rsa computation"
// (B-RSA-MF-INPUT-CONTRACT). The heads below are the neighbour's own
// relations (a foreign head, E-0126): this package, which owns R.262-1,
// writes the computed amounts into them. R.262-7 I (pinned by the neighbour)
// does not say which monthly flat-rate enters each of the three intermediate
// amounts; the model carries the MF of the month of right (increase
// included, L.262-2/L.262-9) to all three months of the reference quarter.

@source(
    CASF_R262_1,
    CASF_R262_1_ED2021_03,
    CASF_R262_1_ED2021_04,
    CASF_R262_1_ED2023_01,
    CASF_R262_1_ED2024_01,
    CASF_R262_1_ED2024_07,
    CASF_R262_1_ED2025_01,
    CASF_R262_1_ED2025_06,
    CASF_R262_1_ED2026_06)
rule MfCompositionMinima(p: fr.minima.ressources::Personne, k: Integer, m: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "montant forfaitaire par taille de foyer transmis à fr.minima.ressources (R. 262-1)";
    label en unofficial "flat-rate amount by household size passed to fr.minima.ressources (R. 262-1)";
    when mf_composition(p, k, m);
    then fr.minima.ressources::mf_composition(p, k, m);
}

@source(
    CASF_L262_2,
    CASF_L262_2_ED2021_03,
    CASF_L262_2_ED2021_04,
    CASF_L262_2_ED2023_01,
    CASF_L262_2_ED2024_01,
    CASF_L262_2_ED2024_07,
    CASF_L262_2_ED2025_01,
    CASF_L262_2_ED2025_06,
    CASF_L262_2_ED2026_06)
rule MfMoisReference1(p: fr.minima.ressources::Personne, md: Date, m1: Date, m2: Date, m3: Date, mm: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "montant forfaitaire du foyer au mois n° 1 du trimestre de référence : celui du mois du droit, majoration comprise (L. 262-2 ; L. 262-9)";
    label en unofficial "household flat-rate for reference-quarter month no. 1: that of the month of right, increase included (L. 262-2; L. 262-9)";
    when mois_droit(p, md)
        and fr.minima.ressources::trimestre_reference(p, m1, m2, m3)
        and mf_applicable_mois(p, md, mm);
    then fr.minima.ressources::mf_mois(p, m1, mm);
}

