    CASF_L262_9_ED2024_07,
    CASF_L262_9_ED2025_01,
    CASF_L262_9_ED2025_06,
    CASF_L262_9_ED2026_06,
    CASF_R262_2,
    CASF_R262_2_ED2021_03,
    CASF_R262_2_ED2021_04,
    CASF_R262_2_ED2023_01,
    CASF_R262_2_ED2024_01,
    CASF_R262_2_ED2024_07,
    CASF_R262_2_ED2025_01,
    CASF_R262_2_ED2025_06,
    CASF_R262_2_ED2026_06)
rule MajoreTermeEnfant3Ans(p: fr.minima.ressources::Personne, x: fr.minima.ressources::Personne, birth: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "terme de la prolongation : mois où le plus jeune enfant atteint trois ans";
    label en unofficial "extension end: month in which the youngest child turns three";
    when dernier_enfant(p, x) and foyer_naissance(p, x, birth) and isole_majore(p);
    then majore_terme_3ans(p, add_calendar_period(birth, 3 calendar_year));
}
@source(
    CASF_L262_9,
    CASF_L262_9_ED2021_03,
    CASF_L262_9_ED2021_04,
