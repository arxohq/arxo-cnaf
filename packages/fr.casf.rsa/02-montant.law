    CASF_R262_2_ED2024_01,
    CASF_R262_2_ED2024_07,
    CASF_R262_2_ED2025_01,
    CASF_R262_2_ED2025_06,
    CASF_R262_2_ED2026_06)
rule MajoreOuvertMois3(p: fr.minima.ressources::Personne, d0: Date, d: Integer, mois: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "majoration servie au 3e mois après le début dans la limite de la durée (R. 262-2 al. 1)";
    label en unofficial "increase in service in month 3 after the start within the duration (R. 262-2 al. 1)";
    when isole_majore(p)
        and majore_debut_mois(p, d0)
        and majore_duree_mois(p, d)
        and d > 3
        and mois_droit(p, mois)
        and mois == add_calendar_period(d0, 3 calendar_month);
    then majore_ouvert_mois(p, mois);
}

