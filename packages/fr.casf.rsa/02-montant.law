    CASF_R262_2_ED2026_06)
rule MajoreOuvertEnfantMoins3(p: fr.minima.ressources::Personne, terme: Date, mois: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "majoration du parent isolé pour le mois où le plus jeune enfant est encore âgé de moins de trois ans";
    label en unofficial "isolated parent's increase in a month when the youngest child is still under three";
    when isole_majore(p) and majore_prolonge_3ans(p) and majore_terme_3ans(p, terme)
        and mois_droit(p, mois) and add_calendar_period(mois, 1 calendar_month) <= terme;
    then majore_ouvert_mois(p, mois);
}

// --- Applicable MF for the month (L.262-2) ---

@source(
    CASF_L262_2,
    CASF_L262_2_ED2021_03,
    CASF_L262_2_ED2021_04,
    CASF_L262_2_ED2023_01,
    CASF_L262_2_ED2024_01,
    CASF_L262_2_ED2024_07,
    CASF_L262_2_ED2025_01,
    CASF_L262_2_ED2025_06,
    CASF_L262_2_ED2026_06)
rule MfApplicableMajore(p: fr.minima.ressources::Personne, mois: Date, mm: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "MF du mois : majoré servi (L. 262-2 ; L. 262-9)";
    label en unofficial "month's flat-rate: increase in service (L. 262-2; L. 262-9)";
    when mois_droit(p, mois)
        and majore_ouvert_mois(p, mois)
        and mf_majore(p, mm);
    then mf_applicable_mois(p, mois, mm);
}

@source(
    CASF_L262_2,
    CASF_L262_2_ED2021_03,
    CASF_L262_2_ED2021_04,
    CASF_L262_2_ED2023_01,
    CASF_L262_2_ED2024_01,
    CASF_L262_2_ED2024_07,
    CASF_L262_2_ED2025_01,
    CASF_L262_2_ED2025_06,
    CASF_L262_2_ED2026_06)
rule MfApplicableNormal(p: fr.minima.ressources::Personne, mois: Date, mm: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "MF du mois : composition hors majoration (L. 262-2)";
    label en unofficial "month's flat-rate: composition without the increase (L. 262-2)";
    when mois_droit(p, mois)
        and mf_menage(p, mm)
        and not_known(majore_ouvert_mois(p, mois));
    then mf_applicable_mois(p, mois, mm);
}

// --- Entitlement (L.262-2, L.262-4, L.262-5) ---

@source(
    CASF_L262_2,
    CASF_L262_2_ED2021_03,
    CASF_L262_2_ED2021_04,
    CASF_L262_2_ED2023_01,
    CASF_L262_2_ED2024_01,
    CASF_L262_2_ED2024_07,
    CASF_L262_2_ED2025_01,
    CASF_L262_2_ED2025_06,
    CASF_L262_2_ED2026_06,
    CASF_L262_4,
    CASF_L262_4_ED2021_03,
    CASF_L262_4_ED2021_04,
    CASF_L262_4_ED2023_01,
    CASF_L262_4_ED2024_01,
    CASF_L262_4_ED2024_07,
    CASF_L262_4_ED2025_01,
    CASF_L262_4_ED2025_06,
    CASF_L262_4_ED2026_06,
    CASF_L262_5,
    CASF_L262_5_ED2021_03,
    CASF_L262_5_ED2021_04,
    CASF_L262_5_ED2023_01,
    CASF_L262_5_ED2024_01,
    CASF_L262_5_ED2024_07,
    CASF_L262_5_ED2025_01,
    CASF_L262_5_ED2025_06,
    CASF_L262_5_ED2026_06)
rule DroitRsa(p: fr.minima.ressources::Personne, mois: Date, du: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "droit ouvert : résidence stable, âge/charge, séjour-travail, conjoint/enfants comptés, pas d'études ni congé, montant dû positif (L. 262-2 via R. 262-7 I ; L. 262-4 ; L. 262-5 ; D-44)";
    label en unofficial "entitlement open: stable residence, age/dependants, residence-work status, spouse/children counted, no studies or leave, positive amount due (L. 262-2 via R. 262-7 I; L. 262-4; L. 262-5; D-44)";
    when mois_droit(p, mois)
        and residence_stable(p)
        and age_charge_condition(p)
        and sejour_travail_condition(p)
        and conjoint_enfants_comptes(p)
        and not_known(etudiant_conge(p))
        and fr.minima.ressources::montant_du_trimestre(p, du)
        and du > 0.00 EUR;
    then droit_rsa(p, mois);
}

@source(
    CASF_L262_2,
    CASF_L262_2_ED2021_03,
    CASF_L262_2_ED2021_04,
    CASF_L262_2_ED2023_01,
    CASF_L262_2_ED2024_01,
    CASF_L262_2_ED2024_07,
    CASF_L262_2_ED2025_01,
    CASF_L262_2_ED2025_06,
    CASF_L262_2_ED2026_06,
    CASF_L262_4,
    CASF_L262_4_ED2021_03,
    CASF_L262_4_ED2021_04,
    CASF_L262_4_ED2023_01,
    CASF_L262_4_ED2024_01,
    CASF_L262_4_ED2024_07,
    CASF_L262_4_ED2025_01,
    CASF_L262_4_ED2025_06,
    CASF_L262_4_ED2026_06,
    CASF_L262_5,
    CASF_L262_5_ED2021_03,
    CASF_L262_5_ED2021_04,
    CASF_L262_5_ED2023_01,
    CASF_L262_5_ED2024_01,
    CASF_L262_5_ED2024_07,
    CASF_L262_5_ED2025_01,
    CASF_L262_5_ED2025_06,
    CASF_L262_5_ED2026_06)
rule DroitRsaMajoreEtudiant(p: fr.minima.ressources::Personne, mois: Date, du: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "étudiant ou en congé avec majoration : le 3°-4° de L. 262-4 ne s'applique pas, montant dû positif (L. 262-4 ; L. 262-9 ; L. 262-2 via R. 262-7 I ; D-44)";
    label en unofficial "student or on leave with the increase: L. 262-4 3°-4° does not apply, positive amount due (L. 262-4; L. 262-9; L. 262-2 via R. 262-7 I; D-44)";
    when mois_droit(p, mois)
        and residence_stable(p)
        and age_charge_condition(p)
        and sejour_travail_condition(p)
        and conjoint_enfants_comptes(p)
        and etudiant_conge(p)
        and isole_majore(p)
        and fr.minima.ressources::montant_du_trimestre(p, du)
        and du > 0.00 EUR;
    then droit_rsa(p, mois);
}

// --- Monthly allowance (L.262-2 al.2) and the 6 euro floor (R.262-39) ---

@source(
    CASF_L262_2,
    CASF_L262_2_ED2021_03,
    CASF_L262_2_ED2021_04,
    CASF_L262_2_ED2023_01,
