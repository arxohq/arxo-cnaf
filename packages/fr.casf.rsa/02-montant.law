    CASF_R262_2_ED2025_01,
    CASF_R262_2_ED2025_06,
    CASF_R262_2_ED2026_06)
rule MajoreOuvertProlonge(p: fr.minima.ressources::Personne, d0: Date, terme: Date, mois: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "majoration servie jusqu'aux trois ans du plus jeune enfant (R. 262-2 al. 2)";
    label en unofficial "increase in service until the youngest child's third birthday (R. 262-2 al. 2)";
    when isole_majore(p)
        and majore_prolonge_3ans(p)
        and majore_debut_mois(p, d0)
        and majore_terme_3ans(p, terme)
        and mois_droit(p, mois)
        and d0 <= mois
        and mois <= terme;
    then majore_ouvert_mois(p, mois);
}

