    CASF_L262_9_ED2024_07,
    CASF_L262_9_ED2025_01,
    CASF_L262_9_ED2025_06,
    CASF_L262_9_ED2026_06,
    CASF_R262_2,
    CASF_R262_2_ED2021_03,
    CASF_R262_2_ED2021_04,
    CASF_R262_2_ED2023_01,
    CASF_R262_2_ED2024_01,
    CASF_R262_2_ED2024_07,
    CASF_R262_2_ED2025_01,
    CASF_R262_2_ED2025_06,
    CASF_R262_2_ED2026_06)
rule MajoreDebutDemande(p: fr.minima.ressources::Personne, mois: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "début de service de la majoration au mois de sa demande établie (L. 262-9, R. 262-2)";
    label en unofficial "increased amount starts in the established claim month (L. 262-9, R. 262-2)";
    when isole_majore(p)
        and majore_demande_mois(p, mois);
    then majore_debut_mois(p, mois);
}

// --- Increase duration (R.262-2): twelve months minus the delay ---
//
// Integer arithmetic is not available in rule heads (12 - r leaves
// the Integer domain and poisons the predicate), so the twelve
// durations are spelled as literal rules: retard r gives 12 - r months.
// A retard of twelve months or more leaves no duration at all.

@source(
    CASF_R262_2,
    CASF_R262_2_ED2021_03,
    CASF_R262_2_ED2021_04,
    CASF_R262_2_ED2023_01,
    CASF_R262_2_ED2024_01,
    CASF_R262_2_ED2024_07,
    CASF_R262_2_ED2025_01,
    CASF_R262_2_ED2025_06,
    CASF_R262_2_ED2026_06)
rule MajoreDureeR0(p: fr.minima.ressources::Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "durée majorée de 12 mois pour un retard de 0 mois (R. 262-2 al. 1)";
    label en unofficial "increased-amount duration of 12 months for a 0-month delay (R. 262-2 al. 1)";
    when isole_majore(p)
        and majore_retard_mois(p, 0)
        and not_known(majore_prolonge_3ans(p));
    then majore_duree_mois(p, 12);
}

