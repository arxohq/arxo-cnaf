    CASF_L262_3_ED2025_06,
    CASF_L262_3_ED2026_06)
rule MfComposition1(p: fr.minima.ressources::Personne, m: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "contrat minima : composition taille 1 (R. 262-1)";
    label en unofficial "minima contract: size-1 composition (R. 262-1)";
    when mf_menage(p, m)
        and foyer_nb_personnes(p, 1);
    then mf_composition(p, 1, m);
}

