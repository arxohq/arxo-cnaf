deadline policy RSA_MOIS {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
};

// --- Module-local intermediates: the single-person base ---

relation mf_base_saisie(p: fr.minima.ressources::Personne) kind institutional {
    label fr official "une base mensuelle personne seule est fournie pour l'espèce (mf_base)";
    label en unofficial "a single-person monthly base is supplied for the case (mf_base)";
}

relation mf_base_retenue(p: fr.minima.ressources::Personne, montant: Money) kind institutional {
    key(p);
    label fr official "base mensuelle personne seule L. 262-2 retenue pour le calcul : montant du décret de revalorisation épinglé, ou base fournie pour l'espèce hors de la série épinglée";
    label en unofficial "single-person L. 262-2 monthly base used in the computation: pinned revaluation decree amount, or the case-supplied base outside the pinned series";
}

// --- Base amount (L.262-2): pinned revaluation decrees, case base as override ---
//
// MontantForfaitaireDecret (bareme/, generated from the pinned decrees by
// tools/build_bareme.py) is read at the legal time of the case. A bare
// parameter name in a head argument stays an unresolved const_ref value;
// the product with 1.0 is the read (identity scaling, no adjustment).

@source(
    DEC2020_490_ART1,
    DEC2021_530_ART1,
    DEC2022_699_ART1,
    DEC2023_340_ART1,
    DEC2024_396_ART1,
    DEC2025_293_ART1)
rule MfBaseDecret(p: fr.minima.ressources::Personne, mois: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "base L. 262-2 d'une personne seule construite du décret de revalorisation en vigueur (article 1er des décrets 2020-490, 2021-530, 2022-699, 2023-340, 2024-396 et 2025-293)";
    label en unofficial "single-person L. 262-2 base built from the revaluation decree in force (article 1 of decrees 2020-490, 2021-530, 2022-699, 2023-340, 2024-396 and 2025-293)";
    when mois_droit(p, mois)
        and not_known(mf_base_saisie(p));
    then mf_base_retenue(p, MontantForfaitaireDecret * 1.0);
}

// --- Window 2022-07..2023-03: art. 9 of law 2022-1158 (reading, rounding to the centime) ---
//
// Art. 9 I: the amounts of the allocations that undergo an annual revaluation
// under L. 161-25 CSS are revalued on 1 July 2022 by a coefficient equal to
// 1.04; L. 262-3 al. 1 CASF says of the montant forfaitaire that it is
// revalued each 1 April by that L. 161-25 coefficient, so art. 9 covers it
// (the limb of the same sentence on the elements entering the calculation too).
// The base is therefore the amount of the last decree (2022-699, 575.52 from
// April 2022) times 1.04. Neither art. 9 nor L. 161-25 nor L. 262-3 states a
// rounding of the product (575.52 x 1.04 = 598.5408 exactly): the centime
// rounding HALF_UP is the practice of the funds, i.e. a READING, not the text.
// Both factors are bareme parameters valid exactly in the window
// (MontantForfaitaireBaseLoi2022 anchored to the decree fragment,
// CoefficientLoi2022 anchored to the art. 9 fragment); the product is built
// here, never typed in. The 1 April 2023 decree 2023-340 sets 607.75 outright,
// so the window ends there. The disputed interpretation stays outside any
// group: unselected it executes nothing and changes no answer.

@source(
    LOI_2022_1158_ART9,
    DEC2022_699_ART1,
    CASF_L262_3,
    CASF_L262_3_ED2021_04,
    CASF_L262_3_ED2023_01)
rule MfBaseLoi2022(p: fr.minima.ressources::Personne, mois: Date) strict {
    effective [@2022-07-01, @2023-04-01);
    label fr official "base L. 262-2 d'une personne seule du 1er juillet 2022 : montant du décret 2022-699 multiplié par le coefficient 1,04 de l'article 9 de la loi 2022-1158, arrondi au centime (lecture)";
    label en unofficial "single-person L. 262-2 base from 1 July 2022: decree 2022-699 amount times the 1.04 coefficient of article 9 of Act 2022-1158, rounded to the centime (reading)";
    when mois_droit(p, mois)
        and not_known(mf_base_saisie(p));
    then mf_base_retenue(p, round(MontantForfaitaireBaseLoi2022 * CoefficientLoi2022, 2, "HALF_UP"));
}

@source(LOI_2022_1158_ART9, CASF_L262_3)
pub interpretation MfJuillet2022ArrondiCentime of LOI_2022_1158_ART9 {
    status disputed;
    label fr official "lecture : le produit du montant forfaitaire du décret 2022-699 par le coefficient 1,04 de l'article 9 de la loi 2022-1158 est arrondi au centime, demi vers le haut — pratique des caisses ; ni l'article 9 ni la L. 161-25 ni la L. 262-3 ne fixent d'arrondi";
    label en unofficial "reading: the product of the decree 2022-699 flat-rate amount and the 1.04 coefficient of article 9 of Act 2022-1158 is rounded to the centime, half up - fund practice; neither article 9 nor L. 161-25 nor L. 262-3 states a rounding";
    include MfBaseLoi2022;
}

@source(
    CASF_L262_2,
    CASF_L262_2_ED2021_03,
    CASF_L262_2_ED2021_04,
    CASF_L262_2_ED2023_01,
    CASF_L262_2_ED2024_01,
    CASF_L262_2_ED2024_07,
    CASF_L262_2_ED2025_01,
    CASF_L262_2_ED2025_06,
    CASF_L262_2_ED2026_06)
rule MfBaseSaisieMarque(p: fr.minima.ressources::Personne, base: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "une base fournie pour l'espèce écarte la base du décret (hors série épinglée ou base retenue par la caisse)";
    label en unofficial "a case-supplied base displaces the decree base (outside the pinned series or fund-retained base)";
    when mf_base(p, base);
    then mf_base_saisie(p);
}

@source(
    CASF_L262_2,
    CASF_L262_2_ED2021_03,
    CASF_L262_2_ED2021_04,
    CASF_L262_2_ED2023_01,
    CASF_L262_2_ED2024_01,
    CASF_L262_2_ED2024_07,
    CASF_L262_2_ED2025_01,
    CASF_L262_2_ED2025_06,
    CASF_L262_2_ED2026_06)
rule MfBaseSaisie(p: fr.minima.ressources::Personne, base: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "base mensuelle personne seule fournie pour l'espèce, retenue telle quelle (B-RSA-MF-EURO)";
    label en unofficial "single-person monthly base supplied for the case, used as is (B-RSA-MF-EURO)";
    when mf_base(p, base);
    then mf_base_retenue(p, base);
}

// --- Composition (R.262-1): household flat-rate from the base ---

@source(
    CASF_R262_1,
    CASF_R262_1_ED2021_03,
    CASF_R262_1_ED2021_04,
    CASF_R262_1_ED2023_01,
    CASF_R262_1_ED2024_01,
    CASF_R262_1_ED2024_07,
    CASF_R262_1_ED2025_01,
    CASF_R262_1_ED2025_06,
    CASF_R262_1_ED2026_06,
    CASF_L262_3,
    CASF_L262_3_ED2021_03,
    CASF_L262_3_ED2021_04,
    CASF_L262_3_ED2023_01,
    CASF_L262_3_ED2024_01,
    CASF_L262_3_ED2024_07,
    CASF_L262_3_ED2025_01,
    CASF_L262_3_ED2025_06,
    CASF_L262_3_ED2026_06)
rule MfTaille1(p: fr.minima.ressources::Personne, base: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "foyer d'une personne : montant forfaitaire de base (R. 262-1)";
    label en unofficial "one-person household: base flat-rate amount (R. 262-1)";
    when mf_base_retenue(p, base)
        and foyer_nb_personnes(p, 1);
    then mf_menage(p, base);
}

@source(
    CASF_R262_1,
    CASF_R262_1_ED2021_03,
    CASF_R262_1_ED2021_04,
    CASF_R262_1_ED2023_01,
    CASF_R262_1_ED2024_01,
    CASF_R262_1_ED2024_07,
    CASF_R262_1_ED2025_01,
    CASF_R262_1_ED2025_06,
    CASF_R262_1_ED2026_06,
    CASF_L262_3,
    CASF_L262_3_ED2021_03,
    CASF_L262_3_ED2021_04,
    CASF_L262_3_ED2023_01,
    CASF_L262_3_ED2024_01,
    CASF_L262_3_ED2024_07,
    CASF_L262_3_ED2025_01,
    CASF_L262_3_ED2025_06,
    CASF_L262_3_ED2026_06)
rule MfTaille2(p: fr.minima.ressources::Personne, base: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "deux personnes : base majorée de 50 % (R. 262-1)";
    label en unofficial "two persons: base increased by 50 % (R. 262-1)";
    when mf_base_retenue(p, base)
        and foyer_nb_personnes(p, 2);
    then mf_menage(p, base + base * TauxCompositionDeux);
}

@source(
    CASF_R262_1,
    CASF_R262_1_ED2021_03,
