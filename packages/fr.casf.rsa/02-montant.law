rule MfTaille4Couple(p: fr.minima.ressources::Personne, base: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "quatre personnes, deux parents : +50 %, +30 %, +30 % (R. 262-1)";
    label en unofficial "four persons, two parents: +50 %, +30 %, +30 % (R. 262-1)";
    when mf_base_retenue(p, base)
        and foyer_nb_personnes(p, 4)
        and foyer_nb_parents(p, 2);
    then mf_menage(p, base + base * TauxCompositionDeux + base * TauxCompositionSupp + base * TauxCompositionSupp);
}

@source(
    CASF_R262_1,
    CASF_R262_1_ED2021_03,
    CASF_R262_1_ED2021_04,
    CASF_R262_1_ED2023_01,
    CASF_R262_1_ED2024_01,
    CASF_R262_1_ED2024_07,
    CASF_R262_1_ED2025_01,
