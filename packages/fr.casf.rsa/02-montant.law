rule SupplementAutreCharge(p: fr.minima.ressources::Personne, x: fr.minima.ressources::Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "autre personne à charge ouvrant le même supplément de majoration";
    label en unofficial "other dependent person entitled to the same increase supplement";
    when foyer_autre_charge(p, x);
    then supplement_charge(p, x);
}
@source(
    CASF_R262_1,
    CASF_R262_1_ED2021_03,
    CASF_R262_1_ED2021_04,
    CASF_R262_1_ED2023_01,
