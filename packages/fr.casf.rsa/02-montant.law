    CASF_L262_3_ED2026_06)
rule MfTaille4Isole(p: fr.minima.ressources::Personne, base: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "quatre personnes, parent isolé : la 4e personne est un enfant, +40 % (R. 262-1)";
    label en unofficial "four persons, lone parent: the 4th person is a child, +40 % (R. 262-1)";
    when mf_base_retenue(p, base)
        and foyer_nb_personnes(p, 4)
        and foyer_nb_parents(p, 1);
    then mf_menage(p, base + base * TauxCompositionDeux + base * TauxCompositionSupp + base * TauxCompositionEnfant3Plus);
}

// R. 262-4 fixes household composition at the last day of each month
// (pinned fr.minima.ressources/sources/casf/R262-4-PRE2025.txt:5 and
// R262-4.txt:2). R. 262-1 classifies each dependent from the third child or under-25
// dependent onward. An established household rank remains a fact about a
// person; the percentage class and its count are conclusions of these rules.
relation membre_compte(p: fr.minima.ressources::Personne, personne: fr.minima.ressources::Personne) kind institutional {
    label fr official "personne comptée dans le foyer pour le barème R. 262-1";
    label en unofficial "person counted in the household under R. 262-1";
}
relation rang_valide(p: fr.minima.ressources::Personne, rang: Integer) kind institutional {
    label fr official "rang entier de un à la taille du foyer établi pour R. 262-1";
    label en unofficial "established rank from one to the household size under R. 262-1";
}
relation rang_avant(p: fr.minima.ressources::Personne, avant: fr.minima.ressources::Personne, apres: fr.minima.ressources::Personne) kind institutional {
    label fr official "personne de rang antérieur dans le même foyer (R. 262-1)";
    label en unofficial "person with an earlier rank in the same household (R. 262-1)";
}
relation personne_40(p: fr.minima.ressources::Personne, personne: fr.minima.ressources::Personne) kind institutional {
    label fr official "enfant ou personne de moins de vingt-cinq ans à charge (R. 262-1)";
    label en unofficial "dependent child or dependent person under age 25 (R. 262-1)";
}
relation rang_5_plus_40(p: fr.minima.ressources::Personne, personne: fr.minima.ressources::Personne) kind institutional {
    label fr official "personne de rang cinq ou suivant ouvrant droit à 40 % (R. 262-1)";
    label en unofficial "rank-five-or-later person entitled to 40 % (R. 262-1)";
}
relation rang_5_plus_30(p: fr.minima.ressources::Personne, personne: fr.minima.ressources::Personne) kind institutional {
    label fr official "personne de rang cinq ou suivant ouvrant droit à 30 % (R. 262-1)";
    label en unofficial "rank-five-or-later person entitled to 30 % (R. 262-1)";
}

