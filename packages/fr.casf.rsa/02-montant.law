rule MfTaille3(p: fr.minima.ressources::Personne, base: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "trois personnes : +50 % et +30 % (R. 262-1)";
    label en unofficial "three persons: +50 % and +30 % (R. 262-1)";
    when mf_base_retenue(p, base)
        and foyer_nb_personnes(p, 3);
    then mf_menage(p, base + base * TauxCompositionDeux + base * TauxCompositionSupp);
}

@source(
    CASF_R262_1,
    CASF_R262_1_ED2021_03,
