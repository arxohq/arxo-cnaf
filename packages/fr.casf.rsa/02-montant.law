rule MfComposition3(p: fr.minima.ressources::Personne, m: Money, n: Integer) strict {
    effective [@2021-01-01, infinity);
    label fr official "contrat minima : composition taille 3 ou plus (R. 262-1)";
    label en unofficial "minima contract: size-3-or-more composition (R. 262-1)";
    when mf_menage(p, m)
        and foyer_nb_personnes(p, n)
        and n >= 3;
    then mf_composition(p, 3, m);
}

// L. 262-9 and R. 262-2: an isolated parent caring for a child under
// three has the extended majoration until that child's third birthday.
relation enfant_ne_apres(p: fr.minima.ressources::Personne, plus_jeune: fr.minima.ressources::Personne, autre: fr.minima.ressources::Personne) kind institutional {
    label fr official "enfant à charge né après un autre enfant du foyer";
    label en unofficial "dependent child born later than another child in the household";
}
relation enfant_naissance_etablie(p: fr.minima.ressources::Personne, enfant: fr.minima.ressources::Personne) kind institutional {
    label fr official "date de naissance établie pour cet enfant à charge";
    label en unofficial "birth date established for this dependent child";
}
relation supplement_charge(p: fr.minima.ressources::Personne, personne: fr.minima.ressources::Personne) kind institutional {
    label fr official "enfant ou autre personne à charge ouvrant supplément majoré (R. 262-1 al. 2)";
    label en unofficial "child or other dependent person entitled to the increased-amount supplement (R. 262-1 para. 2)";
}
relation dernier_enfant(p: fr.minima.ressources::Personne, enfant: fr.minima.ressources::Personne) kind institutional {
    label fr official "plus jeune enfant à charge déterminant le terme des trois ans";
    label en unofficial "youngest dependent child determining the third-birthday end";
}
@source(
    CASF_R262_2,
    CASF_R262_2_ED2021_03,
    CASF_R262_2_ED2021_04,
    CASF_R262_2_ED2023_01,
    CASF_R262_2_ED2024_01,
    CASF_R262_2_ED2024_07,
    CASF_R262_2_ED2025_01,
    CASF_R262_2_ED2025_06,
    CASF_R262_2_ED2026_06)
rule EnfantNeApres(p: fr.minima.ressources::Personne, x: fr.minima.ressources::Personne, y: fr.minima.ressources::Personne, bx: Date, by: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "ordre de naissance des enfants à charge du foyer";
    label en unofficial "birth order of dependent children in the household";
    when foyer_enfant_charge(p, x) and foyer_enfant_charge(p, y)
        and foyer_naissance(p, x, bx) and foyer_naissance(p, y, by) and bx > by;
    then enfant_ne_apres(p, x, y);
}
@source(
    CASF_R262_2,
    CASF_R262_2_ED2021_03,
    CASF_R262_2_ED2021_04,
    CASF_R262_2_ED2023_01,
    CASF_R262_2_ED2024_01,
    CASF_R262_2_ED2024_07,
    CASF_R262_2_ED2025_01,
    CASF_R262_2_ED2025_06,
    CASF_R262_2_ED2026_06)
rule EnfantNaissanceEtablie(p: fr.minima.ressources::Personne, x: fr.minima.ressources::Personne, birth: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "naissance d'un enfant à charge connue pour la prolongation";
    label en unofficial "dependent child's birth known for the extension";
    when foyer_enfant_charge(p, x) and foyer_naissance(p, x, birth);
    then enfant_naissance_etablie(p, x);
}
@source(
    CASF_R262_2,
    CASF_R262_2_ED2021_03,
    CASF_R262_2_ED2021_04,
    CASF_R262_2_ED2023_01,
    CASF_R262_2_ED2024_01,
    CASF_R262_2_ED2024_07,
    CASF_R262_2_ED2025_01,
    CASF_R262_2_ED2025_06,
    CASF_R262_2_ED2026_06)
rule DernierEnfant(p: fr.minima.ressources::Personne, x: fr.minima.ressources::Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "plus jeune enfant à charge du foyer";
    label en unofficial "youngest dependent child in the household";
    when foyer_enfant_charge(p, x)
        and enfant_naissance_etablie(p, x)
        and count(collect y: fr.minima.ressources::Personne where foyer_enfant_charge(p, y)) == count(collect y: fr.minima.ressources::Personne where enfant_naissance_etablie(p, y))
        and count(collect y: fr.minima.ressources::Personne where enfant_ne_apres(p, y, x)) == 0;
    then dernier_enfant(p, x);
}
@source(
    CASF_L262_9,
    CASF_L262_9_ED2021_03,
    CASF_L262_9_ED2021_04,
    CASF_L262_9_ED2023_01,
    CASF_L262_9_ED2024_01,
    CASF_L262_9_ED2024_07,
    CASF_L262_9_ED2025_01,
    CASF_L262_9_ED2025_06,
    CASF_L262_9_ED2026_06,
    CASF_R262_2,
    CASF_R262_2_ED2021_03,
    CASF_R262_2_ED2021_04,
    CASF_R262_2_ED2023_01,
    CASF_R262_2_ED2024_01,
    CASF_R262_2_ED2024_07,
    CASF_R262_2_ED2025_01,
    CASF_R262_2_ED2025_06,
    CASF_R262_2_ED2026_06)
rule IsoleAvecEnfant(p: fr.minima.ressources::Personne, x: fr.minima.ressources::Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "parent isolé avec enfant à charge : condition personnelle de majoration";
    label en unofficial "isolated parent with a dependent child: personal condition for the increase";
    when isolement_constate(p) and foyer_nb_parents(p, 1) and foyer_enfant_charge(p, x);
    then isole_majore(p);
}
@source(
    CASF_R262_1,
    CASF_R262_1_ED2021_03,
    CASF_R262_1_ED2021_04,
    CASF_R262_1_ED2023_01,
    CASF_R262_1_ED2024_01,
    CASF_R262_1_ED2024_07,
    CASF_R262_1_ED2025_01,
    CASF_R262_1_ED2025_06,
    CASF_R262_1_ED2026_06)
rule SupplementEnfant(p: fr.minima.ressources::Personne, x: fr.minima.ressources::Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "enfant à charge ouvrant le supplément de majoration";
    label en unofficial "dependent child entitled to the increase supplement";
    when foyer_enfant_charge(p, x);
    then supplement_charge(p, x);
}
