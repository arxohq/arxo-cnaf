    CASF_R262_1_ED2025_01,
    CASF_R262_1_ED2025_06,
    CASF_R262_1_ED2026_06)
rule MajoreNbEnfantsPersonnes(p: fr.minima.ressources::Personne, n: Integer) strict {
    effective [@2021-01-01, infinity);
    label fr official "suppléments majorés : enfants et autres personnes à charge du foyer (R. 262-1 al. 2)";
    label en unofficial "increased-amount supplements: children and other dependent persons (R. 262-1 para. 2)";
    when isole_majore(p) and foyer_nb_personnes(p, n)
        and count(collect x: fr.minima.ressources::Personne where membre_compte(p, x)) == n;
    then majore_nb_enfants(p, count(collect x: fr.minima.ressources::Personne where supplement_charge(p, x)));
}
@source(
    CASF_L262_9,
    CASF_L262_9_ED2021_03,
    CASF_L262_9_ED2021_04,
