    CASF_R262_1_ED2025_01,
    CASF_R262_1_ED2025_06,
    CASF_R262_1_ED2026_06)
rule MembreCompte(p: fr.minima.ressources::Personne, x: fr.minima.ressources::Personne, r: Integer) strict {
    effective [@2021-01-01, infinity);
    label fr official "un rang établi identifie un membre compté du foyer";
    label en unofficial "an established rank identifies a counted household member";
    when foyer_membre_rang(p, x, r);
    then membre_compte(p, x);
}
@source(
    CASF_R262_1,
    CASF_R262_1_ED2021_03,
    CASF_R262_1_ED2021_04,
    CASF_R262_1_ED2023_01,
    CASF_R262_1_ED2024_01,
    CASF_R262_1_ED2024_07,
    CASF_R262_1_ED2025_01,
    CASF_R262_1_ED2025_06,
    CASF_R262_1_ED2026_06)
rule RangValide(p: fr.minima.ressources::Personne, x: fr.minima.ressources::Personne, r: Integer, n: Integer) strict {
    effective [@2021-01-01, infinity);
    label fr official "rang établi entre un et la taille du foyer";
    label en unofficial "established rank between one and household size";
    when foyer_membre_rang(p, x, r) and foyer_nb_personnes(p, n) and r >= 1 and r <= n;
    then rang_valide(p, r);
}
@source(
    CASF_R262_1,
    CASF_R262_1_ED2021_03,
    CASF_R262_1_ED2021_04,
    CASF_R262_1_ED2023_01,
    CASF_R262_1_ED2024_01,
    CASF_R262_1_ED2024_07,
    CASF_R262_1_ED2025_01,
    CASF_R262_1_ED2025_06,
    CASF_R262_1_ED2026_06)
rule RangAvant(p: fr.minima.ressources::Personne, x: fr.minima.ressources::Personne, y: fr.minima.ressources::Personne, rx: Integer, ry: Integer) strict {
    effective [@2021-01-01, infinity);
    label fr official "ordre établi des personnes du foyer";
    label en unofficial "established order of household persons";
    when foyer_membre_rang(p, x, rx) and foyer_membre_rang(p, y, ry) and rx < ry;
    then rang_avant(p, x, y);
}
@source(
    CASF_R262_1,
    CASF_R262_1_ED2021_03,
    CASF_R262_1_ED2021_04,
    CASF_R262_1_ED2023_01,
    CASF_R262_1_ED2024_01,
    CASF_R262_1_ED2024_07,
    CASF_R262_1_ED2025_01,
    CASF_R262_1_ED2025_06,
    CASF_R262_1_ED2026_06)
rule Personne40Enfant(p: fr.minima.ressources::Personne, x: fr.minima.ressources::Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "enfant à charge ouvrant la catégorie de 40 % à partir du troisième";
    label en unofficial "dependent child eligible for the 40 % class from the third such dependent";
    when foyer_enfant_charge(p, x);
    then personne_40(p, x);
}
@source(
    CASF_R262_1,
    CASF_R262_1_ED2021_03,
    CASF_R262_1_ED2021_04,
    CASF_R262_1_ED2023_01,
    CASF_R262_1_ED2024_01,
    CASF_R262_1_ED2024_07,
    CASF_R262_1_ED2025_01,
    CASF_R262_1_ED2025_06,
    CASF_R262_1_ED2026_06,
    fr.minima.ressources::CASF_R262_4_PRE2025,
    fr.minima.ressources::CASF_R262_4_PRE2025_ED2021_03,
    fr.minima.ressources::CASF_R262_4_PRE2025_ED2022_03,
    fr.minima.ressources::CASF_R262_4_PRE2025_ED2023_12,
    fr.minima.ressources::CASF_R262_4,
    fr.minima.ressources::CASF_R262_4_ED2025_06,
    fr.minima.ressources::CASF_R262_4_ED2026_06)
rule Personne40Jeune(p: fr.minima.ressources::Personne, x: fr.minima.ressources::Personne, birth: Date, mois: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "autre personne à charge de moins de vingt-cinq ans au dernier jour du mois";
    label en unofficial "other dependent person under 25 on the month's last day";
    when foyer_autre_charge(p, x) and foyer_naissance(p, x, birth) and mois_droit(p, mois)
        and add_calendar_period(birth, 25 calendar_year) >= add_calendar_period(mois, 1 calendar_month);
    then personne_40(p, x);
}
@source(
    CASF_R262_1,
    CASF_R262_1_ED2021_03,
    CASF_R262_1_ED2021_04,
    CASF_R262_1_ED2023_01,
    CASF_R262_1_ED2024_01,
    CASF_R262_1_ED2024_07,
    CASF_R262_1_ED2025_01,
    CASF_R262_1_ED2025_06,
    CASF_R262_1_ED2026_06)
rule Rang40(p: fr.minima.ressources::Personne, x: fr.minima.ressources::Personne, r: Integer) strict {
    effective [@2021-01-01, infinity);
    label fr official "troisième enfant ou jeune à charge, de rang cinq ou suivant : 40 %";
    label en unofficial "third dependent child or young person, rank five or later: 40 %";
    when foyer_membre_rang(p, x, r) and r >= 5 and personne_40(p, x)
        and count(collect y: fr.minima.ressources::Personne where rang_avant(p, y, x) and personne_40(p, y)) >= 2;
    then rang_5_plus_40(p, x);
}
@source(
    CASF_R262_1,
    CASF_R262_1_ED2021_03,
    CASF_R262_1_ED2021_04,
    CASF_R262_1_ED2023_01,
    CASF_R262_1_ED2024_01,
    CASF_R262_1_ED2024_07,
    CASF_R262_1_ED2025_01,
    CASF_R262_1_ED2025_06,
    CASF_R262_1_ED2026_06)
rule Rang30AvantTroisieme(p: fr.minima.ressources::Personne, x: fr.minima.ressources::Personne, r: Integer) strict {
    effective [@2021-01-01, infinity);
    label fr official "enfant ou jeune à charge avant le troisième, de rang cinq ou suivant : 30 %";
    label en unofficial "dependent child or young person before the third, rank five or later: 30 %";
    when foyer_membre_rang(p, x, r) and r >= 5 and personne_40(p, x)
        and count(collect y: fr.minima.ressources::Personne where rang_avant(p, y, x) and personne_40(p, y)) < 2;
    then rang_5_plus_30(p, x);
}
@source(
    CASF_R262_1,
    CASF_R262_1_ED2021_03,
    CASF_R262_1_ED2021_04,
    CASF_R262_1_ED2023_01,
    CASF_R262_1_ED2024_01,
    CASF_R262_1_ED2024_07,
    CASF_R262_1_ED2025_01,
    CASF_R262_1_ED2025_06,
    CASF_R262_1_ED2026_06,
    fr.minima.ressources::CASF_R262_4_PRE2025,
    fr.minima.ressources::CASF_R262_4_PRE2025_ED2021_03,
    fr.minima.ressources::CASF_R262_4_PRE2025_ED2022_03,
    fr.minima.ressources::CASF_R262_4_PRE2025_ED2023_12,
    fr.minima.ressources::CASF_R262_4,
    fr.minima.ressources::CASF_R262_4_ED2025_06,
    fr.minima.ressources::CASF_R262_4_ED2026_06)
rule Rang30Autre25(p: fr.minima.ressources::Personne, x: fr.minima.ressources::Personne, r: Integer, birth: Date, mois: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "autre personne à charge de vingt-cinq ans révolus, rang cinq ou suivant : 30 %";
    label en unofficial "other dependent person age 25 or older, rank five or later: 30 %";
    when foyer_membre_rang(p, x, r) and r >= 5 and foyer_autre_charge(p, x)
        and foyer_naissance(p, x, birth) and mois_droit(p, mois)
        and add_calendar_period(birth, 25 calendar_year) < add_calendar_period(mois, 1 calendar_month);
    then rang_5_plus_30(p, x);
}
@source(
    CASF_R262_1,
    CASF_R262_1_ED2021_03,
    CASF_R262_1_ED2021_04,
    CASF_R262_1_ED2023_01,
    CASF_R262_1_ED2024_01,
    CASF_R262_1_ED2024_07,
    CASF_R262_1_ED2025_01,
    CASF_R262_1_ED2025_06,
    CASF_R262_1_ED2026_06)
rule Rangs5Plus40(p: fr.minima.ressources::Personne, n: Integer) strict {
    effective [@2021-01-01, infinity);
    label fr official "nombre des personnes de rang cinq et suivants au taux de 40 %";
    label en unofficial "count of rank-five-or-later persons at the 40 % rate";
    when foyer_nb_personnes(p, n) and n >= 5
        and count(collect x: fr.minima.ressources::Personne where membre_compte(p, x)) == n
        and count(collect r: Integer where rang_valide(p, r)) == n
        and count(collect x: fr.minima.ressources::Personne where rang_5_plus_40(p, x)) + count(collect x: fr.minima.ressources::Personne where rang_5_plus_30(p, x)) == n - 4;
    then foyer_sup_taux40(p, count(collect x: fr.minima.ressources::Personne where rang_5_plus_40(p, x)));
}
@source(
    CASF_R262_1,
    CASF_R262_1_ED2021_03,
    CASF_R262_1_ED2021_04,
    CASF_R262_1_ED2023_01,
    CASF_R262_1_ED2024_01,
    CASF_R262_1_ED2024_07,
    CASF_R262_1_ED2025_01,
    CASF_R262_1_ED2025_06,
    CASF_R262_1_ED2026_06)
rule Rangs5Plus30(p: fr.minima.ressources::Personne, n: Integer) strict {
    effective [@2021-01-01, infinity);
    label fr official "nombre des personnes de rang cinq et suivants au taux de 30 %";
    label en unofficial "count of rank-five-or-later persons at the 30 % rate";
    when foyer_nb_personnes(p, n) and n >= 5
        and count(collect x: fr.minima.ressources::Personne where membre_compte(p, x)) == n
        and count(collect r: Integer where rang_valide(p, r)) == n
        and count(collect x: fr.minima.ressources::Personne where rang_5_plus_40(p, x)) + count(collect x: fr.minima.ressources::Personne where rang_5_plus_30(p, x)) == n - 4;
    then foyer_sup_taux30(p, count(collect x: fr.minima.ressources::Personne where rang_5_plus_30(p, x)));
}

@source(
    CASF_R262_1,
    CASF_R262_1_ED2021_03,
    CASF_R262_1_ED2021_04,
    CASF_R262_1_ED2023_01,
    CASF_R262_1_ED2024_01,
    CASF_R262_1_ED2024_07,
    CASF_R262_1_ED2025_01,
    CASF_R262_1_ED2025_06,
    CASF_R262_1_ED2026_06,
    CASF_L262_3,
    CASF_L262_3_ED2021_03,
    CASF_L262_3_ED2021_04,
    CASF_L262_3_ED2023_01,
    CASF_L262_3_ED2024_01,
    CASF_L262_3_ED2024_07,
    CASF_L262_3_ED2025_01,
    CASF_L262_3_ED2025_06,
    CASF_L262_3_ED2026_06)
rule MfTaille5PlusCouple(p: fr.minima.ressources::Personne, base: Money, n: Integer, k: Integer, m: Integer) strict {
    effective [@2021-01-01, infinity);
    label fr official "cinq personnes ou plus, deux parents : rangs 5+ à 40 % (k) ou 30 % (m) (R. 262-1)";
    label en unofficial "five or more persons, two parents: ranks 5+ at 40 % (k) or 30 % (m) (R. 262-1)";
    when mf_base_retenue(p, base)
        and foyer_nb_personnes(p, n)
        and n >= 5
        and foyer_nb_parents(p, 2)
        and foyer_sup_taux40(p, k)
        and foyer_sup_taux30(p, m);
    then mf_menage(p, base + base * TauxCompositionDeux + base * TauxCompositionSupp + base * TauxCompositionSupp + base * TauxCompositionEnfant3Plus * k + base * TauxCompositionSupp * m);
}

@source(
    CASF_R262_1,
    CASF_R262_1_ED2021_03,
    CASF_R262_1_ED2021_04,
    CASF_R262_1_ED2023_01,
    CASF_R262_1_ED2024_01,
    CASF_R262_1_ED2024_07,
    CASF_R262_1_ED2025_01,
    CASF_R262_1_ED2025_06,
    CASF_R262_1_ED2026_06,
    CASF_L262_3,
    CASF_L262_3_ED2021_03,
    CASF_L262_3_ED2021_04,
    CASF_L262_3_ED2023_01,
    CASF_L262_3_ED2024_01,
    CASF_L262_3_ED2024_07,
    CASF_L262_3_ED2025_01,
    CASF_L262_3_ED2025_06,
    CASF_L262_3_ED2026_06)
rule MfTaille5PlusIsole(p: fr.minima.ressources::Personne, base: Money, n: Integer, k: Integer, m: Integer) strict {
    effective [@2021-01-01, infinity);
    label fr official "cinq personnes ou plus, parent isolé : rangs 5+ à 40 % (k) ou 30 % (m) (R. 262-1)";
    label en unofficial "five or more persons, lone parent: ranks 5+ at 40 % (k) or 30 % (m) (R. 262-1)";
    when mf_base_retenue(p, base)
        and foyer_nb_personnes(p, n)
        and n >= 5
        and foyer_nb_parents(p, 1)
        and foyer_sup_taux40(p, k)
        and foyer_sup_taux30(p, m);
    then mf_menage(p, base + base * TauxCompositionDeux + base * TauxCompositionSupp + base * TauxCompositionEnfant3Plus + base * TauxCompositionEnfant3Plus * k + base * TauxCompositionSupp * m);
}

