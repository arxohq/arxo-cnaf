// --- Increase in service for the month (R.262-2) ---

@source(
    CASF_R262_2,
    CASF_R262_2_ED2021_03,
    CASF_R262_2_ED2021_04,
    CASF_R262_2_ED2023_01,
    CASF_R262_2_ED2024_01,
    CASF_R262_2_ED2024_07,
    CASF_R262_2_ED2025_01,
    CASF_R262_2_ED2025_06,
    CASF_R262_2_ED2026_06)
rule MajoreOuvertMois0(p: fr.minima.ressources::Personne, d0: Date, d: Integer, mois: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "majoration servie au 0e mois après le début dans la limite de la durée (R. 262-2 al. 1)";
    label en unofficial "increase in service in month 0 after the start within the duration (R. 262-2 al. 1)";
    when isole_majore(p)
        and majore_debut_mois(p, d0)
        and majore_duree_mois(p, d)
        and d > 0
        and mois_droit(p, mois)
        and mois == d0;
    then majore_ouvert_mois(p, mois);
}

