    effective [@2025-06-01, infinity);
    label fr official "persistance au terme de la suspension : suppression après audition d'équipe (L. 262-37, II 1° ; R. 262-69-2 ; L. 262-39)";
    label en unofficial "persistence at the end of the suspension: removal after team hearing (L. 262-37, II 1°; R. 262-69-2; L. 262-39)";
    when manquement_persiste(p, motif)
        and not_known(motif_legitime(p))
        and notification_10j(p)
        and audition_equipe(p)
        and avis_equipe(p)
        and tenu_obligations_262_28(p);
    then sanction_suppression(p, motif);
}


