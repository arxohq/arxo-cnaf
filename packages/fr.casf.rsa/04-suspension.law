    label fr official "non-respect des obligations du contrat, sans motif légitime : suspension après notification dix jours (L. 262-37, I 2° ; R. 262-68-1 ; R. 262-69-1)";
    label en unofficial "breach of the contract obligations, no legitimate reason: suspension after ten-day notice (L. 262-37, I 2°; R. 262-68-1; R. 262-69-1)";
    when manquement(p, NON_RESPECT_CONTRAT)
        and not_known(motif_legitime(p))
        and notification_10j(p)
        and tenu_obligations_262_28(p);
    then sanction_suspension(p, NON_RESPECT_CONTRAT);
}


