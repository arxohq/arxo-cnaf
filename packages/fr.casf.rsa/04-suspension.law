};

// --- Suspension and removal on the president's own motion ---
@source(
CASF_L262_37,
CASF_L262_37_ED2025_06,
CASF_L262_37_ED2026_06,
CASF_R262_68,
CASF_R262_68_ED2026_06,
CASF_R262_68_7,
CASF_R262_68_7_ED2026_06,
CASF_R262_69_1,
CASF_R262_69_1_ED2026_06,
CASF_L262_28,
CASF_L262_28_PRE20260627,
CASF_L262_28_PRE20260627_ED2021_03,
CASF_L262_28_PRE20260627_ED2021_04,
CASF_L262_28_PRE20260627_ED2023_01,
CASF_L262_28_PRE20260627_ED2024_01,
CASF_L262_28_PRE20260627_ED2024_07,
CASF_L262_28_PRE20260627_ED2025_01,
CASF_L262_28_PRE20260627_ED2025_06)
rule SuspensionRefusContrat(p: fr.minima.ressources::Personne) strict {
    effective [@2025-06-01, infinity);
    label fr official "refus d'élaborer ou d'actualiser le contrat, sans motif légitime : suspension après notification dix jours (L. 262-37, I 1° ; R. 262-68 ; R. 262-69-1)";
    label en unofficial "refusal to draw up or update the contract, no legitimate reason: suspension after ten-day notice (L. 262-37, I 1°; R. 262-68; R. 262-69-1)";
    when manquement(p, REFUS_CONTRAT)
        and not_known(motif_legitime(p))
        and notification_10j(p)
        and tenu_obligations_262_28(p);
    then sanction_suspension(p, REFUS_CONTRAT);
}


