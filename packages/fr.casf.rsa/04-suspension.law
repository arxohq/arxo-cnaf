// Suspension and removal (L.262-37/38/39, R.262-68(-1..-7)/69(-1..-8),
// decree 2025-478 art. 12).
//
// DEONTIC MAP: the president (or France Travail on proposal/delegation)
// MAY suspend or remove, in whole or part, for a fixed duration; the
// beneficiary MUST be heard first (10 days, team hearing for removal);
// withheld sums MUST be repaid on compliance (3-month cap); the
// non-bound (R.262-68-7) MUST NOT be sanctioned. Sanction scales run
// from the decree's 2025-06-01 entry (B-RSA-SANCTION-PRE202506 for the
// old scales and the January-May 2025 interim); the pre-2025
// accompaniment/sanction regime is B-RSA-AVANT-2025.

language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

