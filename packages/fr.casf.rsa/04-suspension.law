rule SuppressionRefusControle(p: fr.minima.ressources::Personne) strict {
    effective [@2025-06-01, infinity);
    label fr official "refus de contrôle : suppression après notification et audition d'équipe (L. 262-37, II 3° ; R. 262-68-3 ; R. 262-69-2 ; L. 262-39)";
    label en unofficial "control refusal: removal after notice and team hearing (L. 262-37, II 3°; R. 262-68-3; R. 262-69-2; L. 262-39)";
    when manquement(p, REFUS_CONTROLE)
        and not_known(motif_legitime(p))
        and notification_10j(p)
        and audition_equipe(p)
        and avis_equipe(p)
        and tenu_obligations_262_28(p);
    then sanction_suppression(p, REFUS_CONTROLE);
}


