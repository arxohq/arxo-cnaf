    CASF_D262_26,
    CASF_D262_26_ED2025_01,
    CASF_D262_26_ED2025_06,
    CASF_D262_26_ED2026_06)
rule DepotDemandeServices(p: fr.minima.ressources::Personne, d: Departement) strict {
    effective [@2021-01-01, infinity);
    label fr official "dépôt aux services du département (D. 262-26 b))";
    label en unofficial "filing at department services (D. 262-26 b))";
    when demande_rsa_deposee(p)
        and departement_competent(d, p);
    then liberty DeposerDemandeServices {
        holder p;
        action depot_demande_services(p, d);
        window [@2021-01-01, infinity);
    };
}

@source(
    CASF_D262_26_PRE202407,
    CASF_D262_26_PRE202407_ED2021_03,
    CASF_D262_26_PRE202407_ED2021_04,
    CASF_D262_26_PRE202407_ED2023_01,
    CASF_D262_26_PRE202407_ED2024_01,
    CASF_D262_26,
    CASF_D262_26_ED2025_01,
    CASF_D262_26_ED2025_06,
    CASF_D262_26_ED2026_06)
rule DepotDemandeAssociation(p: fr.minima.ressources::Personne, o: Organisme) strict {
    effective [@2021-01-01, infinity);
    label fr official "dépôt à l'association déléguée par le président (D. 262-26 c))";
    label en unofficial "filing at the association delegated by the president (D. 262-26 c))";
    when demande_rsa_deposee(p)
        and est_association_deleguee(o)
        and delegation_instruction(o)
        and organisme_competent(o, p);
    then liberty DeposerDemandeAssociation {
        holder p;
        action depot_demande_association(p, o);
        window [@2021-01-01, infinity);
    };
}

@source(
    CASF_D262_26_PRE202407,
