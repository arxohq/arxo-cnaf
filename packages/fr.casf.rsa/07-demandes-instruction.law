rule DepotDemandeOrganisme(p: fr.minima.ressources::Personne, o: Organisme) strict {
    effective [@2021-01-01, infinity);
    label fr official "dépôt à l'organisme chargé du service du RSA (D. 262-26 d))";
    label en unofficial "filing at the RSA service body (D. 262-26 d))";
    when demande_rsa_deposee(p)
        and est_organisme_service(o)
        and organisme_competent(o, p);
    then liberty DeposerDemandeOrganisme {
        holder p;
        action depot_demande_organisme(p, o);
        window [@2021-01-01, infinity);
    };
}

@source(
    CASF_D262_26_PRE202407,
    CASF_D262_26_PRE202407_ED2021_03,
    CASF_D262_26_PRE202407_ED2021_04,
    CASF_D262_26_PRE202407_ED2023_01,
    CASF_D262_26_PRE202407_ED2024_01,
    CASF_D262_26,
    CASF_D262_26_ED2025_01,
    CASF_D262_26_ED2025_06,
    CASF_D262_26_ED2026_06)
rule DepotDemandeFT(p: fr.minima.ressources::Personne, o: Organisme) strict {
    effective [@2021-01-01, infinity);
    label fr official "dépôt à France Travail chargé de l'instruction (D. 262-26 e) via D. 262-27)";
    label en unofficial "filing at the instructing France Travail (D. 262-26 e) via D. 262-27)";
    when demande_rsa_deposee(p)
        and ft_habilite_instruire(o)
        and organisme_competent(o, p);
    then liberty DeposerDemandeFT {
        holder p;
        action depot_demande_ft(p, o);
        window [@2021-01-01, infinity);
    };
}

@source(
    CASF_D262_27_PRE202407,
    CASF_D262_27_PRE202407_ED2021_03,
    CASF_D262_27_PRE202407_ED2021_04,
    CASF_D262_27_PRE202407_ED2023_01,
    CASF_D262_27_PRE202407_ED2024_01,
    CASF_D262_27,
    CASF_D262_27_ED2025_01,
    CASF_D262_27_ED2025_06,
    CASF_D262_27_ED2026_06)
rule DeciderInstructionFTRule(o: Organisme) strict {
    effective [@2021-01-01, infinity);
    label fr official "le conseil d'administration de France Travail peut décider de se charger de l'instruction (D. 262-27 al. 1)";
    label en unofficial "the France Travail board may decide to take on instruction (D. 262-27 al. 1)";
    when est_france_travail(o);
    then liberty DeciderInstructionFT {
        holder o;
        action decider_instruction_ft(o);
        window [@2021-01-01, infinity);
    };
}

@source(
    CASF_D262_27_PRE202407,
    CASF_D262_27_PRE202407_ED2021_03,
    CASF_D262_27_PRE202407_ED2021_04,
    CASF_D262_27_PRE202407_ED2023_01,
    CASF_D262_27_PRE202407_ED2024_01,
    CASF_D262_27,
    CASF_D262_27_ED2025_01,
    CASF_D262_27_ED2025_06,
    CASF_D262_27_ED2026_06)
rule FTHabiliteInstruire(o: Organisme) strict {
    effective [@2021-01-01, infinity);
    label fr official "France Travail habilité : décision du conseil d'administration et convention de modalités avec la CNAF et la CCMSA (D. 262-27)";
    label en unofficial "France Travail empowered: board decision and modalities convention with CNAF and CCMSA (D. 262-27)";
    when est_france_travail(o)
        and decision_ca_instruire(o)
        and convention_modalites_ft(o);
    then ft_habilite_instruire(o);
}

@source(
    CASF_D262_28,
    CASF_D262_28_ED2021_03,
    CASF_D262_28_ED2021_04,
    CASF_D262_28_ED2023_01,
    CASF_D262_28_ED2024_01,
    CASF_D262_28_ED2024_07,
    CASF_D262_28_ED2025_01,
    CASF_D262_28_ED2025_06,
    CASF_D262_28_ED2026_06)
rule GratuiteInstruction(o: Organisme, p: fr.minima.ressources::Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "instruction gratuite : interdiction de faire payer l'instruction (D. 262-28)";
    label en unofficial "free instruction: charging for instruction prohibited (D. 262-28)";
    when instruction_effectuee(o, p)
        and demande_deposee_aupres(o, p);
    then prohibition InstruireGratuitement {
        bearer o;
        beneficiary p;
        action exiger_frais_instruction(o, p);
        window [@2021-01-01, infinity);
    };
}

@source(
    CASF_D262_28,
    CASF_D262_28_ED2021_03,
    CASF_D262_28_ED2021_04,
    CASF_D262_28_ED2023_01,
    CASF_D262_28_ED2024_01,
    CASF_D262_28_ED2024_07,
    CASF_D262_28_ED2025_01,
    CASF_D262_28_ED2025_06,
    CASF_D262_28_ED2026_06)
rule GratuiteInstructionDept(d: Departement, p: fr.minima.ressources::Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "instruction gratuite des services du département : interdiction de faire payer (D. 262-28)";
    label en unofficial "free instruction by department services: charging prohibited (D. 262-28)";
    when instruction_effectuee_dept(d, p)
        and demande_deposee_aupres_dept(d, p);
    then prohibition InstruireGratuitementDept {
        bearer d;
        beneficiary p;
        action exiger_frais_instruction_dept(d, p);
        window [@2021-01-01, infinity);
    };
}

@source(
    CASF_D262_29,
    CASF_D262_29_ED2021_03,
    CASF_D262_29_ED2021_04,
    CASF_D262_29_ED2023_01,
    CASF_D262_29_ED2024_01,
    CASF_D262_29_ED2024_07,
    CASF_D262_29_ED2025_01,
    CASF_D262_29_ED2025_06,
    CASF_D262_29_ED2026_06)
rule EngagementQualiteOrganisme(o: Organisme, d: Departement, p: fr.minima.ressources::Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "l'organisme définit en commun avec le président l'engagement de qualité de l'instruction, vers le demandeur (D. 262-29, côté organisme)";
    label en unofficial "the body jointly defines the instruction quality commitment with the president, toward the claimant (D. 262-29, body side)";
    when organisme_competent(o, p)
        and departement_competent(d, p);
    then duty DefinirEngagementQualiteOrganisme {
        bearer o;
        beneficiary p;
        maintain engagement_qualite_defini(o, d) during [@2021-01-01, infinity);
    };
}

@source(
    CASF_D262_29,
    CASF_D262_29_ED2021_03,
    CASF_D262_29_ED2021_04,
    CASF_D262_29_ED2023_01,
    CASF_D262_29_ED2024_01,
    CASF_D262_29_ED2024_07,
    CASF_D262_29_ED2025_01,
    CASF_D262_29_ED2025_06,
    CASF_D262_29_ED2026_06)
rule EngagementQualitePresident(o: Organisme, d: Departement, p: fr.minima.ressources::Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "le président définit en commun avec l'organisme l'engagement de qualité de l'instruction, vers le demandeur (D. 262-29, côté président)";
    label en unofficial "the president jointly defines the instruction quality commitment with the body, toward the claimant (D. 262-29, president side)";
    when organisme_competent(o, p)
        and departement_competent(d, p);
    then duty DefinirEngagementQualitePresident {
        bearer d;
        beneficiary p;
        maintain engagement_qualite_defini(o, d) during [@2021-01-01, infinity);
    };
}

@source(
    CASF_D262_30,
    CASF_D262_30_ED2021_03,
    CASF_D262_30_ED2021_04,
    CASF_D262_30_ED2023_01,
    CASF_D262_30_ED2024_01,
    CASF_D262_30_ED2024_07,
    CASF_D262_30_ED2025_01,
    CASF_D262_30_ED2025_06,
    CASF_D262_30_ED2026_06)
rule FixerRessortDelegationRule(o: Organisme, d: Departement, p: fr.minima.ressources::Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "le président fixe le ressort territorial dans la délégation d'instruction (D. 262-30)";
    label en unofficial "the president fixes the territorial scope in the instruction delegation (D. 262-30)";
    when delegation_instruction(o)
        and organisme_competent(o, p)
        and departement_competent(d, p);
    then duty FixerRessortDelegation {
        bearer d;
        beneficiary o;
        maintain ressort_delegation_fixe(o, d) during [@2021-01-01, infinity);
    };
}
