};

@source(
    CASF_D262_26_PRE202407,
    CASF_D262_26_PRE202407_ED2021_03,
    CASF_D262_26_PRE202407_ED2021_04,
    CASF_D262_26_PRE202407_ED2023_01,
    CASF_D262_26_PRE202407_ED2024_01,
    CASF_D262_26,
    CASF_D262_26_ED2025_01,
    CASF_D262_26_ED2025_06,
    CASF_D262_26_ED2026_06)
rule DepotDemandeCCAS(p: fr.minima.ressources::Personne, o: Organisme) strict {
    effective [@2021-01-01, infinity);
    label fr official "dépôt au CCAS ou CIAS qui a décidé de se charger de l'instruction (D. 262-26 a))";
    label en unofficial "filing at the CCAS or CIAS that decided to take on instruction (D. 262-26 a))";
    when demande_rsa_deposee(p)
        and est_ccas(o)
        and decision_ca_instruire(o)
        and organisme_competent(o, p);
    then liberty DeposerDemandeCCAS {
        holder p;
        action depot_demande_ccas(p, o);
        window [@2021-01-01, infinity);
    };
}

@source(
    CASF_D262_26_PRE202407,
    CASF_D262_26_PRE202407_ED2021_03,
    CASF_D262_26_PRE202407_ED2021_04,
    CASF_D262_26_PRE202407_ED2023_01,
