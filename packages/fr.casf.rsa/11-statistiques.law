};

@source(
    CASF_D262_95,
    CASF_D262_95_ED2025_06,
    CASF_D262_95_ED2026_06)
rule TransmettreDonneesAnnuellesPresidentRule(d: Departement, s: Organisme, fin: Date) strict {
    effective [@2025-01-01, infinity);
    label fr official "le président transmet les données annuelles, conjoint inclus, avant la fin du premier trimestre (D. 262-95 en vigueur)";
    label en unofficial "the president transmits the annual data, spouse included, before the end of the first quarter (D. 262-95 in force)";
    when annee_donnees_fin(d, fin)
        and est_service_statistique(s);
    then duty TransmettreDonneesAnnuellesPresident {
        bearer d;
        beneficiary s;
        maintain donnees_annuelles_transmises(d, s, fin) during [fin, month_end_of(add_calendar_period(fin, 3 calendar_month))];
    };
}

@source(
    CASF_D262_95_PRE2025,
    CASF_D262_95_PRE2025_ED2021_03,
    CASF_D262_95_PRE2025_ED2021_04,
    CASF_D262_95_PRE2025_ED2023_01,
    CASF_D262_95_PRE2025_ED2024_01,
    CASF_D262_95_PRE2025_ED2024_07)
rule TransmettreDonneesAnnuellesPresidentPre2025Rule(d: Departement, s: Organisme, fin: Date) strict {
    effective [@2021-01-01, @2025-01-01);
    label fr official "le président transmet les données annuelles des seuls bénéficiaires avant la fin du premier trimestre (D. 262-95 prédécesseur)";
    label en unofficial "the president transmits the claimants-only annual data before the end of the first quarter (D. 262-95 predecessor)";
    when annee_donnees_fin(d, fin)
        and est_service_statistique(s);
    then duty TransmettreDonneesAnnuellesPresidentPre2025 {
        bearer d;
        beneficiary s;
        maintain donnees_annuelles_transmises_pre2025(d, s, fin) during [fin, month_end_of(add_calendar_period(fin, 3 calendar_month))];
    };
}

@source(
    CASF_D262_95,
    CASF_D262_95_ED2025_06,
    CASF_D262_95_ED2026_06)
rule TransmettreDonneesAnnuellesPrefetRule(d: Departement, f: Prefet, fin: Date) strict {
    effective [@2025-01-01, infinity);
    label fr official "le président transmet au représentant de l'Etat les données annuelles, conjoint inclus, avant la fin du premier trimestre (D. 262-95 en vigueur)";
    label en unofficial "the president transmits the annual data, spouse included, to the State representative before the end of the first quarter (D. 262-95 in force)";
    when annee_donnees_fin(d, fin)
        and prefet_du_departement(f, d);
    then duty TransmettreDonneesAnnuellesPrefet {
        bearer d;
        beneficiary f;
        maintain donnees_annuelles_transmises_prefet(d, f, fin) during [fin, month_end_of(add_calendar_period(fin, 3 calendar_month))];
    };
}

@source(
    CASF_D262_95_PRE2025,
    CASF_D262_95_PRE2025_ED2021_03,
    CASF_D262_95_PRE2025_ED2021_04,
    CASF_D262_95_PRE2025_ED2023_01,
    CASF_D262_95_PRE2025_ED2024_01,
    CASF_D262_95_PRE2025_ED2024_07)
rule TransmettreDonneesAnnuellesPrefetPre2025Rule(d: Departement, f: Prefet, fin: Date) strict {
    effective [@2021-01-01, @2025-01-01);
    label fr official "le président transmet au représentant de l'Etat les données annuelles des seuls bénéficiaires avant la fin du premier trimestre (D. 262-95 prédécesseur)";
    label en unofficial "the president transmits the claimants-only annual data to the State representative before the end of the first quarter (D. 262-95 predecessor)";
    when annee_donnees_fin(d, fin)
        and prefet_du_departement(f, d);
    then duty TransmettreDonneesAnnuellesPrefetPre2025 {
        bearer d;
        beneficiary f;
        maintain donnees_annuelles_transmises_prefet_pre2025(d, f, fin) during [fin, month_end_of(add_calendar_period(fin, 3 calendar_month))];
    };
}

@source(
    CASF_D262_96,
    CASF_D262_96_ED2025_06,
    CASF_D262_96_ED2026_06)
rule TransmettreEffectifsTrimestreRule(o: Organisme, s: Organisme, t: Date) strict {
    effective [@2025-01-01, infinity);
    label fr official "la caisse nationale transmet les effectifs de fin de mois avant la fin du deuxième mois du trimestre (D. 262-96 en vigueur)";
    label en unofficial "the national fund transmits the month-end headcounts before the end of the second month of the quarter (D. 262-96 in force)";
    when est_caisse_nationale(o)
        and est_service_statistique(s)
        and trimestre_donnees_fin(t);
    then duty TransmettreEffectifsTrimestre {
        bearer o;
        beneficiary s;
        maintain effectifs_trimestre_transmis(o, s, t) during [t, month_end_of(add_calendar_period(t, 2 calendar_month))];
    };
}

@source(
    CASF_D262_96_PRE2025,
    CASF_D262_96_PRE2025_ED2021_03,
    CASF_D262_96_PRE2025_ED2021_04,
    CASF_D262_96_PRE2025_ED2023_01,
    CASF_D262_96_PRE2025_ED2024_01,
    CASF_D262_96_PRE2025_ED2024_07)
rule TransmettreTrimestrePre2025Rule(o: Organisme, s: Organisme, tprev: Date, tcour: Date) strict {
    effective [@2021-01-01, @2025-01-01);
    label fr official "la caisse nationale transmet les données trimestrielles en quatre rubriques avant la fin du trimestre (D. 262-96 prédécesseur)";
    label en unofficial "the national fund transmits the quarterly data in four items before quarter end (D. 262-96 predecessor)";
    when est_caisse_nationale(o)
        and est_service_statistique(s)
        and trimestre_donnees_fin(tprev)
        and trimestre_courant_fin(tcour);
    then duty TransmettreTrimestrePre2025 {
        bearer o;
        beneficiary s;
        maintain donnees_trimestre_transmises_pre2025(o, s, tprev) during [tprev, tcour];
    };
}

@source(
    CASF_D262_97,
    CASF_D262_97_ED2025_06,
    CASF_D262_97_ED2026_06)
rule TransmettreEffectifsAnnuelsRule(o: Organisme, s: Organisme, d: Departement, fin: Date) strict {
    effective [@2025-01-01, infinity);
    label fr official "la caisse nationale transmet les effectifs et caractéristiques au 31 décembre avant la fin du troisième trimestre (D. 262-97 en vigueur)";
    label en unofficial "the national fund transmits the 31 December headcounts and characteristics before the end of the third quarter (D. 262-97 in force)";
    when est_caisse_nationale(o)
        and est_service_statistique(s)
        and annee_donnees_fin(d, fin);
    then duty TransmettreEffectifsAnnuels {
        bearer o;
        beneficiary s;
        maintain effectifs_annuels_transmis(o, s, fin) during [fin, month_end_of(add_calendar_period(fin, 9 calendar_month))];
    };
}

