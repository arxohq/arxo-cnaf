    CASF_D262_98_ED2025_01,
    CASF_D262_98_ED2025_06,
    CASF_D262_98_ED2026_06)
rule TransmettreInfosL262_55DepartementRule(d: Departement, s: Organisme, p: fr.minima.ressources::Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "le département transmet aux services statistiques les informations L. 262-55 des personnes à l'échantillon (D. 262-98 via L. 262-55, côté département)";
    label en unofficial "the department transmits the in-sample persons' L. 262-55 information to the statistical services (D. 262-98 via L. 262-55, department side)";
    when departement_competent(d, p)
        and echantillon_l262_55(p)
        and est_service_statistique(s);
    then duty TransmettreInfosL262_55Departement {
        bearer d;
        beneficiary s;
        maintain infos_l262_55_transmises_dept(d, s) during [@2021-01-01, infinity);
    };
}

@source(
    CASF_D262_100,
    CASF_D262_100_ED2021_03,
    CASF_D262_100_ED2021_04,
    CASF_D262_100_ED2023_01,
    CASF_D262_100_ED2024_01,
    CASF_D262_100_ED2024_07,
    CASF_D262_100_ED2025_01,
    CASF_D262_100_ED2025_06,
    CASF_D262_100_ED2026_06)
rule PublierResultatsServicesRule(s: Organisme) strict {
    effective [@2021-01-01, infinity);
    label fr official "les services statistiques assurent la publication régulière des résultats (D. 262-100)";
    label en unofficial "the statistical services ensure the regular publication of the results (D. 262-100)";
    when est_service_statistique(s);
    then duty PublierResultatsServices {
        bearer s;
        maintain publication_services_assuree(s) during [@2021-01-01, infinity);
    };
}

@source(
    CASF_D262_100,
    CASF_D262_100_ED2021_03,
    CASF_D262_100_ED2021_04,
    CASF_D262_100_ED2023_01,
    CASF_D262_100_ED2024_01,
    CASF_D262_100_ED2024_07,
    CASF_D262_100_ED2025_01,
    CASF_D262_100_ED2025_06,
    CASF_D262_100_ED2026_06)
rule PublierResultatsCaissesRule(o: Organisme) strict {
    effective [@2021-01-01, infinity);
    label fr official "la caisse nationale assure la publication régulière des résultats (D. 262-100)";
    label en unofficial "the national fund ensures the regular publication of the results (D. 262-100)";
    when est_caisse_nationale(o);
    then duty PublierResultatsCaisses {
        bearer o;
        maintain publication_caisses_assuree(o) during [@2021-01-01, infinity);
    };
}
