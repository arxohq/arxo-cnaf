rule TransmettreAnnuellesCaissesPre2025Rule(o: Organisme, s: Organisme, d: Departement, fin: Date) strict {
    effective [@2021-01-01, @2025-01-01);
    label fr official "la caisse nationale transmet les données annuelles en cinq rubriques avant la fin du premier trimestre (D. 262-97 prédécesseur)";
    label en unofficial "the national fund transmits the annual data in five items before the end of the first quarter (D. 262-97 predecessor)";
    when est_caisse_nationale(o)
        and est_service_statistique(s)
        and annee_donnees_fin(d, fin);
    then duty TransmettreAnnuellesCaissesPre2025 {
        bearer o;
        beneficiary s;
        maintain donnees_annuelles_transmises_caisses_pre2025(o, s, fin) during [fin, month_end_of(add_calendar_period(fin, 3 calendar_month))];
    };
}

@source(
    CASF_D262_98,
    CASF_D262_98_ED2021_03,
    CASF_D262_98_ED2021_04,
    CASF_D262_98_ED2023_01,
    CASF_D262_98_ED2024_01,
    CASF_D262_98_ED2024_07,
    CASF_D262_98_ED2025_01,
    CASF_D262_98_ED2025_06,
    CASF_D262_98_ED2026_06)
rule TransmettreInfosL262_55OrganismeRule(o: Organisme, s: Organisme, p: fr.minima.ressources::Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "l'organisme transmet aux services statistiques les informations L. 262-55 des personnes à l'échantillon (D. 262-98 via L. 262-55, côté organisme)";
    label en unofficial "the body transmits the in-sample persons' L. 262-55 information to the statistical services (D. 262-98 via L. 262-55, body side)";
    when est_organisme_service(o)
        and organisme_competent(o, p)
        and echantillon_l262_55(p)
        and est_service_statistique(s);
    then duty TransmettreInfosL262_55Organisme {
        bearer o;
        beneficiary s;
        maintain infos_l262_55_transmises_organisme(o, s) during [@2021-01-01, infinity);
    };
}

@source(
    CASF_D262_98,
    CASF_D262_98_ED2021_03,
    CASF_D262_98_ED2021_04,
    CASF_D262_98_ED2023_01,
