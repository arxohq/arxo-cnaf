// Fraudulent 1000.00 overpayment: no two-year limit and a 10 %
// indemnity, 100.00 (L.262-45 al. 1 ; L.262-46 al. 1).
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-indu-fraude-indemnite" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2025-07-15T12:00:00Z; knowledge_time @2025-07-15T12:00:00Z; legal_time @2025-07-15; timezone "Europe/Paris"; }
        assert "fraude-01": indu_montant(entity_ref("urn:fr:rsa:case:indu-fraude-indemnite"), 1000.00 EUR) { origin case_input; }
        assert "fraude-02": indu_fraude(entity_ref("urn:fr:rsa:case:indu-fraude-indemnite")) { origin case_input; }
        assert "fraude-03": notification_indu(entity_ref("urn:fr:rsa:case:indu-fraude-indemnite")) { origin case_input; }
    }
    evaluate truth(indu_recouvrable(entity_ref("urn:fr:rsa:case:indu-fraude-indemnite"), 1000.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(indemnite_fraude(entity_ref("urn:fr:rsa:case:indu-fraude-indemnite"), 100.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
