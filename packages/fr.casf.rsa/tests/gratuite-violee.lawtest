// Free instruction violated: the body that received the filing
// charged for the instruction it performed (D. 262-28). Pair of
// gratuite-interdite.
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-gratuite-violee" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2025-06-15T12:00:00Z; knowledge_time @2025-06-15T12:00:00Z; legal_time @2025-06-15; timezone "Europe/Paris"; }
        assert "grat-01": instruction_effectuee(entity_ref("urn:fr:rsa:org:caf"), entity_ref("urn:fr:rsa:case:gratuite-violee")) { origin case_input; }
        assert "grat-02": exiger_frais_instruction(entity_ref("urn:fr:rsa:org:caf"), entity_ref("urn:fr:rsa:case:gratuite-violee")) { origin case_input; }
        assert "grat-03": demande_deposee_aupres(entity_ref("urn:fr:rsa:org:caf"), entity_ref("urn:fr:rsa:case:gratuite-violee")) { origin case_input; }
    }
    evaluate positions();
    expect position(InstruireGratuitement, VIOLATED);
    expect evaluation_status == COMPUTED;
}
