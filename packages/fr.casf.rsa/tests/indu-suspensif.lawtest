// Ongoing appeal against the recovery: suspensive, no recovery
// (L.262-46 al. 2).
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-indu-suspensif" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2025-07-15T12:00:00Z; knowledge_time @2025-07-15T12:00:00Z; legal_time @2025-07-15; timezone "Europe/Paris"; }
        assert "susp-01": indu_montant(entity_ref("urn:fr:rsa:case:indu-suspensif"), 500.00 EUR) { origin case_input; }
        assert "susp-02": prescription_cours(entity_ref("urn:fr:rsa:case:indu-suspensif"), 1) { origin case_input; }
        assert "susp-03": notification_indu(entity_ref("urn:fr:rsa:case:indu-suspensif")) { origin case_input; }
        assert "susp-04": recours_suspensif(entity_ref("urn:fr:rsa:case:indu-suspensif")) { origin case_input; }
    }
    evaluate truth(indu_non_recupere(entity_ref("urn:fr:rsa:case:indu-suspensif")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
