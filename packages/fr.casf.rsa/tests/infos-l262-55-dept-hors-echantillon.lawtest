// Filed claim but out of the L. 262-55 sample, department side: the
// department is competent, the claim is filed and the statistical
// service stands ready, yet no sample inclusion is established, so
// the D. 262-98 transmission duty does not arise ("informations
// relatives aux personnes physiques destinées à la constitution
// d'échantillons statistiquement représentatifs", L. 262-55 via
// D. 262-98). Filing alone does not prove sample inclusion. The
// fulfillment literal stays underived. Control pair of
// infos-l262-55-dept.
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-infos-l262-55-dept-hors-echantillon" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2025-06-15T12:00:00Z; knowledge_time @2025-06-15T12:00:00Z; legal_time @2025-06-15; timezone "Europe/Paris"; }
        assert "infd-01": departement_competent(entity_ref("urn:fr:rsa:dept:nord"), entity_ref("urn:fr:rsa:case:infos-l262-55-dept-hors-echantillon")) { origin case_input; }
        assert "infd-02": demande_rsa_deposee(entity_ref("urn:fr:rsa:case:infos-l262-55-dept-hors-echantillon")) { origin case_input; }
        assert "infd-03": est_service_statistique(entity_ref("urn:fr:rsa:org:drees")) { origin case_input; }
    }
    evaluate truth(infos_l262_55_transmises_dept(entity_ref("urn:fr:rsa:dept:nord"), entity_ref("urn:fr:rsa:org:drees")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
