// Annual data to the State representative, current wording: the
// president transmits the 2024 annual data, spouse included, to the
// representative of the State in the department before the end of the
// first quarter of 2025 (D. 262-95 in force). Legal time inside the
// [year end, year end + 3 months] duty window. No statistical-service
// facts: each recipient duty fires on its own premises. Recipient
// pair of donnees-annuelles-president.
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-donnees-annuelles-prefet" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2025-02-15T12:00:00Z; knowledge_time @2025-02-15T12:00:00Z; legal_time @2025-02-15; timezone "Europe/Paris"; }
        assert "statf-01": annee_donnees_fin(entity_ref("urn:fr:rsa:dept:nord"), @2024-12-31) { origin case_input; }
        assert "statf-02": prefet_du_departement(entity_ref("urn:fr:rsa:prefet:nord"), entity_ref("urn:fr:rsa:dept:nord")) { origin case_input; }
    }
    evaluate positions();
    expect position(TransmettreDonneesAnnuellesPrefet, ACTIVE);
    expect evaluation_status == COMPUTED;
}
