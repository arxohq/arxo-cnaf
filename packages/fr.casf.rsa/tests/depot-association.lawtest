// Claim filed: the claimant may file at the association delegated by
// the president (D. 262-26 c)).
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-depot-association" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2025-06-15T12:00:00Z; knowledge_time @2025-06-15T12:00:00Z; legal_time @2025-06-15; timezone "Europe/Paris"; }
        assert "depot-01": demande_rsa_deposee(entity_ref("urn:fr:rsa:case:depot-association")) { origin case_input; }
        assert "depot-02": est_association_deleguee(entity_ref("urn:fr:rsa:org:assoc")) { origin case_input; }
        assert "depot-03": delegation_instruction(entity_ref("urn:fr:rsa:org:assoc")) { origin case_input; }
        assert "depot-04": organisme_competent(entity_ref("urn:fr:rsa:org:assoc"), entity_ref("urn:fr:rsa:case:depot-association")) { origin case_input; }
    }
    evaluate positions();
    expect position(DeposerDemandeAssociation, ACTIVE);
    expect evaluation_status == COMPUTED;
}
