// Claim filed: the claimant may file at department services
// (D. 262-26 b)).
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-depot-services" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2025-06-15T12:00:00Z; knowledge_time @2025-06-15T12:00:00Z; legal_time @2025-06-15; timezone "Europe/Paris"; }
        assert "depot-01": demande_rsa_deposee(entity_ref("urn:fr:rsa:case:depot-services")) { origin case_input; }
        assert "depot-02": departement_competent(entity_ref("urn:fr:rsa:dept:nord"), entity_ref("urn:fr:rsa:case:depot-services")) { origin case_input; }
    }
    evaluate positions();
    expect position(DeposerDemandeServices, ACTIVE);
    expect evaluation_status == COMPUTED;
}
