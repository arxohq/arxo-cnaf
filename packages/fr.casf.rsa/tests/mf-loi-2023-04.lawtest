// The window ends on 1 April 2023: decree 2023-340 sets 607.75 outright, the reading is
// selected but adds no second value (598.54 is not derived).
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-mf-loi-2023-04" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2023-04-15T12:00:00Z; knowledge_time @2023-04-15T12:00:00Z; legal_time @2023-04-15; timezone "Europe/Paris"; interpretation MfJuillet2022ArrondiCentime; }
        assert "mfl-a4-01": mois_droit(entity_ref("urn:fr:rsa:case:mf-loi-2023-04"), @2023-04-01) { origin case_input; }
        assert "mfl-a4-02": foyer_nb_personnes(entity_ref("urn:fr:rsa:case:mf-loi-2023-04"), 1) { origin case_input; }
    }
    evaluate truth(mf_menage(entity_ref("urn:fr:rsa:case:mf-loi-2023-04"), 607.75 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(mf_menage(entity_ref("urn:fr:rsa:case:mf-loi-2023-04"), 598.54 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
