// Lane integration, asymmetric figures: a 200.00-pro new-regime quarter
// is established by fr.minima.ressources (intermediate 600.00 - 200.00
// = 400.00, quarterly average due 400.00) and consumed here AS the due:
// single person, base 600.00 -> allowance 400.00 for June 2025
// (L. 262-2 al. 2 via R. 262-7 I). The right month is the filing
// month (June): "le revenu de solidarité active est ouvert à compter
// de la date de dépôt de la demande" (L. 262-18), so an April right
// on a June filing is source-impossible; the February-April reference
// quarter stays (fourth-to-second months before the June claim,
// R. 262-7 I). This case discriminates the D-44 repair: the old
// consumer-side double subtraction derived 200.00.
// (Bare-zero Money in evaluate positions does not match derived zeros;
// the lane tests use nonzero figures.)
// The minima-side composition input carries the value derived on this
// side (B-RSA-MF-INPUT-CONTRACT, case-by-case consistency).
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-cascade-trimestre-200" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2025-06-15T12:00:00Z; knowledge_time @2025-06-15T12:00:00Z; legal_time @2025-06-15; timezone "Europe/Paris"; }
        assert "casc2-01": fr.minima.ressources::foyer_du_cas(entity_ref("urn:fr:rsa:case:cascade-trimestre-200")) { origin case_input; }
        assert "casc2-02": fr.minima.ressources::mois_demande(@2025-06-01) { origin case_input; }
        assert "casc2-03": fr.minima.ressources::mois_reference(@2025-02-01, @2025-03-01, @2025-04-01) { origin case_input; }
        assert "casc2-04": fr.minima.ressources::mf_mois(entity_ref("urn:fr:rsa:case:cascade-trimestre-200"), @2025-02-01, 600.00 EUR) { origin case_input; }
        assert "casc2-05": fr.minima.ressources::mf_mois(entity_ref("urn:fr:rsa:case:cascade-trimestre-200"), @2025-03-01, 600.00 EUR) { origin case_input; }
        assert "casc2-06": fr.minima.ressources::mf_mois(entity_ref("urn:fr:rsa:case:cascade-trimestre-200"), @2025-04-01, 600.00 EUR) { origin case_input; }
        assert "casc2-07": fr.minima.ressources::dsn_pro_mois(entity_ref("urn:fr:rsa:case:cascade-trimestre-200"), @2025-02-01, 200.00 EUR) { origin case_input; }
        assert "casc2-08": fr.minima.ressources::dsn_pro_mois(entity_ref("urn:fr:rsa:case:cascade-trimestre-200"), @2025-03-01, 200.00 EUR) { origin case_input; }
        assert "casc2-09": fr.minima.ressources::dsn_pro_mois(entity_ref("urn:fr:rsa:case:cascade-trimestre-200"), @2025-04-01, 200.00 EUR) { origin case_input; }
        assert "casc2-10": fr.minima.ressources::dsn_autre_mois(entity_ref("urn:fr:rsa:case:cascade-trimestre-200"), @2025-02-01, 0 EUR) { origin case_input; }
        assert "casc2-11": fr.minima.ressources::dsn_autre_mois(entity_ref("urn:fr:rsa:case:cascade-trimestre-200"), @2025-03-01, 0 EUR) { origin case_input; }
        assert "casc2-12": fr.minima.ressources::dsn_autre_mois(entity_ref("urn:fr:rsa:case:cascade-trimestre-200"), @2025-04-01, 0 EUR) { origin case_input; }
        assert "casc2-13": fr.minima.ressources::declare_total_mois(entity_ref("urn:fr:rsa:case:cascade-trimestre-200"), @2025-02-01, 0 EUR) { origin case_input; }
        assert "casc2-14": fr.minima.ressources::declare_total_mois(entity_ref("urn:fr:rsa:case:cascade-trimestre-200"), @2025-03-01, 0 EUR) { origin case_input; }
        assert "casc2-15": fr.minima.ressources::declare_total_mois(entity_ref("urn:fr:rsa:case:cascade-trimestre-200"), @2025-04-01, 0 EUR) { origin case_input; }
        assert "casc2-16": fr.minima.ressources::prestation_service_mois(entity_ref("urn:fr:rsa:case:cascade-trimestre-200"), @2025-02-01, 0 EUR) { origin case_input; }
        assert "casc2-17": fr.minima.ressources::prestation_service_mois(entity_ref("urn:fr:rsa:case:cascade-trimestre-200"), @2025-03-01, 0 EUR) { origin case_input; }
        assert "casc2-18": fr.minima.ressources::prestation_service_mois(entity_ref("urn:fr:rsa:case:cascade-trimestre-200"), @2025-04-01, 0 EUR) { origin case_input; }
        assert "casc2-19": mf_base(entity_ref("urn:fr:rsa:case:cascade-trimestre-200"), 600.00 EUR) { origin case_input; }
        assert "casc2-20": foyer_nb_personnes(entity_ref("urn:fr:rsa:case:cascade-trimestre-200"), 1) { origin case_input; }
        assert "casc2-21": mois_droit(entity_ref("urn:fr:rsa:case:cascade-trimestre-200"), @2025-06-01) { origin case_input; }
        assert "casc2-22": residence_stable(entity_ref("urn:fr:rsa:case:cascade-trimestre-200")) { origin case_input; }
        assert "casc2-23": age_charge_condition(entity_ref("urn:fr:rsa:case:cascade-trimestre-200")) { origin case_input; }
        assert "casc2-24": sejour_travail_condition(entity_ref("urn:fr:rsa:case:cascade-trimestre-200")) { origin case_input; }
        assert "casc2-25": conjoint_enfants_comptes(entity_ref("urn:fr:rsa:case:cascade-trimestre-200")) { origin case_input; }
    }
    evaluate truth(fr.minima.ressources::montant_du_trimestre(entity_ref("urn:fr:rsa:case:cascade-trimestre-200"), 400.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(droit_rsa(entity_ref("urn:fr:rsa:case:cascade-trimestre-200"), @2025-06-01));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(allocation_mensuelle(entity_ref("urn:fr:rsa:case:cascade-trimestre-200"), @2025-06-01, 400.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
