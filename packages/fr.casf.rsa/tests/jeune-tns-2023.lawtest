// Young self-employed worker since 2023: RNE entry, 24 months of
// activity, 2023 turnover 30000.00 >= 43 x retained single-person MF
// 600.00 (= 25800.00) -> deemed to meet the hours condition
// (D. 262-25-2 in force). The MF is the 2023 figure, the one in force
// at 1 January of the turnover year ("en vigueur au 1er janvier de
// l'année de réalisation du chiffre d'affaires considéré"); the
// amount stays a retained case input (B-RSA-MF-EURO).
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-jeune-tns-2023" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2024-06-15T12:00:00Z; knowledge_time @2024-06-15T12:00:00Z; legal_time @2024-06-15; timezone "Europe/Paris"; }
        assert "jeun-01": jeune_18_25(entity_ref("urn:fr:rsa:case:jeune-tns-2023")) { origin case_input; }
        assert "jeun-02": tns_non_agricole(entity_ref("urn:fr:rsa:case:jeune-tns-2023")) { origin case_input; }
        assert "jeun-03": tns_immatriculation_rne(entity_ref("urn:fr:rsa:case:jeune-tns-2023")) { origin case_input; }
        assert "jeun-04": tns_duree_activite_mois(entity_ref("urn:fr:rsa:case:jeune-tns-2023"), 24) { origin case_input; }
        assert "jeun-05": tns_chiffre_affaires(entity_ref("urn:fr:rsa:case:jeune-tns-2023"), 2023, 30000.00 EUR) { origin case_input; }
        assert "jeun-06": mf_reference_ca(entity_ref("urn:fr:rsa:case:jeune-tns-2023"), 2023, 600.00 EUR) { origin case_input; }
    }
    evaluate truth(condition_heures_jeune(entity_ref("urn:fr:rsa:case:jeune-tns-2023")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
