// A base supplied for the case wins over the decree even inside the series
// (fund-retained base): 600.00 is kept, 646.52 is not derived.
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-mf-decret-saisie-prevaut" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2025-06-15T12:00:00Z; knowledge_time @2025-06-15T12:00:00Z; legal_time @2025-06-15; timezone "Europe/Paris"; }
        assert "mfdsp-01": mf_base(entity_ref("urn:fr:rsa:case:mf-decret-saisie-prevaut"), 600.00 EUR) { origin case_input; }
        assert "mfdsp-02": foyer_nb_personnes(entity_ref("urn:fr:rsa:case:mf-decret-saisie-prevaut"), 1) { origin case_input; }
        assert "mfdsp-03": mois_droit(entity_ref("urn:fr:rsa:case:mf-decret-saisie-prevaut"), @2025-06-01) { origin case_input; }
    }
    evaluate truth(mf_menage(entity_ref("urn:fr:rsa:case:mf-decret-saisie-prevaut"), 600.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
