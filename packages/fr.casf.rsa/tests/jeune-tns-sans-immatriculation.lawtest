// Young self-employed worker with neither RNE entry nor
// artist-author affiliation: 30 months of activity and a sufficient
// 2023 turnover (30000.00 >= 43 x 600.00) still do not open the
// D. 262-25-2 deeming, because the 1° premise is missing. Control
// pair of jeune-tns-2023 and jeune-tns-artiste-2023.
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-jeune-tns-sans-immatriculation" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2024-06-15T12:00:00Z; knowledge_time @2024-06-15T12:00:00Z; legal_time @2024-06-15; timezone "Europe/Paris"; }
        assert "jeun-01": jeune_18_25(entity_ref("urn:fr:rsa:case:jeune-tns-sans-immatriculation")) { origin case_input; }
        assert "jeun-02": tns_non_agricole(entity_ref("urn:fr:rsa:case:jeune-tns-sans-immatriculation")) { origin case_input; }
        assert "jeun-04": tns_duree_activite_mois(entity_ref("urn:fr:rsa:case:jeune-tns-sans-immatriculation"), 30) { origin case_input; }
        assert "jeun-05": tns_chiffre_affaires(entity_ref("urn:fr:rsa:case:jeune-tns-sans-immatriculation"), 2023, 30000.00 EUR) { origin case_input; }
        assert "jeun-06": mf_reference_ca(entity_ref("urn:fr:rsa:case:jeune-tns-sans-immatriculation"), 2023, 600.00 EUR) { origin case_input; }
    }
    evaluate truth(condition_heures_jeune(entity_ref("urn:fr:rsa:case:jeune-tns-sans-immatriculation")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
