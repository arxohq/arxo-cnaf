// Two-person household, 40 % rate: within the 30 %-50 % band
// (R.262-68 ; R.262-68-6).
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-taux-conforme-plafond" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2025-07-15T12:00:00Z; knowledge_time @2025-07-15T12:00:00Z; legal_time @2025-07-15; timezone "Europe/Paris"; }
        assert "taux-01": sanction_taux(entity_ref("urn:fr:rsa:case:taux-conforme-plafond"), 0.40) { origin case_input; }
        assert "taux-02": foyer_nb_personnes(entity_ref("urn:fr:rsa:case:taux-conforme-plafond"), 2) { origin case_input; }
    }
    evaluate truth(sanction_taux_conforme(entity_ref("urn:fr:rsa:case:taux-conforme-plafond")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
