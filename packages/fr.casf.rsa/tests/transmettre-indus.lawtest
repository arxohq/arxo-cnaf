// Convention delay elapsed with unrecovered overpayments: the body
// transmits them to the president for recovery (D. 262-61 3° ;
// L. 262-46).
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-transmettre-indus" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2025-06-15T12:00:00Z; knowledge_time @2025-06-15T12:00:00Z; legal_time @2025-06-15; timezone "Europe/Paris"; }
        assert "indus-01": convention_service(entity_ref("urn:fr:rsa:dept:nord"), entity_ref("urn:fr:rsa:org:caf")) { origin case_input; }
        assert "indus-02": delai_transmission_indus_expire(entity_ref("urn:fr:rsa:org:caf"), entity_ref("urn:fr:rsa:dept:nord")) { origin case_input; }
    }
    evaluate positions();
    expect position(TransmettreIndusNonRecouvres, ACTIVE);
    expect evaluation_status == COMPUTED;
}
