// No convention: the service body provides instruction and payment
// for the department (D. 262-64 1°).
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-sans-convention-service" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2025-06-15T12:00:00Z; knowledge_time @2025-06-15T12:00:00Z; legal_time @2025-06-15; timezone "Europe/Paris"; }
        assert "sconv-01": absence_convention(entity_ref("urn:fr:rsa:dept:nord"), entity_ref("urn:fr:rsa:org:caf")) { origin case_input; }
        assert "sconv-02": est_organisme_service(entity_ref("urn:fr:rsa:org:caf")) { origin case_input; }
    }
    evaluate positions();
    expect position(InstruireServirSansConvention, ACTIVE);
    expect evaluation_status == COMPUTED;
}
