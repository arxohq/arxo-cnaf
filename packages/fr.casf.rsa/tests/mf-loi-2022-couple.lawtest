// Window 2022-07..2023-03, couple (reading MfJuillet2022ArrondiCentime): the household
// amount follows the R. 262-1 scale from the BUILT base: 598.54 x 1.5 = 897.81.
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-mf-loi-2022-couple" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2022-09-15T12:00:00Z; knowledge_time @2022-09-15T12:00:00Z; legal_time @2022-09-15; timezone "Europe/Paris"; interpretation MfJuillet2022ArrondiCentime; }
        assert "mfl-cp-01": mois_droit(entity_ref("urn:fr:rsa:case:mf-loi-2022-couple"), @2022-09-01) { origin case_input; }
        assert "mfl-cp-02": foyer_nb_personnes(entity_ref("urn:fr:rsa:case:mf-loi-2022-couple"), 2) { origin case_input; }
        assert "mfl-cp-03": foyer_nb_parents(entity_ref("urn:fr:rsa:case:mf-loi-2022-couple"), 2) { origin case_input; }
    }
    evaluate truth(mf_menage(entity_ref("urn:fr:rsa:case:mf-loi-2022-couple"), 897.81 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
