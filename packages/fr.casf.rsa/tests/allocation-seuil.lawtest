// Allowance below the floor: quarterly amount DUE 4.00 < 6.00 -> the
// entitlement stands (due positive, L. 262-2) but nothing is paid
// (R. 262-39). The upstream input is the due itself (R. 262-7 I),
// not retained resources (D-26, D-44: the old 596.00 input read the
// due as resources and derived 600 - 596 = 4.00 by double subtraction).
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-allocation-seuil" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2025-06-15T12:00:00Z; knowledge_time @2025-06-15T12:00:00Z; legal_time @2025-06-15; timezone "Europe/Paris"; }
        assert "seuil-01": mf_base(entity_ref("urn:fr:rsa:case:allocation-seuil"), 600.00 EUR) { origin case_input; }
        assert "seuil-02": foyer_nb_personnes(entity_ref("urn:fr:rsa:case:allocation-seuil"), 1) { origin case_input; }
        assert "seuil-03": mois_droit(entity_ref("urn:fr:rsa:case:allocation-seuil"), @2025-04-01) { origin case_input; }
        assert "seuil-04": residence_stable(entity_ref("urn:fr:rsa:case:allocation-seuil")) { origin case_input; }
        assert "seuil-05": age_charge_condition(entity_ref("urn:fr:rsa:case:allocation-seuil")) { origin case_input; }
        assert "seuil-06": sejour_travail_condition(entity_ref("urn:fr:rsa:case:allocation-seuil")) { origin case_input; }
        assert "seuil-07": conjoint_enfants_comptes(entity_ref("urn:fr:rsa:case:allocation-seuil")) { origin case_input; }
        assert "seuil-08": fr.minima.ressources::montant_du_trimestre(entity_ref("urn:fr:rsa:case:allocation-seuil"), 4.00 EUR) { origin case_input; }
    }
    evaluate truth(droit_rsa(entity_ref("urn:fr:rsa:case:allocation-seuil"), @2025-04-01));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(allocation_non_versee(entity_ref("urn:fr:rsa:case:allocation-seuil"), @2025-04-01));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
