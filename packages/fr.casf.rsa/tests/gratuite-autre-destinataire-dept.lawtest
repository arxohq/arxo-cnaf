// Instructor that did not receive the filing, department side:
// Nord services performed the instruction, but the claim was filed
// with another department's services -> no free-instruction
// prohibition binds Nord, because D. 262-28 limits gratuitous
// instruction to the services or bodies « auprès desquels elles ont
// été déposées ». Control pair of gratuite-interdite-dept (same
// services receive and instruct).
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-gratuite-autre-destinataire-dept" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2025-06-15T12:00:00Z; knowledge_time @2025-06-15T12:00:00Z; legal_time @2025-06-15; timezone "Europe/Paris"; }
        assert "grat-01": instruction_effectuee_dept(entity_ref("urn:fr:rsa:dept:nord"), entity_ref("urn:fr:rsa:case:gratuite-autre-destinataire-dept")) { origin case_input; }
        assert "grat-02": demande_deposee_aupres_dept(entity_ref("urn:fr:rsa:dept:somme"), entity_ref("urn:fr:rsa:case:gratuite-autre-destinataire-dept")) { origin case_input; }
    }
    evaluate positions();
    expect not position(InstruireGratuitementDept, ACTIVE);
    expect evaluation_status == COMPUTED;
}
