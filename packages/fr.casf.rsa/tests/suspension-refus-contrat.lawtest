// Refusal to draw up the contract, notified, bound by L.262-28:
// suspension decided (L.262-37, I 1° ; R.262-68 ; R.262-69-1).
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-suspension-refus-contrat" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2025-07-15T12:00:00Z; knowledge_time @2025-07-15T12:00:00Z; legal_time @2025-07-15; timezone "Europe/Paris"; }
        assert "susp-01": manquement(entity_ref("urn:fr:rsa:case:suspension-refus-contrat"), REFUS_CONTRAT) { origin case_input; }
        assert "susp-02": notification_10j(entity_ref("urn:fr:rsa:case:suspension-refus-contrat")) { origin case_input; }
        assert "susp-03": tenu_obligations_262_28(entity_ref("urn:fr:rsa:case:suspension-refus-contrat")) { origin case_input; }
    }
    evaluate truth(sanction_suspension(entity_ref("urn:fr:rsa:case:suspension-refus-contrat"), REFUS_CONTRAT));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
