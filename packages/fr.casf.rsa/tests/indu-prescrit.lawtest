// Three years since a non-fraudulent overpayment, no interruption:
// time-barred (L.262-45).
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-indu-prescrit" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2025-07-15T12:00:00Z; knowledge_time @2025-07-15T12:00:00Z; legal_time @2025-07-15; timezone "Europe/Paris"; }
        assert "presc-01": indu_montant(entity_ref("urn:fr:rsa:case:indu-prescrit"), 500.00 EUR) { origin case_input; }
        assert "presc-02": prescription_cours(entity_ref("urn:fr:rsa:case:indu-prescrit"), 3) { origin case_input; }
    }
    evaluate truth(indu_non_recupere(entity_ref("urn:fr:rsa:case:indu-prescrit")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
