// Mixed ranks: fifth person age 25 receives 30 %, sixth young dependent 40 %.

test "urn:query:fr-rsa-mf-rangs-mixtes" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2025-06-15T12:00:00Z; knowledge_time @2025-06-15T12:00:00Z; legal_time @2025-06-15; timezone "Europe/Paris"; }
        assert "mf-rangs-mixtes-base": mf_base(entity_ref("urn:fr:rsa:case:mf-rangs-mixtes"), 600.00 EUR) { origin case_input; }
