        assert "mf-rang5-jeune-24-rank-2": foyer_membre_rang(entity_ref("urn:fr:rsa:case:mf-rang5-jeune-24"), entity_ref("urn:fr:rsa:case:mf-rang5-jeune-24:member-2"), 2) { origin case_input; }
        assert "mf-rang5-jeune-24-rank-3": foyer_membre_rang(entity_ref("urn:fr:rsa:case:mf-rang5-jeune-24"), entity_ref("urn:fr:rsa:case:mf-rang5-jeune-24:member-3"), 3) { origin case_input; }
        assert "mf-rang5-jeune-24-child-3": foyer_enfant_charge(entity_ref("urn:fr:rsa:case:mf-rang5-jeune-24"), entity_ref("urn:fr:rsa:case:mf-rang5-jeune-24:member-3")) { origin case_input; }
        assert "mf-rang5-jeune-24-rank-4": foyer_membre_rang(entity_ref("urn:fr:rsa:case:mf-rang5-jeune-24"), entity_ref("urn:fr:rsa:case:mf-rang5-jeune-24:member-4"), 4) { origin case_input; }
        assert "mf-rang5-jeune-24-child-4": foyer_enfant_charge(entity_ref("urn:fr:rsa:case:mf-rang5-jeune-24"), entity_ref("urn:fr:rsa:case:mf-rang5-jeune-24:member-4")) { origin case_input; }
        assert "mf-rang5-jeune-24-rank-5": foyer_membre_rang(entity_ref("urn:fr:rsa:case:mf-rang5-jeune-24"), entity_ref("urn:fr:rsa:case:mf-rang5-jeune-24:member-5"), 5) { origin case_input; }
        assert "mf-rang5-jeune-24-other-5": foyer_autre_charge(entity_ref("urn:fr:rsa:case:mf-rang5-jeune-24"), entity_ref("urn:fr:rsa:case:mf-rang5-jeune-24:member-5")) { origin case_input; }
        assert "mf-rang5-jeune-24-birth-5": foyer_naissance(entity_ref("urn:fr:rsa:case:mf-rang5-jeune-24"), entity_ref("urn:fr:rsa:case:mf-rang5-jeune-24:member-5"), @2000-07-01) { origin case_input; }
    }
    evaluate truth(foyer_sup_taux40(entity_ref("urn:fr:rsa:case:mf-rang5-jeune-24"), 1));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(foyer_sup_taux30(entity_ref("urn:fr:rsa:case:mf-rang5-jeune-24"), 0));
