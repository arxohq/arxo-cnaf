// Young agricultural worker: L. 722-1 affiliation, 24 months of
// activity, 2024 turnover 15000.00 >= 24 x retained single-person MF
// 600.00 (= 14400.00) -> deemed to meet the hours condition
// (D. 262-25-3). The MF is the 2024 figure, the one in force at
// 1 January of the turnover year ("en vigueur au 1er janvier de
// l'année de réalisation du chiffre d'affaires considéré"); the
// amount stays a retained case input (B-RSA-MF-EURO).
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-jeune-agricole" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2025-06-15T12:00:00Z; knowledge_time @2025-06-15T12:00:00Z; legal_time @2025-06-15; timezone "Europe/Paris"; }
        assert "jeun-01": jeune_18_25(entity_ref("urn:fr:rsa:case:jeune-agricole")) { origin case_input; }
        assert "jeun-02": agricole_l722_1(entity_ref("urn:fr:rsa:case:jeune-agricole")) { origin case_input; }
        assert "jeun-03": agricole_affiliation(entity_ref("urn:fr:rsa:case:jeune-agricole")) { origin case_input; }
        assert "jeun-04": agricole_duree_mois(entity_ref("urn:fr:rsa:case:jeune-agricole"), 24) { origin case_input; }
        assert "jeun-05": agricole_chiffre_affaires(entity_ref("urn:fr:rsa:case:jeune-agricole"), 2024, 15000.00 EUR) { origin case_input; }
        assert "jeun-06": mf_reference_ca(entity_ref("urn:fr:rsa:case:jeune-agricole"), 2024, 600.00 EUR) { origin case_input; }
    }
    evaluate truth(condition_heures_jeune(entity_ref("urn:fr:rsa:case:jeune-agricole")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
