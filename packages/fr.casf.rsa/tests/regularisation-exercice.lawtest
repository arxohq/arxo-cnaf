// Year-end settlement of the advances (D. 262-61 1°).
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-regularisation-exercice" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2025-06-15T12:00:00Z; knowledge_time @2025-06-15T12:00:00Z; legal_time @2025-06-15; timezone "Europe/Paris"; }
        assert "regul-01": convention_service(entity_ref("urn:fr:rsa:dept:nord"), entity_ref("urn:fr:rsa:org:caf")) { origin case_input; }
        assert "regul-02": exercice_comptable(entity_ref("urn:fr:rsa:dept:nord"), entity_ref("urn:fr:rsa:org:caf"), 2024) { origin case_input; }
    }
    evaluate positions();
    expect position(RegulariserAcomptesExercice, ACTIVE);
    expect evaluation_status == COMPUTED;
}
