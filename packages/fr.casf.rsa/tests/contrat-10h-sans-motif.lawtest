// Ten unjustified hours: not compliant (L.5411-6, II 3°).
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-contrat-10h-sans-motif" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2025-07-15T12:00:00Z; knowledge_time @2025-07-15T12:00:00Z; legal_time @2025-07-15; timezone "Europe/Paris"; }
        assert "h10-01": contrat_signe(entity_ref("urn:fr:rsa:case:contrat-10h-sans-motif")) { origin case_input; }
        assert "h10-02": contrat_heures(entity_ref("urn:fr:rsa:case:contrat-10h-sans-motif"), 10) { origin case_input; }
    }
    evaluate truth(contrat_heures_conforme(entity_ref("urn:fr:rsa:case:contrat-10h-sans-motif")));
    expect result_kind == PROPOSITION;
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
}
