// Three persons: 600.00 + 50 % + 30 % = 1080.00 (R.262-1).
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-mf-composition-3" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2025-06-15T12:00:00Z; knowledge_time @2025-06-15T12:00:00Z; legal_time @2025-06-15; timezone "Europe/Paris"; }
        assert "mfc3-01": mf_base(entity_ref("urn:fr:rsa:case:mf-composition-3"), 600.00 EUR) { origin case_input; }
        assert "mfc3-02": foyer_nb_personnes(entity_ref("urn:fr:rsa:case:mf-composition-3"), 3) { origin case_input; }
    }
    evaluate truth(mf_menage(entity_ref("urn:fr:rsa:case:mf-composition-3"), 1080.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(mf_composition(entity_ref("urn:fr:rsa:case:mf-composition-3"), 3, 1080.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
