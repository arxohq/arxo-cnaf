// Young worker on a mixed path: 2000.00 salaried hours + 100.00
// occasional + 1300.00 fund-established pro-rata equivalent = 3400.00
// >= twice the retained annual reference 1607.00 (= 3214.00), prorated
// turnover condition met, six capped excluded months (D. 262-25-4).
// The proration method is outside the text and arrives established.
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-jeune-mixte" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2025-06-15T12:00:00Z; knowledge_time @2025-06-15T12:00:00Z; legal_time @2025-06-15; timezone "Europe/Paris"; }
        assert "jeun-01": jeune_18_25(entity_ref("urn:fr:rsa:case:jeune-mixte")) { origin case_input; }
        assert "jeun-02": heures_travail_reference(entity_ref("urn:fr:rsa:case:jeune-mixte"), 2000.0) { origin case_input; }
        assert "jeun-03": heures_occasionnelles(entity_ref("urn:fr:rsa:case:jeune-mixte"), 100.0) { origin case_input; }
        assert "jeun-04": equivalent_tns_prorata(entity_ref("urn:fr:rsa:case:jeune-mixte"), 1300.0) { origin case_input; }
        assert "jeun-05": condition_ca_prorata(entity_ref("urn:fr:rsa:case:jeune-mixte")) { origin case_input; }
        assert "jeun-06": heures_annuelles_reference(entity_ref("urn:fr:rsa:case:jeune-mixte"), 1607.0) { origin case_input; }
        assert "jeun-07": mois_prestations_exclus(entity_ref("urn:fr:rsa:case:jeune-mixte"), 6) { origin case_input; }
    }
    evaluate truth(condition_heures_jeune(entity_ref("urn:fr:rsa:case:jeune-mixte")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
