// Free instruction: the body that received the filing and performed
// the instruction must not charge for it (D. 262-28 : « auprès
// desquels elles ont été déposées »). An instructor that did not
// receive the filing owes nothing (control:
// gratuite-autre-destinataire).
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-gratuite-interdite" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2025-06-15T12:00:00Z; knowledge_time @2025-06-15T12:00:00Z; legal_time @2025-06-15; timezone "Europe/Paris"; }
        assert "grat-01": instruction_effectuee(entity_ref("urn:fr:rsa:org:caf"), entity_ref("urn:fr:rsa:case:gratuite-interdite")) { origin case_input; }
        assert "grat-02": demande_deposee_aupres(entity_ref("urn:fr:rsa:org:caf"), entity_ref("urn:fr:rsa:case:gratuite-interdite")) { origin case_input; }
    }
    evaluate positions();
    expect position(InstruireGratuitement, ACTIVE);
    expect evaluation_status == COMPUTED;
}
