// Couple (two persons), no case base: 635.71 (decree 2024-396) + 50 % = 953.565
// (R.262-1, +50 % for the second person).
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-mf-decret-couple-2024" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2024-06-15T12:00:00Z; knowledge_time @2024-06-15T12:00:00Z; legal_time @2024-06-15; timezone "Europe/Paris"; }
        assert "mfdc24-01": mois_droit(entity_ref("urn:fr:rsa:case:mf-decret-couple-2024"), @2024-06-01) { origin case_input; }
        assert "mfdc24-02": foyer_nb_personnes(entity_ref("urn:fr:rsa:case:mf-decret-couple-2024"), 2) { origin case_input; }
        assert "mfdc24-03": foyer_nb_parents(entity_ref("urn:fr:rsa:case:mf-decret-couple-2024"), 2) { origin case_input; }
    }
    evaluate truth(mf_menage(entity_ref("urn:fr:rsa:case:mf-decret-couple-2024"), 953.565 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
