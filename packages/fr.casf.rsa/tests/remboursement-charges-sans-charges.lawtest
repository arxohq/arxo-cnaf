// No late-payment charges: a service convention and an accounting
// year alone do not open the annual reimbursement duty, because the
// text reimburses only the "charges financières qui pourraient
// résulter pour l'organisme ... des retards de versement des
// acomptes mensuels par le département" (D. 262-61 2°). The
// fulfillment literal stays underived. Control pair of
// remboursement-charges.
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-remboursement-charges-sans-charges" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2025-06-15T12:00:00Z; knowledge_time @2025-06-15T12:00:00Z; legal_time @2025-06-15; timezone "Europe/Paris"; }
        assert "remb-01": convention_service(entity_ref("urn:fr:rsa:dept:nord"), entity_ref("urn:fr:rsa:org:caf")) { origin case_input; }
        assert "remb-02": exercice_comptable(entity_ref("urn:fr:rsa:dept:nord"), entity_ref("urn:fr:rsa:org:caf"), 2024) { origin case_input; }
    }
    evaluate truth(remboursement_charges_effectue(entity_ref("urn:fr:rsa:dept:nord"), entity_ref("urn:fr:rsa:org:caf"), 2024));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
