// Window 2022-07..2023-03, first day (reading MfJuillet2022ArrondiCentime): art. 9 of law
// 2022-1158 revalues the allowances by the coefficient 1.04 on 1 July 2022 and L. 262-3 al. 1
// makes the montant forfaitaire one of them. The base is BUILT: 575.52 (decree 2022-699)
// x 1.04 = 598.5408, rounded to the centime HALF_UP (a reading: no pinned text states the
// rounding) = 598.54. Not 575.52 (the stale April figure), not 598.5408.
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-mf-loi-2022-07" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2022-07-15T12:00:00Z; knowledge_time @2022-07-15T12:00:00Z; legal_time @2022-07-15; timezone "Europe/Paris"; interpretation MfJuillet2022ArrondiCentime; }
        assert "mfl-07-01": mois_droit(entity_ref("urn:fr:rsa:case:mf-loi-2022-07"), @2022-07-01) { origin case_input; }
        assert "mfl-07-02": foyer_nb_personnes(entity_ref("urn:fr:rsa:case:mf-loi-2022-07"), 1) { origin case_input; }
    }
    evaluate truth(mf_menage(entity_ref("urn:fr:rsa:case:mf-loi-2022-07"), 598.54 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(mf_menage(entity_ref("urn:fr:rsa:case:mf-loi-2022-07"), 575.52 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(mf_menage(entity_ref("urn:fr:rsa:case:mf-loi-2022-07"), 598.5408 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
