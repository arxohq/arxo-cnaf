// Full entitlement: single person, base 600.00, quarterly amount DUE
// 200.00 from the upstream lane -> allowance 200.00 for April 2025.
// The upstream figure is the due itself (R. 262-7 I: average of the
// monthly MF-minus-resources intermediates), consumed as the due per
// L. 262-2 al. 2 ("porte les ressources du foyer au niveau du montant
// forfaitaire"); it is never subtracted from the MF again (D-26, D-44:
// the W4 double subtraction is repaired; the old 400.00 expectation
// paid the household its own retained resources).
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-allocation-normale" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2025-06-15T12:00:00Z; knowledge_time @2025-06-15T12:00:00Z; legal_time @2025-06-15; timezone "Europe/Paris"; }
        assert "alloc-01": mf_base(entity_ref("urn:fr:rsa:case:allocation-normale"), 600.00 EUR) { origin case_input; }
        assert "alloc-02": foyer_nb_personnes(entity_ref("urn:fr:rsa:case:allocation-normale"), 1) { origin case_input; }
        assert "alloc-03": mois_droit(entity_ref("urn:fr:rsa:case:allocation-normale"), @2025-04-01) { origin case_input; }
        assert "alloc-04": residence_stable(entity_ref("urn:fr:rsa:case:allocation-normale")) { origin case_input; }
        assert "alloc-05": age_charge_condition(entity_ref("urn:fr:rsa:case:allocation-normale")) { origin case_input; }
        assert "alloc-06": sejour_travail_condition(entity_ref("urn:fr:rsa:case:allocation-normale")) { origin case_input; }
        assert "alloc-07": conjoint_enfants_comptes(entity_ref("urn:fr:rsa:case:allocation-normale")) { origin case_input; }
        assert "alloc-08": fr.minima.ressources::montant_du_trimestre(entity_ref("urn:fr:rsa:case:allocation-normale"), 200.00 EUR) { origin case_input; }
    }
    evaluate truth(droit_rsa(entity_ref("urn:fr:rsa:case:allocation-normale"), @2025-04-01));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(allocation_mensuelle(entity_ref("urn:fr:rsa:case:allocation-normale"), @2025-04-01, 200.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
