// Couple, September 2024, old regime (three previous months): the household MF built
// from decree 2024-396 (635.71 x 1.5 = 953.565) is written into
// fr.minima.ressources::mf_mois for each reference month and into ::mf_composition
// (size 2), so the neighbour needs no flat-rate input (B-RSA-MF-INPUT-CONTRACT).
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-mf-decret-minima-couple" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2024-09-15T12:00:00Z; knowledge_time @2024-09-15T12:00:00Z; legal_time @2024-09-15; timezone "Europe/Paris"; }
        assert "mfdmc-01": fr.minima.ressources::foyer_du_cas(entity_ref("urn:fr:rsa:case:mf-decret-minima-couple")) { origin case_input; }
        assert "mfdmc-02": fr.minima.ressources::mois_demande(@2024-09-01) { origin case_input; }
        assert "mfdmc-03": fr.minima.ressources::mois_reference(@2024-06-01, @2024-07-01, @2024-08-01) { origin case_input; }
        assert "mfdmc-04": foyer_nb_personnes(entity_ref("urn:fr:rsa:case:mf-decret-minima-couple"), 2) { origin case_input; }
        assert "mfdmc-05": mois_droit(entity_ref("urn:fr:rsa:case:mf-decret-minima-couple"), @2024-09-01) { origin case_input; }
    }
    evaluate truth(fr.minima.ressources::mf_mois(entity_ref("urn:fr:rsa:case:mf-decret-minima-couple"), @2024-06-01, 953.565 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(fr.minima.ressources::mf_mois(entity_ref("urn:fr:rsa:case:mf-decret-minima-couple"), @2024-07-01, 953.565 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(fr.minima.ressources::mf_mois(entity_ref("urn:fr:rsa:case:mf-decret-minima-couple"), @2024-08-01, 953.565 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(fr.minima.ressources::mf_composition(entity_ref("urn:fr:rsa:case:mf-decret-minima-couple"), 2, 953.565 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
