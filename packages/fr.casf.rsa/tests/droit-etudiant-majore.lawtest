// Student with the lone-parent increase: the L.262-4 3°-4° bar does
// not apply (L.262-4; L.262-9). Base 600.00, no resources -> quarterly
// amount DUE 600.00, entitlement open. The upstream input is the due
// itself (R. 262-7 I), not retained resources (D-26, D-44: the old
// 0 EUR input read the due as resources).
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-droit-etudiant-majore" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2025-06-15T12:00:00Z; knowledge_time @2025-06-15T12:00:00Z; legal_time @2025-06-15; timezone "Europe/Paris"; }
        assert "etumaj-01": mf_base(entity_ref("urn:fr:rsa:case:droit-etudiant-majore"), 600.00 EUR) { origin case_input; }
        assert "etumaj-02": foyer_nb_personnes(entity_ref("urn:fr:rsa:case:droit-etudiant-majore"), 1) { origin case_input; }
        assert "etumaj-03": mois_droit(entity_ref("urn:fr:rsa:case:droit-etudiant-majore"), @2025-04-01) { origin case_input; }
        assert "etumaj-04": residence_stable(entity_ref("urn:fr:rsa:case:droit-etudiant-majore")) { origin case_input; }
        assert "etumaj-05": age_charge_condition(entity_ref("urn:fr:rsa:case:droit-etudiant-majore")) { origin case_input; }
        assert "etumaj-06": sejour_travail_condition(entity_ref("urn:fr:rsa:case:droit-etudiant-majore")) { origin case_input; }
        assert "etumaj-07": conjoint_enfants_comptes(entity_ref("urn:fr:rsa:case:droit-etudiant-majore")) { origin case_input; }
        assert "etumaj-08": etudiant_conge(entity_ref("urn:fr:rsa:case:droit-etudiant-majore")) { origin case_input; }
        assert "etumaj-09": isole_majore(entity_ref("urn:fr:rsa:case:droit-etudiant-majore")) { origin case_input; }
        assert "etumaj-10": fr.minima.ressources::montant_du_trimestre(entity_ref("urn:fr:rsa:case:droit-etudiant-majore"), 600.00 EUR) { origin case_input; }
    }
    evaluate truth(droit_rsa(entity_ref("urn:fr:rsa:case:droit-etudiant-majore"), @2025-04-01));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
