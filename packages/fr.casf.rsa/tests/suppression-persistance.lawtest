// Persistence at the end of the suspension, team heard with an
// opinion: removal decided (L.262-37, II 1° ; R.262-69-2 ; L.262-39).
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-suppression-persistance" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2025-07-15T12:00:00Z; knowledge_time @2025-07-15T12:00:00Z; legal_time @2025-07-15; timezone "Europe/Paris"; }
        assert "suppr-01": manquement_persiste(entity_ref("urn:fr:rsa:case:suppression-persistance"), NON_RESPECT_CONTRAT) { origin case_input; }
        assert "suppr-02": notification_10j(entity_ref("urn:fr:rsa:case:suppression-persistance")) { origin case_input; }
        assert "suppr-03": audition_equipe(entity_ref("urn:fr:rsa:case:suppression-persistance")) { origin case_input; }
        assert "suppr-04": avis_equipe(entity_ref("urn:fr:rsa:case:suppression-persistance")) { origin case_input; }
        assert "suppr-05": tenu_obligations_262_28(entity_ref("urn:fr:rsa:case:suppression-persistance")) { origin case_input; }
    }
    evaluate truth(sanction_suppression(entity_ref("urn:fr:rsa:case:suppression-persistance"), NON_RESPECT_CONTRAT));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
