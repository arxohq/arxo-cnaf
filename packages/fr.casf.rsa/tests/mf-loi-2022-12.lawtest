// Window 2022-07..2023-03, mid-window (reading MfJuillet2022ArrondiCentime): same built
// base 598.54 for December 2022.
language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

test "urn:query:fr-rsa-mf-loi-2022-12" {
    given {
        context { deadline_policy RSA_MOIS; decision_time @2022-12-15T12:00:00Z; knowledge_time @2022-12-15T12:00:00Z; legal_time @2022-12-15; timezone "Europe/Paris"; interpretation MfJuillet2022ArrondiCentime; }
        assert "mfl-12-01": mois_droit(entity_ref("urn:fr:rsa:case:mf-loi-2022-12"), @2022-12-01) { origin case_input; }
        assert "mfl-12-02": foyer_nb_personnes(entity_ref("urn:fr:rsa:case:mf-loi-2022-12"), 1) { origin case_input; }
    }
    evaluate truth(mf_menage(entity_ref("urn:fr:rsa:case:mf-loi-2022-12"), 598.54 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
