// Shared surface of the package: case facts and predicates for the RSA
// right, the flat-rate amount, the lone-parent increase, duties,
// suspension and recovery. The quarterly amount due (monthly intermediate
// amounts averaged per R. 262-7 I) is computed by fr.minima.ressources
// (same wave 4 lane) and arrives qualified as montant_du_trimestre; it
// is consumed here AS the due, never subtracted again (D-26, D-44).
// NOTHING owned by a neighbour package is redefined here.
//
// Module map:
//   01-sources.law    - CASF / Code du travail / decree 2025-478 sources,
//                       the six MF revaluation decrees 2020-2025 (art. 1) and
//                       art. 9 of law 2022-1158 (coefficient 1.04),
//                       back-to-back editions, fragments (generated)
//   02-montant.law    - L.262-2/3/4/5/6/9, R.262-1/2/39: right, MF base built
//                       from the pinned decrees, MF by composition,
//                       lone-parent increase, allocation, MF written into
//                       fr.minima.ressources (mf_mois, mf_composition)
//   03-devoirs.law    - L.262-27/28/29/30/31/34, C.trav. L.5411-6: contract,
//                       15 hours, registration, orientation
//   04-suspension.law - L.262-37/38/39, R.262-68(-1..-7)/69(-1..-8), decree
//                       2025-478 art.12: scales, procedure, end of right
//   05-recouvrement.law - L.262-45/46/47, R.262-88/89/90/92/92-1/93/94/94-1:
//                       prescription, recovery, appeals
//   06-jeunes-activite.law - D.262-25-1/25-2/25-3/25-4: young-worker hours
//                       condition (18-25, L.262-7-1 scope)
//   07-demandes-instruction.law - D.262-26/27/28/29/30: filing venues,
//                       France Travail instruction, free instruction,
//                       quality engagement, delegation scope
//   08-conventions.law - D.262-61/62/63/64: department-body conventions,
//                       monthly advances, control plan, no-convention
//                       fallback (rate, deadlines)
//   09-devoirs-insertion.law - D.262-65/65-2/65-2-1/73: 500 EUR duties
//                       limb, France Travail orientation, 12-month
//                       extension, re-orientation proposal
//   10-controle-recours.law - D.262-77/94-2: professional-assets ceiling,
//                       recovery bridge to CSS D.553
//   11-statistiques.law - D.262-95/96/97/98/100: annual, quarterly and
//                       L.262-55 data transmissions, regular publication
//                       (D.262-99 ministerial lists: boundary,
//                       B-RSA-ARRETE-LISTES)
//   bareme/*.lawparam.json - percentages and euro thresholds (generated)
//
// SCOPE BOUNDARY. Metropolitan France and the DOM collectivities under
// the same text; L.542-/R.542- adaptations are wave 7 (SANS_OWNER).
// Outside: DSN extraction, the L.262-2 euro base outside the pinned decree
// series (from 2026-04-01: B-RSA-MF-EURO, DSS_PENDING; a case-supplied mf_base
// stays the input there; the window 2022-07..2023-03 is bridged by art. 9 of law
// 2022-1158 under the reading MfJuillet2022ArrondiCentime), the experiment
// of décret 2024-693 (B-RSA-EXPERIMENTATION-2024), the housing-aid euro figure
// (APL-FORFAIT-PENDING), PF benefit amounts (B-RSA-PF-CASCADE), the PA
// quarter (CNAF-PPA), Mayotte specifics (wave 7). Full list - README.

language "law.core" version "0.2";
package fr.casf.rsa version "0.1.0";
namespace "urn:fr:corpus:clir:rsa";

import fr.minima.ressources version "0.1.0";

// The household reference person is fr.minima.ressources::Personne (same
// wave 4 lane: the RSA amount runs on the quarterly resources computed
// there; pf-cf pattern: downstream reuses the upstream entity, nothing
// owned by the neighbour is redefined here).

// --- Amount case inputs (empirical) ---

pub relation mf_base(p: fr.minima.ressources::Personne, montant: Money) kind empirical {
    key(p);
    label fr official "base mensuelle personne seule L. 262-2 retenue pour l'espèce, décret et revalorisation du 1er avril pré-appliqués par la caisse (B-RSA-MF-EURO, DSS_PENDING)";
    label en unofficial "monthly single-person L. 262-2 base retained for the case, decree and 1 April revaluation pre-applied by the fund (B-RSA-MF-EURO, DSS_PENDING)";
}

pub relation foyer_nb_personnes(p: fr.minima.ressources::Personne, n: Integer) kind empirical {
    key(p);
    label fr official "nombre de personnes comptées pour le montant forfaitaire (R. 262-1)";
    label en unofficial "number of persons counted for the flat-rate amount (R. 262-1)";
}

pub relation foyer_nb_parents(p: fr.minima.ressources::Personne, n: Integer) kind empirical {
    key(p);
    label fr official "nombre de parents dans le foyer, 1 ou 2 (distingue le taux de la 4e personne, R. 262-1)";
    label en unofficial "number of parents in the household, 1 or 2 (sets the 4th-person rate, R. 262-1)";
}

pub relation foyer_sup_taux40(p: fr.minima.ressources::Personne, k: Integer) kind institutional {
    key(p);
    label fr official "parmi les personnes de rang 5 et au-delà, nombre d'enfants ou de moins de 25 ans ouvrant droit à 40 % (R. 262-1 ; les autres, à 30 %, vont à foyer_sup_taux30 ; k + m = n - 4)";
    label en unofficial "among persons ranked 5th and above, number of children or under-25s entitled to 40 % (R. 262-1; the rest at 30 % go to foyer_sup_taux30; k + m = n - 4)";
}

pub relation foyer_sup_taux30(p: fr.minima.ressources::Personne, m: Integer) kind institutional {
    key(p);
    label fr official "parmi les personnes de rang 5 et au-delà, nombre de personnes à 30 % (R. 262-1 ; m + k = n - 4 avec foyer_sup_taux40)";
    label en unofficial "among persons ranked 5th and above, number of persons at 30 % (R. 262-1; m + k = n - 4 with foyer_sup_taux40)";
}

pub relation foyer_membre_rang(p: fr.minima.ressources::Personne, membre: fr.minima.ressources::Personne, rang: Integer) kind empirical {
    key(p, membre);
    label fr official "membre compté dans le foyer et son rang établi pour le barème R. 262-1";
    label en unofficial "counted household member and established rank for the R. 262-1 scale";
}

pub relation foyer_enfant_charge(p: fr.minima.ressources::Personne, enfant: fr.minima.ressources::Personne) kind empirical {
    label fr official "enfant à charge du foyer compté dans le barème R. 262-1";
    label en unofficial "dependent child counted in the household under R. 262-1";
}

pub relation foyer_autre_charge(p: fr.minima.ressources::Personne, personne: fr.minima.ressources::Personne) kind empirical {
    label fr official "autre personne à charge du foyer comptée dans le barème R. 262-1";
    label en unofficial "other dependent person counted in the household under R. 262-1";
}

pub relation foyer_naissance(p: fr.minima.ressources::Personne, personne: fr.minima.ressources::Personne, jour: Date) kind empirical {
    key(p, personne);
    label fr official "date de naissance établie de la personne à charge pour la limite de vingt-cinq ans (R. 262-1)";
    label en unofficial "established dependent person's birth date for the age-25 limit (R. 262-1)";
}

// --- Lone-parent increase case inputs (empirical) ---

pub relation isole_majore(p: fr.minima.ressources::Personne) kind empirical {
    label fr official "personne isolée au sens de L. 262-9 (veuve, divorcée, séparée ou célibataire, ne vivant pas notoirement et durablement en couple) assumant la charge d'enfants ou enceinte déclarée";
    label en unofficial "lone person under L. 262-9 (widowed, divorced, separated or single, not living as a couple) with dependent children or declared pregnancy";
}

pub relation majore_nb_enfants(p: fr.minima.ressources::Personne, n: Integer) kind institutional {
    key(p);
    label fr official "nombre d'enfants et autres personnes à charge pour le supplément majoré de 42,804 % (R. 262-1 al. 2 ; grossesse sans enfant : 0)";
    label en unofficial "number of children and other dependent persons for the 42.804 % increase supplement (R. 262-1 para. 2; pregnancy without a child: 0)";
}

pub relation majore_retard_mois(p: fr.minima.ressources::Personne, r: Integer) kind empirical {
    key(p);
    label fr official "mois de retard de la demande majorée au-delà du délai de six mois du fait générateur (R. 262-2 al. 1 ; 0 si dans les délais)";
    label en unofficial "months by which the increased-amount claim missed the six-month window from the triggering event (R. 262-2 al. 1; 0 if on time)";
}

pub relation majore_prolonge_3ans(p: fr.minima.ressources::Personne) kind institutional {
    label fr official "prolongation de la majoration jusqu'aux trois ans du plus jeune enfant (R. 262-2 al. 2)";
    label en unofficial "extension of the increase until the youngest child's third birthday (R. 262-2 al. 2)";
}

pub relation majore_terme_3ans(p: fr.minima.ressources::Personne, terme: Date) kind institutional {
    key(p);
    label fr official "terme de la prolongation : mois des trois ans du plus jeune enfant (R. 262-2 al. 2)";
    label en unofficial "end of the extension: month of the youngest child's third birthday (R. 262-2 al. 2)";
}

// --- Right case inputs (empirical) ---

pub relation mois_droit(p: fr.minima.ressources::Personne, mois: Date) kind empirical {
    key(p, mois);
    label fr official "mois du droit examiné (pf-cf pattern : le mois lie les règles mensuelles)";
    label en unofficial "month of right under examination (pf-cf pattern: the month binds the monthly rules)";
}

pub relation residence_stable(p: fr.minima.ressources::Personne) kind empirical {
    label fr official "résidence stable et effective en France (L. 262-2 ; R. 262-5 : séjours hors de France n'excédant pas trois mois)";
    label en unofficial "stable and effective residence in France (L. 262-2; R. 262-5: stays abroad up to three months)";
}

pub relation age_charge_condition(p: fr.minima.ressources::Personne) kind empirical {
    label fr official "plus de 25 ans ou charge d'enfants nés ou à naître (L. 262-4, 1°)";
    label en unofficial "over 25 or with dependent born or unborn children (L. 262-4, 1°)";
}

pub relation sejour_travail_condition(p: fr.minima.ressources::Personne) kind empirical {
    label fr official "conditions de nationalité, séjour et travail remplies, cas d'exemption inclus : L. 262-4 2° (cinq ans, réfugiés, protection subsidiaire, apatrides, résidents), régularité L. 512-2 pour les majorés, et L. 262-6 pour les UE/EEE/Suisse (droit au séjour, trois mois, exceptions d'activité, exclusion du chercheur d'emploi entré à ce titre)";
    label en unofficial "nationality, residence and work conditions met, exemptions included: L. 262-4 2° (five years, refugees, subsidiary protection, stateless, residents), L. 512-2 regularity for increased-amount cases, and L. 262-6 for EU/EEA/Swiss nationals (right of residence, three months, activity exceptions, jobseeker-entry exclusion)";
}

pub relation etudiant_conge(p: fr.minima.ressources::Personne) kind empirical {
    label fr official "élève, étudiant, stagiaire, ou en congé parental/sabbatique/sans solde/disponibilité (L. 262-4, 3°-4°, sauf majoration L. 262-9)";
    label en unofficial "pupil, student, trainee, or on parental/sabbatical/unpaid leave (L. 262-4, 3°-4°, except L. 262-9 increase)";
}

pub relation conjoint_enfants_comptes(p: fr.minima.ressources::Personne) kind empirical {
    label fr official "conjoint/concubin/partenaire remplit les 2° et 4° de L. 262-4 et enfants étrangers la régularité L. 512-2 CSS (L. 262-5)";
    label en unofficial "spouse/partner meets L. 262-4 2° and 4° and foreign children meet CSS L. 512-2 regularity (L. 262-5)";
}

pub relation isolement_constate(p: fr.minima.ressources::Personne) kind empirical {
    label fr official "absence de vie en couple notoire et permanente établie pour la personne (L. 262-9)";
    label en unofficial "person's absence of a public and lasting couple established (L. 262-9)";
}

pub relation majore_demande_mois(p: fr.minima.ressources::Personne, mois: Date) kind empirical {
    key(p);
    label fr official "mois de dépôt de la demande de majoration, établi par la caisse (R. 262-2)";
    label en unofficial "month when the claim for the increase was filed, established by the fund (R. 262-2)";
}

pub relation majore_debut_mois(p: fr.minima.ressources::Personne, debut: Date) kind institutional {
    key(p);
    label fr official "premier mois de service de l'allocation majorée (point de départ de la durée R. 262-2)";
    label en unofficial "first month of increased-allowance service (start of the R. 262-2 duration)";
}

// --- Duties case inputs (empirical) ---

pub relation contrat_signe(p: fr.minima.ressources::Personne) kind empirical {
    label fr official "contrat d'engagement L. 5411-6 / L. 262-34 élaboré et signé avec l'organisme référent";
    label en unofficial "L. 5411-6 / L. 262-34 engagement contract drawn up and signed with the referring body";
}

pub relation contrat_heures(p: fr.minima.ressources::Personne, h: Integer) kind empirical {
    key(p);
    label fr official "durée hebdomadaire d'activité du plan d'action en heures (L. 5411-6, II 3° : au moins quinze, minorable sans être nulle, absente sur demande motivée)";
    label en unofficial "weekly activity hours of the action plan (L. 5411-6, II 3°: at least fifteen, reducible but not zero, waived on reasoned request)";
}

pub relation dispense_heures(p: fr.minima.ressources::Personne) kind empirical {
    label fr official "plan d'action sans durée hebdomadaire sur demande : santé, handicap, invalidité ou parent isolé sans garde d'enfant de moins de douze ans (L. 5411-6, II 3°)";
    label en unofficial "action plan without weekly hours on request: health, disability, invalidity or lone parent with no childcare for a child under twelve (L. 5411-6, II 3°)";
}

pub relation minoration_justifiee(p: fr.minima.ressources::Personne) kind empirical {
    label fr official "minoration de la durée hebdomadaire justifiée par la situation individuelle au vu du diagnostic global (L. 5411-6, II 3°)";
    label en unofficial "weekly-hours reduction justified by the individual situation in light of the global diagnosis (L. 5411-6, II 3°)";
}

pub relation inscrit_france_travail(p: fr.minima.ressources::Personne) kind empirical {
    label fr official "inscription sur la liste des demandeurs d'emploi auprès de France Travail (L. 262-27 al. 2)";
    label en unofficial "registration on the jobseeker list with France Travail (L. 262-27 al. 2)";
}

pub relation tenu_obligations_262_28(p: fr.minima.ressources::Personne) kind empirical {
    label fr official "tenu aux obligations de l'article L. 262-28 (sanctionnable au titre de R. 262-68 à R. 262-68-2 ; R. 262-68-7 a contrario)";
    label en unofficial "bound by the L. 262-28 obligations (sanctionable under R. 262-68 to R. 262-68-2; R. 262-68-7 a contrario)";
}

pub relation motif_legitime(p: fr.minima.ressources::Personne) kind empirical {
    label fr official "motif légitime du manquement (fait obstacle aux sanctions L. 262-37 et R. 262-68 à R. 262-68-3)";
    label en unofficial "legitimate reason for the breach (bars the L. 262-37 and R. 262-68 to R. 262-68-3 sanctions)";
}

// --- Sanction case inputs (empirical) ---

pub enum MotifSanction {
    label fr official "manquement fondant une sanction (L. 262-37)";
    label en unofficial "breach founding a sanction (L. 262-37)";
    REFUS_CONTRAT,
    NON_RESPECT_CONTRAT,
    REFUS_CONTROLE,
    REFUS_OFFRE_RAISONNABLE
}

pub relation manquement(p: fr.minima.ressources::Personne, motif: MotifSanction) kind empirical {
    label fr official "manquement constaté aux obligations du contrat ou aux contrôles (le motif légitime, s'il est établi, fait obstacle aux sanctions ; L. 262-37, I-II)";
    label en unofficial "breach of the contract obligations or controls found (an established legitimate reason bars the sanctions; L. 262-37, I-II)";
}

pub relation suspension_duree_mois(p: fr.minima.ressources::Personne, d: Integer) kind empirical {
    key(p);
    label fr official "durée de la suspension fixée par la décision, en mois (L. 262-37, I ; R. 262-68 à R. 262-68-1 : un à deux mois, un à quatre en persistance ou réitération)";
    label en unofficial "suspension length set by the decision, in months (L. 262-37, I; R. 262-68 to R. 262-68-1: one to two months, one to four on persistence or repetition)";
}

pub relation suppression_totale_4mois(p: fr.minima.ressources::Personne) kind empirical {
    label fr official "suppression totale de l'allocation pour quatre mois décidée (R. 262-68 à R. 262-68-3 : proposition de radiation et fin du droit à défaut de mise en conformité)";
    label en unofficial "total four-month removal of the allowance decided (R. 262-68 to R. 262-68-3: removal proposal and end of entitlement absent compliance)";
}

pub relation radiation_sans_versement(p: fr.minima.ressources::Personne) kind empirical {
    label fr official "période définie par décret sans versement écoulée (L. 262-38 al. 1 : radiation de la liste)";
    label en unofficial "decree-defined payment-free period elapsed (L. 262-38 al. 1: removal from the list)";
}

pub relation proposition_france_travail(p: fr.minima.ressources::Personne, motif: MotifSanction) kind empirical {
    label fr official "proposition de suspension ou suppression transmise par l'opérateur France Travail, organisme référent (L. 262-37, IV ; R. 262-69-7)";
    label en unofficial "suspension or removal proposal sent by France Travail as referring body (L. 262-37, IV; R. 262-69-7)";
}

pub relation notification_ft(p: fr.minima.ressources::Personne) kind empirical {
    label fr official "information de l'opérateur France Travail sur les faits, la sanction et la proposition, observations recueillies (L. 262-37, IV ; R. 262-69-5)";
    label en unofficial "France Travail notice of the facts, sanction and proposal, observations collected (L. 262-37, IV; R. 262-69-5)";
}

pub relation reprise_president(p: fr.minima.ressources::Personne) kind empirical {
    label fr official "le président du conseil départemental entend statuer lui-même dans les quinze jours de la proposition (L. 262-37, IV ; R. 262-69-6)";
    label en unofficial "the departmental council president takes the case over within fifteen days of the proposal (L. 262-37, IV; R. 262-69-6)";
}

pub relation sanction_allocation_reference(p: fr.minima.ressources::Personne, montant: Money) kind empirical {
    key(p);
    label fr official "allocation à verser au titre du dernier mois du trimestre de référence, assiette transitoire de la sanction (décret 2025-478 art. 12, I)";
    label en unofficial "allowance due for the last month of the reference quarter, transitional sanction base (decree 2025-478 art. 12, I)";
}

pub relation manquement_persiste(p: fr.minima.ressources::Personne, motif: MotifSanction) kind empirical {
    label fr official "persistance du manquement au terme de la suspension (L. 262-37, II 1° ; R. 262-68-4)";
    label en unofficial "persistence of the breach at the end of the suspension (L. 262-37, II 1°; R. 262-68-4)";
}

pub relation manquement_reitere(p: fr.minima.ressources::Personne, motif: MotifSanction) kind empirical {
    label fr official "réitération dans les vingt-quatre mois de la notification de la première sanction (L. 262-37, II 2° ; R. 262-68-4)";
    label en unofficial "repeated breach within twenty-four months of the first sanction notice (L. 262-37, II 2°; R. 262-68-4)";
}

pub relation suspension_duree_conforme(p: fr.minima.ressources::Personne) kind institutional {
    label fr official "durée de suspension dans les bornes du décret (un à deux mois, un à quatre en cas de persistance ou réitération ; R. 262-68 ; R. 262-68-1)";
    label en unofficial "suspension duration within the decree bounds (one to two months, one to four on persistence or repetition; R. 262-68; R. 262-68-1)";
}

pub relation notification_10j(p: fr.minima.ressources::Personne) kind empirical {
    label fr official "notification préalable des faits, de la sanction envisagée et du délai de dix jours pour observations (R. 262-69-1)";
    label en unofficial "prior notice of the facts, the planned sanction and the ten-day window for observations (R. 262-69-1)";
}

pub relation audition_equipe(p: fr.minima.ressources::Personne) kind empirical {
    label fr official "possibilité d'être entendu par l'équipe pluridisciplinaire offerte, délai d'un mois (R. 262-69-2, suppression)";
    label en unofficial "hearing by the multidisciplinary team offered, one-month window (R. 262-69-2, removal)";
}

pub relation avis_equipe(p: fr.minima.ressources::Personne) kind empirical {
    label fr official "avis de l'équipe pluridisciplinaire recueilli avant suppression (L. 262-37, III ; L. 262-39)";
    label en unofficial "multidisciplinary team opinion obtained before removal (L. 262-37, III; L. 262-39)";
}

pub relation mise_en_conformite(p: fr.minima.ressources::Personne) kind empirical {
    label fr official "bénéficiaire mis en conformité avant le terme de la suspension (fin de suspension, L. 262-37, I ; R. 262-68/68-1)";
    label en unofficial "claimant back in compliance before the suspension ends (suspension lifted, L. 262-37, I; R. 262-68/68-1)";
}

pub relation sanction_taux(p: fr.minima.ressources::Personne, taux: Decimal) kind empirical {
    key(p);
    label fr official "taux de suspension ou suppression fixé par la décision de sanction (au moins 30 %, R. 262-68 ; 50 % maximum en foyer pluripersonnel, R. 262-68-6 ; période transitoire décret 2025-478 art. 12)";
    label en unofficial "suspension or removal rate set by the sanction decision (at least 30 %, R. 262-68; 50 % cap in multi-person households, R. 262-68-6; decree 2025-478 art. 12 transition)";
}

// --- Recovery case inputs (empirical) ---

pub relation indu_montant(p: fr.minima.ressources::Personne, montant: Money) kind empirical {
    key(p);
    label fr official "montant de l'allocation indûment versée dont le recouvrement est envisagé (L. 262-46 ; R. 262-92-1)";
    label en unofficial "amount of the unduly paid allowance whose recovery is considered (L. 262-46; R. 262-92-1)";
}

pub relation indu_fraude(p: fr.minima.ressources::Personne) kind empirical {
    label fr official "indu résultant d'une fraude ou fausse déclaration (pas de prescription biennale, L. 262-45 ; indemnité 10 %, L. 262-46)";
    label en unofficial "overpayment from fraud or false declaration (no two-year limit, L. 262-45; 10 % indemnity, L. 262-46)";
}

pub relation prescription_cours(p: fr.minima.ressources::Personne, annees: Integer) kind empirical {
    key(p);
    label fr official "années écoulées depuis le paiement indu (prescription biennale, L. 262-45 al. 1)";
    label en unofficial "years since the undue payment (two-year limitation, L. 262-45 al. 1)";
}

pub relation interruption_prescription(p: fr.minima.ressources::Personne) kind empirical {
    label fr official "cause d'interruption de la prescription : code civil ou recommandé avec avis de réception (L. 262-45 al. 2)";
    label en unofficial "ground interrupting the limitation: civil-code cause or registered letter with acknowledgement (L. 262-45 al. 2)";
}

pub relation recours_suspensif(p: fr.minima.ressources::Personne) kind empirical {
    label fr official "réclamation, remise, recours administratif ou contentieux en cours contre la récupération (caractère suspensif, L. 262-46 al. 2 ; recours préalable L. 262-47, R. 262-88)";
    label en unofficial "ongoing claim, remission request, administrative or court appeal against the recovery (suspensive, L. 262-46 al. 2; prior appeal L. 262-47, R. 262-88)";
}

pub relation notification_indu(p: fr.minima.ressources::Personne) kind empirical {
    label fr official "notification d'indu avec nature, date, montant, motif, voies de recours et délai de rectification de vingt jours (R. 262-92-1, I)";
    label en unofficial "overpayment notice with nature, date, amount, reason, appeal routes and twenty-day rectification window (R. 262-92-1, I)";
}

// --- Derived outputs (institutional) ---

pub relation mf_menage(p: fr.minima.ressources::Personne, montant: Money) kind institutional {
    key(p);
    label fr official "montant forfaitaire du foyer, composition R. 262-1 appliquée à la base (hors majoration isolement)";
    label en unofficial "household flat-rate amount, R. 262-1 composition applied to the base (before the lone-parent increase)";
}

pub relation majore_ouvert_mois(p: fr.minima.ressources::Personne, mois: Date) kind institutional {
    key(p, mois);
    label fr official "majoration servie pour le mois : dans la durée R. 262-2 ou la prolongation trois ans";
    label en unofficial "increase in service for the month: within the R. 262-2 duration or the three-year extension";
}

pub relation mf_applicable_mois(p: fr.minima.ressources::Personne, mois: Date, montant: Money) kind institutional {
    key(p, mois);
    label fr official "montant forfaitaire applicable au mois : majoré si ouvert, composition sinon (L. 262-2)";
    label en unofficial "flat-rate amount for the month: increased if open, composition otherwise (L. 262-2)";
}

pub relation mf_composition(p: fr.minima.ressources::Personne, taille: Integer, montant: Money) kind institutional {
    key(p, taille);
    label fr official "montant forfaitaire par taille de foyer (R. 262-1), repris par fr.minima.ressources ; contrat d'entrée (1, 2, 3 ou plus)";
    label en unofficial "flat-rate amount by household size (R. 262-1), reused by fr.minima.ressources; input contract (1, 2, 3 or more)";
}

pub relation mf_majore(p: fr.minima.ressources::Personne, montant: Money) kind institutional {
    key(p);
    label fr official "montant forfaitaire majoré personne isolée (128,412 % + 42,804 % par enfant, R. 262-1 al. 2 ; L. 262-9)";
    label en unofficial "increased lone-parent flat-rate amount (128.412 % + 42.804 % per child, R. 262-1 al. 2; L. 262-9)";
}

pub relation majore_duree_mois(p: fr.minima.ressources::Personne, duree: Integer) kind institutional {
    key(p);
    label fr official "durée de service de l'allocation majorée en mois : douze moins le retard au-delà de six mois (R. 262-2 al. 1), sauf prolongation trois ans (R. 262-2 al. 2)";
    label en unofficial "months of increased-allowance service: twelve minus the delay beyond six months (R. 262-2 al. 1), unless extended to three years (R. 262-2 al. 2)";
}

pub relation droit_rsa(p: fr.minima.ressources::Personne, mois: Date) kind institutional {
    label fr official "droit au revenu de solidarité active ouvert pour le mois (montant dû trimestriel positif, conditions L. 262-2 et L. 262-4 à L. 262-6 ; dû > 0 vaut ressources < MF, R. 262-7 I)";
    label en unofficial "RSA entitlement open for the month (positive quarterly amount due, L. 262-2 and L. 262-4 to L. 262-6 conditions; due > 0 stands for resources < MF, R. 262-7 I)";
}

pub relation allocation_mensuelle(p: fr.minima.ressources::Personne, mois: Date, montant: Money) kind institutional {
    key(p, mois);
    label fr official "allocation mensuelle : montant dû du trimestre de référence (L. 262-2 al. 2 ; R. 262-7 I), servie à partir de 6 € (R. 262-39)";
    label en unofficial "monthly allowance: amount due for the reference quarter (L. 262-2 al. 2; R. 262-7 I), paid from 6 euros up (R. 262-39)";
}

pub relation allocation_non_versee(p: fr.minima.ressources::Personne, mois: Date) kind institutional {
    label fr official "allocation calculée sous 6 € : non versée (R. 262-39)";
    label en unofficial "allowance computed below 6 euros: not paid (R. 262-39)";
}

pub relation contrat_heures_conforme(p: fr.minima.ressources::Personne) kind institutional {
    label fr official "durée hebdomadaire du plan d'action conforme : au moins quinze heures ou minoration/dispense applicable (L. 5411-6, II 3°)";
    label en unofficial "action-plan weekly hours compliant: at least fifteen hours or an applicable reduction/waiver (L. 5411-6, II 3°)";
}

pub relation accompagnement_adapte(p: fr.minima.ressources::Personne) kind institutional {
    label fr official "droit à un accompagnement social et professionnel adapté, référent unique (L. 262-27 al. 1 ; L. 262-30)";
    label en unofficial "right to adapted social and professional support with a single referrer (L. 262-27 al. 1; L. 262-30)";
}

pub relation sanction_taux_conforme(p: fr.minima.ressources::Personne) kind institutional {
    label fr official "taux de sanction régulier : au moins 30 % (R. 262-68), au plus 50 % en foyer pluripersonnel ou majoré (R. 262-68-6)";
    label en unofficial "regular sanction rate: at least 30 % (R. 262-68), at most 50 % in a multi-person or increased-amount household (R. 262-68-6)";
}

pub relation sanction_montant_mensuel(p: fr.minima.ressources::Personne, montant: Money) kind institutional {
    key(p);
    label fr official "montant mensuel suspendu ou supprimé en période transitoire : taux appliqué à l'allocation du dernier mois du trimestre de référence (décret 2025-478 art. 12, I)";
    label en unofficial "monthly amount suspended or removed in the transition: rate applied to the last reference-quarter month's allowance (decree 2025-478 art. 12, I)";
}

pub relation sanction_suspension(p: fr.minima.ressources::Personne, motif: MotifSanction) kind institutional {
    label fr official "suspension du versement décidée, en tout ou partie (L. 262-37, I ; R. 262-68/68-1 ; taux plancher 30 %, plafond 50 % en foyer pluripersonnel)";
    label en unofficial "payment suspension decided, in whole or part (L. 262-37, I; R. 262-68/68-1; 30 % floor, 50 % cap in multi-person households)";
}

pub relation sanction_suppression(p: fr.minima.ressources::Personne, motif: MotifSanction) kind institutional {
    label fr official "suppression du versement décidée, en tout ou partie (L. 262-37, II ; R. 262-68-3 ; avis d'équipe et audition préalables)";
    label en unofficial "payment removal decided, in whole or part (L. 262-37, II; R. 262-68-3; prior team opinion and hearing)";
}

pub relation sommes_reverses_3mois(p: fr.minima.ressources::Personne, plafond_mois: Integer) kind institutional {
    key(p);
    label fr official "sommes retenues reversées sur mise en conformité : durée de suspension, trois derniers mois si elle excède trois mois (L. 262-37, VI ; 3 ou durée)";
    label en unofficial "withheld sums repaid on compliance: suspension length, last three months if longer (L. 262-37, VI; 3 or length)";
}

pub relation radiation_liste(p: fr.minima.ressources::Personne) kind institutional {
    label fr official "radiation de la liste des bénéficiaires (L. 262-38 ; R. 262-68/68-1/68-3, suppression totale de quatre mois sans mise en conformité)";
    label en unofficial "removal from the beneficiary list (L. 262-38; R. 262-68/68-1/68-3, four-month total removal without compliance)";
}

pub relation indu_recouvrable(p: fr.minima.ressources::Personne, montant: Money) kind institutional {
    key(p);
    label fr official "indu recouvrable : 77 € ou plus, prescription non acquise, aucun recours suspensif (L. 262-45 ; L. 262-46 ; R. 262-92)";
    label en unofficial "recoverable overpayment: 77 euros or more, limitation not reached, no suspensive appeal (L. 262-45; L. 262-46; R. 262-92)";
}

pub relation indu_non_recupere(p: fr.minima.ressources::Personne) kind institutional {
    label fr official "indu non récupéré : sous 77 € (R. 262-92), prescrit (L. 262-45), recours suspensif ou remise (L. 262-46)";
    label en unofficial "overpayment not recovered: below 77 euros (R. 262-92), time-barred (L. 262-45), suspensive appeal or remission (L. 262-46)";
}

pub relation remboursement_unique(p: fr.minima.ressources::Personne) kind empirical {
    label fr official "bénéficiaire optant pour le remboursement de l'indu en une seule fois (L. 262-46 al. 3)";
    label en unofficial "claimant opting for one-shot overpayment repayment (L. 262-46 al. 3)";
}

pub relation remise_president(p: fr.minima.ressources::Personne) kind empirical {
    label fr official "remise ou réduction de la créance par le président en cas de bonne foi ou précarité, hors fraude (L. 262-46)";
    label en unofficial "debt remission or reduction by the president for good faith or hardship, fraud excluded (L. 262-46)";
}

pub relation indemnite_fraude(p: fr.minima.ressources::Personne, montant: Money) kind institutional {
    key(p);
    label fr official "indemnité de 10 % des sommes réclamées en cas de fraude (L. 262-46 al. 1, depuis 2024-01-01)";
    label en unofficial "10 % indemnity on the sums claimed in case of fraud (L. 262-46 al. 1, from 2024-01-01)";
}

pub relation recouvrement_retenues_echeoir(p: fr.minima.ressources::Personne) kind institutional {
    label fr official "recouvrement par retenues sur les montants à échoir (L. 262-46 al. 3 ; R. 262-93/94)";
    label en unofficial "recovery by withholding from future payable amounts (L. 262-46 al. 3; R. 262-93/94)";
}

// --- Finish wave: administrative actors (06-11) ---

pub entity Organisme {
    label fr official "organisme administratif : service instructeur ou payeur (CAF, MSA), CCAS/CIAS, association déléguée, opérateur France Travail, caisse nationale, service statistique (rôle par relation)";
    label en unofficial "administrative body: instructing or paying service (CAF, MSA), CCAS/CIAS, delegated association, France Travail operator, national fund, statistical service (role per relation)";
}

pub entity Departement {
    label fr official "département, y compris son président du conseil départemental agissant pour lui (D. 262-29/30/61/63/64/95/98)";
    label en unofficial "department, including its departmental council president acting for it (D. 262-29/30/61/63/64/95/98)";
}

pub entity Referent {
    label fr official "référent unique du bénéficiaire (D. 262-73 ; L. 262-30)";
    label en unofficial "claimant's single referrer (D. 262-73; L. 262-30)";
}

pub entity Prefet {
    label fr official "représentant de l'Etat dans le département (D. 262-95)";
    label en unofficial "State representative in the department, the prefect (D. 262-95)";
}

// Case anchors: bind administrative bodies to the examined case.
pub relation organisme_competent(o: Organisme, p: fr.minima.ressources::Personne) kind empirical {
    label fr official "organisme compétent pour le dossier de la personne (ancrage du cas)";
    label en unofficial "body competent for the person's case (case anchor)";
}

pub relation departement_competent(d: Departement, p: fr.minima.ressources::Personne) kind empirical {
    label fr official "département compétent pour le dossier de la personne (ancrage du cas)";
    label en unofficial "department competent for the person's case (case anchor)";
}

pub relation referent_attribue(r: Referent, p: fr.minima.ressources::Personne) kind empirical {
    label fr official "référent attribué à la personne (D. 262-73)";
    label en unofficial "referrer assigned to the person (D. 262-73)";
}

pub relation prefet_du_departement(f: Prefet, d: Departement) kind empirical {
    label fr official "représentant de l'Etat dans le département destinataire des données annuelles (D. 262-95)";
    label en unofficial "State representative in the department receiving the annual data (D. 262-95)";
}

// Body roles (empirical).

pub relation est_ccas(o: Organisme) kind empirical {
    label fr official "centre communal ou intercommunal d'action sociale (D. 262-26 a))";
    label en unofficial "communal or intercommunal social action centre (D. 262-26 a))";
}

pub relation est_association_deleguee(o: Organisme) kind empirical {
    label fr official "association ou organisme à but non lucratif délégué (D. 262-26 c))";
    label en unofficial "delegated non-profit association or body (D. 262-26 c))";
}

pub relation est_organisme_service(o: Organisme) kind empirical {
    label fr official "organisme chargé du service du RSA, article L. 262-16 (D. 262-26 d))";
    label en unofficial "RSA service body, article L. 262-16 (D. 262-26 d))";
}

pub relation est_france_travail(o: Organisme) kind empirical {
    label fr official "opérateur France Travail, Pôle emploi avant le 01.07.2024 (D. 262-26 e), D. 262-27)";
    label en unofficial "France Travail operator, Pôle emploi before 01.07.2024 (D. 262-26 e), D. 262-27)";
}

pub relation est_caisse_nationale(o: Organisme) kind empirical {
    label fr official "Caisse nationale des allocations familiales ou Caisse centrale de la mutualité sociale agricole (D. 262-96/97/100)";
    label en unofficial "National family allowances fund or central agricultural mutual fund (D. 262-96/97/100)";
}

pub relation est_service_statistique(o: Organisme) kind empirical {
    label fr official "service statistique des ministères chargés de l'action sociale et de l'emploi (D. 262-95/96/97/98/100)";
    label en unofficial "statistical service of the social action and employment ministries (D. 262-95/96/97/98/100)";
}

