pub relation jeune_18_25(p: fr.minima.ressources::Personne) kind empirical {
    label fr official "demandeur âgé de dix-huit à vingt-cinq ans, champ du paragraphe 4 (L. 262-7-1)";
    label en unofficial "claimant aged eighteen to twenty-five, paragraph 4 scope (L. 262-7-1)";
}

