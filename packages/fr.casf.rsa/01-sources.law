NOTA: Conformément à l’article 7 du décret n° 2021-306 du 23 mars 2021, ces dispositions sont applicables aux indus notifiés à compter de l'entrée en vigueur dudit décret.
""";
    content_hash "sha256:2559ef09fbf8866ddf3a3e1d6b08a25452b3918d8ba47462bdeaeef4ee04ae77";
}

@id("urn:fr:corpus:clir:rsa#CASF_R262_93")
pub fragment CASF_R262_93 in CASF_ED2021_01 {
    kind article;
    locator "article/R262-93";
    text fr official """Article R262-93
Lorsque le débiteur d'un indu a cessé de percevoir le revenu de solidarité active puis en est à nouveau bénéficiaire, le payeur départemental peut procéder au recouvrement du titre de recettes par précompte sur les allocations à échoir.
""";
    content_hash "sha256:16a5a7fe381d2ac2cdd02d676311bb46fb948ab1ba329b029c708087186cde97";
}

