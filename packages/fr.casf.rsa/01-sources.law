@id("urn:fr:corpus:clir:rsa#CASF_R262_39")
pub fragment CASF_R262_39 in CASF_ED2021_01 {
    kind article;
    locator "article/R262-39";
    text fr official """Article R262-39
Le montant au-dessous duquel l'allocation n'est pas versée est fixé à 6 €.
""";
    content_hash "sha256:7f3d48bef54007d58abdb607246c94335a34e86de8da7c4cee27004d464b7f06";
}

