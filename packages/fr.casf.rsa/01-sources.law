pub fragment CASF_D262_94_2 in CASF_ED2021_01 {
    kind article;
    locator "article/D262-94-2";
    text fr official """Article D262-94-2
Les dispositions des articles D. 553-1, D. 553-2, D. 553-4 et D. 553-5 du code de la sécurité sociale sont applicables au recouvrement des indus de revenu de solidarité active.
""";
    content_hash "sha256:d2df47c24dd33cdfee95389a8e6cc9fade68ee571038fc49e7a7638e2cb25618";
}

