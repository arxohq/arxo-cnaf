@id("urn:fr:corpus:clir:rsa#CASF_R262_94")
pub fragment CASF_R262_94 in CASF_ED2021_01 {
    kind article;
    locator "article/R262-94";
    text fr official """Article R262-94
Lorsque l'organisme chargé du service du revenu de solidarité active recouvre un indu sur la prestation à échoir, les sommes correspondantes sont remboursées aux collectivités créancières au prorata des créances qu'elles détiennent.
""";
    content_hash "sha256:2f9e59a0068801a98d566dd8e30aa06f51c748e9032c87f6de83098acaaf9fd8";
}

