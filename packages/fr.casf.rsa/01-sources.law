@id("urn:fr:corpus:clir:rsa#CASF_D262_73")
pub fragment CASF_D262_73 in CASF_ED2021_01 {
    kind article;
    locator "article/D262-73";
    text fr official """Article D262-73
La durée de radiation mentionnée au troisième alinéa de l'article L. 262-30, au-delà de laquelle le référent doit proposer au président du conseil départemental une nouvelle orientation, est fixée à deux mois.
""";
    content_hash "sha256:3053a7210a17f388ea44605b52c8efbd158dcd7da31aaa00d34f2f77c6b471af";
}

