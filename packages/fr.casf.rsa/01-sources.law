@id("urn:fr:corpus:clir:rsa#CASF_D262_28")
pub fragment CASF_D262_28 in CASF_ED2021_01 {
    kind article;
    locator "article/D262-28";
    text fr official """Article D262-28
Les demandes de revenu de solidarité active sont instruites à titre gratuit par les services ou organismes auprès desquels elles ont été déposées.
""";
    content_hash "sha256:459ff80ae62767f81bd1500472d8e338250e4fadad146534aea3aabfafcfff53";
