@id("urn:fr:corpus:clir:rsa#CASF_R262_92")
pub fragment CASF_R262_92 in CASF_ED2021_01 {
    kind article;
    locator "article/R262-92";
    text fr official """Article R262-92
Le montant mentionné à l'article L. 262-46, au-dessous duquel l'allocation indûment versée ne donne pas lieu à récupération, est fixé à 77 €.
""";
    content_hash "sha256:c41837ab854acc5165f0183eebb9eff26df52336131f427b543c2aa6f5d726a4";
}

