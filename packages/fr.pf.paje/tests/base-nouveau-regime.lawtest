// New regime reaches the old cohort: same pre-2018 child, month of right
// 2021-05 — the 2018 wording governs from 01.04.2021: 400 × 0.4165 = 166.60 €.
// Pair — base-ancien-regime (2021-02 → 183.80 €).
language "law.core" version "0.2";
package fr.pf.paje version "0.1.0";
namespace "urn:fr:corpus:clir:pf-paje";

test "urn:query:fr-pf-paje-base-nouveau-regime" {
    given {
        context { decision_time @2021-05-15T12:00:00Z; knowledge_time @2021-05-15T12:00:00Z; legal_time @2021-05-15; timezone "Europe/Paris"; }
        assert "base-nr-01": enfant_en_charge(entity_ref("urn:fr:paje:case:base-nr"), entity_ref("urn:fr:paje:enfant:base-nr")) { origin case_input; }
        assert "base-nr-02": condition_age_base(entity_ref("urn:fr:paje:enfant:base-nr")) { origin adjudicated; }
        assert "base-nr-03": cohorte_enfant(entity_ref("urn:fr:paje:enfant:base-nr"), NE_AVANT_AVRIL_2018) { origin adjudicated; }
        assert "base-nr-04": ressources_annuelles(entity_ref("urn:fr:paje:case:base-nr"), 20000 EUR) { origin case_input; }
        assert "base-nr-05": plafond_base_taux_plein(entity_ref("urn:fr:paje:case:base-nr"), 30000 EUR) { origin case_input; }
        assert "base-nr-06": bmaf_applicable(entity_ref("urn:fr:paje:case:base-nr"), 400.00 EUR) { origin case_input; }
        assert "base-nr-07": mois_eligible_base(entity_ref("urn:fr:paje:case:base-nr"), entity_ref("urn:fr:paje:enfant:base-nr"), @2021-05-01) { origin adjudicated; }
    }
    evaluate truth(base_attribuee(entity_ref("urn:fr:paje:case:base-nr"), entity_ref("urn:fr:paje:enfant:base-nr"), 166.60 EUR, @2021-05-01));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
