// D. 532-1, lower inclusive boundary (RETURN 2026-10-08): sending on the
// established pregnancy-start day itself (2025-01-06, deadline 2025-04-14)
// is inside «les quatorze premières semaines» — on time. Pairs with
// declaration-grossesse-avant-debut (one day before start — NEITHER) and
// mirrors declaration-grossesse-limite (upper inclusive boundary).
language "law.core" version "0.2";
package fr.pf.paje version "0.1.0";
namespace "urn:fr:corpus:clir:pf-paje";

test "urn:query:fr-pf-paje-declaration-jour-debut" {
    given {
        context { decision_time @2025-01-10T12:00:00Z; knowledge_time @2025-01-10T12:00:00Z; legal_time @2025-01-10; timezone "Europe/Paris"; }
        assert "decl-start-01": attente_naissance(entity_ref("urn:fr:paje:case:decl-start"), entity_ref("urn:fr:paje:enfant:decl-start")) { origin case_input; }
        assert "decl-start-02": debut_grossesse(entity_ref("urn:fr:paje:case:decl-start"), entity_ref("urn:fr:paje:enfant:decl-start"), @2025-01-06) { origin adjudicated; }
        assert "decl-start-03": date_limite_declaration(entity_ref("urn:fr:paje:case:decl-start"), entity_ref("urn:fr:paje:enfant:decl-start"), @2025-04-14) { origin adjudicated; }
        assert "decl-start-04": declaration_grossesse_adressee(entity_ref("urn:fr:paje:case:decl-start"), entity_ref("urn:fr:paje:enfant:decl-start"), @2025-01-06) { origin adjudicated; }
    }
    evaluate truth(declaration_grossesse_en_delai(entity_ref("urn:fr:paje:case:decl-start"), entity_ref("urn:fr:paje:enfant:decl-start")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
