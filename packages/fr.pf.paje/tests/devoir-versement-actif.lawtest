// Deontics D1, active duty: awarded grant of 919.00 € +
// debtor fund. VerserPrimeDue position — ACTIVE.
language "law.core" version "0.2";
package fr.pf.paje version "0.1.0";
namespace "urn:fr:corpus:clir:pf-paje";

test "urn:query:fr-pf-paje-devoir-versement-actif" {
    given {
        context { decision_time @2025-07-15T12:00:00Z; knowledge_time @2025-07-15T12:00:00Z; legal_time @2025-07-15; timezone "Europe/Paris"; }
        assert "devoir-actif-01": attente_naissance(entity_ref("urn:fr:paje:case:devoir-actif"), entity_ref("urn:fr:paje:enfant:devoir-actif")) { origin case_input; }
        assert "devoir-actif-02": ressources_annuelles(entity_ref("urn:fr:paje:case:devoir-actif"), 20000 EUR) { origin case_input; }
        assert "devoir-actif-03": plafond_base_taux_plein(entity_ref("urn:fr:paje:case:devoir-actif"), 30000 EUR) { origin case_input; }
        assert "devoir-actif-04": bmaf_applicable(entity_ref("urn:fr:paje:case:devoir-actif"), 400.00 EUR) { origin case_input; }
        assert "devoir-actif-05": date_examen_situation(entity_ref("urn:fr:paje:case:devoir-actif"), entity_ref("urn:fr:paje:enfant:devoir-actif"), @2025-07-01) { origin adjudicated; }
        assert "devoir-actif-06": organisme_debiteur(entity_ref("urn:fr:paje:org:caisse"), entity_ref("urn:fr:paje:case:devoir-actif")) { origin case_input; }
    }
    evaluate positions();
    expect position(VerserPrimeDue, ACTIVE);
    expect evaluation_status == COMPUTED;
}
