// D. 532-1, boundary: sending on the deadline day itself (2025-04-14,
// the last day of the fourteen weeks) is still on time — «dans les
// quatorze premières semaines» is inclusive.
language "law.core" version "0.2";
package fr.pf.paje version "0.1.0";
namespace "urn:fr:corpus:clir:pf-paje";

test "urn:query:fr-pf-paje-declaration-limite" {
    given {
        context { decision_time @2025-04-14T12:00:00Z; knowledge_time @2025-04-14T12:00:00Z; legal_time @2025-04-14; timezone "Europe/Paris"; }
        assert "decl-lim-01": attente_naissance(entity_ref("urn:fr:paje:case:decl-lim"), entity_ref("urn:fr:paje:enfant:decl-lim")) { origin case_input; }
        assert "decl-lim-02": debut_grossesse(entity_ref("urn:fr:paje:case:decl-lim"), entity_ref("urn:fr:paje:enfant:decl-lim"), @2025-01-06) { origin adjudicated; }
        assert "decl-lim-03": date_limite_declaration(entity_ref("urn:fr:paje:case:decl-lim"), entity_ref("urn:fr:paje:enfant:decl-lim"), @2025-04-14) { origin adjudicated; }
        assert "decl-lim-04": declaration_grossesse_adressee(entity_ref("urn:fr:paje:case:decl-lim"), entity_ref("urn:fr:paje:enfant:decl-lim"), @2025-04-14) { origin adjudicated; }
    }
    evaluate truth(declaration_grossesse_en_delai(entity_ref("urn:fr:paje:case:decl-lim"), entity_ref("urn:fr:paje:enfant:decl-lim")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
