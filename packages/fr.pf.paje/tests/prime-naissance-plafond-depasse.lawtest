// Boundary pair: resources of 35841.01 € — one cent above the ceiling of
// 35841.00 € — no right (control — prime-naissance-plafond-egal).
language "law.core" version "0.2";
package fr.pf.paje version "0.1.0";
namespace "urn:fr:corpus:clir:pf-paje";

test "urn:query:fr-pf-paje-naissance-plafond-depasse" {
    given {
        context { decision_time @2025-07-15T12:00:00Z; knowledge_time @2025-07-15T12:00:00Z; legal_time @2025-07-15; timezone "Europe/Paris"; }
        assert "plafond-depasse-01": attente_naissance(entity_ref("urn:fr:paje:case:plafond-depasse"), entity_ref("urn:fr:paje:enfant:plafond-depasse")) { origin case_input; }
        assert "plafond-depasse-02": ressources_annuelles(entity_ref("urn:fr:paje:case:plafond-depasse"), 35841.01 EUR) { origin case_input; }
        assert "plafond-depasse-03": plafond_base_taux_plein(entity_ref("urn:fr:paje:case:plafond-depasse"), 30000 EUR) { origin case_input; }
        assert "plafond-depasse-04": bmaf_applicable(entity_ref("urn:fr:paje:case:plafond-depasse"), 400.00 EUR) { origin case_input; }
        assert "plafond-depasse-05": date_examen_situation(entity_ref("urn:fr:paje:case:plafond-depasse"), entity_ref("urn:fr:paje:enfant:plafond-depasse"), @2025-07-01) { origin adjudicated; }
    }
    evaluate truth(droit_prime_naissance(entity_ref("urn:fr:paje:case:plafond-depasse"), entity_ref("urn:fr:paje:enfant:plafond-depasse")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
