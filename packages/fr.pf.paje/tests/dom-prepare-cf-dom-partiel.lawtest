// L. 755-19, para. 3, PreParE side, part-time variant: Martinique
// household, employer-certified share up to 50% with sufficient prior
// activity (part-time PreParE right open), L. 755-16 complément familial
// served — the PreParE/CF cumulation is barred.
language "law.core" version "0.2";
package fr.pf.paje version "0.1.0";
namespace "urn:fr:corpus:clir:pf-paje";

test "urn:query:fr-pf-paje-dom-prepare-cf-dom-partiel" {
    given {
        context { decision_time @2025-07-15T12:00:00Z; knowledge_time @2025-07-15T12:00:00Z; legal_time @2025-07-15; timezone "Europe/Paris"; }
        assert "dom-prpa-01": territoire(entity_ref("urn:fr:paje:case:dom-prpa"), MARTINIQUE) { origin case_input; }
        assert "dom-prpa-02": menage_beneficiaire(entity_ref("urn:fr:paje:benef:dom-prpa"), entity_ref("urn:fr:paje:case:dom-prpa")) { origin case_input; }
        assert "dom-prpa-03": attestation_quotite(entity_ref("urn:fr:paje:benef:dom-prpa"), JUSQUA_50) { origin adjudicated; }
        assert "dom-prpa-04": activite_anterieure_suffisante(entity_ref("urn:fr:paje:benef:dom-prpa"), entity_ref("urn:fr:paje:enfant:dom-prpa")) { origin adjudicated; }
        assert "dom-prpa-05": condition_age_prepare(entity_ref("urn:fr:paje:enfant:dom-prpa")) { origin adjudicated; }
        assert "dom-prpa-06": cf_dom_l755_16_servi(entity_ref("urn:fr:paje:case:dom-prpa")) { origin adjudicated; }
    }
    evaluate truth(cumul_prepare_cf_dom_interdit(entity_ref("urn:fr:paje:benef:dom-prpa"), entity_ref("urn:fr:paje:enfant:dom-prpa")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
