// PreParE plein via unpaid training (L. 531-4, I, 1, para. 1, second
// branch): same amount, 386.48 €.
language "law.core" version "0.2";
package fr.pf.paje version "0.1.0";
namespace "urn:fr:corpus:clir:pf-paje";

test "urn:query:fr-pf-paje-prepare-formation" {
    given {
        context { decision_time @2025-07-15T12:00:00Z; knowledge_time @2025-07-15T12:00:00Z; legal_time @2025-07-15; timezone "Europe/Paris"; }
        assert "prepare-form-01": formation_non_remuneree(entity_ref("urn:fr:paje:benef:prepare-form"), entity_ref("urn:fr:paje:enfant:prepare-form")) { origin adjudicated; }
        assert "prepare-form-02": activite_anterieure_suffisante(entity_ref("urn:fr:paje:benef:prepare-form"), entity_ref("urn:fr:paje:enfant:prepare-form")) { origin adjudicated; }
        assert "prepare-form-03": condition_age_prepare(entity_ref("urn:fr:paje:enfant:prepare-form")) { origin adjudicated; }
        assert "prepare-form-04": menage_beneficiaire(entity_ref("urn:fr:paje:benef:prepare-form"), entity_ref("urn:fr:paje:case:prepare-form")) { origin case_input; }
        assert "prepare-form-05": bmaf_applicable(entity_ref("urn:fr:paje:case:prepare-form"), 400.00 EUR) { origin case_input; }
        assert "prepare-form-06": mois_eligible_prepare(entity_ref("urn:fr:paje:benef:prepare-form"), entity_ref("urn:fr:paje:enfant:prepare-form"), @2025-07-01) { origin adjudicated; }
    }
    evaluate truth(prepare_attribuee(entity_ref("urn:fr:paje:benef:prepare-form"), entity_ref("urn:fr:paje:enfant:prepare-form"), 386.48 EUR, @2025-07-01));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
