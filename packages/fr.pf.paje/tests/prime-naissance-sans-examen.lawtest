// R. 531-1: without examination of the situation (no date_examen) the grant
// is not awarded — right and amount present, no prime_attribuee.
language "law.core" version "0.2";
package fr.pf.paje version "0.1.0";
namespace "urn:fr:corpus:clir:pf-paje";

test "urn:query:fr-pf-paje-naissance-sans-examen" {
    given {
        context { decision_time @2025-07-15T12:00:00Z; knowledge_time @2025-07-15T12:00:00Z; legal_time @2025-07-15; timezone "Europe/Paris"; }
        assert "sans-examen-01": attente_naissance(entity_ref("urn:fr:paje:case:sans-examen"), entity_ref("urn:fr:paje:enfant:sans-examen")) { origin case_input; }
        assert "sans-examen-02": ressources_annuelles(entity_ref("urn:fr:paje:case:sans-examen"), 20000 EUR) { origin case_input; }
        assert "sans-examen-03": plafond_base_taux_plein(entity_ref("urn:fr:paje:case:sans-examen"), 30000 EUR) { origin case_input; }
        assert "sans-examen-04": bmaf_applicable(entity_ref("urn:fr:paje:case:sans-examen"), 400.00 EUR) { origin case_input; }
    }
    evaluate truth(prime_attribuee(entity_ref("urn:fr:paje:case:sans-examen"), entity_ref("urn:fr:paje:enfant:sans-examen"), 919.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
