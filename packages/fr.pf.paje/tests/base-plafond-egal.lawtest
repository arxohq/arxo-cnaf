// Ceiling pair, full rate: resources exactly at the full ceiling
// (30000 €) — «ne dépassent pas» includes equality → plein, 166.60 €.
language "law.core" version "0.2";
package fr.pf.paje version "0.1.0";
namespace "urn:fr:corpus:clir:pf-paje";

test "urn:query:fr-pf-paje-base-plafond-egal" {
    given {
        context { decision_time @2025-07-15T12:00:00Z; knowledge_time @2025-07-15T12:00:00Z; legal_time @2025-07-15; timezone "Europe/Paris"; }
        assert "base-egal-01": enfant_en_charge(entity_ref("urn:fr:paje:case:base-egal"), entity_ref("urn:fr:paje:enfant:base-egal")) { origin case_input; }
        assert "base-egal-02": condition_age_base(entity_ref("urn:fr:paje:enfant:base-egal")) { origin adjudicated; }
        assert "base-egal-03": cohorte_enfant(entity_ref("urn:fr:paje:enfant:base-egal"), NE_APARTIR_AVRIL_2018) { origin adjudicated; }
        assert "base-egal-04": ressources_annuelles(entity_ref("urn:fr:paje:case:base-egal"), 30000 EUR) { origin case_input; }
        assert "base-egal-05": plafond_base_taux_plein(entity_ref("urn:fr:paje:case:base-egal"), 30000 EUR) { origin case_input; }
        assert "base-egal-06": bmaf_applicable(entity_ref("urn:fr:paje:case:base-egal"), 400.00 EUR) { origin case_input; }
        assert "base-egal-07": mois_eligible_base(entity_ref("urn:fr:paje:case:base-egal"), entity_ref("urn:fr:paje:enfant:base-egal"), @2025-07-01) { origin adjudicated; }
    }
    evaluate truth(base_attribuee(entity_ref("urn:fr:paje:case:base-egal"), entity_ref("urn:fr:paje:enfant:base-egal"), 166.60 EUR, @2025-07-01));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
