// D. 532-2, premise control: the exams were taken (no missed-exams fact),
// so even a transmitted request with an effect month concludes nothing.
// Control — suspension-versement-accordee.
language "law.core" version "0.2";
package fr.pf.paje version "0.1.0";
namespace "urn:fr:corpus:clir:pf-paje";

test "urn:query:fr-pf-paje-suspension-examens-passes" {
    given {
        context { decision_time @2025-07-15T12:00:00Z; knowledge_time @2025-07-15T12:00:00Z; legal_time @2025-07-15; timezone "Europe/Paris"; }
        assert "susp-pass-01": demande_medecin_pmi(entity_ref("urn:fr:paje:case:susp-pass"), entity_ref("urn:fr:paje:enfant:susp-pass"), @2025-06-10) { origin adjudicated; }
        assert "susp-pass-02": mois_effet_suspension(entity_ref("urn:fr:paje:case:susp-pass"), entity_ref("urn:fr:paje:enfant:susp-pass"), @2025-07-01) { origin adjudicated; }
    }
    evaluate truth(suspension_versement_paje(entity_ref("urn:fr:paje:case:susp-pass"), entity_ref("urn:fr:paje:enfant:susp-pass"), @2025-07-01));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
