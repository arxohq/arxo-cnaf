// Adoption, pair: resources above the ceiling — no right.
language "law.core" version "0.2";
package fr.pf.paje version "0.1.0";
namespace "urn:fr:corpus:clir:pf-paje";

test "urn:query:fr-pf-paje-adoption-plafond-depasse" {
    given {
        context { decision_time @2025-07-15T12:00:00Z; knowledge_time @2025-07-15T12:00:00Z; legal_time @2025-07-15; timezone "Europe/Paris"; }
        assert "adoption-depasse-01": adoption_arrivee(entity_ref("urn:fr:paje:case:adoption-depasse"), entity_ref("urn:fr:paje:enfant:adoption-depasse")) { origin adjudicated; }
        assert "adoption-depasse-02": condition_age_adoption(entity_ref("urn:fr:paje:enfant:adoption-depasse")) { origin adjudicated; }
        assert "adoption-depasse-03": ressources_annuelles(entity_ref("urn:fr:paje:case:adoption-depasse"), 40000 EUR) { origin case_input; }
        assert "adoption-depasse-04": plafond_base_taux_plein(entity_ref("urn:fr:paje:case:adoption-depasse"), 30000 EUR) { origin case_input; }
        assert "adoption-depasse-05": bmaf_applicable(entity_ref("urn:fr:paje:case:adoption-depasse"), 400.00 EUR) { origin case_input; }
    }
    evaluate truth(droit_prime_adoption(entity_ref("urn:fr:paje:case:adoption-depasse"), entity_ref("urn:fr:paje:enfant:adoption-depasse")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
