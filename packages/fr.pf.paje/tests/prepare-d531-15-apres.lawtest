// D. 531-15 wording pair, after the 2026 reform (decree 2026-426, birth
// supplements assimilated): month of right 2026-09 — same full rate 386.48 €.
// Pair — prepare-d531-15-avant (2026-03 → same amount).
language "law.core" version "0.2";
package fr.pf.paje version "0.1.0";
namespace "urn:fr:corpus:clir:pf-paje";

test "urn:query:fr-pf-paje-prepare-d531-15-apres" {
    given {
        context { decision_time @2026-09-15T12:00:00Z; knowledge_time @2026-09-15T12:00:00Z; legal_time @2026-09-15; timezone "Europe/Paris"; }
        assert "prepare-15b-01": arret_activite(entity_ref("urn:fr:paje:benef:prepare-15b"), entity_ref("urn:fr:paje:enfant:prepare-15b")) { origin adjudicated; }
        assert "prepare-15b-02": activite_anterieure_suffisante(entity_ref("urn:fr:paje:benef:prepare-15b"), entity_ref("urn:fr:paje:enfant:prepare-15b")) { origin adjudicated; }
        assert "prepare-15b-03": condition_age_prepare(entity_ref("urn:fr:paje:enfant:prepare-15b")) { origin adjudicated; }
        assert "prepare-15b-04": menage_beneficiaire(entity_ref("urn:fr:paje:benef:prepare-15b"), entity_ref("urn:fr:paje:case:prepare-15b")) { origin case_input; }
        assert "prepare-15b-05": bmaf_applicable(entity_ref("urn:fr:paje:case:prepare-15b"), 400.00 EUR) { origin case_input; }
        assert "prepare-15b-06": mois_eligible_prepare(entity_ref("urn:fr:paje:benef:prepare-15b"), entity_ref("urn:fr:paje:enfant:prepare-15b"), @2026-09-01) { origin adjudicated; }
    }
    evaluate truth(prepare_attribuee(entity_ref("urn:fr:paje:benef:prepare-15b"), entity_ref("urn:fr:paje:enfant:prepare-15b"), 386.48 EUR, @2026-09-01));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
