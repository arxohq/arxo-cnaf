// Ceiling pair, just above the full ceiling (30001 €): no plein right —
// the 166.60 € award is NEITHER (control — base-plafond-egal).
language "law.core" version "0.2";
package fr.pf.paje version "0.1.0";
namespace "urn:fr:corpus:clir:pf-paje";

test "urn:query:fr-pf-paje-base-juste-au-dessus" {
    given {
        context { decision_time @2025-07-15T12:00:00Z; knowledge_time @2025-07-15T12:00:00Z; legal_time @2025-07-15; timezone "Europe/Paris"; }
        assert "base-dessus-01": enfant_en_charge(entity_ref("urn:fr:paje:case:base-dessus"), entity_ref("urn:fr:paje:enfant:base-dessus")) { origin case_input; }
        assert "base-dessus-02": condition_age_base(entity_ref("urn:fr:paje:enfant:base-dessus")) { origin adjudicated; }
        assert "base-dessus-03": cohorte_enfant(entity_ref("urn:fr:paje:enfant:base-dessus"), NE_APARTIR_AVRIL_2018) { origin adjudicated; }
        assert "base-dessus-04": ressources_annuelles(entity_ref("urn:fr:paje:case:base-dessus"), 30001 EUR) { origin case_input; }
        assert "base-dessus-05": plafond_base_taux_plein(entity_ref("urn:fr:paje:case:base-dessus"), 30000 EUR) { origin case_input; }
        assert "base-dessus-06": bmaf_applicable(entity_ref("urn:fr:paje:case:base-dessus"), 400.00 EUR) { origin case_input; }
        assert "base-dessus-07": mois_eligible_base(entity_ref("urn:fr:paje:case:base-dessus"), entity_ref("urn:fr:paje:enfant:base-dessus"), @2025-07-01) { origin adjudicated; }
    }
    evaluate truth(base_attribuee(entity_ref("urn:fr:paje:case:base-dessus"), entity_ref("urn:fr:paje:enfant:base-dessus"), 166.60 EUR, @2025-07-01));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
