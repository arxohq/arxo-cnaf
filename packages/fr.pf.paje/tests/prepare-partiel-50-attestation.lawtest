// Part-time 50% via employer certificate (D. 531-6 path): certified share
// up to 50% → 400 × 0.6246 = 249.84 €.
language "law.core" version "0.2";
package fr.pf.paje version "0.1.0";
namespace "urn:fr:corpus:clir:pf-paje";

test "urn:query:fr-pf-paje-prepare-partiel-50-attestation" {
    given {
        context { decision_time @2025-07-15T12:00:00Z; knowledge_time @2025-07-15T12:00:00Z; legal_time @2025-07-15; timezone "Europe/Paris"; }
        assert "prepare-a50-01": attestation_quotite(entity_ref("urn:fr:paje:benef:prepare-a50"), JUSQUA_50) { origin adjudicated; }
        assert "prepare-a50-02": activite_anterieure_suffisante(entity_ref("urn:fr:paje:benef:prepare-a50"), entity_ref("urn:fr:paje:enfant:prepare-a50")) { origin adjudicated; }
        assert "prepare-a50-03": condition_age_prepare(entity_ref("urn:fr:paje:enfant:prepare-a50")) { origin adjudicated; }
        assert "prepare-a50-04": menage_beneficiaire(entity_ref("urn:fr:paje:benef:prepare-a50"), entity_ref("urn:fr:paje:case:prepare-a50")) { origin case_input; }
        assert "prepare-a50-05": bmaf_applicable(entity_ref("urn:fr:paje:case:prepare-a50"), 400.00 EUR) { origin case_input; }
        assert "prepare-a50-06": mois_eligible_prepare(entity_ref("urn:fr:paje:benef:prepare-a50"), entity_ref("urn:fr:paje:enfant:prepare-a50"), @2025-07-01) { origin adjudicated; }
    }
    evaluate truth(prepare_attribuee(entity_ref("urn:fr:paje:benef:prepare-a50"), entity_ref("urn:fr:paje:enfant:prepare-a50"), 249.84 EUR, @2025-07-01));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
