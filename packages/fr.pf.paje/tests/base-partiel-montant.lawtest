// Base partiel: resources of 32000 € above the full ceiling of 30000 € but
// within the L. 531-2 ceiling (119.47% × 30000 = 35841.00 €, built by
// D. 531-3-1) → 400 × 0.20825 = 83.30 €.
language "law.core" version "0.2";
package fr.pf.paje version "0.1.0";
namespace "urn:fr:corpus:clir:pf-paje";

test "urn:query:fr-pf-paje-base-partiel-montant" {
    given {
        context { decision_time @2025-07-15T12:00:00Z; knowledge_time @2025-07-15T12:00:00Z; legal_time @2025-07-15; timezone "Europe/Paris"; }
        assert "base-partiel-01": enfant_en_charge(entity_ref("urn:fr:paje:case:base-partiel"), entity_ref("urn:fr:paje:enfant:base-partiel")) { origin case_input; }
        assert "base-partiel-02": condition_age_base(entity_ref("urn:fr:paje:enfant:base-partiel")) { origin adjudicated; }
        assert "base-partiel-03": cohorte_enfant(entity_ref("urn:fr:paje:enfant:base-partiel"), NE_APARTIR_AVRIL_2018) { origin adjudicated; }
        assert "base-partiel-04": ressources_annuelles(entity_ref("urn:fr:paje:case:base-partiel"), 32000 EUR) { origin case_input; }
        assert "base-partiel-05": plafond_base_taux_plein(entity_ref("urn:fr:paje:case:base-partiel"), 30000 EUR) { origin case_input; }
        assert "base-partiel-06": bmaf_applicable(entity_ref("urn:fr:paje:case:base-partiel"), 400.00 EUR) { origin case_input; }
        assert "base-partiel-07": mois_eligible_base(entity_ref("urn:fr:paje:case:base-partiel"), entity_ref("urn:fr:paje:enfant:base-partiel"), @2025-07-01) { origin adjudicated; }
    }
    evaluate truth(base_attribuee(entity_ref("urn:fr:paje:case:base-partiel"), entity_ref("urn:fr:paje:enfant:base-partiel"), 83.30 EUR, @2025-07-01));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
