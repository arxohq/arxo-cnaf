// D. 532-1, performance control (FULL RETURN 03, R02-02 + RETURN04,
// R03-01): the declaration was sent to both bodies in time (2025-03-10,
// window 2025-01-06–2025-04-14), but no conforming prescribed medical
// document is established — the declaration does not count as made. The
// window facts isolate the missing document as the failing premise.
// Control — declaration-grossesse-effectuee-conforme.
language "law.core" version "0.2";
package fr.pf.paje version "0.1.0";
namespace "urn:fr:corpus:clir:pf-paje";

test "urn:query:fr-pf-paje-declaration-sans-document-conforme" {
    given {
        context { decision_time @2025-03-15T12:00:00Z; knowledge_time @2025-03-15T12:00:00Z; legal_time @2025-03-15; timezone "Europe/Paris"; }
        assert "decl-sdc-01": declaration_grossesse_adressee(entity_ref("urn:fr:paje:case:decl-sdc"), entity_ref("urn:fr:paje:enfant:decl-sdc"), @2025-03-10) { origin adjudicated; }
        assert "decl-sdc-02": debut_grossesse(entity_ref("urn:fr:paje:case:decl-sdc"), entity_ref("urn:fr:paje:enfant:decl-sdc"), @2025-01-06) { origin adjudicated; }
        assert "decl-sdc-03": date_limite_declaration(entity_ref("urn:fr:paje:case:decl-sdc"), entity_ref("urn:fr:paje:enfant:decl-sdc"), @2025-04-14) { origin adjudicated; }
    }
    evaluate truth(declaration_grossesse_effectuee(entity_ref("urn:fr:paje:case:decl-sdc"), entity_ref("urn:fr:paje:enfant:decl-sdc")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
