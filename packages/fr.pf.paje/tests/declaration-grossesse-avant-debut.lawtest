// D. 532-1, lower-start boundary (RETURN 2026-10-08): the declaration sent
// 2025-01-01, five days before the established pregnancy start (2025-01-06,
// deadline 2025-04-14), is outside «les quatorze premières semaines» —
// neither on time nor late. The tardive head is likewise NEITHER on these
// facts (envoi < debut <= limite). Controls — declaration-grossesse-en-delai
// (inside the window) and declaration-grossesse-jour-debut (exactly at start).
language "law.core" version "0.2";
package fr.pf.paje version "0.1.0";
namespace "urn:fr:corpus:clir:pf-paje";

test "urn:query:fr-pf-paje-declaration-avant-debut" {
    given {
        context { decision_time @2025-01-10T12:00:00Z; knowledge_time @2025-01-10T12:00:00Z; legal_time @2025-01-10; timezone "Europe/Paris"; }
        assert "decl-early-01": attente_naissance(entity_ref("urn:fr:paje:case:decl-early"), entity_ref("urn:fr:paje:enfant:decl-early")) { origin case_input; }
        assert "decl-early-02": debut_grossesse(entity_ref("urn:fr:paje:case:decl-early"), entity_ref("urn:fr:paje:enfant:decl-early"), @2025-01-06) { origin adjudicated; }
        assert "decl-early-03": date_limite_declaration(entity_ref("urn:fr:paje:case:decl-early"), entity_ref("urn:fr:paje:enfant:decl-early"), @2025-04-14) { origin adjudicated; }
        assert "decl-early-04": declaration_grossesse_adressee(entity_ref("urn:fr:paje:case:decl-early"), entity_ref("urn:fr:paje:enfant:decl-early"), @2025-01-01) { origin adjudicated; }
    }
    evaluate truth(declaration_grossesse_en_delai(entity_ref("urn:fr:paje:case:decl-early"), entity_ref("urn:fr:paje:enfant:decl-early")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
