// Adoption (L. 531-3, para. 3): adopted child within the age limits,
// pre-2018 arrival, month of right 2021-02 — old rate 183.80 €, same
// duration as paragraph 1.
language "law.core" version "0.2";
package fr.pf.paje version "0.1.0";
namespace "urn:fr:corpus:clir:pf-paje";

test "urn:query:fr-pf-paje-base-adoption" {
    given {
        context { decision_time @2021-02-15T12:00:00Z; knowledge_time @2021-02-15T12:00:00Z; legal_time @2021-02-15; timezone "Europe/Paris"; }
        assert "base-ad-01": enfant_en_charge(entity_ref("urn:fr:paje:case:base-ad"), entity_ref("urn:fr:paje:enfant:base-ad")) { origin case_input; }
        assert "base-ad-02": condition_age_base(entity_ref("urn:fr:paje:enfant:base-ad")) { origin adjudicated; }
        assert "base-ad-03": cohorte_enfant(entity_ref("urn:fr:paje:enfant:base-ad"), NE_AVANT_AVRIL_2018) { origin adjudicated; }
        assert "base-ad-04": ressources_annuelles(entity_ref("urn:fr:paje:case:base-ad"), 20000 EUR) { origin case_input; }
        assert "base-ad-05": plafond_base_taux_plein(entity_ref("urn:fr:paje:case:base-ad"), 30000 EUR) { origin case_input; }
        assert "base-ad-06": bmaf_applicable(entity_ref("urn:fr:paje:case:base-ad"), 400.00 EUR) { origin case_input; }
        assert "base-ad-07": mois_eligible_base(entity_ref("urn:fr:paje:case:base-ad"), entity_ref("urn:fr:paje:enfant:base-ad"), @2021-02-01) { origin adjudicated; }
    }
    evaluate truth(base_attribuee(entity_ref("urn:fr:paje:case:base-ad"), entity_ref("urn:fr:paje:enfant:base-ad"), 183.80 EUR, @2021-02-01));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
