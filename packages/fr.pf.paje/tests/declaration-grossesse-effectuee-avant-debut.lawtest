// D. 532-1, pre-start performance control (RETURN04, R03-01): the
// declaration sent 2025-01-01 to both bodies, five days before the
// established pregnancy start (2025-01-06, deadline 2025-04-14), with a
// conforming prescribed medical document — outside «les quatorze premières
// semaines», the declaration does not count as made (same dates as
// declaration-grossesse-avant-debut, NEITHER there for both status heads).
// Control — declaration-grossesse-effectuee-conforme (in-window pair).
language "law.core" version "0.2";
package fr.pf.paje version "0.1.0";
namespace "urn:fr:corpus:clir:pf-paje";

test "urn:query:fr-pf-paje-declaration-effectuee-avant-debut" {
    given {
        context { decision_time @2025-01-10T12:00:00Z; knowledge_time @2025-01-10T12:00:00Z; legal_time @2025-01-10; timezone "Europe/Paris"; }
        assert "decl-eff-early-01": declaration_grossesse_adressee(entity_ref("urn:fr:paje:case:decl-eff-early"), entity_ref("urn:fr:paje:enfant:decl-eff-early"), @2025-01-01) { origin adjudicated; }
        assert "decl-eff-early-02": document_medical_conforme(entity_ref("urn:fr:paje:case:decl-eff-early"), entity_ref("urn:fr:paje:enfant:decl-eff-early")) { origin adjudicated; }
        assert "decl-eff-early-03": debut_grossesse(entity_ref("urn:fr:paje:case:decl-eff-early"), entity_ref("urn:fr:paje:enfant:decl-eff-early"), @2025-01-06) { origin adjudicated; }
        assert "decl-eff-early-04": date_limite_declaration(entity_ref("urn:fr:paje:case:decl-eff-early"), entity_ref("urn:fr:paje:enfant:decl-eff-early"), @2025-04-14) { origin adjudicated; }
    }
    evaluate truth(declaration_grossesse_effectuee(entity_ref("urn:fr:paje:case:decl-eff-early"), entity_ref("urn:fr:paje:enfant:decl-eff-early")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
