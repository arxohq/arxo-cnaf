// Ceiling pair, part rate: resources exactly at the built L. 531-2 ceiling
// (35841.00 € = 119.47% × 30000) → partiel, 83.30 €.
language "law.core" version "0.2";
package fr.pf.paje version "0.1.0";
namespace "urn:fr:corpus:clir:pf-paje";

test "urn:query:fr-pf-paje-base-partiel-plafond-egal" {
    given {
        context { decision_time @2025-07-15T12:00:00Z; knowledge_time @2025-07-15T12:00:00Z; legal_time @2025-07-15; timezone "Europe/Paris"; }
        assert "base-peg-01": enfant_en_charge(entity_ref("urn:fr:paje:case:base-peg"), entity_ref("urn:fr:paje:enfant:base-peg")) { origin case_input; }
        assert "base-peg-02": condition_age_base(entity_ref("urn:fr:paje:enfant:base-peg")) { origin adjudicated; }
        assert "base-peg-03": cohorte_enfant(entity_ref("urn:fr:paje:enfant:base-peg"), NE_APARTIR_AVRIL_2018) { origin adjudicated; }
        assert "base-peg-04": ressources_annuelles(entity_ref("urn:fr:paje:case:base-peg"), 35841 EUR) { origin case_input; }
        assert "base-peg-05": plafond_base_taux_plein(entity_ref("urn:fr:paje:case:base-peg"), 30000 EUR) { origin case_input; }
        assert "base-peg-06": bmaf_applicable(entity_ref("urn:fr:paje:case:base-peg"), 400.00 EUR) { origin case_input; }
        assert "base-peg-07": mois_eligible_base(entity_ref("urn:fr:paje:case:base-peg"), entity_ref("urn:fr:paje:enfant:base-peg"), @2025-07-01) { origin adjudicated; }
    }
    evaluate truth(base_attribuee(entity_ref("urn:fr:paje:case:base-peg"), entity_ref("urn:fr:paje:enfant:base-peg"), 83.30 EUR, @2025-07-01));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
