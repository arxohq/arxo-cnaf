// D. 531-2 wording pair, old side: right month 03.2021 — the 2015 wording
// applies («due et versée après la naissance»): APRES_NAISSANCE.
// Control — prime-naissance-regime-nouveau (05.2021).
language "law.core" version "0.2";
package fr.pf.paje version "0.1.0";
namespace "urn:fr:corpus:clir:pf-paje";

test "urn:query:fr-pf-paje-naissance-regime-ancien" {
    given {
        context { decision_time @2021-03-15T12:00:00Z; knowledge_time @2021-03-15T12:00:00Z; legal_time @2021-03-15; timezone "Europe/Paris"; }
        assert "regime-ancien-01": attente_naissance(entity_ref("urn:fr:paje:case:regime-ancien"), entity_ref("urn:fr:paje:enfant:regime-ancien")) { origin case_input; }
        assert "regime-ancien-02": ressources_annuelles(entity_ref("urn:fr:paje:case:regime-ancien"), 20000 EUR) { origin case_input; }
        assert "regime-ancien-03": plafond_base_taux_plein(entity_ref("urn:fr:paje:case:regime-ancien"), 30000 EUR) { origin case_input; }
        assert "regime-ancien-04": bmaf_applicable(entity_ref("urn:fr:paje:case:regime-ancien"), 400.00 EUR) { origin case_input; }
    }
    evaluate truth(regime_versement_naissance(entity_ref("urn:fr:paje:case:regime-ancien"), entity_ref("urn:fr:paje:enfant:regime-ancien"), APRES_NAISSANCE));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
