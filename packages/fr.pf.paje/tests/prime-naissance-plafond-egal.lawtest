// Equality boundary: «ressources ne dépassent pas» — equality with the
// ceiling gives the right (resources 35841.00 € = ceiling 35841.00 €).
language "law.core" version "0.2";
package fr.pf.paje version "0.1.0";
namespace "urn:fr:corpus:clir:pf-paje";

test "urn:query:fr-pf-paje-naissance-plafond-egal" {
    given {
        context { decision_time @2025-07-15T12:00:00Z; knowledge_time @2025-07-15T12:00:00Z; legal_time @2025-07-15; timezone "Europe/Paris"; }
        assert "plafond-egal-01": attente_naissance(entity_ref("urn:fr:paje:case:plafond-egal"), entity_ref("urn:fr:paje:enfant:plafond-egal")) { origin case_input; }
        assert "plafond-egal-02": ressources_annuelles(entity_ref("urn:fr:paje:case:plafond-egal"), 35841.00 EUR) { origin case_input; }
        assert "plafond-egal-03": plafond_base_taux_plein(entity_ref("urn:fr:paje:case:plafond-egal"), 30000 EUR) { origin case_input; }
        assert "plafond-egal-04": bmaf_applicable(entity_ref("urn:fr:paje:case:plafond-egal"), 400.00 EUR) { origin case_input; }
        assert "plafond-egal-05": date_examen_situation(entity_ref("urn:fr:paje:case:plafond-egal"), entity_ref("urn:fr:paje:enfant:plafond-egal"), @2025-07-01) { origin adjudicated; }
    }
    evaluate truth(droit_prime_naissance(entity_ref("urn:fr:paje:case:plafond-egal"), entity_ref("urn:fr:paje:enfant:plafond-egal")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
