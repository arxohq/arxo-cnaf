// D. 532-1, late-performance control (RETURN04, R03-01): the declaration
// sent 2025-04-20 to both bodies, six days after the fourteen-week deadline
// (2025-04-14), with a conforming prescribed medical document — the sending
// is tardive (same dates as declaration-grossesse-tardive, TRUE there),
// but the declaration does not count as made: the performance derivation
// enforces «dans les quatorze premières semaines», so a late conforming
// send cannot satisfy the duty. Control —
// declaration-grossesse-effectuee-conforme (in-time pair).
language "law.core" version "0.2";
package fr.pf.paje version "0.1.0";
namespace "urn:fr:corpus:clir:pf-paje";

test "urn:query:fr-pf-paje-declaration-effectuee-tardive" {
    given {
        context { decision_time @2025-04-25T12:00:00Z; knowledge_time @2025-04-25T12:00:00Z; legal_time @2025-04-25; timezone "Europe/Paris"; }
        assert "decl-eff-tard-01": declaration_grossesse_adressee(entity_ref("urn:fr:paje:case:decl-eff-tard"), entity_ref("urn:fr:paje:enfant:decl-eff-tard"), @2025-04-20) { origin adjudicated; }
        assert "decl-eff-tard-02": document_medical_conforme(entity_ref("urn:fr:paje:case:decl-eff-tard"), entity_ref("urn:fr:paje:enfant:decl-eff-tard")) { origin adjudicated; }
        assert "decl-eff-tard-03": debut_grossesse(entity_ref("urn:fr:paje:case:decl-eff-tard"), entity_ref("urn:fr:paje:enfant:decl-eff-tard"), @2025-01-06) { origin adjudicated; }
        assert "decl-eff-tard-04": date_limite_declaration(entity_ref("urn:fr:paje:case:decl-eff-tard"), entity_ref("urn:fr:paje:enfant:decl-eff-tard"), @2025-04-14) { origin adjudicated; }
    }
    evaluate truth(declaration_grossesse_effectuee(entity_ref("urn:fr:paje:case:decl-eff-tard"), entity_ref("urn:fr:paje:enfant:decl-eff-tard")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
