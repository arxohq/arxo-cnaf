// Deontics D3, active duty: pregnancy in progress with established dates
// and a debtor fund, declaration not yet made. DeclarerGrossesseEnDelai
// position — ACTIVE.
language "law.core" version "0.2";
package fr.pf.paje version "0.1.0";
namespace "urn:fr:corpus:clir:pf-paje";

test "urn:query:fr-pf-paje-devoir-declarer-actif" {
    given {
        context { decision_time @2025-03-15T12:00:00Z; knowledge_time @2025-03-15T12:00:00Z; legal_time @2025-03-15; timezone "Europe/Paris"; }
        assert "devoir-decl-01": attente_naissance(entity_ref("urn:fr:paje:case:devoir-decl"), entity_ref("urn:fr:paje:enfant:devoir-decl")) { origin case_input; }
        assert "devoir-decl-02": debut_grossesse(entity_ref("urn:fr:paje:case:devoir-decl"), entity_ref("urn:fr:paje:enfant:devoir-decl"), @2025-01-06) { origin adjudicated; }
        assert "devoir-decl-03": date_limite_declaration(entity_ref("urn:fr:paje:case:devoir-decl"), entity_ref("urn:fr:paje:enfant:devoir-decl"), @2025-04-14) { origin adjudicated; }
        assert "devoir-decl-04": organisme_debiteur(entity_ref("urn:fr:paje:org:caisse"), entity_ref("urn:fr:paje:case:devoir-decl")) { origin case_input; }
    }
    evaluate positions();
    expect position(DeclarerGrossesseEnDelai, ACTIVE);
    expect evaluation_status == COMPUTED;
}
