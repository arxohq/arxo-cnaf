// Without sufficient prior activity (no activite_anterieure_suffisante) the
// full-rate right does not open — the 386.48 € award is NEITHER.
language "law.core" version "0.2";
package fr.pf.paje version "0.1.0";
namespace "urn:fr:corpus:clir:pf-paje";

test "urn:query:fr-pf-paje-prepare-sans-activite-anterieure" {
    given {
        context { decision_time @2025-07-15T12:00:00Z; knowledge_time @2025-07-15T12:00:00Z; legal_time @2025-07-15; timezone "Europe/Paris"; }
        assert "prepare-saa-01": arret_activite(entity_ref("urn:fr:paje:benef:prepare-saa"), entity_ref("urn:fr:paje:enfant:prepare-saa")) { origin adjudicated; }
        assert "prepare-saa-02": condition_age_prepare(entity_ref("urn:fr:paje:enfant:prepare-saa")) { origin adjudicated; }
        assert "prepare-saa-03": menage_beneficiaire(entity_ref("urn:fr:paje:benef:prepare-saa"), entity_ref("urn:fr:paje:case:prepare-saa")) { origin case_input; }
        assert "prepare-saa-04": bmaf_applicable(entity_ref("urn:fr:paje:case:prepare-saa"), 400.00 EUR) { origin case_input; }
        assert "prepare-saa-05": mois_eligible_prepare(entity_ref("urn:fr:paje:benef:prepare-saa"), entity_ref("urn:fr:paje:enfant:prepare-saa"), @2025-07-01) { origin adjudicated; }
    }
    evaluate truth(prepare_attribuee(entity_ref("urn:fr:paje:benef:prepare-saa"), entity_ref("urn:fr:paje:enfant:prepare-saa"), 386.48 EUR, @2025-07-01));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
