// --- Wave 3: PreParE (05-prepare.law) -------------------------------------

pub entity Beneficiaire {
    label fr official "personne qui demande la prestation partagée d'éducation de l'enfant (L. 531-4)";
    label en unofficial "person claiming the shared child-raising benefit (L. 531-4)";
}

pub relation menage_beneficiaire(b: Beneficiaire, m: Menage) kind empirical {
    label fr official "le demandeur appartient au ménage dont la BMAF et le SMIC s'appliquent (fait du dossier)";
    label en unofficial "claimant belongs to the household whose BMAF and SMIC apply (case fact)";
}

pub relation arret_activite(b: Beneficiaire, e: Enfant) kind empirical {
    label fr official "le demandeur a cessé son activité professionnelle pour s'occuper de l'enfant (L. 531-4, I, 1, al. 1 ; fait établi)";
    label en unofficial "claimant stopped working to care for the child (L. 531-4, I, 1, para. 1; established fact)";
}

pub relation formation_non_remuneree(b: Beneficiaire, e: Enfant) kind empirical {
    label fr official "le demandeur suit une formation professionnelle non rémunérée (L. 531-4, I, 1, al. 1 ; fait établi)";
    label en unofficial "claimant follows unpaid vocational training (L. 531-4, I, 1, para. 1; established fact)";
}

pub relation activite_anterieure_suffisante(b: Beneficiaire, e: Enfant) kind empirical {
    label fr official "activité antérieure suffisante : périodes de référence 2/4/5 ans et 8 trimestres (R. 531-2), assimilations comprises (D. 531-15 ; fait établi)";
    label en unofficial "sufficient prior activity: 2/4/5-year reference periods and 8 quarters (R. 531-2), including assimilated periods (D. 531-15; established fact)";
}

pub relation condition_age_prepare(e: Enfant) kind empirical {
    label fr official "condition d'âge PreParE remplie : limite D. 531-1 ou limites adoption L. 531-4, IV et L. 512-3 2° (fait établi)";
    label en unofficial "PreParE age condition met: D. 531-1 limit, or the adoption limits of L. 531-4, IV and L. 512-3 2° (established fact)";
}

pub enum BandeQuotite {
    label fr official "bande de quotité d'activité à temps partiel (D. 531-4, II)";
    label en unofficial "part-time activity share band (D. 531-4, II)";
    JUSQUA_50, DE_50_A_80
}

pub relation attestation_quotite(b: Beneficiaire, q: BandeQuotite) kind empirical {
    label fr official "quotité attestée par l'employeur : employés du particulier employeur, vacataires, accueillants familiaux (D. 531-6 à D. 531-8 ; fait établi)";
    label en unofficial "employer-certified share: home employees, vacataires, family carers (D. 531-6 to D. 531-8; established fact)";
}

pub relation jours_garde(b: Beneficiaire, total_jours: Integer, enfants_gardes: Integer, jours_ouvres: Integer) kind empirical {
    label fr official "assistants maternels : jours de garde du premier mois, enfants gardés, jours ouvrés (D. 531-10 ; fait établi)";
    label en unofficial "childminders: first-month care days, children kept, working days (D. 531-10; established fact)";
}

pub relation jours_contrat(b: Beneficiaire, jours: Integer) kind empirical {
    label fr official "cadres au forfait-jours : jours travaillés fixés par le contrat (D. 531-11 ; fait établi)";
    label en unofficial "forfait-jours managers: working days set by the contract (D. 531-11; established fact)";
}

pub relation jours_accord(b: Beneficiaire, jours: Integer) kind empirical {
    label fr official "cadres au forfait-jours : jours autorisés par l'accord collectif ou le plafond légal (D. 531-11 ; fait établi)";
    label en unofficial "forfait-jours managers: days allowed by the collective agreement or the legal ceiling (D. 531-11; established fact)";
}

pub relation quotite_declaree(b: Beneficiaire, q: BandeQuotite) kind empirical {
    label fr official "quotité déclarée sur l'honneur : au plus 50 % ou 50–80 % de la durée légale (D. 531-9, I–II ; fait établi)";
    label en unofficial "share declared on honour: at most 50% or 50-80% of the legal working time (D. 531-9, I-II; established fact)";
}

pub relation categorie_plafond_smic(b: Beneficiaire) kind empirical {
    label fr official "demandeur d'une catégorie à plafond SMIC : salarié L. 7311-3, non-salarié, élu local (D. 531-9 ; fait établi)";
    label en unofficial "claimant in a SMIC-capped category: L. 7311-3 employee, self-employed, local elected official (D. 531-9; established fact)";
}

pub relation bande_activite(b: Beneficiaire, q: BandeQuotite) kind institutional {
    label fr official "bande de quotité applicable au demandeur (D. 531-4, II ; R. 531-3 : premier mois)";
    label en unofficial "applicable activity-share band of the claimant (D. 531-4, II; R. 531-3: first month)";
}

pub relation smic_mensuel(m: Menage, montant: Money) kind empirical {
    label fr official "SMIC mensuel (SMIC horaire × 169 ; série — fr.travail.smic ; fait du dossier)";
    label en unofficial "monthly SMIC (hourly SMIC x 169; series — fr.travail.smic; case fact)";
}

pub relation revenu_mensuel_activite(b: Beneficiaire, montant: Money) kind empirical {
    label fr official "rémunération mensuelle nette ou revenu professionnel mensuel du temps partiel (D. 531-9 ; fait établi)";
    label en unofficial "monthly net pay or monthly professional income from part-time work (D. 531-9; established fact)";
}

pub relation condition_elu(b: Beneficiaire) kind empirical {
    label fr official "élu ayant cessé son activité : indemnités au plus égales à la fraction représentative (D. 531-5 ; fait établi)";
    label en unofficial "elected official who stopped working: allowances within the representative fraction (D. 531-5; established fact)";
}

pub relation option_majoree(b: Beneficiaire, e: Enfant) kind empirical {
    label fr official "option définitive du montant majoré : aucune activité pendant la durée, trois enfants à charge (L. 531-4, VI, al. 2 ; D. 531-16-1 ; fait établi)";
    label en unofficial "final option for the increased amount: no activity during the period, three dependent children (L. 531-4, VI, para. 2; D. 531-16-1; established fact)";
}

pub relation droit_prepare_plein(b: Beneficiaire, e: Enfant) kind institutional {
    label fr official "droit à la PreParE à taux plein ouvert (L. 531-4)";
    label en unofficial "right to full-rate PreParE is open (L. 531-4)";
}

pub relation droit_prepare_partiel(b: Beneficiaire, e: Enfant) kind institutional {
    label fr official "droit à la PreParE à taux partiel ouvert (L. 531-4)";
    label en unofficial "right to part-time PreParE is open (L. 531-4)";
}

pub relation montant_prepare_plein(b: Beneficiaire, e: Enfant, montant: Money) kind institutional {
    key(b, e);
    label fr official "montant mensuel PreParE à taux plein : 96,62 % de la BMAF (D. 531-4, I, 1°)";
    label en unofficial "monthly full-rate PreParE: 96.62% of the BMAF (D. 531-4, I, 1)";
}

pub relation montant_prepare_partiel(b: Beneficiaire, e: Enfant, montant: Money) kind institutional {
    key(b, e);
    label fr official "montant mensuel PreParE à taux partiel : 62,46 % ou 36,03 % de la BMAF (D. 531-4, II)";
    label en unofficial "monthly part-time PreParE: 62.46% or 36.03% of the BMAF (D. 531-4, II)";
}

pub relation montant_prepare_majore(b: Beneficiaire, e: Enfant, montant: Money) kind institutional {
    key(b, e);
    label fr official "montant mensuel PreParE majoré : 157,93 % de la BMAF (D. 531-4, I, 2°)";
    label en unofficial "monthly increased PreParE: 157.93% of the BMAF (D. 531-4, I, 2)";
}

pub relation mois_eligible_prepare(b: Beneficiaire, e: Enfant, mois: Date) kind empirical {
    label fr official "mois au titre duquel la PreParE est due (période établie par la caisse)";
    label en unofficial "month for which PreParE is due (fund-established period)";
}

pub relation prepare_attribuee(b: Beneficiaire, e: Enfant, montant: Money, mois: Date) kind institutional {
    key(b, e);
    label fr official "PreParE attribuée au mois au montant en vigueur";
    label en unofficial "PreParE awarded for the month at the amount in force";
}

pub relation prepare_versee(b: Beneficiaire, e: Enfant, montant: Money) kind empirical {
    key(b, e);
    label fr official "la PreParE a été versée au demandeur (exécution)";
    label en unofficial "PreParE paid to the claimant (performance)";
}

// --- FINISH D72: medical-exam duties (07-examens-medicaux.law) -------------

pub relation debut_grossesse(m: Menage, e: Enfant, debut: Date) kind empirical {
    label fr official "début de la grossesse, datation médicale (D. 532-1 : les quatorze premières semaines ; fait établi)";
    label en unofficial "pregnancy start, medical dating (D. 532-1: the first fourteen weeks; established fact)";
}

pub relation date_limite_declaration(m: Menage, e: Enfant, limite: Date) kind empirical {
    label fr official "date limite de déclaration établie par la caisse (fin des quatorze premières semaines ; dérivation calendaire — fait établi)";
    label en unofficial "declaration deadline set by the fund (end of the first fourteen weeks; calendar derivation — established fact)";
}

pub relation declaration_grossesse_adressee(m: Menage, e: Enfant, envoi: Date) kind empirical {
    label fr official "déclaration de grossesse adressée aux deux organismes à la date d'envoi, attestée par le document médical du premier examen prénatal (D. 532-1 ; fait établi)";
    label en unofficial "pregnancy declaration sent to both bodies on the sending date, attested by the first-prenatal-exam medical document (D. 532-1; established fact)";
}

pub relation document_medical_conforme(m: Menage, e: Enfant) kind empirical {
    label fr official "déclaration attestée par le document médical prévu à cet effet constatant la passation du premier examen prénatal, conforme au modèle type — arrêté avant 2023, formulaire homologué depuis (D. 532-1, al. 2 ; fait documentaire établi)";
    label en unofficial "declaration attested by the prescribed medical document recording the first prenatal exam, conforming to the standard model — ministerial order before 2023, homologated form since (D. 532-1, para. 2; established documentary fact)";
}

pub relation declaration_grossesse_effectuee(m: Menage, e: Enfant) kind institutional {
    label fr official "déclaration de grossesse effectuée : envoi aux deux organismes dans les quatorze premières semaines et document médical prescrit conforme (exécution dérivée du devoir D. 532-1)";
    label en unofficial "pregnancy declaration made: both-destination sending within the first fourteen weeks plus conforming prescribed medical document (derived performance of the D. 532-1 duty)";
}

pub relation declaration_grossesse_en_delai(m: Menage, e: Enfant) kind institutional {
    label fr official "déclaration de grossesse adressée dans les quatorze premières semaines (D. 532-1)";
    label en unofficial "pregnancy declaration sent within the first fourteen weeks (D. 532-1)";
}

pub relation declaration_grossesse_tardive(m: Menage, e: Enfant) kind institutional {
    label fr official "déclaration de grossesse adressée après les quatorze premières semaines (D. 532-1)";
    label en unofficial "pregnancy declaration sent after the first fourteen weeks (D. 532-1)";
}

pub relation examens_l5331_non_passes(m: Menage, e: Enfant) kind empirical {
    label fr official "examens mentionnés à l'article L. 533-1 non passés (substance amont fr.pf.core ; fait établi)";
    label en unofficial "examinations of Art. L. 533-1 not taken (upstream fr.pf.core substance; established fact)";
}

pub relation motif_legitime_examens(m: Menage, e: Enfant) kind empirical {
    label fr official "motifs légitimes de ne pas passer les examens, établis (font obstacle à la suspension ; D. 532-2)";
    label en unofficial "established legitimate reasons for missing the examinations (bar the suspension; D. 532-2)";
}

pub relation sans_motif_legitime_examens(m: Menage, e: Enfant) kind empirical {
    label fr official "absence de motifs légitimes de ne pas passer les examens, établie (condition de la suspension ; D. 532-2 « en l'absence de motifs légitimes »)";
    label en unofficial "established absence of legitimate reasons for missing the examinations (suspension condition; D. 532-2 'en l'absence de motifs légitimes')";
}

pub relation demande_medecin_pmi(m: Menage, e: Enfant, transmission: Date) kind empirical {
    label fr official "demande de suspension du médecin responsable du service départemental de protection maternelle et infantile, transmise à la date (D. 532-2 ; fait établi)";
    label en unofficial "suspension request of the departmental PMI head doctor, transmitted on the date (D. 532-2; established fact)";
}

pub relation mois_effet_suspension(m: Menage, e: Enfant, mois: Date) kind empirical {
    label fr official "mois d'effet de la suspension établi par la caisse (mois civil suivant la demande ; dérivation calendaire — fait établi)";
    label en unofficial "suspension effect month set by the fund (calendar month after the request; calendar derivation — established fact)";
}

pub relation suspension_versement_paje(m: Menage, e: Enfant, mois: Date) kind institutional {
    label fr official "suspension du versement de la prestation d'accueil du jeune enfant prenant effet au mois (D. 532-2)";
    label en unofficial "suspension of the young-child benefit payment taking effect in the month (D. 532-2)";
}

// --- FINISH D73: DOM scope and non-cumulation (08-dom.law) ------------------

pub enum Territoire {
    label fr official "territoire de résidence pour la règle DOM PAJE (L. 755-19, collectivités L. 751-1)";
    label en unofficial "residence territory for the DOM PAJE rule (L. 755-19, L. 751-1 collectivities)";
    METROPOLE,
    GUADELOUPE,
    GUYANE,
    MARTINIQUE,
    REUNION,
    SAINT_BARTHELEMY,
    SAINT_MARTIN,
    MAYOTTE,
    AUTRE
}

pub relation territoire(m: Menage, t: Territoire) kind empirical {
    key(m);
    label fr official "territoire de résidence du ménage (fait du dossier)";
    label en unofficial "household residence territory (case fact)";
}

pub relation paje_dom_applicable(m: Menage) kind institutional {
    label fr official "la prestation d'accueil du jeune enfant est attribuée au ménage dans les conditions du titre III du livre V (L. 755-19, al. 1)";
    label en unofficial "the young-child benefit is awarded to the household under the Book V Title III conditions (L. 755-19, para. 1)";
}

pub relation af_enfant_unique_servies(m: Menage, e: Enfant) kind empirical {
    label fr official "allocations familiales et leurs majorations pour âge servies au titre d'un seul enfant à charge (substance fr.pf.af ; fait établi)";
    label en unofficial "family allowances with age supplements served for a single dependent child (fr.pf.af substance; established fact)";
}

pub relation cf_dom_l755_16_servi(m: Menage) kind empirical {
    label fr official "complément familial défini à l'article L. 755-16 servi au ménage (substance fr.pf.cf ; fait établi)";
    label en unofficial "complément familial of Art. L. 755-16 served to the household (fr.pf.cf substance; established fact)";
}

pub relation cumul_base_af_unique_interdit(m: Menage, e: Enfant) kind institutional {
    label fr official "l'allocation de base n'est pas cumulable avec les allocations familiales servies au titre d'un seul enfant à charge (L. 755-19, al. 2)";
    label en unofficial "the base allowance is not cumulable with family allowances served for a single dependent child (L. 755-19, para. 2)";
}

pub relation cumul_base_cf_dom_interdit(m: Menage, e: Enfant) kind institutional {
    label fr official "l'allocation de base n'est pas cumulable avec le complément familial défini à l'article L. 755-16 (L. 755-19, al. 3)";
    label en unofficial "the base allowance is not cumulable with the complément familial of Art. L. 755-16 (L. 755-19, para. 3)";
}

pub relation cumul_prepare_cf_dom_interdit(b: Beneficiaire, e: Enfant) kind institutional {
    label fr official "la prestation partagée d'éducation de l'enfant n'est pas cumulable avec le complément familial défini à l'article L. 755-16 (L. 755-19, al. 3)";
    label en unofficial "the shared child-raising benefit is not cumulable with the complément familial of Art. L. 755-16 (L. 755-19, para. 3)";
}
