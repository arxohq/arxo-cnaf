    label en unofficial "right to the full-rate base allowance is open (L. 531-3)";
}

pub relation droit_base_partiel(m: Menage, e: Enfant) kind institutional {
    label fr official "droit à l'allocation de base à taux partiel ouvert (L. 531-3)";
    label en unofficial "right to the part-rate base allowance is open (L. 531-3)";
}

pub relation montant_base_plein(m: Menage, e: Enfant, montant: Money) kind institutional {
    key(m, e);
    label fr official "montant mensuel de l'allocation de base à taux plein (D. 531-3)";
    label en unofficial "monthly full-rate base allowance amount (D. 531-3)";
}

pub relation montant_base_partiel(m: Menage, e: Enfant, montant: Money) kind institutional {
    key(m, e);
    label fr official "montant mensuel de l'allocation de base à taux partiel (D. 531-3)";
    label en unofficial "monthly part-rate base allowance amount (D. 531-3)";
}

pub relation mois_eligible_base(m: Menage, e: Enfant, mois: Date) kind empirical {
