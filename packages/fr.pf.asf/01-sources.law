@id("urn:fr:corpus:clir:pf-asf#CSS_R523_7")
pub fragment CSS_R523_7 in CSS_ED2022_11 {
    kind article;
    locator "article/R523-7";
    text fr official """Article R523-7
Les taux servant au calcul de l'allocation de soutien familial sont fixés, en pourcentage de la base mensuelle de calcul des allocations familiales déterminée en application de l'article L. 551-1 à :
1°) 56,25 % pour l'enfant mentionné au 1° de l'article L. 523-3 ;
2°) 42,2 % pour l'enfant mentionné au 2° de l'article L. 523-3.
NOTA: Conformément à l'article 2 du décret n° 2022-1370 du 27 octobre 2022, ces dispositions sont applicables aux prestations dues à compter du 1er novembre 2022.
""";
    content_hash "sha256:074587472abd7501343808dbc9e5316a5d460b0ff305b873ddc56e7cae7f0bc5";
}

@id("urn:fr:corpus:clir:pf-asf#CSS_R523_8")
pub fragment CSS_R523_8 in CSS_ED1985_12 {
    kind article;
    locator "article/R523-8";
    text fr official """Article R523-8
Les sommes récupérées par l'organisme débiteur de prestations familiales, en vertu de la subrogation prévue à l'article L. 581-2, viennent en atténuation des dépenses constatées au titre des allocations de soutien familial.
""";
    content_hash "sha256:0a94b8c674685cfe3ea18169d7f76f6c7836e7722bd91ac40472077a80067efc";
}

