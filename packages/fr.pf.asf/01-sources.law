@id("urn:fr:corpus:clir:pf-asf#CSS_D523_3")
pub fragment CSS_D523_3 in CSS_ED2018_07 {
    kind article;
    locator "article/D523-3";
    text fr official """Article D523-3
Lorsque le total des montants d'allocation de soutien familial dû au parent ou à la personne physique qui assume la charge effective et permanente de l'enfant est inférieur à 15 euros, celui-ci n'est pas versé.
""";
    content_hash "sha256:0a9e5f8e0a70340181da801ce0044fe4cc67d6c29e0cf9be9653c665c9f5684b";
}

