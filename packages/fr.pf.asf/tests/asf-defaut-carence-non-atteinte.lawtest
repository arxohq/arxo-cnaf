// Single default March 2021, opening March 2021: carence not served, nothing opens (NEITHER probe).
language "law.core" version "0.2";
package fr.pf.asf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-asf";

test "urn:query:fr-pf-asf-defaut-carence-non-atteinte" {
    given {
        context { deadline_policy PAIEMENT_MENSUEL; decision_time @2021-06-15T12:00:00Z; knowledge_time @2021-06-15T12:00:00Z; legal_time @2021-06-15; timezone "Europe/Paris"; }
        assert "odn-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-asf:case:defaut-carence-non-atteinte"), entity_ref("urn:fr:pf-asf:case:defaut-carence-non-atteinte-e1")) { origin case_input; }
        assert "odn-02": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-asf:case:defaut-carence-non-atteinte-e1")) { origin case_input; }
        assert "odn-03": motif_asf(entity_ref("urn:fr:pf-asf:case:defaut-carence-non-atteinte-e1"), DEFAUT_SIMPLE) { origin case_input; }
        assert "odn-04": demande_asf(entity_ref("urn:fr:pf-asf:case:defaut-carence-non-atteinte-e1")) { origin case_input; }
        assert "odn-05": manquement_debiteur(entity_ref("urn:fr:pf-asf:case:defaut-carence-non-atteinte-e1"), @2021-03-01) { origin case_input; }
        assert "odn-06": mois_ouverture_asf(@2021-03-01) { origin case_input; }
        assert "odn-07": bmaf_retenu(entity_ref("urn:fr:pf-asf:case:defaut-carence-non-atteinte"), 400.00 EUR) { origin case_input; }
    }
    evaluate truth(asf_enfant_eligible(entity_ref("urn:fr:pf-asf:case:defaut-carence-non-atteinte-e1")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
