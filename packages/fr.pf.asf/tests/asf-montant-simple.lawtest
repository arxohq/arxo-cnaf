// Eligible orphan of one parent, stated BMAF 400: 0.2813 x 400 = 112.52 (R. 523-7).
language "law.core" version "0.2";
package fr.pf.asf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-asf";

test "urn:query:fr-pf-asf-montant-simple" {
    given {
        context { deadline_policy PAIEMENT_MENSUEL; decision_time @2021-06-15T12:00:00Z; knowledge_time @2021-06-15T12:00:00Z; legal_time @2021-06-15; timezone "Europe/Paris"; }
        assert "oms-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-asf:case:montant-simple"), entity_ref("urn:fr:pf-asf:case:montant-simple-e1")) { origin case_input; }
        assert "oms-02": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-asf:case:montant-simple-e1")) { origin case_input; }
        assert "oms-03": motif_asf(entity_ref("urn:fr:pf-asf:case:montant-simple-e1"), ORPHELIN_UN_PARENT) { origin case_input; }
        assert "oms-04": demande_asf(entity_ref("urn:fr:pf-asf:case:montant-simple-e1")) { origin case_input; }
        assert "oms-05": mois_ouverture_asf(@2021-04-01) { origin case_input; }
        assert "oms-06": bmaf_retenu(entity_ref("urn:fr:pf-asf:case:montant-simple"), 400.00 EUR) { origin case_input; }
    }
    evaluate truth(asf_montant_du(entity_ref("urn:fr:pf-asf:case:montant-simple-e1"), 112.52 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
