// Orphan of both parents, requested: eligible, no carence (L. 523-1 1°).
language "law.core" version "0.2";
package fr.pf.asf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-asf";

test "urn:query:fr-pf-asf-orphelin-deux-parents" {
    given {
        context { deadline_policy PAIEMENT_MENSUEL; decision_time @2021-06-15T12:00:00Z; knowledge_time @2021-06-15T12:00:00Z; legal_time @2021-06-15; timezone "Europe/Paris"; }
        assert "ood-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-asf:case:orphelin-deux-parents"), entity_ref("urn:fr:pf-asf:case:orphelin-deux-parents-e1")) { origin case_input; }
        assert "ood-02": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-asf:case:orphelin-deux-parents-e1")) { origin case_input; }
        assert "ood-03": motif_asf(entity_ref("urn:fr:pf-asf:case:orphelin-deux-parents-e1"), ORPHELIN_DEUX_PARENTS) { origin case_input; }
        assert "ood-04": demande_asf(entity_ref("urn:fr:pf-asf:case:orphelin-deux-parents-e1")) { origin case_input; }
        assert "ood-05": bmaf_retenu(entity_ref("urn:fr:pf-asf:case:orphelin-deux-parents"), 400.00 EUR) { origin case_input; }
    }
    evaluate truth(asf_enfant_eligible(entity_ref("urn:fr:pf-asf:case:orphelin-deux-parents-e1")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
