// Pension 60 received, default March 2021, opening April 2021, requested: eligible (L. 523-1 4°).
language "law.core" version "0.2";
package fr.pf.asf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-asf";

test "urn:query:fr-pf-asf-pension-partielle" {
    given {
        context { deadline_policy PAIEMENT_MENSUEL; decision_time @2021-06-15T12:00:00Z; knowledge_time @2021-06-15T12:00:00Z; legal_time @2021-06-15; timezone "Europe/Paris"; }
        assert "opp-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-asf:case:pension-partielle"), entity_ref("urn:fr:pf-asf:case:pension-partielle-e1")) { origin case_input; }
        assert "opp-02": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-asf:case:pension-partielle-e1")) { origin case_input; }
        assert "opp-03": motif_asf(entity_ref("urn:fr:pf-asf:case:pension-partielle-e1"), PENSION_PARTIELLE) { origin case_input; }
        assert "opp-04": demande_asf(entity_ref("urn:fr:pf-asf:case:pension-partielle-e1")) { origin case_input; }
        assert "opp-05": manquement_debiteur(entity_ref("urn:fr:pf-asf:case:pension-partielle-e1"), @2021-03-01) { origin case_input; }
        assert "opp-06": mois_ouverture_asf(@2021-04-01) { origin case_input; }
        assert "opp-07": pension_recue(entity_ref("urn:fr:pf-asf:case:pension-partielle-e1"), 60.00 EUR) { origin case_input; }
        assert "opp-08": bmaf_retenu(entity_ref("urn:fr:pf-asf:case:pension-partielle"), 400.00 EUR) { origin case_input; }
    }
    evaluate truth(asf_enfant_eligible(entity_ref("urn:fr:pf-asf:case:pension-partielle-e1")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
