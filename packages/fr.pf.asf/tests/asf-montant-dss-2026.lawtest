// DSS/2B/2026/46 barème (annexe III.2, pinned in fr.css.revalorisation):
// ASF taux partiel (orphan of one parent), BMAF 478.16: 0.422 x 478.16 =
// 201.78352, rounded to the centime -> 201.78, the published amount.
language "law.core" version "0.2";
package fr.pf.asf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-asf";

test "urn:query:fr-pf-asf-montant-dss-2026" {
    given {
        context { deadline_policy PAIEMENT_MENSUEL; decision_time @2026-12-15T12:00:00Z; knowledge_time @2026-12-15T12:00:00Z; legal_time @2026-12-15; timezone "Europe/Paris"; }
        assert "omd-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-asf:case:montant-dss-2026"), entity_ref("urn:fr:pf-asf:case:montant-dss-2026-e1")) { origin case_input; }
        assert "omd-02": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-asf:case:montant-dss-2026-e1")) { origin case_input; }
        assert "omd-03": motif_asf(entity_ref("urn:fr:pf-asf:case:montant-dss-2026-e1"), ORPHELIN_UN_PARENT) { origin case_input; }
        assert "omd-04": demande_asf(entity_ref("urn:fr:pf-asf:case:montant-dss-2026-e1")) { origin case_input; }
        assert "omd-05": mois_ouverture_asf(@2026-04-01) { origin case_input; }
        assert "omd-06": bmaf_retenu(entity_ref("urn:fr:pf-asf:case:montant-dss-2026"), 478.16 EUR) { origin case_input; }
    }
    evaluate truth(asf_montant_du(entity_ref("urn:fr:pf-asf:case:montant-dss-2026-e1"), 201.78 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
