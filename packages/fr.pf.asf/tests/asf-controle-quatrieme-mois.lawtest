// Opening April 2021 confirmed, control July 2021: fourth-month control due (R. 523-3-2).
language "law.core" version "0.2";
package fr.pf.asf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-asf";

test "urn:query:fr-pf-asf-controle-quatrieme-mois" {
    given {
        context { deadline_policy CONTROLE_TRIMESTRIEL; decision_time @2021-06-15T12:00:00Z; knowledge_time @2021-06-15T12:00:00Z; legal_time @2021-06-15; timezone "Europe/Paris"; }
        assert "ocq-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-asf:case:controle-quatrieme-mois"), entity_ref("urn:fr:pf-asf:case:controle-quatrieme-mois-e1")) { origin case_input; }
        assert "ocq-02": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-asf:case:controle-quatrieme-mois-e1")) { origin case_input; }
        assert "ocq-03": motif_asf(entity_ref("urn:fr:pf-asf:case:controle-quatrieme-mois-e1"), DEFAUT_SIMPLE) { origin case_input; }
        assert "ocq-04": demande_asf(entity_ref("urn:fr:pf-asf:case:controle-quatrieme-mois-e1")) { origin case_input; }
        assert "ocq-05": manquement_debiteur(entity_ref("urn:fr:pf-asf:case:controle-quatrieme-mois-e1"), @2021-03-01) { origin case_input; }
        assert "ocq-06": mois_ouverture_asf(@2021-04-01) { origin case_input; }
        assert "ocq-07": bmaf_retenu(entity_ref("urn:fr:pf-asf:case:controle-quatrieme-mois"), 400.00 EUR) { origin case_input; }
        assert "ocq-08": mois_controle_4m(@2021-07-01) { origin case_input; }
    }
    evaluate truth(asf_controle_confirme(entity_ref("urn:fr:pf-asf:case:controle-quatrieme-mois-e1")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
