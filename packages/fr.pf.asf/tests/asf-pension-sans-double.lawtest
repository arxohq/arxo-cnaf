// D-29(c), F-CH6-ASF-PENSION-DOUBLE: partial pension 60, request filed, right open: ONLY the differential 52.52 is due; the full single-rate amount 112.52 is not (L. 523-1 I 4).
language "law.core" version "0.2";
package fr.pf.asf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-asf";

test "urn:query:fr-pf-asf-pension-sans-double" {
    given {
        context { deadline_policy PAIEMENT_MENSUEL; decision_time @2021-06-15T12:00:00Z; knowledge_time @2021-06-15T12:00:00Z; legal_time @2021-06-15; timezone "Europe/Paris"; }
        assert "psd-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-asf:case:pension-sans-double"), entity_ref("urn:fr:pf-asf:case:pension-sans-double-e1")) { origin case_input; }
        assert "psd-02": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-asf:case:pension-sans-double-e1")) { origin case_input; }
        assert "psd-03": motif_asf(entity_ref("urn:fr:pf-asf:case:pension-sans-double-e1"), PENSION_PARTIELLE) { origin case_input; }
        assert "psd-04": manquement_debiteur(entity_ref("urn:fr:pf-asf:case:pension-sans-double-e1"), @2021-03-01) { origin case_input; }
        assert "psd-05": mois_ouverture_asf(@2021-04-01) { origin case_input; }
        assert "psd-06": pension_recue(entity_ref("urn:fr:pf-asf:case:pension-sans-double-e1"), 60.00 EUR) { origin case_input; }
        assert "psd-08": demande_asf(entity_ref("urn:fr:pf-asf:case:pension-sans-double-e1")) { origin case_input; }
        assert "psd-07": bmaf_retenu(entity_ref("urn:fr:pf-asf:case:pension-sans-double"), 400.00 EUR) { origin case_input; }
    }
    evaluate truth(asf_differentiel_du(entity_ref("urn:fr:pf-asf:case:pension-sans-double-e1"), 52.52 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(asf_montant_du(entity_ref("urn:fr:pf-asf:case:pension-sans-double-e1"), 112.52 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
