// Eligible default, opening April 2021 after the March default: opening confirmed (R. 523-1, D. 523-1).
language "law.core" version "0.2";
package fr.pf.asf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-asf";

test "urn:query:fr-pf-asf-ouverture-apres-carence" {
    given {
        context { deadline_policy PAIEMENT_MENSUEL; decision_time @2021-06-15T12:00:00Z; knowledge_time @2021-06-15T12:00:00Z; legal_time @2021-06-15; timezone "Europe/Paris"; }
        assert "ooa-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-asf:case:ouverture-apres-carence"), entity_ref("urn:fr:pf-asf:case:ouverture-apres-carence-e1")) { origin case_input; }
        assert "ooa-02": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-asf:case:ouverture-apres-carence-e1")) { origin case_input; }
        assert "ooa-03": motif_asf(entity_ref("urn:fr:pf-asf:case:ouverture-apres-carence-e1"), DEFAUT_SIMPLE) { origin case_input; }
        assert "ooa-04": demande_asf(entity_ref("urn:fr:pf-asf:case:ouverture-apres-carence-e1")) { origin case_input; }
        assert "ooa-05": manquement_debiteur(entity_ref("urn:fr:pf-asf:case:ouverture-apres-carence-e1"), @2021-03-01) { origin case_input; }
        assert "ooa-06": mois_ouverture_asf(@2021-04-01) { origin case_input; }
        assert "ooa-07": bmaf_retenu(entity_ref("urn:fr:pf-asf:case:ouverture-apres-carence"), 400.00 EUR) { origin case_input; }
    }
    evaluate truth(asf_ouverture_confirmee(entity_ref("urn:fr:pf-asf:case:ouverture-apres-carence-e1")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
