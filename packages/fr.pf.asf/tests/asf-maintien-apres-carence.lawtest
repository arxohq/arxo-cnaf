// Default chain confirmed, opening April 2021, assessed May 2021: payment continued (R. 523-3).
language "law.core" version "0.2";
package fr.pf.asf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-asf";

test "urn:query:fr-pf-asf-maintien-apres-carence" {
    given {
        context { deadline_policy PAIEMENT_MENSUEL; decision_time @2021-06-15T12:00:00Z; knowledge_time @2021-06-15T12:00:00Z; legal_time @2021-06-15; timezone "Europe/Paris"; }
        assert "oma-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-asf:case:maintien-apres-carence"), entity_ref("urn:fr:pf-asf:case:maintien-apres-carence-e1")) { origin case_input; }
        assert "oma-02": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-asf:case:maintien-apres-carence-e1")) { origin case_input; }
        assert "oma-03": motif_asf(entity_ref("urn:fr:pf-asf:case:maintien-apres-carence-e1"), DEFAUT_SIMPLE) { origin case_input; }
        assert "oma-04": demande_asf(entity_ref("urn:fr:pf-asf:case:maintien-apres-carence-e1")) { origin case_input; }
        assert "oma-05": manquement_debiteur(entity_ref("urn:fr:pf-asf:case:maintien-apres-carence-e1"), @2021-03-01) { origin case_input; }
        assert "oma-06": mois_ouverture_asf(@2021-04-01) { origin case_input; }
        assert "oma-07": bmaf_retenu(entity_ref("urn:fr:pf-asf:case:maintien-apres-carence"), 400.00 EUR) { origin case_input; }
        assert "oma-08": mois_droit_asf(@2021-05-01) { origin case_input; }
    }
    evaluate truth(asf_maintien_mois(entity_ref("urn:fr:pf-asf:case:maintien-apres-carence-e1"), @2021-05-01));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
