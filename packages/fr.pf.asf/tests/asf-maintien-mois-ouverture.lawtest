// Opening month itself is not continuation: assessed April 2021 for an April opening gives NEITHER.
language "law.core" version "0.2";
package fr.pf.asf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-asf";

test "urn:query:fr-pf-asf-maintien-mois-ouverture" {
    given {
        context { deadline_policy PAIEMENT_MENSUEL; decision_time @2021-06-15T12:00:00Z; knowledge_time @2021-06-15T12:00:00Z; legal_time @2021-06-15; timezone "Europe/Paris"; }
        assert "omo-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-asf:case:maintien-mois-ouverture"), entity_ref("urn:fr:pf-asf:case:maintien-mois-ouverture-e1")) { origin case_input; }
        assert "omo-02": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-asf:case:maintien-mois-ouverture-e1")) { origin case_input; }
        assert "omo-03": motif_asf(entity_ref("urn:fr:pf-asf:case:maintien-mois-ouverture-e1"), DEFAUT_SIMPLE) { origin case_input; }
        assert "omo-04": demande_asf(entity_ref("urn:fr:pf-asf:case:maintien-mois-ouverture-e1")) { origin case_input; }
        assert "omo-05": manquement_debiteur(entity_ref("urn:fr:pf-asf:case:maintien-mois-ouverture-e1"), @2021-03-01) { origin case_input; }
        assert "omo-06": mois_ouverture_asf(@2021-04-01) { origin case_input; }
        assert "omo-07": bmaf_retenu(entity_ref("urn:fr:pf-asf:case:maintien-mois-ouverture"), 400.00 EUR) { origin case_input; }
        assert "omo-08": mois_droit_asf(@2021-04-01) { origin case_input; }
    }
    evaluate truth(asf_maintien_mois(entity_ref("urn:fr:pf-asf:case:maintien-mois-ouverture-e1"), @2021-04-01));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
