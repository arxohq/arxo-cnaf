// Eligible orphan, stated opening April 2021, no default: opening confirmed without carence (D. 523-2).
language "law.core" version "0.2";
package fr.pf.asf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-asf";

test "urn:query:fr-pf-asf-ouverture-hors-etat" {
    given {
        context { deadline_policy PAIEMENT_MENSUEL; decision_time @2021-06-15T12:00:00Z; knowledge_time @2021-06-15T12:00:00Z; legal_time @2021-06-15; timezone "Europe/Paris"; }
        assert "ooh-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-asf:case:ouverture-hors-etat"), entity_ref("urn:fr:pf-asf:case:ouverture-hors-etat-e1")) { origin case_input; }
        assert "ooh-02": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-asf:case:ouverture-hors-etat-e1")) { origin case_input; }
        assert "ooh-03": motif_asf(entity_ref("urn:fr:pf-asf:case:ouverture-hors-etat-e1"), ORPHELIN_UN_PARENT) { origin case_input; }
        assert "ooh-04": demande_asf(entity_ref("urn:fr:pf-asf:case:ouverture-hors-etat-e1")) { origin case_input; }
        assert "ooh-05": mois_ouverture_asf(@2021-04-01) { origin case_input; }
        assert "ooh-06": bmaf_retenu(entity_ref("urn:fr:pf-asf:case:ouverture-hors-etat"), 400.00 EUR) { origin case_input; }
    }
    evaluate truth(asf_ouverture_confirmee(entity_ref("urn:fr:pf-asf:case:ouverture-hors-etat-e1")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
