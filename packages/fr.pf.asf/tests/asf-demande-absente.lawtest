// Single default with carence served but no request: nothing opens (R. 523-2, NEITHER probe).
language "law.core" version "0.2";
package fr.pf.asf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-asf";

test "urn:query:fr-pf-asf-demande-absente" {
    given {
        context { deadline_policy PAIEMENT_MENSUEL; decision_time @2021-06-15T12:00:00Z; knowledge_time @2021-06-15T12:00:00Z; legal_time @2021-06-15; timezone "Europe/Paris"; }
        assert "oda-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-asf:case:demande-absente"), entity_ref("urn:fr:pf-asf:case:demande-absente-e1")) { origin case_input; }
        assert "oda-02": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-asf:case:demande-absente-e1")) { origin case_input; }
        assert "oda-03": motif_asf(entity_ref("urn:fr:pf-asf:case:demande-absente-e1"), DEFAUT_SIMPLE) { origin case_input; }
        assert "oda-04": manquement_debiteur(entity_ref("urn:fr:pf-asf:case:demande-absente-e1"), @2021-03-01) { origin case_input; }
        assert "oda-05": mois_ouverture_asf(@2021-04-01) { origin case_input; }
        assert "oda-06": bmaf_retenu(entity_ref("urn:fr:pf-asf:case:demande-absente"), 400.00 EUR) { origin case_input; }
    }
    evaluate truth(asf_enfant_eligible(entity_ref("urn:fr:pf-asf:case:demande-absente-e1")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
