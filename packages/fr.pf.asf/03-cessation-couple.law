    CSS_R523_5_ED2017_04,
    CSS_R523_5_ED2018_04,
    CSS_R523_5_ED2018_07,
    CSS_R523_5_ED2018_07_27,
    CSS_R523_5_ED2019_12,
    CSS_R523_5_ED2021_12,
    CSS_R523_5_ED2022_11,
    CSS_R523_6,
    CSS_R523_6_ED1999_11,
    CSS_R523_6_ED2011_12,
    CSS_R523_6_ED2014_04,
    CSS_R523_6_ED2015_04,
    CSS_R523_6_ED2016_04,
    CSS_R523_6_ED2017_04,
    CSS_R523_6_ED2018_04,
    CSS_R523_6_ED2018_07,
    CSS_R523_6_ED2018_07_27,
    CSS_R523_6_ED2019_12,
    CSS_R523_6_ED2021_12,
    CSS_R523_6_ED2022_11,
    asf_cessation_couple,
    mois_cessation_couple,
    mois_droit_asf,
};

@source(
    CSS_L523_2,
    CSS_L523_2_ED2011_12,
    CSS_L523_2_ED2014_04,
    CSS_L523_2_ED2015_04,
    CSS_L523_2_ED2016_04,
    CSS_L523_2_ED2017_04,
    CSS_L523_2_ED2018_04,
    CSS_L523_2_ED2018_07,
    CSS_L523_2_ED2018_07_27,
    CSS_L523_2_ED2019_12,
    CSS_L523_2_ED2021_12,
    CSS_L523_2_ED2022_11,
    CSS_R523_4,
    CSS_R523_4_ED1999_11,
    CSS_R523_4_ED2011_12,
    CSS_R523_4_ED2014_04,
    CSS_R523_4_ED2015_04,
    CSS_R523_4_ED2016_04,
    CSS_R523_4_ED2017_04,
