    CSS_L523_3_ED2016_04,
    CSS_L523_3_ED2017_04,
    CSS_L523_3_ED2018_04,
    CSS_L523_3_ED2018_07,
    CSS_L523_3_ED2018_07_27,
    CSS_L523_3_ED2019_12,
    CSS_L523_3_ED2021_12,
    CSS_L523_3_ED2022_11,
    CSS_R523_7,
    CSS_R523_7_PRE2015,
    CSS_R523_7_PRE2016,
    CSS_R523_7_PRE2017,
    CSS_R523_7_PRE2018,
    CSS_R523_7_PRE2022,
    CSS_R523_7_PRE2022_ED2018_07,
    CSS_R523_7_PRE2022_ED2018_07_27,
    CSS_R523_7_PRE2022_ED2019_12,
    CSS_R523_7_PRE2022_ED2021_12)
rule MontantDoubleDefaut2022(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, bmaf: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "defaillance des deux debiteurs: taux double de la base mensuelle en vigueur, 37,5 % avant novembre 2022 puis 56,25 % (L. 523-1 5° avant 2022-11, 3° ensuite; R. 523-7)";
    label en unofficial "double debtor default: double rate of the monthly base in force, 37.5% before November 2022 then 56.25% (L. 523-1 5th before 2022-11, 3rd after; R. 523-7)";
    when asf_enfant_eligible(e) and fr.pf.core::parent_charge(p, e)
        and motif_asf(e, DEFAUT_DOUBLE) and bmaf_retenu(p, bmaf);
    then asf_montant_du(e, round(TauxAsfDoubleOrphelin * bmaf, 2, "HALF_UP"));
}

@source(
    CSS_D523_3,
    CSS_D523_3_ED2018_07_27,
    CSS_D523_3_ED2019_12,
    CSS_D523_3_ED2021_12,
    CSS_D523_3_ED2022_11,
    CSS_L523_1,
    CSS_L523_1_ED2022_11,
    CSS_L523_1_PRE2019,
    CSS_L523_1_PRE2019_ED2018_07,
    CSS_L523_1_PRE2019_ED2018_07_27,
    CSS_L523_1_PREV,
    CSS_L523_3,
    CSS_L523_3_ED1999_11,
    CSS_L523_3_ED2011_12,
    CSS_L523_3_ED2014_04,
    CSS_L523_3_ED2015_04,
    CSS_L523_3_ED2016_04,
    CSS_L523_3_ED2017_04,
    CSS_L523_3_ED2018_04,
    CSS_L523_3_ED2018_07,
    CSS_L523_3_ED2018_07_27,
    CSS_L523_3_ED2019_12,
    CSS_L523_3_ED2021_12,
    CSS_L523_3_ED2022_11,
    CSS_R523_1,
    CSS_R523_1_ED2018_04,
    CSS_R523_1_ED2018_07,
    CSS_R523_1_ED2018_07_27,
    CSS_R523_1_ED2019_12,
    CSS_R523_1_ED2021_12,
    CSS_R523_1_ED2022_11)
rule DifferentielPartiel(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, pension: Money, manq: Date, m0: Date, bmaf: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "pension sous le taux simple, delai purge: differentiel brut, voie autonome sans droit ouvert ni demande (L. 523-1 4°)";
    label en unofficial "pension below the single rate, period served: gross differential, standalone track with no open right or request (L. 523-1 4°)";
    when fr.pf.core::parent_charge(p, e) and fr.pf.core::enfant_ouvre_droit(e)
        and motif_asf(e, PENSION_PARTIELLE)
        and manquement_debiteur(e, manq) and mois_ouverture_asf(m0)
        and m0 >= add_calendar_period(manq, 1 calendar_month)
        and pension_recue(e, pension) and bmaf_retenu(p, bmaf)
        and pension < TauxAsfSimple * bmaf;
    then asf_differentiel_du(e, TauxAsfSimple * bmaf - pension);
}
