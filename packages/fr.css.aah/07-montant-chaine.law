rule MontantAahSaisiConformeConstruit(s: Money, c: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "le montant fourni pour l'espèce est égal au montant construit par la chaîne L. 161-25";
    label en unofficial "the case-supplied amount equals the amount built by the L. 161-25 chain";
    when montant_mensuel_retenu(s) and aah_montant_construit(c) and s == c;
    then aah_saisi_conforme_construit();
}

@source(
    LOI_2022_1158_ART9,
    DSS_SD2B_2020_33_COEFF,
    DSS_2B_2021_65_COEFF,
    DSS_2B_2022_82_COEFF,
