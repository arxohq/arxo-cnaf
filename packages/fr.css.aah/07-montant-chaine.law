@source(
    CSS_L821_3_1_ED2021_01_01,
    CSS_L821_3_1_ED2021_05_01,
    CSS_L821_3_1_ED2021_12_03,
    CSS_L821_3_1_ED2022_01_01,
    CSS_L821_3_1_ED2022_01_21,
    CSS_L821_3_1_ED2022_06_17,
    CSS_L821_3_1_ED2023_01_01,
    CSS_L821_3_1_ED2023_09_01,
    CSS_L821_3_1_ED2023_10_01,
    CSS_L821_3_1_ED2024_12_01,
    CSS_L821_3_1_ED2025_08_28,
    CSS_L821_3_1_ED2026_01_01,
    CSS_L821_3_1_ED2026_06_28,
    CSS_L821_3_1_ED2026_07_23)
rule MontantAahConformePublie(p: Money, c: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "le montant construit par la chaîne L. 161-25 est égal au montant publié du décret";
    label en unofficial "the amount built by the L. 161-25 chain equals the decree's published amount";
    when aah_montant_publie(p) and aah_montant_construit(c) and p == c;
    then aah_montant_conforme_publie();
}

