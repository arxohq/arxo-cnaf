    CSS_R821_4_PRE2022_ED2022_01_01,
    CSS_R821_4_PRE2023_ED2022_06_17,
    CSS_R821_4_PRE2025_ED2023_01_01,
    CSS_R821_4_PRE2025_ED2023_09_01,
    CSS_R821_4_PRE2025_ED2023_10_01,
    CSS_R821_4_PRE2025_ED2024_12_01,
    CSS_R821_4_PRE2026_ED2025_08_28,
    CSS_R821_4_PRE2026_ED2026_01_01,
    Personne,
    aah_droit_calcule,
    aah_montant_ancien,
    aah_montant_nouveau,
    en_couple,
    enfants_charge,
    lecture_douzieme_tiers_arrondis,
    montant_aah_applicable,
    percoit_revenu_activite,
    personne_seule,
    ressources_annuelles_retenues,
    ressources_conjoint_retenues,
    ressources_trimestrielles_retenues,
    sans_revenu_activite,
};

function plafond_nouveau_annuel(m: Money, n: Integer) -> Money =
    12.0 * m + 12.0 * m * MajorationPlafondEnfant * n;

function plafond_nouveau_trimestriel(m: Money, n: Integer) -> Money =
    3.0 * m + 3.0 * m * MajorationPlafondEnfant * n;

function plafond_ancien_couple_annuel(m: Money, n: Integer) -> Money =
    12.0 * m * (1.0 + MajorationPlafondCoupleAncien) + 12.0 * m * MajorationPlafondEnfant * n;

function plafond_ancien_couple_trimestriel(m: Money, n: Integer) -> Money =
    3.0 * m * (1.0 + MajorationPlafondCoupleAncien) + 3.0 * m * MajorationPlafondEnfant * n;

// --- Current rules: annual track (R. 821-4) -------------------------------

@source(
    CSS_L821_3_ED2023_10_01,
    CSS_L821_3_ED2024_12_01,
    CSS_L821_3_ED2025_08_28,
    CSS_L821_3_ED2026_01_01,
    CSS_L821_3_ED2026_06_28,
    CSS_L821_3_ED2026_07_23,
    CSS_D821_2_ED2023_10_01,
    CSS_D821_2_ED2024_12_01,
    CSS_D821_2_ED2025_08_28,
    CSS_D821_2_ED2026_01_01,
    CSS_D821_2_ED2026_06_28,
    CSS_D821_2_ED2026_07_23,
    CSS_R821_4_PRE2025_ED2023_10_01,
    CSS_R821_4_PRE2025_ED2024_12_01,
    CSS_R821_4_PRE2026_ED2025_08_28,
    CSS_R821_4_PRE2026_ED2026_01_01,
    CSS_R821_4_ED2026_06_28,
    CSS_R821_4_ED2026_07_23)
rule MontantNouveauAnnuel(p: Personne, m: Money, r: Money, n: Integer) strict {
    effective [@2023-10-01, infinity);
    label fr official "montant nouveau, régime annuel: douzième de (plafond − ressources annuelles), au plus le montant mensuel";
    label en unofficial "current amount, annual track: twelfth of (ceiling - annual resources), at most the monthly amount";
    when aah_droit_calcule(p) and sans_revenu_activite(p) and montant_aah_applicable(m) and ressources_annuelles_retenues(p, r) and enfants_charge(n) and r < plafond_nouveau_annuel(m, n) and not_known(lecture_douzieme_tiers_arrondis());
    then aah_montant_nouveau(p, min(m, (plafond_nouveau_annuel(m, n) - r) / 12.0));
}

// --- Current rules: quarterly track (R. 821-4-1) --------------------------

@source(
