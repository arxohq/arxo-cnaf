rule MontantAncienAnnuelCoupleArrondi(p: Personne, m: Money, r1: Money, r2: Money, n: Integer) strict {
    effective [@2021-01-01, infinity);
    label fr official "montant ancien, régime annuel, couple: plafond majoré de 81 %, ressources du couple, arrondi au centime (lecture D-82)";
    label en unofficial "former amount, annual track, couple: 81% higher ceiling, couple resources, rounded to the centime (reading D-82)";
    when aah_droit_calcule(p) and sans_revenu_activite(p) and en_couple(p) and montant_aah_applicable(m) and ressources_annuelles_retenues(p, r1) and ressources_conjoint_retenues(p, r2) and enfants_charge(n) and r1 + r2 < plafond_ancien_couple_annuel(m, n);
    then aah_montant_ancien(p, min(m, div_round(plafond_ancien_couple_annuel(m, n) - (r1 + r2), 12.0, 2, "HALF_UP")));
}

