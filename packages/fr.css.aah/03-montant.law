    CSS_R821_4_1_ED2026_06_28,
    CSS_R821_4_1_ED2026_07_23)
rule MontantNouveauTrimestriel(p: Personne, m: Money, r: Money, n: Integer) strict {
    effective [@2023-10-01, infinity);
    label fr official "montant nouveau, régime trimestriel: tiers de (plafond − ressources trimestrielles), au plus le montant mensuel";
    label en unofficial "current amount, quarterly track: third of (ceiling - quarterly resources), at most the monthly amount";
    when aah_droit_calcule(p) and percoit_revenu_activite(p) and montant_aah_applicable(m) and ressources_trimestrielles_retenues(p, r) and enfants_charge(n) and r < plafond_nouveau_trimestriel(m, n) and not_known(lecture_douzieme_tiers_arrondis());
    then aah_montant_nouveau(p, min(m, (plafond_nouveau_trimestriel(m, n) - r) / 3.0));
}

