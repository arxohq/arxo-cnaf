    CSS_D821_2_PRE2023_ED2022_06_17,
    CSS_D821_2_PRE2023_ED2023_01_01,
    CSS_D821_2_PRE2023_ED2023_09_01)
pub interpretation DouziemeTiersArrondiCentime of CSS_D821_2_ED2026_07_23 {
    status disputed;
    label fr official "lecture : le douzième (régime annuel) et le tiers (régime trimestriel) de la différence entre le plafond et les ressources, D. 821-2 al. 3, si la division n'est pas exacte, sont arrondis au centime, demi vers le haut — pratique des caisses (CNAF) ; ni la D. 821-2 ni la L. 821-3-1 ne fixent d'arrondi";
    label en unofficial "reading: the twelfth (annual track) and the third (quarterly track) of the difference between the ceiling and the resources, D. 821-2 para. 3, where the division is not exact, are rounded to the centime, half up - fund (CNAF) practice; neither D. 821-2 nor L. 821-3-1 states a rounding";
    include LectureDouziemeTiersArrondis;
    include MontantNouveauAnnuelArrondi;
    include MontantNouveauTrimestrielArrondi;
    include MontantAncienAnnuelCoupleArrondi;
    include MontantAncienAnnuelSeulArrondi;
    include MontantAncienTrimestrielCoupleArrondi;
    include MontantAncienTrimestrielSeulArrondi;
}
