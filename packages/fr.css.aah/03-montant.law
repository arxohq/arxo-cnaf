// --- Reading D-82/D-83: douzième and tiers of D. 821-2, rounded to the centime ---
//
// D. 821-2 al. 3: «une allocation égale au douzième de la différence entre le
// montant du plafond applicable et les ressources annuelles» (R. 821-4 track),
// «au tiers de la différence» for the quarterly track (R. 821-4-1). Neither the
// article nor the decrees state a rounding. The base rules above divide exactly:
// a quotient that does not terminate (an eighth place and beyond, a twelfth or a
// third of a figure of more than two places) makes the document NON_EXECUTABLE
// (INEXACT_DIVISION, SPEC 50/18: rounding only by an explicit policy). The
// rounding is not a text of the law but a READING (SPEC 152, owner decisions
// D-82 / D-83, 08.10.2026): the basis is the practice of the funds (CNAF),
// under which the intermediate value (the quotient, the monthly amount before
// the cap at the monthly amount M) is rounded to the centime, HALF_UP. The
// reading is outside any group: unselected it executes nothing and changes no
// answer; selected (context { interpretation fr.css.aah::DouziemeTiersArrondiCentime; })
// it replaces the exact division by div_round(difference, 12.0 | 3.0, 2, "HALF_UP")
// in all six rules, and the marker silences the exact-division rules (not_known),
// so each head carries ONE value under either choice. The reading rounds ALWAYS
// when selected, also where the exact quotient is longer than two places (as the
// funds do); where the quotient is already in centimes the two give the same value.
// The cap min(m, ·) comes after the rounding: M is itself a centime figure.

@source(
    CSS_D821_2_ED2023_10_01,
    CSS_D821_2_ED2024_12_01,
    CSS_D821_2_ED2025_08_28,
    CSS_D821_2_ED2026_01_01,
    CSS_D821_2_ED2026_06_28,
    CSS_D821_2_ED2026_07_23,
    CSS_D821_2_PRE2023_ED2021_01_01,
    CSS_D821_2_PRE2023_ED2021_05_01,
    CSS_D821_2_PRE2023_ED2021_12_03,
    CSS_D821_2_PRE2023_ED2022_01_01,
    CSS_D821_2_PRE2023_ED2022_01_21,
    CSS_D821_2_PRE2023_ED2022_06_17,
    CSS_D821_2_PRE2023_ED2023_01_01,
    CSS_D821_2_PRE2023_ED2023_09_01)
rule LectureDouziemeTiersArrondis() strict {
    effective [@2021-01-01, infinity);
    label fr official "lecture retenue : le douzième et le tiers de la différence (D. 821-2 al. 3) sont arrondis au centime (marqueur)";
    label en unofficial "selected reading: the twelfth and the third of the difference (D. 821-2 para. 3) are rounded to the centime (marker)";
    when true;
    then lecture_douzieme_tiers_arrondis();
}

@source(
    CSS_L821_3_ED2023_10_01,
    CSS_L821_3_ED2024_12_01,
    CSS_L821_3_ED2025_08_28,
    CSS_L821_3_ED2026_01_01,
    CSS_L821_3_ED2026_06_28,
    CSS_L821_3_ED2026_07_23,
    CSS_D821_2_ED2023_10_01,
    CSS_D821_2_ED2024_12_01,
    CSS_D821_2_ED2025_08_28,
    CSS_D821_2_ED2026_01_01,
    CSS_D821_2_ED2026_06_28,
    CSS_D821_2_ED2026_07_23,
    CSS_R821_4_PRE2025_ED2023_10_01,
    CSS_R821_4_PRE2025_ED2024_12_01,
    CSS_R821_4_PRE2026_ED2025_08_28,
    CSS_R821_4_PRE2026_ED2026_01_01,
    CSS_R821_4_ED2026_06_28,
    CSS_R821_4_ED2026_07_23)
rule MontantNouveauAnnuelArrondi(p: Personne, m: Money, r: Money, n: Integer) strict {
    effective [@2023-10-01, infinity);
    label fr official "montant nouveau, régime annuel: douzième de (plafond − ressources annuelles), au plus le montant mensuel, arrondi au centime (lecture D-82)";
    label en unofficial "current amount, annual track: twelfth of (ceiling - annual resources), at most the monthly amount, rounded to the centime (reading D-82)";
    when aah_droit_calcule(p) and sans_revenu_activite(p) and montant_aah_applicable(m) and ressources_annuelles_retenues(p, r) and enfants_charge(n) and r < plafond_nouveau_annuel(m, n);
    then aah_montant_nouveau(p, min(m, div_round(plafond_nouveau_annuel(m, n) - r, 12.0, 2, "HALF_UP")));
}

