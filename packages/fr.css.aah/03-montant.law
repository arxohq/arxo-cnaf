rule MontantNouveauTrimestrielArrondi(p: Personne, m: Money, r: Money, n: Integer) strict {
    effective [@2023-10-01, infinity);
    label fr official "montant nouveau, régime trimestriel: tiers de (plafond − ressources trimestrielles), au plus le montant mensuel, arrondi au centime (lecture D-82)";
    label en unofficial "current amount, quarterly track: third of (ceiling - quarterly resources), at most the monthly amount, rounded to the centime (reading D-82)";
    when aah_droit_calcule(p) and percoit_revenu_activite(p) and montant_aah_applicable(m) and ressources_trimestrielles_retenues(p, r) and enfants_charge(n) and r < plafond_nouveau_trimestriel(m, n);
    then aah_montant_nouveau(p, min(m, div_round(plafond_nouveau_trimestriel(m, n) - r, 3.0, 2, "HALF_UP")));
}

