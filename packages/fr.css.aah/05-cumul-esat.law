    CSS_D821_5_PRE2023_ED2023_09_01)
rule EsatAncienDirectSeulEnfant(p: Personne, a: Money, g: Money, s: Money) strict {
    effective [@2021-01-01, @2023-10-01);
    label fr official "ESAT, rédaction antérieure, personne seule avec enfant ou ascendant: cumul plafonné à 115 % du SMIC brut";
    label en unofficial "sheltered work, former direct wording, single person with child or ascendant: joint amount capped at 115% of gross SMIC";
    when aah_montant_ancien(p, a) and remuneration_garantie_retenue(p, g) and smic_brut_mensuel_retenu(s) and personne_seule(p) and majoration_enfant_esat();
    then aah_montant_du(p, min(a, cap_esat_nouveau_enfant(s) - g));
}

