// --- New wording (from 01.10.2023, no maintenance) --------------------------

@source(
    CSS_D821_5_ED2023_10_01,
    CSS_D821_5_ED2024_12_01,
    CSS_D821_5_ED2025_08_28,
    CSS_D821_5_ED2026_01_01,
    CSS_D821_5_ED2026_06_28,
    CSS_D821_5_ED2026_07_23)
rule EsatNouveau(p: Personne, n: Money, g: Money, s: Money) strict {
    effective [@2023-10-01, infinity);
    label fr official "ESAT, rédaction en vigueur, sans enfant: cumul plafonné à 100 % du SMIC brut";
    label en unofficial "sheltered work, current wording, no children: joint amount capped at 100% of gross SMIC";
    when aah_montant_nouveau(p, n) and remuneration_garantie_retenue(p, g) and smic_brut_mensuel_retenu(s) and not_known(aah_maintien_ancien_calcul(p)) and not_known(majoration_enfant_esat());
    then aah_montant_du(p, min(n, cap_esat_nouveau(s) - g));
}

@source(
    CSS_D821_5_ED2023_10_01,
    CSS_D821_5_ED2024_12_01,
    CSS_D821_5_ED2025_08_28,
    CSS_D821_5_ED2026_01_01,
    CSS_D821_5_ED2026_06_28,
    CSS_D821_5_ED2026_07_23)
rule EsatNouveauEnfant(p: Personne, n: Money, g: Money, s: Money) strict {
    effective [@2023-10-01, infinity);
    label fr official "ESAT, rédaction en vigueur, avec enfant ou ascendant: cumul plafonné à 115 % du SMIC brut";
    label en unofficial "sheltered work, current wording, with child or ascendant: joint amount capped at 115% of gross SMIC";
    when aah_montant_nouveau(p, n) and remuneration_garantie_retenue(p, g) and smic_brut_mensuel_retenu(s) and not_known(aah_maintien_ancien_calcul(p)) and majoration_enfant_esat();
    then aah_montant_du(p, min(n, cap_esat_nouveau_enfant(s) - g));
}
