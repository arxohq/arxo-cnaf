rule TeteDroit80(p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "tête de calcul: filière 80 % ouvre le droit au niveau calcul";
    label en unofficial "computation head: 80% track opens the computation-level right";
    when aah_droit_80(p);
    then aah_droit_calcule(p);
}

