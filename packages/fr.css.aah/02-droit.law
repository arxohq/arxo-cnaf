rule Droit5079(p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "droit filière 50-79 %: décision CDAPH, RSDAE reconnue, âge dépassé, résidence permanente, séjour régulier";
    label en unofficial "50-79% track: CDAPH decision, recognised RSDAE, age passed, permanent residence, regular stay";
    when decision_cdaph_50_79(p) and rsdae_reconnue(p) and age_droit_depasse(p) and residence_permanente(p) and sejour_regulier(p);
    then aah_droit_50_79(p);
}

