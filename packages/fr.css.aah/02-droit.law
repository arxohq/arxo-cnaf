    CSS_L821_4_ED2026_06_28,
    CSS_L821_4_ED2026_07_23)
rule Droit80(p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "droit filière 80 % et plus: décision CDAPH, âge dépassé, résidence permanente, séjour régulier";
    label en unofficial "80% and over track: CDAPH decision, age passed, permanent residence, regular stay";
    when decision_cdaph_80(p) and age_droit_depasse(p) and residence_permanente(p) and sejour_regulier(p);
    then aah_droit_80(p);
}

