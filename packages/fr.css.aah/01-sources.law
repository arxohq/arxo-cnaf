@id("urn:fr:corpus:clir:aah#CSS_L821_8_ED2021_01_01")
pub fragment CSS_L821_8_ED2021_01_01 in CSS_ED2021_01_01 {
    kind article;
    locator "article/L821-8";
    text fr official """Article L821-8
Des dispositions réglementaires déterminent, en tant que de besoin, les modalités d'application du présent titre. Sauf disposition contraire, elles sont prises par décret en Conseil d'Etat.
""";
    content_hash "sha256:3d21f3e6d4b243885769452f4d134b542028ccad50346889f398ba4b3b5237e5";
}

