// Provenance S1: disabled-adults allowance (CSS, livre VIII,
// titre II: L. 821-1..8, R. 821-1..9, D. 821-1..11 in ownership;
// modelled: L. 821-1/2 (tracks), L. 821-3/3-1 + D. 821-2 (amount),
// L. 821-4 (CDAPH channel), L. 821-5 (recovery ref, unmodelled),
// L. 821-8 (application decrees), D. 821-1 (80/50 %), D. 821-5
// (ESAT cap), R. 821-4/4-1/4-2 (resource regimes), R. 821-4-5
// (recipient duties); JORF: decree 2022-1694 arts 2-3 (double
// calculation, irreversible switch) and decree 2023-360 arts 2-3
// (entry into force 2023-10-01). Block generated by
// tools/build_sources.py from the registries .scratch/reg-css.json,
// .scratch/reg-JORFTEXT000046830041.json and
// .scratch/reg-JORFTEXT000047541289.json (cut 2026-10-06; alineas
// and versions from the DILA LEGI mirror). Do not edit by hand.
//
// Coverage D-01 from 2021-01-01. Editions run back to back from
// the coverage start through every pinned debut. The 2023-10-01
// reform (loi 2022-1158 art. 10, decrees 2022-1694/2023-360)
// splits L. 821-3, D. 821-2 and D. 821-5 into PRE2023/current
// wordings; decree 2026-547 splits R. 821-4/4-1/4-2 from
// 2026-06-28. NOTA joins the fragment only where it carries
// applicability (L821-3, D821-2, D821-5); see sources/articles.json.
// The monthly euro amount chain (L. 821-3-1, L. 161-25) comes from
// sources/montant/ (tools/pin_montant.py): block "amount chain" at the
// end of this file (decrees, DSS coefficient paragraphs, act 2022-1158).


language "law.core" version "0.2";
package fr.css.aah version "0.1.0";
namespace "urn:fr:corpus:clir:aah";

source CSS {
    kind code;
    jurisdiction FR;
    label fr official "Code de la sécurité sociale";
    label en unofficial "French Social Security Code";
}

source JORF {
    kind official_journal;
    jurisdiction FR;
    label fr official "Journal officiel de la République française";
    label en unofficial "Official Journal of the French Republic";
}

