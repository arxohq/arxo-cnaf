    content_hash "sha256:a162443ef95a4b3882c21d99dcb3123e879ed4a8bfadc380e1fc4cc1aee7df35";
    local_path "sources/montant/dss-2022-82-coeff.txt";
}

@id("urn:fr:corpus:clir:aah#DSS_2B_2022_82_COEFF")
pub fragment DSS_2B_2022_82_COEFF in DSS_2B_2022_82_COEFF_ED {
    kind guidance;
    locator "instruction/dss-2b-2022-82/coefficient";
    text fr official """        Au 1er avril 2022, le coefficient de revalorisation de la base mensuelle de calcul des
allocations familiales (BMAF) est ainsi fixé à 1,018 soit un taux de revalorisation de la BMAF
de 1,8 %. Le montant de cette base mensuelle, en pourcentage duquel sont fixées les
prestations familiales, est donc porté de 414,81 € au 1er avril 2021 à 422,28 € au 1er avril 2022.
""";
    content_hash "sha256:a162443ef95a4b3882c21d99dcb3123e879ed4a8bfadc380e1fc4cc1aee7df35";
}

