    retrieved_at @2026-10-08T00:00:00Z;
    content_hash "sha256:8b1c68735fb331b322a0365ec0ea5c622c832ea099918e1277960e8dd82deac2";
    local_path "sources/montant/dss-2021-65-coeff.txt";
}

@id("urn:fr:corpus:clir:aah#DSS_2B_2021_65_COEFF")
pub fragment DSS_2B_2021_65_COEFF in DSS_2B_2021_65_COEFF_ED {
    kind guidance;
    locator "instruction/dss-2b-2021-65/coefficient";
    text fr official """        Au 1er avril 2021, le coefficient de revalorisation de la BMAF est ainsi fixé à 1,001 soit un taux
de revalorisation de la BMAF de 0,1 %. Le montant de cette base mensuelle, en pourcentage duquel
sont fixées les prestations familiales, est donc porté de 414,4 € au 1er avril 2020 à 414,81 € au 1er
avril 2021.
""";
    content_hash "sha256:8b1c68735fb331b322a0365ec0ea5c622c832ea099918e1277960e8dd82deac2";
}

