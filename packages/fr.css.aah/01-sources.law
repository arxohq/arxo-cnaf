    language fr;
    officiality official;
    materialization_status PINNED_UNOFFICIAL_COPY;
    in_force [@2021-01-01, infinity);
    label fr official "DSS/SD2B/2020/33 : paragraphe du coefficient L. 161-25 au 1er avril (octets de fr.css.revalorisation)";
    label en unofficial "DSS/SD2B/2020/33: L. 161-25 coefficient paragraph for 1 April (bytes of fr.css.revalorisation)";
}

publication DSS_SD2B_2020_33_COEFF_ED_TEXT of DSS_SD2B_2020_33_COEFF_ED {
    media_type "text/plain; charset=utf-8";
    uri "https://web.archive.org/web/20230119222325id_/https://sante.gouv.fr/fichiers/bo/2020/20-02/ste_20200002_0000_0046.pdf";
    retrieved_at @2026-10-08T00:00:00Z;
    content_hash "sha256:30203bc31e0b46ec177a182e45334c5e037595a6e4423f527463f7f51f381ded";
    local_path "sources/montant/dss-2020-33-coeff.txt";
}

@id("urn:fr:corpus:clir:aah#DSS_SD2B_2020_33_COEFF")
pub fragment DSS_SD2B_2020_33_COEFF in DSS_SD2B_2020_33_COEFF_ED {
    kind guidance;
    locator "instruction/dss-sd2b-2020-33/coefficient";
    text fr official """Au titre de l’année 2020, l’article 81 de la loi du 24 décembre 2019 de financement de la sécurité
sociale a prévu, par dérogation aux dispositions de l’article L. 161-25, une revalorisation de 0,3 %
du montant des prestations relevant de cet article.
   Le montant précité de la base mensuelle de calcul des allocations familiales (BMAF), en pourcen-
tage duquel sont fixés les montants des prestations familiales, est ainsi porté de 413,16 € à 414,4 €
au 1er avril 2020.
""";
    content_hash "sha256:30203bc31e0b46ec177a182e45334c5e037595a6e4423f527463f7f51f381ded";
}

