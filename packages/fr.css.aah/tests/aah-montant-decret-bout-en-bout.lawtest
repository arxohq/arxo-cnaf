// От декрета до суммы дела (L. 821-3-1 + D. 821-2 в редакции с 01.10.2023): одинокий заявитель, 80 % и выше,
// без ресурсов, годовой режим; число дела не подаётся — сумма берётся из закреплённого декрета окна.
language "law.core" version "0.2";
package fr.css.aah version "0.1.0";
namespace "urn:fr:corpus:clir:aah";

// 2023-12-15: aah_montant_nouveau = 971.37 EUR (décret du mois d'avril 2023)
test "urn:query:fr-css-aah-bout-2023" {
    given {
        context { decision_time @2023-12-15T12:00:00Z; knowledge_time @2023-12-15T12:00:00Z; legal_time @2023-12-15; timezone "Europe/Paris"; }
        assert "bout-2023-01": decision_cdaph_80(entity_ref("urn:fr:css-aah:case:bout-2023")) { origin case_input; }
        assert "bout-2023-02": age_droit_depasse(entity_ref("urn:fr:css-aah:case:bout-2023")) { origin case_input; }
        assert "bout-2023-03": residence_permanente(entity_ref("urn:fr:css-aah:case:bout-2023")) { origin case_input; }
        assert "bout-2023-04": sejour_regulier(entity_ref("urn:fr:css-aah:case:bout-2023")) { origin case_input; }
        assert "bout-2023-05": sans_revenu_activite(entity_ref("urn:fr:css-aah:case:bout-2023")) { origin case_input; }
        assert "bout-2023-06": personne_seule(entity_ref("urn:fr:css-aah:case:bout-2023")) { origin case_input; }
        assert "bout-2023-07": ressources_annuelles_retenues(entity_ref("urn:fr:css-aah:case:bout-2023"), 0.00 EUR) { origin case_input; }
        assert "bout-2023-08": enfants_charge(0) { origin case_input; }
    }
    evaluate truth(aah_montant_nouveau(entity_ref("urn:fr:css-aah:case:bout-2023"), 971.37 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

