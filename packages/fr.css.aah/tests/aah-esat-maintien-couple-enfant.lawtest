// ESAT under maintenance (2024): couple, one child, own annual resources
// 9000.00, spouse 3000.00. Former figure min(1000.00, (27720.00 -
// 12000.00) / 12) = 1000.00; current figure min(1000.00, (18000.00 -
// 9000.00) / 12) = 750.00: maintenance applies. Former couple+child cap
// 1800.00 x 1.45 = 2610.00, guaranteed pay 2000.00: 2610.00 - 2000.00 =
// 610.00 due.
language "law.core" version "0.2";
package fr.css.aah version "0.1.0";
namespace "urn:fr:corpus:clir:aah";

test "urn:query:fr-css-aah-esat-maintien-couple-enfant" {
    given {
        context { decision_time @2024-06-15T12:00:00Z; knowledge_time @2024-06-15T12:00:00Z; legal_time @2024-06-15; timezone "Europe/Paris"; }
        assert "es3-01": decision_cdaph_80(entity_ref("urn:fr:css-aah:case:esat-3")) { origin adjudicated; }
        assert "es3-02": age_droit_depasse(entity_ref("urn:fr:css-aah:case:esat-3")) { origin case_input; }
        assert "es3-03": residence_permanente(entity_ref("urn:fr:css-aah:case:esat-3")) { origin case_input; }
        assert "es3-04": sejour_regulier(entity_ref("urn:fr:css-aah:case:esat-3")) { origin case_input; }
        assert "es3-05": sans_revenu_activite(entity_ref("urn:fr:css-aah:case:esat-3")) { origin case_input; }
        assert "es3-06": en_couple(entity_ref("urn:fr:css-aah:case:esat-3")) { origin case_input; }
        assert "es3-07": beneficiaire_au_1er_octobre_2023(entity_ref("urn:fr:css-aah:case:esat-3")) { origin case_input; }
        assert "es3-08": montant_mensuel_retenu(1000.00 EUR) { origin case_input; }
        assert "es3-09": ressources_annuelles_retenues(entity_ref("urn:fr:css-aah:case:esat-3"), 9000.00 EUR) { origin case_input; }
        assert "es3-10": ressources_conjoint_retenues(entity_ref("urn:fr:css-aah:case:esat-3"), 3000.00 EUR) { origin case_input; }
        assert "es3-11": ressources_trimestrielles_retenues(entity_ref("urn:fr:css-aah:case:esat-3"), 0.00 EUR) { origin case_input; }
        assert "es3-12": enfants_charge(1) { origin case_input; }
        assert "es3-13": remuneration_garantie_retenue(entity_ref("urn:fr:css-aah:case:esat-3"), 2000.00 EUR) { origin case_input; }
        assert "es3-14": smic_brut_mensuel_retenu(1800.00 EUR) { origin case_input; }
    }
    evaluate truth(aah_maintien_ancien_calcul(entity_ref("urn:fr:css-aah:case:esat-3")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(aah_montant_du(entity_ref("urn:fr:css-aah:case:esat-3"), 610.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
