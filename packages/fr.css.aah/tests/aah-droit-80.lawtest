// 80 %+ track: commission decision at 80 %, age passed, permanent
// residence, regular stay. Right opens on the L. 821-1 track.
language "law.core" version "0.2";
package fr.css.aah version "0.1.0";
namespace "urn:fr:corpus:clir:aah";

test "urn:query:fr-css-aah-droit-80" {
    given {
        context { decision_time @2024-06-15T12:00:00Z; knowledge_time @2024-06-15T12:00:00Z; legal_time @2024-06-15; timezone "Europe/Paris"; }
        assert "droit80-01": decision_cdaph_80(entity_ref("urn:fr:css-aah:case:seul-80")) { origin adjudicated; }
        assert "droit80-02": age_droit_depasse(entity_ref("urn:fr:css-aah:case:seul-80")) { origin case_input; }
        assert "droit80-03": residence_permanente(entity_ref("urn:fr:css-aah:case:seul-80")) { origin case_input; }
        assert "droit80-04": sejour_regulier(entity_ref("urn:fr:css-aah:case:seul-80")) { origin case_input; }
    }
    evaluate truth(aah_droit_80(entity_ref("urn:fr:css-aah:case:seul-80")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(aah_droit_calcule(entity_ref("urn:fr:css-aah:case:seul-80")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
