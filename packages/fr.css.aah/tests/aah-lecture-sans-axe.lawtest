// §156: the gap-renewal facts WITHOUT a reading axis. The rupture amount
// depends on the SensRenouvellement group, so the evaluator must return
// INTERPRETATION_REQUIRED; the mainstream current figure (250.00) does not
// depend on the group and stays COMPUTED.
language "law.core" version "0.2";
package fr.css.aah version "0.1.0";
namespace "urn:fr:corpus:clir:aah";

test "urn:query:fr-css-aah-lecture-sans-axe" {
    given {
        context { decision_time @2024-06-15T12:00:00Z; knowledge_time @2024-06-15T12:00:00Z; legal_time @2024-06-15; timezone "Europe/Paris"; }
        assert "lec0-01": decision_cdaph_80(entity_ref("urn:fr:css-aah:couple:gap-renewal-noaxis")) { origin adjudicated; }
        assert "lec0-02": age_droit_depasse(entity_ref("urn:fr:css-aah:couple:gap-renewal-noaxis")) { origin case_input; }
        assert "lec0-03": residence_permanente(entity_ref("urn:fr:css-aah:couple:gap-renewal-noaxis")) { origin case_input; }
        assert "lec0-04": sejour_regulier(entity_ref("urn:fr:css-aah:couple:gap-renewal-noaxis")) { origin case_input; }
        assert "lec0-05": sans_revenu_activite(entity_ref("urn:fr:css-aah:couple:gap-renewal-noaxis")) { origin case_input; }
        assert "lec0-06": en_couple(entity_ref("urn:fr:css-aah:couple:gap-renewal-noaxis")) { origin case_input; }
        assert "lec0-07": beneficiaire_au_1er_octobre_2023(entity_ref("urn:fr:css-aah:couple:gap-renewal-noaxis")) { origin case_input; }
        assert "lec0-08": renouvellement_apres_rupture(entity_ref("urn:fr:css-aah:couple:gap-renewal-noaxis")) { origin case_input; }
        assert "lec0-09": montant_mensuel_retenu(1000.00 EUR) { origin case_input; }
        assert "lec0-10": ressources_annuelles_retenues(entity_ref("urn:fr:css-aah:couple:gap-renewal-noaxis"), 9000.00 EUR) { origin case_input; }
        assert "lec0-11": ressources_conjoint_retenues(entity_ref("urn:fr:css-aah:couple:gap-renewal-noaxis"), 3000.00 EUR) { origin case_input; }
        assert "lec0-12": enfants_charge(0) { origin case_input; }
    }
    evaluate truth(aah_montant_rupture(entity_ref("urn:fr:css-aah:couple:gap-renewal-noaxis"), 810.00 EUR));
    expect result_kind == PROPOSITION;
    expect evaluation_status == INTERPRETATION_REQUIRED;
    evaluate truth(aah_montant_nouveau(entity_ref("urn:fr:css-aah:couple:gap-renewal-noaxis"), 250.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
