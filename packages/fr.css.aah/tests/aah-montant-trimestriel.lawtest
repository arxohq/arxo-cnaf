// Worker, quarterly track (2024): (3000.00 - 1500.00) / 3 = 500.00.
language "law.core" version "0.2";
package fr.css.aah version "0.1.0";
namespace "urn:fr:corpus:clir:aah";

test "urn:query:fr-css-aah-montant-trimestriel" {
    given {
        context { decision_time @2024-06-15T12:00:00Z; knowledge_time @2024-06-15T12:00:00Z; legal_time @2024-06-15; timezone "Europe/Paris"; }
        assert "m3-01": decision_cdaph_80(entity_ref("urn:fr:css-aah:case:m3")) { origin adjudicated; }
        assert "m3-02": age_droit_depasse(entity_ref("urn:fr:css-aah:case:m3")) { origin case_input; }
        assert "m3-03": residence_permanente(entity_ref("urn:fr:css-aah:case:m3")) { origin case_input; }
        assert "m3-04": sejour_regulier(entity_ref("urn:fr:css-aah:case:m3")) { origin case_input; }
        assert "m3-05": percoit_revenu_activite(entity_ref("urn:fr:css-aah:case:m3")) { origin case_input; }
        assert "m3-06": personne_seule(entity_ref("urn:fr:css-aah:case:m3")) { origin case_input; }
        assert "m3-07": montant_mensuel_retenu(1000.00 EUR) { origin case_input; }
        assert "m3-08": ressources_trimestrielles_retenues(entity_ref("urn:fr:css-aah:case:m3"), 1500.00 EUR) { origin case_input; }
        assert "m3-09": enfants_charge(0) { origin case_input; }
    }
    evaluate truth(aah_montant_nouveau(entity_ref("urn:fr:css-aah:case:m3"), 500.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
