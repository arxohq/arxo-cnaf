// Resources reach the twelvefold threshold (13000.00 >= 12000.00):
// the D. 821-2 para. 1 condition fails, no current amount.
language "law.core" version "0.2";
package fr.css.aah version "0.1.0";
namespace "urn:fr:corpus:clir:aah";

test "urn:query:fr-css-aah-montant-plafond-depasse" {
    given {
        context { decision_time @2024-06-15T12:00:00Z; knowledge_time @2024-06-15T12:00:00Z; legal_time @2024-06-15; timezone "Europe/Paris"; }
        assert "m4-01": decision_cdaph_80(entity_ref("urn:fr:css-aah:case:m4")) { origin adjudicated; }
        assert "m4-02": age_droit_depasse(entity_ref("urn:fr:css-aah:case:m4")) { origin case_input; }
        assert "m4-03": residence_permanente(entity_ref("urn:fr:css-aah:case:m4")) { origin case_input; }
        assert "m4-04": sejour_regulier(entity_ref("urn:fr:css-aah:case:m4")) { origin case_input; }
        assert "m4-05": sans_revenu_activite(entity_ref("urn:fr:css-aah:case:m4")) { origin case_input; }
        assert "m4-06": personne_seule(entity_ref("urn:fr:css-aah:case:m4")) { origin case_input; }
        assert "m4-07": montant_mensuel_retenu(1000.00 EUR) { origin case_input; }
        assert "m4-08": ressources_annuelles_retenues(entity_ref("urn:fr:css-aah:case:m4"), 13000.00 EUR) { origin case_input; }
        assert "m4-09": enfants_charge(0) { origin case_input; }
    }
    evaluate truth(aah_montant_nouveau(entity_ref("urn:fr:css-aah:case:m4"), 0.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
