// §152/dependency case, reading MaintienTantQue, selection interpretation MaintienTantQue:
// couple qualifying on 01.10.2023, right lapsed for a period (provider gap)
// and renewed in 2024. Former figure 810.00, current figure 250.00
// (spouse income now ignored).
// Under MaintienTantQue the gap does not break the decree 2022-1694 art. 2
// comparison: the rupture amount (810.00) is due. The mainstream current
// figure (250.00) stays available as a reading-independent control.
language "law.core" version "0.2";
package fr.css.aah version "0.1.0";
namespace "urn:fr:corpus:clir:aah";

test "urn:query:fr-css-aah-lecture-tant-que" {
    given {
        context { decision_time @2024-06-15T12:00:00Z; knowledge_time @2024-06-15T12:00:00Z; legal_time @2024-06-15; timezone "Europe/Paris"; interpretation fr.css.aah::MaintienTantQue; }
        assert "lecA-01": decision_cdaph_80(entity_ref("urn:fr:css-aah:couple:gap-renewal")) { origin adjudicated; }
        assert "lecA-02": age_droit_depasse(entity_ref("urn:fr:css-aah:couple:gap-renewal")) { origin case_input; }
        assert "lecA-03": residence_permanente(entity_ref("urn:fr:css-aah:couple:gap-renewal")) { origin case_input; }
        assert "lecA-04": sejour_regulier(entity_ref("urn:fr:css-aah:couple:gap-renewal")) { origin case_input; }
        assert "lecA-05": sans_revenu_activite(entity_ref("urn:fr:css-aah:couple:gap-renewal")) { origin case_input; }
        assert "lecA-06": en_couple(entity_ref("urn:fr:css-aah:couple:gap-renewal")) { origin case_input; }
        assert "lecA-07": beneficiaire_au_1er_octobre_2023(entity_ref("urn:fr:css-aah:couple:gap-renewal")) { origin case_input; }
        assert "lecA-08": renouvellement_apres_rupture(entity_ref("urn:fr:css-aah:couple:gap-renewal")) { origin case_input; }
        assert "lecA-09": montant_mensuel_retenu(1000.00 EUR) { origin case_input; }
        assert "lecA-10": ressources_annuelles_retenues(entity_ref("urn:fr:css-aah:couple:gap-renewal"), 9000.00 EUR) { origin case_input; }
        assert "lecA-11": ressources_conjoint_retenues(entity_ref("urn:fr:css-aah:couple:gap-renewal"), 3000.00 EUR) { origin case_input; }
        assert "lecA-12": enfants_charge(0) { origin case_input; }
        assert "lecA-13": sans_esat(entity_ref("urn:fr:css-aah:couple:gap-renewal")) { origin case_input; }
    }
    evaluate truth(aah_montant_rupture(entity_ref("urn:fr:css-aah:couple:gap-renewal"), 810.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(aah_montant_nouveau(entity_ref("urn:fr:css-aah:couple:gap-renewal"), 250.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
