// Double calculation, switch (2024): spouse resources 12000.00.
// Former: (21720.00 - 21000.00) / 12 = 60.00. Current: 250.00.
// The current figure is higher: no maintenance, 250.00 due
// (the rule "cesse définitivement" — see the irreversible pair).
language "law.core" version "0.2";
package fr.css.aah version "0.1.0";
namespace "urn:fr:corpus:clir:aah";

test "urn:query:fr-css-aah-double-calcul-bascule" {
    given {
        context { decision_time @2024-06-15T12:00:00Z; knowledge_time @2024-06-15T12:00:00Z; legal_time @2024-06-15; timezone "Europe/Paris"; }
        assert "dc2-01": decision_cdaph_80(entity_ref("urn:fr:css-aah:case:couple-dc2")) { origin adjudicated; }
        assert "dc2-02": age_droit_depasse(entity_ref("urn:fr:css-aah:case:couple-dc2")) { origin case_input; }
        assert "dc2-03": residence_permanente(entity_ref("urn:fr:css-aah:case:couple-dc2")) { origin case_input; }
        assert "dc2-04": sejour_regulier(entity_ref("urn:fr:css-aah:case:couple-dc2")) { origin case_input; }
        assert "dc2-05": sans_revenu_activite(entity_ref("urn:fr:css-aah:case:couple-dc2")) { origin case_input; }
        assert "dc2-06": en_couple(entity_ref("urn:fr:css-aah:case:couple-dc2")) { origin case_input; }
        assert "dc2-07": beneficiaire_au_1er_octobre_2023(entity_ref("urn:fr:css-aah:case:couple-dc2")) { origin case_input; }
        assert "dc2-08": montant_mensuel_retenu(1000.00 EUR) { origin case_input; }
        assert "dc2-09": ressources_annuelles_retenues(entity_ref("urn:fr:css-aah:case:couple-dc2"), 9000.00 EUR) { origin case_input; }
        assert "dc2-10": ressources_conjoint_retenues(entity_ref("urn:fr:css-aah:case:couple-dc2"), 12000.00 EUR) { origin case_input; }
        assert "dc2-11": ressources_trimestrielles_retenues(entity_ref("urn:fr:css-aah:case:couple-dc2"), 0.00 EUR) { origin case_input; }
        assert "dc2-12": enfants_charge(0) { origin case_input; }
        assert "dc2-13": sans_esat(entity_ref("urn:fr:css-aah:case:couple-dc2")) { origin case_input; }
    }
    evaluate truth(aah_montant_ancien(entity_ref("urn:fr:css-aah:case:couple-dc2"), 60.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(aah_montant_nouveau(entity_ref("urn:fr:css-aah:case:couple-dc2"), 250.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(aah_montant_du(entity_ref("urn:fr:css-aah:case:couple-dc2"), 250.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
