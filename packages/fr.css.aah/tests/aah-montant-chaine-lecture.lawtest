// Построение и сверка (DECISION-0452) под чтением AahRevalorisationArrondiCentime: предыдущая сумма × коэффициент L. 161-25,
// округление до сантима; построенное равно опубликованному в каждом окне.
language "law.core" version "0.2";
package fr.css.aah version "0.1.0";
namespace "urn:fr:corpus:clir:aah";

// 2020: aah_montant_construit = 902.70 EUR и conforme au décret
test "urn:query:fr-css-aah-chaine-2020" {
    given {
        context { decision_time @2021-02-15T12:00:00Z; knowledge_time @2021-02-15T12:00:00Z; legal_time @2021-02-15; timezone "Europe/Paris"; interpretation AahRevalorisationArrondiCentime; }
        assert "chaine-2020-01": en_couple(entity_ref("urn:fr:css-aah:case:chaine-2020")) { origin case_input; }
    }
    evaluate truth(aah_montant_construit(902.70 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(aah_montant_conforme_publie());
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

