// OpenFisca AAH case (tests/formulas/aah/aah_couple.yaml, period 2023-11):
// deconjugalised couple, second parent without income. Their rate 971.37,
// their expectation aah = 971.37 (full rate).
// Ours, current rules (spouse ignored): min(971.37, (12 x 971.37 - 0)
// / 12) = 971.37. Their case -> our answer -> class: REPORT.md
// (OpenFisca, 3).
language "law.core" version "0.2";
package fr.css.aah version "0.1.0";
namespace "urn:fr:corpus:clir:aah";

test "urn:query:fr-css-aah-of-2023-11-deconjugalise" {
    given {
        context { decision_time @2023-11-15T12:00:00Z; knowledge_time @2023-11-15T12:00:00Z; legal_time @2023-11-15; timezone "Europe/Paris"; }
        assert "of1123-01": decision_cdaph_80(entity_ref("urn:fr:css-aah:foreign:of-2023-11")) { origin adjudicated; }
        assert "of1123-02": age_droit_depasse(entity_ref("urn:fr:css-aah:foreign:of-2023-11")) { origin case_input; }
        assert "of1123-03": residence_permanente(entity_ref("urn:fr:css-aah:foreign:of-2023-11")) { origin case_input; }
        assert "of1123-04": sejour_regulier(entity_ref("urn:fr:css-aah:foreign:of-2023-11")) { origin case_input; }
        assert "of1123-05": sans_revenu_activite(entity_ref("urn:fr:css-aah:foreign:of-2023-11")) { origin case_input; }
        assert "of1123-06": en_couple(entity_ref("urn:fr:css-aah:foreign:of-2023-11")) { origin case_input; }
        assert "of1123-07": montant_mensuel_retenu(971.37 EUR) { origin case_input; }
        assert "of1123-08": ressources_annuelles_retenues(entity_ref("urn:fr:css-aah:foreign:of-2023-11"), 0.00 EUR) { origin case_input; }
        assert "of1123-09": enfants_charge(0) { origin case_input; }
    }
    evaluate truth(aah_montant_nouveau(entity_ref("urn:fr:css-aah:foreign:of-2023-11"), 971.37 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
