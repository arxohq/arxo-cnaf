// §152/dependency case, reading RenouvellementStrict, selection interpretation RenouvellementStrict:
// same gap-renewal facts as the MaintienTantQue scenario. Under the strict
// reading the decree 2022-1694 art. 2 comparison applies only «until the
// right expires», so no rupture amount is due (NEITHER); the mainstream
// current figure (250.00) is still computed — the dependency pair.
language "law.core" version "0.2";
package fr.css.aah version "0.1.0";
namespace "urn:fr:corpus:clir:aah";

test "urn:query:fr-css-aah-lecture-strict" {
    given {
        context { decision_time @2024-06-15T12:00:00Z; knowledge_time @2024-06-15T12:00:00Z; legal_time @2024-06-15; timezone "Europe/Paris"; interpretation RenouvellementStrict; }
        assert "lecB-01": decision_cdaph_80(entity_ref("urn:fr:css-aah:couple:gap-renewal-strict")) { origin adjudicated; }
        assert "lecB-02": age_droit_depasse(entity_ref("urn:fr:css-aah:couple:gap-renewal-strict")) { origin case_input; }
        assert "lecB-03": residence_permanente(entity_ref("urn:fr:css-aah:couple:gap-renewal-strict")) { origin case_input; }
        assert "lecB-04": sejour_regulier(entity_ref("urn:fr:css-aah:couple:gap-renewal-strict")) { origin case_input; }
        assert "lecB-05": sans_revenu_activite(entity_ref("urn:fr:css-aah:couple:gap-renewal-strict")) { origin case_input; }
        assert "lecB-06": en_couple(entity_ref("urn:fr:css-aah:couple:gap-renewal-strict")) { origin case_input; }
        assert "lecB-07": beneficiaire_au_1er_octobre_2023(entity_ref("urn:fr:css-aah:couple:gap-renewal-strict")) { origin case_input; }
        assert "lecB-08": renouvellement_apres_rupture(entity_ref("urn:fr:css-aah:couple:gap-renewal-strict")) { origin case_input; }
        assert "lecB-09": montant_mensuel_retenu(1000.00 EUR) { origin case_input; }
        assert "lecB-10": ressources_annuelles_retenues(entity_ref("urn:fr:css-aah:couple:gap-renewal-strict"), 9000.00 EUR) { origin case_input; }
        assert "lecB-11": ressources_conjoint_retenues(entity_ref("urn:fr:css-aah:couple:gap-renewal-strict"), 3000.00 EUR) { origin case_input; }
        assert "lecB-12": enfants_charge(0) { origin case_input; }
    }
    evaluate truth(aah_montant_rupture(entity_ref("urn:fr:css-aah:couple:gap-renewal-strict"), 810.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    evaluate truth(aah_montant_nouveau(entity_ref("urn:fr:css-aah:couple:gap-renewal-strict"), 250.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
