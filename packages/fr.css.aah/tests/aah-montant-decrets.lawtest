// Окна декретов о размере AAH: сумма окна — число статьи 1 декрета (sources/montant/),
// дата дела — середина окна. Ожидания читаются из закреплённых текстов (build_montant_chaine.py).
language "law.core" version "0.2";
package fr.css.aah version "0.1.0";
namespace "urn:fr:corpus:clir:aah";

// 2020: montant_aah_applicable = 902.70 EUR, décret du mois d'avril 2020
test "urn:query:fr-css-aah-decret-2020" {
    given {
        context { decision_time @2021-02-15T12:00:00Z; knowledge_time @2021-02-15T12:00:00Z; legal_time @2021-02-15; timezone "Europe/Paris"; }
        assert "decret-2020-01": en_couple(entity_ref("urn:fr:css-aah:case:decret-2020")) { origin case_input; }
    }
    evaluate truth(montant_aah_applicable(902.70 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// 2021: montant_aah_applicable = 903.60 EUR, décret du mois d'avril 2021
test "urn:query:fr-css-aah-decret-2021" {
    given {
        context { decision_time @2021-06-15T12:00:00Z; knowledge_time @2021-06-15T12:00:00Z; legal_time @2021-06-15; timezone "Europe/Paris"; }
        assert "decret-2021-01": en_couple(entity_ref("urn:fr:css-aah:case:decret-2021")) { origin case_input; }
    }
    evaluate truth(montant_aah_applicable(903.60 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(montant_aah_applicable(902.70 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

