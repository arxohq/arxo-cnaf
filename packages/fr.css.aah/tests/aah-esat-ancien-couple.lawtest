// ESAT, former wording direct (2022): couple, annual track, no resources.
// Former figure min(1000.00, 21720.00 / 12) = 1000.00. Guaranteed pay
// 1500.00, retained gross SMIC 1800.00: couple cap 1800.00 x 1.30 =
// 2340.00, 2340.00 - 1500.00 = 840.00 due.
language "law.core" version "0.2";
package fr.css.aah version "0.1.0";
namespace "urn:fr:corpus:clir:aah";

test "urn:query:fr-css-aah-esat-ancien-couple" {
    given {
        context { decision_time @2022-06-15T12:00:00Z; knowledge_time @2022-06-15T12:00:00Z; legal_time @2022-06-15; timezone "Europe/Paris"; }
        assert "es2-01": decision_cdaph_80(entity_ref("urn:fr:css-aah:case:esat-2")) { origin adjudicated; }
        assert "es2-02": age_droit_depasse(entity_ref("urn:fr:css-aah:case:esat-2")) { origin case_input; }
        assert "es2-03": residence_permanente(entity_ref("urn:fr:css-aah:case:esat-2")) { origin case_input; }
        assert "es2-04": sejour_regulier(entity_ref("urn:fr:css-aah:case:esat-2")) { origin case_input; }
        assert "es2-05": sans_revenu_activite(entity_ref("urn:fr:css-aah:case:esat-2")) { origin case_input; }
        assert "es2-06": en_couple(entity_ref("urn:fr:css-aah:case:esat-2")) { origin case_input; }
        assert "es2-07": montant_mensuel_retenu(1000.00 EUR) { origin case_input; }
        assert "es2-08": ressources_annuelles_retenues(entity_ref("urn:fr:css-aah:case:esat-2"), 0.00 EUR) { origin case_input; }
        assert "es2-09": ressources_conjoint_retenues(entity_ref("urn:fr:css-aah:case:esat-2"), 0.00 EUR) { origin case_input; }
        assert "es2-10": enfants_charge(0) { origin case_input; }
        assert "es2-11": remuneration_garantie_retenue(entity_ref("urn:fr:css-aah:case:esat-2"), 1500.00 EUR) { origin case_input; }
        assert "es2-12": smic_brut_mensuel_retenu(1800.00 EUR) { origin case_input; }
    }
    evaluate truth(aah_montant_du(entity_ref("urn:fr:css-aah:case:esat-2"), 840.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
