@source(JORF_DECR2025_515_ART3)
rule DifferentielEteint2028(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, mois: Date, d3: Date, ancien_montant: Money) strict {
    effective [@2025-09-01, infinity);
