pub interpretation ArrondiMaximumCmgCentime {
    status disputed;
    label fr official "lecture : maxima du CMG ancien au centime HALF_UP (D-82 ; tableaux DSS)";
    label en unofficial "reading: old CMG maxima rounded to cents HALF_UP (D-82; DSS tables)";
    label ru unofficial "D-82: максимумы прежнего CMG до сантима HALF_UP";
    include ArrondiMaximumCmg;
    include MaximumAncienBande1Centime;
    include MaximumAncienBande2Centime;
    include MaximumAncienBande3Centime;
    include MaximumAncienReduitAgeCentime;
    include MaximumAncienReduitPreParECentime;
    include MaximumStructureAssmat1Centime;
    include MaximumStructureAssmat2Centime;
    include MaximumStructureAssmat3Centime;
    include MaximumStructureDom1Centime;
    include MaximumStructureDom2Centime;
    include MaximumStructureDom3Centime;
    include MaximumStructureReduitAmAgeCentime;
    include MaximumStructureReduitDomAgeCentime;
    include MaximumStructureReduitAmPreParECentime;
    include MaximumStructureReduitDomPreParECentime;
}
