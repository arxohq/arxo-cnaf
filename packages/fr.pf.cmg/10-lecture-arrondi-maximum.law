        and ressources_annuelles(p, r) and plafond1_applicable(p, p1) and plafond2_applicable(p, p2)
        and bmaf_retenu(p, bmaf) and taux_bande_structure_dom(p, r, p1, p2, t) and arrondi_maximum_cmg(p, e);
    then maximum_structure(p, e, div_round(t * bmaf, 2.0, 2, "HALF_UP"));
}

@source(CSS_D531_23_ED2020_01, CSS_D531_23_ED2021_09, CSS_D531_21_ED2025_09)
rule MaximumStructureReduitAmPreParECentime(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, r: Money, p1: Money, p2: Money, bmaf: Money, t: Decimal) strict {
    effective [@2021-01-01, @2025-09-01);
