    label en unofficial "structure childminder band-3 maximum: 115.05% (old law)";
    when droit_structure_ouvert(p, e) and mode_garde(p, e, STRUCTURE) and ressources_annuelles(p, r) and plafond2_applicable(p, p2) and r > p2 and bmaf_retenu(p, bmaf) and not_known(age_taux_reduit(p, e)) and not_known(preparer_temps_partiel(p)) and arrondi_maximum_cmg(p, e);
    then maximum_structure(p, e, round(TauxStructureAssmatBande3 * bmaf, 2, "HALF_UP"));
}

@source(CSS_D531_23_ED2020_01, CSS_D531_23_ED2021_09, CSS_D531_21_ED2025_09)
rule MaximumStructureDom1Centime(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, mode: ModeGarde, r: Money, p1: Money, bmaf: Money) strict {
    effective [@2021-01-01, @2025-09-01);
    label fr official "maximum domicile/EAJE bande 1: 208,53 % (ancien droit)";
    label en unofficial "home/EAJE band-1 maximum: 208.53% (old law)";
    when droit_structure_ouvert(p, e) and mode_garde(p, e, mode) and mode != ASSISTANT_MATERNEL and mode != STRUCTURE and ressources_annuelles(p, r) and plafond1_applicable(p, p1) and r <= p1 and bmaf_retenu(p, bmaf) and not_known(age_taux_reduit(p, e)) and not_known(preparer_temps_partiel(p)) and arrondi_maximum_cmg(p, e);
    then maximum_structure(p, e, round(TauxStructureDomBande1 * bmaf, 2, "HALF_UP"));
}

@source(CSS_D531_23_ED2020_01, CSS_D531_23_ED2021_09, CSS_D531_21_ED2025_09)
rule MaximumStructureDom2Centime(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, mode: ModeGarde, r: Money, p1: Money, p2: Money, bmaf: Money) strict {
    effective [@2021-01-01, @2025-09-01);
    label fr official "maximum domicile/EAJE bande 2: 179,76 % (ancien droit)";
    label en unofficial "home/EAJE band-2 maximum: 179.76% (old law)";
    when droit_structure_ouvert(p, e) and mode_garde(p, e, mode) and mode != ASSISTANT_MATERNEL and mode != STRUCTURE and ressources_annuelles(p, r) and plafond1_applicable(p, p1) and plafond2_applicable(p, p2) and r > p1 and r <= p2 and bmaf_retenu(p, bmaf) and not_known(age_taux_reduit(p, e)) and not_known(preparer_temps_partiel(p)) and arrondi_maximum_cmg(p, e);
    then maximum_structure(p, e, round(TauxStructureDomBande2 * bmaf, 2, "HALF_UP"));
}

@source(CSS_D531_23_ED2020_01, CSS_D531_23_ED2021_09, CSS_D531_21_ED2025_09)
rule MaximumStructureDom3Centime(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, mode: ModeGarde, r: Money, p2: Money, bmaf: Money) strict {
    effective [@2021-01-01, @2025-09-01);
    label fr official "maximum domicile/EAJE bande 3: 151,00 % (ancien droit)";
    label en unofficial "home/EAJE band-3 maximum: 151.00% (old law)";
    when droit_structure_ouvert(p, e) and mode_garde(p, e, mode) and mode != ASSISTANT_MATERNEL and mode != STRUCTURE and ressources_annuelles(p, r) and plafond2_applicable(p, p2) and r > p2 and bmaf_retenu(p, bmaf) and not_known(age_taux_reduit(p, e)) and not_known(preparer_temps_partiel(p)) and arrondi_maximum_cmg(p, e);
    then maximum_structure(p, e, round(TauxStructureDomBande3 * bmaf, 2, "HALF_UP"));
}

@source(CSS_D531_23_ED2020_01, CSS_D531_23_ED2021_09)
rule MaximumStructureReduitAmAgeCentime(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, r: Money, p1: Money, p2: Money, bmaf: Money, t: Decimal) strict {
    effective [@2021-01-01, @2025-09-01);
    label fr official "maximum assistante maternelle divisé par deux (taux réduit ancien)";
    label en unofficial "childminder maximum halved (old reduced rate)";
    when droit_structure_ouvert(p, e) and mode_garde(p, e, STRUCTURE) and age_taux_reduit(p, e)
        and ressources_annuelles(p, r) and plafond1_applicable(p, p1) and plafond2_applicable(p, p2)
        and bmaf_retenu(p, bmaf) and taux_bande_structure_am(p, r, p1, p2, t) and arrondi_maximum_cmg(p, e);
    then maximum_structure(p, e, div_round(t * bmaf, 2.0, 2, "HALF_UP"));
}

@source(CSS_D531_23_ED2020_01, CSS_D531_23_ED2021_09)
