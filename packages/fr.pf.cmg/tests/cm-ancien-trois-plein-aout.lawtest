// L. 531-5 IV: a January third birthday retains the full maximum through August.
language "law.core" version "0.2";
package fr.pf.cmg version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cmg";

test "urn:query:fr-pf-cmg-ancien-trois-plein-aout" {
    given {
        context { deadline_policy CMG_MOIS_CALENDAIRE; decision_time @2024-06-20T12:00:00Z; knowledge_time @2024-06-20T12:00:00Z; legal_time @2024-06-15; timezone "Europe/Paris"; }
        assert "ancien-full-01": mode_garde(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-aout"), entity_ref("urn:fr:pf-cmg:child:full"), ASSISTANT_MATERNEL) { origin case_input; }
        assert "ancien-full-02": exerce_activite(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-aout")) { origin case_input; }
        assert "ancien-full-03": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-aout"), entity_ref("urn:fr:pf-cmg:child:full")) { origin case_input; }
        assert "ancien-full-04": age_revolu_ans(entity_ref("urn:fr:pf-cmg:child:full"), 3) { origin case_input; }
        assert "ancien-full-dob": date_naissance(entity_ref("urn:fr:pf-cmg:child:full"), @2021-01-01) { origin case_input; }
        assert "ancien-full-month": mois_droit(@2024-06-01) { origin case_input; }
        assert "ancien-full-05": age_base_ans(entity_ref("urn:fr:pf-cmg:child:full"), 3) { origin case_input; }
        assert "ancien-full-06": nb_enfants_charge(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-aout"), 1) { origin case_input; }
        assert "ancien-full-07-p1": plafond_a_base_publie(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-aout"), 17633 EUR) { origin case_input; }
        assert "ancien-full-07-p2": plafond_a_enfant_publie(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-aout"), 2917 EUR) { origin case_input; }
        assert "ancien-full-07-p3": plafond_c_base_publie(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-aout"), 39184 EUR) { origin case_input; }
        assert "ancien-full-07-p4": plafond_c_enfant_publie(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-aout"), 6482 EUR) { origin case_input; }
        assert "ancien-full-08": ressources_annuelles(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-aout"), 15000 EUR) { origin case_input; }
        assert "ancien-full-09": bmaf_retenu(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-aout"), 400.00 EUR) { origin case_input; }
        assert "ancien-full-10": salaire_net_verse(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-aout"), entity_ref("urn:fr:pf-cmg:child:full"), 600 EUR) { origin case_input; }
        assert "ancien-full-11": indemnites_entretien_repas(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-aout"), entity_ref("urn:fr:pf-cmg:child:full"), 50 EUR) { origin case_input; }
        assert "ancien-full-12": cotisations_sociales(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-aout"), entity_ref("urn:fr:pf-cmg:child:full"), 150 EUR) { origin case_input; }
        assert "ancien-full-13": smic_horaire_retenu(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-aout"), 12 EUR) { origin case_input; }
        assert "ancien-full-14": jours_remuneres(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-aout"), entity_ref("urn:fr:pf-cmg:child:full"), 20.0) { origin case_input; }
    }
    evaluate truth(maximum_ancien_b(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-aout"), entity_ref("urn:fr:pf-cmg:child:full"), 456.16 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(montant_cmg_du(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-aout"), entity_ref("urn:fr:pf-cmg:child:full"), 606.16 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
