// Structure aid, reform: band-1 childminder maximum 172.57% of the
// 400.00 BMAF = 690.28; 85% of the 500.00 expense = 425.00 under the
// maximum; amount due 425.00.
language "law.core" version "0.2";
package fr.pf.cmg version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cmg";

test "urn:query:fr-pf-cmg-structure-montant" {
    given {
        context { decision_time @2025-10-20T12:00:00Z; knowledge_time @2025-10-20T12:00:00Z; legal_time @2025-10-15; timezone "Europe/Paris"; }
        assert "struct-mo-01": mode_garde(entity_ref("urn:fr:pf-cmg:case:structure-montant"), entity_ref("urn:fr:pf-cmg:child:sm"), STRUCTURE) { origin case_input; }
        assert "struct-mo-02": exerce_activite(entity_ref("urn:fr:pf-cmg:case:structure-montant")) { origin case_input; }
        assert "struct-mo-03": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cmg:case:structure-montant"), entity_ref("urn:fr:pf-cmg:child:sm")) { origin case_input; }
        assert "struct-mo-04": age_revolu_ans(entity_ref("urn:fr:pf-cmg:child:sm"), 2) { origin case_input; }
        assert "struct-mo-05": nb_enfants_charge(entity_ref("urn:fr:pf-cmg:case:structure-montant"), 1) { origin case_input; }
        assert "struct-mo-06-p1": plafond_a_base_publie(entity_ref("urn:fr:pf-cmg:case:structure-montant"), 17633 EUR) { origin case_input; }
        assert "struct-mo-06-p2": plafond_a_enfant_publie(entity_ref("urn:fr:pf-cmg:case:structure-montant"), 2917 EUR) { origin case_input; }
        assert "struct-mo-06-p3": plafond_c_base_publie(entity_ref("urn:fr:pf-cmg:case:structure-montant"), 39184 EUR) { origin case_input; }
        assert "struct-mo-06-p4": plafond_c_enfant_publie(entity_ref("urn:fr:pf-cmg:case:structure-montant"), 6482 EUR) { origin case_input; }
        assert "struct-mo-07": ressources_annuelles(entity_ref("urn:fr:pf-cmg:case:structure-montant"), 15000 EUR) { origin case_input; }
        assert "struct-mo-08": bmaf_retenu(entity_ref("urn:fr:pf-cmg:case:structure-montant"), 400.00 EUR) { origin case_input; }
        assert "struct-mo-09": depense_engagee(entity_ref("urn:fr:pf-cmg:case:structure-montant"), entity_ref("urn:fr:pf-cmg:child:sm"), 500 EUR) { origin case_input; }
    }
    evaluate truth(maximum_structure(entity_ref("urn:fr:pf-cmg:case:structure-montant"), entity_ref("urn:fr:pf-cmg:child:sm"), 690.28 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(montant_structure_du(entity_ref("urn:fr:pf-cmg:case:structure-montant"), entity_ref("urn:fr:pf-cmg:child:sm"), 425.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
