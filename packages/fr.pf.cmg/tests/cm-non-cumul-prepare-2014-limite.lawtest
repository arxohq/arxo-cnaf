// L. 531-9, para. 1, 2014 at-cutoff boundary (FULL RETURN 03, R02-06):
// the child was born 01.10.2014 («à partir du» — in the cohort), age 11
// at 2025-10-15 with an isolated parent (the <12 gate holds the CMG right
// open), established non-VI full-rate PreParE — the marker concludes.
// Pair — cm-non-cumul-prepare-avant-2014 (pre-cutoff, NEITHER).
language "law.core" version "0.2";
package fr.pf.cmg version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cmg";

test "urn:query:fr-pf-cmg-non-cumul-prepare-2014-limite" {
    given {
        context { decision_time @2025-10-20T12:00:00Z; knowledge_time @2025-10-20T12:00:00Z; legal_time @2025-10-15; timezone "Europe/Paris"; }
        assert "ncpl-01": mode_garde(entity_ref("urn:fr:pf-cmg:case:ncpl"), entity_ref("urn:fr:pf-cmg:child:ncpl"), ASSISTANT_MATERNEL) { origin case_input; }
        assert "ncpl-02": exerce_activite(entity_ref("urn:fr:pf-cmg:case:ncpl")) { origin case_input; }
        assert "ncpl-03": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cmg:case:ncpl"), entity_ref("urn:fr:pf-cmg:child:ncpl")) { origin case_input; }
        assert "ncpl-04": age_revolu_ans(entity_ref("urn:fr:pf-cmg:child:ncpl"), 11) { origin case_input; }
        assert "ncpl-05": parent_isole(entity_ref("urn:fr:pf-cmg:case:ncpl")) { origin case_input; }
        assert "ncpl-06": beneficie_prepare_plein(entity_ref("urn:fr:pf-cmg:case:ncpl"), entity_ref("urn:fr:pf-cmg:child:ncpl")) { origin case_input; }
        assert "ncpl-07": prepare_plein_hors_vi(entity_ref("urn:fr:pf-cmg:case:ncpl"), entity_ref("urn:fr:pf-cmg:child:ncpl")) { origin adjudicated; }
        assert "ncpl-08": cohorte_l5319_2014(entity_ref("urn:fr:pf-cmg:child:ncpl")) { origin adjudicated; }
    }
    evaluate truth(cumul_prepare_plein_interdit(entity_ref("urn:fr:pf-cmg:case:ncpl"), entity_ref("urn:fr:pf-cmg:child:ncpl")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
