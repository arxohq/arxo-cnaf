// A 15 September third birthday is reflected at the next month-start, 1 October; half rate with the D-82 reading.
language "law.core" version "0.2";
package fr.pf.cmg version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cmg";

test "urn:query:fr-pf-cmg-ancien-oct-oct" {
    given {
        context { deadline_policy CMG_MOIS_CALENDAIRE; decision_time @2024-10-20T12:00:00Z; knowledge_time @2024-10-20T12:00:00Z; legal_time @2024-10-15; timezone "Europe/Paris"; interpretation ArrondiMaximumCmgCentime; }
        assert "ancien-oct-01": mode_garde(entity_ref("urn:fr:pf-cmg:case:ancien-oct-oct"), entity_ref("urn:fr:pf-cmg:child:oct"), ASSISTANT_MATERNEL) { origin case_input; }
        assert "ancien-oct-02": exerce_activite(entity_ref("urn:fr:pf-cmg:case:ancien-oct-oct")) { origin case_input; }
        assert "ancien-oct-03": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cmg:case:ancien-oct-oct"), entity_ref("urn:fr:pf-cmg:child:oct")) { origin case_input; }
        assert "ancien-oct-04": age_revolu_ans(entity_ref("urn:fr:pf-cmg:child:oct"), 3) { origin case_input; }
        assert "ancien-oct-dob": date_naissance(entity_ref("urn:fr:pf-cmg:child:oct"), @2021-09-15) { origin case_input; }
        assert "ancien-oct-month": mois_droit(@2024-10-01) { origin case_input; }
        assert "ancien-oct-05": age_base_ans(entity_ref("urn:fr:pf-cmg:child:oct"), 3) { origin case_input; }
        assert "ancien-oct-06": nb_enfants_charge(entity_ref("urn:fr:pf-cmg:case:ancien-oct-oct"), 1) { origin case_input; }
        assert "ancien-oct-07-p1": plafond_a_base_publie(entity_ref("urn:fr:pf-cmg:case:ancien-oct-oct"), 19572 EUR) { origin case_input; }
        assert "ancien-oct-07-p2": plafond_a_enfant_publie(entity_ref("urn:fr:pf-cmg:case:ancien-oct-oct"), 3237 EUR) { origin case_input; }
        assert "ancien-oct-07-p3": plafond_c_base_publie(entity_ref("urn:fr:pf-cmg:case:ancien-oct-oct"), 43491 EUR) { origin case_input; }
        assert "ancien-oct-07-p4": plafond_c_enfant_publie(entity_ref("urn:fr:pf-cmg:case:ancien-oct-oct"), 7195 EUR) { origin case_input; }
        assert "ancien-oct-08": ressources_annuelles(entity_ref("urn:fr:pf-cmg:case:ancien-oct-oct"), 58806.50 EUR) { origin case_input; }
        assert "ancien-oct-09": bmaf_retenu(entity_ref("urn:fr:pf-cmg:case:ancien-oct-oct"), 466.44 EUR) { origin case_input; }
        assert "ancien-oct-10": salaire_net_verse(entity_ref("urn:fr:pf-cmg:case:ancien-oct-oct"), entity_ref("urn:fr:pf-cmg:child:oct"), 600 EUR) { origin case_input; }
        assert "ancien-oct-11": indemnites_entretien_repas(entity_ref("urn:fr:pf-cmg:case:ancien-oct-oct"), entity_ref("urn:fr:pf-cmg:child:oct"), 50 EUR) { origin case_input; }
        assert "ancien-oct-12": cotisations_sociales(entity_ref("urn:fr:pf-cmg:case:ancien-oct-oct"), entity_ref("urn:fr:pf-cmg:child:oct"), 150 EUR) { origin case_input; }
        assert "ancien-oct-13": smic_horaire_retenu(entity_ref("urn:fr:pf-cmg:case:ancien-oct-oct"), 12 EUR) { origin case_input; }
        assert "ancien-oct-14": jours_remuneres(entity_ref("urn:fr:pf-cmg:case:ancien-oct-oct"), entity_ref("urn:fr:pf-cmg:child:oct"), 20.0) { origin case_input; }
    }
    evaluate truth(maximum_ancien_b(entity_ref("urn:fr:pf-cmg:case:ancien-oct-oct"), entity_ref("urn:fr:pf-cmg:child:oct"), 100.61 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(plafond2_applicable(entity_ref("urn:fr:pf-cmg:case:ancien-oct-oct"), 50686 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(montant_cmg_du(entity_ref("urn:fr:pf-cmg:case:ancien-oct-oct"), entity_ref("urn:fr:pf-cmg:child:oct"), 250.61 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
