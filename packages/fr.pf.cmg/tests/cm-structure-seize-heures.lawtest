// Structure aid, old law: ten paid hours under the sixteen-hour
// minimum — no structure right opens and no structure amount follows.
language "law.core" version "0.2";
package fr.pf.cmg version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cmg";

test "urn:query:fr-pf-cmg-structure-seize-heures" {
    given {
        context { decision_time @2024-06-20T12:00:00Z; knowledge_time @2024-06-20T12:00:00Z; legal_time @2024-06-15; timezone "Europe/Paris"; }
        assert "struct-sh-01": mode_garde(entity_ref("urn:fr:pf-cmg:case:structure-heures"), entity_ref("urn:fr:pf-cmg:child:sh"), STRUCTURE) { origin case_input; }
        assert "struct-sh-02": exerce_activite(entity_ref("urn:fr:pf-cmg:case:structure-heures")) { origin case_input; }
        assert "struct-sh-03": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cmg:case:structure-heures"), entity_ref("urn:fr:pf-cmg:child:sh")) { origin case_input; }
        assert "struct-sh-04": age_revolu_ans(entity_ref("urn:fr:pf-cmg:child:sh"), 2) { origin case_input; }
        assert "struct-sh-05": age_base_ans(entity_ref("urn:fr:pf-cmg:child:sh"), 3) { origin case_input; }
        assert "struct-sh-06": heures_remunerees(entity_ref("urn:fr:pf-cmg:case:structure-heures"), entity_ref("urn:fr:pf-cmg:child:sh"), 10.0) { origin case_input; }
        assert "struct-sh-07": nb_enfants_charge(entity_ref("urn:fr:pf-cmg:case:structure-heures"), 1) { origin case_input; }
        assert "struct-sh-08-p1": plafond_a_base_publie(entity_ref("urn:fr:pf-cmg:case:structure-heures"), 17633 EUR) { origin case_input; }
        assert "struct-sh-08-p2": plafond_a_enfant_publie(entity_ref("urn:fr:pf-cmg:case:structure-heures"), 2917 EUR) { origin case_input; }
        assert "struct-sh-08-p3": plafond_c_base_publie(entity_ref("urn:fr:pf-cmg:case:structure-heures"), 39184 EUR) { origin case_input; }
        assert "struct-sh-08-p4": plafond_c_enfant_publie(entity_ref("urn:fr:pf-cmg:case:structure-heures"), 6482 EUR) { origin case_input; }
        assert "struct-sh-09": ressources_annuelles(entity_ref("urn:fr:pf-cmg:case:structure-heures"), 15000 EUR) { origin case_input; }
        assert "struct-sh-10": bmaf_retenu(entity_ref("urn:fr:pf-cmg:case:structure-heures"), 400.00 EUR) { origin case_input; }
        assert "struct-sh-11": depense_engagee(entity_ref("urn:fr:pf-cmg:case:structure-heures"), entity_ref("urn:fr:pf-cmg:child:sh"), 500 EUR) { origin case_input; }
    }
    evaluate truth(droit_structure_ouvert(entity_ref("urn:fr:pf-cmg:case:structure-heures"), entity_ref("urn:fr:pf-cmg:child:sh")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
