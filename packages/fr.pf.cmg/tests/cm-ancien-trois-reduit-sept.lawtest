// L. 531-5 IV: after the January–August extension, the maximum halves on 1 September.
language "law.core" version "0.2";
package fr.pf.cmg version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cmg";

test "urn:query:fr-pf-cmg-ancien-trois-reduit-sept" {
    given {
        context { deadline_policy CMG_MOIS_CALENDAIRE; decision_time @2024-09-20T12:00:00Z; knowledge_time @2024-09-20T12:00:00Z; legal_time @2024-09-15; timezone "Europe/Paris"; }
        assert "ancien-sept-01": mode_garde(entity_ref("urn:fr:pf-cmg:case:ancien-trois-reduit-sept"), entity_ref("urn:fr:pf-cmg:child:sept"), ASSISTANT_MATERNEL) { origin case_input; }
        assert "ancien-sept-02": exerce_activite(entity_ref("urn:fr:pf-cmg:case:ancien-trois-reduit-sept")) { origin case_input; }
        assert "ancien-sept-03": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cmg:case:ancien-trois-reduit-sept"), entity_ref("urn:fr:pf-cmg:child:sept")) { origin case_input; }
        assert "ancien-sept-04": age_revolu_ans(entity_ref("urn:fr:pf-cmg:child:sept"), 3) { origin case_input; }
        assert "ancien-sept-dob": date_naissance(entity_ref("urn:fr:pf-cmg:child:sept"), @2021-01-01) { origin case_input; }
        assert "ancien-sept-month": mois_droit(@2024-09-01) { origin case_input; }
        assert "ancien-sept-05": age_base_ans(entity_ref("urn:fr:pf-cmg:child:sept"), 3) { origin case_input; }
        assert "ancien-sept-06": nb_enfants_charge(entity_ref("urn:fr:pf-cmg:case:ancien-trois-reduit-sept"), 1) { origin case_input; }
        assert "ancien-sept-07-p1": plafond_a_base_publie(entity_ref("urn:fr:pf-cmg:case:ancien-trois-reduit-sept"), 17633 EUR) { origin case_input; }
        assert "ancien-sept-07-p2": plafond_a_enfant_publie(entity_ref("urn:fr:pf-cmg:case:ancien-trois-reduit-sept"), 2917 EUR) { origin case_input; }
        assert "ancien-sept-07-p3": plafond_c_base_publie(entity_ref("urn:fr:pf-cmg:case:ancien-trois-reduit-sept"), 39184 EUR) { origin case_input; }
        assert "ancien-sept-07-p4": plafond_c_enfant_publie(entity_ref("urn:fr:pf-cmg:case:ancien-trois-reduit-sept"), 6482 EUR) { origin case_input; }
        assert "ancien-sept-08": ressources_annuelles(entity_ref("urn:fr:pf-cmg:case:ancien-trois-reduit-sept"), 15000 EUR) { origin case_input; }
        assert "ancien-sept-09": bmaf_retenu(entity_ref("urn:fr:pf-cmg:case:ancien-trois-reduit-sept"), 400.00 EUR) { origin case_input; }
        assert "ancien-sept-10": salaire_net_verse(entity_ref("urn:fr:pf-cmg:case:ancien-trois-reduit-sept"), entity_ref("urn:fr:pf-cmg:child:sept"), 600 EUR) { origin case_input; }
        assert "ancien-sept-11": indemnites_entretien_repas(entity_ref("urn:fr:pf-cmg:case:ancien-trois-reduit-sept"), entity_ref("urn:fr:pf-cmg:child:sept"), 50 EUR) { origin case_input; }
        assert "ancien-sept-12": cotisations_sociales(entity_ref("urn:fr:pf-cmg:case:ancien-trois-reduit-sept"), entity_ref("urn:fr:pf-cmg:child:sept"), 150 EUR) { origin case_input; }
        assert "ancien-sept-13": smic_horaire_retenu(entity_ref("urn:fr:pf-cmg:case:ancien-trois-reduit-sept"), 12 EUR) { origin case_input; }
        assert "ancien-sept-14": jours_remuneres(entity_ref("urn:fr:pf-cmg:case:ancien-trois-reduit-sept"), entity_ref("urn:fr:pf-cmg:child:sept"), 20.0) { origin case_input; }
    }
    evaluate truth(maximum_ancien_b(entity_ref("urn:fr:pf-cmg:case:ancien-trois-reduit-sept"), entity_ref("urn:fr:pf-cmg:child:sept"), 228.08 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(montant_cmg_du(entity_ref("urn:fr:pf-cmg:case:ancien-trois-reduit-sept"), entity_ref("urn:fr:pf-cmg:child:sept"), 378.08 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
