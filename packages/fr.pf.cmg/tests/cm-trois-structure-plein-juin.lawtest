// L. 531-6 and L. 531-5 IV: at age 3 in June, full old STRUCTURE maximum remains through August.
language "law.core" version "0.2";
package fr.pf.cmg version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cmg";

test "urn:query:fr-pf-cmg-trois-structure-plein-juin" {
    given {
        context { deadline_policy CMG_MOIS_CALENDAIRE; decision_time @2024-06-20T12:00:00Z; knowledge_time @2024-06-20T12:00:00Z; legal_time @2024-06-15; timezone "Europe/Paris"; interpretation ArrondiMaximumCmgCentime; }
        assert "troisstruct-01": mode_garde(entity_ref("urn:fr:pf-cmg:case:trois-structure-plein-juin"), entity_ref("urn:fr:pf-cmg:child:t3"), STRUCTURE) { origin case_input; }
        assert "troisstruct-02": exerce_activite(entity_ref("urn:fr:pf-cmg:case:trois-structure-plein-juin")) { origin case_input; }
        assert "troisstruct-03": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cmg:case:trois-structure-plein-juin"), entity_ref("urn:fr:pf-cmg:child:t3")) { origin case_input; }
        assert "troisstruct-04": age_revolu_ans(entity_ref("urn:fr:pf-cmg:child:t3"), 3) { origin case_input; }
        assert "troisstruct-dob": date_naissance(entity_ref("urn:fr:pf-cmg:child:t3"), @2021-01-01) { origin case_input; }
        assert "troisstruct-month": mois_droit(@2024-06-01) { origin case_input; }
        assert "troisstruct-05": age_base_ans(entity_ref("urn:fr:pf-cmg:child:t3"), 3) { origin case_input; }
        assert "troisstruct-06": heures_remunerees(entity_ref("urn:fr:pf-cmg:case:trois-structure-plein-juin"), entity_ref("urn:fr:pf-cmg:child:t3"), 16.0) { origin case_input; }
        assert "troisstruct-07": nb_enfants_charge(entity_ref("urn:fr:pf-cmg:case:trois-structure-plein-juin"), 1) { origin case_input; }
        assert "troisstruct-08-p1": plafond_a_base_publie(entity_ref("urn:fr:pf-cmg:case:trois-structure-plein-juin"), 19572 EUR) { origin case_input; }
        assert "troisstruct-08-p2": plafond_a_enfant_publie(entity_ref("urn:fr:pf-cmg:case:trois-structure-plein-juin"), 3237 EUR) { origin case_input; }
        assert "troisstruct-08-p3": plafond_c_base_publie(entity_ref("urn:fr:pf-cmg:case:trois-structure-plein-juin"), 43491 EUR) { origin case_input; }
        assert "troisstruct-08-p4": plafond_c_enfant_publie(entity_ref("urn:fr:pf-cmg:case:trois-structure-plein-juin"), 7195 EUR) { origin case_input; }
        assert "troisstruct-isole": personne_seule(entity_ref("urn:fr:pf-cmg:case:trois-structure-plein-juin")) { origin case_input; }
        assert "troisstruct-p1": plafond_a_base_isole_publie(entity_ref("urn:fr:pf-cmg:case:trois-structure-plein-juin"), 27401 EUR) { origin case_input; }
        assert "troisstruct-p2": plafond_a_enfant_isole_publie(entity_ref("urn:fr:pf-cmg:case:trois-structure-plein-juin"), 4532 EUR) { origin case_input; }
        assert "troisstruct-p3": plafond_c_base_isole_publie(entity_ref("urn:fr:pf-cmg:case:trois-structure-plein-juin"), 60887 EUR) { origin case_input; }
        assert "troisstruct-p4": plafond_c_enfant_isole_publie(entity_ref("urn:fr:pf-cmg:case:trois-structure-plein-juin"), 10073 EUR) { origin case_input; }
        assert "troisstruct-09": ressources_annuelles(entity_ref("urn:fr:pf-cmg:case:trois-structure-plein-juin"), 80000 EUR) { origin case_input; }
        assert "troisstruct-10": bmaf_retenu(entity_ref("urn:fr:pf-cmg:case:trois-structure-plein-juin"), 466.44 EUR) { origin case_input; }
        assert "troisstruct-11": depense_engagee(entity_ref("urn:fr:pf-cmg:case:trois-structure-plein-juin"), entity_ref("urn:fr:pf-cmg:child:t3"), 500 EUR) { origin case_input; }
    }
    evaluate truth(maximum_structure(entity_ref("urn:fr:pf-cmg:case:trois-structure-plein-juin"), entity_ref("urn:fr:pf-cmg:child:t3"), 536.64 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
