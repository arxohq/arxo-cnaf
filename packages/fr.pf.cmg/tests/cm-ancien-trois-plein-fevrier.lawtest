// A 15 January birthday is reached after the 1 January month start; in February the full-rate extension applies.
language "law.core" version "0.2";
package fr.pf.cmg version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cmg";

test "urn:query:fr-pf-cmg-ancien-trois-plein-fevrier" {
    given {
        context { deadline_policy CMG_MOIS_CALENDAIRE; decision_time @2024-02-20T12:00:00Z; knowledge_time @2024-02-20T12:00:00Z; legal_time @2024-02-15; timezone "Europe/Paris"; }
        assert "ancien-feb-01": mode_garde(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-fevrier"), entity_ref("urn:fr:pf-cmg:child:feb"), ASSISTANT_MATERNEL) { origin case_input; }
        assert "ancien-feb-02": exerce_activite(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-fevrier")) { origin case_input; }
        assert "ancien-feb-03": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-fevrier"), entity_ref("urn:fr:pf-cmg:child:feb")) { origin case_input; }
        assert "ancien-feb-04": age_revolu_ans(entity_ref("urn:fr:pf-cmg:child:feb"), 3) { origin case_input; }
        assert "ancien-feb-dob": date_naissance(entity_ref("urn:fr:pf-cmg:child:feb"), @2021-01-15) { origin case_input; }
        assert "ancien-feb-month": mois_droit(@2024-02-01) { origin case_input; }
        assert "ancien-feb-05": age_base_ans(entity_ref("urn:fr:pf-cmg:child:feb"), 3) { origin case_input; }
        assert "ancien-feb-06": nb_enfants_charge(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-fevrier"), 1) { origin case_input; }
        assert "ancien-feb-07-p1": plafond_a_base_publie(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-fevrier"), 17633 EUR) { origin case_input; }
        assert "ancien-feb-07-p2": plafond_a_enfant_publie(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-fevrier"), 2917 EUR) { origin case_input; }
        assert "ancien-feb-07-p3": plafond_c_base_publie(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-fevrier"), 39184 EUR) { origin case_input; }
        assert "ancien-feb-07-p4": plafond_c_enfant_publie(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-fevrier"), 6482 EUR) { origin case_input; }
        assert "ancien-feb-08": ressources_annuelles(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-fevrier"), 15000 EUR) { origin case_input; }
        assert "ancien-feb-09": bmaf_retenu(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-fevrier"), 400.00 EUR) { origin case_input; }
        assert "ancien-feb-10": salaire_net_verse(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-fevrier"), entity_ref("urn:fr:pf-cmg:child:feb"), 600 EUR) { origin case_input; }
        assert "ancien-feb-11": indemnites_entretien_repas(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-fevrier"), entity_ref("urn:fr:pf-cmg:child:feb"), 50 EUR) { origin case_input; }
        assert "ancien-feb-12": cotisations_sociales(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-fevrier"), entity_ref("urn:fr:pf-cmg:child:feb"), 150 EUR) { origin case_input; }
        assert "ancien-feb-13": smic_horaire_retenu(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-fevrier"), 12 EUR) { origin case_input; }
        assert "ancien-feb-14": jours_remuneres(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-fevrier"), entity_ref("urn:fr:pf-cmg:child:feb"), 20.0) { origin case_input; }
    }
    evaluate truth(maximum_ancien_b(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-fevrier"), entity_ref("urn:fr:pf-cmg:child:feb"), 456.16 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(montant_cmg_du(entity_ref("urn:fr:pf-cmg:case:ancien-trois-plein-fevrier"), entity_ref("urn:fr:pf-cmg:child:feb"), 606.16 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
