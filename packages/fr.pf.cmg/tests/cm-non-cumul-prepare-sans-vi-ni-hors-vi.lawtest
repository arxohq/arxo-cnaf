// L. 531-9, para. 1, missing-evidence control (RETURN 2026-10-08): open
// L. 531-5 right plus full-rate PreParE, 2014-cohort child, but the fund
// established neither VI payment nor non-VI status — the «sauf si»
// condition is unevaluated, so no prohibition marker concludes (missing
// evidence must not prove absence). Controls — cm-non-cumul-prepare-plein
// (affirmative hors-VI) and cm-non-cumul-prepare-vi (positive exception).
language "law.core" version "0.2";
package fr.pf.cmg version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cmg";

test "urn:query:fr-pf-cmg-non-cumul-prepare-sans-vi-ni-hors-vi" {
    given {
        context { decision_time @2025-10-20T12:00:00Z; knowledge_time @2025-10-20T12:00:00Z; legal_time @2025-10-15; timezone "Europe/Paris"; }
        assert "ncpn-01": mode_garde(entity_ref("urn:fr:pf-cmg:case:ncpn"), entity_ref("urn:fr:pf-cmg:child:ncpn"), ASSISTANT_MATERNEL) { origin case_input; }
        assert "ncpn-02": exerce_activite(entity_ref("urn:fr:pf-cmg:case:ncpn")) { origin case_input; }
        assert "ncpn-03": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cmg:case:ncpn"), entity_ref("urn:fr:pf-cmg:child:ncpn")) { origin case_input; }
        assert "ncpn-04": age_revolu_ans(entity_ref("urn:fr:pf-cmg:child:ncpn"), 2) { origin case_input; }
        assert "ncpn-05": beneficie_prepare_plein(entity_ref("urn:fr:pf-cmg:case:ncpn"), entity_ref("urn:fr:pf-cmg:child:ncpn")) { origin case_input; }
        assert "ncpn-06": cohorte_l5319_2014(entity_ref("urn:fr:pf-cmg:child:ncpn")) { origin adjudicated; }
    }
    evaluate truth(cumul_prepare_plein_interdit(entity_ref("urn:fr:pf-cmg:case:ncpn"), entity_ref("urn:fr:pf-cmg:child:ncpn")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
