// Reform formula under the floor: gross 500 below the 700 - 100 = 600
// floor, retained as 600; part b = 650 x (1 - 600 x 0.0619 / 4.85)
// = 600.22495; total 800.22.
language "law.core" version "0.2";
package fr.pf.cmg version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cmg";

test "urn:query:fr-pf-cmg-formule-plancher" {
    given {
        context { decision_time @2025-10-20T12:00:00Z; knowledge_time @2025-10-20T12:00:00Z; legal_time @2025-10-15; timezone "Europe/Paris"; }
        assert "formule-plan-01": mode_garde(entity_ref("urn:fr:pf-cmg:case:formule-plancher"), entity_ref("urn:fr:pf-cmg:child:plan"), ASSISTANT_MATERNEL) { origin case_input; }
        assert "formule-plan-02": exerce_activite(entity_ref("urn:fr:pf-cmg:case:formule-plancher")) { origin case_input; }
        assert "formule-plan-03": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cmg:case:formule-plancher"), entity_ref("urn:fr:pf-cmg:child:plan")) { origin case_input; }
        assert "formule-plan-04": age_revolu_ans(entity_ref("urn:fr:pf-cmg:child:plan"), 2) { origin case_input; }
        assert "formule-plan-05": nb_enfants_charge(entity_ref("urn:fr:pf-cmg:case:formule-plancher"), 1) { origin case_input; }
        assert "formule-plan-06": facteur_smic(entity_ref("urn:fr:pf-cmg:case:formule-plancher"), 1.0) { origin case_input; }
        assert "formule-plan-07": salaire_net_verse(entity_ref("urn:fr:pf-cmg:case:formule-plancher"), entity_ref("urn:fr:pf-cmg:child:plan"), 600 EUR) { origin case_input; }
        assert "formule-plan-08": indemnites_entretien_repas(entity_ref("urn:fr:pf-cmg:case:formule-plancher"), entity_ref("urn:fr:pf-cmg:child:plan"), 50 EUR) { origin case_input; }
        assert "formule-plan-09": heures_remunerees(entity_ref("urn:fr:pf-cmg:case:formule-plancher"), entity_ref("urn:fr:pf-cmg:child:plan"), 130.0) { origin case_input; }
        assert "formule-plan-10": cotisations_sociales(entity_ref("urn:fr:pf-cmg:case:formule-plancher"), entity_ref("urn:fr:pf-cmg:child:plan"), 200 EUR) { origin case_input; }
        assert "formule-plan-11": cout_reference_retenu(entity_ref("urn:fr:pf-cmg:case:formule-plancher"), entity_ref("urn:fr:pf-cmg:child:plan"), 4.85 EUR) { origin case_input; }
        assert "formule-plan-12": montant_forfaitaire_isole(entity_ref("urn:fr:pf-cmg:case:formule-plancher"), 700 EUR) { origin case_input; }
        assert "formule-plan-13": forfait_logement(entity_ref("urn:fr:pf-cmg:case:formule-plancher"), 100 EUR) { origin case_input; }
        assert "formule-plan-14": revenu_mensuel_brut(entity_ref("urn:fr:pf-cmg:case:formule-plancher"), 500 EUR) { origin case_input; }
    }
    evaluate truth(revenu_mensuel_retenu(entity_ref("urn:fr:pf-cmg:case:formule-plancher"), 600 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(montant_cmg_du(entity_ref("urn:fr:pf-cmg:case:formule-plancher"), entity_ref("urn:fr:pf-cmg:child:plan"), 800.22 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
