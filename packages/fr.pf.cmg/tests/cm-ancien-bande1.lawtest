// Old scale, band 1: resources 15 000 under the a-ceiling
// (17 633 + 2 917 = 20 550 from stated nominal components); maximum 114.04% of the
// 400.00 BMAF = 456.16; 85% of 650.00 cut to 456.16; part a 150.00
// (600.00 under the 5 x 12 x 20 daily SMIC cap); total 606.16.
// BMAF and nominal ceiling components are stated synthetic case facts.
language "law.core" version "0.2";
package fr.pf.cmg version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cmg";

test "urn:query:fr-pf-cmg-ancien-bande1" {
    given {
        context { decision_time @2024-06-20T12:00:00Z; knowledge_time @2024-06-20T12:00:00Z; legal_time @2024-06-15; timezone "Europe/Paris"; }
        assert "ancien-b1-01": mode_garde(entity_ref("urn:fr:pf-cmg:case:ancien-bande1"), entity_ref("urn:fr:pf-cmg:child:b1"), ASSISTANT_MATERNEL) { origin case_input; }
        assert "ancien-b1-02": exerce_activite(entity_ref("urn:fr:pf-cmg:case:ancien-bande1")) { origin case_input; }
        assert "ancien-b1-03": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cmg:case:ancien-bande1"), entity_ref("urn:fr:pf-cmg:child:b1")) { origin case_input; }
        assert "ancien-b1-04": age_revolu_ans(entity_ref("urn:fr:pf-cmg:child:b1"), 2) { origin case_input; }
        assert "ancien-b1-05": age_base_ans(entity_ref("urn:fr:pf-cmg:child:b1"), 3) { origin case_input; }
        assert "ancien-b1-06": nb_enfants_charge(entity_ref("urn:fr:pf-cmg:case:ancien-bande1"), 1) { origin case_input; }
        assert "ancien-b1-07-p1": plafond_a_base_publie(entity_ref("urn:fr:pf-cmg:case:ancien-bande1"), 17633 EUR) { origin case_input; }
        assert "ancien-b1-07-p2": plafond_a_enfant_publie(entity_ref("urn:fr:pf-cmg:case:ancien-bande1"), 2917 EUR) { origin case_input; }
        assert "ancien-b1-07-p3": plafond_c_base_publie(entity_ref("urn:fr:pf-cmg:case:ancien-bande1"), 39184 EUR) { origin case_input; }
        assert "ancien-b1-07-p4": plafond_c_enfant_publie(entity_ref("urn:fr:pf-cmg:case:ancien-bande1"), 6482 EUR) { origin case_input; }
        assert "ancien-b1-08": ressources_annuelles(entity_ref("urn:fr:pf-cmg:case:ancien-bande1"), 15000 EUR) { origin case_input; }
        assert "ancien-b1-09": bmaf_retenu(entity_ref("urn:fr:pf-cmg:case:ancien-bande1"), 400.00 EUR) { origin case_input; }
        assert "ancien-b1-10": salaire_net_verse(entity_ref("urn:fr:pf-cmg:case:ancien-bande1"), entity_ref("urn:fr:pf-cmg:child:b1"), 600 EUR) { origin case_input; }
        assert "ancien-b1-11": indemnites_entretien_repas(entity_ref("urn:fr:pf-cmg:case:ancien-bande1"), entity_ref("urn:fr:pf-cmg:child:b1"), 50 EUR) { origin case_input; }
        assert "ancien-b1-12": cotisations_sociales(entity_ref("urn:fr:pf-cmg:case:ancien-bande1"), entity_ref("urn:fr:pf-cmg:child:b1"), 150 EUR) { origin case_input; }
        assert "ancien-b1-13": smic_horaire_retenu(entity_ref("urn:fr:pf-cmg:case:ancien-bande1"), 12 EUR) { origin case_input; }
        assert "ancien-b1-14": jours_remuneres(entity_ref("urn:fr:pf-cmg:case:ancien-bande1"), entity_ref("urn:fr:pf-cmg:child:b1"), 20.0) { origin case_input; }
    }
    evaluate truth(plafond1_applicable(entity_ref("urn:fr:pf-cmg:case:ancien-bande1"), 20550 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(montant_cmg_du(entity_ref("urn:fr:pf-cmg:case:ancien-bande1"), entity_ref("urn:fr:pf-cmg:child:b1"), 606.16 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
