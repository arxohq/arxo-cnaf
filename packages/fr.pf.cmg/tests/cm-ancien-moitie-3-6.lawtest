// Old scale, half rate between three and six: age 4 above the base
// age 3 opens the reduced rate; band 1 read through the shared reader
// (114.04%); maximum halved to 228.08; 85% of 650.00 cut to 228.08;
// part a 150.00; total 378.08.
language "law.core" version "0.2";
package fr.pf.cmg version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cmg";

test "urn:query:fr-pf-cmg-ancien-moitie" {
    given {
        context { decision_time @2024-06-20T12:00:00Z; knowledge_time @2024-06-20T12:00:00Z; legal_time @2024-06-15; timezone "Europe/Paris"; }
        assert "ancien-mo-01": mode_garde(entity_ref("urn:fr:pf-cmg:case:ancien-moitie"), entity_ref("urn:fr:pf-cmg:child:mo"), ASSISTANT_MATERNEL) { origin case_input; }
        assert "ancien-mo-02": exerce_activite(entity_ref("urn:fr:pf-cmg:case:ancien-moitie")) { origin case_input; }
        assert "ancien-mo-03": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cmg:case:ancien-moitie"), entity_ref("urn:fr:pf-cmg:child:mo")) { origin case_input; }
        assert "ancien-mo-04": age_revolu_ans(entity_ref("urn:fr:pf-cmg:child:mo"), 4) { origin case_input; }
        assert "ancien-mo-05": age_base_ans(entity_ref("urn:fr:pf-cmg:child:mo"), 3) { origin case_input; }
        assert "ancien-mo-06": nb_enfants_charge(entity_ref("urn:fr:pf-cmg:case:ancien-moitie"), 1) { origin case_input; }
        assert "ancien-mo-07-p1": plafond_a_base_publie(entity_ref("urn:fr:pf-cmg:case:ancien-moitie"), 17633 EUR) { origin case_input; }
        assert "ancien-mo-07-p2": plafond_a_enfant_publie(entity_ref("urn:fr:pf-cmg:case:ancien-moitie"), 2917 EUR) { origin case_input; }
        assert "ancien-mo-07-p3": plafond_c_base_publie(entity_ref("urn:fr:pf-cmg:case:ancien-moitie"), 39184 EUR) { origin case_input; }
        assert "ancien-mo-07-p4": plafond_c_enfant_publie(entity_ref("urn:fr:pf-cmg:case:ancien-moitie"), 6482 EUR) { origin case_input; }
        assert "ancien-mo-08": ressources_annuelles(entity_ref("urn:fr:pf-cmg:case:ancien-moitie"), 15000 EUR) { origin case_input; }
        assert "ancien-mo-09": bmaf_retenu(entity_ref("urn:fr:pf-cmg:case:ancien-moitie"), 400.00 EUR) { origin case_input; }
        assert "ancien-mo-10": salaire_net_verse(entity_ref("urn:fr:pf-cmg:case:ancien-moitie"), entity_ref("urn:fr:pf-cmg:child:mo"), 600 EUR) { origin case_input; }
        assert "ancien-mo-11": indemnites_entretien_repas(entity_ref("urn:fr:pf-cmg:case:ancien-moitie"), entity_ref("urn:fr:pf-cmg:child:mo"), 50 EUR) { origin case_input; }
        assert "ancien-mo-12": cotisations_sociales(entity_ref("urn:fr:pf-cmg:case:ancien-moitie"), entity_ref("urn:fr:pf-cmg:child:mo"), 150 EUR) { origin case_input; }
        assert "ancien-mo-13": smic_horaire_retenu(entity_ref("urn:fr:pf-cmg:case:ancien-moitie"), 12 EUR) { origin case_input; }
        assert "ancien-mo-14": jours_remuneres(entity_ref("urn:fr:pf-cmg:case:ancien-moitie"), entity_ref("urn:fr:pf-cmg:child:mo"), 20.0) { origin case_input; }
    }
    evaluate truth(maximum_ancien_b(entity_ref("urn:fr:pf-cmg:case:ancien-moitie"), entity_ref("urn:fr:pf-cmg:child:mo"), 228.08 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(montant_cmg_du(entity_ref("urn:fr:pf-cmg:case:ancien-moitie"), entity_ref("urn:fr:pf-cmg:child:mo"), 378.08 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
