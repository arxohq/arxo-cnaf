// L. 531-9, para. 1, «sauf si»: the same full-rate PreParE paid under
// title VI of L. 531-4 — the prohibition marker stays silent. The 2014
// cohort fact isolates the VI exception (RETURN 2026-10-08).
language "law.core" version "0.2";
package fr.pf.cmg version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cmg";

test "urn:query:fr-pf-cmg-non-cumul-prepare-vi" {
    given {
        context { decision_time @2025-10-20T12:00:00Z; knowledge_time @2025-10-20T12:00:00Z; legal_time @2025-10-15; timezone "Europe/Paris"; }
        assert "ncpv-01": mode_garde(entity_ref("urn:fr:pf-cmg:case:ncpv"), entity_ref("urn:fr:pf-cmg:child:ncpv"), ASSISTANT_MATERNEL) { origin case_input; }
        assert "ncpv-02": exerce_activite(entity_ref("urn:fr:pf-cmg:case:ncpv")) { origin case_input; }
        assert "ncpv-03": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cmg:case:ncpv"), entity_ref("urn:fr:pf-cmg:child:ncpv")) { origin case_input; }
        assert "ncpv-04": age_revolu_ans(entity_ref("urn:fr:pf-cmg:child:ncpv"), 2) { origin case_input; }
        assert "ncpv-05": beneficie_prepare_plein(entity_ref("urn:fr:pf-cmg:case:ncpv"), entity_ref("urn:fr:pf-cmg:child:ncpv")) { origin case_input; }
        assert "ncpv-06": prepare_verse_titre_vi(entity_ref("urn:fr:pf-cmg:case:ncpv"), entity_ref("urn:fr:pf-cmg:child:ncpv")) { origin case_input; }
        assert "ncpv-07": cohorte_l5319_2014(entity_ref("urn:fr:pf-cmg:child:ncpv")) { origin adjudicated; }
    }
    evaluate truth(cumul_prepare_plein_interdit(entity_ref("urn:fr:pf-cmg:case:ncpv"), entity_ref("urn:fr:pf-cmg:child:ncpv")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
