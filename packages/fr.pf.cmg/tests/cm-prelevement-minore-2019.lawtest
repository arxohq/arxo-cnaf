// L. 531-8-1, 2019 wording: levy 450 EUR reduced by the 150 EUR
// supplement amount — the 300 EUR minoré levy is built in the
// [@2021-01-01, @2021-12-25) window.
language "law.core" version "0.2";
package fr.pf.cmg version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cmg";

test "urn:query:fr-pf-cmg-prelevement-minore-2019" {
    given {
        context { decision_time @2021-06-20T12:00:00Z; knowledge_time @2021-06-20T12:00:00Z; legal_time @2021-06-10; timezone "Europe/Paris"; }
        assert "pm19-01": prelevement_cesu_base(entity_ref("urn:fr:pf-cmg:case:pm19"), 450 EUR) { origin case_input; }
        assert "pm19-02": cmg_imputable_l5318(entity_ref("urn:fr:pf-cmg:case:pm19"), entity_ref("urn:fr:pf-cmg:child:pm19"), 150 EUR) { origin case_input; }
    }
    evaluate truth(prelevement_cesu_minore(entity_ref("urn:fr:pf-cmg:case:pm19"), entity_ref("urn:fr:pf-cmg:child:pm19"), 300 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
