@source(CSS_D531_22_ED2025_09)
rule AideStructureMajoree30AEEHSousMaximum(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, depense: Money, maximum: Money) strict {
    effective [@2025-09-01, infinity);
    label fr official "L. 541-1: 85 % sous maximum majoré de 30 %";
