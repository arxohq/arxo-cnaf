// --- Monthly amount due ------------------------------------------------------------------
//
// Halves 3-6 (IV) and PreParE part-time (VII) already sit in the
// maxima; monthly payment on filed justification (VI) gates the duty
// in 08, not the amount.

@source(CSS_L531_6_ED2020_01, CSS_L531_6_ED2024_09, CSS_L531_6_ED2025_01, CSS_L531_6_ED2025_02, CSS_L531_6_ED2025_09, CSS_D531_23_ED2020_01, CSS_D531_23_ED2021_09, CSS_D531_21_ED2025_09)
rule MontantStructureDu(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, aide: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "montant L. 531-6 dû, arrondi au centime";
    label en unofficial "L. 531-6 amount due, rounded to cents";
    when aide_structure(p, e, aide);
    then montant_structure_du(p, e, round(aide, 2, "HALF_UP"));
}

// --- Three-to-six age marker (reform halve ground, D. 531-21 IV) -------------------
//
// The reform full rows above read it through not_known; the halved rows
// below read the positive age range inline.

@source(CSS_D531_21_ED2025_09)
rule AgeMoitie36(e: fr.pf.core::Enfant, n: Integer) strict {
    effective [@2025-09-01, infinity);
    label fr official "trois à six ans révolus: assiette de la moitié (D. 531-21, IV)";
    label en unofficial "age three to six: halve base (D. 531-21, IV)";
    when age_revolu_ans(e, n) and n >= AgeSeuil3 and n < AgeLimite6;
    then age_moitie36(e);
}
