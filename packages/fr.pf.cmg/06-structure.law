    then maximum_structure(p, e, round(TauxStructureAssmatBande3 * bmaf, 2, "HALF_UP"));
}
@source(CSS_D531_23_ED2020_01, CSS_D531_23_ED2021_09, CSS_D531_21_ED2025_09)
rule MaximumStructureDom1(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, mode: ModeGarde, r: Money, p1: Money, bmaf: Money) strict {
    effective [@2021-01-01, @2025-09-01);
    label fr official "maximum domicile/EAJE bande 1: 208,53 % (ancien droit)";
    label en unofficial "home/EAJE band-1 maximum: 208.53% (old law)";
    when droit_structure_ouvert(p, e) and mode_garde(p, e, mode) and mode != ASSISTANT_MATERNEL and mode != STRUCTURE and ressources_annuelles(p, r) and plafond1_applicable(p, p1) and r <= p1 and bmaf_retenu(p, bmaf) and not_known(age_taux_reduit(p, e)) and not_known(preparer_temps_partiel(p)) and not_known(arrondi_maximum_cmg(p, e));
    then maximum_structure(p, e, TauxStructureDomBande1 * bmaf);
}

@source(CSS_D531_21_ED2025_09)
rule MaximumStructureDom1Reforme(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, mode: ModeGarde, r: Money, p1: Money, bmaf: Money) strict {
    effective [@2025-09-01, infinity);
