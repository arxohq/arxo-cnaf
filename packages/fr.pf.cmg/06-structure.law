    when droit_structure_ouvert(p, e) and mode_garde(p, e, mode) and mode != ASSISTANT_MATERNEL and mode != STRUCTURE and ressources_annuelles(p, r) and plafond1_applicable(p, p1) and r <= p1 and bmaf_retenu(p, bmaf) and not_known(age_moitie36(e)) and not_known(age_taux_reduit(p, e)) and not_known(preparer_temps_partiel(p));
    then maximum_structure(p, e, round(TauxStructureDomBande1 * bmaf, 2, "HALF_UP"));
}
