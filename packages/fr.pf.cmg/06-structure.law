// --- Halves ------------------------------------------------------------------------
//
// Old grounds (full window — age_taux_reduit only exists pre-reform):
// reduced-rate age and part-time PreParE. New ground 3–6 (reform
// window, D. 531-21 IV; VII sends part-time PreParE to the same halves).

// --- Band rate readers (shared by the halved rows) ------------------------------

@source(CSS_D531_23_ED2020_01, CSS_D531_23_ED2021_09, CSS_D531_21_ED2025_09)
rule TauxBandeStructureAm1(p: fr.pf.core::Personne, r: Money, p1: Money, p2: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "bande structure assistante maternelle 1";
    label en unofficial "structure childminder band 1";
    when ressources_annuelles(p, r) and plafond1_applicable(p, p1) and plafond2_applicable(p, p2) and r <= p1;
    then taux_bande_structure_am(p, r, p1, p2, TauxStructureAssmatBande1);
}

@source(CSS_D531_23_ED2020_01, CSS_D531_23_ED2021_09, CSS_D531_21_ED2025_09)
rule TauxBandeStructureAm2(p: fr.pf.core::Personne, r: Money, p1: Money, p2: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "bande structure assistante maternelle 2";
    label en unofficial "structure childminder band 2";
    when ressources_annuelles(p, r)
        and plafond1_applicable(p, p1) and plafond2_applicable(p, p2)
        and r > p1 and r <= p2;
    then taux_bande_structure_am(p, r, p1, p2, TauxStructureAssmatBande2);
}

@source(CSS_D531_23_ED2020_01, CSS_D531_23_ED2021_09, CSS_D531_21_ED2025_09)
rule TauxBandeStructureAm3(p: fr.pf.core::Personne, r: Money, p1: Money, p2: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "bande structure assistante maternelle 3";
    label en unofficial "structure childminder band 3";
    when ressources_annuelles(p, r) and plafond1_applicable(p, p1) and plafond2_applicable(p, p2) and r > p2;
    then taux_bande_structure_am(p, r, p1, p2, TauxStructureAssmatBande3);
}

@source(CSS_D531_23_ED2020_01, CSS_D531_23_ED2021_09, CSS_D531_21_ED2025_09)
rule TauxBandeStructureDom1(p: fr.pf.core::Personne, r: Money, p1: Money, p2: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "bande domicile/EAJE 1";
    label en unofficial "home/EAJE band 1";
    when ressources_annuelles(p, r) and plafond1_applicable(p, p1) and plafond2_applicable(p, p2) and r <= p1;
    then taux_bande_structure_dom(p, r, p1, p2, TauxStructureDomBande1);
}

@source(CSS_D531_23_ED2020_01, CSS_D531_23_ED2021_09, CSS_D531_21_ED2025_09)
rule TauxBandeStructureDom2(p: fr.pf.core::Personne, r: Money, p1: Money, p2: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "bande domicile/EAJE 2";
