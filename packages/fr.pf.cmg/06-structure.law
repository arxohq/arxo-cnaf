        and plafond1_applicable(p, p1) and plafond2_applicable(p, p2)
        and r > p1 and r <= p2;
    then taux_bande_structure_dom(p, r, p1, p2, TauxStructureDomBande2);
}

@source(CSS_D531_23_ED2020_01, CSS_D531_23_ED2021_09, CSS_D531_21_ED2025_09)
rule TauxBandeStructureDom3(p: fr.pf.core::Personne, r: Money, p1: Money, p2: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "bande domicile/EAJE 3";
    label en unofficial "home/EAJE band 3";
    when ressources_annuelles(p, r) and plafond1_applicable(p, p1) and plafond2_applicable(p, p2) and r > p2;
    then taux_bande_structure_dom(p, r, p1, p2, TauxStructureDomBande3);
}

// --- Halved maxima ------------------------------------------------------------------
//
// Old grounds (age_taux_reduit implies the old window; PreParE spans
// both): halved on the old and new figures alike. New ground 3–6
// (reform window only).

@source(CSS_D531_23_ED2020_01, CSS_D531_23_ED2021_09)
rule MaximumStructureReduitAmAge(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, r: Money, p1: Money, p2: Money, bmaf: Money, t: Decimal) strict {
    effective [@2021-01-01, @2025-09-01);
    label fr official "maximum assistante maternelle divisé par deux (taux réduit ancien)";
    label en unofficial "childminder maximum halved (old reduced rate)";
    when droit_structure_ouvert(p, e) and mode_garde(p, e, STRUCTURE) and age_taux_reduit(p, e)
        and ressources_annuelles(p, r) and plafond1_applicable(p, p1) and plafond2_applicable(p, p2)
        and bmaf_retenu(p, bmaf) and taux_bande_structure_am(p, r, p1, p2, t) and not_known(arrondi_maximum_cmg(p, e));
    then maximum_structure(p, e, t * bmaf / 2.0);
}

@source(CSS_D531_23_ED2020_01, CSS_D531_23_ED2021_09)
rule MaximumStructureReduitDomAge(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, mode: ModeGarde, r: Money, p1: Money, p2: Money, bmaf: Money, t: Decimal) strict {
    effective [@2021-01-01, @2025-09-01);
    label fr official "maximum domicile/EAJE divisé par deux (taux réduit ancien)";
    label en unofficial "home/EAJE maximum halved (old reduced rate)";
    when droit_structure_ouvert(p, e) and mode_garde(p, e, mode) and mode != ASSISTANT_MATERNEL and mode != STRUCTURE and age_taux_reduit(p, e)
        and ressources_annuelles(p, r) and plafond1_applicable(p, p1) and plafond2_applicable(p, p2)
        and bmaf_retenu(p, bmaf) and taux_bande_structure_dom(p, r, p1, p2, t) and not_known(arrondi_maximum_cmg(p, e));
    then maximum_structure(p, e, t * bmaf / 2.0);
}

@source(CSS_D531_23_ED2020_01, CSS_D531_23_ED2021_09, CSS_D531_21_ED2025_09)
rule MaximumStructureReduitAmPreParE(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, r: Money, p1: Money, p2: Money, bmaf: Money, t: Decimal) strict {
    effective [@2021-01-01, infinity);
    label fr official "maximum assistante maternelle divisé par deux (PreParE à temps partiel)";
    label en unofficial "childminder maximum halved (part-time PreParE)";
    when droit_structure_ouvert(p, e) and mode_garde(p, e, STRUCTURE) and preparer_temps_partiel(p)
        and ressources_annuelles(p, r) and plafond1_applicable(p, p1) and plafond2_applicable(p, p2)
        and bmaf_retenu(p, bmaf) and taux_bande_structure_am(p, r, p1, p2, t) and not_known(arrondi_maximum_cmg(p, e));
    then maximum_structure(p, e, t * bmaf / 2.0);
}

@source(CSS_D531_23_ED2020_01, CSS_D531_23_ED2021_09, CSS_D531_21_ED2025_09)
rule MaximumStructureReduitDomPreParE(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, mode: ModeGarde, r: Money, p1: Money, p2: Money, bmaf: Money, t: Decimal) strict {
    effective [@2021-01-01, infinity);
    label fr official "maximum domicile/EAJE divisé par deux (PreParE à temps partiel)";
    label en unofficial "home/EAJE maximum halved (part-time PreParE)";
    when droit_structure_ouvert(p, e) and mode_garde(p, e, mode) and mode != ASSISTANT_MATERNEL and mode != STRUCTURE and preparer_temps_partiel(p)
        and ressources_annuelles(p, r) and plafond1_applicable(p, p1) and plafond2_applicable(p, p2)
        and bmaf_retenu(p, bmaf) and taux_bande_structure_dom(p, r, p1, p2, t) and not_known(arrondi_maximum_cmg(p, e));
    then maximum_structure(p, e, t * bmaf / 2.0);
}

@source(CSS_D531_21_ED2025_09)
rule MaximumStructureReduitAm36(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, r: Money, p1: Money, p2: Money, bmaf: Money, t: Decimal, n: Integer) strict {
    effective [@2025-09-01, infinity);
    label fr official "maximum assistante maternelle divisé par deux entre trois et six ans (D. 531-21, IV)";
    label en unofficial "childminder maximum halved between three and six (D. 531-21, IV)";
    when droit_structure_ouvert(p, e) and mode_garde(p, e, STRUCTURE)
        and age_revolu_ans(e, n) and n >= AgeSeuil3 and n < AgeLimite6
        and ressources_annuelles(p, r) and plafond1_applicable(p, p1) and plafond2_applicable(p, p2)
        and bmaf_retenu(p, bmaf) and taux_bande_structure_am(p, r, p1, p2, t);
    then maximum_structure(p, e, t * bmaf / 2.0);
}

@source(CSS_D531_21_ED2025_09)
rule MaximumStructureReduitDom36(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, mode: ModeGarde, r: Money, p1: Money, p2: Money, bmaf: Money, t: Decimal, n: Integer) strict {
    effective [@2025-09-01, infinity);
    label fr official "maximum domicile/EAJE divisé par deux entre trois et six ans (D. 531-21, IV)";
    label en unofficial "home/EAJE maximum halved between three and six (D. 531-21, IV)";
    when droit_structure_ouvert(p, e)
        and mode_garde(p, e, mode) and mode != ASSISTANT_MATERNEL and mode != STRUCTURE
        and age_revolu_ans(e, n) and n >= AgeSeuil3 and n < AgeLimite6
        and ressources_annuelles(p, r) and plafond1_applicable(p, p1) and plafond2_applicable(p, p2)
        and bmaf_retenu(p, bmaf) and taux_bande_structure_dom(p, r, p1, p2, t);
    then maximum_structure(p, e, t * bmaf / 2.0);
}

// --- Aid: 85% of expense under the maxima (strict disjoint rows) -------------------
//
// «La prise en charge partielle ... est fixée au maximum à 85 % de la
// dépense engagée». Majorations raise the maxima (+10% specific hours,
// +30% AAH/disability/single): the base aid rows are strict and
// disjoint from the majorated rows (not_known on the majoration
// grounds); the majorated rows conclude under the raised maxima on the
// positive grounds. Co-occurring +30% grounds yield the same value, so
// no precedence is needed among them; a +10% ground co-occurring with
// a +30% ground yields to the +30% rows (B-CMG-MAJO-COEX: no
// cumulation of majorations, single majoration retained).

@source(CSS_D531_23_ED2020_01, CSS_D531_23_ED2021_09, CSS_D531_21_ED2025_09)
rule AideStructureSousMaximum(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, depense: Money, maximum: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "85 % de la dépense sous le maximum: 85 %";
    label en unofficial "85% of expense under the maximum: 85%";
    when droit_structure_ouvert(p, e) and depense_engagee(p, e, depense) and maximum_structure(p, e, maximum) and TauxPriseEnCharge85 * depense <= maximum and not_known(horaires_atypiques(p)) and not_known(beneficiaire_aah(p)) and not_known(personne_seule(p)) and not_known(enfant_aeeh(e));
    then aide_structure(p, e, TauxPriseEnCharge85 * depense);
}

@source(CSS_D531_23_ED2020_01, CSS_D531_23_ED2021_09, CSS_D531_21_ED2025_09)
rule AideStructureEcretee(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, depense: Money, maximum: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "85 % écrêté au maximum";
    label en unofficial "85% cut to the maximum";
    when droit_structure_ouvert(p, e) and depense_engagee(p, e, depense) and maximum_structure(p, e, maximum) and TauxPriseEnCharge85 * depense > maximum and not_known(horaires_atypiques(p)) and not_known(beneficiaire_aah(p)) and not_known(personne_seule(p)) and not_known(enfant_aeeh(e));
    then aide_structure(p, e, maximum);
}

@source(CSS_D531_22_ED2025_09)
rule AideStructureSpecifiquesSousMaximum(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, depense: Money, maximum: Money, h: Decimal) strict {
    effective [@2025-09-01, infinity);
    label fr official "horaires spécifiques: 85 % sous maximum majoré de 10 %";
    label en unofficial "specific hours: 85% under the 10%-raised maximum";
    when droit_structure_ouvert(p, e) and horaires_atypiques(p) and heures_specifiques(p, e, h) and h >= SeuilSpecifiques25 and depense_engagee(p, e, depense) and maximum_structure(p, e, maximum) and TauxPriseEnCharge85 * depense <= maximum * MajorationSpecifiques10 and not_known(beneficiaire_aah(p)) and not_known(personne_seule(p)) and not_known(enfant_aeeh(e));
    then aide_structure(p, e, TauxPriseEnCharge85 * depense);
}

@source(CSS_D531_22_ED2025_09)
rule AideStructureSpecifiquesEcretee(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, depense: Money, maximum: Money, h: Decimal) strict {
    effective [@2025-09-01, infinity);
    label fr official "horaires spécifiques: maximum majoré de 10 %";
    label en unofficial "specific hours: 10%-raised maximum";
    when droit_structure_ouvert(p, e) and horaires_atypiques(p) and heures_specifiques(p, e, h) and h >= SeuilSpecifiques25 and depense_engagee(p, e, depense) and maximum_structure(p, e, maximum) and TauxPriseEnCharge85 * depense > maximum * MajorationSpecifiques10 and not_known(beneficiaire_aah(p)) and not_known(personne_seule(p)) and not_known(enfant_aeeh(e));
    then aide_structure(p, e, maximum * MajorationSpecifiques10);
}

@source(CSS_D531_22_ED2025_09)
rule AideStructureMajoree30AAHSousMaximum(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, depense: Money, maximum: Money) strict {
    effective [@2025-09-01, infinity);
    label fr official "AAH: 85 % sous maximum majoré de 30 %";
    label en unofficial "AAH: 85% under the 30%-raised maximum";
    when droit_structure_ouvert(p, e) and beneficiaire_aah(p)
        and depense_engagee(p, e, depense)
        and maximum_structure(p, e, maximum)
        and TauxPriseEnCharge85 * depense <= maximum * MajorationTrente30;
    then aide_structure(p, e, TauxPriseEnCharge85 * depense);
}

@source(CSS_D531_22_ED2025_09)
rule AideStructureMajoree30AAHEcretee(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, depense: Money, maximum: Money) strict {
    effective [@2025-09-01, infinity);
    label fr official "AAH: maximum majoré de 30 %";
