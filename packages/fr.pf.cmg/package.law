pub relation choix_partage_af(p1: fr.pf.core::Personne, p2: fr.pf.core::Personne) kind empirical {
    label fr official "les deux parents ont choisi chacun la qualité d'allocataire AF (R. 521-2; voisin fr.pf.af; fait établi)";
