pub relation eligible_af_partage(p: fr.pf.core::Personne) kind empirical {
    label fr official "le ménage est éligible aux allocations familiales pour le choix R. 521-2 (D. 531-18-2, 2°; fait établi)";
    label en unofficial "household is AF-eligible for the R. 521-2 choice (D. 531-18-2, 2°; established fact)";
