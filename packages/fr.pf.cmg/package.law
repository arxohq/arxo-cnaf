pub relation dispense_activite(m: fr.pf.core::Personne) kind empirical {
    label fr official "dispense de la condition d'activité: études, service civique, AAH/chômage, RSA en insertion (L. 531-5, I al. 7-11)";
    label en unofficial "activity-condition waiver: studies, civic service, AAH/unemployment, RSA in insertion (L. 531-5, I paras. 7-11)";
