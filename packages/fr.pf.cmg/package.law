// --- Activity condition inputs (L. 531-5, I + D. 531-19 + R. 531-5/6) ---

pub relation exerce_activite(m: fr.pf.core::Personne) kind empirical {
    label fr official "le ménage ou la personne seule exerce une activité professionnelle au mois apprécié (R. 531-5)";
    label en unofficial "the household or single person works in the assessed month (R. 531-5)";
