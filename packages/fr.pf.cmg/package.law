pub relation situation_naissance_supplementaire(m: fr.pf.core::Personne) kind empirical {
    label fr official "indemnités supplémentaires de naissance perçues (D. 531-19 éd. 2026-07 uniquement)";
    label en unofficial "supplementary birth allowances received (D. 531-19 2026-07 wording only)";
