// --- Shared residence inputs (D. 531-18-2, from 01.12.2025) ---

pub relation residence_alternee_effective(e: fr.pf.core::Enfant) kind empirical {
    label fr official "résidence alternée 373-2-9 mise en œuvre effective (D. 531-18-2, 1°)";
    label en unofficial "effective shared residence under Art. 373-2-9 (D. 531-18-2, 1°)";
