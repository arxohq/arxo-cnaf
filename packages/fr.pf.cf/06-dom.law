    CSS_R755_3_ED2018_01,
    CSS_R755_3_ED2018_04,
    CSS_R755_3_ED2020_04,
    CSS_R755_3_ED2022_10,
    CSS_R522_3,
    CSS_R522_3_ED2014_04,
    CSS_R522_3_ED2017_04,
    CSS_R522_3_ED2018_01,
    CSS_R522_3_ED2018_04,
    CSS_R522_3_ED2020_04,
    CSS_R522_3_ED2022_10,
    CSS_D755_6,
    CSS_D755_6_ED2022_10)
rule CfDomDifferentielGrand(p: fr.pf.core::Personne, n: Integer, r: Money, plafond: Money, base: Money, t: Territoire) strict {
    effective [@2021-01-01, infinity);
    label fr official "DOM département, trois enfants et plus, dépassement inférieur à douze mensualités: différentiel au douzième de l'écart (L. 755-16 al. 4, R. 755-3)";
    label en unofficial "DOM department, three or more children, overrun under twelve monthly amounts: differential at one twelfth of the gap (L. 755-16 para. 4, R. 755-3)";
    when territoire(p, t) and t != METROPOLE and t != MAYOTTE and t != AUTRE
        and departement_l751_1(t)
        and cadre_cf_dom_remplie(p) and presence_jeune_dom(p)
        and nb_enfants_cf(p, n) and n >= 3
        and plafond_cf_applicable(p, plafond)
        and ressources_menage(p, r) and base_dom_retenue(p, base)
        and r > plafond and r - plafond < 12.0 * (TauxCfDomBase * base);
    then cf_dom_differentiel_du(p, (plafond + 12.0 * (TauxCfDomBase * base) - r) / 12.0);
}

@source(
    CSS_L755_16,
    CSS_L755_16_ED2018_01,
    CSS_L755_16_ED2018_04,
    CSS_L755_16_ED2020_04,
    CSS_L755_16_ED2022_10,
    CSS_L755_16_1,
    CSS_L755_16_1_ED2018_01,
    CSS_L755_16_1_ED2018_04,
    CSS_L755_16_1_ED2020_04,
    CSS_L755_16_1_ED2022_10)
// Title V statutory scope (D-76): L. 755-16/16-1 carry no local
// territorial phrase and sit under the Title V header naming the six
// L. 751-1 collectivities; the six enum values spell that header. No
// department fact and no R. 755-1 premise: scope only.
rule CfTitreVPortee(p: fr.pf.core::Personne, t: Territoire) strict {
    effective [@2021-01-01, infinity);
    label fr official "portée statutaire titre V : ménage dans une collectivité L. 751-1 (L. 755-16, L. 755-16-1)";
    label en unofficial "Title V statutory scope: household in an L. 751-1 collectivity (L. 755-16, L. 755-16-1)";
    when territoire(p, t) and t != METROPOLE and t != MAYOTTE and t != AUTRE;
    then cf_titre_v_portee(p);
}

@source(
    CSS_L755_16,
    CSS_L755_16_ED2018_01,
    CSS_L755_16_ED2018_04,
    CSS_L755_16_ED2020_04,
    CSS_L755_16_ED2022_10,
    CSS_D755_6,
    CSS_D755_6_ED2022_10)
// Available base amount for a qualifying Title V collectivity household:
// the generic D. 755-6 rate on the stated L. 755-3 base. The retained
// Title V frame stands where non-department regulatory detail is not
// pinned; no R. 755-1 age, ceiling or department premise is asserted, the
// amount is available rather than due, and no duty reads it.
rule CfTitreVMontantDisponible(p: fr.pf.core::Personne, base: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "montant titre V disponible : 41,65 % de la base L. 755-3, cadre titre V réuni (L. 755-16, D. 755-6)";
    label en unofficial "Title V amount available: 41.65% of the L. 755-3 base, Title V frame met (L. 755-16, D. 755-6)";
    when cf_titre_v_portee(p) and cadre_cf_titre_v_remplie(p)
        and base_dom_retenue(p, base);
    then cf_titre_v_montant_disponible(p, round(TauxCfDomBase * base, 2, "HALF_UP"));
}

@source(
    CSS_L755_16_1,
    CSS_L755_16_1_ED2018_01,
    CSS_L755_16_1_ED2018_04,
    CSS_L755_16_1_ED2020_04,
    CSS_L755_16_1_ED2022_10,
    CSS_D755_6_1,
    CSS_D755_6_1_ED2022_10)
// Available increased amount for a qualifying Title V collectivity
// household: the generic D. 755-6-1 rate on stated BMAF, same retained
// frame contract as the base track. No exclusivity against the base
// available amount is asserted: the half-ceiling test stays
// department-linked via R. 755-4.
rule CfTitreVMajoreDisponible(p: fr.pf.core::Personne, bmaf: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "montant majoré titre V disponible : taux en vigueur sur BMAF, cadre titre V réuni (L. 755-16-1, D. 755-6-1)";
    label en unofficial "Title V increased amount available: rate in force on BMAF, Title V frame met (L. 755-16-1, D. 755-6-1)";
    when cf_titre_v_portee(p) and cadre_cf_titre_v_remplie(p)
        and bmaf_retenu(p, bmaf);
    then cf_titre_v_majore_disponible(p, round(TauxCfDomMajore * bmaf, 2, "HALF_UP"));
}

@source(
    CSS_L755_16,
    CSS_L755_16_ED2018_01,
    CSS_L755_16_ED2018_04,
    CSS_L755_16_ED2020_04,
    CSS_L755_16_ED2022_10,
    CSS_D755_6,
    CSS_D755_6_ED2022_10)
rule DevoirVerserCfDom(o: fr.pf.core::Organisme, p: fr.pf.core::Personne, montant: Money) strict {
    label fr official "l'organisme débiteur paie au ménage DOM le complément mensuel dû";
    label en unofficial "the debtor fund pays the DOM household the monthly complement due";
    when cf_dom_montant_du(p, montant) and fr.pf.core::organisme_debiteur_pf(o, p);
    then duty PayerCfDomDu {
        bearer o;
        beneficiary p;
        maintain cf_verse(p, montant) during [@2021-01-01, infinity);
    };
}

@source(
    CSS_L755_16_1,
    CSS_L755_16_1_ED2018_01,
    CSS_L755_16_1_ED2018_04,
    CSS_L755_16_1_ED2020_04,
    CSS_L755_16_1_ED2022_10,
    CSS_D755_6_1,
    CSS_D755_6_1_ED2022_10)
rule DevoirVerserCfDomMajore(o: fr.pf.core::Organisme, p: fr.pf.core::Personne, montant: Money) strict {
    label fr official "l'organisme débiteur paie au ménage DOM le montant majoré dû";
    label en unofficial "the debtor fund pays the DOM household the increased amount due";
    when cf_dom_majore_du(p, montant) and fr.pf.core::organisme_debiteur_pf(o, p);
    then duty PayerCfDomMajoreDu {
        bearer o;
        beneficiary p;
        maintain cf_verse(p, montant) during [@2021-01-01, infinity);
    };
}

@source(
    CSS_L755_16,
    CSS_L755_16_ED2018_01,
    CSS_L755_16_ED2018_04,
    CSS_L755_16_ED2020_04,
    CSS_L755_16_ED2022_10,
    CSS_R755_3,
    CSS_R755_3_ED2018_01,
    CSS_R755_3_ED2018_04,
    CSS_R755_3_ED2020_04,
    CSS_R755_3_ED2022_10)
rule DevoirVerserCfDomDifferentiel(o: fr.pf.core::Organisme, p: fr.pf.core::Personne, montant: Money) strict {
    label fr official "l'organisme débiteur paie au ménage DOM le complément différentiel dû";
    label en unofficial "the debtor fund pays the DOM household the differential top-up due";
    when cf_dom_differentiel_du(p, montant) and fr.pf.core::organisme_debiteur_pf(o, p);
    then duty PayerCfDomDifferentielDu {
        bearer o;
        beneficiary p;
        maintain cf_verse(p, montant) during [@2021-01-01, infinity);
    };
}
