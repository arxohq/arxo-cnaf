    effective [@2021-01-01, infinity);
    label fr official "DOM majoré, un enfant, couple biactif: plafond de base publié du montant majoré plus sa majoration de 25 % publiée et majoration publiée pour double activité ou isolement (R. 755-4, R. 522-4, R. 522-2 al. 2-3)";
    label en unofficial "DOM increased, one child, two-earner couple: published increased-amount base plus its published 25% increment and the published two-earner or lone-parent increment (R. 755-4, R. 522-4, R. 522-2 paras. 2-3)";
    when plafond_base_majore(p, base) and majoration_enfant_majore(p, enfant) and nb_enfants_cf(p, 1)
        and couple_biactif(p) and majoration_biactivite_majore(p, majoration);
    then cf_dom_plafond_majore(p, base + enfant + majoration);
}

