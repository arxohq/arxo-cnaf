    effective [@2021-01-01, infinity);
    label fr official "DOM, un enfant, couple biactif: plafond de base publié plus la majoration de 25 % publiée et majoration publiée pour double activité ou isolement (R. 755-2, R. 522-2 al. 3)";
    label en unofficial "DOM, one child, two-earner couple: published base plus the published 25% increment and the published two-earner or lone-parent increment (R. 755-2, R. 522-2 para. 3)";
    when plafond_base_cf(p, base) and majoration_enfant_cf(p, enfant) and nb_enfants_cf(p, 1)
        and couple_biactif(p) and majoration_biactivite(p, majoration);
    then cf_dom_plafond(p, base + enfant + majoration);
}

