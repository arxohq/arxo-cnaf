rule MajoreDomUnSansMajoration(p: fr.pf.core::Personne, base: Money, enfant: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "DOM majoré, un enfant, ni biactif ni isolé: plafond de base publié du montant majoré plus sa majoration de 25 % publiée (R. 755-4, R. 522-4)";
    label en unofficial "DOM increased, one child, neither two-earner nor lone: published increased-amount base plus its published 25% increment (R. 755-4, R. 522-4)";
    when plafond_base_majore(p, base) and majoration_enfant_majore(p, enfant) and nb_enfants_cf(p, 1)
        and foyer_du_cas(p) and not couple_biactif(p) and not parent_isole(p);
    then cf_dom_plafond_majore(p, base + enfant);
}

