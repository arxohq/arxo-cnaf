    label fr official "DOM, un enfant, parent isolé: plafond de base publié plus la majoration de 25 % publiée et majoration publiée pour double activité ou isolement (R. 755-2, R. 522-2 al. 3)";
    label en unofficial "DOM, one child, lone parent: published base plus the published 25% increment and the published two-earner or lone-parent increment (R. 755-2, R. 522-2 para. 3)";
    when plafond_base_cf(p, base) and majoration_enfant_cf(p, enfant) and nb_enfants_cf(p, 1)
        and parent_isole(p) and majoration_biactivite(p, majoration);
    then cf_dom_plafond(p, base + enfant + majoration);
