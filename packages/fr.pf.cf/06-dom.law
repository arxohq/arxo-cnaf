    CSS_R522_2_PRE2022,
    CSS_R522_2_PRE2022_ED2014_01,
    CSS_R522_2_PRE2022_ED2014_04,
    CSS_R522_2_PRE2022_ED2017_04,
    CSS_R522_2_PRE2022_ED2018_01,
    CSS_R522_2_PRE2022_ED2018_04,
    CSS_R522_2_PRE2022_ED2020_04)
rule PlafondDomUnSansMajoration(p: fr.pf.core::Personne, base: Money, enfant: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "DOM, un enfant, ni biactif ni isolé: plafond de base publié plus la majoration de 25 % publiée (R. 755-2, R. 522-2 al. 1-2)";
    label en unofficial "DOM, one child, neither two-earner nor lone: published base plus the published 25% increment (R. 755-2, R. 522-2 paras. 1-2)";
    when plafond_base_cf(p, base) and majoration_enfant_cf(p, enfant) and nb_enfants_cf(p, 1)
        and foyer_du_cas(p) and not couple_biactif(p) and not parent_isole(p);
    then cf_dom_plafond(p, base + enfant);
}

