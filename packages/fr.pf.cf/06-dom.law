    CSS_R755_2_ED2020_04,
    CSS_R755_2_ED2022_10)
rule CfDomDroitOuvertGrand(p: fr.pf.core::Personne, n: Integer, r: Money, plafond: Money, t: Territoire) strict {
    effective [@2021-01-01, infinity);
    label fr official "DOM département, trois enfants et plus, ressources sous plafond: droit ouvert, plafond métropolitain en liaison (L. 755-16, R. 755-1, R. 755-2)";
    label en unofficial "DOM department, three or more children, resources within the ceiling: right open, metropolitan ceiling by liaison (L. 755-16, R. 755-1, R. 755-2)";
    when territoire(p, t) and t != METROPOLE and t != MAYOTTE and t != AUTRE
        and departement_l751_1(t)
        and cadre_cf_dom_remplie(p) and presence_jeune_dom(p)
        and nb_enfants_cf(p, n) and n >= 3
        and ressources_menage(p, r) and plafond_cf_applicable(p, plafond) and r <= plafond;
    then cf_dom_droit_ouvert(p);
}

@source(
    CSS_D755_6,
    CSS_D755_6_ED2022_10)
rule CfDomMontantBasePetit(p: fr.pf.core::Personne, r: Money, plafond_majore: Money, base: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "montant DOM: 41,65 % de la base L. 755-3, hors ménage sous le plafond moitié (D. 755-6, L. 755-16-1)";
    label en unofficial "DOM amount: 41.65% of the L. 755-3 base, excluding a household within the half ceiling (D. 755-6, L. 755-16-1)";
    when cf_dom_droit_ouvert(p) and ressources_menage(p, r)
        and cf_dom_plafond_majore(p, plafond_majore) and r > plafond_majore
        and base_dom_retenue(p, base);
    then cf_dom_montant_du(p, round(TauxCfDomBase * base, 2, "HALF_UP"));
}

@source(
    CSS_D755_6,
    CSS_D755_6_ED2022_10)
rule CfDomMontantBaseGrand(p: fr.pf.core::Personne, r: Money, plafond_majore: Money, base: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "montant DOM, trois enfants et plus: 41,65 % de la base L. 755-3, hors ménage sous le plafond moitié (D. 755-6, L. 755-16-1)";
    label en unofficial "DOM amount, three or more children: 41.65% of the L. 755-3 base, excluding a household within the half ceiling (D. 755-6, L. 755-16-1)";
    when cf_dom_droit_ouvert(p) and ressources_menage(p, r)
        and plafond_majore_applicable(p, plafond_majore) and r > plafond_majore
        and base_dom_retenue(p, base);
    then cf_dom_montant_du(p, round(TauxCfDomBase * base, 2, "HALF_UP"));
}

@source(
    CSS_L755_16_1,
    CSS_L755_16_1_ED2018_01,
    CSS_L755_16_1_ED2018_04,
    CSS_L755_16_1_ED2020_04,
    CSS_L755_16_1_ED2022_10,
