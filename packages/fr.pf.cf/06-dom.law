};

@source(
    CSS_R755_1,
    CSS_R755_1_ED2000_01,
    CSS_R755_1_ED2003_12,
    CSS_R755_1_ED2011_11,
    CSS_R755_1_ED2014_01,
    CSS_R755_1_ED2014_04,
    CSS_R755_1_ED2017_04,
    CSS_R755_1_ED2018_01,
    CSS_R755_1_ED2018_04,
    CSS_R755_1_ED2020_04,
    CSS_R755_1_ED2022_10)
rule CfDomEnfantAncien(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, naissance: Date, mois: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "enfant de plus de trois ans, strict: compte pour l'âge DOM (R. 755-1)";
    label en unofficial "child strictly over three: counts for the DOM age (R. 755-1)";
    when fr.pf.core::parent_charge(p, e) and fr.pf.core::enfant_ouvre_droit(e)
        and date_naissance(e, naissance) and mois_droit(mois)
        and mois > add_calendar_period(naissance, 3 calendar_year);
    then cf_dom_enfant_ancien(e);
}

@source(
    CSS_R755_1,
    CSS_R755_1_ED2000_01,
    CSS_R755_1_ED2003_12,
    CSS_R755_1_ED2011_11,
    CSS_R755_1_ED2014_01,
    CSS_R755_1_ED2014_04,
    CSS_R755_1_ED2017_04,
    CSS_R755_1_ED2018_01,
    CSS_R755_1_ED2018_04,
    CSS_R755_1_ED2020_04,
    CSS_R755_1_ED2022_10)
rule CfDomEnfantJeune(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, naissance: Date, mois: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "enfant de plus de trois ans et de moins de cinq ans, strict: le jeune DOM (R. 755-1)";
    label en unofficial "child strictly over three and strictly under five: the young DOM child (R. 755-1)";
    when fr.pf.core::parent_charge(p, e) and fr.pf.core::enfant_ouvre_droit(e)
        and date_naissance(e, naissance) and mois_droit(mois)
        and mois > add_calendar_period(naissance, 3 calendar_year)
        and mois < add_calendar_period(naissance, 5 calendar_year);
    then cf_dom_enfant_jeune(e);
}

@source(
    CSS_R755_2,
