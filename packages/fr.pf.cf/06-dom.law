rule CfDomMontantMajoreGrand(p: fr.pf.core::Personne, r: Money, plafond_majore: Money, bmaf: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "DOM, trois enfants et plus, ressources sous le plafond moitié: montant majoré au taux en vigueur (L. 755-16-1, D. 755-6-1)";
    label en unofficial "DOM, three or more children, resources within the half ceiling: increased amount at the rate in force (L. 755-16-1, D. 755-6-1)";
    when cf_dom_droit_ouvert(p) and ressources_menage(p, r)
        and plafond_majore_applicable(p, plafond_majore) and r <= plafond_majore
        and bmaf_retenu(p, bmaf);
    then cf_dom_majore_du(p, round(TauxCfDomMajore * bmaf, 2, "HALF_UP"));
}

@source(
    CSS_L755_16,
    CSS_L755_16_ED2018_01,
    CSS_L755_16_ED2018_04,
    CSS_L755_16_ED2020_04,
    CSS_L755_16_ED2022_10,
    CSS_R755_3,
    CSS_R755_3_ED2018_01,
    CSS_R755_3_ED2018_04,
    CSS_R755_3_ED2020_04,
    CSS_R755_3_ED2022_10,
    CSS_R522_3,
    CSS_R522_3_ED2014_04,
    CSS_R522_3_ED2017_04,
    CSS_R522_3_ED2018_01,
    CSS_R522_3_ED2018_04,
    CSS_R522_3_ED2020_04,
    CSS_R522_3_ED2022_10,
    CSS_D755_6,
    CSS_D755_6_ED2022_10)
// Standalone track with the R755-1 frame: the overrun household has no open
// base right, so cf_dom_droit_ouvert is not required; the R755-1
// qualification arrives as the DOM frame, territory and young-child
// premises (adopted reading, see the module header). The monthly reference
// is the theoretical DOM base amount (TauxCfDomBase x L755-3 base).
rule CfDomDifferentielPetit(p: fr.pf.core::Personne, r: Money, plafond: Money, base: Money, t: Territoire) strict {
    effective [@2021-01-01, infinity);
    label fr official "DOM département, dépassement inférieur à douze mensualités: différentiel au douzième de l'écart (L. 755-16 al. 4, R. 755-3)";
    label en unofficial "DOM department, overrun under twelve monthly amounts: differential at one twelfth of the gap (L. 755-16 para. 4, R. 755-3)";
    when territoire(p, t) and t != METROPOLE and t != MAYOTTE and t != AUTRE
        and departement_l751_1(t)
        and cadre_cf_dom_remplie(p) and presence_jeune_dom(p)
        and cf_dom_plafond(p, plafond)
        and ressources_menage(p, r) and base_dom_retenue(p, base)
        and r > plafond and r - plafond < 12.0 * (TauxCfDomBase * base);
    then cf_dom_differentiel_du(p, (plafond + 12.0 * (TauxCfDomBase * base) - r) / 12.0);
}

@source(
    CSS_L755_16,
