    CSS_D755_6_1_ED2022_10)
rule CfDomMontantMajorePetit(p: fr.pf.core::Personne, r: Money, plafond_majore: Money, bmaf: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "ressources sous le plafond moitié DOM: montant majoré au taux en vigueur (L. 755-16-1, D. 755-6-1)";
    label en unofficial "resources within the DOM half ceiling: increased amount at the rate in force (L. 755-16-1, D. 755-6-1)";
    when cf_dom_droit_ouvert(p) and ressources_menage(p, r)
        and cf_dom_plafond_majore(p, plafond_majore) and r <= plafond_majore
        and bmaf_retenu(p, bmaf);
    then cf_dom_majore_du(p, round(TauxCfDomMajore * bmaf, 2, "HALF_UP"));
}

