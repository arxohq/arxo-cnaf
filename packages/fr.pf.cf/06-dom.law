    CSS_R755_1_ED2017_04,
    CSS_R755_1_ED2018_01,
    CSS_R755_1_ED2018_04,
    CSS_R755_1_ED2020_04,
    CSS_R755_1_ED2022_10,
    CSS_R755_2,
    CSS_R755_2_ED2018_01,
    CSS_R755_2_ED2018_04,
    CSS_R755_2_ED2020_04,
    CSS_R755_2_ED2022_10)
rule CfDomDroitOuvertPetit(p: fr.pf.core::Personne, r: Money, plafond: Money, t: Territoire) strict {
    effective [@2021-01-01, infinity);
    label fr official "DOM département, un ou deux enfants, ressources sous plafond: droit ouvert (L. 755-16, R. 755-1, R. 755-2)";
    label en unofficial "DOM department, one or two children, resources within the ceiling: right open (L. 755-16, R. 755-1, R. 755-2)";
    when territoire(p, t) and t != METROPOLE and t != MAYOTTE and t != AUTRE
        and departement_l751_1(t)
        and cadre_cf_dom_remplie(p) and presence_jeune_dom(p)
        and ressources_menage(p, r) and cf_dom_plafond(p, plafond) and r <= plafond;
    then cf_dom_droit_ouvert(p);
}

