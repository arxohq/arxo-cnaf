@id("urn:fr:corpus:clir:pf-cf#CSS_D755_6_1")
pub fragment CSS_D755_6_1 in CSS_ED2020_04 {
    kind article;
    locator "article/D755-6-1";
    text fr official """Article D755-6-1
Le taux du complément familial majoré est égal à 62,48 % de la base mensuelle de calcul des allocations familiales fixée en application de l'article L. 551-1.
""";
    content_hash "sha256:4875c357aa708bece45f61c1f4431dc3c5af09b502c331fd578a4935273ae831";
}

@id("urn:fr:corpus:clir:pf-cf#CSS_D755_6_1_ED2022_10")
