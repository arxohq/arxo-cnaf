@id("urn:fr:corpus:clir:pf-cf#CSS_D522_2_PRE2018")
pub fragment CSS_D522_2_PRE2018 in CSS_ED2017_04 {
    kind article;
    locator "article/D522-2";
    text fr official """Article D522-2
Le taux du complément familial majoré est égal à 58,33 % de la base mensuelle de calcul des allocations familiales fixée en application de l'article L. 551-1.
NOTA: Conformément au II de l'article 5 du décret n° 2017-532 du 12 avril 2017, ces dispositions s'appliquent pour les prestations dues au titre de la période allant du 1er avril 2017 au 31 mars 2018.
""";
    content_hash "sha256:5bd56eb58b901af4f0f9676ba72e9bd31828cddfa1d34329d5d51f9bb92824cd";
}

@id("urn:fr:corpus:clir:pf-cf#CSS_D522_2_PRE2018_ED2018_01")
