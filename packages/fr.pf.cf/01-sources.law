@id("urn:fr:corpus:clir:pf-cf#DSS_SD2B_2016_396_RECONDUCTION")
pub fragment DSS_SD2B_2016_396_RECONDUCTION in DSS_SD2B_2016_396_RECONDUCTION_ED {
    kind table;
    locator "instruction/dss-2016-396/lines/81-83";
    text fr official """  Or compte tenu de la stabilité des prix en 2015, les différents plafonds et montants, pour la
période du 1er janvier 2016 au 31 décembre 2016, sont reconduits à l’identique pour la période
du 1er janvier 2017 au 31 décembre 2017.
""";
    content_hash "sha256:08e071af898da91ec490c1f1cdc650a90c44883538d49fbb3185ee74784bb130";
}
