    media_type "text/plain; charset=utf-8";
    uri "https://web.archive.org/web/20240630052908id_/https://sante.gouv.fr/fichiers/bo/2017/17-01/ste_20170001_0000_0088.pdf";
    retrieved_at @2026-10-08T00:00:00Z;
