// DOM increased amount, two children in Guadeloupe: resources 12000 do not
// exceed the half ceiling 15000, so the increased track opens INSTEAD of the
// base track: 62.48 % x BMAF 100 = 62.48. The base amount stays silent.
// D-83: плафоны строятся из опубликованных сумм — база 20000, надбавки 25 % = 5000 и 30 % = 6000; montant majoré: база 10000, 2500 и 3000 (ровно то, что давали проценты). Ожидание не менялось.
language "law.core" version "0.2";
package fr.pf.cf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cf";

test "urn:query:fr-pf-cf-dom-montant-majore" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2023-03-15T12:00:00Z; knowledge_time @2023-03-15T12:00:00Z; legal_time @2023-03-15; timezone "Europe/Paris"; }
        assert "dmm-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:dom-montant-majore"), entity_ref("urn:fr:pf-cf:case:dom-montant-majore-e1")) { origin case_input; }
        assert "dmm-02": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:dom-montant-majore"), entity_ref("urn:fr:pf-cf:case:dom-montant-majore-e2")) { origin case_input; }
        assert "dmm-03": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:dom-montant-majore-e1")) { origin case_input; }
        assert "dmm-04": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:dom-montant-majore-e2")) { origin case_input; }
        assert "dmm-05": date_naissance(entity_ref("urn:fr:pf-cf:case:dom-montant-majore-e1"), @2018-03-15) { origin case_input; }
        assert "dmm-06": date_naissance(entity_ref("urn:fr:pf-cf:case:dom-montant-majore-e2"), @2016-03-15) { origin case_input; }
        assert "dmm-07": mois_droit(@2023-03-01) { origin case_input; }
        assert "dmm-08": nb_enfants_cf(entity_ref("urn:fr:pf-cf:case:dom-montant-majore"), 2) { origin case_input; }
        assert "dmm-09": ressources_menage(entity_ref("urn:fr:pf-cf:case:dom-montant-majore"), 12000 EUR) { origin case_input; }
        assert "dmm-10": plafond_base_cf(entity_ref("urn:fr:pf-cf:case:dom-montant-majore"), 20000 EUR) { origin case_input; }
        assert "dmm-10a": majoration_enfant_cf(entity_ref("urn:fr:pf-cf:case:dom-montant-majore"), 5000 EUR) { origin case_input; }
        assert "dmm-10b": majoration_troisieme_cf(entity_ref("urn:fr:pf-cf:case:dom-montant-majore"), 6000 EUR) { origin case_input; }
        assert "dmm-10c": plafond_base_majore(entity_ref("urn:fr:pf-cf:case:dom-montant-majore"), 10000 EUR) { origin case_input; }
        assert "dmm-10d": majoration_enfant_majore(entity_ref("urn:fr:pf-cf:case:dom-montant-majore"), 2500 EUR) { origin case_input; }
        assert "dmm-10e": majoration_troisieme_majore(entity_ref("urn:fr:pf-cf:case:dom-montant-majore"), 3000 EUR) { origin case_input; }
        assert "dmm-11": foyer_du_cas(entity_ref("urn:fr:pf-cf:case:dom-montant-majore")) { origin case_input; }
        assert "dmm-12": territoire(entity_ref("urn:fr:pf-cf:case:dom-montant-majore"), GUADELOUPE) { origin case_input; }
        assert "dmm-13": cadre_cf_dom_remplie(entity_ref("urn:fr:pf-cf:case:dom-montant-majore")) { origin case_input; }
        assert "dmm-14": presence_jeune_dom(entity_ref("urn:fr:pf-cf:case:dom-montant-majore")) { origin case_input; }
        assert "dmm-15": base_dom_retenue(entity_ref("urn:fr:pf-cf:case:dom-montant-majore"), 400.00 EUR) { origin case_input; }
        assert "dmm-16": bmaf_retenu(entity_ref("urn:fr:pf-cf:case:dom-montant-majore"), 100.00 EUR) { origin case_input; }
        assert "dmm-17": departement_l751_1(GUADELOUPE) { origin case_input; }
    }
    evaluate truth(cf_dom_majore_du(entity_ref("urn:fr:pf-cf:case:dom-montant-majore"), 62.48 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_dom_montant_du(entity_ref("urn:fr:pf-cf:case:dom-montant-majore"), 166.60 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
