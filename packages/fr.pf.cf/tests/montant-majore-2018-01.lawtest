// Majore amount at 2018-01: the 2017-04-15 rate row (0.5833) applies.
// Plain majore household, 15000 <= 18000 derived, BMAF 1200.00 stated:
// 0.5833 x 1200.00 = 699.96.
// D-83: плафоны строятся из опубликованных сумм — база 20000, надбавки 25 % = 5000 и 30 % = 6000; montant majoré: база 10000, 2500 и 3000 (ровно то, что давали проценты). Ожидание не менялось.
language "law.core" version "0.2";
package fr.pf.cf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cf";

test "urn:query:fr-pf-cf-montant-majore-2018-01" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2018-01-15T12:00:00Z; knowledge_time @2018-01-15T12:00:00Z; legal_time @2018-01-15; timezone "Europe/Paris"; }
        assert "mm1-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:montant-majore-2018-01"), entity_ref("urn:fr:pf-cf:case:montant-majore-2018-01-e1")) { origin case_input; }
        assert "mm1-02": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:montant-majore-2018-01"), entity_ref("urn:fr:pf-cf:case:montant-majore-2018-01-e2")) { origin case_input; }
        assert "mm1-03": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:montant-majore-2018-01"), entity_ref("urn:fr:pf-cf:case:montant-majore-2018-01-e3")) { origin case_input; }
        assert "mm1-04": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:montant-majore-2018-01-e1")) { origin case_input; }
        assert "mm1-05": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:montant-majore-2018-01-e2")) { origin case_input; }
        assert "mm1-06": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:montant-majore-2018-01-e3")) { origin case_input; }
        assert "mm1-07": date_naissance(entity_ref("urn:fr:pf-cf:case:montant-majore-2018-01-e1"), @2014-03-15) { origin case_input; }
        assert "mm1-08": date_naissance(entity_ref("urn:fr:pf-cf:case:montant-majore-2018-01-e2"), @2012-03-15) { origin case_input; }
        assert "mm1-09": date_naissance(entity_ref("urn:fr:pf-cf:case:montant-majore-2018-01-e3"), @2010-03-15) { origin case_input; }
        assert "mm1-10": mois_droit(@2018-01-01) { origin case_input; }
        assert "mm1-11": nb_enfants_cf(entity_ref("urn:fr:pf-cf:case:montant-majore-2018-01"), 3) { origin case_input; }
        assert "mm1-12": ressources_menage(entity_ref("urn:fr:pf-cf:case:montant-majore-2018-01"), 15000 EUR) { origin case_input; }
        assert "mm1-13": plafond_base_cf(entity_ref("urn:fr:pf-cf:case:montant-majore-2018-01"), 20000 EUR) { origin case_input; }
        assert "mm1-13a": majoration_enfant_cf(entity_ref("urn:fr:pf-cf:case:montant-majore-2018-01"), 5000 EUR) { origin case_input; }
        assert "mm1-13b": majoration_troisieme_cf(entity_ref("urn:fr:pf-cf:case:montant-majore-2018-01"), 6000 EUR) { origin case_input; }
        assert "mm1-13c": plafond_base_majore(entity_ref("urn:fr:pf-cf:case:montant-majore-2018-01"), 10000 EUR) { origin case_input; }
        assert "mm1-13d": majoration_enfant_majore(entity_ref("urn:fr:pf-cf:case:montant-majore-2018-01"), 2500 EUR) { origin case_input; }
        assert "mm1-13e": majoration_troisieme_majore(entity_ref("urn:fr:pf-cf:case:montant-majore-2018-01"), 3000 EUR) { origin case_input; }
        assert "mm1-14": foyer_du_cas(entity_ref("urn:fr:pf-cf:case:montant-majore-2018-01")) { origin case_input; }
        assert "mm1-15": cadre_cf_remplie(entity_ref("urn:fr:pf-cf:case:montant-majore-2018-01")) { origin case_input; }
        assert "mm1-16": bmaf_retenu(entity_ref("urn:fr:pf-cf:case:montant-majore-2018-01"), 1200.00 EUR) { origin case_input; }
    }
    evaluate truth(cf_majore_du(entity_ref("urn:fr:pf-cf:case:montant-majore-2018-01"), 699.96 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
