// D-83: PASS года отсчёта 2015 из arrêté du 26 novembre 2014 (AFSS1428039A): valeur mensuelle 3 170 € x 12 =
// 38 040 €. Порог 13,6 % x 38 040 = 5 173,44; доход ровно 5 173,44 — условие «au moins égal» выполнено.
language "law.core" version "0.2";
package fr.pf.cf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cf";

test "urn:query:fr-pf-cf-pass-2015-seuil-egal" {
    given {
        context { decision_time @2018-06-15T12:00:00Z; knowledge_time @2018-06-15T12:00:00Z; legal_time @2018-06-15; timezone "Europe/Paris"; }
        assert "p2se-01": revenu_pro_min_couple(entity_ref("urn:fr:pf-cf:case:pass-2015-seuil-egal"), 5173.44 EUR) { origin case_input; }
        assert "p2se-02": annee_reference_ressources(entity_ref("urn:fr:pf-cf:case:pass-2015-seuil-egal"), 2015) { origin case_input; }
    }
    evaluate truth(pass_reference(entity_ref("urn:fr:pf-cf:case:pass-2015-seuil-egal"), 38040 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(couple_biactif(entity_ref("urn:fr:pf-cf:case:pass-2015-seuil-egal")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
