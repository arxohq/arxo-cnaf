// Title V increased amount available in Saint-Martin: the retained Title V
// frame qualifies the household, so 62.48 % x BMAF 100 = 62.48 is available.
// The base available amount (41.65 % x 400 = 166.60) is available at the same
// time: no base/majore exclusivity is asserted on the broad track because the
// half-ceiling test stays department-linked via R. 755-4. The department
// track stays silent (no department fact for Saint-Martin).
// D-83: плафоны строятся из опубликованных сумм — база 20000, надбавки 25 % = 5000 и 30 % = 6000; montant majoré: база 10000, 2500 и 3000 (ровно то, что давали проценты). Ожидание не менялось.
language "law.core" version "0.2";
package fr.pf.cf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cf";

test "urn:query:fr-pf-cf-dom-titre-v-majore-saint-martin" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2023-03-15T12:00:00Z; knowledge_time @2023-03-15T12:00:00Z; legal_time @2023-03-15; timezone "Europe/Paris"; }
        assert "dtj-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:dom-tv-majore-sm"), entity_ref("urn:fr:pf-cf:case:dom-tv-majore-sm-e1")) { origin case_input; }
        assert "dtj-02": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:dom-tv-majore-sm"), entity_ref("urn:fr:pf-cf:case:dom-tv-majore-sm-e2")) { origin case_input; }
        assert "dtj-03": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:dom-tv-majore-sm-e1")) { origin case_input; }
        assert "dtj-04": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:dom-tv-majore-sm-e2")) { origin case_input; }
        assert "dtj-05": date_naissance(entity_ref("urn:fr:pf-cf:case:dom-tv-majore-sm-e1"), @2018-03-15) { origin case_input; }
        assert "dtj-06": date_naissance(entity_ref("urn:fr:pf-cf:case:dom-tv-majore-sm-e2"), @2016-03-15) { origin case_input; }
        assert "dtj-07": mois_droit(@2023-03-01) { origin case_input; }
        assert "dtj-08": nb_enfants_cf(entity_ref("urn:fr:pf-cf:case:dom-tv-majore-sm"), 2) { origin case_input; }
        assert "dtj-09": ressources_menage(entity_ref("urn:fr:pf-cf:case:dom-tv-majore-sm"), 12000 EUR) { origin case_input; }
        assert "dtj-10": plafond_base_cf(entity_ref("urn:fr:pf-cf:case:dom-tv-majore-sm"), 20000 EUR) { origin case_input; }
        assert "dtj-10a": majoration_enfant_cf(entity_ref("urn:fr:pf-cf:case:dom-tv-majore-sm"), 5000 EUR) { origin case_input; }
        assert "dtj-10b": majoration_troisieme_cf(entity_ref("urn:fr:pf-cf:case:dom-tv-majore-sm"), 6000 EUR) { origin case_input; }
        assert "dtj-10c": plafond_base_majore(entity_ref("urn:fr:pf-cf:case:dom-tv-majore-sm"), 10000 EUR) { origin case_input; }
        assert "dtj-10d": majoration_enfant_majore(entity_ref("urn:fr:pf-cf:case:dom-tv-majore-sm"), 2500 EUR) { origin case_input; }
        assert "dtj-10e": majoration_troisieme_majore(entity_ref("urn:fr:pf-cf:case:dom-tv-majore-sm"), 3000 EUR) { origin case_input; }
        assert "dtj-11": foyer_du_cas(entity_ref("urn:fr:pf-cf:case:dom-tv-majore-sm")) { origin case_input; }
        assert "dtj-12": territoire(entity_ref("urn:fr:pf-cf:case:dom-tv-majore-sm"), SAINT_MARTIN) { origin case_input; }
        assert "dtj-13": cadre_cf_dom_remplie(entity_ref("urn:fr:pf-cf:case:dom-tv-majore-sm")) { origin case_input; }
        assert "dtj-14": presence_jeune_dom(entity_ref("urn:fr:pf-cf:case:dom-tv-majore-sm")) { origin case_input; }
        assert "dtj-15": base_dom_retenue(entity_ref("urn:fr:pf-cf:case:dom-tv-majore-sm"), 400.00 EUR) { origin case_input; }
        assert "dtj-16": bmaf_retenu(entity_ref("urn:fr:pf-cf:case:dom-tv-majore-sm"), 100.00 EUR) { origin case_input; }
        assert "dtj-17": cadre_cf_titre_v_remplie(entity_ref("urn:fr:pf-cf:case:dom-tv-majore-sm")) { origin case_input; }
    }
    evaluate truth(cf_titre_v_portee(entity_ref("urn:fr:pf-cf:case:dom-tv-majore-sm")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_titre_v_majore_disponible(entity_ref("urn:fr:pf-cf:case:dom-tv-majore-sm"), 62.48 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_titre_v_montant_disponible(entity_ref("urn:fr:pf-cf:case:dom-tv-majore-sm"), 166.60 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_dom_droit_ouvert(entity_ref("urn:fr:pf-cf:case:dom-tv-majore-sm")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_dom_majore_du(entity_ref("urn:fr:pf-cf:case:dom-tv-majore-sm"), 62.48 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
