// DOM age, strict lower bound (R. 755-1 «tous âgés de plus de trois ans»):
// at mois_droit 2021-05-01 the child born 2018-05-01 is exactly three and
// does NOT count (strict >), while the child born 2018-04-30 does.
language "law.core" version "0.2";
package fr.pf.cf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cf";

test "urn:query:fr-pf-cf-dom-ancien-strict" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2021-05-15T12:00:00Z; knowledge_time @2021-05-15T12:00:00Z; legal_time @2021-05-15; timezone "Europe/Paris"; }
        assert "das-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:dom-ancien-strict"), entity_ref("urn:fr:pf-cf:case:dom-ancien-strict-e1")) { origin case_input; }
        assert "das-02": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:dom-ancien-strict"), entity_ref("urn:fr:pf-cf:case:dom-ancien-strict-e2")) { origin case_input; }
        assert "das-03": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:dom-ancien-strict-e1")) { origin case_input; }
        assert "das-04": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:dom-ancien-strict-e2")) { origin case_input; }
        assert "das-05": date_naissance(entity_ref("urn:fr:pf-cf:case:dom-ancien-strict-e1"), @2018-05-01) { origin case_input; }
        assert "das-06": date_naissance(entity_ref("urn:fr:pf-cf:case:dom-ancien-strict-e2"), @2018-04-30) { origin case_input; }
        assert "das-07": mois_droit(@2021-05-01) { origin case_input; }
    }
    evaluate truth(cf_dom_enfant_ancien(entity_ref("urn:fr:pf-cf:case:dom-ancien-strict-e1")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_dom_enfant_ancien(entity_ref("urn:fr:pf-cf:case:dom-ancien-strict-e2")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
