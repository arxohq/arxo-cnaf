// DOM young child, strict upper bound (R. 755-1 «moins de cinq ans»): at
// mois_droit 2021-05-01 the child born 2016-05-01 is exactly five and is NOT
// the young child (strict <), while the child born 2016-05-02 is. The elder
// still counts as over three.
language "law.core" version "0.2";
package fr.pf.cf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cf";

test "urn:query:fr-pf-cf-dom-jeune-cinq-ans" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2021-05-15T12:00:00Z; knowledge_time @2021-05-15T12:00:00Z; legal_time @2021-05-15; timezone "Europe/Paris"; }
        assert "djc-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:dom-jeune-cinq-ans"), entity_ref("urn:fr:pf-cf:case:dom-jeune-cinq-ans-e1")) { origin case_input; }
        assert "djc-02": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:dom-jeune-cinq-ans"), entity_ref("urn:fr:pf-cf:case:dom-jeune-cinq-ans-e2")) { origin case_input; }
        assert "djc-03": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:dom-jeune-cinq-ans-e1")) { origin case_input; }
        assert "djc-04": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:dom-jeune-cinq-ans-e2")) { origin case_input; }
        assert "djc-05": date_naissance(entity_ref("urn:fr:pf-cf:case:dom-jeune-cinq-ans-e1"), @2016-05-01) { origin case_input; }
        assert "djc-06": date_naissance(entity_ref("urn:fr:pf-cf:case:dom-jeune-cinq-ans-e2"), @2016-05-02) { origin case_input; }
        assert "djc-07": mois_droit(@2021-05-01) { origin case_input; }
    }
    evaluate truth(cf_dom_enfant_jeune(entity_ref("urn:fr:pf-cf:case:dom-jeune-cinq-ans-e1")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_dom_enfant_jeune(entity_ref("urn:fr:pf-cf:case:dom-jeune-cinq-ans-e2")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_dom_enfant_ancien(entity_ref("urn:fr:pf-cf:case:dom-jeune-cinq-ans-e1")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
