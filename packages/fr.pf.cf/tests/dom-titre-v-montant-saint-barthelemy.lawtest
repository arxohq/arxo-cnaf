// Title V base amount available in Saint-Barthélemy: the retained Title V
// frame qualifies the household, so 41.65 % x L755-3 base 400 = 166.60 is
// available. The department track stays silent: resources 30000 equal the
// two-child ceiling 30000 and all R. 755-1 premises hold, but no department
// fact exists for Saint-Barthélemy, so neither the right nor the department
// base amount opens. No R. 755-1 age gate is asserted for the broad amount.
// D-83: плафоны строятся из опубликованных сумм — база 20000, надбавки 25 % = 5000 и 30 % = 6000; montant majoré: база 10000, 2500 и 3000 (ровно то, что давали проценты). Ожидание не менялось.
language "law.core" version "0.2";
package fr.pf.cf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cf";

test "urn:query:fr-pf-cf-dom-titre-v-montant-saint-barthelemy" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2021-06-15T12:00:00Z; knowledge_time @2021-06-15T12:00:00Z; legal_time @2021-06-15; timezone "Europe/Paris"; }
        assert "dtm-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:dom-tv-montant-sb"), entity_ref("urn:fr:pf-cf:case:dom-tv-montant-sb-e1")) { origin case_input; }
        assert "dtm-02": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:dom-tv-montant-sb"), entity_ref("urn:fr:pf-cf:case:dom-tv-montant-sb-e2")) { origin case_input; }
        assert "dtm-03": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:dom-tv-montant-sb-e1")) { origin case_input; }
        assert "dtm-04": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:dom-tv-montant-sb-e2")) { origin case_input; }
        assert "dtm-05": date_naissance(entity_ref("urn:fr:pf-cf:case:dom-tv-montant-sb-e1"), @2017-03-15) { origin case_input; }
        assert "dtm-06": date_naissance(entity_ref("urn:fr:pf-cf:case:dom-tv-montant-sb-e2"), @2015-03-15) { origin case_input; }
        assert "dtm-07": mois_droit(@2021-06-01) { origin case_input; }
        assert "dtm-08": nb_enfants_cf(entity_ref("urn:fr:pf-cf:case:dom-tv-montant-sb"), 2) { origin case_input; }
        assert "dtm-09": ressources_menage(entity_ref("urn:fr:pf-cf:case:dom-tv-montant-sb"), 30000 EUR) { origin case_input; }
        assert "dtm-10": plafond_base_cf(entity_ref("urn:fr:pf-cf:case:dom-tv-montant-sb"), 20000 EUR) { origin case_input; }
        assert "dtm-10a": majoration_enfant_cf(entity_ref("urn:fr:pf-cf:case:dom-tv-montant-sb"), 5000 EUR) { origin case_input; }
        assert "dtm-10b": majoration_troisieme_cf(entity_ref("urn:fr:pf-cf:case:dom-tv-montant-sb"), 6000 EUR) { origin case_input; }
        assert "dtm-10c": plafond_base_majore(entity_ref("urn:fr:pf-cf:case:dom-tv-montant-sb"), 10000 EUR) { origin case_input; }
        assert "dtm-10d": majoration_enfant_majore(entity_ref("urn:fr:pf-cf:case:dom-tv-montant-sb"), 2500 EUR) { origin case_input; }
        assert "dtm-10e": majoration_troisieme_majore(entity_ref("urn:fr:pf-cf:case:dom-tv-montant-sb"), 3000 EUR) { origin case_input; }
        assert "dtm-11": foyer_du_cas(entity_ref("urn:fr:pf-cf:case:dom-tv-montant-sb")) { origin case_input; }
        assert "dtm-12": territoire(entity_ref("urn:fr:pf-cf:case:dom-tv-montant-sb"), SAINT_BARTHELEMY) { origin case_input; }
        assert "dtm-13": cadre_cf_dom_remplie(entity_ref("urn:fr:pf-cf:case:dom-tv-montant-sb")) { origin case_input; }
        assert "dtm-14": presence_jeune_dom(entity_ref("urn:fr:pf-cf:case:dom-tv-montant-sb")) { origin case_input; }
        assert "dtm-15": base_dom_retenue(entity_ref("urn:fr:pf-cf:case:dom-tv-montant-sb"), 400.00 EUR) { origin case_input; }
        assert "dtm-16": cadre_cf_titre_v_remplie(entity_ref("urn:fr:pf-cf:case:dom-tv-montant-sb")) { origin case_input; }
    }
    evaluate truth(cf_titre_v_portee(entity_ref("urn:fr:pf-cf:case:dom-tv-montant-sb")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_titre_v_montant_disponible(entity_ref("urn:fr:pf-cf:case:dom-tv-montant-sb"), 166.60 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_dom_droit_ouvert(entity_ref("urn:fr:pf-cf:case:dom-tv-montant-sb")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_dom_montant_du(entity_ref("urn:fr:pf-cf:case:dom-tv-montant-sb"), 166.60 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
