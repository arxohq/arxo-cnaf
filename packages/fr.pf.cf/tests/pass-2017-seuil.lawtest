// D-85: PASS года отсчёта 2017 строится из закреплённого arrêté du 2016-12-05 (AFSS1628753A; fr.css.pass: sources/pass/arrete-2016-12-05-art1.txt):
// valeur mensuelle 3269 € x 12 = 39228 €. Порог R. 522-2 al. 3: 13,6 % x 39228 = 5335.008.
// Доход 5335.01 достигает порога -> couple_biactif; на сантим меньше (5335.00) — нет (NEITHER). Дата дела — июнь 2019 (ресурсы N-2 по R. 532-1).
// Порождено tools/build_pass_tests.py из закреплённых байтов fr.css.pass — руками не править.
language "law.core" version "0.2";
package fr.pf.cf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cf";

test "urn:query:fr-pf-cf-pass-2017-seuil" {
    given {
        context { decision_time @2019-06-15T12:00:00Z; knowledge_time @2019-06-15T12:00:00Z; legal_time @2019-06-15; timezone "Europe/Paris"; }
        assert "p17a-01": revenu_pro_min_couple(entity_ref("urn:fr:pf-cf:case:pass-2017-seuil"), 5335.01 EUR) { origin case_input; }
        assert "p17a-02": annee_reference_ressources(entity_ref("urn:fr:pf-cf:case:pass-2017-seuil"), 2017) { origin case_input; }
    }
    evaluate truth(pass_reference(entity_ref("urn:fr:pf-cf:case:pass-2017-seuil"), 39228 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(couple_biactif(entity_ref("urn:fr:pf-cf:case:pass-2017-seuil")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "urn:query:fr-pf-cf-pass-2017-sous-seuil" {
    given {
        context { decision_time @2019-06-15T12:00:00Z; knowledge_time @2019-06-15T12:00:00Z; legal_time @2019-06-15; timezone "Europe/Paris"; }
        assert "p17b-01": revenu_pro_min_couple(entity_ref("urn:fr:pf-cf:case:pass-2017-sous-seuil"), 5335.00 EUR) { origin case_input; }
        assert "p17b-02": annee_reference_ressources(entity_ref("urn:fr:pf-cf:case:pass-2017-sous-seuil"), 2017) { origin case_input; }
    }
    evaluate truth(pass_reference(entity_ref("urn:fr:pf-cf:case:pass-2017-sous-seuil"), 39228 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(couple_biactif(entity_ref("urn:fr:pf-cf:case:pass-2017-sous-seuil")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
