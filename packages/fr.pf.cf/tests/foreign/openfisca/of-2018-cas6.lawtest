// OpenFisca cf_2018 Cas 6 (2018-01): 5 children (14, 10, 7, 5, 3),
// N-2 15000 within the 5-child 31500 majore ceiling: MAJORE track,
// 58.33. Their 236.71. Class (b).
// D-83: плафоны строятся из опубликованных сумм — база 20000, надбавки 25 % = 5000 и 30 % = 6000; montant majoré: база 10000, 2500 и 3000 (ровно то, что давали проценты). Ожидание не менялось.
language "law.core" version "0.2";
package fr.pf.cf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cf";

test "urn:query:fr-pf-cf-of-2018-cas6" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2018-01-15T12:00:00Z; knowledge_time @2018-01-15T12:00:00Z; legal_time @2018-01-15; timezone "Europe/Paris"; }
        assert "oc6-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6"), entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6-e1")) { origin case_input; }
        assert "oc6-02": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6"), entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6-e2")) { origin case_input; }
        assert "oc6-03": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6"), entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6-e3")) { origin case_input; }
        assert "oc6-04": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6"), entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6-e4")) { origin case_input; }
        assert "oc6-05": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6"), entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6-e5")) { origin case_input; }
        assert "oc6-06": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6-e1")) { origin case_input; }
        assert "oc6-07": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6-e2")) { origin case_input; }
        assert "oc6-08": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6-e3")) { origin case_input; }
        assert "oc6-09": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6-e4")) { origin case_input; }
        assert "oc6-10": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6-e5")) { origin case_input; }
        assert "oc6-11": date_naissance(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6-e1"), @2003-06-01) { origin case_input; }
        assert "oc6-12": date_naissance(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6-e2"), @2007-06-01) { origin case_input; }
        assert "oc6-13": date_naissance(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6-e3"), @2010-06-01) { origin case_input; }
        assert "oc6-14": date_naissance(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6-e4"), @2012-06-01) { origin case_input; }
        assert "oc6-15": date_naissance(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6-e5"), @2014-06-01) { origin case_input; }
        assert "oc6-16": mois_droit(@2018-01-01) { origin case_input; }
        assert "oc6-17": nb_enfants_cf(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6"), 5) { origin case_input; }
        assert "oc6-18": ressources_menage(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6"), 15000 EUR) { origin case_input; }
        assert "oc6-19": plafond_base_cf(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6"), 20000 EUR) { origin case_input; }
        assert "oc6-19a": majoration_enfant_cf(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6"), 5000 EUR) { origin case_input; }
        assert "oc6-19b": majoration_troisieme_cf(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6"), 6000 EUR) { origin case_input; }
        assert "oc6-19c": plafond_base_majore(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6"), 10000 EUR) { origin case_input; }
        assert "oc6-19d": majoration_enfant_majore(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6"), 2500 EUR) { origin case_input; }
        assert "oc6-19e": majoration_troisieme_majore(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6"), 3000 EUR) { origin case_input; }
        assert "oc6-20": foyer_du_cas(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6")) { origin case_input; }
        assert "oc6-21": cadre_cf_remplie(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6")) { origin case_input; }
        assert "oc6-22": bmaf_retenu(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6"), 100.00 EUR) { origin case_input; }
    }
    evaluate truth(cf_droit_ouvert(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_majore_du(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas6"), 58.33 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
