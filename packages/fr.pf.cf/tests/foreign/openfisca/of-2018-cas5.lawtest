// OpenFisca cf_2018 Cas 5 (2018-01): 4 children, N-2 15000 within the
// 4-child 26000 majore ceiling: MAJORE track, 58.33 on stated BMAF
// 100.00. Their 236.71. Class (b).
// D-83: плафоны строятся из опубликованных сумм — база 20000, надбавки 25 % = 5000 и 30 % = 6000; montant majoré: база 10000, 2500 и 3000 (ровно то, что давали проценты). Ожидание не менялось.
language "law.core" version "0.2";
package fr.pf.cf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cf";

test "urn:query:fr-pf-cf-of-2018-cas5" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2018-01-15T12:00:00Z; knowledge_time @2018-01-15T12:00:00Z; legal_time @2018-01-15; timezone "Europe/Paris"; }
        assert "oc5-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas5"), entity_ref("urn:fr:pf-cf:foreign:of-2018-cas5-e1")) { origin case_input; }
        assert "oc5-02": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas5"), entity_ref("urn:fr:pf-cf:foreign:of-2018-cas5-e2")) { origin case_input; }
        assert "oc5-03": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas5"), entity_ref("urn:fr:pf-cf:foreign:of-2018-cas5-e3")) { origin case_input; }
        assert "oc5-04": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas5"), entity_ref("urn:fr:pf-cf:foreign:of-2018-cas5-e4")) { origin case_input; }
        assert "oc5-05": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas5-e1")) { origin case_input; }
        assert "oc5-06": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas5-e2")) { origin case_input; }
        assert "oc5-07": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas5-e3")) { origin case_input; }
        assert "oc5-08": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas5-e4")) { origin case_input; }
        assert "oc5-09": date_naissance(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas5-e1"), @2005-06-01) { origin case_input; }
        assert "oc5-10": date_naissance(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas5-e2"), @2007-06-01) { origin case_input; }
        assert "oc5-11": date_naissance(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas5-e3"), @2010-06-01) { origin case_input; }
        assert "oc5-12": date_naissance(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas5-e4"), @2012-06-01) { origin case_input; }
        assert "oc5-13": mois_droit(@2018-01-01) { origin case_input; }
        assert "oc5-14": nb_enfants_cf(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas5"), 4) { origin case_input; }
        assert "oc5-15": ressources_menage(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas5"), 15000 EUR) { origin case_input; }
        assert "oc5-16": plafond_base_cf(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas5"), 20000 EUR) { origin case_input; }
        assert "oc5-16a": majoration_enfant_cf(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas5"), 5000 EUR) { origin case_input; }
        assert "oc5-16b": majoration_troisieme_cf(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas5"), 6000 EUR) { origin case_input; }
        assert "oc5-16c": plafond_base_majore(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas5"), 10000 EUR) { origin case_input; }
        assert "oc5-16d": majoration_enfant_majore(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas5"), 2500 EUR) { origin case_input; }
        assert "oc5-16e": majoration_troisieme_majore(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas5"), 3000 EUR) { origin case_input; }
        assert "oc5-17": foyer_du_cas(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas5")) { origin case_input; }
        assert "oc5-18": cadre_cf_remplie(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas5")) { origin case_input; }
        assert "oc5-19": bmaf_retenu(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas5"), 100.00 EUR) { origin case_input; }
    }
    evaluate truth(cf_droit_ouvert(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas5")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_majore_du(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas5"), 58.33 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
