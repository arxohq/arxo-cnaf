// OpenFisca 2018-04 Cas 2: same household as 2018-01 Cas 4 at period
// 2018-04. The 2018-04-01 majore row (0.6248) applies: 0.6248 x
// 100.00 = 62.48 on stated BMAF 100.00. Their 256.09 embeds their
// April BMAF (0.6248 x 409.88). The edition pair (2018-01 vs 2018-04)
// proves the row switch. Class (b).
// D-83: плафоны строятся из опубликованных сумм — база 20000, надбавки 25 % = 5000 и 30 % = 6000; montant majoré: база 10000, 2500 и 3000 (ровно то, что давали проценты). Ожидание не менялось.
language "law.core" version "0.2";
package fr.pf.cf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cf";

test "urn:query:fr-pf-cf-of-2018-04-cas2" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2018-04-15T12:00:00Z; knowledge_time @2018-04-15T12:00:00Z; legal_time @2018-04-15; timezone "Europe/Paris"; }
        assert "o42-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas2"), entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas2-e1")) { origin case_input; }
        assert "o42-02": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas2"), entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas2-e2")) { origin case_input; }
        assert "o42-03": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas2"), entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas2-e3")) { origin case_input; }
        assert "o42-04": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas2-e1")) { origin case_input; }
        assert "o42-05": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas2-e2")) { origin case_input; }
        assert "o42-06": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas2-e3")) { origin case_input; }
        assert "o42-07": date_naissance(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas2-e1"), @2005-09-01) { origin case_input; }
        assert "o42-08": date_naissance(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas2-e2"), @2007-09-01) { origin case_input; }
        assert "o42-09": date_naissance(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas2-e3"), @2010-09-01) { origin case_input; }
        assert "o42-10": mois_droit(@2018-04-01) { origin case_input; }
        assert "o42-11": nb_enfants_cf(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas2"), 3) { origin case_input; }
        assert "o42-12": ressources_menage(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas2"), 15000 EUR) { origin case_input; }
        assert "o42-13": plafond_base_cf(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas2"), 20000 EUR) { origin case_input; }
        assert "o42-13a": majoration_enfant_cf(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas2"), 5000 EUR) { origin case_input; }
        assert "o42-13b": majoration_troisieme_cf(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas2"), 6000 EUR) { origin case_input; }
        assert "o42-13c": plafond_base_majore(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas2"), 10000 EUR) { origin case_input; }
        assert "o42-13d": majoration_enfant_majore(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas2"), 2500 EUR) { origin case_input; }
        assert "o42-13e": majoration_troisieme_majore(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas2"), 3000 EUR) { origin case_input; }
        assert "o42-14": foyer_du_cas(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas2")) { origin case_input; }
        assert "o42-15": cadre_cf_remplie(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas2")) { origin case_input; }
        assert "o42-16": bmaf_retenu(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas2"), 100.00 EUR) { origin case_input; }
    }
    evaluate truth(cf_droit_ouvert(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas2")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_majore_du(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas2"), 62.48 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
