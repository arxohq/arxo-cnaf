// OpenFisca 2018-04 Cas 1: same household as 2018-01 Cas 1 at period
// 2018-04. Base rate unchanged (0.4165): our brut 133.28 on stated
// BMAF 320.00. Their 170.71 embeds their April 2018 BMAF. Class (b).
// D-83: плафоны строятся из опубликованных сумм — база 20000, надбавки 25 % = 5000 и 30 % = 6000; montant majoré: база 10000, 2500 и 3000 (ровно то, что давали проценты). Ожидание не менялось.
language "law.core" version "0.2";
package fr.pf.cf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cf";

test "urn:query:fr-pf-cf-of-2018-04-cas1" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2018-04-15T12:00:00Z; knowledge_time @2018-04-15T12:00:00Z; legal_time @2018-04-15; timezone "Europe/Paris"; }
        assert "o41-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas1"), entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas1-e1")) { origin case_input; }
        assert "o41-02": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas1"), entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas1-e2")) { origin case_input; }
        assert "o41-03": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas1"), entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas1-e3")) { origin case_input; }
        assert "o41-04": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas1-e1")) { origin case_input; }
        assert "o41-05": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas1-e2")) { origin case_input; }
        assert "o41-06": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas1-e3")) { origin case_input; }
        assert "o41-07": date_naissance(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas1-e1"), @2005-09-01) { origin case_input; }
        assert "o41-08": date_naissance(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas1-e2"), @2007-09-01) { origin case_input; }
        assert "o41-09": date_naissance(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas1-e3"), @2010-09-01) { origin case_input; }
        assert "o41-10": mois_droit(@2018-04-01) { origin case_input; }
        assert "o41-11": nb_enfants_cf(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas1"), 3) { origin case_input; }
        assert "o41-12": ressources_menage(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas1"), 35000 EUR) { origin case_input; }
        assert "o41-13": plafond_base_cf(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas1"), 20000 EUR) { origin case_input; }
        assert "o41-13a": majoration_enfant_cf(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas1"), 5000 EUR) { origin case_input; }
        assert "o41-13b": majoration_troisieme_cf(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas1"), 6000 EUR) { origin case_input; }
        assert "o41-13c": plafond_base_majore(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas1"), 10000 EUR) { origin case_input; }
        assert "o41-13d": majoration_enfant_majore(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas1"), 2500 EUR) { origin case_input; }
        assert "o41-13e": majoration_troisieme_majore(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas1"), 3000 EUR) { origin case_input; }
        assert "o41-14": foyer_du_cas(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas1")) { origin case_input; }
        assert "o41-15": cadre_cf_remplie(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas1")) { origin case_input; }
        assert "o41-16": bmaf_retenu(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas1"), 320.00 EUR) { origin case_input; }
    }
    evaluate truth(cf_droit_ouvert(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas1")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_montant_du(entity_ref("urn:fr:pf-cf:foreign:of-2018-04-cas1"), 133.28 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
