// OpenFisca Non Passant 8 (2018-01): youngest is 1 (born 2016-06-01),
// below the 3-year floor, so the fund count holds at two. Their cf =
// 0; ours: no conclusion. Class (c).
language "law.core" version "0.2";
package fr.pf.cf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cf";

test "urn:query:fr-pf-cf-of-2018-np8" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2018-01-15T12:00:00Z; knowledge_time @2018-01-15T12:00:00Z; legal_time @2018-01-15; timezone "Europe/Paris"; }
        assert "on8-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:foreign:of-2018-np8"), entity_ref("urn:fr:pf-cf:foreign:of-2018-np8-e1")) { origin case_input; }
        assert "on8-02": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:foreign:of-2018-np8"), entity_ref("urn:fr:pf-cf:foreign:of-2018-np8-e2")) { origin case_input; }
        assert "on8-03": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:foreign:of-2018-np8"), entity_ref("urn:fr:pf-cf:foreign:of-2018-np8-e3")) { origin case_input; }
        assert "on8-04": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:foreign:of-2018-np8-e1")) { origin case_input; }
        assert "on8-05": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:foreign:of-2018-np8-e2")) { origin case_input; }
        assert "on8-06": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:foreign:of-2018-np8-e3")) { origin case_input; }
        assert "on8-07": date_naissance(entity_ref("urn:fr:pf-cf:foreign:of-2018-np8-e1"), @2005-06-01) { origin case_input; }
        assert "on8-08": date_naissance(entity_ref("urn:fr:pf-cf:foreign:of-2018-np8-e2"), @2007-06-01) { origin case_input; }
        assert "on8-09": date_naissance(entity_ref("urn:fr:pf-cf:foreign:of-2018-np8-e3"), @2016-06-01) { origin case_input; }
        assert "on8-10": mois_droit(@2018-01-01) { origin case_input; }
        assert "on8-11": nb_enfants_cf(entity_ref("urn:fr:pf-cf:foreign:of-2018-np8"), 2) { origin case_input; }
        assert "on8-12": ressources_menage(entity_ref("urn:fr:pf-cf:foreign:of-2018-np8"), 35000 EUR) { origin case_input; }
        assert "on8-13": cadre_cf_remplie(entity_ref("urn:fr:pf-cf:foreign:of-2018-np8")) { origin case_input; }
    }
    evaluate truth(cf_enfant_qualifie(entity_ref("urn:fr:pf-cf:foreign:of-2018-np8-e3")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_droit_ouvert(entity_ref("urn:fr:pf-cf:foreign:of-2018-np8")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
