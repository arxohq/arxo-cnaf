// OpenFisca cf_2018 Cas 1 (2018-01): 3 children (12, 10, 7), N-2
// salaries 20000 + 15000 = 35000 fund-stated. Base track (35000 above
// the 18000 majore ceiling, within the 36000 ceiling). Our brut on
// stated BMAF 320.00: 0.4165 x 320.00 = 133.28. Their 169.03 embeds
// their 2018 BMAF and ceiling tables (unpinned) plus CRDS handling
// outside our brut scope. Class (b). See tests/foreign/REPORT.md.
// D-83: плафоны строятся из опубликованных сумм — база 20000, надбавки 25 % = 5000 и 30 % = 6000; montant majoré: база 10000, 2500 и 3000 (ровно то, что давали проценты). Ожидание не менялось.
language "law.core" version "0.2";
package fr.pf.cf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cf";

test "urn:query:fr-pf-cf-of-2018-cas1" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2018-01-15T12:00:00Z; knowledge_time @2018-01-15T12:00:00Z; legal_time @2018-01-15; timezone "Europe/Paris"; }
        assert "oc1-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas1"), entity_ref("urn:fr:pf-cf:foreign:of-2018-cas1-e1")) { origin case_input; }
        assert "oc1-02": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas1"), entity_ref("urn:fr:pf-cf:foreign:of-2018-cas1-e2")) { origin case_input; }
        assert "oc1-03": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas1"), entity_ref("urn:fr:pf-cf:foreign:of-2018-cas1-e3")) { origin case_input; }
        assert "oc1-04": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas1-e1")) { origin case_input; }
        assert "oc1-05": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas1-e2")) { origin case_input; }
        assert "oc1-06": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas1-e3")) { origin case_input; }
        assert "oc1-07": date_naissance(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas1-e1"), @2005-06-01) { origin case_input; }
        assert "oc1-08": date_naissance(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas1-e2"), @2007-06-01) { origin case_input; }
        assert "oc1-09": date_naissance(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas1-e3"), @2010-06-01) { origin case_input; }
        assert "oc1-10": mois_droit(@2018-01-01) { origin case_input; }
        assert "oc1-11": nb_enfants_cf(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas1"), 3) { origin case_input; }
        assert "oc1-12": ressources_menage(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas1"), 35000 EUR) { origin case_input; }
        assert "oc1-13": plafond_base_cf(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas1"), 20000 EUR) { origin case_input; }
        assert "oc1-13a": majoration_enfant_cf(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas1"), 5000 EUR) { origin case_input; }
        assert "oc1-13b": majoration_troisieme_cf(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas1"), 6000 EUR) { origin case_input; }
        assert "oc1-13c": plafond_base_majore(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas1"), 10000 EUR) { origin case_input; }
        assert "oc1-13d": majoration_enfant_majore(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas1"), 2500 EUR) { origin case_input; }
        assert "oc1-13e": majoration_troisieme_majore(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas1"), 3000 EUR) { origin case_input; }
        assert "oc1-14": foyer_du_cas(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas1")) { origin case_input; }
        assert "oc1-15": cadre_cf_remplie(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas1")) { origin case_input; }
        assert "oc1-16": bmaf_retenu(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas1"), 320.00 EUR) { origin case_input; }
    }
    evaluate truth(cf_droit_ouvert(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas1")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_montant_du(entity_ref("urn:fr:pf-cf:foreign:of-2018-cas1"), 133.28 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
