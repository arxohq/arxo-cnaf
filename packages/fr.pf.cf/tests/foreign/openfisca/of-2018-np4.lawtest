// OpenFisca Non Passant 4 (2018-01): two children (12, 10), N-2
// 10000 + 55000 = 65000. Their cf = 0; ours: count below three (the
// ceiling is never even reached), no conclusion. Class (c).
language "law.core" version "0.2";
package fr.pf.cf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cf";

test "urn:query:fr-pf-cf-of-2018-np4" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2018-01-15T12:00:00Z; knowledge_time @2018-01-15T12:00:00Z; legal_time @2018-01-15; timezone "Europe/Paris"; }
        assert "on4-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:foreign:of-2018-np4"), entity_ref("urn:fr:pf-cf:foreign:of-2018-np4-e1")) { origin case_input; }
        assert "on4-02": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:foreign:of-2018-np4"), entity_ref("urn:fr:pf-cf:foreign:of-2018-np4-e2")) { origin case_input; }
        assert "on4-03": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:foreign:of-2018-np4-e1")) { origin case_input; }
        assert "on4-04": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:foreign:of-2018-np4-e2")) { origin case_input; }
        assert "on4-05": date_naissance(entity_ref("urn:fr:pf-cf:foreign:of-2018-np4-e1"), @2005-06-01) { origin case_input; }
        assert "on4-06": date_naissance(entity_ref("urn:fr:pf-cf:foreign:of-2018-np4-e2"), @2007-06-01) { origin case_input; }
        assert "on4-07": mois_droit(@2018-01-01) { origin case_input; }
        assert "on4-08": nb_enfants_cf(entity_ref("urn:fr:pf-cf:foreign:of-2018-np4"), 2) { origin case_input; }
        assert "on4-09": ressources_menage(entity_ref("urn:fr:pf-cf:foreign:of-2018-np4"), 65000 EUR) { origin case_input; }
        assert "on4-10": cadre_cf_remplie(entity_ref("urn:fr:pf-cf:foreign:of-2018-np4")) { origin case_input; }
    }
    evaluate truth(cf_droit_ouvert(entity_ref("urn:fr:pf-cf:foreign:of-2018-np4")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_montant_du(entity_ref("urn:fr:pf-cf:foreign:of-2018-np4"), 0 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
