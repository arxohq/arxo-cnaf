// OpenFisca Non Passant 9 (2018-01): same 1-year-old household at
// N-2 15000. Their cf = 0; ours: no conclusion. Class (c).
language "law.core" version "0.2";
package fr.pf.cf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cf";

test "urn:query:fr-pf-cf-of-2018-np9" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2018-01-15T12:00:00Z; knowledge_time @2018-01-15T12:00:00Z; legal_time @2018-01-15; timezone "Europe/Paris"; }
        assert "on9-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:foreign:of-2018-np9"), entity_ref("urn:fr:pf-cf:foreign:of-2018-np9-e1")) { origin case_input; }
        assert "on9-02": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:foreign:of-2018-np9"), entity_ref("urn:fr:pf-cf:foreign:of-2018-np9-e2")) { origin case_input; }
        assert "on9-03": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:foreign:of-2018-np9"), entity_ref("urn:fr:pf-cf:foreign:of-2018-np9-e3")) { origin case_input; }
        assert "on9-04": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:foreign:of-2018-np9-e1")) { origin case_input; }
        assert "on9-05": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:foreign:of-2018-np9-e2")) { origin case_input; }
        assert "on9-06": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:foreign:of-2018-np9-e3")) { origin case_input; }
        assert "on9-07": date_naissance(entity_ref("urn:fr:pf-cf:foreign:of-2018-np9-e1"), @2005-06-01) { origin case_input; }
        assert "on9-08": date_naissance(entity_ref("urn:fr:pf-cf:foreign:of-2018-np9-e2"), @2007-06-01) { origin case_input; }
        assert "on9-09": date_naissance(entity_ref("urn:fr:pf-cf:foreign:of-2018-np9-e3"), @2016-06-01) { origin case_input; }
        assert "on9-10": mois_droit(@2018-01-01) { origin case_input; }
        assert "on9-11": nb_enfants_cf(entity_ref("urn:fr:pf-cf:foreign:of-2018-np9"), 2) { origin case_input; }
        assert "on9-12": ressources_menage(entity_ref("urn:fr:pf-cf:foreign:of-2018-np9"), 15000 EUR) { origin case_input; }
        assert "on9-13": cadre_cf_remplie(entity_ref("urn:fr:pf-cf:foreign:of-2018-np9")) { origin case_input; }
    }
    evaluate truth(cf_enfant_qualifie(entity_ref("urn:fr:pf-cf:foreign:of-2018-np9-e3")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_droit_ouvert(entity_ref("urn:fr:pf-cf:foreign:of-2018-np9")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
