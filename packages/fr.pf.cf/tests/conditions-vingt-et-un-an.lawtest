// Eldest turns exactly 20 on the first of the month: the [20,21)
// band applies, pay within the ceiling is fund-established, so the
// child counts until 21 and the right opens.
language "law.core" version "0.2";
package fr.pf.cf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cf";

test "urn:query:fr-pf-cf-conditions-vingt-et-un-an" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2021-06-15T12:00:00Z; knowledge_time @2021-06-15T12:00:00Z; legal_time @2021-06-15; timezone "Europe/Paris"; }
        assert "c21-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:cond-vingt-et-un-an"), entity_ref("urn:fr:pf-cf:case:cond-vingt-et-un-an-e1")) { origin case_input; }
        assert "c21-02": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:cond-vingt-et-un-an"), entity_ref("urn:fr:pf-cf:case:cond-vingt-et-un-an-e2")) { origin case_input; }
        assert "c21-03": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:cond-vingt-et-un-an"), entity_ref("urn:fr:pf-cf:case:cond-vingt-et-un-an-e3")) { origin case_input; }
        assert "c21-04": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:cond-vingt-et-un-an-e1")) { origin case_input; }
        assert "c21-05": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:cond-vingt-et-un-an-e2")) { origin case_input; }
        assert "c21-06": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:cond-vingt-et-un-an-e3")) { origin case_input; }
        assert "c21-07": date_naissance(entity_ref("urn:fr:pf-cf:case:cond-vingt-et-un-an-e1"), @2016-03-15) { origin case_input; }
        assert "c21-08": date_naissance(entity_ref("urn:fr:pf-cf:case:cond-vingt-et-un-an-e2"), @2014-03-15) { origin case_input; }
        assert "c21-09": date_naissance(entity_ref("urn:fr:pf-cf:case:cond-vingt-et-un-an-e3"), @2001-06-01) { origin case_input; }
        assert "c21-10": mois_droit(@2021-06-01) { origin case_input; }
        assert "c21-11": remuneration_sous_plafond(entity_ref("urn:fr:pf-cf:case:cond-vingt-et-un-an-e3")) { origin case_input; }
        assert "c21-12": nb_enfants_cf(entity_ref("urn:fr:pf-cf:case:cond-vingt-et-un-an"), 3) { origin case_input; }
        assert "c21-13": ressources_menage(entity_ref("urn:fr:pf-cf:case:cond-vingt-et-un-an"), 30000 EUR) { origin case_input; }
        assert "c21-14": plafond_cf_applicable(entity_ref("urn:fr:pf-cf:case:cond-vingt-et-un-an"), 41000 EUR) { origin case_input; }
        assert "c21-15": cadre_cf_remplie(entity_ref("urn:fr:pf-cf:case:cond-vingt-et-un-an")) { origin case_input; }
    }
    evaluate truth(cf_enfant_qualifie(entity_ref("urn:fr:pf-cf:case:cond-vingt-et-un-an-e3")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_droit_ouvert(entity_ref("urn:fr:pf-cf:case:cond-vingt-et-un-an")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
