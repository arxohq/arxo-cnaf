// Input contract, resources absent (pfcf-blind-13 situation, D-39(a),
// L. 522-3): three qualifying children, stated nominal 20000 and BMAF
// 40.00, but NO ressources_menage fact. The ceilings still build from
// the stated nominal (36000 / 18000, tiered D-36); the right and both
// amount tracks stay silent. The base amount must never be inferred by
// default: 16.66 is exactly the blind reader's base-track arithmetic
// (40.00 x 41.65 %), and the model must NOT conclude it while the
// resources premise needed to exclude the majore zone is missing.
// D-83: плафоны строятся из опубликованных сумм — база 20000, надбавки 25 % = 5000 и 30 % = 6000; montant majoré: база 10000, 2500 и 3000 (ровно то, что давали проценты). Ожидание не менялось.
language "law.core" version "0.2";
package fr.pf.cf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cf";

test "urn:query:fr-pf-cf-montant-ressources-absentes" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2021-06-15T12:00:00Z; knowledge_time @2021-06-15T12:00:00Z; legal_time @2021-06-15; timezone "Europe/Paris"; }
        assert "mra-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:montant-ressources-absentes"), entity_ref("urn:fr:pf-cf:case:montant-ressources-absentes-e1")) { origin case_input; }
        assert "mra-02": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:montant-ressources-absentes"), entity_ref("urn:fr:pf-cf:case:montant-ressources-absentes-e2")) { origin case_input; }
        assert "mra-03": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:montant-ressources-absentes"), entity_ref("urn:fr:pf-cf:case:montant-ressources-absentes-e3")) { origin case_input; }
        assert "mra-04": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:montant-ressources-absentes-e1")) { origin case_input; }
        assert "mra-05": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:montant-ressources-absentes-e2")) { origin case_input; }
        assert "mra-06": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:montant-ressources-absentes-e3")) { origin case_input; }
        assert "mra-07": date_naissance(entity_ref("urn:fr:pf-cf:case:montant-ressources-absentes-e1"), @2016-03-15) { origin case_input; }
        assert "mra-08": date_naissance(entity_ref("urn:fr:pf-cf:case:montant-ressources-absentes-e2"), @2014-03-15) { origin case_input; }
        assert "mra-09": date_naissance(entity_ref("urn:fr:pf-cf:case:montant-ressources-absentes-e3"), @2012-03-15) { origin case_input; }
        assert "mra-10": mois_droit(@2021-06-01) { origin case_input; }
        assert "mra-11": nb_enfants_cf(entity_ref("urn:fr:pf-cf:case:montant-ressources-absentes"), 3) { origin case_input; }
        assert "mra-12": plafond_base_cf(entity_ref("urn:fr:pf-cf:case:montant-ressources-absentes"), 20000 EUR) { origin case_input; }
        assert "mra-12a": majoration_enfant_cf(entity_ref("urn:fr:pf-cf:case:montant-ressources-absentes"), 5000 EUR) { origin case_input; }
        assert "mra-12b": majoration_troisieme_cf(entity_ref("urn:fr:pf-cf:case:montant-ressources-absentes"), 6000 EUR) { origin case_input; }
        assert "mra-12c": plafond_base_majore(entity_ref("urn:fr:pf-cf:case:montant-ressources-absentes"), 10000 EUR) { origin case_input; }
        assert "mra-12d": majoration_enfant_majore(entity_ref("urn:fr:pf-cf:case:montant-ressources-absentes"), 2500 EUR) { origin case_input; }
        assert "mra-12e": majoration_troisieme_majore(entity_ref("urn:fr:pf-cf:case:montant-ressources-absentes"), 3000 EUR) { origin case_input; }
        assert "mra-13": foyer_du_cas(entity_ref("urn:fr:pf-cf:case:montant-ressources-absentes")) { origin case_input; }
        assert "mra-14": cadre_cf_remplie(entity_ref("urn:fr:pf-cf:case:montant-ressources-absentes")) { origin case_input; }
        assert "mra-15": bmaf_retenu(entity_ref("urn:fr:pf-cf:case:montant-ressources-absentes"), 40.00 EUR) { origin case_input; }
    }
    evaluate truth(plafond_cf_applicable(entity_ref("urn:fr:pf-cf:case:montant-ressources-absentes"), 36000 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(plafond_majore_applicable(entity_ref("urn:fr:pf-cf:case:montant-ressources-absentes"), 18000 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_droit_ouvert(entity_ref("urn:fr:pf-cf:case:montant-ressources-absentes")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_montant_du(entity_ref("urn:fr:pf-cf:case:montant-ressources-absentes"), 16.66 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_majore_du(entity_ref("urn:fr:pf-cf:case:montant-ressources-absentes"), 24.99 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
