// Resources exactly at the ceiling: the base right opens (36000 <=
// 36000) while the differential needs a strict overrun, so it stays
// absent (NEITHER).
// D-83: плафоны строятся из опубликованных сумм — база 20000, надбавки 25 % = 5000 и 30 % = 6000; montant majoré: база 10000, 2500 и 3000 (ровно то, что давали проценты). Ожидание не менялось.
language "law.core" version "0.2";
package fr.pf.cf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cf";

test "urn:query:fr-pf-cf-differentiel-plafond-egal" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2021-06-15T12:00:00Z; knowledge_time @2021-06-15T12:00:00Z; legal_time @2021-06-15; timezone "Europe/Paris"; }
        assert "dpe-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:differentiel-plafond-egal"), entity_ref("urn:fr:pf-cf:case:differentiel-plafond-egal-e1")) { origin case_input; }
        assert "dpe-02": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:differentiel-plafond-egal"), entity_ref("urn:fr:pf-cf:case:differentiel-plafond-egal-e2")) { origin case_input; }
        assert "dpe-03": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:differentiel-plafond-egal"), entity_ref("urn:fr:pf-cf:case:differentiel-plafond-egal-e3")) { origin case_input; }
        assert "dpe-04": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:differentiel-plafond-egal-e1")) { origin case_input; }
        assert "dpe-05": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:differentiel-plafond-egal-e2")) { origin case_input; }
        assert "dpe-06": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:differentiel-plafond-egal-e3")) { origin case_input; }
        assert "dpe-07": date_naissance(entity_ref("urn:fr:pf-cf:case:differentiel-plafond-egal-e1"), @2016-03-15) { origin case_input; }
        assert "dpe-08": date_naissance(entity_ref("urn:fr:pf-cf:case:differentiel-plafond-egal-e2"), @2014-03-15) { origin case_input; }
        assert "dpe-09": date_naissance(entity_ref("urn:fr:pf-cf:case:differentiel-plafond-egal-e3"), @2012-03-15) { origin case_input; }
        assert "dpe-10": mois_droit(@2021-06-01) { origin case_input; }
        assert "dpe-11": nb_enfants_cf(entity_ref("urn:fr:pf-cf:case:differentiel-plafond-egal"), 3) { origin case_input; }
        assert "dpe-12": ressources_menage(entity_ref("urn:fr:pf-cf:case:differentiel-plafond-egal"), 36000 EUR) { origin case_input; }
        assert "dpe-13": plafond_base_cf(entity_ref("urn:fr:pf-cf:case:differentiel-plafond-egal"), 20000 EUR) { origin case_input; }
        assert "dpe-13a": majoration_enfant_cf(entity_ref("urn:fr:pf-cf:case:differentiel-plafond-egal"), 5000 EUR) { origin case_input; }
        assert "dpe-13b": majoration_troisieme_cf(entity_ref("urn:fr:pf-cf:case:differentiel-plafond-egal"), 6000 EUR) { origin case_input; }
        assert "dpe-13c": plafond_base_majore(entity_ref("urn:fr:pf-cf:case:differentiel-plafond-egal"), 10000 EUR) { origin case_input; }
        assert "dpe-13d": majoration_enfant_majore(entity_ref("urn:fr:pf-cf:case:differentiel-plafond-egal"), 2500 EUR) { origin case_input; }
        assert "dpe-13e": majoration_troisieme_majore(entity_ref("urn:fr:pf-cf:case:differentiel-plafond-egal"), 3000 EUR) { origin case_input; }
        assert "dpe-14": foyer_du_cas(entity_ref("urn:fr:pf-cf:case:differentiel-plafond-egal")) { origin case_input; }
        assert "dpe-15": cadre_cf_remplie(entity_ref("urn:fr:pf-cf:case:differentiel-plafond-egal")) { origin case_input; }
        assert "dpe-16": bmaf_retenu(entity_ref("urn:fr:pf-cf:case:differentiel-plafond-egal"), 240.00 EUR) { origin case_input; }
    }
    evaluate truth(cf_droit_ouvert(entity_ref("urn:fr:pf-cf:case:differentiel-plafond-egal")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_differentiel_du(entity_ref("urn:fr:pf-cf:case:differentiel-plafond-egal"), 0 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
