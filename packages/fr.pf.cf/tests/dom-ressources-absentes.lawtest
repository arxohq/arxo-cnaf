// DOM input contract, resources absent (mirrors montant-ressources-absentes):
// two qualifying DOM children, stated nominal 20000, L755-3 base 400 and
// BMAF 100, but NO ressources_menage fact. The DOM ceilings still build
// from the stated nominal (30000 / 15000); the DOM right and all three DOM
// amount tracks stay silent. Track selection needs the resources premise.
// D-83: плафоны строятся из опубликованных сумм — база 20000, надбавки 25 % = 5000 и 30 % = 6000; montant majoré: база 10000, 2500 и 3000 (ровно то, что давали проценты). Ожидание не менялось.
language "law.core" version "0.2";
package fr.pf.cf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cf";

test "urn:query:fr-pf-cf-dom-ressources-absentes" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2021-06-15T12:00:00Z; knowledge_time @2021-06-15T12:00:00Z; legal_time @2021-06-15; timezone "Europe/Paris"; }
        assert "dra-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:dom-ressources-absentes"), entity_ref("urn:fr:pf-cf:case:dom-ressources-absentes-e1")) { origin case_input; }
        assert "dra-02": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:dom-ressources-absentes"), entity_ref("urn:fr:pf-cf:case:dom-ressources-absentes-e2")) { origin case_input; }
        assert "dra-03": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:dom-ressources-absentes-e1")) { origin case_input; }
        assert "dra-04": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:dom-ressources-absentes-e2")) { origin case_input; }
        assert "dra-05": date_naissance(entity_ref("urn:fr:pf-cf:case:dom-ressources-absentes-e1"), @2017-03-15) { origin case_input; }
        assert "dra-06": date_naissance(entity_ref("urn:fr:pf-cf:case:dom-ressources-absentes-e2"), @2015-03-15) { origin case_input; }
        assert "dra-07": mois_droit(@2021-06-01) { origin case_input; }
        assert "dra-08": nb_enfants_cf(entity_ref("urn:fr:pf-cf:case:dom-ressources-absentes"), 2) { origin case_input; }
        assert "dra-09": plafond_base_cf(entity_ref("urn:fr:pf-cf:case:dom-ressources-absentes"), 20000 EUR) { origin case_input; }
        assert "dra-09a": majoration_enfant_cf(entity_ref("urn:fr:pf-cf:case:dom-ressources-absentes"), 5000 EUR) { origin case_input; }
        assert "dra-09b": majoration_troisieme_cf(entity_ref("urn:fr:pf-cf:case:dom-ressources-absentes"), 6000 EUR) { origin case_input; }
        assert "dra-09c": plafond_base_majore(entity_ref("urn:fr:pf-cf:case:dom-ressources-absentes"), 10000 EUR) { origin case_input; }
        assert "dra-09d": majoration_enfant_majore(entity_ref("urn:fr:pf-cf:case:dom-ressources-absentes"), 2500 EUR) { origin case_input; }
        assert "dra-09e": majoration_troisieme_majore(entity_ref("urn:fr:pf-cf:case:dom-ressources-absentes"), 3000 EUR) { origin case_input; }
        assert "dra-10": foyer_du_cas(entity_ref("urn:fr:pf-cf:case:dom-ressources-absentes")) { origin case_input; }
        assert "dra-11": territoire(entity_ref("urn:fr:pf-cf:case:dom-ressources-absentes"), GUADELOUPE) { origin case_input; }
        assert "dra-12": cadre_cf_dom_remplie(entity_ref("urn:fr:pf-cf:case:dom-ressources-absentes")) { origin case_input; }
        assert "dra-13": presence_jeune_dom(entity_ref("urn:fr:pf-cf:case:dom-ressources-absentes")) { origin case_input; }
        assert "dra-14": base_dom_retenue(entity_ref("urn:fr:pf-cf:case:dom-ressources-absentes"), 400.00 EUR) { origin case_input; }
        assert "dra-15": bmaf_retenu(entity_ref("urn:fr:pf-cf:case:dom-ressources-absentes"), 100.00 EUR) { origin case_input; }
        assert "dra-16": departement_l751_1(GUADELOUPE) { origin case_input; }
    }
    evaluate truth(cf_dom_plafond(entity_ref("urn:fr:pf-cf:case:dom-ressources-absentes"), 30000 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_dom_plafond_majore(entity_ref("urn:fr:pf-cf:case:dom-ressources-absentes"), 15000 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_dom_droit_ouvert(entity_ref("urn:fr:pf-cf:case:dom-ressources-absentes")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_dom_montant_du(entity_ref("urn:fr:pf-cf:case:dom-ressources-absentes"), 166.60 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_dom_majore_du(entity_ref("urn:fr:pf-cf:case:dom-ressources-absentes"), 62.48 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
