// Active fund duty, majore track: 124.96 EUR due (0.6248 x 200.00).
// Position PayerCfMajoreDu is ACTIVE.
// D-83: плафоны строятся из опубликованных сумм — база 20000, надбавки 25 % = 5000 и 30 % = 6000; montant majoré: база 10000, 2500 и 3000 (ровно то, что давали проценты). Ожидание не менялось.
language "law.core" version "0.2";
package fr.pf.cf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cf";

test "urn:query:fr-pf-cf-devoir-versement-majore" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2021-06-15T12:00:00Z; knowledge_time @2021-06-15T12:00:00Z; legal_time @2021-06-15; timezone "Europe/Paris"; }
        assert "dvm-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:devoir-versement-majore"), entity_ref("urn:fr:pf-cf:case:devoir-versement-majore-e1")) { origin case_input; }
        assert "dvm-02": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:devoir-versement-majore"), entity_ref("urn:fr:pf-cf:case:devoir-versement-majore-e2")) { origin case_input; }
        assert "dvm-03": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:devoir-versement-majore"), entity_ref("urn:fr:pf-cf:case:devoir-versement-majore-e3")) { origin case_input; }
        assert "dvm-04": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:devoir-versement-majore-e1")) { origin case_input; }
        assert "dvm-05": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:devoir-versement-majore-e2")) { origin case_input; }
        assert "dvm-06": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:devoir-versement-majore-e3")) { origin case_input; }
        assert "dvm-07": date_naissance(entity_ref("urn:fr:pf-cf:case:devoir-versement-majore-e1"), @2016-03-15) { origin case_input; }
        assert "dvm-08": date_naissance(entity_ref("urn:fr:pf-cf:case:devoir-versement-majore-e2"), @2014-03-15) { origin case_input; }
        assert "dvm-09": date_naissance(entity_ref("urn:fr:pf-cf:case:devoir-versement-majore-e3"), @2012-03-15) { origin case_input; }
        assert "dvm-10": mois_droit(@2021-06-01) { origin case_input; }
        assert "dvm-11": nb_enfants_cf(entity_ref("urn:fr:pf-cf:case:devoir-versement-majore"), 3) { origin case_input; }
        assert "dvm-12": ressources_menage(entity_ref("urn:fr:pf-cf:case:devoir-versement-majore"), 15000 EUR) { origin case_input; }
        assert "dvm-13": plafond_base_cf(entity_ref("urn:fr:pf-cf:case:devoir-versement-majore"), 20000 EUR) { origin case_input; }
        assert "dvm-13a": majoration_enfant_cf(entity_ref("urn:fr:pf-cf:case:devoir-versement-majore"), 5000 EUR) { origin case_input; }
        assert "dvm-13b": majoration_troisieme_cf(entity_ref("urn:fr:pf-cf:case:devoir-versement-majore"), 6000 EUR) { origin case_input; }
        assert "dvm-13c": plafond_base_majore(entity_ref("urn:fr:pf-cf:case:devoir-versement-majore"), 10000 EUR) { origin case_input; }
        assert "dvm-13d": majoration_enfant_majore(entity_ref("urn:fr:pf-cf:case:devoir-versement-majore"), 2500 EUR) { origin case_input; }
        assert "dvm-13e": majoration_troisieme_majore(entity_ref("urn:fr:pf-cf:case:devoir-versement-majore"), 3000 EUR) { origin case_input; }
        assert "dvm-14": foyer_du_cas(entity_ref("urn:fr:pf-cf:case:devoir-versement-majore")) { origin case_input; }
        assert "dvm-15": cadre_cf_remplie(entity_ref("urn:fr:pf-cf:case:devoir-versement-majore")) { origin case_input; }
        assert "dvm-16": bmaf_retenu(entity_ref("urn:fr:pf-cf:case:devoir-versement-majore"), 200.00 EUR) { origin case_input; }
        assert "dvm-17": fr.pf.core::organisme_debiteur_pf(entity_ref("urn:fr:pf-cf:org:caisse"), entity_ref("urn:fr:pf-cf:case:devoir-versement-majore")) { origin case_input; }
    }
    evaluate positions();
    expect position(PayerCfMajoreDu, ACTIVE);
