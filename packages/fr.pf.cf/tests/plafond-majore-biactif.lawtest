// Majore ceiling, two-earner couple: 18000 plus the 1000 EUR two-earner
// increment of the increased amount = 19000.
// D-83 (Q-PFCF-1 закрыт): надбавка montant majoré за двойную активность — опубликованная
// отдельно (majoration_biactivite_majore; в 2018 году DSS печатает 4 218 при 8 437 у плафона CF),
// а не полная надбавка плафона CF. Число 1000 то же, что было входом majoration_biactivite;
// ожидание 19000 не менялось.
// D-83: плафоны строятся из опубликованных сумм — база 20000, надбавки 25 % = 5000 и 30 % = 6000; montant majoré: база 10000, 2500 и 3000 (ровно то, что давали проценты). Ожидание не менялось.
language "law.core" version "0.2";
package fr.pf.cf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cf";

test "urn:query:fr-pf-cf-plafond-majore-biactif" {
    given {
        context { decision_time @2021-06-15T12:00:00Z; knowledge_time @2021-06-15T12:00:00Z; legal_time @2021-06-15; timezone "Europe/Paris"; }
        assert "pmb-01": plafond_base_cf(entity_ref("urn:fr:pf-cf:case:plafond-majore-biactif"), 20000 EUR) { origin case_input; }
        assert "pmb-01a": majoration_enfant_cf(entity_ref("urn:fr:pf-cf:case:plafond-majore-biactif"), 5000 EUR) { origin case_input; }
        assert "pmb-01b": majoration_troisieme_cf(entity_ref("urn:fr:pf-cf:case:plafond-majore-biactif"), 6000 EUR) { origin case_input; }
        assert "pmb-01c": plafond_base_majore(entity_ref("urn:fr:pf-cf:case:plafond-majore-biactif"), 10000 EUR) { origin case_input; }
        assert "pmb-01d": majoration_enfant_majore(entity_ref("urn:fr:pf-cf:case:plafond-majore-biactif"), 2500 EUR) { origin case_input; }
        assert "pmb-01e": majoration_troisieme_majore(entity_ref("urn:fr:pf-cf:case:plafond-majore-biactif"), 3000 EUR) { origin case_input; }
        assert "pmb-02": nb_enfants_cf(entity_ref("urn:fr:pf-cf:case:plafond-majore-biactif"), 3) { origin case_input; }
        assert "pmb-03": revenu_pro_min_couple(entity_ref("urn:fr:pf-cf:case:plafond-majore-biactif"), 6000 EUR) { origin case_input; }
        assert "pmb-04": pass_annuel(40000 EUR) { origin case_input; }
        assert "pmb-05": majoration_biactivite_majore(entity_ref("urn:fr:pf-cf:case:plafond-majore-biactif"), 1000 EUR) { origin case_input; }
    }
    evaluate truth(plafond_majore_applicable(entity_ref("urn:fr:pf-cf:case:plafond-majore-biactif"), 19000 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
