// Majore amount in 2021: the 0.6248 row still applies (no later row).
// BMAF 200.00 stated: 0.6248 x 200.00 = 124.96.
// D-83: плафоны строятся из опубликованных сумм — база 20000, надбавки 25 % = 5000 и 30 % = 6000; montant majoré: база 10000, 2500 и 3000 (ровно то, что давали проценты). Ожидание не менялось.
language "law.core" version "0.2";
package fr.pf.cf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cf";

test "urn:query:fr-pf-cf-montant-majore-2021" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2021-06-15T12:00:00Z; knowledge_time @2021-06-15T12:00:00Z; legal_time @2021-06-15; timezone "Europe/Paris"; }
        assert "mm2-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:montant-majore-2021"), entity_ref("urn:fr:pf-cf:case:montant-majore-2021-e1")) { origin case_input; }
        assert "mm2-02": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:montant-majore-2021"), entity_ref("urn:fr:pf-cf:case:montant-majore-2021-e2")) { origin case_input; }
        assert "mm2-03": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:montant-majore-2021"), entity_ref("urn:fr:pf-cf:case:montant-majore-2021-e3")) { origin case_input; }
        assert "mm2-04": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:montant-majore-2021-e1")) { origin case_input; }
        assert "mm2-05": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:montant-majore-2021-e2")) { origin case_input; }
        assert "mm2-06": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:montant-majore-2021-e3")) { origin case_input; }
        assert "mm2-07": date_naissance(entity_ref("urn:fr:pf-cf:case:montant-majore-2021-e1"), @2016-03-15) { origin case_input; }
        assert "mm2-08": date_naissance(entity_ref("urn:fr:pf-cf:case:montant-majore-2021-e2"), @2014-03-15) { origin case_input; }
        assert "mm2-09": date_naissance(entity_ref("urn:fr:pf-cf:case:montant-majore-2021-e3"), @2012-03-15) { origin case_input; }
        assert "mm2-10": mois_droit(@2021-06-01) { origin case_input; }
        assert "mm2-11": nb_enfants_cf(entity_ref("urn:fr:pf-cf:case:montant-majore-2021"), 3) { origin case_input; }
        assert "mm2-12": ressources_menage(entity_ref("urn:fr:pf-cf:case:montant-majore-2021"), 15000 EUR) { origin case_input; }
        assert "mm2-13": plafond_base_cf(entity_ref("urn:fr:pf-cf:case:montant-majore-2021"), 20000 EUR) { origin case_input; }
        assert "mm2-13a": majoration_enfant_cf(entity_ref("urn:fr:pf-cf:case:montant-majore-2021"), 5000 EUR) { origin case_input; }
        assert "mm2-13b": majoration_troisieme_cf(entity_ref("urn:fr:pf-cf:case:montant-majore-2021"), 6000 EUR) { origin case_input; }
        assert "mm2-13c": plafond_base_majore(entity_ref("urn:fr:pf-cf:case:montant-majore-2021"), 10000 EUR) { origin case_input; }
        assert "mm2-13d": majoration_enfant_majore(entity_ref("urn:fr:pf-cf:case:montant-majore-2021"), 2500 EUR) { origin case_input; }
        assert "mm2-13e": majoration_troisieme_majore(entity_ref("urn:fr:pf-cf:case:montant-majore-2021"), 3000 EUR) { origin case_input; }
        assert "mm2-14": foyer_du_cas(entity_ref("urn:fr:pf-cf:case:montant-majore-2021")) { origin case_input; }
        assert "mm2-15": cadre_cf_remplie(entity_ref("urn:fr:pf-cf:case:montant-majore-2021")) { origin case_input; }
        assert "mm2-16": bmaf_retenu(entity_ref("urn:fr:pf-cf:case:montant-majore-2021"), 200.00 EUR) { origin case_input; }
    }
    evaluate truth(cf_majore_du(entity_ref("urn:fr:pf-cf:case:montant-majore-2021"), 124.96 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
