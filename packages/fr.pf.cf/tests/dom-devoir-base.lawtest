// Active DOM fund duty, base track: 166.60 EUR due in Réunion, debtor fund
// recorded. Position PayerCfDomDu is ACTIVE.
// D-83: плафоны строятся из опубликованных сумм — база 20000, надбавки 25 % = 5000 и 30 % = 6000; montant majoré: база 10000, 2500 и 3000 (ровно то, что давали проценты). Ожидание не менялось.
language "law.core" version "0.2";
package fr.pf.cf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cf";

test "urn:query:fr-pf-cf-dom-devoir-base" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2021-06-15T12:00:00Z; knowledge_time @2021-06-15T12:00:00Z; legal_time @2021-06-15; timezone "Europe/Paris"; }
        assert "ddb-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:dom-devoir-base"), entity_ref("urn:fr:pf-cf:case:dom-devoir-base-e1")) { origin case_input; }
        assert "ddb-02": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:dom-devoir-base"), entity_ref("urn:fr:pf-cf:case:dom-devoir-base-e2")) { origin case_input; }
        assert "ddb-03": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:dom-devoir-base-e1")) { origin case_input; }
        assert "ddb-04": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:dom-devoir-base-e2")) { origin case_input; }
        assert "ddb-05": date_naissance(entity_ref("urn:fr:pf-cf:case:dom-devoir-base-e1"), @2017-03-15) { origin case_input; }
        assert "ddb-06": date_naissance(entity_ref("urn:fr:pf-cf:case:dom-devoir-base-e2"), @2015-03-15) { origin case_input; }
        assert "ddb-07": mois_droit(@2021-06-01) { origin case_input; }
        assert "ddb-08": nb_enfants_cf(entity_ref("urn:fr:pf-cf:case:dom-devoir-base"), 2) { origin case_input; }
        assert "ddb-09": ressources_menage(entity_ref("urn:fr:pf-cf:case:dom-devoir-base"), 20000 EUR) { origin case_input; }
        assert "ddb-10": plafond_base_cf(entity_ref("urn:fr:pf-cf:case:dom-devoir-base"), 20000 EUR) { origin case_input; }
        assert "ddb-10a": majoration_enfant_cf(entity_ref("urn:fr:pf-cf:case:dom-devoir-base"), 5000 EUR) { origin case_input; }
        assert "ddb-10b": majoration_troisieme_cf(entity_ref("urn:fr:pf-cf:case:dom-devoir-base"), 6000 EUR) { origin case_input; }
        assert "ddb-10c": plafond_base_majore(entity_ref("urn:fr:pf-cf:case:dom-devoir-base"), 10000 EUR) { origin case_input; }
        assert "ddb-10d": majoration_enfant_majore(entity_ref("urn:fr:pf-cf:case:dom-devoir-base"), 2500 EUR) { origin case_input; }
        assert "ddb-10e": majoration_troisieme_majore(entity_ref("urn:fr:pf-cf:case:dom-devoir-base"), 3000 EUR) { origin case_input; }
        assert "ddb-11": foyer_du_cas(entity_ref("urn:fr:pf-cf:case:dom-devoir-base")) { origin case_input; }
        assert "ddb-12": territoire(entity_ref("urn:fr:pf-cf:case:dom-devoir-base"), REUNION) { origin case_input; }
        assert "ddb-13": cadre_cf_dom_remplie(entity_ref("urn:fr:pf-cf:case:dom-devoir-base")) { origin case_input; }
        assert "ddb-14": presence_jeune_dom(entity_ref("urn:fr:pf-cf:case:dom-devoir-base")) { origin case_input; }
        assert "ddb-15": base_dom_retenue(entity_ref("urn:fr:pf-cf:case:dom-devoir-base"), 400.00 EUR) { origin case_input; }
        assert "ddb-16": fr.pf.core::organisme_debiteur_pf(entity_ref("urn:fr:pf-cf:org:caisse"), entity_ref("urn:fr:pf-cf:case:dom-devoir-base")) { origin case_input; }
        assert "ddb-17": departement_l751_1(REUNION) { origin case_input; }
    }
    evaluate positions();
    expect position(PayerCfDomDu, ACTIVE);
    expect evaluation_status == COMPUTED;
}
