// D-85: PASS года отсчёта 2018 строится из закреплённого arrêté du 2017-12-05 (SSAS1733749A; fr.css.pass: sources/pass/arrete-2017-12-05-art1.txt):
// valeur mensuelle 3311 € x 12 = 39732 €. Порог R. 522-2 al. 3: 13,6 % x 39732 = 5403.552.
// Доход 5403.56 достигает порога -> couple_biactif; на сантим меньше (5403.55) — нет (NEITHER). Дата дела — июнь 2020 (ресурсы N-2 по R. 532-1).
// Порождено tools/build_pass_tests.py из закреплённых байтов fr.css.pass — руками не править.
language "law.core" version "0.2";
package fr.pf.cf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cf";

test "urn:query:fr-pf-cf-pass-2018-seuil" {
    given {
        context { decision_time @2020-06-15T12:00:00Z; knowledge_time @2020-06-15T12:00:00Z; legal_time @2020-06-15; timezone "Europe/Paris"; }
        assert "p18a-01": revenu_pro_min_couple(entity_ref("urn:fr:pf-cf:case:pass-2018-seuil"), 5403.56 EUR) { origin case_input; }
        assert "p18a-02": annee_reference_ressources(entity_ref("urn:fr:pf-cf:case:pass-2018-seuil"), 2018) { origin case_input; }
    }
    evaluate truth(pass_reference(entity_ref("urn:fr:pf-cf:case:pass-2018-seuil"), 39732 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(couple_biactif(entity_ref("urn:fr:pf-cf:case:pass-2018-seuil")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "urn:query:fr-pf-cf-pass-2018-sous-seuil" {
    given {
        context { decision_time @2020-06-15T12:00:00Z; knowledge_time @2020-06-15T12:00:00Z; legal_time @2020-06-15; timezone "Europe/Paris"; }
        assert "p18b-01": revenu_pro_min_couple(entity_ref("urn:fr:pf-cf:case:pass-2018-sous-seuil"), 5403.55 EUR) { origin case_input; }
        assert "p18b-02": annee_reference_ressources(entity_ref("urn:fr:pf-cf:case:pass-2018-sous-seuil"), 2018) { origin case_input; }
    }
    evaluate truth(pass_reference(entity_ref("urn:fr:pf-cf:case:pass-2018-sous-seuil"), 39732 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(couple_biactif(entity_ref("urn:fr:pf-cf:case:pass-2018-sous-seuil")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
