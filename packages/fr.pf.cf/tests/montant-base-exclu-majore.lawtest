// Exclusivity (D-29(a), L. 522-3): the household within the half ceiling
// (15000 <= 18000) receives the increased amount INSTEAD of the base
// amount: cf_montant_du must not be derived next to cf_majore_du.
// D-83: плафоны строятся из опубликованных сумм — база 20000, надбавки 25 % = 5000 и 30 % = 6000; montant majoré: база 10000, 2500 и 3000 (ровно то, что давали проценты). Ожидание не менялось.
language "law.core" version "0.2";
package fr.pf.cf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cf";

test "urn:query:fr-pf-cf-montant-base-exclu-majore" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2018-04-15T12:00:00Z; knowledge_time @2018-04-15T12:00:00Z; legal_time @2018-04-15; timezone "Europe/Paris"; }
        assert "bem-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:montant-base-exclu-majore"), entity_ref("urn:fr:pf-cf:case:montant-base-exclu-majore-e1")) { origin case_input; }
        assert "bem-02": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:montant-base-exclu-majore"), entity_ref("urn:fr:pf-cf:case:montant-base-exclu-majore-e2")) { origin case_input; }
        assert "bem-03": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:montant-base-exclu-majore"), entity_ref("urn:fr:pf-cf:case:montant-base-exclu-majore-e3")) { origin case_input; }
        assert "bem-04": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:montant-base-exclu-majore-e1")) { origin case_input; }
        assert "bem-05": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:montant-base-exclu-majore-e2")) { origin case_input; }
        assert "bem-06": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:montant-base-exclu-majore-e3")) { origin case_input; }
        assert "bem-07": date_naissance(entity_ref("urn:fr:pf-cf:case:montant-base-exclu-majore-e1"), @2014-03-15) { origin case_input; }
        assert "bem-08": date_naissance(entity_ref("urn:fr:pf-cf:case:montant-base-exclu-majore-e2"), @2012-03-15) { origin case_input; }
        assert "bem-09": date_naissance(entity_ref("urn:fr:pf-cf:case:montant-base-exclu-majore-e3"), @2010-03-15) { origin case_input; }
        assert "bem-10": mois_droit(@2018-04-01) { origin case_input; }
        assert "bem-11": nb_enfants_cf(entity_ref("urn:fr:pf-cf:case:montant-base-exclu-majore"), 3) { origin case_input; }
        assert "bem-12": ressources_menage(entity_ref("urn:fr:pf-cf:case:montant-base-exclu-majore"), 15000 EUR) { origin case_input; }
        assert "bem-13": plafond_base_cf(entity_ref("urn:fr:pf-cf:case:montant-base-exclu-majore"), 20000 EUR) { origin case_input; }
        assert "bem-13a": majoration_enfant_cf(entity_ref("urn:fr:pf-cf:case:montant-base-exclu-majore"), 5000 EUR) { origin case_input; }
        assert "bem-13b": majoration_troisieme_cf(entity_ref("urn:fr:pf-cf:case:montant-base-exclu-majore"), 6000 EUR) { origin case_input; }
        assert "bem-13c": plafond_base_majore(entity_ref("urn:fr:pf-cf:case:montant-base-exclu-majore"), 10000 EUR) { origin case_input; }
        assert "bem-13d": majoration_enfant_majore(entity_ref("urn:fr:pf-cf:case:montant-base-exclu-majore"), 2500 EUR) { origin case_input; }
        assert "bem-13e": majoration_troisieme_majore(entity_ref("urn:fr:pf-cf:case:montant-base-exclu-majore"), 3000 EUR) { origin case_input; }
        assert "bem-14": foyer_du_cas(entity_ref("urn:fr:pf-cf:case:montant-base-exclu-majore")) { origin case_input; }
        assert "bem-15": cadre_cf_remplie(entity_ref("urn:fr:pf-cf:case:montant-base-exclu-majore")) { origin case_input; }
        assert "bem-16": bmaf_retenu(entity_ref("urn:fr:pf-cf:case:montant-base-exclu-majore"), 100.00 EUR) { origin case_input; }
    }
    evaluate truth(cf_majore_du(entity_ref("urn:fr:pf-cf:case:montant-base-exclu-majore"), 62.48 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_montant_du(entity_ref("urn:fr:pf-cf:case:montant-base-exclu-majore"), 41.65 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
