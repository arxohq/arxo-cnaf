// Overrun exactly at twelve monthly amounts: 37199.52 - 36000 =
// 1199.52 = 12 x 0.4165 x 240.00, and the comparison is strict, so no
// differential (NEITHER at any amount; 0 EUR is the probe).
// D-83: плафоны строятся из опубликованных сумм — база 20000, надбавки 25 % = 5000 и 30 % = 6000; montant majoré: база 10000, 2500 и 3000 (ровно то, что давали проценты). Ожидание не менялось.
language "law.core" version "0.2";
package fr.pf.cf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cf";

test "urn:query:fr-pf-cf-differentiel-seuil-egal" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2021-06-15T12:00:00Z; knowledge_time @2021-06-15T12:00:00Z; legal_time @2021-06-15; timezone "Europe/Paris"; }
        assert "dse-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:differentiel-seuil-egal"), entity_ref("urn:fr:pf-cf:case:differentiel-seuil-egal-e1")) { origin case_input; }
        assert "dse-02": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:differentiel-seuil-egal"), entity_ref("urn:fr:pf-cf:case:differentiel-seuil-egal-e2")) { origin case_input; }
        assert "dse-03": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:differentiel-seuil-egal"), entity_ref("urn:fr:pf-cf:case:differentiel-seuil-egal-e3")) { origin case_input; }
        assert "dse-04": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:differentiel-seuil-egal-e1")) { origin case_input; }
        assert "dse-05": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:differentiel-seuil-egal-e2")) { origin case_input; }
        assert "dse-06": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:differentiel-seuil-egal-e3")) { origin case_input; }
        assert "dse-07": date_naissance(entity_ref("urn:fr:pf-cf:case:differentiel-seuil-egal-e1"), @2016-03-15) { origin case_input; }
        assert "dse-08": date_naissance(entity_ref("urn:fr:pf-cf:case:differentiel-seuil-egal-e2"), @2014-03-15) { origin case_input; }
        assert "dse-09": date_naissance(entity_ref("urn:fr:pf-cf:case:differentiel-seuil-egal-e3"), @2012-03-15) { origin case_input; }
        assert "dse-10": mois_droit(@2021-06-01) { origin case_input; }
        assert "dse-11": nb_enfants_cf(entity_ref("urn:fr:pf-cf:case:differentiel-seuil-egal"), 3) { origin case_input; }
        assert "dse-12": ressources_menage(entity_ref("urn:fr:pf-cf:case:differentiel-seuil-egal"), 37199.52 EUR) { origin case_input; }
        assert "dse-13": plafond_base_cf(entity_ref("urn:fr:pf-cf:case:differentiel-seuil-egal"), 20000 EUR) { origin case_input; }
        assert "dse-13a": majoration_enfant_cf(entity_ref("urn:fr:pf-cf:case:differentiel-seuil-egal"), 5000 EUR) { origin case_input; }
        assert "dse-13b": majoration_troisieme_cf(entity_ref("urn:fr:pf-cf:case:differentiel-seuil-egal"), 6000 EUR) { origin case_input; }
        assert "dse-13c": plafond_base_majore(entity_ref("urn:fr:pf-cf:case:differentiel-seuil-egal"), 10000 EUR) { origin case_input; }
        assert "dse-13d": majoration_enfant_majore(entity_ref("urn:fr:pf-cf:case:differentiel-seuil-egal"), 2500 EUR) { origin case_input; }
        assert "dse-13e": majoration_troisieme_majore(entity_ref("urn:fr:pf-cf:case:differentiel-seuil-egal"), 3000 EUR) { origin case_input; }
        assert "dse-14": foyer_du_cas(entity_ref("urn:fr:pf-cf:case:differentiel-seuil-egal")) { origin case_input; }
        assert "dse-15": bmaf_retenu(entity_ref("urn:fr:pf-cf:case:differentiel-seuil-egal"), 240.00 EUR) { origin case_input; }
    }
    evaluate truth(cf_differentiel_du(entity_ref("urn:fr:pf-cf:case:differentiel-seuil-egal"), 0 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
