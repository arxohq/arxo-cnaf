// DOM base amount, two children in Guadeloupe (ED2022_10 window): resources
// 20000 lie above the half ceiling 15000 and within the plain ceiling 30000,
// so the base track opens: 41.65 % x L755-3 base 400 = 166.60. The increased
// track stays silent (D-39(a) exclusivity mirrored for L. 755-16-1).
// D-83: плафоны строятся из опубликованных сумм — база 20000, надбавки 25 % = 5000 и 30 % = 6000; montant majoré: база 10000, 2500 и 3000 (ровно то, что давали проценты). Ожидание не менялось.
language "law.core" version "0.2";
package fr.pf.cf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cf";

test "urn:query:fr-pf-cf-dom-montant-base" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2023-03-15T12:00:00Z; knowledge_time @2023-03-15T12:00:00Z; legal_time @2023-03-15; timezone "Europe/Paris"; }
        assert "dmb-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:dom-montant-base"), entity_ref("urn:fr:pf-cf:case:dom-montant-base-e1")) { origin case_input; }
        assert "dmb-02": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:dom-montant-base"), entity_ref("urn:fr:pf-cf:case:dom-montant-base-e2")) { origin case_input; }
        assert "dmb-03": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:dom-montant-base-e1")) { origin case_input; }
        assert "dmb-04": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:dom-montant-base-e2")) { origin case_input; }
        assert "dmb-05": date_naissance(entity_ref("urn:fr:pf-cf:case:dom-montant-base-e1"), @2018-03-15) { origin case_input; }
        assert "dmb-06": date_naissance(entity_ref("urn:fr:pf-cf:case:dom-montant-base-e2"), @2016-03-15) { origin case_input; }
        assert "dmb-07": mois_droit(@2023-03-01) { origin case_input; }
        assert "dmb-08": nb_enfants_cf(entity_ref("urn:fr:pf-cf:case:dom-montant-base"), 2) { origin case_input; }
        assert "dmb-09": ressources_menage(entity_ref("urn:fr:pf-cf:case:dom-montant-base"), 20000 EUR) { origin case_input; }
        assert "dmb-10": plafond_base_cf(entity_ref("urn:fr:pf-cf:case:dom-montant-base"), 20000 EUR) { origin case_input; }
        assert "dmb-10a": majoration_enfant_cf(entity_ref("urn:fr:pf-cf:case:dom-montant-base"), 5000 EUR) { origin case_input; }
        assert "dmb-10b": majoration_troisieme_cf(entity_ref("urn:fr:pf-cf:case:dom-montant-base"), 6000 EUR) { origin case_input; }
        assert "dmb-10c": plafond_base_majore(entity_ref("urn:fr:pf-cf:case:dom-montant-base"), 10000 EUR) { origin case_input; }
        assert "dmb-10d": majoration_enfant_majore(entity_ref("urn:fr:pf-cf:case:dom-montant-base"), 2500 EUR) { origin case_input; }
        assert "dmb-10e": majoration_troisieme_majore(entity_ref("urn:fr:pf-cf:case:dom-montant-base"), 3000 EUR) { origin case_input; }
        assert "dmb-11": foyer_du_cas(entity_ref("urn:fr:pf-cf:case:dom-montant-base")) { origin case_input; }
        assert "dmb-12": territoire(entity_ref("urn:fr:pf-cf:case:dom-montant-base"), GUADELOUPE) { origin case_input; }
        assert "dmb-13": cadre_cf_dom_remplie(entity_ref("urn:fr:pf-cf:case:dom-montant-base")) { origin case_input; }
        assert "dmb-14": presence_jeune_dom(entity_ref("urn:fr:pf-cf:case:dom-montant-base")) { origin case_input; }
        assert "dmb-15": base_dom_retenue(entity_ref("urn:fr:pf-cf:case:dom-montant-base"), 400.00 EUR) { origin case_input; }
        assert "dmb-16": bmaf_retenu(entity_ref("urn:fr:pf-cf:case:dom-montant-base"), 100.00 EUR) { origin case_input; }
        assert "dmb-17": departement_l751_1(GUADELOUPE) { origin case_input; }
    }
    evaluate truth(cf_dom_montant_du(entity_ref("urn:fr:pf-cf:case:dom-montant-base"), 166.60 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_dom_majore_du(entity_ref("urn:fr:pf-cf:case:dom-montant-base"), 62.48 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
