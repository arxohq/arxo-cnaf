// Three children aged 5, 7, 9: each qualifies ([3,20)), resources within
// the stated ceiling, core award frame met: right open.
// Ceiling 41000 EUR is fund-stated, consistent with the 03 formula
// (20000 + 0.25*20000*3 + 0.30*20000*1).
language "law.core" version "0.2";
package fr.pf.cf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cf";

test "urn:query:fr-pf-cf-conditions-trois-enfants" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2021-06-15T12:00:00Z; knowledge_time @2021-06-15T12:00:00Z; legal_time @2021-06-15; timezone "Europe/Paris"; }
        assert "c3e-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:cond-trois-enfants"), entity_ref("urn:fr:pf-cf:case:cond-trois-enfants-e1")) { origin case_input; }
        assert "c3e-02": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:cond-trois-enfants"), entity_ref("urn:fr:pf-cf:case:cond-trois-enfants-e2")) { origin case_input; }
        assert "c3e-03": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-cf:case:cond-trois-enfants"), entity_ref("urn:fr:pf-cf:case:cond-trois-enfants-e3")) { origin case_input; }
        assert "c3e-04": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:cond-trois-enfants-e1")) { origin case_input; }
        assert "c3e-05": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:cond-trois-enfants-e2")) { origin case_input; }
        assert "c3e-06": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-cf:case:cond-trois-enfants-e3")) { origin case_input; }
        assert "c3e-07": date_naissance(entity_ref("urn:fr:pf-cf:case:cond-trois-enfants-e1"), @2016-03-15) { origin case_input; }
        assert "c3e-08": date_naissance(entity_ref("urn:fr:pf-cf:case:cond-trois-enfants-e2"), @2014-03-15) { origin case_input; }
        assert "c3e-09": date_naissance(entity_ref("urn:fr:pf-cf:case:cond-trois-enfants-e3"), @2012-03-15) { origin case_input; }
        assert "c3e-10": mois_droit(@2021-06-01) { origin case_input; }
        assert "c3e-11": nb_enfants_cf(entity_ref("urn:fr:pf-cf:case:cond-trois-enfants"), 3) { origin case_input; }
        assert "c3e-12": ressources_menage(entity_ref("urn:fr:pf-cf:case:cond-trois-enfants"), 30000 EUR) { origin case_input; }
        assert "c3e-13": plafond_cf_applicable(entity_ref("urn:fr:pf-cf:case:cond-trois-enfants"), 41000 EUR) { origin case_input; }
        assert "c3e-14": cadre_cf_remplie(entity_ref("urn:fr:pf-cf:case:cond-trois-enfants")) { origin case_input; }
    }
    evaluate truth(cf_enfant_qualifie(entity_ref("urn:fr:pf-cf:case:cond-trois-enfants-e1")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_enfant_qualifie(entity_ref("urn:fr:pf-cf:case:cond-trois-enfants-e2")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_enfant_qualifie(entity_ref("urn:fr:pf-cf:case:cond-trois-enfants-e3")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(cf_droit_ouvert(entity_ref("urn:fr:pf-cf:case:cond-trois-enfants")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
