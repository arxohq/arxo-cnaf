// D-85: PASS года отсчёта 2023 строится из закреплённого arrêté du 2022-12-09 (SPRS2236037A; fr.css.pass: sources/pass/arrete-2022-12-09-art1.txt):
// valeur mensuelle 3666 € x 12 = 43992 €. Порог R. 522-2 al. 3: 13,6 % x 43992 = 5982.912.
// Доход 5982.92 достигает порога -> couple_biactif; на сантим меньше (5982.91) — нет (NEITHER). Дата дела — июнь 2025 (ресурсы N-2 по R. 532-1).
// Порождено tools/build_pass_tests.py из закреплённых байтов fr.css.pass — руками не править.
language "law.core" version "0.2";
package fr.pf.cf version "0.1.0";
namespace "urn:fr:corpus:clir:pf-cf";

test "urn:query:fr-pf-cf-pass-2023-seuil" {
    given {
        context { decision_time @2025-06-15T12:00:00Z; knowledge_time @2025-06-15T12:00:00Z; legal_time @2025-06-15; timezone "Europe/Paris"; }
        assert "p23a-01": revenu_pro_min_couple(entity_ref("urn:fr:pf-cf:case:pass-2023-seuil"), 5982.92 EUR) { origin case_input; }
        assert "p23a-02": annee_reference_ressources(entity_ref("urn:fr:pf-cf:case:pass-2023-seuil"), 2023) { origin case_input; }
    }
    evaluate truth(pass_reference(entity_ref("urn:fr:pf-cf:case:pass-2023-seuil"), 43992 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(couple_biactif(entity_ref("urn:fr:pf-cf:case:pass-2023-seuil")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "urn:query:fr-pf-cf-pass-2023-sous-seuil" {
    given {
        context { decision_time @2025-06-15T12:00:00Z; knowledge_time @2025-06-15T12:00:00Z; legal_time @2025-06-15; timezone "Europe/Paris"; }
        assert "p23b-01": revenu_pro_min_couple(entity_ref("urn:fr:pf-cf:case:pass-2023-sous-seuil"), 5982.91 EUR) { origin case_input; }
        assert "p23b-02": annee_reference_ressources(entity_ref("urn:fr:pf-cf:case:pass-2023-sous-seuil"), 2023) { origin case_input; }
    }
    evaluate truth(pass_reference(entity_ref("urn:fr:pf-cf:case:pass-2023-sous-seuil"), 43992 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(couple_biactif(entity_ref("urn:fr:pf-cf:case:pass-2023-sous-seuil")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
