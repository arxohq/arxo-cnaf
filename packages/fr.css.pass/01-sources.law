@id("urn:fr:corpus:clir:pass#ARRETE_2014_11_26_PASS_ART1")
pub fragment ARRETE_2014_11_26_PASS_ART1 in ARRETE_2014_11_26_PASS_ART1_ED {
    kind article;
    locator "article/1";
    text fr official """Pour les rémunérations ou gains versés à compter du 1er janvier et jusqu'au 31 décembre 2015, les valeurs mensuelle et journalière du plafond de la sécurité sociale mentionnées à l'article D. 242-17 du code de la sécurité sociale sont les suivantes :
- valeur mensuelle : 3 170 euros ;
- valeur journalière : 174 euros.
""";
    content_hash "sha256:b84552a6de0eda3a10ebf967ccf7179b87a1429b04904f1670ccd0b64861118d";
}

