    kind order;
    jurisdiction FR;
    number "AFSS1428039A";
    label fr official "Arrêté du 26 novembre 2014 portant fixation du plafond de la sécurité sociale pour 2015";
    label ru unofficial "Приказ от 26 ноября 2014 года об определении потолка социального страхования (PASS) на 2015 год";
}

