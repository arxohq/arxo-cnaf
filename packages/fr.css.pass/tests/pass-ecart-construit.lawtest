// Построение годового PASS не принимает суммы, расходящиеся с текстом arrêté ровно на евро.
language "law.core" version "0.2";
package fr.css.pass version "0.1.0";
namespace "urn:fr:corpus:clir:pass";

// 2015: построение — не подстановка. Годовое значение 38041 (на евро больше 12 × 3170) и
// месячное 3171 (на евро больше текста arrêté) не устанавливаются.
test "urn:query:fr-pass-ecart-2015" {
    given {
        context { decision_time @2018-06-15T12:00:00Z; knowledge_time @2018-06-15T12:00:00Z; legal_time @2018-06-15; timezone "Europe/Paris"; }
    }
    evaluate truth(pass_annuel_arrete(2015, 38041 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(pass_mensuel_arrete(2015, 3171 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

