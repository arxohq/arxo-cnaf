// PASS 2017: valeur mensuelle 3269 € (arrêté du 2016-12-05, AFSS1628753A; sources/pass/arrete-2016-12-05-art1.txt);
// годовое значение строится 12 × 3269 = 39228 €. Дата дела ни при чём: ключ — год.
language "law.core" version "0.2";
package fr.css.pass version "0.1.0";
namespace "urn:fr:corpus:clir:pass";

test "urn:query:fr-pass-serie-2017" {
    given {
        context { decision_time @2018-06-15T12:00:00Z; knowledge_time @2018-06-15T12:00:00Z; legal_time @2018-06-15; timezone "Europe/Paris"; }
    }
    evaluate truth(pass_mensuel_arrete(2017, 3269 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(pass_annuel_arrete(2017, 39228 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
