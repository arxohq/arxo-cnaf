// PASS 2016: valeur mensuelle 3218 € (arrêté du 2015-12-17, AFSS1530064A; sources/pass/arrete-2015-12-17-art1.txt);
// годовое значение строится 12 × 3218 = 38616 €. Дата дела ни при чём: ключ — год.
language "law.core" version "0.2";
package fr.css.pass version "0.1.0";
namespace "urn:fr:corpus:clir:pass";

test "urn:query:fr-pass-serie-2016" {
    given {
        context { decision_time @2018-06-15T12:00:00Z; knowledge_time @2018-06-15T12:00:00Z; legal_time @2018-06-15; timezone "Europe/Paris"; }
    }
    evaluate truth(pass_mensuel_arrete(2016, 3218 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(pass_annuel_arrete(2016, 38616 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
