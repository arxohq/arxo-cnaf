// PASS 2019: valeur mensuelle 3377 € (arrêté du 2018-12-11, SSAS1833942A; sources/pass/arrete-2018-12-11-art1.txt);
// годовое значение строится 12 × 3377 = 40524 €. Дата дела ни при чём: ключ — год.
language "law.core" version "0.2";
package fr.css.pass version "0.1.0";
namespace "urn:fr:corpus:clir:pass";

test "urn:query:fr-pass-serie-2019" {
    given {
        context { decision_time @2019-06-15T12:00:00Z; knowledge_time @2019-06-15T12:00:00Z; legal_time @2019-06-15; timezone "Europe/Paris"; }
    }
    evaluate truth(pass_mensuel_arrete(2019, 3377 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(pass_annuel_arrete(2019, 40524 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
