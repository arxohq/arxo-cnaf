    effective [@2026-01-01, infinity);
    label fr official "plafond de la sécurité sociale 2026 : valeur mensuelle 4005 euros selon l'arrêté du 2025-12-22 (CPPS2536168A), article 1";
    label ru unofficial "PASS 2026: месячное значение 4005 € по приказу от 2025-12-22 (CPPS2536168A), ст. 1";
