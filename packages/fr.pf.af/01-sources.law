@id("urn:fr:corpus:clir:pf-af#CSS_D521_4")
pub fragment CSS_D521_4 in CSS_ED2015_07 {
    kind article;
    locator "article/D521-4";
    text fr official """Article D521-4
Pour l'application des articles D. 521-1 et D. 521-2, les ressources du ménage ou de la personne sont appréciées dans les conditions prévues aux articles R. 532-3 à R. 532-8.
""";
    content_hash "sha256:f0fc069ba9ada14141ada93f747f4e87dbf61df78dd34be3a1a1445536fe79cc";
}

