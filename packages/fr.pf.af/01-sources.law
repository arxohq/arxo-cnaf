    content_hash "sha256:97cf754a886bc086d5e549965f04c9d48307c2c7527e6ebbd3c83d8561347477";
}

@id("urn:fr:corpus:clir:pf-af#CSS_L755_12_ED2021_09")
pub fragment CSS_L755_12_ED2021_09 in CSS_ED2021_09 {
    kind article;
    locator "article/L755-12";
    text fr official """Article L755-12
Les allocations familiales sont dues, pour tout enfant, à la personne qui a effectivement la charge de celui-ci.
Toutefois, les quatre derniers alinéas de l'article L. 521-1 ne sont pas applicables lorsque le ménage ou la personne a un seul enfant à charge.
""";
    content_hash "sha256:97cf754a886bc086d5e549965f04c9d48307c2c7527e6ebbd3c83d8561347477";
}

