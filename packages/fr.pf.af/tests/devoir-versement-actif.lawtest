// D-81 (08.10.2026): вход facteur_revalorisation(1.0) заменён плафонами-входами
// D. 521-3: база I 55950, база II 78300, надбавка 5595 за ребёнка =
// суммы D. 521-3 I/II × 1.0 — заявленные иллюстративные суммы, не опубликованные
// DSS на дату дела. (база + надбавка × n) × F = база·F + надбавка·F × n — ожидания
// не меняются.
// Active fund duty: the designated parent receives 128.00 and the
// debtor fund is recorded. Position PayerAllocationsFamilialesDues
// is ACTIVE.
language "law.core" version "0.2";
package fr.pf.af version "0.1.0";
namespace "urn:fr:corpus:clir:pf-af";

test "urn:query:fr-pf-af-devoir-versement-actif" {
    given {
        context { decision_time @2023-06-15T12:00:00Z; knowledge_time @2023-06-15T12:00:00Z; legal_time @2023-06-15; timezone "Europe/Paris"; }
        assert "devoir-01": territoire(entity_ref("urn:fr:pf-af:parent:mere-dev"), METROPOLE) { origin case_input; }
        assert "devoir-02": nb_enfants_charge(entity_ref("urn:fr:pf-af:parent:mere-dev"), 2) { origin case_input; }
        assert "devoir-03": ressources_menage(entity_ref("urn:fr:pf-af:parent:mere-dev"), 30000 EUR) { origin case_input; }
        assert "devoir-04": plafond_base_tranche1_publie(entity_ref("urn:fr:pf-af:parent:mere-dev"), 55950 EUR) { origin case_input; }
        assert "devoir-04b": plafond_base_tranche2_publie(entity_ref("urn:fr:pf-af:parent:mere-dev"), 78300 EUR) { origin case_input; }
        assert "devoir-04c": majoration_plafond_enfant_publiee(entity_ref("urn:fr:pf-af:parent:mere-dev"), 5595 EUR) { origin case_input; }
        assert "devoir-05": bmaf_retenu(entity_ref("urn:fr:pf-af:parent:mere-dev"), 400.00 EUR) { origin case_input; }
        assert "devoir-06": nb_majorations_pleines(entity_ref("urn:fr:pf-af:parent:mere-dev"), 0) { origin case_input; }
        assert "devoir-07": nb_majorations_demi(entity_ref("urn:fr:pf-af:parent:mere-dev"), 0) { origin case_input; }
        assert "devoir-08": forfait_total_menage(entity_ref("urn:fr:pf-af:parent:mere-dev"), 0 EUR) { origin case_input; }
        assert "devoir-09": nb_enfants_ase_service(entity_ref("urn:fr:pf-af:parent:mere-dev"), 0) { origin case_input; }
        assert "devoir-10": foyer_du_cas(entity_ref("urn:fr:pf-af:parent:mere-dev")) { origin case_input; }
        assert "devoir-11": allocataire_unique_convenu(entity_ref("urn:fr:pf-af:parent:mere-dev")) { origin case_input; }
        assert "devoir-12": fr.pf.core::organisme_debiteur_pf(entity_ref("urn:fr:pf-af:org:caisse"), entity_ref("urn:fr:pf-af:parent:mere-dev")) { origin case_input; }
    }
    evaluate positions();
    expect position(PayerAllocationsFamilialesDues, ACTIVE);
    expect evaluation_status == COMPUTED;
}
