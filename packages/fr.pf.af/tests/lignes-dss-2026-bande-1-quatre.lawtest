// Прочтение D-83 выбрано в context (`interpretation ArrondiLignesDss;`): суммы AF — округлённые
// строки таблицы DSS, итог — их сумма (08-lecture-arrondi-lignes.law). Ожидания — строки
// закреплённой таблицы DSS/2B/2026/46 (фрагменты DSS_2026_46_AF и DSS_2026_46_MAJO; revalorisation/sources/
// dss-2026-46.txt), BMAF 478,16 € с 01.04.2026: «4 enfants 114 % 545,1» (:194) и majoration «16 % 76,51» (:208).
// Строка базы — доля СЕМЬИ, округлённая один раз: по рангам было бы 153,01 + 2 × 196,05 = 545,11, а таблица
// печатает 545,10. Четыре ребёнка, одна надбавка, полоса 1 (ресурсы 30 000 ≤ I(4) = 66 652 + 4 × 6 664 = 93 308,
// фрагмент DSS_2025_177_PLAFOND_AF). Итог 545,10 + 76,51 = 621,61.
language "law.core" version "0.2";
package fr.pf.af version "0.1.0";
namespace "urn:fr:corpus:clir:pf-af";

test "urn:query:fr-pf-af-lignes-dss-2026-bande-1-quatre" {
    given {
        context { decision_time @2026-04-15T12:00:00Z; knowledge_time @2026-04-15T12:00:00Z; legal_time @2026-04-15; timezone "Europe/Paris"; interpretation ArrondiLignesDss; }
        assert "l83-01": territoire(entity_ref("urn:fr:pf-af:case:lignes-dss-2026-bande-1-quatre"), METROPOLE) { origin case_input; }
        assert "l83-02": nb_enfants_charge(entity_ref("urn:fr:pf-af:case:lignes-dss-2026-bande-1-quatre"), 4) { origin case_input; }
        assert "l83-03": ressources_menage(entity_ref("urn:fr:pf-af:case:lignes-dss-2026-bande-1-quatre"), 30000 EUR) { origin case_input; }
        assert "l83-04": plafond_base_tranche1_publie(entity_ref("urn:fr:pf-af:case:lignes-dss-2026-bande-1-quatre"), 66652 EUR) { origin case_input; }
        assert "l83-05": plafond_base_tranche2_publie(entity_ref("urn:fr:pf-af:case:lignes-dss-2026-bande-1-quatre"), 93276 EUR) { origin case_input; }
        assert "l83-06": majoration_plafond_enfant_publiee(entity_ref("urn:fr:pf-af:case:lignes-dss-2026-bande-1-quatre"), 6664 EUR) { origin case_input; }
        assert "l83-07": bmaf_retenu(entity_ref("urn:fr:pf-af:case:lignes-dss-2026-bande-1-quatre"), 478.16 EUR) { origin case_input; }
        assert "l83-08": nb_majorations_pleines(entity_ref("urn:fr:pf-af:case:lignes-dss-2026-bande-1-quatre"), 1) { origin case_input; }
        assert "l83-09": nb_majorations_demi(entity_ref("urn:fr:pf-af:case:lignes-dss-2026-bande-1-quatre"), 0) { origin case_input; }
        assert "l83-10": forfait_total_menage(entity_ref("urn:fr:pf-af:case:lignes-dss-2026-bande-1-quatre"), 0 EUR) { origin case_input; }
        assert "l83-11": nb_enfants_ase_service(entity_ref("urn:fr:pf-af:case:lignes-dss-2026-bande-1-quatre"), 0) { origin case_input; }
        assert "l83-12": foyer_du_cas(entity_ref("urn:fr:pf-af:case:lignes-dss-2026-bande-1-quatre")) { origin case_input; }
    }
    evaluate truth(bande_ressources(entity_ref("urn:fr:pf-af:case:lignes-dss-2026-bande-1-quatre"), BANDE_1));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(montant_mensuel_af(entity_ref("urn:fr:pf-af:case:lignes-dss-2026-bande-1-quatre"), 621.61 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(af_montant_du(entity_ref("urn:fr:pf-af:case:lignes-dss-2026-bande-1-quatre"), 621.61 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
