// D-81 (08.10.2026): вход facteur_revalorisation(1.0) заменён плафонами-входами
// D. 521-3: база I 55950, база II 78300, надбавка 5595 за ребёнка =
// суммы D. 521-3 I/II × 1.0 — заявленные иллюстративные суммы, не опубликованные
// DSS на дату дела. (база + надбавка × n) × F = база·F + надбавка·F × n — ожидания
// не меняются.
// New regime at 18: child born 2012-03-15 (14th birthday 2026-03-15,
// on or after 01.03.2026), claimed month 2026-03-01. Eighteen not
// reached: no age opening, metropolitan amount 0. Pair of
// majoration-18-atteint (same child in 2030).
language "law.core" version "0.2";
package fr.pf.af version "0.1.0";
namespace "urn:fr:corpus:clir:pf-af";

test "urn:query:fr-pf-af-majoration-18-nouveau-zero" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2026-03-01T12:00:00Z; knowledge_time @2026-03-01T12:00:00Z; legal_time @2026-03-01; timezone "Europe/Paris"; }
        assert "m18n-01": territoire(entity_ref("urn:fr:pf-af:case:majoration-18-nouveau-zero"), METROPOLE) { origin case_input; }
        assert "m18n-02": nb_enfants_charge(entity_ref("urn:fr:pf-af:case:majoration-18-nouveau-zero"), 2) { origin case_input; }
        assert "m18n-03": ressources_menage(entity_ref("urn:fr:pf-af:case:majoration-18-nouveau-zero"), 30000 EUR) { origin case_input; }
        assert "m18n-04": plafond_base_tranche1_publie(entity_ref("urn:fr:pf-af:case:majoration-18-nouveau-zero"), 55950 EUR) { origin case_input; }
        assert "m18n-04b": plafond_base_tranche2_publie(entity_ref("urn:fr:pf-af:case:majoration-18-nouveau-zero"), 78300 EUR) { origin case_input; }
        assert "m18n-04c": majoration_plafond_enfant_publiee(entity_ref("urn:fr:pf-af:case:majoration-18-nouveau-zero"), 5595 EUR) { origin case_input; }
        assert "m18n-05": bmaf_retenu(entity_ref("urn:fr:pf-af:case:majoration-18-nouveau-zero"), 400.00 EUR) { origin case_input; }
        assert "m18n-06": nb_majorations_pleines(entity_ref("urn:fr:pf-af:case:majoration-18-nouveau-zero"), 0) { origin case_input; }
        assert "m18n-07": nb_majorations_demi(entity_ref("urn:fr:pf-af:case:majoration-18-nouveau-zero"), 0) { origin case_input; }
        assert "m18n-08": forfait_total_menage(entity_ref("urn:fr:pf-af:case:majoration-18-nouveau-zero"), 0 EUR) { origin case_input; }
        assert "m18n-09": nb_enfants_ase_service(entity_ref("urn:fr:pf-af:case:majoration-18-nouveau-zero"), 0) { origin case_input; }
        assert "m18n-10": foyer_du_cas(entity_ref("urn:fr:pf-af:case:majoration-18-nouveau-zero")) { origin case_input; }
        assert "m18n-11": mois_droit(@2026-03-01) { origin case_input; }
        assert "m18n-12": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-af:case:majoration-18-nouveau-zero"), entity_ref("urn:fr:pf-af:child:aine-18")) { origin case_input; }
        assert "m18n-13": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-af:case:majoration-18-nouveau-zero"), entity_ref("urn:fr:pf-af:child:cadet-18")) { origin case_input; }
        assert "m18n-14": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-af:child:aine-18")) { origin case_input; }
        assert "m18n-15": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-af:child:cadet-18")) { origin case_input; }
        assert "m18n-16": date_naissance(entity_ref("urn:fr:pf-af:child:aine-18"), @2008-05-01) { origin case_input; }
        assert "m18n-17": date_naissance(entity_ref("urn:fr:pf-af:child:cadet-18"), @2012-03-15) { origin case_input; }
        assert "m18n-18": enfant_du_cas(entity_ref("urn:fr:pf-af:child:aine-18")) { origin case_input; }
        assert "m18n-19": enfant_du_cas(entity_ref("urn:fr:pf-af:child:cadet-18")) { origin case_input; }
        assert "m18n-20": garde(entity_ref("urn:fr:pf-af:child:aine-18"), CHARGE_EFFECTIVE_PERMANENTE) { origin case_input; }
        assert "m18n-21": garde(entity_ref("urn:fr:pf-af:child:cadet-18"), CHARGE_EFFECTIVE_PERMANENTE) { origin case_input; }
    }
    evaluate truth(montant_majoration(entity_ref("urn:fr:pf-af:child:cadet-18"), 0 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
