// РАВНО ДО САНТИМА: их 99.46, наше точное 99.4575. Их модель округляет
// промежуточные величины до сантима, текст этого не велит — закреплён НАШ ответ.
// ИСТОЧНИК: Catala, CatalaLang/catala-examples@2694b17d, allocations_familiales/tests/tests_allocations_familiales.catala_fr, scope Test4.
// ИХ ОЖИДАНИЕ: i_montant_versé = 99.46.
// ПЕРЕНОС: метрополия, дети 2007 (charge permanente) и 2003 (résidence alternée, partage — demande conjointe); цель — доля родителя R. 521-3
// ДЕТИ: e1 — 13 лет: до конца обязательного обучения (16 лет) — L. 512-3 1° (pf-core/sources/css/L512-3.txt:3); e3 — 17 лет, заработок 400 € ≤ плафона R. 512-2 (L. 512-3 2°); SMIC 2020 в корпусе не закреплён: квалификация по первому закреплённому SMIC (01.01.2021, 10,25 €/ч → плафон 952,66 €); тот же ответ при любом SMIC ниже 11,83 €/ч, их модель берёт 10,15 €/ч.
// СУММЫ: BMAF и плафоны D. 521-3 — закреплённые фрагменты fr.css.revalorisation
// (tools/openfisca_hook.py); счёт надбавок и forfait — пробы этого же пакета.
// Файл порождён corpus/tools/foreign/catala_tests.py (режим af-interface) по
// tools/foreign-map.json — правится таблица, не файл.
language "law.core" version "0.2";
package fr.pf.af version "0.1.0";
namespace "urn:fr:corpus:clir:pf-af";

test "urn:query:fr-pf-af-allocations_familiales-test4-i-montant-verse" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2020-05-01T12:00:00Z; knowledge_time @2020-05-01T12:00:00Z; legal_time @2020-05-01; timezone "Europe/Paris"; interpretation ArrondiLignesDss; }
        assert "allocations_familiales-test4-01": territoire(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test4"), METROPOLE) { origin case_input; }
        assert "allocations_familiales-test4-02": nb_enfants_charge(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test4"), 2) { origin case_input; }
        assert "allocations_familiales-test4-03": ressources_menage(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test4"), 67250 EUR) { origin case_input; }
        assert "allocations_familiales-test4-04": bmaf_retenu(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test4"), 414.4 EUR) { origin case_input; }
        assert "allocations_familiales-test4-05": plafond_base_tranche1_publie(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test4"), 57759 EUR) { origin case_input; }
        assert "allocations_familiales-test4-06": plafond_base_tranche2_publie(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test4"), 80831 EUR) { origin case_input; }
        assert "allocations_familiales-test4-07": majoration_plafond_enfant_publiee(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test4"), 5775 EUR) { origin case_input; }
        assert "allocations_familiales-test4-08": nb_majorations_pleines(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test4"), 0) { origin case_input; }
        assert "allocations_familiales-test4-09": nb_majorations_demi(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test4"), 0) { origin case_input; }
        assert "allocations_familiales-test4-10": forfait_total_menage(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test4"), 0 EUR) { origin case_input; }
        assert "allocations_familiales-test4-11": nb_enfants_ase_service(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test4"), 0) { origin case_input; }
        assert "allocations_familiales-test4-12": foyer_du_cas(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test4")) { origin case_input; }
        assert "allocations_familiales-test4-13": mois_droit(@2020-05-01) { origin case_input; }
        assert "allocations_familiales-test4-14": demande_conjointe_partage(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test4"), entity_ref("urn:fr:pf-af:catala:allocations_familiales-test4-bis")) { origin case_input; }
        assert "allocations_familiales-test4-15": enfants_propres(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test4"), 1) { origin case_input; }
        assert "allocations_familiales-test4-16": enfants_alternes(1) { origin case_input; }
        assert "allocations_familiales-test4-17": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test4"), entity_ref("urn:fr:pf-af:catala:allocations_familiales-test4-e1")) { origin case_input; }
        assert "allocations_familiales-test4-18": date_naissance(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test4-e1"), @2007-01-01) { origin case_input; }
        assert "allocations_familiales-test4-19": enfant_du_cas(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test4-e1")) { origin case_input; }
        assert "allocations_familiales-test4-20": garde(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test4-e1"), CHARGE_EFFECTIVE_PERMANENTE) { origin case_input; }
        assert "allocations_familiales-test4-21": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test4-e1")) { origin case_input; }
        assert "allocations_familiales-test4-22": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test4"), entity_ref("urn:fr:pf-af:catala:allocations_familiales-test4-e3")) { origin case_input; }
        assert "allocations_familiales-test4-23": date_naissance(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test4-e3"), @2003-01-01) { origin case_input; }
        assert "allocations_familiales-test4-24": enfant_du_cas(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test4-e3")) { origin case_input; }
        assert "allocations_familiales-test4-25": garde(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test4-e3"), RESIDENCE_ALTERNEE_PARTAGE) { origin case_input; }
        assert "allocations_familiales-test4-26": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test4-e3")) { origin case_input; }
    }
    evaluate truth(montant_parent_partage(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test4"), 99.4575 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
