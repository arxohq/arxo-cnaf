        assert "allocations_familiales-test2-08": nb_majorations_pleines(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test2"), 0) { origin case_input; }
        assert "allocations_familiales-test2-09": nb_majorations_demi(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test2"), 0) { origin case_input; }
        assert "allocations_familiales-test2-10": forfait_total_menage(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test2"), 83.85 EUR) { origin case_input; }
        assert "allocations_familiales-test2-11": nb_enfants_ase_service(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test2"), 0) { origin case_input; }
        assert "allocations_familiales-test2-12": foyer_du_cas(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test2")) { origin case_input; }
        assert "allocations_familiales-test2-13": mois_droit(@2020-05-01) { origin case_input; }
        assert "allocations_familiales-test2-14": nb_enfants_charge_forfait(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test2"), 3) { origin case_input; }
        assert "allocations_familiales-test2-15": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test2"), entity_ref("urn:fr:pf-af:catala:allocations_familiales-test2-e1")) { origin case_input; }
        assert "allocations_familiales-test2-16": date_naissance(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test2-e1"), @2007-01-01) { origin case_input; }
        assert "allocations_familiales-test2-17": enfant_du_cas(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test2-e1")) { origin case_input; }
        assert "allocations_familiales-test2-18": garde(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test2-e1"), CHARGE_EFFECTIVE_PERMANENTE) { origin case_input; }
        assert "allocations_familiales-test2-19": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test2-e1")) { origin case_input; }
        assert "allocations_familiales-test2-20": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test2"), entity_ref("urn:fr:pf-af:catala:allocations_familiales-test2-e2")) { origin case_input; }
        assert "allocations_familiales-test2-21": date_naissance(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test2-e2"), @2009-01-01) { origin case_input; }
        assert "allocations_familiales-test2-22": enfant_du_cas(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test2-e2")) { origin case_input; }
        assert "allocations_familiales-test2-23": garde(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test2-e2"), CHARGE_EFFECTIVE_PERMANENTE) { origin case_input; }
        assert "allocations_familiales-test2-24": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test2-e2")) { origin case_input; }
        assert "allocations_familiales-test2-25": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test2"), entity_ref("urn:fr:pf-af:catala:allocations_familiales-test2-e5")) { origin case_input; }
        assert "allocations_familiales-test2-26": date_naissance(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test2-e5"), @2000-01-01) { origin case_input; }
        assert "allocations_familiales-test2-27": enfant_du_cas(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test2-e5")) { origin case_input; }
        assert "allocations_familiales-test2-28": garde(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test2-e5"), CHARGE_EFFECTIVE_PERMANENTE) { origin case_input; }
        assert "allocations_familiales-test2-29": conditions_hormis_age(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test2-e5")) { origin case_input; }
