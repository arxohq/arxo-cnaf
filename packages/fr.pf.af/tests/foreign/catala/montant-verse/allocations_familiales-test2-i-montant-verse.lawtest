    }
    evaluate truth(af_montant_du(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test2"), 216.46 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
