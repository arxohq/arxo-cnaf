        assert "allocations_familiales-test6-15": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test6"), entity_ref("urn:fr:pf-af:catala:allocations_familiales-test6-e0")) { origin case_input; }
        assert "allocations_familiales-test6-16": date_naissance(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test6-e0"), @2009-11-10) { origin case_input; }
