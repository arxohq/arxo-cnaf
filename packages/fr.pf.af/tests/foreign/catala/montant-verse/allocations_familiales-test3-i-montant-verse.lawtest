// ИСТОЧНИК: Catala, CatalaLang/catala-examples@2694b17d, allocations_familiales/tests/tests_allocations_familiales.catala_fr, scope Test3.
// ИХ ОЖИДАНИЕ: i_montant_versé = 24.37.
// ПЕРЕНОС: Гвиана, один ребёнок 2007: L. 755-12 al. 2 (один ребёнок — без модуляции), D. 755-5 II 5,88 % базы L. 755-3 = BMAF (L. 755-3 al. 2, pf-dom/01-sources.law:129); цель — af_montant_du
// ДЕТИ: e1 — 13 лет: до конца обязательного обучения (16 лет) — L. 512-3 1° (pf-core/sources/css/L512-3.txt:3).
// СУММЫ: BMAF и плафоны D. 521-3 — закреплённые фрагменты fr.css.revalorisation
// (tools/openfisca_hook.py); счёт надбавок и forfait — пробы этого же пакета.
// Файл порождён corpus/tools/foreign/catala_tests.py (режим af-interface) по
// tools/foreign-map.json — правится таблица, не файл.
language "law.core" version "0.2";
package fr.pf.af version "0.1.0";
namespace "urn:fr:corpus:clir:pf-af";

test "urn:query:fr-pf-af-allocations_familiales-test3-i-montant-verse" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2020-05-01T12:00:00Z; knowledge_time @2020-05-01T12:00:00Z; legal_time @2020-05-01; timezone "Europe/Paris"; interpretation ArrondiLignesDss; }
        assert "allocations_familiales-test3-01": territoire(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test3"), GUYANE) { origin case_input; }
        assert "allocations_familiales-test3-02": nb_enfants_charge(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test3"), 1) { origin case_input; }
        assert "allocations_familiales-test3-03": ressources_menage(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test3"), 63540 EUR) { origin case_input; }
        assert "allocations_familiales-test3-04": bmaf_retenu(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test3"), 414.4 EUR) { origin case_input; }
        assert "allocations_familiales-test3-05": plafond_base_tranche1_publie(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test3"), 57759 EUR) { origin case_input; }
        assert "allocations_familiales-test3-06": plafond_base_tranche2_publie(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test3"), 80831 EUR) { origin case_input; }
        assert "allocations_familiales-test3-07": majoration_plafond_enfant_publiee(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test3"), 5775 EUR) { origin case_input; }
        assert "allocations_familiales-test3-08": base_dom_retenue(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test3"), 414.4 EUR) { origin case_input; }
        assert "allocations_familiales-test3-09": nb_majorations_pleines(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test3"), 0) { origin case_input; }
        assert "allocations_familiales-test3-10": nb_majorations_demi(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test3"), 0) { origin case_input; }
        assert "allocations_familiales-test3-11": forfait_total_menage(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test3"), 0 EUR) { origin case_input; }
        assert "allocations_familiales-test3-12": nb_enfants_ase_service(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test3"), 0) { origin case_input; }
        assert "allocations_familiales-test3-13": foyer_du_cas(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test3")) { origin case_input; }
        assert "allocations_familiales-test3-14": mois_droit(@2020-05-01) { origin case_input; }
        assert "allocations_familiales-test3-15": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test3"), entity_ref("urn:fr:pf-af:catala:allocations_familiales-test3-e1")) { origin case_input; }
        assert "allocations_familiales-test3-16": date_naissance(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test3-e1"), @2007-01-01) { origin case_input; }
        assert "allocations_familiales-test3-17": enfant_du_cas(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test3-e1")) { origin case_input; }
        assert "allocations_familiales-test3-18": garde(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test3-e1"), CHARGE_EFFECTIVE_PERMANENTE) { origin case_input; }
        assert "allocations_familiales-test3-19": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test3-e1")) { origin case_input; }
    }
    evaluate truth(af_montant_du(entity_ref("urn:fr:pf-af:catala:allocations_familiales-test3"), 24.37 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
