// D-81 (08.10.2026): вход facteur_revalorisation(1.0) заменён плафонами-входами
// D. 521-3: база I 55950, база II 78300, надбавка 5595 за ребёнка =
// суммы D. 521-3 I/II × 1.0 — заявленные иллюстративные суммы, не опубликованные
// DSS на дату дела. (база + надбавка × n) × F = база·F + надбавка·F × n — ожидания
// не меняются.
// Catala AF Test2 (2020-05-01, Metropole, resources 30 000):
// children 2007/2009 plus a 20-year-old (2000). The two young
// children open the base (band 1: 128.00); the aged-out child opens
// the lump sum (limit 2020-01-01, month inside the year).
// Their case -> our answer -> class: REPORT.md (Catala, 2).
language "law.core" version "0.2";
package fr.pf.af version "0.1.0";
namespace "urn:fr:corpus:clir:pf-af";

test "urn:query:fr-pf-af-catala-test-02" {
    given {
        context { deadline_policy FORFAIT_UN_AN; decision_time @2020-05-01T12:00:00Z; knowledge_time @2020-05-01T12:00:00Z; legal_time @2020-05-01; timezone "Europe/Paris"; }
        assert "ct02-01": territoire(entity_ref("urn:fr:pf-af:foreign:catala-02"), METROPOLE) { origin case_input; }
        assert "ct02-02": nb_enfants_charge(entity_ref("urn:fr:pf-af:foreign:catala-02"), 2) { origin case_input; }
        assert "ct02-02f": nb_enfants_charge_forfait(entity_ref("urn:fr:pf-af:foreign:catala-02"), 3) { origin case_input; }
        assert "ct02-03": ressources_menage(entity_ref("urn:fr:pf-af:foreign:catala-02"), 30000 EUR) { origin case_input; }
        assert "ct02-04": plafond_base_tranche1_publie(entity_ref("urn:fr:pf-af:foreign:catala-02"), 55950 EUR) { origin case_input; }
        assert "ct02-04b": plafond_base_tranche2_publie(entity_ref("urn:fr:pf-af:foreign:catala-02"), 78300 EUR) { origin case_input; }
        assert "ct02-04c": majoration_plafond_enfant_publiee(entity_ref("urn:fr:pf-af:foreign:catala-02"), 5595 EUR) { origin case_input; }
        assert "ct02-05": bmaf_retenu(entity_ref("urn:fr:pf-af:foreign:catala-02"), 400.00 EUR) { origin case_input; }
        assert "ct02-06": nb_majorations_pleines(entity_ref("urn:fr:pf-af:foreign:catala-02"), 0) { origin case_input; }
        assert "ct02-07": nb_majorations_demi(entity_ref("urn:fr:pf-af:foreign:catala-02"), 0) { origin case_input; }
        assert "ct02-08": forfait_total_menage(entity_ref("urn:fr:pf-af:foreign:catala-02"), 0 EUR) { origin case_input; }
        assert "ct02-09": nb_enfants_ase_service(entity_ref("urn:fr:pf-af:foreign:catala-02"), 0) { origin case_input; }
        assert "ct02-10": foyer_du_cas(entity_ref("urn:fr:pf-af:foreign:catala-02")) { origin case_input; }
        assert "ct02-11": mois_droit(@2020-05-01) { origin case_input; }
        assert "ct02-12": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-af:foreign:catala-02"), entity_ref("urn:fr:pf-af:foreign:catala-02-e1")) { origin case_input; }
        assert "ct02-13": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-af:foreign:catala-02"), entity_ref("urn:fr:pf-af:foreign:catala-02-e2")) { origin case_input; }
        assert "ct02-14": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-af:foreign:catala-02"), entity_ref("urn:fr:pf-af:foreign:catala-02-e5")) { origin case_input; }
        assert "ct02-15": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-af:foreign:catala-02-e1")) { origin case_input; }
        assert "ct02-16": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-af:foreign:catala-02-e2")) { origin case_input; }
        assert "ct02-17": date_naissance(entity_ref("urn:fr:pf-af:foreign:catala-02-e1"), @2007-01-01) { origin case_input; }
        assert "ct02-18": date_naissance(entity_ref("urn:fr:pf-af:foreign:catala-02-e2"), @2009-01-01) { origin case_input; }
        assert "ct02-19": enfant_du_cas(entity_ref("urn:fr:pf-af:foreign:catala-02-e1")) { origin case_input; }
        assert "ct02-20": enfant_du_cas(entity_ref("urn:fr:pf-af:foreign:catala-02-e2")) { origin case_input; }
        assert "ct02-21": enfant_du_cas(entity_ref("urn:fr:pf-af:foreign:catala-02-e5")) { origin case_input; }
        assert "ct02-22": garde(entity_ref("urn:fr:pf-af:foreign:catala-02-e1"), CHARGE_EFFECTIVE_PERMANENTE) { origin case_input; }
        assert "ct02-23": garde(entity_ref("urn:fr:pf-af:foreign:catala-02-e2"), CHARGE_EFFECTIVE_PERMANENTE) { origin case_input; }
        assert "ct02-24": date_limite_age_atteinte(entity_ref("urn:fr:pf-af:foreign:catala-02-e5"), @2020-01-01) { origin case_input; }
        assert "ct02-25": conditions_hormis_age(entity_ref("urn:fr:pf-af:foreign:catala-02-e5")) { origin case_input; }
    }
    evaluate truth(montant_mensuel_af(entity_ref("urn:fr:pf-af:foreign:catala-02"), 128.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(forfait_ouvert(entity_ref("urn:fr:pf-af:foreign:catala-02-e5")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
