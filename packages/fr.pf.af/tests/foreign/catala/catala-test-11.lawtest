// D-81 (08.10.2026): вход facteur_revalorisation(1.0) заменён плафонами-входами
// D. 521-3: база I 55950, база II 78300, надбавка 5595 за ребёнка =
// суммы D. 521-3 I/II × 1.0 — заявленные иллюстративные суммы, не опубликованные
// DSS на дату дела. (база + надбавка × n) × F = база·F + надбавка·F × n — ожидания
// не меняются.
// Catala AF Test11 (2021-12-31, Metropole, resources 30 000):
// three children (2003, 2013, 2007), all full custody. The eldest
// (18) is included by the three-or-more rule (L. 521-3 al. 2) and
// the 14-year-old non-eldest opens too: 292.00 + 128.00 = 420.00.
// Their case -> our answer -> class: REPORT.md (Catala, 11).
language "law.core" version "0.2";
package fr.pf.af version "0.1.0";
namespace "urn:fr:corpus:clir:pf-af";

test "urn:query:fr-pf-af-catala-test-11" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2021-12-31T12:00:00Z; knowledge_time @2021-12-31T12:00:00Z; legal_time @2021-12-31; timezone "Europe/Paris"; }
        assert "ct11-01": territoire(entity_ref("urn:fr:pf-af:foreign:catala-11"), METROPOLE) { origin case_input; }
        assert "ct11-02": nb_enfants_charge(entity_ref("urn:fr:pf-af:foreign:catala-11"), 3) { origin case_input; }
        assert "ct11-03": ressources_menage(entity_ref("urn:fr:pf-af:foreign:catala-11"), 30000 EUR) { origin case_input; }
        assert "ct11-04": plafond_base_tranche1_publie(entity_ref("urn:fr:pf-af:foreign:catala-11"), 55950 EUR) { origin case_input; }
        assert "ct11-04b": plafond_base_tranche2_publie(entity_ref("urn:fr:pf-af:foreign:catala-11"), 78300 EUR) { origin case_input; }
        assert "ct11-04c": majoration_plafond_enfant_publiee(entity_ref("urn:fr:pf-af:foreign:catala-11"), 5595 EUR) { origin case_input; }
        assert "ct11-05": bmaf_retenu(entity_ref("urn:fr:pf-af:foreign:catala-11"), 400.00 EUR) { origin case_input; }
        assert "ct11-06": nb_majorations_pleines(entity_ref("urn:fr:pf-af:foreign:catala-11"), 2) { origin case_input; }
        assert "ct11-07": nb_majorations_demi(entity_ref("urn:fr:pf-af:foreign:catala-11"), 0) { origin case_input; }
        assert "ct11-08": forfait_total_menage(entity_ref("urn:fr:pf-af:foreign:catala-11"), 0 EUR) { origin case_input; }
        assert "ct11-09": nb_enfants_ase_service(entity_ref("urn:fr:pf-af:foreign:catala-11"), 0) { origin case_input; }
        assert "ct11-10": foyer_du_cas(entity_ref("urn:fr:pf-af:foreign:catala-11")) { origin case_input; }
        assert "ct11-11": mois_droit(@2021-12-31) { origin case_input; }
        assert "ct11-12": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-af:foreign:catala-11"), entity_ref("urn:fr:pf-af:foreign:catala-11-e0")) { origin case_input; }
        assert "ct11-13": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-af:foreign:catala-11"), entity_ref("urn:fr:pf-af:foreign:catala-11-e1")) { origin case_input; }
        assert "ct11-14": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-af:foreign:catala-11"), entity_ref("urn:fr:pf-af:foreign:catala-11-e2")) { origin case_input; }
        assert "ct11-15": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-af:foreign:catala-11-e0")) { origin case_input; }
        assert "ct11-16": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-af:foreign:catala-11-e1")) { origin case_input; }
        assert "ct11-17": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-af:foreign:catala-11-e2")) { origin case_input; }
        assert "ct11-18": date_naissance(entity_ref("urn:fr:pf-af:foreign:catala-11-e0"), @2003-02-22) { origin case_input; }
        assert "ct11-19": date_naissance(entity_ref("urn:fr:pf-af:foreign:catala-11-e1"), @2013-09-30) { origin case_input; }
        assert "ct11-20": date_naissance(entity_ref("urn:fr:pf-af:foreign:catala-11-e2"), @2007-04-16) { origin case_input; }
        assert "ct11-21": enfant_du_cas(entity_ref("urn:fr:pf-af:foreign:catala-11-e0")) { origin case_input; }
        assert "ct11-22": enfant_du_cas(entity_ref("urn:fr:pf-af:foreign:catala-11-e1")) { origin case_input; }
        assert "ct11-23": enfant_du_cas(entity_ref("urn:fr:pf-af:foreign:catala-11-e2")) { origin case_input; }
        assert "ct11-24": garde(entity_ref("urn:fr:pf-af:foreign:catala-11-e0"), CHARGE_EFFECTIVE_PERMANENTE) { origin case_input; }
        assert "ct11-25": garde(entity_ref("urn:fr:pf-af:foreign:catala-11-e1"), CHARGE_EFFECTIVE_PERMANENTE) { origin case_input; }
        assert "ct11-26": garde(entity_ref("urn:fr:pf-af:foreign:catala-11-e2"), CHARGE_EFFECTIVE_PERMANENTE) { origin case_input; }
    }
    evaluate truth(majoration_eligible(entity_ref("urn:fr:pf-af:foreign:catala-11-e0")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(majoration_eligible(entity_ref("urn:fr:pf-af:foreign:catala-11-e2")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(af_montant_du(entity_ref("urn:fr:pf-af:foreign:catala-11"), 420.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
