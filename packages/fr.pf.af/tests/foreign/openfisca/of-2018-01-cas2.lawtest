// D-81 (08.10.2026): вход facteur_revalorisation(1.0) заменён плафонами-входами
// D. 521-3: база I 55950, база II 78300, надбавка 5595 за ребёнка =
// суммы D. 521-3 I/II × 1.0 — заявленные иллюстративные суммы, не опубликованные
// DSS на дату дела. (база + надбавка × n) × F = база·F + надбавка·F × n — ожидания
// не меняются.
// OpenFisca AF 2018-01 Cas 2: three children under 14 (12, 10, 7),
// salaries 40 000 + 20 000 (fund-established 60 000 here,
// B-PFAF-COMPTAGE/ABATTEMENTS). Band 1, no supplement:
// 0.32 + 0.41 = 0.73 x 400 = 292.00.
// Their case -> our answer -> class: REPORT.md (OpenFisca, 2).
language "law.core" version "0.2";
package fr.pf.af version "0.1.0";
namespace "urn:fr:corpus:clir:pf-af";

test "urn:query:fr-pf-af-of-2018-01-cas2" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2018-01-15T12:00:00Z; knowledge_time @2018-01-15T12:00:00Z; legal_time @2018-01-15; timezone "Europe/Paris"; }
        assert "of1801-01": territoire(entity_ref("urn:fr:pf-af:foreign:of-2018-01"), METROPOLE) { origin case_input; }
        assert "of1801-02": nb_enfants_charge(entity_ref("urn:fr:pf-af:foreign:of-2018-01"), 3) { origin case_input; }
        assert "of1801-03": ressources_menage(entity_ref("urn:fr:pf-af:foreign:of-2018-01"), 60000 EUR) { origin case_input; }
        assert "of1801-04": plafond_base_tranche1_publie(entity_ref("urn:fr:pf-af:foreign:of-2018-01"), 55950 EUR) { origin case_input; }
        assert "of1801-04b": plafond_base_tranche2_publie(entity_ref("urn:fr:pf-af:foreign:of-2018-01"), 78300 EUR) { origin case_input; }
        assert "of1801-04c": majoration_plafond_enfant_publiee(entity_ref("urn:fr:pf-af:foreign:of-2018-01"), 5595 EUR) { origin case_input; }
        assert "of1801-05": bmaf_retenu(entity_ref("urn:fr:pf-af:foreign:of-2018-01"), 400.00 EUR) { origin case_input; }
        assert "of1801-06": nb_majorations_pleines(entity_ref("urn:fr:pf-af:foreign:of-2018-01"), 0) { origin case_input; }
        assert "of1801-07": nb_majorations_demi(entity_ref("urn:fr:pf-af:foreign:of-2018-01"), 0) { origin case_input; }
        assert "of1801-08": forfait_total_menage(entity_ref("urn:fr:pf-af:foreign:of-2018-01"), 0 EUR) { origin case_input; }
        assert "of1801-09": nb_enfants_ase_service(entity_ref("urn:fr:pf-af:foreign:of-2018-01"), 0) { origin case_input; }
        assert "of1801-10": foyer_du_cas(entity_ref("urn:fr:pf-af:foreign:of-2018-01")) { origin case_input; }
        assert "of1801-11": mois_droit(@2018-01-01) { origin case_input; }
        assert "of1801-12": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-af:foreign:of-2018-01"), entity_ref("urn:fr:pf-af:foreign:of-2018-01-e1")) { origin case_input; }
        assert "of1801-13": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-af:foreign:of-2018-01"), entity_ref("urn:fr:pf-af:foreign:of-2018-01-e2")) { origin case_input; }
        assert "of1801-14": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-af:foreign:of-2018-01"), entity_ref("urn:fr:pf-af:foreign:of-2018-01-e3")) { origin case_input; }
        assert "of1801-15": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-af:foreign:of-2018-01-e1")) { origin case_input; }
        assert "of1801-16": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-af:foreign:of-2018-01-e2")) { origin case_input; }
        assert "of1801-17": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-af:foreign:of-2018-01-e3")) { origin case_input; }
        assert "of1801-18": date_naissance(entity_ref("urn:fr:pf-af:foreign:of-2018-01-e1"), @2006-01-01) { origin case_input; }
        assert "of1801-19": date_naissance(entity_ref("urn:fr:pf-af:foreign:of-2018-01-e2"), @2008-01-01) { origin case_input; }
        assert "of1801-20": date_naissance(entity_ref("urn:fr:pf-af:foreign:of-2018-01-e3"), @2011-01-01) { origin case_input; }
        assert "of1801-21": enfant_du_cas(entity_ref("urn:fr:pf-af:foreign:of-2018-01-e1")) { origin case_input; }
        assert "of1801-22": enfant_du_cas(entity_ref("urn:fr:pf-af:foreign:of-2018-01-e2")) { origin case_input; }
        assert "of1801-23": enfant_du_cas(entity_ref("urn:fr:pf-af:foreign:of-2018-01-e3")) { origin case_input; }
        assert "of1801-24": garde(entity_ref("urn:fr:pf-af:foreign:of-2018-01-e1"), CHARGE_EFFECTIVE_PERMANENTE) { origin case_input; }
        assert "of1801-25": garde(entity_ref("urn:fr:pf-af:foreign:of-2018-01-e2"), CHARGE_EFFECTIVE_PERMANENTE) { origin case_input; }
        assert "of1801-26": garde(entity_ref("urn:fr:pf-af:foreign:of-2018-01-e3"), CHARGE_EFFECTIVE_PERMANENTE) { origin case_input; }
    }
    evaluate truth(bande_ressources(entity_ref("urn:fr:pf-af:foreign:of-2018-01"), BANDE_1));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(af_montant_du(entity_ref("urn:fr:pf-af:foreign:of-2018-01"), 292.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
