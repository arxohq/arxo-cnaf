// D-81 (08.10.2026): вход facteur_revalorisation(1.0) заменён плафонами-входами
// D. 521-3: база I 55950, база II 78300, надбавка 5595 за ребёнка =
// суммы D. 521-3 I/II × 1.0 — заявленные иллюстративные суммы, не опубликованные
// DSS на дату дела. (база + надбавка × n) × F = база·F + надбавка·F × n — ожидания
// не меняются.
// Eldest exclusion with two children: the eldest (2005) is
// age-qualified but gets nothing (L. 521-3 al. 1, under three);
// the younger (2015) has not reached the age: nothing either.
language "law.core" version "0.2";
package fr.pf.af version "0.1.0";
namespace "urn:fr:corpus:clir:pf-af";

test "urn:query:fr-pf-af-majoration-aine-exclu" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2023-06-15T12:00:00Z; knowledge_time @2023-06-15T12:00:00Z; legal_time @2023-06-15; timezone "Europe/Paris"; }
        assert "maine-01": territoire(entity_ref("urn:fr:pf-af:case:majoration-aine-exclu"), METROPOLE) { origin case_input; }
        assert "maine-02": nb_enfants_charge(entity_ref("urn:fr:pf-af:case:majoration-aine-exclu"), 2) { origin case_input; }
        assert "maine-03": ressources_menage(entity_ref("urn:fr:pf-af:case:majoration-aine-exclu"), 30000 EUR) { origin case_input; }
        assert "maine-04": plafond_base_tranche1_publie(entity_ref("urn:fr:pf-af:case:majoration-aine-exclu"), 55950 EUR) { origin case_input; }
        assert "maine-04b": plafond_base_tranche2_publie(entity_ref("urn:fr:pf-af:case:majoration-aine-exclu"), 78300 EUR) { origin case_input; }
        assert "maine-04c": majoration_plafond_enfant_publiee(entity_ref("urn:fr:pf-af:case:majoration-aine-exclu"), 5595 EUR) { origin case_input; }
        assert "maine-05": bmaf_retenu(entity_ref("urn:fr:pf-af:case:majoration-aine-exclu"), 400.00 EUR) { origin case_input; }
        assert "maine-06": nb_majorations_pleines(entity_ref("urn:fr:pf-af:case:majoration-aine-exclu"), 0) { origin case_input; }
        assert "maine-07": nb_majorations_demi(entity_ref("urn:fr:pf-af:case:majoration-aine-exclu"), 0) { origin case_input; }
        assert "maine-08": forfait_total_menage(entity_ref("urn:fr:pf-af:case:majoration-aine-exclu"), 0 EUR) { origin case_input; }
        assert "maine-09": nb_enfants_ase_service(entity_ref("urn:fr:pf-af:case:majoration-aine-exclu"), 0) { origin case_input; }
        assert "maine-10": foyer_du_cas(entity_ref("urn:fr:pf-af:case:majoration-aine-exclu")) { origin case_input; }
        assert "maine-11": mois_droit(@2023-06-01) { origin case_input; }
        assert "maine-12": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-af:case:majoration-aine-exclu"), entity_ref("urn:fr:pf-af:child:aine-x")) { origin case_input; }
        assert "maine-13": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-af:case:majoration-aine-exclu"), entity_ref("urn:fr:pf-af:child:cadet-x")) { origin case_input; }
        assert "maine-14": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-af:child:aine-x")) { origin case_input; }
        assert "maine-15": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-af:child:cadet-x")) { origin case_input; }
        assert "maine-16": date_naissance(entity_ref("urn:fr:pf-af:child:aine-x"), @2005-04-01) { origin case_input; }
        assert "maine-17": date_naissance(entity_ref("urn:fr:pf-af:child:cadet-x"), @2015-09-01) { origin case_input; }
        assert "maine-18": enfant_du_cas(entity_ref("urn:fr:pf-af:child:aine-x")) { origin case_input; }
        assert "maine-19": enfant_du_cas(entity_ref("urn:fr:pf-af:child:cadet-x")) { origin case_input; }
        assert "maine-20": garde(entity_ref("urn:fr:pf-af:child:aine-x"), CHARGE_EFFECTIVE_PERMANENTE) { origin case_input; }
        assert "maine-21": garde(entity_ref("urn:fr:pf-af:child:cadet-x"), CHARGE_EFFECTIVE_PERMANENTE) { origin case_input; }
    }
    evaluate truth(montant_majoration(entity_ref("urn:fr:pf-af:child:aine-x"), 0 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(montant_majoration(entity_ref("urn:fr:pf-af:child:cadet-x"), 0 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
