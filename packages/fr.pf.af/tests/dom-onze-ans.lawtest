// Single dependent child aged eleven who is not the eldest
// (D. 755-5, II): the elder sibling (22, no right opened) keeps the
// younger from being the eldest (Q-PFAF-1). Base 1 000.00 EUR stated
// assumption: 58.80 + 3.69% x 1 000 = 36.90, total due 95.70.
language "law.core" version "0.2";
package fr.pf.af version "0.1.0";
namespace "urn:fr:corpus:clir:pf-af";

test "urn:query:fr-pf-af-dom-onze-ans" {
    given {
        context { deadline_policy DOM_AGE_ATTEINT; decision_time @2023-06-15T12:00:00Z; knowledge_time @2023-06-15T12:00:00Z; legal_time @2023-06-15; timezone "Europe/Paris"; }
        assert "dom11-01": territoire(entity_ref("urn:fr:pf-af:case:dom-onze-ans"), GUYANE) { origin case_input; }
        assert "dom11-02": nb_enfants_charge(entity_ref("urn:fr:pf-af:case:dom-onze-ans"), 1) { origin case_input; }
        assert "dom11-03": base_dom_retenue(entity_ref("urn:fr:pf-af:case:dom-onze-ans"), 1000.00 EUR) { origin case_input; }
        assert "dom11-04": forfait_total_menage(entity_ref("urn:fr:pf-af:case:dom-onze-ans"), 0 EUR) { origin case_input; }
        assert "dom11-05": foyer_du_cas(entity_ref("urn:fr:pf-af:case:dom-onze-ans")) { origin case_input; }
        assert "dom11-06": mois_droit(@2023-06-01) { origin case_input; }
        assert "dom11-07": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-af:case:dom-onze-ans"), entity_ref("urn:fr:pf-af:child:grand-gy")) { origin case_input; }
        assert "dom11-08": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-af:case:dom-onze-ans"), entity_ref("urn:fr:pf-af:child:petit-gy")) { origin case_input; }
        assert "dom11-09": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-af:child:petit-gy")) { origin case_input; }
        assert "dom11-10": date_naissance(entity_ref("urn:fr:pf-af:child:grand-gy"), @2001-04-01) { origin case_input; }
        assert "dom11-11": date_naissance(entity_ref("urn:fr:pf-af:child:petit-gy"), @2011-03-01) { origin case_input; }
        assert "dom11-12": enfant_du_cas(entity_ref("urn:fr:pf-af:child:grand-gy")) { origin case_input; }
        assert "dom11-13": enfant_du_cas(entity_ref("urn:fr:pf-af:child:petit-gy")) { origin case_input; }
    }
    evaluate truth(montant_majoration(entity_ref("urn:fr:pf-af:child:petit-gy"), 36.90 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(af_montant_du(entity_ref("urn:fr:pf-af:case:dom-onze-ans"), 95.70 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
