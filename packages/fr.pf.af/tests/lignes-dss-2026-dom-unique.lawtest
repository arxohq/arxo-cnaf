// Прочтение D-83 выбрано в context (`interpretation ArrondiLignesDss;`): суммы AF — округлённые
// строки таблицы DSS, итог — их сумма (08-lecture-arrondi-lignes.law). Ожидания — строки
// закреплённой таблицы DSS/2B/2026/46 (revalorisation/sources/dss-2026-46.txt), раздел I.4 (Guadeloupe, Guyane,
// Martinique, La Réunion …, один ребёнок): «Allocations familiales pour un enfant 5,88 % 28,12» (:233) от BMAF
// 478,16 € (база L. 755-3 дела — та же сумма). Единственный ребёнок пяти лет — старший: надбавки нет. Итог 28,12;
// без прочтения — точное 0,0588 × 478,16 = 28,115808 и итог 28,12 после округления суммы.
language "law.core" version "0.2";
package fr.pf.af version "0.1.0";
namespace "urn:fr:corpus:clir:pf-af";

test "urn:query:fr-pf-af-lignes-dss-2026-dom-unique" {
    given {
        context { decision_time @2026-04-15T12:00:00Z; knowledge_time @2026-04-15T12:00:00Z; legal_time @2026-04-15; timezone "Europe/Paris"; interpretation ArrondiLignesDss; }
        assert "l83-01": territoire(entity_ref("urn:fr:pf-af:case:lignes-dss-2026-dom-unique"), GUYANE) { origin case_input; }
        assert "l83-02": nb_enfants_charge(entity_ref("urn:fr:pf-af:case:lignes-dss-2026-dom-unique"), 1) { origin case_input; }
        assert "l83-03": base_dom_retenue(entity_ref("urn:fr:pf-af:case:lignes-dss-2026-dom-unique"), 478.16 EUR) { origin case_input; }
        assert "l83-04": forfait_total_menage(entity_ref("urn:fr:pf-af:case:lignes-dss-2026-dom-unique"), 0 EUR) { origin case_input; }
        assert "l83-05": foyer_du_cas(entity_ref("urn:fr:pf-af:case:lignes-dss-2026-dom-unique")) { origin case_input; }
        assert "l83-06": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-af:case:lignes-dss-2026-dom-unique"), entity_ref("urn:fr:pf-af:child:unique-l83")) { origin case_input; }
        assert "l83-07": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-af:child:unique-l83")) { origin case_input; }
        assert "l83-08": date_naissance(entity_ref("urn:fr:pf-af:child:unique-l83"), @2021-03-01) { origin case_input; }
        assert "l83-09": enfant_du_cas(entity_ref("urn:fr:pf-af:child:unique-l83")) { origin case_input; }
    }
    evaluate truth(montant_mensuel_af_dom(entity_ref("urn:fr:pf-af:case:lignes-dss-2026-dom-unique"), 28.12 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(montant_majoration(entity_ref("urn:fr:pf-af:child:unique-l83"), 0 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(af_montant_du(entity_ref("urn:fr:pf-af:case:lignes-dss-2026-dom-unique"), 28.12 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
