// D-81 (08.10.2026): вход facteur_revalorisation(1.0) заменён плафонами-входами
// D. 521-3: база I 55950, база II 78300, надбавка 5595 за ребёнка =
// суммы D. 521-3 I/II × 1.0 — заявленные иллюстративные суммы, не опубликованные
// DSS на дату дела. (база + надбавка × n) × F = база·F + надбавка·F × n — ожидания
// не меняются.
// Three children, two young non-eldest supplements at full rate (band 1).
// BMAF 400.00 EUR is a stated illustrative assumption (arrete unpinned,
// B-PFAF-BMAF-EURO); counts are fund-established (B-PFAF-COMPTAGE).
language "law.core" version "0.2";
package fr.pf.af version "0.1.0";
namespace "urn:fr:corpus:clir:pf-af";

test "urn:query:fr-pf-af-majoration-trois-enfants" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2023-06-15T12:00:00Z; knowledge_time @2023-06-15T12:00:00Z; legal_time @2023-06-15; timezone "Europe/Paris"; }
        assert "majo-3-01": territoire(entity_ref("urn:fr:pf-af:case:majoration-trois-enfants"), METROPOLE) { origin case_input; }
        assert "majo-3-02": nb_enfants_charge(entity_ref("urn:fr:pf-af:case:majoration-trois-enfants"), 3) { origin case_input; }
        assert "majo-3-03": ressources_menage(entity_ref("urn:fr:pf-af:case:majoration-trois-enfants"), 30000 EUR) { origin case_input; }
        assert "majo-3-04": plafond_base_tranche1_publie(entity_ref("urn:fr:pf-af:case:majoration-trois-enfants"), 55950 EUR) { origin case_input; }
        assert "majo-3-04b": plafond_base_tranche2_publie(entity_ref("urn:fr:pf-af:case:majoration-trois-enfants"), 78300 EUR) { origin case_input; }
        assert "majo-3-04c": majoration_plafond_enfant_publiee(entity_ref("urn:fr:pf-af:case:majoration-trois-enfants"), 5595 EUR) { origin case_input; }
        assert "majo-3-05": bmaf_retenu(entity_ref("urn:fr:pf-af:case:majoration-trois-enfants"), 400.00 EUR) { origin case_input; }
        assert "majo-3-06": nb_majorations_pleines(entity_ref("urn:fr:pf-af:case:majoration-trois-enfants"), 2) { origin case_input; }
        assert "majo-3-07": nb_majorations_demi(entity_ref("urn:fr:pf-af:case:majoration-trois-enfants"), 0) { origin case_input; }
        assert "majo-3-08": forfait_total_menage(entity_ref("urn:fr:pf-af:case:majoration-trois-enfants"), 0 EUR) { origin case_input; }
        assert "majo-3-09": nb_enfants_ase_service(entity_ref("urn:fr:pf-af:case:majoration-trois-enfants"), 0) { origin case_input; }
        assert "majo-3-10": foyer_du_cas(entity_ref("urn:fr:pf-af:case:majoration-trois-enfants")) { origin case_input; }
        assert "majo-3-11": mois_droit(@2023-06-01) { origin case_input; }
        assert "majo-3-12": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-af:case:majoration-trois-enfants"), entity_ref("urn:fr:pf-af:child:aine")) { origin case_input; }
        assert "majo-3-13": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-af:case:majoration-trois-enfants"), entity_ref("urn:fr:pf-af:child:cadet-1")) { origin case_input; }
        assert "majo-3-14": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-af:case:majoration-trois-enfants"), entity_ref("urn:fr:pf-af:child:cadet-2")) { origin case_input; }
        assert "majo-3-15": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-af:child:aine")) { origin case_input; }
        assert "majo-3-16": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-af:child:cadet-1")) { origin case_input; }
        assert "majo-3-17": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-af:child:cadet-2")) { origin case_input; }
        assert "majo-3-18": date_naissance(entity_ref("urn:fr:pf-af:child:aine"), @2005-04-01) { origin case_input; }
        assert "majo-3-19": date_naissance(entity_ref("urn:fr:pf-af:child:cadet-1"), @2008-07-01) { origin case_input; }
        assert "majo-3-20": date_naissance(entity_ref("urn:fr:pf-af:child:cadet-2"), @2010-02-01) { origin case_input; }
        assert "majo-3-21": enfant_du_cas(entity_ref("urn:fr:pf-af:child:aine")) { origin case_input; }
        assert "majo-3-22": enfant_du_cas(entity_ref("urn:fr:pf-af:child:cadet-1")) { origin case_input; }
        assert "majo-3-23": enfant_du_cas(entity_ref("urn:fr:pf-af:child:cadet-2")) { origin case_input; }
        assert "majo-3-24": garde(entity_ref("urn:fr:pf-af:child:aine"), CHARGE_EFFECTIVE_PERMANENTE) { origin case_input; }
        assert "majo-3-25": garde(entity_ref("urn:fr:pf-af:child:cadet-1"), CHARGE_EFFECTIVE_PERMANENTE) { origin case_input; }
        assert "majo-3-26": garde(entity_ref("urn:fr:pf-af:child:cadet-2"), CHARGE_EFFECTIVE_PERMANENTE) { origin case_input; }
    }
    evaluate truth(majoration_eligible(entity_ref("urn:fr:pf-af:child:cadet-1")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(montant_majoration(entity_ref("urn:fr:pf-af:child:cadet-1"), 64.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(montant_majoration(entity_ref("urn:fr:pf-af:child:aine"), 64.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
