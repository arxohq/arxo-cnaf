// D-81 (08.10.2026): вход facteur_revalorisation(1.0) заменён плафонами-входами
// D. 521-3: база I 55950, база II 78300, надбавка 5595 за ребёнка =
// суммы D. 521-3 I/II × 1.0 — заявленные иллюстративные суммы, не опубликованные
// DSS на дату дела. (база + надбавка × n) × F = база·F + надбавка·F × n — ожидания
// не меняются.
// No forfait with two children: the three-child minimum of
// D. 521-2, III fails. Monthly amount 0.
language "law.core" version "0.2";
package fr.pf.af version "0.1.0";
namespace "urn:fr:corpus:clir:pf-af";

test "urn:query:fr-pf-af-forfait-petit-foyer" {
    given {
        context { deadline_policy FORFAIT_UN_AN; decision_time @2023-06-15T12:00:00Z; knowledge_time @2023-06-15T12:00:00Z; legal_time @2023-06-15; timezone "Europe/Paris"; }
        assert "forfp-01": territoire(entity_ref("urn:fr:pf-af:case:forfait-petit-foyer"), METROPOLE) { origin case_input; }
        assert "forfp-02": nb_enfants_charge(entity_ref("urn:fr:pf-af:case:forfait-petit-foyer"), 2) { origin case_input; }
        assert "forfp-02f": nb_enfants_charge_forfait(entity_ref("urn:fr:pf-af:case:forfait-petit-foyer"), 2) { origin case_input; }
        assert "forfp-03": ressources_menage(entity_ref("urn:fr:pf-af:case:forfait-petit-foyer"), 30000 EUR) { origin case_input; }
        assert "forfp-04": plafond_base_tranche1_publie(entity_ref("urn:fr:pf-af:case:forfait-petit-foyer"), 55950 EUR) { origin case_input; }
        assert "forfp-04b": plafond_base_tranche2_publie(entity_ref("urn:fr:pf-af:case:forfait-petit-foyer"), 78300 EUR) { origin case_input; }
        assert "forfp-04c": majoration_plafond_enfant_publiee(entity_ref("urn:fr:pf-af:case:forfait-petit-foyer"), 5595 EUR) { origin case_input; }
        assert "forfp-05": bmaf_retenu(entity_ref("urn:fr:pf-af:case:forfait-petit-foyer"), 1000.00 EUR) { origin case_input; }
        assert "forfp-06": nb_majorations_pleines(entity_ref("urn:fr:pf-af:case:forfait-petit-foyer"), 0) { origin case_input; }
        assert "forfp-07": nb_majorations_demi(entity_ref("urn:fr:pf-af:case:forfait-petit-foyer"), 0) { origin case_input; }
        assert "forfp-08": forfait_total_menage(entity_ref("urn:fr:pf-af:case:forfait-petit-foyer"), 0 EUR) { origin case_input; }
        assert "forfp-09": nb_enfants_ase_service(entity_ref("urn:fr:pf-af:case:forfait-petit-foyer"), 0) { origin case_input; }
        assert "forfp-10": foyer_du_cas(entity_ref("urn:fr:pf-af:case:forfait-petit-foyer")) { origin case_input; }
        assert "forfp-11": mois_droit(@2023-06-01) { origin case_input; }
        assert "forfp-12": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-af:case:forfait-petit-foyer"), entity_ref("urn:fr:pf-af:child:aged-out-p")) { origin case_input; }
        assert "forfp-13": date_limite_age_atteinte(entity_ref("urn:fr:pf-af:child:aged-out-p"), @2022-06-15) { origin case_input; }
    }
    evaluate truth(montant_forfait(entity_ref("urn:fr:pf-af:child:aged-out-p"), 0 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
