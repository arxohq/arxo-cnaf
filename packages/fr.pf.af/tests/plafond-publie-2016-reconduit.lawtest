// D-81: 2016 — суммы 2017, перенесённые без изменения: инструкция DSS/SD2B/2016/396
// (фрагмент DSS_SD2B_2016_396_REVAL пакета fr.css.revalorisation: суммы периода
// 01.01–31.12.2016 «reconduits à l'identique» на 2017); суммы 2017 — фрагмент
// DSS_SD2B_2016_396_PLAFOND_AF: база 56 174 / 78 613 €, надбавка 5 617 €.
// Три ребёнка: I = 56 174 + 3 × 5 617 = 73 025 (строка таблицы «3 enfants ≤ 73 025»),
// II = 78 613 + 3 × 5 617 = 95 464. Ресурсы ровно 73 025 — полоса 1.
language "law.core" version "0.2";
package fr.pf.af version "0.1.0";
namespace "urn:fr:corpus:clir:pf-af";

test "urn:query:fr-pf-af-plafond-publie-2016-reconduit" {
    given {
        context { decision_time @2016-06-15T12:00:00Z; knowledge_time @2016-06-15T12:00:00Z; legal_time @2016-06-15; timezone "Europe/Paris"; }
        assert "pp16-01": territoire(entity_ref("urn:fr:pf-af:case:plafond-publie-2016-reconduit"), METROPOLE) { origin case_input; }
        assert "pp16-02": nb_enfants_charge(entity_ref("urn:fr:pf-af:case:plafond-publie-2016-reconduit"), 3) { origin case_input; }
        assert "pp16-03": ressources_menage(entity_ref("urn:fr:pf-af:case:plafond-publie-2016-reconduit"), 73025 EUR) { origin case_input; }
        assert "pp16-04": plafond_base_tranche1_publie(entity_ref("urn:fr:pf-af:case:plafond-publie-2016-reconduit"), 56174 EUR) { origin case_input; }
        assert "pp16-05": plafond_base_tranche2_publie(entity_ref("urn:fr:pf-af:case:plafond-publie-2016-reconduit"), 78613 EUR) { origin case_input; }
        assert "pp16-06": majoration_plafond_enfant_publiee(entity_ref("urn:fr:pf-af:case:plafond-publie-2016-reconduit"), 5617 EUR) { origin case_input; }
        assert "pp16-07": foyer_du_cas(entity_ref("urn:fr:pf-af:case:plafond-publie-2016-reconduit")) { origin case_input; }
    }
    evaluate truth(plafond1_applicable(entity_ref("urn:fr:pf-af:case:plafond-publie-2016-reconduit"), 73025 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(plafond2_applicable(entity_ref("urn:fr:pf-af:case:plafond-publie-2016-reconduit"), 95464 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(bande_ressources(entity_ref("urn:fr:pf-af:case:plafond-publie-2016-reconduit"), BANDE_1));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
