// Границы окон по МЕСЯЦУ: первый и последний месяц каждого окна; окно ст. 9 закона 2022-1158 (чтение D-82).
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

// 2021-03-01: forfait_base_du_mois = 553.16 EUR
test "urn:query:fr-ppa-forfait-bord-2021-03-01" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2027-02-15T12:00:00Z; knowledge_time @2027-02-15T12:00:00Z; legal_time @2027-02-15; timezone "Europe/Paris"; }
        assert "forfait-bord-2021-03-01-01": forme_foyer_retenue(entity_ref("urn:fr:ppa:case:forfait-bord-2021-03-01"), @2021-03-01, SEUL) { origin case_input; }
    }
    evaluate truth(forfait_base_du_mois(@2021-03-01, 553.16 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

