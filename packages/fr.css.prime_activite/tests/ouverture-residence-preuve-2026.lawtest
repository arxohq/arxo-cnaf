// Residence proof branches (PA-R4-04): permanent residence holds
// on its own; a complete classified history without excess holds;
// bare durations without permanence or history stay undetermined;
// a classified 5-month non-insertion stay is established, while
// residence stays undetermined without permanence evidence (R.842-1).
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

test "urn:query:fr-ppa-ouverture-residence-preuve-2026" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; }
        assert "ppa-01": residence_permanente_france(entity_ref("urn:fr:ppa:case:residence-permanente")) { origin case_input; }
        assert "ppa-02": sejour_duree(entity_ref("urn:fr:ppa:case:residence-historique"), 1, 2) { origin case_input; }
        assert "ppa-03": sejour_hors_insertion(entity_ref("urn:fr:ppa:case:residence-historique"), 1) { origin case_input; }
        assert "ppa-04": duree_totale_etrangere_annee(entity_ref("urn:fr:ppa:case:residence-historique"), 2026, 2) { origin case_input; }
        assert "ppa-05": historique_sejours_complet(entity_ref("urn:fr:ppa:case:residence-historique")) { origin case_input; }
        assert "ppa-06": sejour_duree(entity_ref("urn:fr:ppa:case:residence-inconnue"), 1, 2) { origin case_input; }
        assert "ppa-07": duree_totale_etrangere_annee(entity_ref("urn:fr:ppa:case:residence-inconnue"), 2026, 2) { origin case_input; }
        assert "ppa-08": sejour_duree(entity_ref("urn:fr:ppa:case:residence-depassee"), 1, 5) { origin case_input; }
        assert "ppa-09": sejour_hors_insertion(entity_ref("urn:fr:ppa:case:residence-depassee"), 1) { origin case_input; }
        assert "ppa-10": historique_sejours_complet(entity_ref("urn:fr:ppa:case:residence-depassee")) { origin case_input; }
    }
    evaluate truth(residence_r842_1(entity_ref("urn:fr:ppa:case:residence-permanente")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(residence_r842_1(entity_ref("urn:fr:ppa:case:residence-historique")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(residence_r842_1(entity_ref("urn:fr:ppa:case:residence-inconnue")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(sejour_excessif(entity_ref("urn:fr:ppa:case:residence-depassee")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(residence_r842_1(entity_ref("urn:fr:ppa:case:residence-depassee")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
