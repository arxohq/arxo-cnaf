// Known post-month decision (request 06-10, rejection 07-20 >
// 07-10) on a date-certain notice, observed after II-2° maturity
// (10-15 > 09-10): the late date proves no decision within the
// month, and no earlier decision is known, so both II heads stay
// NEITHER — neither refuted nor established (R. 847-1-1 II;
// PA-FE11-01). No negative is inferred from the unknown. The
// timely request still interrupted the CRA deadline (III al. 1).
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

test "urn:query:fr-ppa-decision-tardive-2026" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-10-15T12:00:00Z; knowledge_time @2026-10-15T12:00:00Z; legal_time @2026-10-15; timezone "Europe/Paris"; }
        assert "ppa-01": reception_notification(entity_ref("urn:fr:ppa:case:decision-tardive-2026"), @2026-06-01) { origin case_input; }
        assert "ppa-02": demande_rectification(entity_ref("urn:fr:ppa:case:decision-tardive-2026"), @2026-06-10) { origin case_input; }
        assert "ppa-03": decision_rectification_rejet(entity_ref("urn:fr:ppa:case:decision-tardive-2026"), @2026-07-20) { origin case_input; }
        assert "ppa-04": date_observation_recours(entity_ref("urn:fr:ppa:case:decision-tardive-2026"), @2026-10-15) { origin case_input; }
        assert "ppa-05": notification_recouvrement(entity_ref("urn:fr:ppa:case:decision-tardive-2026"), @2026-05-20) { origin case_input; }
        assert "ppa-06": notification_moyen_date_certaine(entity_ref("urn:fr:ppa:case:decision-tardive-2026")) { origin case_input; }
    }
    evaluate truth(decision_rectification(entity_ref("urn:fr:ppa:case:decision-tardive-2026")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(rejet_implicite_rectification(entity_ref("urn:fr:ppa:case:decision-tardive-2026")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(recouvrement_apres_demande(entity_ref("urn:fr:ppa:case:decision-tardive-2026")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(interruption_delai_cra(entity_ref("urn:fr:ppa:case:decision-tardive-2026")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
