// Couple, deux revenus de 600.00 par mois (chacun sous 59 x SMIC 11.65 = 687.35: pas de bonification), aide au logement 200.00,
// révision 2024-09 (ancienne rédaction de R. 843-1: mois 2024-06..08), AUCUNE base n'est fournie: montant forfaitaire du décret 2024-403
// (622.63), couple x 1.5 = 933.945; fraction 61 % de 1200.00 = 732.0000; forfait logement 16 % x 933.945 = 149.43120
// (aide 200.00 plafonnée); ressources 1200.00 + 149.43120 = 1349.43120; prime = 933.945 + 732.0000 - 1349.43120 = 316.51380; moyenne de trois mois égaux.
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

// prime due 316.51380
