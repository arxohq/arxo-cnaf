// Seizure protection evidence (PA-R4-10): an open right with a
// positive no-maintenance-claim status is unseizable; a present
// alimentary claim affirmatively lifts the protection; without any
// claim evidence protection stays undetermined (L.845-5).
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

test "urn:query:fr-ppa-insaisissable-2026" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; }
        assert "ppa-01": droit_ouvert(entity_ref("urn:fr:ppa:case:insaisissable-ok")) { origin case_input; }
        assert "ppa-02": sans_creance_alimentaire(entity_ref("urn:fr:ppa:case:insaisissable-ok")) { origin case_input; }
        assert "ppa-03": droit_ouvert(entity_ref("urn:fr:ppa:case:insaisissable-alimentaire")) { origin case_input; }
        assert "ppa-04": creance_alimentaire_exception(entity_ref("urn:fr:ppa:case:insaisissable-alimentaire")) { origin case_input; }
        assert "ppa-05": droit_ouvert(entity_ref("urn:fr:ppa:case:insaisissable-inconnu")) { origin case_input; }
    }
    evaluate truth(insaisissable(entity_ref("urn:fr:ppa:case:insaisissable-ok")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(insaisissable(entity_ref("urn:fr:ppa:case:insaisissable-alimentaire")));
    expect result_kind == PROPOSITION;
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(insaisissable(entity_ref("urn:fr:ppa:case:insaisissable-inconnu")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
