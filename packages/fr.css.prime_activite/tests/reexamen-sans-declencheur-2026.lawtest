// No re-examination trigger on record (D. 846-1, PA-COV-02
// boundary): the serving fund is known but neither a quarterly
// due-date nor an RSA opening is established, so no review is due
// on the candidate month.
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

test "urn:query:fr-ppa-reexamen-sans-declencheur-2026" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; }
        assert "ppa-01": mois_revue(entity_ref("urn:fr:ppa:case:reexamen-sans-declencheur-2026"), @2026-06-01) { origin case_input; }
        assert "ppa-02": organisme_serviteur(entity_ref("urn:fr:ppa:org:caisse"), entity_ref("urn:fr:ppa:case:reexamen-sans-declencheur-2026")) { origin case_input; }
    }
    evaluate truth(reexamen_du(entity_ref("urn:fr:ppa:case:reexamen-sans-declencheur-2026"), @2026-06-01));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
