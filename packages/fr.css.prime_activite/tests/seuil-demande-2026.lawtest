// 15-euro non-payment floor; online request valid (D. 846-2,
// R. 846-1).
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

test "urn:query:fr-ppa-seuil-demande-2026" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; }
        assert "ppa-01": demande_teleservice(entity_ref("urn:fr:ppa:case:seuil-demande-2026"), @2026-06-05) { origin case_input; }
    }
    evaluate truth(seuil_non_versement(15.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(demande_valide(entity_ref("urn:fr:ppa:case:seuil-demande-2026"), @2026-06-05));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
