// Rectification 9 days after reception interrupts the CRA deadline
// (R. 847-1-1 II); the notice used a date-certain means, so the
// 20-day clock is anchored (PA-FE09-03).
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

test "urn:query:fr-ppa-notification-rectification-2026" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; }
        assert "ppa-01": indu_recupere(entity_ref("urn:fr:ppa:case:notification-rectification-2026"), 300.00 EUR) { origin case_input; }
        assert "ppa-02": constat_indu(entity_ref("urn:fr:ppa:case:notification-rectification-2026"), @2026-05-20) { origin case_input; }
        assert "ppa-03": organisme_serviteur(entity_ref("urn:fr:ppa:org:caisse"), entity_ref("urn:fr:ppa:case:notification-rectification-2026")) { origin case_input; }
        assert "ppa-04": notification_recouvrement(entity_ref("urn:fr:ppa:case:notification-rectification-2026"), @2026-05-20) { origin case_input; }
        assert "ppa-05": reception_notification(entity_ref("urn:fr:ppa:case:notification-rectification-2026"), @2026-06-01) { origin case_input; }
        assert "ppa-06": demande_rectification(entity_ref("urn:fr:ppa:case:notification-rectification-2026"), @2026-06-10) { origin case_input; }
        assert "ppa-07": notification_moyen_date_certaine(entity_ref("urn:fr:ppa:case:notification-rectification-2026")) { origin case_input; }
    }
    evaluate truth(interruption_delai_cra(entity_ref("urn:fr:ppa:case:notification-rectification-2026")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
