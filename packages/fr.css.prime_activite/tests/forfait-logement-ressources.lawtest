        assert "fl-total-retenu-01": revenus_mensuels_retenus(entity_ref("urn:fr:ppa:case:fl-total-retenu"), @2024-10-01, 1349.43 EUR) { origin case_input; }
    }
    evaluate truth(ressources_foyer_mois(entity_ref("urn:fr:ppa:case:fl-total-retenu"), @2024-10-01, 1349.43 EUR));
    expect result_kind == PROPOSITION;
