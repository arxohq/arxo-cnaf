// Written rectification 26 days after reception of a date-certain
// notice, CRA deadline open: deemed a prior appeal;
// inadmissibility undetermined without the CRA-deadline premise
// (R. 847-1-1 IV 1°; PA-FE09-03).
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

test "urn:query:fr-ppa-rectification-tardive-2026" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-07-15T12:00:00Z; knowledge_time @2026-07-15T12:00:00Z; legal_time @2026-07-15; timezone "Europe/Paris"; }
        assert "ppa-01": reception_notification(entity_ref("urn:fr:ppa:case:rectification-tardive-2026"), @2026-05-20) { origin case_input; }
        assert "ppa-02": demande_rectification(entity_ref("urn:fr:ppa:case:rectification-tardive-2026"), @2026-06-15) { origin case_input; }
        assert "ppa-03": demande_rectification_ecrite(entity_ref("urn:fr:ppa:case:rectification-tardive-2026")) { origin case_input; }
        assert "ppa-04": delai_recours_cra_en_cours(entity_ref("urn:fr:ppa:case:rectification-tardive-2026")) { origin case_input; }
        assert "ppa-05": notification_moyen_date_certaine(entity_ref("urn:fr:ppa:case:rectification-tardive-2026")) { origin case_input; }
    }
    evaluate truth(demande_requalifiee_recours(entity_ref("urn:fr:ppa:case:rectification-tardive-2026")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(demande_irrecevable(entity_ref("urn:fr:ppa:case:rectification-tardive-2026")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
