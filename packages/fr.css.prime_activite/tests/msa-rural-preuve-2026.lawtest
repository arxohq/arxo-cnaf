// MSA rural-branch evidence (PA-R4-07): a rural worker with a
// positive no-CAF-benefits status is MSA-served; CAF-paid family
// benefits block the rural branch without establishing the
// non-salaried one, so competence stays undetermined, as it does
// without any CAF evidence (R.846-6 2°).
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

test "urn:query:fr-ppa-msa-rural-preuve-2026" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; }
        assert "ppa-01": regime_agricole_salarie_ou_rural(entity_ref("urn:fr:ppa:case:msa-rural-ok")) { origin case_input; }
        assert "ppa-02": pf_non_versee_par_caf(entity_ref("urn:fr:ppa:case:msa-rural-ok")) { origin case_input; }
        assert "ppa-03": regime_agricole_salarie_ou_rural(entity_ref("urn:fr:ppa:case:msa-rural-caf")) { origin case_input; }
        assert "ppa-04": pf_versee_par_caf(entity_ref("urn:fr:ppa:case:msa-rural-caf")) { origin case_input; }
        assert "ppa-05": regime_agricole_salarie_ou_rural(entity_ref("urn:fr:ppa:case:msa-rural-inconnu")) { origin case_input; }
    }
    evaluate truth(organisme_competent_msa(entity_ref("urn:fr:ppa:case:msa-rural-ok")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(organisme_competent_msa(entity_ref("urn:fr:ppa:case:msa-rural-caf")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(organisme_competent_msa(entity_ref("urn:fr:ppa:case:msa-rural-inconnu")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
