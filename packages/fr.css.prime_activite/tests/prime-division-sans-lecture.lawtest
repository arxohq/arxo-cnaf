        assert "div-s3-03": smic_horaire_retenu(@2026-02-01, 12.02 EUR) { origin case_input; }
    }
    evaluate truth(bonification_mensuelle(entity_ref("urn:fr:ppa:case:div-s3"), @2026-02-01, 119.360085 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

