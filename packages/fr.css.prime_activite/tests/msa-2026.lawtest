// Non-salaried farm scheme -> MSA service (R. 846-6).
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

test "urn:query:fr-ppa-msa-2026" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; }
        assert "ppa-01": regime_agricole_non_salarie(entity_ref("urn:fr:ppa:case:msa-2026")) { origin case_input; }
    }
    evaluate truth(organisme_competent_msa(entity_ref("urn:fr:ppa:case:msa-2026")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
