// Forfait logement R. 844-3 par composition du foyer: 12 % du montant forfaitaire d'une personne, 16 % du montant
// calculé pour deux personnes (x 1.5), 16,5 % du montant calculé pour trois personnes (x 1.8; D. 843-1 al. 1).
// Base du mois 2024-10-01: 622.63 (décret 2024-403, chaîne 11-forfait-chaine.law), non fournie par le cas.
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

// SEUL: one person -> 622.63 x 1 x 0.12 = 74.7156
test "urn:query:fr-ppa-fl-seul" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2027-02-15T12:00:00Z; knowledge_time @2027-02-15T12:00:00Z; legal_time @2027-02-15; timezone "Europe/Paris"; }
        assert "fl-seul-01": forme_foyer_retenue(entity_ref("urn:fr:ppa:case:fl-seul"), @2024-10-01, SEUL) { origin case_input; }
    }
    evaluate truth(forfait_logement_du_mois(entity_ref("urn:fr:ppa:case:fl-seul"), @2024-10-01, 74.7156 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

