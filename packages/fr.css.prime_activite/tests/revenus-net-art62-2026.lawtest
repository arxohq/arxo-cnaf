// Net professional income: gross 2000 minus 400 charges (R. 844-1
// II); CGI art. 62 income counted before deduction (R. 845-3).
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

test "urn:query:fr-ppa-revenus-net-art62-2026" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; }
        assert "ppa-01": revenu_pro_elements(entity_ref("urn:fr:ppa:case:revenus-net-art62-2026"), @2026-05-01, 0, ITEM_01_ACTIVITE, 2000.00 EUR, 400.00 EUR) { origin case_input; }
        assert "ppa-03": activite_hors_non_salarie(entity_ref("urn:fr:ppa:case:revenus-net-art62-2026"), @2026-05-01, 0) { origin case_input; }
        assert "ppa-02": revenus_art62_avant_deduction(entity_ref("urn:fr:ppa:case:revenus-net-art62-2026"), @2026-05-01, 3000.00 EUR) { origin case_input; }
    }
    evaluate truth(revenu_pro_montant_retenu(entity_ref("urn:fr:ppa:case:revenus-net-art62-2026"), @2026-05-01, 0, ITEM_01_ACTIVITE, 1600.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(revenus_art62_retenus(entity_ref("urn:fr:ppa:case:revenus-net-art62-2026"), @2026-05-01, 3000.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
