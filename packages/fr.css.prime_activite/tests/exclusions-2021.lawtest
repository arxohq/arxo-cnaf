// Exclusions June 2021: old 21° and 29° excluded; 21°bis not yet
// introduced stays silent (R. 844-5).
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

test "urn:query:fr-ppa-exclusions-2021" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2021-06-15T12:00:00Z; knowledge_time @2021-06-15T12:00:00Z; legal_time @2021-06-15; timezone "Europe/Paris"; }
        assert "ppa-01": prestation_declaree(entity_ref("urn:fr:ppa:case:exclusions-2021"), @2021-06-01, ITEM_21_1999_RECONNAISSANCE, 600.00 EUR) { origin case_input; }
        assert "ppa-02": prestation_declaree(entity_ref("urn:fr:ppa:case:exclusions-2021"), @2021-06-01, ITEM_29_ALLOCATION_DECES_ENFANT, 1000.00 EUR) { origin case_input; }
        assert "ppa-03": prestation_declaree(entity_ref("urn:fr:ppa:case:exclusions-2021"), @2021-06-01, ITEM_21BIS_ALLOCATION_VIAGERE, 600.00 EUR) { origin case_input; }
    }
    evaluate truth(prestation_exclue(entity_ref("urn:fr:ppa:case:exclusions-2021"), @2021-06-01, ITEM_21_1999_RECONNAISSANCE, 600.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(prestation_exclue(entity_ref("urn:fr:ppa:case:exclusions-2021"), @2021-06-01, ITEM_29_ALLOCATION_DECES_ENFANT, 1000.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(prestation_exclue(entity_ref("urn:fr:ppa:case:exclusions-2021"), @2021-06-01, ITEM_21BIS_ALLOCATION_VIAGERE, 600.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
