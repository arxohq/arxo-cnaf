// Couple + 2 children, two workers, new wording: SMIC 12.00, base
// 640.00, claimant 1182.00/month, spouse 945.00/month (Feb-Apr 2026),
// resources 2127.00. Forfait 2.1x640 = 1344.00 (D.843-1). Boni claimant
// 120.64 (ratio 0.5), boni spouse 60.32 (ratio (945-708)/948 = 0.25,
// cap 0.377x640); fraction 0.5985x2127 = 1273.0095; prime = 1344 +
// 1273.0095 + 180.96 - 2127 = 670.9695; average 670.9695 above 15.00
// -> due 670.9695 for June 2026.
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

test "urn:query:fr-ppa-prime-couple-2e-2026" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; }
        assert "ppa-01": forfait_base_retenu(@2026-02-01, 640.00 EUR) { origin case_input; }
        assert "ppa-02": forfait_base_retenu(@2026-03-01, 640.00 EUR) { origin case_input; }
        assert "ppa-03": forfait_base_retenu(@2026-04-01, 640.00 EUR) { origin case_input; }
        assert "ppa-04": smic_horaire_retenu(@2026-02-01, 12.00 EUR) { origin case_input; }
        assert "ppa-05": smic_horaire_retenu(@2026-03-01, 12.00 EUR) { origin case_input; }
        assert "ppa-06": smic_horaire_retenu(@2026-04-01, 12.00 EUR) { origin case_input; }
        assert "ppa-07": forme_foyer_retenue(entity_ref("urn:fr:ppa:case:couple-2e-2026"), @2026-02-01, COUPLE_2E) { origin case_input; }
        assert "ppa-08": forme_foyer_retenue(entity_ref("urn:fr:ppa:case:couple-2e-2026"), @2026-03-01, COUPLE_2E) { origin case_input; }
        assert "ppa-09": forme_foyer_retenue(entity_ref("urn:fr:ppa:case:couple-2e-2026"), @2026-04-01, COUPLE_2E) { origin case_input; }
        assert "ppa-10": revenus_pro_demandeur(entity_ref("urn:fr:ppa:case:couple-2e-2026"), @2026-02-01, 1182.00 EUR) { origin case_input; }
        assert "ppa-11": revenus_pro_demandeur(entity_ref("urn:fr:ppa:case:couple-2e-2026"), @2026-03-01, 1182.00 EUR) { origin case_input; }
        assert "ppa-12": revenus_pro_demandeur(entity_ref("urn:fr:ppa:case:couple-2e-2026"), @2026-04-01, 1182.00 EUR) { origin case_input; }
        assert "ppa-13": revenus_pro_conjoint(entity_ref("urn:fr:ppa:case:couple-2e-2026"), @2026-02-01, 945.00 EUR) { origin case_input; }
        assert "ppa-14": revenus_pro_conjoint(entity_ref("urn:fr:ppa:case:couple-2e-2026"), @2026-03-01, 945.00 EUR) { origin case_input; }
        assert "ppa-15": revenus_pro_conjoint(entity_ref("urn:fr:ppa:case:couple-2e-2026"), @2026-04-01, 945.00 EUR) { origin case_input; }
        assert "ppa-16": revenus_mensuels_retenus(entity_ref("urn:fr:ppa:case:couple-2e-2026"), @2026-02-01, 2127.00 EUR) { origin case_input; }
        assert "ppa-17": revenus_mensuels_retenus(entity_ref("urn:fr:ppa:case:couple-2e-2026"), @2026-03-01, 2127.00 EUR) { origin case_input; }
        assert "ppa-18": revenus_mensuels_retenus(entity_ref("urn:fr:ppa:case:couple-2e-2026"), @2026-04-01, 2127.00 EUR) { origin case_input; }
        assert "ppa-19": mois_revue(entity_ref("urn:fr:ppa:case:couple-2e-2026"), @2026-06-01) { origin case_input; }
        assert "ppa-20": minimum_paiement_retenu(@2026-06-01, 15.00 EUR) { origin case_input; }
    }
    evaluate truth(prime_due_trimestre(entity_ref("urn:fr:ppa:case:couple-2e-2026"), 670.9695 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
