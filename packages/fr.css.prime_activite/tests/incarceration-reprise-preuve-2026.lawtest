// Next-review resumption (PA-R5-02): release alone does not restore
// the right; restoration follows the periodic review after the end
// (R. 846-8 al. 3).
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

test "urn:query:fr-ppa-incarceration-reprise-preuve-2026" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; }
        assert "ppa-01": fin_incarceration(entity_ref("urn:fr:ppa:case:incarceration-fin-seule")) { origin case_input; }
        assert "ppa-02": fin_incarceration(entity_ref("urn:fr:ppa:case:incarceration-reexamen")) { origin case_input; }
        assert "ppa-03": reexamen_periodique_apres_incarceration(entity_ref("urn:fr:ppa:case:incarceration-reexamen")) { origin case_input; }
    }
    evaluate truth(reprise_apres_incarceration(entity_ref("urn:fr:ppa:case:incarceration-fin-seule")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(reprise_apres_incarceration(entity_ref("urn:fr:ppa:case:incarceration-reexamen")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
