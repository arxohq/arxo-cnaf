// Composition: PF-entitled child, charge-judged 6-year-old, spouse
// present -> three memberships (R. 842-3).
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

test "urn:query:fr-ppa-foyer-composition-2026" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; }
        assert "ppa-01": conjoint_present(entity_ref("urn:fr:ppa:case:foyer-composition-2026")) { origin case_input; }
        assert "ppa-02": mois_du_droit(entity_ref("urn:fr:ppa:case:foyer-composition-2026"), @2026-06-01) { origin case_input; }
        assert "ppa-03": enfant_ou_charge(entity_ref("urn:fr:ppa:case:foyer-composition-2026"), entity_ref("urn:fr:ppa:enfant:aine")) { origin case_input; }
        assert "ppa-04": ouvre_droit_pf(entity_ref("urn:fr:ppa:enfant:aine")) { origin case_input; }
        assert "ppa-05": enfant_ou_charge(entity_ref("urn:fr:ppa:case:foyer-composition-2026"), entity_ref("urn:fr:ppa:enfant:cadet")) { origin case_input; }
        assert "ppa-06": naissance(entity_ref("urn:fr:ppa:enfant:cadet"), @2020-05-01) { origin case_input; }
        assert "ppa-07": charge_effective_permanente(entity_ref("urn:fr:ppa:case:foyer-composition-2026"), entity_ref("urn:fr:ppa:enfant:cadet")) { origin adjudicated; }
        assert "ppa-08": enfant_non_beneficiaire_pa_annee_droit(entity_ref("urn:fr:ppa:enfant:aine")) { origin case_input; }
        assert "ppa-09": enfant_non_beneficiaire_pa_annee_droit(entity_ref("urn:fr:ppa:enfant:cadet")) { origin case_input; }
        assert "ppa-10": arrivee_foyer(entity_ref("urn:fr:ppa:enfant:cadet"), @2020-06-01) { origin case_input; }
    }
    evaluate truth(conjoint_membre_foyer(entity_ref("urn:fr:ppa:case:foyer-composition-2026")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(enfant_membre_foyer(entity_ref("urn:fr:ppa:case:foyer-composition-2026"), entity_ref("urn:fr:ppa:enfant:aine")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(enfant_membre_foyer(entity_ref("urn:fr:ppa:case:foyer-composition-2026"), entity_ref("urn:fr:ppa:enfant:cadet")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
