// Professional income: activity wages + IJ within 3 months of the
// stoppage -> both counted (R. 844-1 1°/6°).
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

test "urn:query:fr-ppa-revenus-pro-2026" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; }
        assert "ppa-01": revenu_pro_declare(entity_ref("urn:fr:ppa:case:revenus-pro-2026"), @2026-05-01, 0, ITEM_01_ACTIVITE, 1500.00 EUR) { origin case_input; }
        assert "ppa-02": revenu_pro_declare(entity_ref("urn:fr:ppa:case:revenus-pro-2026"), @2026-05-01, 1, ITEM_06_IJ_3_MOIS, 800.00 EUR) { origin case_input; }
        assert "ppa-03": arret_travail(entity_ref("urn:fr:ppa:case:revenus-pro-2026"), @2026-04-10) { origin case_input; }
    }
    evaluate truth(revenu_pro_retenu(entity_ref("urn:fr:ppa:case:revenus-pro-2026"), @2026-05-01, 0, ITEM_01_ACTIVITE, 1500.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(revenu_pro_retenu(entity_ref("urn:fr:ppa:case:revenus-pro-2026"), @2026-05-01, 1, ITEM_06_IJ_3_MOIS, 800.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
