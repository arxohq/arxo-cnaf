// Request channel -> D6 verification mention ACTIVE; individual
// decision -> D9 appeal mentions ACTIVE (R. 847-1/3).
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

test "urn:query:fr-ppa-mentions-recours-2026" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; }
        assert "ppa-01": demande_teleservice(entity_ref("urn:fr:ppa:case:mentions-recours-2026"), @2026-06-05) { origin case_input; }
        assert "ppa-02": decision_individuelle(entity_ref("urn:fr:ppa:case:mentions-recours-2026"), @2026-06-10) { origin case_input; }
        assert "ppa-03": organisme_serviteur(entity_ref("urn:fr:ppa:org:caisse"), entity_ref("urn:fr:ppa:case:mentions-recours-2026")) { origin case_input; }
    }
    evaluate positions();
    expect position(MentionnerVerification, ACTIVE);
    expect position(MentionnerRecours, ACTIVE);
    expect evaluation_status == COMPUTED;
}
