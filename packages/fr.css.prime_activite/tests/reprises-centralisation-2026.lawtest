// Service endpoints: monthly rhythm on the open right, resumption at
// the next periodic review after hospital and prison, CNAF
// centralisation (R. 846-3/7/8/9).
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

test "urn:query:fr-ppa-reprises-centralisation-2026" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; }
        assert "ppa-01": age_plus_dix_huit(entity_ref("urn:fr:ppa:case:reprises-centralisation-2026")) { origin case_input; }
        assert "ppa-02": residence_stable(entity_ref("urn:fr:ppa:case:reprises-centralisation-2026")) { origin case_input; }
        assert "ppa-03": revenus_professionnels(entity_ref("urn:fr:ppa:case:reprises-centralisation-2026")) { origin case_input; }
        assert "ppa-04": sejour_travail_ok(entity_ref("urn:fr:ppa:case:reprises-centralisation-2026")) { origin case_input; }
        assert "ppa-05": conjoint_conditions_ok(entity_ref("urn:fr:ppa:case:reprises-centralisation-2026")) { origin case_input; }
        assert "ppa-10": sans_exclusion_statutaire(entity_ref("urn:fr:ppa:case:reprises-centralisation-2026")) { origin case_input; }
        assert "ppa-06": demande_deposee(entity_ref("urn:fr:ppa:case:reprises-centralisation-2026"), @2026-06-01) { origin case_input; }
        assert "ppa-07": fin_hospitalisation(entity_ref("urn:fr:ppa:case:reprises-centralisation-2026")) { origin case_input; }
        assert "ppa-08": fin_incarceration(entity_ref("urn:fr:ppa:case:reprises-centralisation-2026")) { origin case_input; }
        assert "ppa-09": operations_centralisees(entity_ref("urn:fr:ppa:org:cnaf")) { origin case_input; }
        assert "ppa-11": reexamen_periodique_apres_hospitalisation(entity_ref("urn:fr:ppa:case:reprises-centralisation-2026")) { origin case_input; }
        assert "ppa-12": reexamen_periodique_apres_incarceration(entity_ref("urn:fr:ppa:case:reprises-centralisation-2026")) { origin case_input; }
    }
    evaluate truth(versement_mensuel_terme_echu(entity_ref("urn:fr:ppa:case:reprises-centralisation-2026")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(reprise_taux_plein_hospitalisation(entity_ref("urn:fr:ppa:case:reprises-centralisation-2026")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(reprise_apres_incarceration(entity_ref("urn:fr:ppa:case:reprises-centralisation-2026")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(centralisation_assuree(entity_ref("urn:fr:ppa:org:cnaf")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
