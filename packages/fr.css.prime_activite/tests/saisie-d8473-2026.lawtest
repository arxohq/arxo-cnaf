// Seizure of the bonus being implemented: monthly deductions
// under D. 553-1/2 (D. 847-3).
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

test "urn:query:fr-ppa-saisie-d8473-2026" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; }
        assert "ppa-01": indu_recupere(entity_ref("urn:fr:ppa:case:saisie-d8473-2026"), 500.00 EUR) { origin case_input; }
        assert "ppa-02": saisie_prime_mise_en_oeuvre(entity_ref("urn:fr:ppa:case:saisie-d8473-2026")) { origin case_input; }
        assert "ppa-03": organisme_serviteur(entity_ref("urn:fr:ppa:org:caisse"), entity_ref("urn:fr:ppa:case:saisie-d8473-2026")) { origin case_input; }
    }
    evaluate truth(prelevements_saisie_mensuels(entity_ref("urn:fr:ppa:case:saisie-d8473-2026")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
