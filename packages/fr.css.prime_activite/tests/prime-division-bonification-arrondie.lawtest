        assert "div-b3-02": revenus_pro_demandeur(entity_ref("urn:fr:ppa:case:div-b3"), @2026-02-01, 1000.00 EUR) { origin case_input; }
        assert "div-b3-03": revenus_pro_conjoint(entity_ref("urn:fr:ppa:case:div-b3"), @2026-02-01, 1200.00 EUR) { origin case_input; }
        assert "div-b3-04": smic_horaire_retenu(@2026-02-01, 12.02 EUR) { origin case_input; }
    }
    evaluate truth(bonification_mensuelle(entity_ref("urn:fr:ppa:case:div-b3"), @2026-02-01, 196.50 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

