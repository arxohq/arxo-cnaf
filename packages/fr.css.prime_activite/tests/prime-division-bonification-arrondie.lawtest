    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; interpretation BonificationLineaireArrondieCentime; }
        assert "div-b2-01": forme_foyer_retenue(entity_ref("urn:fr:ppa:case:div-b2"), @2026-02-01, SEUL) { origin case_input; }
        assert "div-b2-02": revenus_pro_demandeur(entity_ref("urn:fr:ppa:case:div-b2"), @2026-02-01, 1183.97 EUR) { origin case_input; }
        assert "div-b2-03": smic_horaire_retenu(@2026-02-01, 12.02 EUR) { origin case_input; }
    }
    evaluate truth(bonification_mensuelle(entity_ref("urn:fr:ppa:case:div-b2"), @2026-02-01, 119.36 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "urn:query:fr-ppa-division-boni-nouveau-couple" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; interpretation BonificationLineaireArrondieCentime; }
