// Fallback allocation evidence (PA-R4-07): with positive no-payee
// and no-designation status the filer is the payee, and a
// one-year-old joint designation is reopened; a joint designation
// without any payee status stays undetermined (R.846-4).
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

test "urn:query:fr-ppa-allocataire-defaut-2026" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; }
        assert "ppa-01": aucun_allocataire_pf_rsa(entity_ref("urn:fr:ppa:case:allocataire-defaut-filer")) { origin case_input; }
        assert "ppa-02": aucune_designation_conjointe(entity_ref("urn:fr:ppa:case:allocataire-defaut-filer")) { origin case_input; }
        assert "ppa-03": designation_conjointe(entity_ref("urn:fr:ppa:case:allocataire-defaut-inconnu"), CONJOINT) { origin case_input; }
        assert "ppa-04": modification_designation(entity_ref("urn:fr:ppa:case:allocataire-defaut-revision"), CONJOINT, @2025-01-01, @2026-02-01) { origin case_input; }
        assert "ppa-05": aucun_allocataire_pf_rsa(entity_ref("urn:fr:ppa:case:allocataire-defaut-revision")) { origin case_input; }
    }
    evaluate truth(allocataire_designe(entity_ref("urn:fr:ppa:case:allocataire-defaut-filer"), BENEFICIAIRE));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(allocataire_designe(entity_ref("urn:fr:ppa:case:allocataire-defaut-inconnu"), CONJOINT));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(allocataire_designe(entity_ref("urn:fr:ppa:case:allocataire-defaut-revision"), CONJOINT));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
