// Household gate evidence (PA-R5-01, PA-R6-01): a recorded
// spouse/partner/concubin/dependent affirmatively bars the hospital
// half-rate; without any household evidence the reduction stays
// undetermined; generic family co-residence without the statutory
// qualification neither bars the reduction nor selects it (R. 846-7).
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

test "urn:query:fr-ppa-hospitalisation-foyer-preuve-2026" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; }
        assert "ppa-01": prime_due_trimestre(entity_ref("urn:fr:ppa:case:hospitalisation-famille"), 400.00 EUR) { origin case_input; }
        assert "ppa-02": hospitalisation_prise_en_charge(entity_ref("urn:fr:ppa:case:hospitalisation-famille")) { origin case_input; }
        assert "ppa-03": deuxieme_revision_depassee(entity_ref("urn:fr:ppa:case:hospitalisation-famille")) { origin case_input; }
        assert "ppa-04": hospitalisation_en_cours(entity_ref("urn:fr:ppa:case:hospitalisation-famille")) { origin case_input; }
        assert "ppa-05": grossesse_non_en_cours(entity_ref("urn:fr:ppa:case:hospitalisation-famille")) { origin case_input; }
        assert "ppa-06": prise_en_charge_active(entity_ref("urn:fr:ppa:case:hospitalisation-famille")) { origin case_input; }
        assert "ppa-07": foyer_avec_conjoint_pacs_concubin_ou_charge(entity_ref("urn:fr:ppa:case:hospitalisation-famille")) { origin case_input; }
        assert "ppa-08": prime_due_trimestre(entity_ref("urn:fr:ppa:case:hospitalisation-foyer-inconnu"), 400.00 EUR) { origin case_input; }
        assert "ppa-09": hospitalisation_prise_en_charge(entity_ref("urn:fr:ppa:case:hospitalisation-foyer-inconnu")) { origin case_input; }
        assert "ppa-10": deuxieme_revision_depassee(entity_ref("urn:fr:ppa:case:hospitalisation-foyer-inconnu")) { origin case_input; }
        assert "ppa-11": hospitalisation_en_cours(entity_ref("urn:fr:ppa:case:hospitalisation-foyer-inconnu")) { origin case_input; }
        assert "ppa-12": grossesse_non_en_cours(entity_ref("urn:fr:ppa:case:hospitalisation-foyer-inconnu")) { origin case_input; }
        assert "ppa-13": prise_en_charge_active(entity_ref("urn:fr:ppa:case:hospitalisation-foyer-inconnu")) { origin case_input; }
        assert "ppa-14": prime_due_trimestre(entity_ref("urn:fr:ppa:case:hospitalisation-cohabitation-generique"), 400.00 EUR) { origin case_input; }
        assert "ppa-15": hospitalisation_prise_en_charge(entity_ref("urn:fr:ppa:case:hospitalisation-cohabitation-generique")) { origin case_input; }
        assert "ppa-16": deuxieme_revision_depassee(entity_ref("urn:fr:ppa:case:hospitalisation-cohabitation-generique")) { origin case_input; }
        assert "ppa-17": hospitalisation_en_cours(entity_ref("urn:fr:ppa:case:hospitalisation-cohabitation-generique")) { origin case_input; }
        assert "ppa-18": grossesse_non_en_cours(entity_ref("urn:fr:ppa:case:hospitalisation-cohabitation-generique")) { origin case_input; }
        assert "ppa-19": prise_en_charge_active(entity_ref("urn:fr:ppa:case:hospitalisation-cohabitation-generique")) { origin case_input; }
        assert "ppa-20": foyer_sans_conjoint_ni_charge(entity_ref("urn:fr:ppa:case:hospitalisation-cohabitation-generique")) { origin case_input; }
        assert "ppa-21": foyer_avec_famille(entity_ref("urn:fr:ppa:case:hospitalisation-cohabitation-generique")) { origin case_input; }
    }
    evaluate truth(prime_reduite_hospitalisation(entity_ref("urn:fr:ppa:case:hospitalisation-famille"), 200.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(prime_reduite_hospitalisation(entity_ref("urn:fr:ppa:case:hospitalisation-foyer-inconnu"), 200.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(prime_reduite_hospitalisation(entity_ref("urn:fr:ppa:case:hospitalisation-cohabitation-generique"), 200.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
