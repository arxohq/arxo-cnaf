// Построение и сверка (DECISION-0452) под чтением ForfaitRevalorisationArrondiCentime: предыдущая сумма × коэффициент L. 161-25,
// округление до сантима; построенное равно опубликованному в каждом окне, начиная с 2021.
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

// 2021-10-01: forfait_base_construit = 553.71 EUR et conforme au décret
test "urn:query:fr-ppa-forfait-chaine-2021" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2027-02-15T12:00:00Z; knowledge_time @2027-02-15T12:00:00Z; legal_time @2027-02-15; timezone "Europe/Paris"; interpretation ForfaitRevalorisationArrondiCentime; }
        assert "forfait-chaine-2021-01": forme_foyer_retenue(entity_ref("urn:fr:ppa:case:forfait-chaine-2021"), @2021-10-01, SEUL) { origin case_input; }
    }
    evaluate truth(forfait_base_construit(@2021-10-01, 553.71 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(forfait_base_conforme_publie(@2021-10-01));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

