// Household split evidence (PA-R5-02, PA-R6-01): the isolated prisoner
// suspends with no family examination; the qualifying household
// (spouse/PACS/concubin/dependent) examines without suspending;
// without household evidence both stay undetermined; the
// isolated-major with child bars the family examination too (R. 846-8).
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

test "urn:query:fr-ppa-incarceration-foyer-preuve-2026" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; }
        assert "ppa-01": incarceration_en_cours(entity_ref("urn:fr:ppa:case:incarceration-isole")) { origin case_input; }
        assert "ppa-02": deuxieme_reexamen_depasse(entity_ref("urn:fr:ppa:case:incarceration-isole")) { origin case_input; }
        assert "ppa-03": foyer_sans_conjoint_ni_charge(entity_ref("urn:fr:ppa:case:incarceration-isole")) { origin case_input; }
        assert "ppa-04": sans_majo_isolee_avec_enfant(entity_ref("urn:fr:ppa:case:incarceration-isole")) { origin case_input; }
        assert "ppa-05": incarceration_en_cours(entity_ref("urn:fr:ppa:case:incarceration-foyer-inconnu")) { origin case_input; }
        assert "ppa-06": deuxieme_reexamen_depasse(entity_ref("urn:fr:ppa:case:incarceration-foyer-inconnu")) { origin case_input; }
        assert "ppa-07": sans_majo_isolee_avec_enfant(entity_ref("urn:fr:ppa:case:incarceration-foyer-inconnu")) { origin case_input; }
        assert "ppa-08": incarceration_en_cours(entity_ref("urn:fr:ppa:case:incarceration-famille-majo")) { origin case_input; }
        assert "ppa-09": deuxieme_reexamen_depasse(entity_ref("urn:fr:ppa:case:incarceration-famille-majo")) { origin case_input; }
        assert "ppa-10": foyer_avec_conjoint_pacs_concubin_ou_charge(entity_ref("urn:fr:ppa:case:incarceration-famille-majo")) { origin case_input; }
        assert "ppa-11": majo_isolee_avec_enfant(entity_ref("urn:fr:ppa:case:incarceration-famille-majo")) { origin case_input; }
    }
    evaluate truth(prime_suspendue_incarceration(entity_ref("urn:fr:ppa:case:incarceration-isole")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(droits_reexamines_sans_beneficiaire(entity_ref("urn:fr:ppa:case:incarceration-isole")));
    expect result_kind == PROPOSITION;
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(prime_suspendue_incarceration(entity_ref("urn:fr:ppa:case:incarceration-foyer-inconnu")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(droits_reexamines_sans_beneficiaire(entity_ref("urn:fr:ppa:case:incarceration-foyer-inconnu")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(droits_reexamines_sans_beneficiaire(entity_ref("urn:fr:ppa:case:incarceration-famille-majo")));
    expect result_kind == PROPOSITION;
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
}
