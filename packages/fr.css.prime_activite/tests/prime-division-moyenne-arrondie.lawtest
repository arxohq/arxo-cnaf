        assert "div-m2-07": smic_horaire_retenu(@2024-12-01, 11.65 EUR) { origin case_input; }
        assert "div-m2-08": revenus_mensuels_retenus(entity_ref("urn:fr:ppa:case:div-m2"), @2024-12-01, 501.00 EUR) { origin case_input; }
        assert "div-m2-09": forme_foyer_retenue(entity_ref("urn:fr:ppa:case:div-m2"), @2025-01-01, SEUL) { origin case_input; }
        assert "div-m2-10": revenus_pro_demandeur(entity_ref("urn:fr:ppa:case:div-m2"), @2025-01-01, 503.00 EUR) { origin case_input; }
        assert "div-m2-11": smic_horaire_retenu(@2025-01-01, 11.88 EUR) { origin case_input; }
        assert "div-m2-12": revenus_mensuels_retenus(entity_ref("urn:fr:ppa:case:div-m2"), @2025-01-01, 503.00 EUR) { origin case_input; }
        assert "div-m2-13": mois_revue(entity_ref("urn:fr:ppa:case:div-m2"), @2025-02-01) { origin case_input; }
        assert "div-m2-14": minimum_paiement_retenu(@2025-02-01, 15.00 EUR) { origin case_input; }
    }
    evaluate truth(prime_due_trimestre(entity_ref("urn:fr:ppa:case:div-m2"), 305.81 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
