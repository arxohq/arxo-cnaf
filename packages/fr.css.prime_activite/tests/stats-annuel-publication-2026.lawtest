// Closed year -> D11/D12/D14 ACTIVE; the statute-named actor
// ensures regular publication, the published 2025 results are the
// performance evidence (D. 848-2/3/4, R. 848-1).
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

test "urn:query:fr-ppa-stats-annuel-publication-2026" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; }
        assert "ppa-01": annee_stats_emetteur(entity_ref("urn:fr:ppa:org:cnaf"), entity_ref("urn:fr:ppa:org:drees"), 2025) { origin case_input; }
        assert "ppa-02": resultats_publies(entity_ref("urn:fr:ppa:org:france-travail"), 2025) { origin case_input; }
        assert "ppa-03": arretes_conjoints_stats(2026) { origin case_input; }
        assert "ppa-04": acteur_publication_2024(entity_ref("urn:fr:ppa:org:france-travail")) { origin case_input; }
        assert "ppa-05": exercice_stats_publication(2025) { origin case_input; }
    }
    evaluate positions();
    expect position(TransmettreAnnuel, ACTIVE);
    expect position(TransmettreL8463, ACTIVE);
    expect position(TransmettreL8462, ACTIVE);
    expect evaluation_status == COMPUTED;
    evaluate truth(publication_stats_assuree(entity_ref("urn:fr:ppa:org:france-travail"), 2025));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(publication_periodique_realisee(entity_ref("urn:fr:ppa:org:france-travail"), 2025));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(listes_stats_applicables(2026));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
