// Student with both exception-absences established and without the
// isolated-person majoration -> excluded (L.842-2 3°); the open right
// is affirmatively false (PA-R4-09; was NEITHER, incoherent with the
// Belnap-join FALSE on a present contrary used since the M-repair).
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

test "urn:query:fr-ppa-droit-etudiant-exclu" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; }
        assert "ppa-01": age_plus_dix_huit(entity_ref("urn:fr:ppa:case:droit-etudiant-exclu")) { origin case_input; }
        assert "ppa-02": residence_stable(entity_ref("urn:fr:ppa:case:droit-etudiant-exclu")) { origin case_input; }
        assert "ppa-03": revenus_professionnels(entity_ref("urn:fr:ppa:case:droit-etudiant-exclu")) { origin case_input; }
        assert "ppa-04": sejour_travail_ok(entity_ref("urn:fr:ppa:case:droit-etudiant-exclu")) { origin case_input; }
        assert "ppa-05": conjoint_conditions_ok(entity_ref("urn:fr:ppa:case:droit-etudiant-exclu")) { origin case_input; }
        assert "ppa-06": etudiant_stagiaire_apprenti(entity_ref("urn:fr:ppa:case:droit-etudiant-exclu")) { origin case_input; }
        assert "ppa-07": demande_deposee(entity_ref("urn:fr:ppa:case:droit-etudiant-exclu"), @2026-06-01) { origin case_input; }
        assert "ppa-08": revenus_etudiant_plafond_non_depasse(entity_ref("urn:fr:ppa:case:droit-etudiant-exclu")) { origin case_input; }
        assert "ppa-09": sans_majoration_isole(entity_ref("urn:fr:ppa:case:droit-etudiant-exclu")) { origin case_input; }
    }
    evaluate truth(exclu_statut(entity_ref("urn:fr:ppa:case:droit-etudiant-exclu")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(droit_ouvert(entity_ref("urn:fr:ppa:case:droit-etudiant-exclu")));
    expect result_kind == PROPOSITION;
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
}
