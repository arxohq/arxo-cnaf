// D-82/D-84 БЕЗ прочтения: те же факты, что в ressources-division-lecture.lawtest, прочтение не выбрано - поведение прежнее.
// Неточное частное (бесконечная дробь) - RUNTIME_ERROR по INEXACT_DIVISION (SPEC 50/18: округление - только явной политикой);
// конечное частное (rd-a1x, rd-b1x - четыре знака; rd-a1t, rd-b1t - три знака, ровно полцента) - точное значение без округления. Реплика - Fraction.
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

test "urn:query:fr-ppa-ressources-division-rd-a1-sans" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; }
        assert "rd-a1-01": n_2_agri_connu(entity_ref("urn:fr:ppa:case:rd-a1"), @2026-06-01) { origin case_input; }
        assert "rd-a1-02": benefices_agri_n_2(entity_ref("urn:fr:ppa:case:rd-a1"), @2026-06-01, 10000.00 EUR) { origin case_input; }
        assert "rd-a1-03": annee_agri_complete(entity_ref("urn:fr:ppa:case:rd-a1"), @2026-06-01) { origin case_input; }
    }
    evaluate truth(revenu_agri(entity_ref("urn:fr:ppa:case:rd-a1"), @2026-06-01, 833.33 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == RUNTIME_ERROR;
}

