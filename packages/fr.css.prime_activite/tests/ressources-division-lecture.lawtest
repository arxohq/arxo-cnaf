// D-82/D-84 (решение владельца, 08.10.2026): двенадцатые и трети доходов R. 845-1/2 под прочтением
// RessourcesFractionsArrondiesCentime - частное округляется до сантима HALF_UP (практика CNAF, не текст), всегда, в т. ч.
// точное частное длиннее двух знаков; произведение с (1 - t) остаётся точным. Ожидания - независимая реплика на дробях
// (fractions.Fraction, HALF_UP), tools/build_ressources_division.py; «douzième» и «tiers» - из закреплённых
// sources/css/R845-1.txt и R845-2.txt, суммы и ставки абатмана - входы дела. Новая редакция - обзор 2026-06-01
// (M-4..M-2), прежняя - 2025-02-01 (трети квартала, предшествующего обзору), оба на общем режиме.
//   rd-a1   AgriBaseN2: 10000.00 / 12 = 833.333333... -> 833.33;
//   rd-a2   AgriBaseN1: 18000.10 / 12 = 1500.008333... -> 1500.01;
//   rd-a3   AgriFallbackAncienNonImposes: 9000.01 / 3 = 3000.003333... -> 3000.00; x (1 - 0.10) = 2700.00;
//   rd-a4   AgriFallbackAncienIncomplet: 4500.02 / 3 = 1500.006667... -> 1500.01; x (1 - 0.10) = 1350.009;
//   rd-a5   AgriFallbackNouveauNonImposes: 3000.01 / 3 = 1000.003333... -> 1000.00; x (1 - 0.10) = 900.00;
//   rd-a6   AgriFallbackNouveauIncomplet: 2100.05 / 3 = 700.016667... -> 700.02; x (1 - 0.10) = 630.018;
//   rd-a7   AgriOptionAncienne: 1234.58 / 3 = 411.526667... -> 411.53; x (1 - 0.10) = 370.377;
//   rd-a8   AgriOptionNouvelle: 2500.07 / 3 = 833.356667... -> 833.36; x (1 - 0.10) = 750.024;
//   rd-b1   BicBaseN2: 12000.50 / 12 = 1000.041667... -> 1000.04;
//   rd-b2   BicBaseN1: 6000.07 / 12 = 500.005833... -> 500.01;
//   rd-b3   BicFallbackAncienNonImposes: 7000.04 / 3 = 2333.346667... -> 2333.35; x (1 - 0.34) = 1540.011;
//   rd-b4   BicFallbackAncienIncomplet: 5200.12 / 3 = 1733.373333... -> 1733.37; x (1 - 0.34) = 1144.0242;
//   rd-b5   BicFallbackAncienSpecial: 3100.21 / 3 = 1033.403333... -> 1033.40; x (1 - 0.34) = 682.044;
//   rd-b6   BicFallbackNouveauNonImposes: 8000.02 / 3 = 2666.673333... -> 2666.67; x (1 - 0.34) = 1760.0022;
//   rd-b7   BicFallbackNouveauIncomplet: 6400.13 / 3 = 2133.376667... -> 2133.38; x (1 - 0.34) = 1408.0308;
//   rd-b8   BicFallbackNouveauSpecial: 4300.22 / 3 = 1433.406667... -> 1433.41; x (1 - 0.34) = 946.0506;
//   rd-b9   BicOptionAncienne: 2900.32 / 3 = 966.773333... -> 966.77; x (1 - 0.34) = 638.0682;
//   rd-b10  BicOptionNouvelle: 3700.19 / 3 = 1233.396667... -> 1233.40; x (1 - 0.34) = 814.044;
//   rd-a1x  AgriBaseN2: 24000.03 / 12 = 2000.0025 -> 2000.00 (частное точное, четыре знака);
//   rd-a1t  AgriBaseN2: 24010.14 / 12 = 2000.845 -> 2000.85 (ровно полцента, HALF_UP вверх, а HALF_EVEN дал бы вниз);
//   rd-b1x  BicBaseN1: 18000.09 / 12 = 1500.0075 -> 1500.01 (частное точное, четыре знака);
//   rd-b1t  BicBaseN2: 12000.06 / 12 = 1000.005 -> 1000.01 (ровно полцента, HALF_UP вверх, а HALF_EVEN дал бы вниз);
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

test "urn:query:fr-ppa-ressources-division-rd-a1" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; interpretation RessourcesFractionsArrondiesCentime; }
        assert "rd-a1-01": n_2_agri_connu(entity_ref("urn:fr:ppa:case:rd-a1"), @2026-06-01) { origin case_input; }
        assert "rd-a1-02": benefices_agri_n_2(entity_ref("urn:fr:ppa:case:rd-a1"), @2026-06-01, 10000.00 EUR) { origin case_input; }
        assert "rd-a1-03": annee_agri_complete(entity_ref("urn:fr:ppa:case:rd-a1"), @2026-06-01) { origin case_input; }
    }
    evaluate truth(revenu_agri(entity_ref("urn:fr:ppa:case:rd-a1"), @2026-06-01, 833.33 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

