// Undue 200.00 from fraud: recovered 200.00 + 10 % indemnity 20.00
// (L.845-3 al. 1).
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

test "urn:query:fr-ppa-indu-fraude-indemnite" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; }
        assert "ppa-01": indu_constate(entity_ref("urn:fr:ppa:case:indu-fraude"), 200.00 EUR) { origin case_input; }
        assert "ppa-02": indu_frauduleux(entity_ref("urn:fr:ppa:case:indu-fraude")) { origin case_input; }
        assert "ppa-03": action_non_prescrite(entity_ref("urn:fr:ppa:case:indu-fraude")) { origin case_input; }
        assert "ppa-04": aucun_recours_suspensif(entity_ref("urn:fr:ppa:case:indu-fraude")) { origin case_input; }
    }
    evaluate truth(indu_recupere(entity_ref("urn:fr:ppa:case:indu-fraude"), 200.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(indemnite_fraude(entity_ref("urn:fr:ppa:case:indu-fraude"), 20.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
