// Oral late request (21 days after reception of a date-certain
// notice), no documents produced, observed past the 20-day
// production delay: D8 duty ACTIVE on the beneficiary, oral
// request rejected under IV 2°, and that express rejection
// refutes examination of the same request (PA-FE09-06); NO II
// implicit rejection and NO II 2° recovery: the request is not
// the timely I.2.a request governed by II (PA-R3-02).
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

test "urn:query:fr-ppa-rejet-recouvrement-2026" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-08-15T12:00:00Z; knowledge_time @2026-08-15T12:00:00Z; legal_time @2026-08-15; timezone "Europe/Paris"; }
        assert "ppa-01": demande_rectification(entity_ref("urn:fr:ppa:case:rejet-recouvrement-2026"), @2026-06-10) { origin case_input; }
        assert "ppa-02": date_observation_recours(entity_ref("urn:fr:ppa:case:rejet-recouvrement-2026"), @2026-08-15) { origin case_input; }
        assert "ppa-03": demande_rectification_orale(entity_ref("urn:fr:ppa:case:rejet-recouvrement-2026")) { origin case_input; }
        assert "ppa-04": reception_notification(entity_ref("urn:fr:ppa:case:rejet-recouvrement-2026"), @2026-05-20) { origin case_input; }
        assert "ppa-05": organisme_serviteur(entity_ref("urn:fr:ppa:org:caisse"), entity_ref("urn:fr:ppa:case:rejet-recouvrement-2026")) { origin case_input; }
        assert "ppa-06": delai_recours_cra_en_cours(entity_ref("urn:fr:ppa:case:rejet-recouvrement-2026")) { origin case_input; }
        assert "ppa-07": pieces_orales_non_produites(entity_ref("urn:fr:ppa:case:rejet-recouvrement-2026")) { origin case_input; }
        assert "ppa-08": notification_moyen_date_certaine(entity_ref("urn:fr:ppa:case:rejet-recouvrement-2026")) { origin case_input; }
    }
    evaluate positions();
    expect position(TransmettrePieces, ACTIVE);
    expect evaluation_status == COMPUTED;
    evaluate truth(rejet_demande_orale(entity_ref("urn:fr:ppa:case:rejet-recouvrement-2026")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(rejet_implicite_rectification(entity_ref("urn:fr:ppa:case:rejet-recouvrement-2026")));
    expect result_kind == PROPOSITION;
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(recouvrement_apres_demande(entity_ref("urn:fr:ppa:case:rejet-recouvrement-2026")));
    expect result_kind == PROPOSITION;
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(examen_demande_possible(entity_ref("urn:fr:ppa:case:rejet-recouvrement-2026")));
    expect result_kind == PROPOSITION;
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
}
