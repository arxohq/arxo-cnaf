// Non-salaried: farm N-2 24000 -> 2000 monthly; BIC untaxed,
// M-4..M-2 9000 at 34% -> 1980 (R. 845-1/2).
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

test "urn:query:fr-ppa-non-salarie-2026" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; }
        assert "ppa-01": n_2_agri_connu(entity_ref("urn:fr:ppa:case:non-salarie-2026"), @2026-06-01) { origin case_input; }
        assert "ppa-02": benefices_agri_n_2(entity_ref("urn:fr:ppa:case:non-salarie-2026"), @2026-06-01, 24000.00 EUR) { origin case_input; }
        assert "ppa-03": annee_agri_complete(entity_ref("urn:fr:ppa:case:non-salarie-2026"), @2026-06-01) { origin case_input; }
        assert "ppa-04": benefices_bic_non_imposes(entity_ref("urn:fr:ppa:case:non-salarie-2026"), @2026-06-01) { origin case_input; }
        assert "ppa-05": ca_bic_m_4_m_2(entity_ref("urn:fr:ppa:case:non-salarie-2026"), @2026-06-01, 9000.00 EUR) { origin case_input; }
        assert "ppa-06": abattement_50_0_102ter(entity_ref("urn:fr:ppa:case:non-salarie-2026"), @2026-06-01, 0.34) { origin case_input; }
        assert "ppa-07": regime_general(entity_ref("urn:fr:ppa:case:non-salarie-2026")) { origin case_input; }
        // D-42: the NOTA gate (dispositions_nouvelles_2025) now binds its date
        // through the claim/review month (mois_revue, R. 843-1 I); the
        // computation at review @2026-06-01 states that month explicitly.
        assert "ppa-08": mois_revue(entity_ref("urn:fr:ppa:case:non-salarie-2026"), @2026-06-01) { origin case_input; }
    }
    evaluate truth(revenu_agri(entity_ref("urn:fr:ppa:case:non-salarie-2026"), @2026-06-01, 2000.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(revenu_bic(entity_ref("urn:fr:ppa:case:non-salarie-2026"), @2026-06-01, 1980.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
