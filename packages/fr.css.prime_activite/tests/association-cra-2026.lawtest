// Refusal challenged through a duly constituted five-year
// professional-integration association with a written mandate:
// CRA appeal admissible (R. 847-2).
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

test "urn:query:fr-ppa-association-cra-2026" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; }
        assert "ppa-01": decision_refus(entity_ref("urn:fr:ppa:case:association-cra-2026")) { origin case_input; }
        assert "ppa-02": recours_cra_association(entity_ref("urn:fr:ppa:case:association-cra-2026"), @2026-06-05) { origin case_input; }
        assert "ppa-03": association_regulierement_constituee(entity_ref("urn:fr:ppa:case:association-cra-2026")) { origin case_input; }
        assert "ppa-04": association_anciennete_5_ans(entity_ref("urn:fr:ppa:case:association-cra-2026")) { origin case_input; }
        assert "ppa-05": association_objet_insertion_pro(entity_ref("urn:fr:ppa:case:association-cra-2026")) { origin case_input; }
        assert "ppa-06": mandat_association_ecrit(entity_ref("urn:fr:ppa:case:association-cra-2026")) { origin case_input; }
        assert "ppa-07": delai_recours_cra_en_cours(entity_ref("urn:fr:ppa:case:association-cra-2026")) { origin case_input; }
    }
    evaluate truth(recours_prealaire_recevable(entity_ref("urn:fr:ppa:case:association-cra-2026")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
