// Quarterly option with a joint RSA request and the council
// president agreement -> option granted for RSA (R. 845-1).
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

test "urn:query:fr-ppa-option-rsa-2026" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; }
        assert "ppa-01": demande_option_agri(entity_ref("urn:fr:ppa:case:option-rsa-2026"), @2026-06-01) { origin case_input; }
        assert "ppa-02": demande_conjointe_rsa(entity_ref("urn:fr:ppa:case:option-rsa-2026"), @2026-06-01) { origin case_input; }
        assert "ppa-03": accord_president_cd(entity_ref("urn:fr:ppa:case:option-rsa-2026"), @2026-06-01) { origin case_input; }
    }
    evaluate truth(option_rsa_conjointe(entity_ref("urn:fr:ppa:case:option-rsa-2026"), @2026-06-01));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
