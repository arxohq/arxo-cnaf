// Timing, new wording: single, review June 2026, month of right June
// 2026, M-4..M-2 Feb..Apr 2026, all beneficiary slots met.
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

test "urn:query:fr-ppa-ouverture-timing-2026" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-06-15T12:00:00Z; knowledge_time @2026-06-15T12:00:00Z; legal_time @2026-06-15; timezone "Europe/Paris"; }
        assert "ppa-01": mois_revue(entity_ref("urn:fr:ppa:case:ouverture-timing-2026"), @2026-06-01) { origin case_input; }
        assert "ppa-02": mois_du_droit(entity_ref("urn:fr:ppa:case:ouverture-timing-2026"), @2026-06-01) { origin case_input; }
        assert "ppa-19": regime_general(entity_ref("urn:fr:ppa:case:ouverture-timing-2026")) { origin case_input; }
        assert "ppa-20": sans_conjoint(entity_ref("urn:fr:ppa:case:ouverture-timing-2026")) { origin case_input; }
        assert "ppa-03": condition_mensuelle(entity_ref("urn:fr:ppa:case:ouverture-timing-2026"), @2026-06-01, BENEFICIAIRE, COND_L8422_1) { origin case_input; }
        assert "ppa-04": condition_mensuelle(entity_ref("urn:fr:ppa:case:ouverture-timing-2026"), @2026-06-01, BENEFICIAIRE, COND_L8422_2) { origin case_input; }
        assert "ppa-05": condition_mensuelle(entity_ref("urn:fr:ppa:case:ouverture-timing-2026"), @2026-02-01, BENEFICIAIRE, COND_L8422_3) { origin case_input; }
        assert "ppa-06": condition_mensuelle(entity_ref("urn:fr:ppa:case:ouverture-timing-2026"), @2026-03-01, BENEFICIAIRE, COND_L8422_3) { origin case_input; }
        assert "ppa-07": condition_mensuelle(entity_ref("urn:fr:ppa:case:ouverture-timing-2026"), @2026-04-01, BENEFICIAIRE, COND_L8422_3) { origin case_input; }
        assert "ppa-08": condition_mensuelle(entity_ref("urn:fr:ppa:case:ouverture-timing-2026"), @2026-02-01, BENEFICIAIRE, COND_L8422_5) { origin case_input; }
        assert "ppa-09": condition_mensuelle(entity_ref("urn:fr:ppa:case:ouverture-timing-2026"), @2026-03-01, BENEFICIAIRE, COND_L8422_5) { origin case_input; }
        assert "ppa-10": condition_mensuelle(entity_ref("urn:fr:ppa:case:ouverture-timing-2026"), @2026-04-01, BENEFICIAIRE, COND_L8422_5) { origin case_input; }
        assert "ppa-11": condition_mensuelle(entity_ref("urn:fr:ppa:case:ouverture-timing-2026"), @2026-02-01, BENEFICIAIRE, COND_L8421) { origin case_input; }
        assert "ppa-12": condition_mensuelle(entity_ref("urn:fr:ppa:case:ouverture-timing-2026"), @2026-03-01, BENEFICIAIRE, COND_L8421) { origin case_input; }
        assert "ppa-13": condition_mensuelle(entity_ref("urn:fr:ppa:case:ouverture-timing-2026"), @2026-04-01, BENEFICIAIRE, COND_L8421) { origin case_input; }
        assert "ppa-14": condition_mensuelle(entity_ref("urn:fr:ppa:case:ouverture-timing-2026"), @2026-06-01, BENEFICIAIRE, COND_L8421) { origin case_input; }
        assert "ppa-15": condition_mensuelle(entity_ref("urn:fr:ppa:case:ouverture-timing-2026"), @2026-02-01, BENEFICIAIRE, COND_L8422_4) { origin case_input; }
        assert "ppa-16": condition_mensuelle(entity_ref("urn:fr:ppa:case:ouverture-timing-2026"), @2026-03-01, BENEFICIAIRE, COND_L8422_4) { origin case_input; }
        assert "ppa-17": condition_mensuelle(entity_ref("urn:fr:ppa:case:ouverture-timing-2026"), @2026-04-01, BENEFICIAIRE, COND_L8422_4) { origin case_input; }
        assert "ppa-18": condition_mensuelle(entity_ref("urn:fr:ppa:case:ouverture-timing-2026"), @2026-06-01, BENEFICIAIRE, COND_L8422_4) { origin case_input; }
    }
    evaluate truth(conditions_beneficiaire_ok(entity_ref("urn:fr:ppa:case:ouverture-timing-2026"), @2026-06-01));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(conditions_temporelles_ok(entity_ref("urn:fr:ppa:case:ouverture-timing-2026"), @2026-06-01));
