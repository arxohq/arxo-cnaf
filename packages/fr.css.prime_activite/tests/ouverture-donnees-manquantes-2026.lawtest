// Unknown caisse and household (PA-R4-03): a June 2026 review
// without any scheme or spouse evidence classifies neither the
// applicable wording nor the household branch (R.842-2, NOTA 2025-185).
language "law.core" version "0.2";
package fr.css.prime_activite version "0.1.0";
namespace "urn:fr:corpus:clir:ppa";

test "urn:query:fr-ppa-ouverture-donnees-manquantes-2026" {
    given {
        context { deadline_policy PPA_MOIS; decision_time @2026-07-15T12:00:00Z; knowledge_time @2026-07-15T12:00:00Z; legal_time @2026-07-15; timezone "Europe/Paris"; }
        assert "ppa-01": mois_revue(entity_ref("urn:fr:ppa:case:ouverture-donnees-manquantes-2026"), @2026-06-01) { origin case_input; }
        assert "ppa-02": mois_du_droit(entity_ref("urn:fr:ppa:case:ouverture-donnees-manquantes-2026"), @2026-06-01) { origin case_input; }
    }
    evaluate truth(dispositions_nouvelles_2025(entity_ref("urn:fr:ppa:case:ouverture-donnees-manquantes-2026"), @2026-06-01));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(dispositions_anciennes_2025(entity_ref("urn:fr:ppa:case:ouverture-donnees-manquantes-2026"), @2026-06-01));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(conditions_temporelles_ok(entity_ref("urn:fr:ppa:case:ouverture-donnees-manquantes-2026"), @2026-06-01));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
