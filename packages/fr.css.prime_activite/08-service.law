    key(d);
    label fr official "salarié agricole, exploitant ou artisan rural (R. 846-6; fait retenu)";
    label en unofficial "farm employee, operator or rural craft worker (R. 846-6; retained fact)";
}

pub relation pf_versee_par_caf(d: Demandeur) kind empirical {
    key(d);
    label fr official "prestations familiales versées par la CAF (R. 846-6; fait retenu)";
    label en unofficial "family benefits paid by the CAF (R. 846-6; retained fact)";
}

pub relation organisme_competent_msa(d: Demandeur) kind institutional {
    key(d);
    label fr official "service par la MSA (R. 846-6)";
    label en unofficial "served by the MSA (R. 846-6)";
}

