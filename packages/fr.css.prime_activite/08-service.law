pub relation seuil_non_versement(seuil: Money) kind institutional {
    key();
    label fr official "montant en dessous duquel la prime n'est pas versée: 15 euros (D. 846-2)";
    label en unofficial "amount below which the bonus is not paid: 15 euros (D. 846-2)";
}

@source(
    CSS_D846_2_ED2021_01_01,
    CSS_D846_2_ED2021_03_25,
    CSS_D846_2_ED2021_06_01,
    CSS_D846_2_ED2022_03_21,
    CSS_D846_2_ED2023_12_31,
    CSS_D846_2_ED2024_01_01,
    CSS_D846_2_ED2024_07_01,
    CSS_D846_2_ED2025_01_01,
    CSS_D846_2_ED2025_02_28,
    CSS_D846_2_ED2025_03_31,
    CSS_D846_2_ED2026_04_01,
    CSS_D846_2_ED2026_06_27)
rule Seuil15() strict {
    effective [@2021-01-01, infinity);
    label fr official "non-versement sous 15 euros (D. 846-2)";
    label en unofficial "no payment under 15 euros (D. 846-2)";
    when true;
    then seuil_non_versement(15.00 EUR);
}

pub relation demande_teleservice(d: Demandeur, date: Date) kind empirical {
    key(d);
    label fr official "demande par le téléservice (R. 846-1; fait retenu)";
    label en unofficial "request via the online service (R. 846-1; retained fact)";
}

pub relation demande_formulaire(d: Demandeur, date: Date) kind empirical {
    key(d);
    label fr official "demande par formulaire R. 846-1 (R. 846-1; fait retenu)";
    label en unofficial "request on the R. 846-1 form (R. 846-1; retained fact)";
}

pub relation declaration_activite_rsa(d: Demandeur, date: Date) kind empirical {
    key(d);
    label fr official "déclaration d'activité du bénéficiaire du RSA, valant demande (R. 846-1; fait retenu)";
    label en unofficial "RSA payee activity declaration counting as a request (R. 846-1; retained fact)";
}

pub relation demande_valide(d: Demandeur, date: Date) kind institutional {
    key(d);
    label fr official "demande valablement formée (R. 846-1)";
    label en unofficial "validly filed request (R. 846-1)";
}

@source(
    CSS_R846_1_ED2021_01_01,
    CSS_R846_1_ED2021_03_25,
    CSS_R846_1_ED2021_06_01,
    CSS_R846_1_ED2022_03_21,
    CSS_R846_1_ED2023_12_31,
    CSS_R846_1_ED2024_01_01,
    CSS_R846_1_ED2024_07_01,
    CSS_R846_1_ED2025_01_01,
    CSS_R846_1_ED2025_02_28,
    CSS_R846_1_ED2025_03_31,
    CSS_R846_1_ED2026_04_01,
    CSS_R846_1_ED2026_06_27)
rule DemandeTeleservice(d: Demandeur, date: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "demande par téléservice (R. 846-1)";
    label en unofficial "online-service request (R. 846-1)";
    when demande_teleservice(d, date);
    then demande_valide(d, date);
}

@source(
    CSS_R846_1_ED2021_01_01,
    CSS_R846_1_ED2021_03_25,
    CSS_R846_1_ED2021_06_01,
