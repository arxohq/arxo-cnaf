rule MSASalarieRural(d: Demandeur) strict {
    effective [@2021-01-01, infinity);
    label fr official "salarié/exploitant/artisan rural hors PF CAF: MSA (R. 846-6)";
    label en unofficial "rural worker outside CAF benefits: MSA (R. 846-6)";
    when regime_agricole_salarie_ou_rural(d) and pf_non_versee_par_caf(d)
        and not_known(pf_versee_par_caf(d));
    then organisme_competent_msa(d);
}

pub relation hospitalisation_prise_en_charge(d: Demandeur) kind empirical {
    key(d);
    label fr official "hospitalisation avec prise en charge (R. 846-7; fait retenu)";
    label en unofficial "hospital stay with coverage (R. 846-7; retained fact)";
}

pub relation hospitalisation_en_cours(d: Demandeur) kind empirical {
    key(d);
    label fr official "séjour hospitalier effectif en cours (R. 846-7; fait retenu)";
    label en unofficial "effective hospital stay ongoing (R. 846-7; retained fact)";
}

pub relation deuxieme_revision_depassee(d: Demandeur) kind empirical {
    key(d);
    label fr official "deuxième révision périodique depuis le début dépassée (R. 846-7; fait retenu)";
    label en unofficial "second periodic revision since the start passed (R. 846-7; retained fact)";
}

pub relation grossesse_en_cours(d: Demandeur) kind empirical {
    key(d);
    label fr official "femme en état de grossesse (R. 846-7; fait retenu)";
    label en unofficial "pregnant woman (R. 846-7; retained fact)";
}

pub relation fin_hospitalisation(d: Demandeur) kind empirical {
    key(d);
    label fr official "fin de l'hospitalisation (R. 846-7; fait retenu)";
    label en unofficial "end of the hospital stay (R. 846-7; retained fact)";
}

pub relation grossesse_non_en_cours(d: Demandeur) kind empirical {
    key(d);
    label fr official "pas d'état de grossesse constaté (R. 846-7; fait retenu)";
    label en unofficial "no pregnancy state recorded (R. 846-7; retained fact)";
}

pub relation prise_en_charge_active(d: Demandeur) kind empirical {
    key(d);
    label fr official "prise en charge par l'assurance maladie active sur la période réduite (R. 846-7; fait retenu)";
    label en unofficial "health-insurance coverage active over the reduced period (R. 846-7; retained fact)";
}

pub relation suspension_prise_en_charge(d: Demandeur) kind empirical {
    key(d);
    label fr official "suspension de la prise en charge par l'assurance maladie sur la période (R. 846-7; fait retenu)";
    label en unofficial "suspension of health-insurance coverage over the period (R. 846-7; retained fact)";
}

pub relation reexamen_periodique_apres_hospitalisation(d: Demandeur) kind empirical {
    key(d);
    label fr official "réexamen périodique suivant la fin de l'hospitalisation survenu (R. 846-7; fait retenu)";
    label en unofficial "periodic review following the end of hospitalisation reached (R. 846-7; retained fact)";
}

pub relation prime_reduite_hospitalisation(d: Demandeur, montant: Money) kind institutional {
    key(d);
    label fr official "prime réduite de moitié à l'hospitalisation (R. 846-7)";
    label en unofficial "bonus halved during hospitalisation (R. 846-7)";
}

pub relation reprise_taux_plein_hospitalisation(d: Demandeur) kind institutional {
    key(d);
    label fr official "rétablissement sans nouvelle demande au réexamen suivant la sortie (R. 846-7)";
    label en unofficial "restoration without a new request at the review after discharge (R. 846-7)";
}

@source(
    CSS_R846_7_ED2021_01_01,
    CSS_R846_7_ED2021_03_25,
    CSS_R846_7_ED2021_06_01,
    CSS_R846_7_ED2022_03_21,
    CSS_R846_7_ED2023_12_31,
    CSS_R846_7_ED2024_01_01,
    CSS_R846_7_ED2024_07_01,
    CSS_R846_7_ED2025_01_01,
    CSS_R846_7_ED2025_02_28,
    CSS_R846_7_ED2025_03_31,
    CSS_R846_7_ED2026_04_01,
    CSS_R846_7_ED2026_06_27)
rule ReductionHospitalisation(d: Demandeur, p: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "hospitalisé isolé hors grossesse, couverture active: moitié dès la deuxième révision (R. 846-7)";
    label en unofficial "isolated hospitalised outside pregnancy, active coverage: half from the second revision (R. 846-7)";
    when hospitalisation_prise_en_charge(d) and deuxieme_revision_depassee(d)
        and hospitalisation_en_cours(d)
        and foyer_sans_conjoint_ni_charge(d)
        and not_known(foyer_avec_conjoint_pacs_concubin_ou_charge(d))
        and prise_en_charge_active(d)
        and not_known(suspension_prise_en_charge(d))
        and grossesse_non_en_cours(d)
        and not_known(grossesse_en_cours(d))
        and prime_due_trimestre(d, p);
    then prime_reduite_hospitalisation(d, p * 0.5);
}

// D-42: affirmative refutations of the R. 846-7 half-rate. A failed
// not_known guard leaves NEITHER, never FALSE; each excepting fact of
// the text is written as an explicit contrary: «n'est pas applicable
// aux personnes en état de grossesse» (al. 1), the household gate
// «qui n'a ni conjoint, ni partenaire ..., ni concubin, ni personne à
// charge» (al. 1), «à l'exclusion des périodes de suspension de la
// prise en charge» (al. 2).
@source(
    CSS_R846_7_ED2021_01_01,
    CSS_R846_7_ED2021_03_25,
    CSS_R846_7_ED2021_06_01,
    CSS_R846_7_ED2022_03_21,
    CSS_R846_7_ED2023_12_31,
    CSS_R846_7_ED2024_01_01,
    CSS_R846_7_ED2024_07_01,
    CSS_R846_7_ED2025_01_01,
    CSS_R846_7_ED2025_02_28,
    CSS_R846_7_ED2025_03_31,
    CSS_R846_7_ED2026_04_01,
    CSS_R846_7_ED2026_06_27)
rule ReductionRefuteeGrossesse(d: Demandeur, p: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "grossesse: pas de réduction hospitalière (R. 846-7 al. 1)";
    label en unofficial "pregnancy: no hospital reduction (R. 846-7 para 1)";
    when hospitalisation_en_cours(d) and grossesse_en_cours(d)
        and prime_due_trimestre(d, p);
    then not prime_reduite_hospitalisation(d, p * 0.5);
}

@source(
    CSS_R846_7_ED2021_01_01,
    CSS_R846_7_ED2021_03_25,
    CSS_R846_7_ED2021_06_01,
    CSS_R846_7_ED2022_03_21,
    CSS_R846_7_ED2023_12_31,
    CSS_R846_7_ED2024_01_01,
    CSS_R846_7_ED2024_07_01,
    CSS_R846_7_ED2025_01_01,
    CSS_R846_7_ED2025_02_28,
    CSS_R846_7_ED2025_03_31,
    CSS_R846_7_ED2026_04_01,
    CSS_R846_7_ED2026_06_27)
rule ReductionRefuteeFoyer(d: Demandeur, p: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "conjoint/PACS/concubin/personne à charge: pas de réduction hospitalière (R. 846-7 al. 1)";
    label en unofficial "spouse/PACS/concubin/dependent: no hospital reduction (R. 846-7 para 1)";
    when hospitalisation_en_cours(d)
        and foyer_avec_conjoint_pacs_concubin_ou_charge(d)
        and prime_due_trimestre(d, p);
    then not prime_reduite_hospitalisation(d, p * 0.5);
}

@source(
    CSS_R846_7_ED2021_01_01,
    CSS_R846_7_ED2021_03_25,
    CSS_R846_7_ED2021_06_01,
    CSS_R846_7_ED2022_03_21,
    CSS_R846_7_ED2023_12_31,
    CSS_R846_7_ED2024_01_01,
    CSS_R846_7_ED2024_07_01,
    CSS_R846_7_ED2025_01_01,
    CSS_R846_7_ED2025_02_28,
    CSS_R846_7_ED2025_03_31,
    CSS_R846_7_ED2026_04_01,
    CSS_R846_7_ED2026_06_27)
rule ReductionRefuteeSuspensionPriseEnCharge(d: Demandeur, p: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "prise en charge suspendue: pas de réduction sur la période (R. 846-7 al. 2)";
    label en unofficial "coverage suspended: no reduction over the period (R. 846-7 para 2)";
    when hospitalisation_en_cours(d) and suspension_prise_en_charge(d)
        and prime_due_trimestre(d, p);
    then not prime_reduite_hospitalisation(d, p * 0.5);
}

@source(
    CSS_R846_7_ED2021_01_01,
    CSS_R846_7_ED2021_03_25,
    CSS_R846_7_ED2021_06_01,
    CSS_R846_7_ED2022_03_21,
    CSS_R846_7_ED2023_12_31,
    CSS_R846_7_ED2024_01_01,
    CSS_R846_7_ED2024_07_01,
    CSS_R846_7_ED2025_01_01,
    CSS_R846_7_ED2025_02_28,
    CSS_R846_7_ED2025_03_31,
    CSS_R846_7_ED2026_04_01,
    CSS_R846_7_ED2026_06_27)
rule RepriseHospitalisation(d: Demandeur) strict {
    effective [@2021-01-01, infinity);
    label fr official "rétablissement au réexamen suivant la fin, sans nouvelle demande (R. 846-7)";
    label en unofficial "restoration at the review following discharge, no new request (R. 846-7)";
    when fin_hospitalisation(d) and reexamen_periodique_apres_hospitalisation(d);
    then reprise_taux_plein_hospitalisation(d);
}

pub relation incarceration_en_cours(d: Demandeur) kind empirical {
    key(d);
    label fr official "incarcération en cours (R. 846-8; fait retenu)";
    label en unofficial "ongoing imprisonment (R. 846-8; retained fact)";
}

pub relation deuxieme_reexamen_depasse(d: Demandeur) kind empirical {
    key(d);
    label fr official "deuxième réexamen trimestriel dépassé (R. 846-8; fait retenu)";
    label en unofficial "second quarterly re-examination passed (R. 846-8; retained fact)";
}

pub relation foyer_avec_famille(d: Demandeur) kind empirical {
    key(d);
    label fr official "vit avec sa famille ou des cohabitants, sans qualification de conjoint, partenaire PACS, concubin ou personne à charge (fait retenu générique ; ne qualifie pas R. 846-7/8)";
    label en unofficial "lives with family members or co-residents, with no spouse, PACS partner, concubin or dependent qualification (generic retained fact; does not qualify R. 846-7/8)";
}

pub relation foyer_avec_conjoint_pacs_concubin_ou_charge(d: Demandeur) kind empirical {
    key(d);
    label fr official "a un conjoint, un partenaire lié par un pacte civil de solidarité, un concubin ou une personne à charge (R. 846-7/8 ; fait retenu qualifiant)";
    label en unofficial "has a spouse, PACS partner, concubin or dependent (R. 846-7/8; qualifying retained fact)";
}

pub relation foyer_sans_conjoint_ni_charge(d: Demandeur) kind empirical {
    key(d);
    label fr official "ni conjoint, ni partenaire PACS, ni concubin, ni personne à charge (R. 846-7/8; fait retenu)";
    label en unofficial "no spouse, PACS partner, concubin or dependent (R. 846-7/8; retained fact)";
}

pub relation majo_isolee_avec_enfant(d: Demandeur) kind empirical {
    key(d);
    label fr official "majoré isolé avec enfant à charge (R. 846-8; fait retenu)";
    label en unofficial "isolated-major amount with a dependent child (R. 846-8; retained fact)";
}

pub relation fin_incarceration(d: Demandeur) kind empirical {
    key(d);
    label fr official "fin de l'incarcération (R. 846-8; fait retenu)";
    label en unofficial "end of imprisonment (R. 846-8; retained fact)";
}

pub relation reexamen_periodique_apres_incarceration(d: Demandeur) kind empirical {
    key(d);
    label fr official "réexamen périodique du droit suivant la fin de l'incarcération survenu (R. 846-8; fait retenu)";
    label en unofficial "periodic review of the right following release reached (R. 846-8; retained fact)";
}

pub relation sans_majo_isolee_avec_enfant(d: Demandeur) kind empirical {
    key(d);
    label fr official "pas de majoration L. 842-7 avec enfant à charge conservé (R. 846-8; fait retenu)";
    label en unofficial "no L. 842-7 majoration with a kept dependent child (R. 846-8; retained fact)";
}

pub relation prime_suspendue_incarceration(d: Demandeur) kind institutional {
    key(d);
    label fr official "versement suspendu à l'incarcération (R. 846-8)";
    label en unofficial "payment suspended during imprisonment (R. 846-8)";
}

pub relation droits_reexamines_sans_beneficiaire(d: Demandeur) kind institutional {
    key(d);
    label fr official "droits réexaminés sans le bénéficiaire, conjoint/PACS/concubin/charge (R. 846-8 al. 2)";
    label en unofficial "rights re-examined without the payee, spouse/PACS/concubin/dependent (R. 846-8 para 2)";
}

pub relation reprise_apres_incarceration(d: Demandeur) kind institutional {
    key(d);
    label fr official "reprise au réexamen périodique suivant la fin de l'incarcération (R. 846-8)";
    label en unofficial "resumption at the periodic review after release (R. 846-8)";
}

@source(
    CSS_R846_8_ED2021_01_01,
    CSS_R846_8_ED2021_03_25,
    CSS_R846_8_ED2021_06_01,
    CSS_R846_8_ED2022_03_21,
    CSS_R846_8_ED2023_12_31,
    CSS_R846_8_ED2024_01_01,
    CSS_R846_8_ED2024_07_01,
    CSS_R846_8_ED2025_01_01,
    CSS_R846_8_ED2025_02_28,
    CSS_R846_8_ED2025_03_31,
    CSS_R846_8_ED2026_04_01,
    CSS_R846_8_ED2026_06_27)
rule SuspensionIncarceration(d: Demandeur) strict {
    effective [@2021-01-01, infinity);
    label fr official "incarcéré isolé hors majoré isolé: suspension dès le deuxième réexamen (R. 846-8 al. 1)";
    label en unofficial "isolated imprisoned outside isolated-major: suspension from the second review (R. 846-8 para 1)";
    when incarceration_en_cours(d) and deuxieme_reexamen_depasse(d)
        and foyer_sans_conjoint_ni_charge(d)
        and not_known(foyer_avec_conjoint_pacs_concubin_ou_charge(d))
        and sans_majo_isolee_avec_enfant(d)
        and not_known(majo_isolee_avec_enfant(d));
    then prime_suspendue_incarceration(d);
}

// D-42: affirmative refutations of the R. 846-8 branches. A failed
// not_known guard leaves NEITHER, never FALSE: the suspension (al. 1)
// is barred by the qualifying union «a un conjoint, un partenaire ...,
// un concubin ou une personne à charge» (al. 2) and by the al. 4
// exception «conservant un enfant à charge, ont droit à la majoration
// mentionnée à l'article L. 842-7»; the family examination (al. 2) is
// barred by the no-family record (al. 1) and by the same al. 4
// exception.
@source(
    CSS_R846_8_ED2021_01_01,
    CSS_R846_8_ED2021_03_25,
    CSS_R846_8_ED2021_06_01,
    CSS_R846_8_ED2022_03_21,
    CSS_R846_8_ED2023_12_31,
    CSS_R846_8_ED2024_01_01,
    CSS_R846_8_ED2024_07_01,
    CSS_R846_8_ED2025_01_01,
    CSS_R846_8_ED2025_02_28,
    CSS_R846_8_ED2025_03_31,
    CSS_R846_8_ED2026_04_01,
    CSS_R846_8_ED2026_06_27)
rule SuspensionRefuteeFoyer(d: Demandeur) strict {
    effective [@2021-01-01, infinity);
    label fr official "incarcéré avec conjoint/PACS/concubin/personne à charge: pas de suspension (R. 846-8 al. 1-2)";
    label en unofficial "imprisoned with spouse/PACS/concubin/dependent: no suspension (R. 846-8 paras 1-2)";
    when incarceration_en_cours(d)
        and foyer_avec_conjoint_pacs_concubin_ou_charge(d);
    then not prime_suspendue_incarceration(d);
}

@source(
    CSS_R846_8_ED2021_01_01,
    CSS_R846_8_ED2021_03_25,
    CSS_R846_8_ED2021_06_01,
    CSS_R846_8_ED2022_03_21,
    CSS_R846_8_ED2023_12_31,
    CSS_R846_8_ED2024_01_01,
    CSS_R846_8_ED2024_07_01,
    CSS_R846_8_ED2025_01_01,
    CSS_R846_8_ED2025_02_28,
    CSS_R846_8_ED2025_03_31,
    CSS_R846_8_ED2026_04_01,
    CSS_R846_8_ED2026_06_27)
rule SuspensionRefuteeMajoration(d: Demandeur) strict {
    effective [@2021-01-01, infinity);
    label fr official "majoration L. 842-7 avec enfant à charge conservé: pas de suspension (R. 846-8 al. 4)";
    label en unofficial "L. 842-7 majoration with a kept dependent child: no suspension (R. 846-8 para 4)";
    when incarceration_en_cours(d) and majo_isolee_avec_enfant(d);
    then not prime_suspendue_incarceration(d);
}

@source(
    CSS_R846_8_ED2021_01_01,
    CSS_R846_8_ED2021_03_25,
    CSS_R846_8_ED2021_06_01,
    CSS_R846_8_ED2022_03_21,
    CSS_R846_8_ED2023_12_31,
    CSS_R846_8_ED2024_01_01,
    CSS_R846_8_ED2024_07_01,
    CSS_R846_8_ED2025_01_01,
    CSS_R846_8_ED2025_02_28,
    CSS_R846_8_ED2025_03_31,
    CSS_R846_8_ED2026_04_01,
    CSS_R846_8_ED2026_06_27)
rule ReexamenSansBeneficiaire(d: Demandeur) strict {
    effective [@2021-01-01, infinity);
    label fr official "conjoint/PACS/concubin/charge, hors majoré isolé: réexamen sans le bénéficiaire au terme du délai (R. 846-8 al. 2)";
    label en unofficial "spouse/PACS/concubin/dependent, outside isolated-major: re-examination without the payee at the end of the period (R. 846-8 para 2)";
    when incarceration_en_cours(d) and deuxieme_reexamen_depasse(d)
        and foyer_avec_conjoint_pacs_concubin_ou_charge(d)
        and not_known(foyer_sans_conjoint_ni_charge(d))
        and sans_majo_isolee_avec_enfant(d)
        and not_known(majo_isolee_avec_enfant(d));
    then droits_reexamines_sans_beneficiaire(d);
}

@source(
    CSS_R846_8_ED2021_01_01,
    CSS_R846_8_ED2021_03_25,
    CSS_R846_8_ED2021_06_01,
    CSS_R846_8_ED2022_03_21,
    CSS_R846_8_ED2023_12_31,
    CSS_R846_8_ED2024_01_01,
    CSS_R846_8_ED2024_07_01,
    CSS_R846_8_ED2025_01_01,
    CSS_R846_8_ED2025_02_28,
    CSS_R846_8_ED2025_03_31,
    CSS_R846_8_ED2026_04_01,
    CSS_R846_8_ED2026_06_27)
rule ReexamenRefuteIsole(d: Demandeur) strict {
    effective [@2021-01-01, infinity);
    label fr official "incarcéré sans conjoint ni personne à charge: pas d'examen des droits des autres (R. 846-8 al. 2)";
    label en unofficial "imprisoned without spouse or dependent: no examination of others' rights (R. 846-8 para 2)";
    when incarceration_en_cours(d) and foyer_sans_conjoint_ni_charge(d);
    then not droits_reexamines_sans_beneficiaire(d);
}

@source(
    CSS_R846_8_ED2021_01_01,
    CSS_R846_8_ED2021_03_25,
    CSS_R846_8_ED2021_06_01,
    CSS_R846_8_ED2022_03_21,
    CSS_R846_8_ED2023_12_31,
    CSS_R846_8_ED2024_01_01,
    CSS_R846_8_ED2024_07_01,
    CSS_R846_8_ED2025_01_01,
    CSS_R846_8_ED2025_02_28,
    CSS_R846_8_ED2025_03_31,
    CSS_R846_8_ED2026_04_01,
    CSS_R846_8_ED2026_06_27)
rule ReexamenRefuteMajoration(d: Demandeur) strict {
    effective [@2021-01-01, infinity);
    label fr official "majoration L. 842-7 avec enfant à charge conservé: pas d'examen sans le bénéficiaire (R. 846-8 al. 4)";
    label en unofficial "L. 842-7 majoration with a kept dependent child: no examination without the payee (R. 846-8 para 4)";
    when incarceration_en_cours(d) and majo_isolee_avec_enfant(d);
    then not droits_reexamines_sans_beneficiaire(d);
}

@source(
    CSS_R846_8_ED2021_01_01,
    CSS_R846_8_ED2021_03_25,
    CSS_R846_8_ED2021_06_01,
    CSS_R846_8_ED2022_03_21,
    CSS_R846_8_ED2023_12_31,
    CSS_R846_8_ED2024_01_01,
    CSS_R846_8_ED2024_07_01,
    CSS_R846_8_ED2025_01_01,
    CSS_R846_8_ED2025_02_28,
    CSS_R846_8_ED2025_03_31,
    CSS_R846_8_ED2026_04_01,
    CSS_R846_8_ED2026_06_27)
rule RepriseIncarceration(d: Demandeur) strict {
    effective [@2021-01-01, infinity);
    label fr official "reprise au réexamen périodique suivant la fin de l'incarcération (R. 846-8 al. 3)";
    label en unofficial "resumption at the periodic review after release (R. 846-8 para 3)";
    when fin_incarceration(d) and reexamen_periodique_apres_incarceration(d);
    then reprise_apres_incarceration(d);
}

pub relation operations_centralisees(o: Organisme) kind empirical {
    key(o);
    label fr official "opérations financières et comptables centralisées (R. 846-9; fait retenu)";
    label en unofficial "financial and accounting operations centralised (R. 846-9; retained fact)";
}

pub relation centralisation_assuree(o: Organisme) kind institutional {
    key(o);
    label fr official "centralisation CNAF/CCMSA assurée (R. 846-9)";
    label en unofficial "CNAF/CCMSA centralisation in place (R. 846-9)";
}

@source(
    CSS_R846_9_ED2021_01_01,
    CSS_R846_9_ED2021_03_25,
    CSS_R846_9_ED2021_06_01,
    CSS_R846_9_ED2022_03_21,
    CSS_R846_9_ED2023_12_31,
    CSS_R846_9_ED2024_01_01,
    CSS_R846_9_ED2024_07_01,
    CSS_R846_9_ED2025_01_01,
    CSS_R846_9_ED2025_02_28,
    CSS_R846_9_ED2025_03_31,
    CSS_R846_9_ED2026_04_01,
    CSS_R846_9_ED2026_06_27)
rule CentralisationCnafCCMSA(o: Organisme) strict {
    effective [@2021-01-01, infinity);
    label fr official "CNAF/CCMSA: opérations centralisées (R. 846-9)";
    label en unofficial "CNAF/CCMSA: operations centralised (R. 846-9)";
    when operations_centralisees(o);
    then centralisation_assuree(o);
}
