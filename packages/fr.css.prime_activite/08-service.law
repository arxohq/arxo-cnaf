rule MSANonSalarie(d: Demandeur) strict {
    effective [@2021-01-01, infinity);
    label fr official "non-salarié agricole: MSA (R. 846-6)";
    label en unofficial "non-salaried farm worker: MSA (R. 846-6)";
    when regime_agricole_non_salarie(d);
    then organisme_competent_msa(d);
}

