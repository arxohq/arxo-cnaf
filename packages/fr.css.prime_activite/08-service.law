    CSS_R846_5_ED2025_03_31,
    CSS_R846_5_ED2026_04_01,
    CSS_R846_5_ED2026_06_27)
rule DevoirDeclarerInformations(d: Demandeur, o: Organisme) strict {
    effective [@2021-01-01, infinity);
    label fr official "D4a: le bénéficiaire déclare les informations (R. 846-5)";
    label en unofficial "D4a: the payee declares the information (R. 846-5)";
    when droit_ouvert(d) and organisme_serviteur(o, d);
    then duty DeclarerInformations {
        bearer d;
        beneficiary o;
        maintain informations_declarees(d) during [@2021-01-01, infinity);
    };
}

