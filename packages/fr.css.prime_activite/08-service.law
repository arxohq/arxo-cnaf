    CSS_R846_1_ED2025_03_31,
    CSS_R846_1_ED2026_04_01,
    CSS_R846_1_ED2026_06_27)
rule DemandeFictionRSA(d: Demandeur, date: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "déclaration d'activité RSA valant demande (R. 846-1)";
    label en unofficial "RSA activity declaration counting as a request (R. 846-1)";
    when declaration_activite_rsa(d, date);
    then demande_valide(d, date);
}

pub relation demande_mois(d: Demandeur, mois: Date) kind empirical {
    key(d);
    label fr official "mois civil du dépôt, au premier jour (R. 846-2; fait retenu)";
    label en unofficial "civil month of filing, at the first day (R. 846-2; retained fact)";
}

pub relation droit_du_premier_jour(d: Demandeur, mois: Date) kind institutional {
    key(d);
    label fr official "prime due à compter du premier jour du mois du dépôt (R. 846-2)";
    label en unofficial "bonus due from the first day of the filing month (R. 846-2)";
}

@source(
    CSS_R846_2_ED2021_01_01,
    CSS_R846_2_ED2021_03_25,
    CSS_R846_2_ED2021_06_01,
    CSS_R846_2_ED2022_03_21,
    CSS_R846_2_ED2023_12_31,
    CSS_R846_2_ED2024_01_01,
    CSS_R846_2_ED2024_07_01,
    CSS_R846_2_ED2025_01_01,
    CSS_R846_2_ED2025_02_28,
    CSS_R846_2_ED2025_03_31,
    CSS_R846_2_ED2026_04_01,
    CSS_R846_2_ED2026_06_27)
rule DroitPremierJour(d: Demandeur, mois: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "due à compter du premier jour du mois du dépôt (R. 846-2)";
    label en unofficial "due from the first day of the filing month (R. 846-2)";
    when demande_mois(d, mois);
    then droit_du_premier_jour(d, mois);
}

pub relation versement_mensuel_terme_echu(d: Demandeur) kind institutional {
    key(d);
    label fr official "versement mensuel à terme échu (R. 846-3)";
    label en unofficial "monthly payment in arrears (R. 846-3)";
}

@source(
    CSS_R846_3_ED2021_01_01,
    CSS_R846_3_ED2021_03_25,
    CSS_R846_3_ED2021_06_01,
    CSS_R846_3_ED2022_03_21,
    CSS_R846_3_ED2023_12_31,
    CSS_R846_3_ED2024_01_01,
    CSS_R846_3_ED2024_07_01,
    CSS_R846_3_ED2025_01_01,
    CSS_R846_3_ED2025_02_28,
    CSS_R846_3_ED2025_03_31,
    CSS_R846_3_ED2026_04_01,
    CSS_R846_3_ED2026_06_27)
rule RythmeMensuel(d: Demandeur) strict {
    effective [@2021-01-01, infinity);
    label fr official "droit ouvert: versement mensuel à terme échu (R. 846-3)";
    label en unofficial "open right: monthly payment in arrears (R. 846-3)";
    when droit_ouvert(d);
    then versement_mensuel_terme_echu(d);
}

pub relation pf_rsa_allocataire_role(d: Demandeur, rf: RoleFoyer) kind empirical {
    key(d);
    label fr official "déjà allocataire PF/RSA au rôle indiqué (R. 846-4; fait retenu)";
    label en unofficial "already a PF/RSA payee in the stated role (R. 846-4; retained fact)";
}

pub relation designation_conjointe(d: Demandeur, rf: RoleFoyer) kind empirical {
    key(d);
    label fr official "allocataire désigné d'un commun accord (R. 846-4; fait retenu)";
    label en unofficial "payee designated by mutual agreement (R. 846-4; retained fact)";
}

pub relation modification_designation(d: Demandeur, rf: RoleFoyer, date_prec: Date, date_dem: Date) kind empirical {
    key(d);
    label fr official "remise en cause: désignation précédente et demande (R. 846-4; fait retenu)";
    label en unofficial "reopening: previous designation and request (R. 846-4; retained fact)";
}

pub relation modification_changement_situation(d: Demandeur, rf: RoleFoyer) kind empirical {
    key(d);
    label fr official "remise en cause sur changement de situation (R. 846-4; fait retenu)";
    label en unofficial "reopening on a change of situation (R. 846-4; retained fact)";
}

pub relation changement_situation_foyer(d: Demandeur) kind empirical {
    key(d);
    label fr official "changement de situation du foyer (R. 846-4; fait retenu)";
    label en unofficial "change of the household situation (R. 846-4; retained fact)";
}

pub relation allocataire_designe(d: Demandeur, rf: RoleFoyer) kind institutional {
    key(d);
    label fr official "allocataire de la prime (R. 846-4)";
    label en unofficial "bonus payee (R. 846-4)";
}

pub relation aucun_allocataire_pf_rsa(d: Demandeur) kind empirical {
    key(d);
    label fr official "aucun membre du foyer déjà allocataire au titre des PF ou du RSA (R. 846-4; fait retenu)";
    label en unofficial "no household member already a PF/RSA payee (R. 846-4; retained fact)";
}

pub relation aucune_designation_conjointe(d: Demandeur) kind empirical {
    key(d);
    label fr official "droit d'option non exercé, aucune désignation d'un commun accord (R. 846-4; fait retenu)";
    label en unofficial "option right not exercised, no mutual designation (R. 846-4; retained fact)";
}

@source(
    CSS_R846_4_ED2021_01_01,
    CSS_R846_4_ED2021_03_25,
    CSS_R846_4_ED2021_06_01,
    CSS_R846_4_ED2022_03_21,
    CSS_R846_4_ED2023_12_31,
    CSS_R846_4_ED2024_01_01,
    CSS_R846_4_ED2024_07_01,
    CSS_R846_4_ED2025_01_01,
    CSS_R846_4_ED2025_02_28,
    CSS_R846_4_ED2025_03_31,
    CSS_R846_4_ED2026_04_01,
    CSS_R846_4_ED2026_06_27)
rule AllocatairePFRSA(d: Demandeur, rf: RoleFoyer) strict {
    effective [@2021-01-01, infinity);
    label fr official "déjà allocataire PF/RSA: même allocataire (R. 846-4)";
    label en unofficial "already a PF/RSA payee: same payee (R. 846-4)";
    when pf_rsa_allocataire_role(d, rf);
    then allocataire_designe(d, rf);
}

@source(
    CSS_R846_4_ED2021_01_01,
    CSS_R846_4_ED2021_03_25,
    CSS_R846_4_ED2021_06_01,
    CSS_R846_4_ED2022_03_21,
    CSS_R846_4_ED2023_12_31,
    CSS_R846_4_ED2024_01_01,
    CSS_R846_4_ED2024_07_01,
    CSS_R846_4_ED2025_01_01,
    CSS_R846_4_ED2025_02_28,
    CSS_R846_4_ED2025_03_31,
    CSS_R846_4_ED2026_04_01,
    CSS_R846_4_ED2026_06_27)
rule DesignationSansPFRSA(d: Demandeur, rf: RoleFoyer) strict {
    effective [@2021-01-01, infinity);
    label fr official "sans PF/RSA: désignation commune (R. 846-4)";
    label en unofficial "no PF/RSA: mutual designation (R. 846-4)";
    when designation_conjointe(d, rf)
        and aucun_allocataire_pf_rsa(d)
        and not_known(pf_rsa_allocataire_role(d, BENEFICIAIRE))
        and not_known(pf_rsa_allocataire_role(d, CONJOINT));
    then allocataire_designe(d, rf);
}

@source(
    CSS_R846_4_ED2021_01_01,
    CSS_R846_4_ED2021_03_25,
    CSS_R846_4_ED2021_06_01,
    CSS_R846_4_ED2022_03_21,
    CSS_R846_4_ED2023_12_31,
    CSS_R846_4_ED2024_01_01,
    CSS_R846_4_ED2024_07_01,
    CSS_R846_4_ED2025_01_01,
    CSS_R846_4_ED2025_02_28,
    CSS_R846_4_ED2025_03_31,
    CSS_R846_4_ED2026_04_01,
    CSS_R846_4_ED2026_06_27)
rule DeposantDefaut(d: Demandeur) strict {
    effective [@2021-01-01, infinity);
    label fr official "à défaut: le déposant de la demande (R. 846-4)";
    label en unofficial "otherwise: the filer (R. 846-4)";
    when aucun_allocataire_pf_rsa(d)
        and not_known(pf_rsa_allocataire_role(d, BENEFICIAIRE))
        and not_known(pf_rsa_allocataire_role(d, CONJOINT))
        and aucune_designation_conjointe(d)
        and not_known(designation_conjointe(d, BENEFICIAIRE))
        and not_known(designation_conjointe(d, CONJOINT));
    then allocataire_designe(d, BENEFICIAIRE);
}

@source(
    CSS_R846_4_ED2021_01_01,
    CSS_R846_4_ED2021_03_25,
    CSS_R846_4_ED2021_06_01,
    CSS_R846_4_ED2022_03_21,
    CSS_R846_4_ED2023_12_31,
    CSS_R846_4_ED2024_01_01,
    CSS_R846_4_ED2024_07_01,
    CSS_R846_4_ED2025_01_01,
    CSS_R846_4_ED2025_02_28,
    CSS_R846_4_ED2025_03_31,
    CSS_R846_4_ED2026_04_01,
    CSS_R846_4_ED2026_06_27)
rule ModificationDelai(d: Demandeur, rf: RoleFoyer, dp: Date, dm: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "remise en cause au bout d'un an (R. 846-4)";
    label en unofficial "reopening after one year (R. 846-4)";
    when modification_designation(d, rf, dp, dm)
        and dm >= add_calendar_period(dp, 12 calendar_month)
        and aucun_allocataire_pf_rsa(d)
        and not_known(pf_rsa_allocataire_role(d, BENEFICIAIRE))
        and not_known(pf_rsa_allocataire_role(d, CONJOINT));
    then allocataire_designe(d, rf);
}

@source(
    CSS_R846_4_ED2021_01_01,
    CSS_R846_4_ED2021_03_25,
    CSS_R846_4_ED2021_06_01,
    CSS_R846_4_ED2022_03_21,
    CSS_R846_4_ED2023_12_31,
    CSS_R846_4_ED2024_01_01,
    CSS_R846_4_ED2024_07_01,
    CSS_R846_4_ED2025_01_01,
    CSS_R846_4_ED2025_02_28,
    CSS_R846_4_ED2025_03_31,
    CSS_R846_4_ED2026_04_01,
    CSS_R846_4_ED2026_06_27)
rule ModificationChangement(d: Demandeur, rf: RoleFoyer) strict {
    effective [@2021-01-01, infinity);
    label fr official "remise en cause sur changement de situation (R. 846-4)";
    label en unofficial "reopening on a change of situation (R. 846-4)";
    when modification_changement_situation(d, rf) and changement_situation_foyer(d)
        and aucun_allocataire_pf_rsa(d)
        and not_known(pf_rsa_allocataire_role(d, BENEFICIAIRE))
        and not_known(pf_rsa_allocataire_role(d, CONJOINT));
    then allocataire_designe(d, rf);
}

pub relation informations_declarees(d: Demandeur) kind empirical {
    key(d);
    label fr official "informations relatives au foyer déclarées (R. 846-5; fait retenu)";
    label en unofficial "household information declared (R. 846-5; retained fact)";
}

pub relation changements_declares(d: Demandeur) kind empirical {
    key(d);
    label fr official "changements de situation déclarés (R. 846-5; fait retenu)";
    label en unofficial "situation changes declared (R. 846-5; retained fact)";
}

@source(
    CSS_R846_5_ED2021_01_01,
    CSS_R846_5_ED2021_03_25,
    CSS_R846_5_ED2021_06_01,
