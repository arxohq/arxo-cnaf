rule DevoirDeclarerChangements(d: Demandeur, o: Organisme) strict {
    effective [@2021-01-01, infinity);
    label fr official "D4b: le bénéficiaire déclare les changements (R. 846-5)";
    label en unofficial "D4b: the payee declares changes (R. 846-5)";
    when droit_ouvert(d) and organisme_serviteur(o, d);
    then duty DeclarerChangements {
        bearer d;
        beneficiary o;
        maintain changements_declares(d) during [@2021-01-01, infinity);
    };
}

