    effective [@2021-01-01, infinity);
    label fr official "forfait couple + 1 enfant: +30 % (D. 843-1 al. 1)";
    label en unofficial "couple + 1 child forfait: +30 % (D. 843-1 para. 1)";
    when forfait_base_du_mois(mois, base) and forme_foyer_retenue(d, mois, COUPLE_1E);
    then forfait_majore(d, mois, base * 1.8);
}

