pub interpretation PrimeMoyenneArrondieCentime of CSS_R843_1_ED2026_06_27 {
    status disputed;
    label fr official "lecture : la moyenne trimestrielle des primes mensuelles de la R. 843-1 I, si la division n'est pas exacte, est arrondie au centime, demi vers le haut — pratique des caisses (CNAF) ; le texte de la R. 843-1 ne fixe aucun arrondi";
    label en unofficial "reading: the R. 843-1 I quarterly average of the monthly bonuses, where the division is not exact, is rounded to the centime, half up - fund (CNAF) practice; the text of R. 843-1 states no rounding";
    include LecturePrimeMoyenneArrondie;
    include TrimestreNouveauArrondi;
    include TrimestreAncienArrondi;
}

// --- Reading D-82/D-83: linear bonification (D. 843-2) rounded to the centime ---
//
// D. 843-2 gives the bonification of a worker as a fraction of the single forfait,
// «croissant linéairement» between 59 and 138 (before 2026-04-01: 120) hourly SMIC:
// base x rate x (income - 59 SMIC) / (span x SMIC). The ratio is a Money / Money
// division that is rarely exact; the text states no rounding. The base rules divide
// exactly (INEXACT_DIVISION on a non-terminating ratio). The reading
// BonificationLineaireArrondieCentime (SPEC 152, D-82 / D-83, fund practice) rounds
// the linear bonification of ONE worker, the euro amount base x rate x ratio, to the
// centime, HALF_UP, as ONE division with rounding (the ratio itself is a fraction,
// not rounded: div_round(base x rate x (income - 59 SMIC), span x SMIC, 2, "HALF_UP");
// both money operands are divided by 1 EUR as in fr.apl). The maximum bonification
// (base x rate, no division) and the zero band are not touched.

pub relation lecture_bonification_lineaire_arrondie() kind institutional {
    label fr official "lecture retenue : la bonification linéaire d'un travailleur (D. 843-2) est arrondie au centime (D-82, D-83 ; marqueur de la lecture BonificationLineaireArrondieCentime)";
    label en unofficial "selected reading: the linear bonification of one worker (D. 843-2) is rounded to the centime (D-82, D-83; marker of the reading BonificationLineaireArrondieCentime)";
}

@source(
    CSS_D843_2_ED2026_04_01,
    CSS_D843_2_ED2026_06_27,
    CSS_D843_2_PRE2026_ED2021_01_01,
    CSS_D843_2_PRE2026_ED2021_03_25,
    CSS_D843_2_PRE2026_ED2021_06_01,
    CSS_D843_2_PRE2026_ED2022_03_21,
    CSS_D843_2_PRE2026_ED2023_12_31,
    CSS_D843_2_PRE2026_ED2024_01_01,
    CSS_D843_2_PRE2026_ED2024_07_01,
    CSS_D843_2_PRE2026_ED2025_01_01,
    CSS_D843_2_PRE2026_ED2025_02_28,
    CSS_D843_2_PRE2026_ED2025_03_31)
rule LectureBonificationLineaireArrondie() strict {
    effective [@2021-01-01, infinity);
    label fr official "lecture retenue : la bonification linéaire (D. 843-2) est arrondie au centime (marqueur)";
    label en unofficial "selected reading: the linear bonification (D. 843-2) is rounded to the centime (marker)";
    when true;
    then lecture_bonification_lineaire_arrondie();
}

@source(
    CSS_D843_2_ED2026_04_01,
    CSS_D843_2_ED2026_06_27)
rule BoniLineaire2026Arrondi(d: Demandeur, mois: Date, flux: Integer, rev: Money, smic: Money, base: Money) strict {
    effective [@2026-04-01, infinity);
    label fr official "bonification linéaire entre 59 et 138 SMIC horaires (D. 843-2, décret 2026-222), arrondi au centime (lecture D-82)";
    label en unofficial "linear bonification between 59 and 138 hourly SMIC (D. 843-2, decree 2026-222), rounded to the centime (reading D-82)";
    when revenus_pro_d_un_actif(d, mois, flux, rev) and smic_horaire_retenu(mois, smic)
        and forfait_base_du_mois(mois, base) and rev > smic * 59.0 and rev < smic * 138.0;
    then boni_un_actif(d, mois, flux, div_round(base * 0.377 * ((rev - smic * 59.0) / 1 EUR), (smic * 79.0) / 1 EUR, 2, "HALF_UP"));
}

@source(
    CSS_D843_2_PRE2026_ED2021_01_01,
    CSS_D843_2_PRE2026_ED2021_03_25,
    CSS_D843_2_PRE2026_ED2021_06_01,
    CSS_D843_2_PRE2026_ED2022_03_21,
    CSS_D843_2_PRE2026_ED2023_12_31,
    CSS_D843_2_PRE2026_ED2024_01_01,
    CSS_D843_2_PRE2026_ED2024_07_01,
    CSS_D843_2_PRE2026_ED2025_01_01,
    CSS_D843_2_PRE2026_ED2025_02_28,
    CSS_D843_2_PRE2026_ED2025_03_31)
rule BoniLineairePre2026Arrondi(d: Demandeur, mois: Date, flux: Integer, rev: Money, smic: Money, base: Money) strict {
    effective [@2021-01-01, @2026-04-01);
    label fr official "bonification linéaire entre 59 et 120 SMIC horaires (D. 843-2 avant décret 2026-222), arrondi au centime (lecture D-82)";
    label en unofficial "linear bonification between 59 and 120 hourly SMIC (D. 843-2 before decree 2026-222), rounded to the centime (reading D-82)";
    when revenus_pro_d_un_actif(d, mois, flux, rev) and smic_horaire_retenu(mois, smic)
        and forfait_base_du_mois(mois, base) and rev > smic * 59.0 and rev < smic * 120.0;
    then boni_un_actif(d, mois, flux, div_round(base * 0.29101 * ((rev - smic * 59.0) / 1 EUR), (smic * 61.0) / 1 EUR, 2, "HALF_UP"));
}

@source(
    CSS_D843_2_ED2026_04_01,
    CSS_D843_2_ED2026_06_27,
    CSS_D843_2_PRE2026_ED2021_01_01,
