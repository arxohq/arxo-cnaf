pub interpretation BonificationLineaireArrondieCentime of CSS_D843_2_ED2026_06_27 {
    status disputed;
    label fr official "lecture : la bonification linéaire d'un travailleur (D. 843-2, entre 59 et 138 SMIC horaires, avant le 01.04.2026 entre 59 et 120), si la division n'est pas exacte, est arrondie au centime, demi vers le haut — pratique des caisses (CNAF) ; le texte de la D. 843-2 ne fixe aucun arrondi";
    label en unofficial "reading: the linear bonification of one worker (D. 843-2, between 59 and 138 hourly SMIC, between 59 and 120 before 01.04.2026), where the division is not exact, is rounded to the centime, half up - fund (CNAF) practice; the text of D. 843-2 states no rounding";
    include LectureBonificationLineaireArrondie;
    include BoniLineaire2026Arrondi;
    include BoniLineairePre2026Arrondi;
}
