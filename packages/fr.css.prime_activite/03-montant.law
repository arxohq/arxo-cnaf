}

// --- Fraction (D. 843-3, wording split 2025-03-31) ---

@source(
    CSS_D843_3_PRE2025_ED2021_01_01,
    CSS_D843_3_PRE2025_ED2021_03_25,
    CSS_D843_3_PRE2025_ED2021_06_01,
    CSS_D843_3_PRE2025_ED2022_03_21,
    CSS_D843_3_PRE2025_ED2023_12_31,
    CSS_D843_3_PRE2025_ED2024_01_01,
    CSS_D843_3_PRE2025_ED2024_07_01,
    CSS_D843_3_PRE2025_ED2025_01_01,
    CSS_D843_3_PRE2025_ED2025_02_28)
rule Fraction61() strict {
    effective [@2021-01-01, @2025-03-31);
    label fr official "fraction 61 % (D. 843-3 avant décret 2025-292)";
    label en unofficial "61 % fraction (D. 843-3 before decree 2025-292)";
    when true;
    then fraction_revenus_pro(0.61);
}

@source(
    CSS_D843_3_ED2025_03_31,
    CSS_D843_3_ED2026_04_01,
    CSS_D843_3_ED2026_06_27)
rule Fraction5985() strict {
    effective [@2025-03-31, infinity);
    label fr official "fraction 59,85 % (D. 843-3, décret 2025-292)";
    label en unofficial "59.85 % fraction (D. 843-3, decree 2025-292)";
    when true;
    then fraction_revenus_pro(0.5985);
}

// --- Bonification per worker (D. 843-2) ---
//
// New wording (decree 2026-222, from 2026-04-01): zero at or below 59x
// hourly SMIC, linear to 138x, cap 37.7 % of the single forfait.
// Old wording (2018-2026-03): 120x, cap 29.101 %.

@source(
    CSS_D843_2_ED2026_04_01,
    CSS_D843_2_ED2026_06_27)
rule BoniNulle2026(d: Demandeur, mois: Date, flux: Integer, rev: Money, smic: Money, base: Money) strict {
    effective [@2026-04-01, infinity);
    label fr official "bonification nulle à 59 SMIC horaires ou moins (D. 843-2, décret 2026-222)";
    label en unofficial "zero bonification at or below 59 hourly SMIC (D. 843-2, decree 2026-222)";
    when revenus_pro_d_un_actif(d, mois, flux, rev) and smic_horaire_retenu(mois, smic)
        and forfait_base_du_mois(mois, base) and rev <= smic * 59.0;
    then boni_un_actif(d, mois, flux, 0 EUR);
}

@source(
    CSS_D843_2_ED2026_04_01,
    CSS_D843_2_ED2026_06_27)
rule BoniMax2026(d: Demandeur, mois: Date, flux: Integer, rev: Money, smic: Money, base: Money) strict {
    effective [@2026-04-01, infinity);
    label fr official "bonification maximale 37,7 % dès 138 SMIC horaires (D. 843-2, décret 2026-222)";
    label en unofficial "maximum 37.7 % bonification from 138 hourly SMIC (D. 843-2, decree 2026-222)";
    when revenus_pro_d_un_actif(d, mois, flux, rev) and smic_horaire_retenu(mois, smic)
        and forfait_base_du_mois(mois, base) and rev >= smic * 138.0;
    then boni_un_actif(d, mois, flux, base * 0.377);
}

@source(
    CSS_D843_2_ED2026_04_01,
    CSS_D843_2_ED2026_06_27)
rule BoniLineaire2026(d: Demandeur, mois: Date, flux: Integer, rev: Money, smic: Money, base: Money) strict {
    effective [@2026-04-01, infinity);
    label fr official "bonification linéaire entre 59 et 138 SMIC horaires (D. 843-2, décret 2026-222)";
    label en unofficial "linear bonification between 59 and 138 hourly SMIC (D. 843-2, decree 2026-222)";
    when revenus_pro_d_un_actif(d, mois, flux, rev) and smic_horaire_retenu(mois, smic)
        and forfait_base_du_mois(mois, base) and rev > smic * 59.0 and rev < smic * 138.0 and not_known(lecture_bonification_lineaire_arrondie());
    then boni_un_actif(d, mois, flux, base * 0.377 * ((rev - smic * 59.0) / (smic * 79.0)));
}

@source(
    CSS_D843_2_PRE2026_ED2021_01_01,
    CSS_D843_2_PRE2026_ED2021_03_25,
    CSS_D843_2_PRE2026_ED2021_06_01,
    CSS_D843_2_PRE2026_ED2022_03_21,
    CSS_D843_2_PRE2026_ED2023_12_31,
    CSS_D843_2_PRE2026_ED2024_01_01,
    CSS_D843_2_PRE2026_ED2024_07_01,
    CSS_D843_2_PRE2026_ED2025_01_01,
    CSS_D843_2_PRE2026_ED2025_02_28,
    CSS_D843_2_PRE2026_ED2025_03_31)
rule BoniNullePre2026(d: Demandeur, mois: Date, flux: Integer, rev: Money, smic: Money, base: Money) strict {
    effective [@2021-01-01, @2026-04-01);
    label fr official "bonification nulle à 59 SMIC horaires ou moins (D. 843-2 avant décret 2026-222)";
    label en unofficial "zero bonification at or below 59 hourly SMIC (D. 843-2 before decree 2026-222)";
    when revenus_pro_d_un_actif(d, mois, flux, rev) and smic_horaire_retenu(mois, smic)
        and forfait_base_du_mois(mois, base) and rev <= smic * 59.0;
    then boni_un_actif(d, mois, flux, 0 EUR);
}

@source(
    CSS_D843_2_PRE2026_ED2021_01_01,
    CSS_D843_2_PRE2026_ED2021_03_25,
    CSS_D843_2_PRE2026_ED2021_06_01,
    CSS_D843_2_PRE2026_ED2022_03_21,
    CSS_D843_2_PRE2026_ED2023_12_31,
    CSS_D843_2_PRE2026_ED2024_01_01,
    CSS_D843_2_PRE2026_ED2024_07_01,
    CSS_D843_2_PRE2026_ED2025_01_01,
    CSS_D843_2_PRE2026_ED2025_02_28,
    CSS_D843_2_PRE2026_ED2025_03_31)
rule BoniMaxPre2026(d: Demandeur, mois: Date, flux: Integer, rev: Money, smic: Money, base: Money) strict {
    effective [@2021-01-01, @2026-04-01);
    label fr official "bonification maximale 29,101 % dès 120 SMIC horaires (D. 843-2 avant décret 2026-222)";
    label en unofficial "maximum 29.101 % bonification from 120 hourly SMIC (D. 843-2 before decree 2026-222)";
    when revenus_pro_d_un_actif(d, mois, flux, rev) and smic_horaire_retenu(mois, smic)
        and forfait_base_du_mois(mois, base) and rev >= smic * 120.0;
    then boni_un_actif(d, mois, flux, base * 0.29101);
}

@source(
    CSS_D843_2_PRE2026_ED2021_01_01,
    CSS_D843_2_PRE2026_ED2021_03_25,
    CSS_D843_2_PRE2026_ED2021_06_01,
    CSS_D843_2_PRE2026_ED2022_03_21,
    CSS_D843_2_PRE2026_ED2023_12_31,
    CSS_D843_2_PRE2026_ED2024_01_01,
    CSS_D843_2_PRE2026_ED2024_07_01,
    CSS_D843_2_PRE2026_ED2025_01_01,
    CSS_D843_2_PRE2026_ED2025_02_28,
    CSS_D843_2_PRE2026_ED2025_03_31)
rule BoniLineairePre2026(d: Demandeur, mois: Date, flux: Integer, rev: Money, smic: Money, base: Money) strict {
    effective [@2021-01-01, @2026-04-01);
    label fr official "bonification linéaire entre 59 et 120 SMIC horaires (D. 843-2 avant décret 2026-222)";
    label en unofficial "linear bonification between 59 and 120 hourly SMIC (D. 843-2 before decree 2026-222)";
    when revenus_pro_d_un_actif(d, mois, flux, rev) and smic_horaire_retenu(mois, smic)
        and forfait_base_du_mois(mois, base) and rev > smic * 59.0 and rev < smic * 120.0 and not_known(lecture_bonification_lineaire_arrondie());
    then boni_un_actif(d, mois, flux, base * 0.29101 * ((rev - smic * 59.0) / (smic * 61.0)));
}

// --- Stream-tagged proxies (one worker = one stream) ---
//
// The band rules below fire per income stream. Streams are tagged 0
// (claimant) and 1 (spouse): Integer keys (RSA precedent). Single and
// isolated formes have no spouse by definition of the composition fact,
// so the spouse stream defaults to zero positively per forme — no
// absence test.

pub relation revenus_pro_d_un_actif(d: Demandeur, mois: Date, flux: Integer, rev: Money) kind institutional {
    key(d, mois, flux);
    label fr official "revenus pro d'un travailleur du foyer, flux 0 demandeur / 1 conjoint (D. 843-2)";
    label en unofficial "professional income of one household worker, stream 0 claimant / 1 spouse (D. 843-2)";
}

pub relation boni_un_actif(d: Demandeur, mois: Date, flux: Integer, montant: Money) kind institutional {
    key(d, mois, flux);
    label fr official "bonification d'un travailleur du foyer, flux 0/1 (D. 843-2)";
    label en unofficial "one household worker's bonification, stream 0/1 (D. 843-2)";
}

pub relation revenus_pro_foyer(d: Demandeur, mois: Date, total: Money) kind institutional {
    key(d, mois);
    label fr official "revenus professionnels totaux du foyer (L. 842-3 1°)";
    label en unofficial "total household professional income (L. 842-3 1°)";
}

rule BoniStreamDemandeur(d: Demandeur, mois: Date, rev: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "flux 0: revenus pro du demandeur (D. 843-2)";
    label en unofficial "stream 0: claimant professional income (D. 843-2)";
    when revenus_pro_demandeur(d, mois, rev);
    then revenus_pro_d_un_actif(d, mois, 0, rev);
}

rule BoniStreamConjoint(d: Demandeur, mois: Date, rev: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "flux 1: revenus pro du conjoint (D. 843-2)";
    label en unofficial "stream 1: spouse professional income (D. 843-2)";
    when revenus_pro_conjoint(d, mois, rev);
    then revenus_pro_d_un_actif(d, mois, 1, rev);
}

rule BoniConjointNulSeul(d: Demandeur, mois: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "personne seule: pas de second travailleur (D. 843-1, D. 843-2)";
    label en unofficial "single person: no second worker (D. 843-1, D. 843-2)";
    when forme_foyer_retenue(d, mois, SEUL);
    then boni_un_actif(d, mois, 1, 0 EUR);
}

rule BoniConjointNulIsole(d: Demandeur, mois: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "isolé sans enfant: pas de second travailleur (D. 843-1, D. 843-2)";
    label en unofficial "isolated without child: no second worker (D. 843-1, D. 843-2)";
    when forme_foyer_retenue(d, mois, ISOLE);
    then boni_un_actif(d, mois, 1, 0 EUR);
}

rule BoniConjointNulIsole1E(d: Demandeur, mois: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "isolé + 1 enfant: pas de second travailleur (D. 843-1, D. 843-2)";
    label en unofficial "isolated + 1 child: no second worker (D. 843-1, D. 843-2)";
    when forme_foyer_retenue(d, mois, ISOLE_1E);
    then boni_un_actif(d, mois, 1, 0 EUR);
}

rule BoniConjointNulIsole2E(d: Demandeur, mois: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "isolé + 2 enfants: pas de second travailleur (D. 843-1, D. 843-2)";
    label en unofficial "isolated + 2 children: no second worker (D. 843-1, D. 843-2)";
    when forme_foyer_retenue(d, mois, ISOLE_2E);
    then boni_un_actif(d, mois, 1, 0 EUR);
}

rule BoniFoyer(d: Demandeur, mois: Date, b0: Money, b1: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "bonification du foyer: somme des travailleurs (D. 843-2)";
    label en unofficial "household bonification: sum over workers (D. 843-2)";
    when boni_un_actif(d, mois, 0, b0) and boni_un_actif(d, mois, 1, b1);
    then bonification_mensuelle(d, mois, b0 + b1);
}

rule RevProFoyerSeul(d: Demandeur, mois: Date, r: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "revenus pro du foyer seul (L. 842-3 1°)";
    label en unofficial "single-person household professional income (L. 842-3 1°)";
    when revenus_pro_demandeur(d, mois, r) and forme_foyer_retenue(d, mois, SEUL);
    then revenus_pro_foyer(d, mois, r);
}

rule RevProFoyerIsole(d: Demandeur, mois: Date, r: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "revenus pro du foyer isolé (L. 842-3 1°)";
    label en unofficial "isolated household professional income (L. 842-3 1°)";
    when revenus_pro_demandeur(d, mois, r)
        and forme_foyer_retenue(d, mois, ISOLE);
    then revenus_pro_foyer(d, mois, r);
}

rule RevProFoyerIsole1E(d: Demandeur, mois: Date, r: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "revenus pro du foyer isolé + 1 enfant (L. 842-3 1°)";
    label en unofficial "isolated + 1 child household professional income (L. 842-3 1°)";
    when revenus_pro_demandeur(d, mois, r)
        and forme_foyer_retenue(d, mois, ISOLE_1E);
    then revenus_pro_foyer(d, mois, r);
}

rule RevProFoyerIsole2E(d: Demandeur, mois: Date, r: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "revenus pro du foyer isolé + 2 enfants (L. 842-3 1°)";
    label en unofficial "isolated + 2 children household professional income (L. 842-3 1°)";
    when revenus_pro_demandeur(d, mois, r)
        and forme_foyer_retenue(d, mois, ISOLE_2E);
    then revenus_pro_foyer(d, mois, r);
}

rule RevProFoyerCouple(d: Demandeur, mois: Date, r1: Money, r2: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "revenus pro du foyer en couple: demandeur + conjoint (L. 842-3 1°)";
    label en unofficial "couple household professional income: claimant + spouse (L. 842-3 1°)";
    when revenus_pro_demandeur(d, mois, r1) and revenus_pro_conjoint(d, mois, r2);
    then revenus_pro_foyer(d, mois, r1 + r2);
}

// --- Monthly prime (L. 842-3 1°/2°) ---
//
// Resources are deemed at least equal to the forfait (2°): floor rules.
// The computed difference cannot create a debt: floored at zero.

pub relation ressources_retenues(d: Demandeur, mois: Date, montant: Money) kind institutional {
    key(d, mois);
    label fr official "ressources retenues: plancher forfaitaire L. 842-3 2°";
    label en unofficial "retained resources: L. 842-3 2° forfait floor";
}

pub relation prime_trimestre(d: Demandeur, montant: Money) kind institutional {
    key(d);
    label fr official "moyenne trimestrielle des primes mensuelles (R. 843-1 I, avant seuil)";
    label en unofficial "quarterly average of monthly bonuses (R. 843-1 I, before floor)";
}

deadline policy PPA_MOIS {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}

pub relation mois_revue(d: Demandeur, revue: Date) kind empirical {
    key(d);
    label fr official "mois de la demande ou du réexamen périodique (R. 843-1 I; fait retenu)";
    label en unofficial "month of the claim or periodic review (R. 843-1 I; retained fact)";
}

@source(
    CSS_L842_3_ED2021_01_01,
    CSS_L842_3_ED2021_03_25,
    CSS_L842_3_ED2021_06_01,
    CSS_L842_3_ED2022_03_21,
    CSS_L842_3_ED2023_12_31,
    CSS_L842_3_ED2024_01_01,
    CSS_L842_3_ED2024_07_01,
    CSS_L842_3_ED2025_01_01,
    CSS_L842_3_ED2025_02_28,
    CSS_L842_3_ED2025_03_31,
    CSS_L842_3_ED2026_04_01,
    CSS_L842_3_ED2026_06_27)
rule RessourcesPlancherHaut(d: Demandeur, mois: Date, res: Money, forfait: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "ressources au-dessus du forfait: retenues telles quelles (L. 842-3 2°)";
    label en unofficial "resources above forfait: retained as-is (L. 842-3 2°)";
    when ressources_foyer_mois(d, mois, res) and forfait_majore(d, mois, forfait) and res >= forfait;
    then ressources_retenues(d, mois, res);
}

@source(
    CSS_L842_3_ED2021_01_01,
    CSS_L842_3_ED2021_03_25,
    CSS_L842_3_ED2021_06_01,
    CSS_L842_3_ED2022_03_21,
    CSS_L842_3_ED2023_12_31,
    CSS_L842_3_ED2024_01_01,
    CSS_L842_3_ED2024_07_01,
    CSS_L842_3_ED2025_01_01,
    CSS_L842_3_ED2025_02_28,
    CSS_L842_3_ED2025_03_31,
    CSS_L842_3_ED2026_04_01,
    CSS_L842_3_ED2026_06_27)
rule RessourcesPlancherBas(d: Demandeur, mois: Date, res: Money, forfait: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "ressources sous le forfait: réputées égales au forfait (L. 842-3 2°)";
    label en unofficial "resources below forfait: deemed equal to forfait (L. 842-3 2°)";
    when ressources_foyer_mois(d, mois, res) and forfait_majore(d, mois, forfait) and res < forfait;
    then ressources_retenues(d, mois, forfait);
}

@source(
    CSS_L842_3_ED2021_01_01,
    CSS_L842_3_ED2021_03_25,
    CSS_L842_3_ED2021_06_01,
    CSS_L842_3_ED2022_03_21,
    CSS_L842_3_ED2023_12_31,
    CSS_L842_3_ED2024_01_01,
    CSS_L842_3_ED2024_07_01,
    CSS_L842_3_ED2025_01_01,
    CSS_L842_3_ED2025_02_28,
    CSS_L842_3_ED2025_03_31,
    CSS_L842_3_ED2026_04_01,
    CSS_L842_3_ED2026_06_27)
rule PrimeMensuellePositive(d: Demandeur, mois: Date, f: Money, q: Decimal, rpro: Money, boni: Money, res: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "prime mensuelle: forfait + fraction + bonifications − ressources (L. 842-3)";
    label en unofficial "monthly bonus: forfait + fraction + bonifications − resources (L. 842-3)";
    when forfait_majore(d, mois, f) and fraction_revenus_pro(q) and revenus_pro_foyer(d, mois, rpro)
        and bonification_mensuelle(d, mois, boni) and ressources_retenues(d, mois, res)
        and f + q * rpro + boni - res >= 0 EUR;
    then prime_mensuelle(d, mois, f + q * rpro + boni - res);
}

@source(
    CSS_L842_3_ED2021_01_01,
    CSS_L842_3_ED2021_03_25,
    CSS_L842_3_ED2021_06_01,
    CSS_L842_3_ED2022_03_21,
    CSS_L842_3_ED2023_12_31,
    CSS_L842_3_ED2024_01_01,
    CSS_L842_3_ED2024_07_01,
    CSS_L842_3_ED2025_01_01,
    CSS_L842_3_ED2025_02_28,
    CSS_L842_3_ED2025_03_31,
    CSS_L842_3_ED2026_04_01,
    CSS_L842_3_ED2026_06_27)
rule PrimeMensuelleNulle(d: Demandeur, mois: Date, f: Money, q: Decimal, rpro: Money, boni: Money, res: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "différence négative: pas de dette, prime nulle (L. 842-3)";
    label en unofficial "negative difference: no debt, zero bonus (L. 842-3)";
    when forfait_majore(d, mois, f) and fraction_revenus_pro(q) and revenus_pro_foyer(d, mois, rpro)
        and bonification_mensuelle(d, mois, boni) and ressources_retenues(d, mois, res)
        and f + q * rpro + boni - res < 0 EUR;
    then prime_mensuelle(d, mois, 0 EUR);
}

// --- Trimestre (R. 843-1 I; wording split 2025-02-28) ---
//
// The due amount is the quarterly average; the L. 842-3 payment floor
// applies to the served average.

@source(
    CSS_R843_1_ED2025_02_28,
    CSS_R843_1_ED2025_03_31,
    CSS_R843_1_ED2026_04_01,
    CSS_R843_1_ED2026_06_27)
rule TrimestreNouveau(d: Demandeur, revue: Date, m1: Date, m2: Date, m3: Date, p1: Money, p2: Money, p3: Money) strict {
    effective [@2025-02-28, infinity);
    label fr official "trimestre: moyenne des 4e, 3e et 2e mois précédents (R. 843-1 I)";
    label en unofficial "quarter: average of the 4th, 3rd and 2nd previous months (R. 843-1 I)";
    when mois_revue(d, revue) and prime_mensuelle(d, m1, p1) and prime_mensuelle(d, m2, p2) and prime_mensuelle(d, m3, p3)
        and revue == add_calendar_period(m1, 4 calendar_month)
        and m2 == add_calendar_period(m1, 1 calendar_month)
        and m3 == add_calendar_period(m1, 2 calendar_month) and not_known(lecture_prime_moyenne_arrondie());
    then prime_trimestre(d, (p1 + p2 + p3) / 3.0);
}

@source(
    CSS_R843_1_PRE2025_ED2021_01_01,
    CSS_R843_1_PRE2025_ED2021_03_25,
    CSS_R843_1_PRE2025_ED2021_06_01,
    CSS_R843_1_PRE2025_ED2022_03_21,
    CSS_R843_1_PRE2025_ED2023_12_31,
    CSS_R843_1_PRE2025_ED2024_01_01,
    CSS_R843_1_PRE2025_ED2024_07_01,
    CSS_R843_1_PRE2025_ED2025_01_01)
rule TrimestreAncien(d: Demandeur, revue: Date, m1: Date, m2: Date, m3: Date, p1: Money, p2: Money, p3: Money) strict {
    effective [@2021-01-01, @2025-02-28);
    label fr official "trimestre: moyenne des trois mois précédents (R. 843-1 avant décret 2025-185)";
    label en unofficial "quarter: average of the three previous months (R. 843-1 before decree 2025-185)";
    when mois_revue(d, revue) and prime_mensuelle(d, m1, p1) and prime_mensuelle(d, m2, p2) and prime_mensuelle(d, m3, p3)
        and revue == add_calendar_period(m1, 3 calendar_month)
        and m2 == add_calendar_period(m1, 1 calendar_month)
        and m3 == add_calendar_period(m1, 2 calendar_month) and not_known(lecture_prime_moyenne_arrondie());
    then prime_trimestre(d, (p1 + p2 + p3) / 3.0);
}

@source(
    CSS_L842_3_ED2021_01_01,
    CSS_L842_3_ED2021_03_25,
    CSS_L842_3_ED2021_06_01,
    CSS_L842_3_ED2022_03_21,
    CSS_L842_3_ED2023_12_31,
    CSS_L842_3_ED2024_01_01,
    CSS_L842_3_ED2024_07_01,
    CSS_L842_3_ED2025_01_01,
    CSS_L842_3_ED2025_02_28,
    CSS_L842_3_ED2025_03_31,
    CSS_L842_3_ED2026_04_01,
    CSS_L842_3_ED2026_06_27)
rule PrimeDueSeuil(d: Demandeur, revue: Date, moyenne: Money, seuil: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "moyenne au-dessus du minimal: montant dû servi (L. 842-3 dernier al.)";
    label en unofficial "average above the minimum: due amount served (L. 842-3 last para.)";
    when prime_trimestre(d, moyenne) and minimum_paiement_retenu(revue, seuil) and moyenne >= seuil;
    then prime_due_trimestre(d, moyenne);
}

@source(
    CSS_L842_3_ED2021_01_01,
    CSS_L842_3_ED2021_03_25,
    CSS_L842_3_ED2021_06_01,
    CSS_L842_3_ED2022_03_21,
    CSS_L842_3_ED2023_12_31,
    CSS_L842_3_ED2024_01_01,
    CSS_L842_3_ED2024_07_01,
    CSS_L842_3_ED2025_01_01,
    CSS_L842_3_ED2025_02_28,
    CSS_L842_3_ED2025_03_31,
    CSS_L842_3_ED2026_04_01,
    CSS_L842_3_ED2026_06_27)
rule PrimeDueSousSeuil(d: Demandeur, revue: Date, moyenne: Money, seuil: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "moyenne sous le minimal: prime non versée (L. 842-3 dernier al.)";
    label en unofficial "average below the minimum: bonus not paid (L. 842-3 last para.)";
    when prime_trimestre(d, moyenne) and minimum_paiement_retenu(revue, seuil) and moyenne < seuil;
    then prime_due_trimestre(d, 0 EUR);
}

// --- Reading D-82/D-83: quarterly average (R. 843-1) rounded to the centime ---
//
// R. 843-1 I speaks of the quarterly average of the three monthly primes and
// states NO rounding. The base rules divide exactly: a quotient that does not
// terminate makes the document NON_EXECUTABLE (INEXACT_DIVISION, SPEC 50/18:
// rounding only by an explicit policy). The rounding is not a text of the law but
// a READING (SPEC 152, owner decisions D-82 / D-83, 08.10.2026): the basis is the
// practice of the funds (CNAF), under which the intermediate value (the average of
// the monthly primes, before the L. 842-3 payment floor) is rounded to the centime,
// HALF_UP. Outside any group: unselected it executes nothing and changes no
// answer; selected (context { interpretation fr.css.prime_activite::PrimeMoyenneArrondieCentime; })
// it replaces the exact division by div_round(p1 + p2 + p3, 3.0, 2, "HALF_UP") in both
// wordings of R. 843-1 (M-4..M-2 and the three previous months), and the marker
// silences the exact-division rules (not_known), so the head carries ONE value
// under either choice. It rounds ALWAYS when selected, also where the exact quotient
// is longer than two places (as the funds do).

pub relation lecture_prime_moyenne_arrondie() kind institutional {
    label fr official "lecture retenue : la moyenne trimestrielle des primes mensuelles (R. 843-1 I) est arrondie au centime (D-82, D-83 ; marqueur de la lecture PrimeMoyenneArrondieCentime)";
    label en unofficial "selected reading: the quarterly average of the monthly bonuses (R. 843-1 I) is rounded to the centime (D-82, D-83; marker of the reading PrimeMoyenneArrondieCentime)";
}

@source(
    CSS_R843_1_ED2025_02_28,
    CSS_R843_1_ED2025_03_31,
    CSS_R843_1_ED2026_04_01,
    CSS_R843_1_ED2026_06_27,
    CSS_R843_1_PRE2025_ED2021_01_01,
    CSS_R843_1_PRE2025_ED2021_03_25,
    CSS_R843_1_PRE2025_ED2021_06_01,
    CSS_R843_1_PRE2025_ED2022_03_21,
    CSS_R843_1_PRE2025_ED2023_12_31,
    CSS_R843_1_PRE2025_ED2024_01_01,
    CSS_R843_1_PRE2025_ED2024_07_01,
    CSS_R843_1_PRE2025_ED2025_01_01)
rule LecturePrimeMoyenneArrondie() strict {
    effective [@2021-01-01, infinity);
    label fr official "lecture retenue : la moyenne trimestrielle des primes (R. 843-1 I) est arrondie au centime (marqueur)";
    label en unofficial "selected reading: the quarterly average of the bonuses (R. 843-1 I) is rounded to the centime (marker)";
    when true;
    then lecture_prime_moyenne_arrondie();
}

@source(
    CSS_R843_1_ED2025_02_28,
    CSS_R843_1_ED2025_03_31,
    CSS_R843_1_ED2026_04_01,
    CSS_R843_1_ED2026_06_27)
rule TrimestreNouveauArrondi(d: Demandeur, revue: Date, m1: Date, m2: Date, m3: Date, p1: Money, p2: Money, p3: Money) strict {
    effective [@2025-02-28, infinity);
    label fr official "trimestre: moyenne des 4e, 3e et 2e mois précédents (R. 843-1 I), arrondi au centime (lecture D-82)";
    label en unofficial "quarter: average of the 4th, 3rd and 2nd previous months (R. 843-1 I), rounded to the centime (reading D-82)";
    when mois_revue(d, revue) and prime_mensuelle(d, m1, p1) and prime_mensuelle(d, m2, p2) and prime_mensuelle(d, m3, p3)
        and revue == add_calendar_period(m1, 4 calendar_month)
        and m2 == add_calendar_period(m1, 1 calendar_month)
        and m3 == add_calendar_period(m1, 2 calendar_month);
    then prime_trimestre(d, div_round(p1 + p2 + p3, 3.0, 2, "HALF_UP"));
}

@source(
    CSS_R843_1_PRE2025_ED2021_01_01,
    CSS_R843_1_PRE2025_ED2021_03_25,
    CSS_R843_1_PRE2025_ED2021_06_01,
    CSS_R843_1_PRE2025_ED2022_03_21,
    CSS_R843_1_PRE2025_ED2023_12_31,
    CSS_R843_1_PRE2025_ED2024_01_01,
    CSS_R843_1_PRE2025_ED2024_07_01,
    CSS_R843_1_PRE2025_ED2025_01_01)
rule TrimestreAncienArrondi(d: Demandeur, revue: Date, m1: Date, m2: Date, m3: Date, p1: Money, p2: Money, p3: Money) strict {
    effective [@2021-01-01, @2025-02-28);
    label fr official "trimestre: moyenne des trois mois précédents (R. 843-1 avant décret 2025-185), arrondi au centime (lecture D-82)";
    label en unofficial "quarter: average of the three previous months (R. 843-1 before decree 2025-185), rounded to the centime (reading D-82)";
    when mois_revue(d, revue) and prime_mensuelle(d, m1, p1) and prime_mensuelle(d, m2, p2) and prime_mensuelle(d, m3, p3)
        and revue == add_calendar_period(m1, 3 calendar_month)
        and m2 == add_calendar_period(m1, 1 calendar_month)
        and m3 == add_calendar_period(m1, 2 calendar_month);
    then prime_trimestre(d, div_round(p1 + p2 + p3, 3.0, 2, "HALF_UP"));
}

@source(
    CSS_R843_1_ED2025_02_28,
    CSS_R843_1_ED2025_03_31,
    CSS_R843_1_ED2026_04_01,
