    CSS_R843_1_ED2026_04_01,
    CSS_R843_1_ED2026_06_27,
    CSS_R843_1_PRE2025_ED2021_01_01,
    CSS_R843_1_PRE2025_ED2021_03_25,
    CSS_R843_1_PRE2025_ED2021_06_01,
    CSS_R843_1_PRE2025_ED2022_03_21,
    CSS_R843_1_PRE2025_ED2023_12_31,
    CSS_R843_1_PRE2025_ED2024_01_01,
    CSS_R843_1_PRE2025_ED2024_07_01,
    CSS_R843_1_PRE2025_ED2025_01_01,
    Demandeur,
    forfait_base_du_mois,
    ressources_foyer_mois,
};

pub enum FormeFoyer {
    label fr official "composition du foyer au dernier jour du mois (D. 843-1, R. 843-1 II)";
    label en unofficial "household composition on the last day of the month (D. 843-1, R. 843-1 II)";
    SEUL, COUPLE, COUPLE_1E, COUPLE_2E, COUPLE_3E, ISOLE, ISOLE_1E, ISOLE_2E
}

pub relation forfait_base_retenu(mois: Date, base: Money) kind empirical {
    key(mois);
    label fr official "montant forfaitaire personne seule en euros du mois fourni pour l'espèce (fait retenu ; prévaut sur le montant du décret épinglé)";
    label en unofficial "single-person forfait euros of the month supplied for the case (retained fact; prevails over the pinned decree amount)";
}

pub relation smic_horaire_retenu(mois: Date, taux: Money) kind empirical {
    key(mois);
    label fr official "SMIC horaire brut du mois (fait retenu)";
    label en unofficial "gross hourly SMIC of the month (retained fact)";
}

pub relation forme_foyer_retenue(d: Demandeur, mois: Date, forme: FormeFoyer) kind empirical {
    key(d, mois);
    label fr official "composition du foyer au dernier jour du mois, nette de l'ex-conjoint (D. 843-1, R. 843-1 II 1°; fait retenu)";
    label en unofficial "household composition on the last day of the month, net of the departed spouse (D. 843-1, R. 843-1 II 1°; retained fact)";
}

pub relation revenus_mensuels_retenus(d: Demandeur, mois: Date, total: Money) kind empirical {
    key(d, mois);
    label fr official "ressources du foyer du mois, catégories L. 842-4 (fait retenu B-PPA-RESSOURCES-CALCUL)";
    label en unofficial "household resources of the month, L. 842-4 categories (retained fact B-PPA-RESSOURCES-CALCUL)";
}

pub relation revenus_pro_demandeur(d: Demandeur, mois: Date, montant: Money) kind empirical {
    key(d, mois);
    label fr official "revenus professionnels mensuels du demandeur (dont AAH L. 842-8 le cas échéant; fait retenu)";
    label en unofficial "monthly professional income of the claimant (incl. AAH under L. 842-8 where applicable; retained fact)";
}

pub relation revenus_pro_conjoint(d: Demandeur, mois: Date, montant: Money) kind empirical {
    key(d, mois);
    label fr official "revenus professionnels mensuels du conjoint/concubin/partenaire (fait retenu; absent: pas de bonification)";
    label en unofficial "monthly professional income of the spouse/partner (retained fact; absent: no bonification)";
}

pub relation minimum_paiement_retenu(mois: Date, seuil: Money) kind empirical {
    key(mois);
    label fr official "montant minimal en dessous duquel la prime n'est pas versée (L. 842-3, décret; fait retenu)";
    label en unofficial "minimum amount below which the bonus is not paid (L. 842-3, decree; retained fact)";
}

pub relation forfait_majore(d: Demandeur, mois: Date, montant: Money) kind institutional {
    key(d, mois);
    label fr official "montant forfaitaire après majorations de composition (D. 843-1)";
    label en unofficial "forfait after composition majorations (D. 843-1)";
}

pub relation fraction_revenus_pro(taux: Decimal) kind institutional {
    label fr official "fraction des revenus professionnels (D. 843-3: 61 % puis 59,85 %)";
    label en unofficial "professional-income fraction (D. 843-3: 61 % then 59.85 %)";
}

pub relation bonification_mensuelle(d: Demandeur, mois: Date, montant: Money) kind institutional {
    key(d, mois);
    label fr official "bonification totale du foyer pour le mois (D. 843-2, par travailleur)";
    label en unofficial "total household bonification for the month (D. 843-2, per worker)";
}

pub relation prime_mensuelle(d: Demandeur, mois: Date, montant: Money) kind institutional {
    key(d, mois);
    label fr official "prime mensuelle calculée L. 842-3 (avant seuil de paiement)";
    label en unofficial "monthly bonus computed under L. 842-3 (before payment floor)";
}

pub relation prime_due_trimestre(d: Demandeur, montant: Money) kind institutional {
    key(d);
    label fr official "montant dû au foyer: moyenne trimestrielle servie (R. 843-1 I, seuil L. 842-3)";
    label en unofficial "amount due to the household: served quarterly average (R. 843-1 I, L. 842-3 floor)";
}

// --- Forfait shapes (D. 843-1, all editions: stable text) ---

@source(
    CSS_D843_1_ED2021_01_01,
    CSS_D843_1_ED2021_03_25,
    CSS_D843_1_ED2021_06_01,
    CSS_D843_1_ED2022_03_21,
    CSS_D843_1_ED2023_12_31,
    CSS_D843_1_ED2024_01_01,
    CSS_D843_1_ED2024_07_01,
    CSS_D843_1_ED2025_01_01,
    CSS_D843_1_ED2025_02_28,
    CSS_D843_1_ED2025_03_31,
    CSS_D843_1_ED2026_04_01,
    CSS_D843_1_ED2026_06_27)
rule ForfaitSeul(d: Demandeur, mois: Date, base: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "forfait personne seule (D. 843-1 al. 1)";
    label en unofficial "single-person forfait (D. 843-1 para. 1)";
    when forfait_base_du_mois(mois, base) and forme_foyer_retenue(d, mois, SEUL);
    then forfait_majore(d, mois, base);
}

@source(
    CSS_D843_1_ED2021_01_01,
    CSS_D843_1_ED2021_03_25,
    CSS_D843_1_ED2021_06_01,
    CSS_D843_1_ED2022_03_21,
    CSS_D843_1_ED2023_12_31,
    CSS_D843_1_ED2024_01_01,
    CSS_D843_1_ED2024_07_01,
    CSS_D843_1_ED2025_01_01,
    CSS_D843_1_ED2025_02_28,
    CSS_D843_1_ED2025_03_31,
    CSS_D843_1_ED2026_04_01,
    CSS_D843_1_ED2026_06_27)
rule ForfaitCouple(d: Demandeur, mois: Date, base: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "forfait deux personnes: +50 % (D. 843-1 al. 1)";
    label en unofficial "two-person forfait: +50 % (D. 843-1 para. 1)";
    when forfait_base_du_mois(mois, base) and forme_foyer_retenue(d, mois, COUPLE);
    then forfait_majore(d, mois, base * 1.5);
}

