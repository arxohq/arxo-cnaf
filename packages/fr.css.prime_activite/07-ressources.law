pub enum CategorieRevenuPro {
    label fr official "rubrique de revenus professionnels R. 844-1 I (9° abrogé: sans valeur)";
    label en unofficial "professional income item R. 844-1 I (9° repealed: no value)";
    ITEM_01_ACTIVITE,
    ITEM_02_STAGES,
    ITEM_03_VOLONTARIAT_ARMEES,
    ITEM_04_CHOMAGE_PARTIEL,
    ITEM_05_CONGES_MAT_PAT_ADOPT,
    ITEM_05BIS_CONGE_NAISSANCE,
    ITEM_06_IJ_3_MOIS,
    ITEM_07_ESAT,
    ITEM_08_ADAPTATION_VIE_ACTIVE,
    ITEM_10_INSERTION_COMMUNAUTAIRE,
    AUTRE_REVENU_PRO
}

pub enum CategorieRevenuRemplacement {
    label fr official "rubrique de revenus de remplacement R. 844-2";
    label en unofficial "replacement income item R. 844-2";
    ITEM_01_VIEILLESSE_INVALIDITE,
    ITEM_02_ALLOCATIONS_CHOMAGE,
    ITEM_03_CESSATION_ANTICIPEE,
    ITEM_04_IJ_APRES_3_MOIS,
    ITEM_05_PRESTATION_COMPENSATOIRE,
    ITEM_06_PENSIONS_ALIMENTAIRES,
    ITEM_07_RENTES_AT_MP,
    AUTRE_REVENU_REMPLACEMENT
}

pub relation revenu_pro_declare(d: Demandeur, mois: Date, flux: Integer, cat: CategorieRevenuPro, montant: Money) kind empirical {
    key(d, mois, flux, cat);
    label fr official "revenu déclaré à la rubrique R. 844-1 (faits qualifiants compris; fait retenu)";
    label en unofficial "income declared under an R. 844-1 item (qualifying facts included; retained fact)";
}

pub relation revenu_pro_retenu(d: Demandeur, mois: Date, flux: Integer, cat: CategorieRevenuPro, montant: Money) kind institutional {
    key(d, mois, flux, cat);
    label fr official "revenu à caractère professionnel au sens de R. 844-1";
    label en unofficial "income of professional character within the meaning of R. 844-1";
}

pub relation arret_travail(d: Demandeur, date: Date) kind empirical {
    key(d);
    label fr official "arrêt de travail ouvrant les indemnités journalières (R. 844-1 6°/R. 844-2 4°; fait retenu)";
    label en unofficial "work stoppage opening daily allowances (R. 844-1 6°/R. 844-2 4°; retained fact)";
}

