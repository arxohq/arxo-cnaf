    CSS_R845_2_PRE2025_ED2025_01_01)
rule BicFallbackAncienNonImposes(d: Demandeur, revue: Date, r: Money, t: Decimal) strict {
    effective [@2021-01-01, infinity);
    label fr official "ancien, non imposés: tiers du trimestre moins abattement (R. 845-2; porte NOTA)";
    label en unofficial "old, untaxed: quarter third minus abatement (R. 845-2; NOTA gate)";
    when benefices_bic_non_imposes(d, revue)
        and dispositions_anciennes_2025(d, revue)
        and ca_bic_trimestre_precedent(d, revue, r)
        and abattement_50_0_102ter(d, revue, t)
        and not_known(lecture_ressources_fractions_arrondies());
    then revenu_bic(d, revue, (r / 3.0) * (1.0 - t));
}

