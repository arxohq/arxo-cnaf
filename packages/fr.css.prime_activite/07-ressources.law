    effective [@2021-01-01, infinity);
    label fr official "BIC: douzième des bénéfices N-2, année complète, sauf base N-1 (R. 845-2), arrondi au centime (lecture D-82/D-84)";
    label en unofficial "BIC: twelfth of N-2 profits, full year, unless N-1 base (R. 845-2), rounded to the centime (reading D-82/D-84)";
    when n_2_bic_connu(d, revue) and benefices_bic_n_2(d, revue, b)
        and annee_bic_complete(d, revue)
        and not_known(base_n_1_bic(d, revue));
    then revenu_bic(d, revue, div_round(b, 12.0, 2, "HALF_UP"));
}

