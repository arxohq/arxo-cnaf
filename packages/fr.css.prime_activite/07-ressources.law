    CSS_R844_1_W2023_ED2026_04_01,
    CSS_R844_1_ED2026_06_27)
rule ProItem01(d: Demandeur, mois: Date, flux: Integer, m: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "1° revenus d'activité salariée ou non salariée (R. 844-1)";
    label en unofficial "1° salaried or non-salaried activity income (R. 844-1)";
    when revenu_pro_declare(d, mois, flux, ITEM_01_ACTIVITE, m);
    then revenu_pro_retenu(d, mois, flux, ITEM_01_ACTIVITE, m);
}

