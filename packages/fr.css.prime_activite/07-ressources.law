pub relation revenu_pro_elements(d: Demandeur, mois: Date, flux: Integer, cat: CategorieRevenuPro, brut: Money, cotis: Money) kind empirical {
    key(d, mois, flux, cat);
    label fr official "brut net des exclusions II et cotisations salariales du revenu (R. 844-1 II; fait retenu)";
    label en unofficial "gross net of II exclusions and employee charges of the income (R. 844-1 II; retained fact)";
}

pub relation activite_non_salariee(d: Demandeur, mois: Date, flux: Integer) kind empirical {
    key(d, mois, flux);
    label fr official "revenu 1° tiré d'une activité non salariée, calcul R. 845-1/2 (R. 844-1 II; fait retenu)";
    label en unofficial "item-1° income from non-salaried activity, R. 845-1/2 computation (R. 844-1 II; retained fact)";
}

pub relation activite_hors_non_salarie(d: Demandeur, mois: Date, flux: Integer) kind empirical {
    key(d, mois, flux);
    label fr official "revenu ne relevant pas d'une activité non salariée, calcul brut moins cotisations applicable (R. 844-1 II; fait retenu)";
    label en unofficial "income outside non-salaried activity, gross-minus-charges computation applying (R. 844-1 II; retained fact)";
}

pub relation revenu_pro_montant_retenu(d: Demandeur, mois: Date, flux: Integer, cat: CategorieRevenuPro, net: Money) kind institutional {
    key(d, mois, flux, cat);
    label fr official "revenu professionnel retenu: brut moins cotisations (R. 844-1 II)";
    label en unofficial "counted professional income: gross minus charges (R. 844-1 II)";
}

@source(
    CSS_R844_1_W2023_ED2023_12_31,
    CSS_R844_1_W2023_ED2024_01_01,
    CSS_R844_1_W2023_ED2024_07_01,
    CSS_R844_1_W2023_ED2025_01_01,
    CSS_R844_1_W2023_ED2025_02_28,
    CSS_R844_1_W2023_ED2025_03_31,
    CSS_R844_1_W2023_ED2026_04_01,
    CSS_R844_1_ED2026_06_27)
rule ProMontantNet(d: Demandeur, mois: Date, flux: Integer, cat: CategorieRevenuPro, brut: Money, cotis: Money) strict {
    effective [@2023-12-31, infinity);
    label fr official "II: brut moins cotisations, hors non-salarié (R. 844-1)";
    label en unofficial "II: gross minus charges, non-salaried out (R. 844-1)";
    when revenu_pro_elements(d, mois, flux, cat, brut, cotis)
        and activite_hors_non_salarie(d, mois, flux)
        and not_known(activite_non_salariee(d, mois, flux));
    then revenu_pro_montant_retenu(d, mois, flux, cat, brut - cotis);
}

// D-42: «à l'exception des revenus tirés d'une activité non salariée
// mentionnés au 1° du I et définis aux articles R. 845-1 et R. 845-2»
// (R. 844-1 II): a classified non-salaried flux is the affirmative
// contrary of the gross-minus-charges amount (the not_known guard
// alone only leaves NEITHER).
@source(
    CSS_R844_1_W2023_ED2023_12_31,
    CSS_R844_1_W2023_ED2024_01_01,
    CSS_R844_1_W2023_ED2024_07_01,
    CSS_R844_1_W2023_ED2025_01_01,
    CSS_R844_1_W2023_ED2025_02_28,
    CSS_R844_1_W2023_ED2025_03_31,
    CSS_R844_1_W2023_ED2026_04_01,
    CSS_R844_1_ED2026_06_27)
rule ProMontantNetRefuteNonSalarie(d: Demandeur, mois: Date, flux: Integer, cat: CategorieRevenuPro, brut: Money, cotis: Money) strict {
    effective [@2023-12-31, infinity);
    label fr official "II: revenu non salarié exclu du calcul brut moins cotisations (R. 844-1)";
    label en unofficial "II: non-salaried income excluded from gross minus charges (R. 844-1)";
    when revenu_pro_elements(d, mois, flux, cat, brut, cotis)
        and activite_non_salariee(d, mois, flux);
    then not revenu_pro_montant_retenu(d, mois, flux, cat, brut - cotis);
}

pub relation revenu_rempl_declare(d: Demandeur, mois: Date, flux: Integer, cat: CategorieRevenuRemplacement, montant: Money) kind empirical {
    key(d, mois, flux, cat);
    label fr official "revenu déclaré à la rubrique R. 844-2 (faits qualifiants compris; fait retenu)";
    label en unofficial "income declared under an R. 844-2 item (qualifying facts included; retained fact)";
}

pub relation revenu_remplacement_retenu(d: Demandeur, mois: Date, flux: Integer, cat: CategorieRevenuRemplacement, montant: Money) kind institutional {
    key(d, mois, flux, cat);
    label fr official "revenu de remplacement au sens de R. 844-2";
    label en unofficial "replacement income within the meaning of R. 844-2";
}

@source(
    CSS_R844_2_ED2021_01_01,
    CSS_R844_2_ED2021_03_25,
