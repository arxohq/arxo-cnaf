    CSS_R844_2_ED2026_06_27)
rule RemplItem01(d: Demandeur, mois: Date, flux: Integer, m: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "1° vieillesse ou invalidité, régime obligatoire (R. 844-2)";
    label en unofficial "1° old-age or disability, compulsory scheme (R. 844-2)";
    when revenu_rempl_declare(d, mois, flux, ITEM_01_VIEILLESSE_INVALIDITE, m);
    then revenu_remplacement_retenu(d, mois, flux, ITEM_01_VIEILLESSE_INVALIDITE, m);
}

