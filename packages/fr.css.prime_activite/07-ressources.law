rule BicOptionAncienneArrondi(d: Demandeur, revue: Date, c12: Money, p: Money, ct: Money, cp: Money, t: Decimal) strict {
    effective [@2021-01-01, infinity);
    label fr official "ancienne option BIC: plafonds 50-0/102ter, calcul trimestre précédent (R. 845-2; porte NOTA), arrondi au centime (lecture D-82/D-84)";
    label en unofficial "old BIC option: 50-0/102ter ceilings, preceding-quarter computation (R. 845-2; NOTA gate), rounded to the centime (reading D-82/D-84)";
    when demande_option_bic(d, revue) and ca_bic_12_mois(d, revue, c12)
        and dispositions_anciennes_2025(d, revue)
        and plafond_50_0_102ter(d, revue, p) and c12 <= p
        and ca_bic_trimestre(d, revue, ct) and ct <= p / 4.0
        and ca_bic_trimestre_precedent(d, revue, cp)
        and abattement_50_0_102ter(d, revue, t);
