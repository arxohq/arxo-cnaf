    then revenu_remplacement_retenu(d, mois, flux, ITEM_07_RENTES_AT_MP, m);
}

pub relation apl_foyer(d: Demandeur, mois: Date) kind empirical {
    key(d, mois);
    label fr official "foyer bénéficiaire d'une aide personnelle au logement (R. 844-4 I; fait retenu)";
    label en unofficial "household receiving personal housing aid (R. 844-4 I; retained fact)";
}

pub relation forfait_logement_r844_3(d: Demandeur, mois: Date, montant: Money) kind empirical {
    key(d, mois);
    label fr official "forfait R. 844-3 1°/2°/3° net des personnes hors APL (R. 844-4 I; fait retenu, convergence R. 844-3 pendante)";
    label en unofficial "R. 844-3 1°/2°/3° flat amount net of non-APL persons (R. 844-4 I; retained fact, R. 844-3 convergence pending)";
}

pub relation cf_majore_foyer(d: Demandeur, mois: Date) kind empirical {
    key(d, mois);
    label fr official "foyer bénéficiaire du complément familial majoré L. 522-3 (R. 844-4 II; fait retenu)";
    label en unofficial "household receiving the increased family supplement (R. 844-4 II; retained fact)";
}

pub relation bmaf_retenue(mois: Date, montant: Money) kind empirical {
    key(mois);
    label fr official "BMAF L. 551-1 en euros (R. 844-4; fait retenu, passerelle revalorisation)";
    label en unofficial "BMAF euros (R. 844-4; retained fact, revalorisation bridge)";
}

pub relation nb_enfants_asf(d: Demandeur, mois: Date, slot: Integer, n: Integer) kind empirical {
    key(d, mois, slot);
    label fr official "nombre d'enfants ASF L. 523-3, rubrique 1 ou 2 (R. 844-4 III; fait retenu)";
    label en unofficial "ASF child count, L. 523-3 slot 1 or 2 (R. 844-4 III; retained fact)";
}

pub relation forfait_apl(d: Demandeur, mois: Date, montant: Money) kind institutional {
    key(d, mois);
    label fr official "forfait logement APL dans les ressources (R. 844-4 I)";
    label en unofficial "APL housing flat amount in resources (R. 844-4 I)";
}

pub relation forfait_cf_majore(d: Demandeur, mois: Date, montant: Money) kind institutional {
    key(d, mois);
    label fr official "forfait complément familial majoré 41,65 % BMAF (R. 844-4 II)";
    label en unofficial "increased-supplement flat amount 41.65% BMAF (R. 844-4 II)";
}

pub relation forfait_asf(d: Demandeur, mois: Date, montant: Money) kind institutional {
    key(d, mois);
    label fr official "forfait ASF 30 % / 22,5 % BMAF par enfant (R. 844-4 III)";
    label en unofficial "ASF flat amount 30% / 22.5% BMAF per child (R. 844-4 III)";
}

@source(
    CSS_R844_4_ED2021_01_01,
    CSS_R844_4_ED2021_03_25,
    CSS_R844_4_ED2021_06_01,
    CSS_R844_4_ED2022_03_21,
    CSS_R844_4_ED2023_12_31,
    CSS_R844_4_ED2024_01_01,
    CSS_R844_4_ED2024_07_01,
    CSS_R844_4_ED2025_01_01,
    CSS_R844_4_ED2025_02_28,
    CSS_R844_4_ED2025_03_31,
    CSS_R844_4_ED2026_04_01,
    CSS_R844_4_ED2026_06_27)
rule ForfaitAPL(d: Demandeur, mois: Date, f: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "I: APL incluses au forfait R. 844-3 (R. 844-4)";
    label en unofficial "I: APL included at the R. 844-3 flat amount (R. 844-4)";
    when apl_foyer(d, mois) and forfait_logement_r844_3(d, mois, f);
    then forfait_apl(d, mois, f);
}

@source(
    CSS_R844_4_ED2021_01_01,
    CSS_R844_4_ED2021_03_25,
    CSS_R844_4_ED2021_06_01,
    CSS_R844_4_ED2022_03_21,
    CSS_R844_4_ED2023_12_31,
    CSS_R844_4_ED2024_01_01,
    CSS_R844_4_ED2024_07_01,
    CSS_R844_4_ED2025_01_01,
    CSS_R844_4_ED2025_02_28,
    CSS_R844_4_ED2025_03_31,
    CSS_R844_4_ED2026_04_01,
    CSS_R844_4_ED2026_06_27)
rule ForfaitCFMajore(d: Demandeur, mois: Date, bmaf: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "II: CF majoré à 41,65 % BMAF (R. 844-4)";
    label en unofficial "II: increased supplement at 41.65% BMAF (R. 844-4)";
    when cf_majore_foyer(d, mois) and bmaf_retenue(mois, bmaf);
    then forfait_cf_majore(d, mois, bmaf * 0.4165);
}

@source(
    CSS_R844_4_ED2021_01_01,
    CSS_R844_4_ED2021_03_25,
    CSS_R844_4_ED2021_06_01,
    CSS_R844_4_ED2022_03_21,
    CSS_R844_4_ED2023_12_31,
    CSS_R844_4_ED2024_01_01,
    CSS_R844_4_ED2024_07_01,
    CSS_R844_4_ED2025_01_01,
    CSS_R844_4_ED2025_02_28,
    CSS_R844_4_ED2025_03_31,
    CSS_R844_4_ED2026_04_01,
    CSS_R844_4_ED2026_06_27)
rule ForfaitASF(d: Demandeur, mois: Date, n1: Integer, n2: Integer, bmaf: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "III: ASF 30 % / 22,5 % BMAF par enfant (R. 844-4)";
    label en unofficial "III: ASF 30% / 22.5% BMAF per child (R. 844-4)";
    when nb_enfants_asf(d, mois, 1, n1) and nb_enfants_asf(d, mois, 2, n2)
        and bmaf_retenue(mois, bmaf);
    then forfait_asf(d, mois, bmaf * (0.30 * n1 + 0.225 * n2));
}

