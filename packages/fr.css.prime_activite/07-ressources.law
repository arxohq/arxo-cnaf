    CSS_R844_2_ED2025_03_31,
    CSS_R844_2_ED2026_04_01,
    CSS_R844_2_ED2026_06_27)
rule RemplItem04(d: Demandeur, mois: Date, flux: Integer, m: Money, a: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "4° IJ au-delà de trois mois après l'arrêt (R. 844-2)";
    label en unofficial "4° daily allowances past three months after stoppage (R. 844-2)";
    when revenu_rempl_declare(d, mois, flux, ITEM_04_IJ_APRES_3_MOIS, m)
        and arret_travail(d, a) and mois > add_calendar_period(a, 3 calendar_month);
    then revenu_remplacement_retenu(d, mois, flux, ITEM_04_IJ_APRES_3_MOIS, m);
}

