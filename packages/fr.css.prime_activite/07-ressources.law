    CSS_R845_2_ED2026_04_01,
    CSS_R845_2_ED2026_06_27)
pub interpretation RessourcesFractionsArrondiesCentime of CSS_R845_1_ED2026_06_27 {
    status disputed;
    label fr official "lecture : les douzièmes (bénéfices N-2 ou N-1) et tiers (recettes du trimestre précédent ou de M-4..M-2) de revenus non salariés de la R. 845-1 et de la R. 845-2, si la division n'est pas exacte, sont arrondis au centime, demi vers le haut — pratique des caisses (CNAF) ; les textes de la R. 845-1 et de la R. 845-2 ne fixent aucun arrondi";
    label en unofficial "reading: the twelfths (N-2 or N-1 profits) and thirds (receipts of the preceding quarter or of M-4..M-2) of non-salaried income in R. 845-1 and R. 845-2, where the division is not exact, are rounded to the centime, half up - fund (CNAF) practice; the texts of R. 845-1 and R. 845-2 state no rounding";
    include LectureRessourcesFractionsArrondies;
    include AgriBaseN2Arrondi;
    include AgriBaseN1Arrondi;
    include AgriFallbackAncienNonImposesArrondi;
    include AgriFallbackAncienIncompletArrondi;
    include AgriFallbackNouveauNonImposesArrondi;
    include AgriFallbackNouveauIncompletArrondi;
    include AgriOptionAncienneArrondi;
    include AgriOptionNouvelleArrondi;
    include BicBaseN2Arrondi;
    include BicBaseN1Arrondi;
    include BicFallbackAncienNonImposesArrondi;
    include BicFallbackAncienIncompletArrondi;
    include BicFallbackAncienSpecialArrondi;
    include BicFallbackNouveauNonImposesArrondi;
    include BicFallbackNouveauIncompletArrondi;
    include BicFallbackNouveauSpecialArrondi;
    include BicOptionAncienneArrondi;
    include BicOptionNouvelleArrondi;
}
