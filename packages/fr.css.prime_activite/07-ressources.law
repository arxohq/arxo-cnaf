    when revenu_rempl_declare(d, mois, flux, ITEM_03_CESSATION_ANTICIPEE, m);
    then revenu_remplacement_retenu(d, mois, flux, ITEM_03_CESSATION_ANTICIPEE, m);
}

@source(
    CSS_R844_2_ED2021_01_01,
    CSS_R844_2_ED2021_03_25,
    CSS_R844_2_ED2021_06_01,
