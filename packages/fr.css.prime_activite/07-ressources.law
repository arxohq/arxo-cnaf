}

pub relation revenus_art62_avant_deduction(d: Demandeur, mois: Date, montant: Money) kind empirical {
    key(d, mois);
    label fr official "revenus CGI art. 62 avant déduction des frais professionnels (R. 845-3; fait retenu)";
    label en unofficial "CGI art. 62 income before professional-expense deduction (R. 845-3; retained fact)";
}

pub relation revenus_art62_retenus(d: Demandeur, mois: Date, montant: Money) kind institutional {
    key(d, mois);
    label fr official "revenus CGI art. 62 retenus avant déduction (R. 845-3)";
    label en unofficial "CGI art. 62 income counted before deduction (R. 845-3)";
}

