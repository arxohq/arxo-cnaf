    CSS_R844_1_W2023_ED2026_04_01,
    CSS_R844_1_ED2026_06_27)
rule ProItem06(d: Demandeur, mois: Date, flux: Integer, m: Money, a: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "6° IJ dans les trois mois de l'arrêt (R. 844-1)";
    label en unofficial "6° daily allowances within three months of stoppage (R. 844-1)";
    when revenu_pro_declare(d, mois, flux, ITEM_06_IJ_3_MOIS, m)
        and arret_travail(d, a) and mois <= add_calendar_period(a, 3 calendar_month);
    then revenu_pro_retenu(d, mois, flux, ITEM_06_IJ_3_MOIS, m);
}

