    ITEM_37_MAJO_INVALIDITE_INDEPENDANTS,
    ITEM_38_AJAP,
    ITEM_39_AIDE_VICTIMES_VIOLENCES,
    AUTRE_PRESTATION
}

pub relation prestation_declaree(d: Demandeur, mois: Date, cat: CategorieExclue, montant: Money) kind empirical {
    key(d, mois, cat);
    label fr official "prestation déclarée à la rubrique R. 844-5 (faits qualifiants compris; fait retenu)";
    label en unofficial "benefit declared under an R. 844-5 item (qualifying facts included; retained fact)";
}

pub relation prestation_exclue(d: Demandeur, mois: Date, cat: CategorieExclue, montant: Money) kind institutional {
    key(d, mois, cat);
    label fr official "prestation exclue des ressources (R. 844-5)";
    label en unofficial "resource-excluded benefit (R. 844-5)";
}

pub relation allocation_base_l8427_jeune(d: Demandeur, mois: Date) kind empirical {
    key(d, mois);
    label fr official "allocation de base en situation L. 842-7, enfant de moins de trois mois (R. 844-5 2°; fait retenu)";
    label en unofficial "base allowance in an L. 842-7 situation, child under three months (R. 844-5 2°; retained fact)";
}

pub relation tiers_hors_foyer_remunere(d: Demandeur, mois: Date) kind empirical {
    key(d, mois);
    label fr official "PCH/ACTP servant à rémunérer un tiers hors foyer (R. 844-5 9°/10°; fait retenu)";
    label en unofficial "PCH/ACTP paying a non-household third party (R. 844-5 9°/10°; retained fact)";
}

