pub relation benefices_agri_n_2(d: Demandeur, revue: Date, montant: Money) kind empirical {
    key(d, revue);
    label fr official "bénéfices agricoles de l'avant-dernière année (R. 845-1; fait retenu)";
    label en unofficial "farm profits of year N-2 (R. 845-1; retained fact)";
}

pub relation n_2_agri_connu(d: Demandeur, revue: Date) kind empirical {
    key(d, revue);
    label fr official "bénéfices agricoles N-2 connus (R. 845-1; fait retenu)";
    label en unofficial "N-2 farm profits known (R. 845-1; retained fact)";
}

pub relation benefices_agri_n_1(d: Demandeur, revue: Date, montant: Money) kind empirical {
    key(d, revue);
    label fr official "bénéfices agricoles de la dernière année (R. 845-1; fait retenu)";
    label en unofficial "farm profits of year N-1 (R. 845-1; retained fact)";
}

pub relation annee_agri_complete(d: Demandeur, revue: Date) kind empirical {
    key(d, revue);
    label fr official "bénéfices agricoles N-2 d'une année complète d'activité (R. 845-1; fait retenu)";
    label en unofficial "N-2 farm profits of a full activity year (R. 845-1; retained fact)";
}

pub relation annee_agri_incomplete(d: Demandeur, revue: Date) kind empirical {
    key(d, revue);
    label fr official "bénéfices agricoles ne correspondant pas à une année complète d'activité (R. 845-1; fait retenu)";
    label en unofficial "farm profits not matching a full activity year (R. 845-1; retained fact)";
}

pub relation n_1_agri_connu(d: Demandeur, revue: Date) kind empirical {
    key(d, revue);
    label fr official "bénéfices agricoles N-1 connus (R. 845-1; fait retenu)";
    label en unofficial "N-1 farm profits known (R. 845-1; retained fact)";
}

pub relation annee_agri_n_1_complete(d: Demandeur, revue: Date) kind empirical {
    key(d, revue);
    label fr official "bénéfices agricoles N-1 d'une année complète d'activité (R. 845-1; fait retenu)";
    label en unofficial "N-1 farm profits of a full activity year (R. 845-1; retained fact)";
}

pub relation base_n_1_agri(d: Demandeur, revue: Date) kind institutional {
    key(d, revue);
    label fr official "base N-1 applicable: dernière année connue et complète, primant N-2 (R. 845-1)";
    label en unofficial "N-1 base applying: known full last year, overriding N-2 (R. 845-1)";
}

pub relation benefices_agri_non_imposes(d: Demandeur, revue: Date) kind empirical {
    key(d, revue);
    label fr official "bénéfices agricoles non imposés (R. 845-1; fait retenu)";
    label en unofficial "untaxed farm profits (R. 845-1; retained fact)";
}

pub relation recettes_agri_trimestre_precedent(d: Demandeur, revue: Date, montant: Money) kind empirical {
    key(d, revue);
    label fr official "total des recettes agricoles du trimestre précédant (R. 845-1; fait retenu)";
    label en unofficial "farm receipts total of the preceding quarter (R. 845-1; retained fact)";
}

pub relation recettes_agri_m_4_m_2(d: Demandeur, revue: Date, montant: Money) kind empirical {
    key(d, revue);
    label fr official "total des recettes agricoles M-4..M-2 (R. 845-1; fait retenu)";
    label en unofficial "farm receipts total M-4..M-2 (R. 845-1; retained fact)";
}

pub relation abattement_64bis(d: Demandeur, revue: Date, taux: Decimal) kind empirical {
    key(d, revue);
    label fr official "taux CGI 64 bis al. 2 (R. 845-1; fait retenu, passerelle CGI)";
    label en unofficial "CGI 64bis rate (R. 845-1; retained fact, CGI bridge)";
}

pub relation demande_option_agri(d: Demandeur, revue: Date) kind empirical {
    key(d, revue);
    label fr official "demande du calcul trimestriel, en cours au réexamen (R. 845-1; fait retenu)";
    label en unofficial "quarterly-computation request standing at review (R. 845-1; retained fact)";
}

pub relation recettes_agri_12_mois(d: Demandeur, revue: Date, montant: Money) kind empirical {
    key(d, revue);
    label fr official "recettes agricoles des douze derniers mois (R. 845-1; fait retenu)";
    label en unofficial "farm receipts of the last twelve months (R. 845-1; retained fact)";
}

pub relation plafond_69_I(d: Demandeur, revue: Date, montant: Money) kind empirical {
    key(d, revue);
    label fr official "montant CGI 69-I applicable (R. 845-1; fait retenu, passerelle CGI)";
    label en unofficial "applicable CGI 69-I amount (R. 845-1; retained fact, CGI bridge)";
}

pub relation recettes_agri_trimestre(d: Demandeur, revue: Date, montant: Money) kind empirical {
    key(d, revue);
    label fr official "recettes agricoles trimestrielles déclarées (R. 845-1; fait retenu)";
    label en unofficial "declared quarterly farm receipts (R. 845-1; retained fact)";
}

pub relation demande_conjointe_rsa(d: Demandeur, revue: Date) kind empirical {
    key(d, revue);
    label fr official "demande conjointe RSA même mode de calcul (R. 845-1/2; fait retenu)";
    label en unofficial "joint RSA request for the same computation (R. 845-1/2; retained fact)";
}

pub relation accord_president_cd(d: Demandeur, revue: Date) kind empirical {
    key(d, revue);
    label fr official "accord du président du conseil départemental, part RSA (R. 845-1/2; fait retenu)";
    label en unofficial "departmental council president agreement, RSA part (R. 845-1/2; retained fact)";
}

pub relation revenu_agri(d: Demandeur, revue: Date, montant: Money) kind institutional {
    key(d, revue);
    label fr official "revenu professionnel agricole retenu (R. 845-1)";
    label en unofficial "counted farm professional income (R. 845-1)";
}

pub relation option_rsa_conjointe(d: Demandeur, revue: Date) kind institutional {
    key(d, revue);
    label fr official "option trimestrielle accueillie pour le RSA (R. 845-1/2)";
    label en unofficial "quarterly option granted for RSA (R. 845-1/2)";
}

@source(
    CSS_R845_1_PRE2025_ED2021_01_01,
    CSS_R845_1_PRE2025_ED2021_03_25,
    CSS_R845_1_PRE2025_ED2021_06_01,
    CSS_R845_1_PRE2025_ED2022_03_21,
    CSS_R845_1_PRE2025_ED2023_12_31,
    CSS_R845_1_PRE2025_ED2024_01_01,
    CSS_R845_1_PRE2025_ED2024_07_01,
    CSS_R845_1_PRE2025_ED2025_01_01,
    CSS_R845_1_ED2025_02_28,
    CSS_R845_1_ED2025_03_31,
    CSS_R845_1_ED2026_04_01,
    CSS_R845_1_ED2026_06_27)
rule AgriBaseN2(d: Demandeur, revue: Date, b: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "agricole: douzième des bénéfices N-2, année complète, sauf base N-1 (R. 845-1)";
    label en unofficial "farm: twelfth of N-2 profits, full year, unless N-1 base (R. 845-1)";
    when n_2_agri_connu(d, revue) and benefices_agri_n_2(d, revue, b)
        and annee_agri_complete(d, revue)
        and not_known(base_n_1_agri(d, revue))
        and not_known(lecture_ressources_fractions_arrondies());
    then revenu_agri(d, revue, b / 12.0);
}

@source(
    CSS_R845_1_PRE2025_ED2021_01_01,
    CSS_R845_1_PRE2025_ED2021_03_25,
    CSS_R845_1_PRE2025_ED2021_06_01,
    CSS_R845_1_PRE2025_ED2022_03_21,
    CSS_R845_1_PRE2025_ED2023_12_31,
    CSS_R845_1_PRE2025_ED2024_01_01,
    CSS_R845_1_PRE2025_ED2024_07_01,
    CSS_R845_1_PRE2025_ED2025_01_01,
    CSS_R845_1_ED2025_02_28,
    CSS_R845_1_ED2025_03_31,
    CSS_R845_1_ED2026_04_01,
    CSS_R845_1_ED2026_06_27)
rule AgriBaseN1Applicable(d: Demandeur, revue: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "agricole: base N-1 applicable, dernière année connue et complète (R. 845-1)";
    label en unofficial "farm: N-1 base applying, known full last year (R. 845-1)";
    when n_1_agri_connu(d, revue) and annee_agri_n_1_complete(d, revue);
    then base_n_1_agri(d, revue);
}

@source(
    CSS_R845_1_PRE2025_ED2021_01_01,
    CSS_R845_1_PRE2025_ED2021_03_25,
    CSS_R845_1_PRE2025_ED2021_06_01,
    CSS_R845_1_PRE2025_ED2022_03_21,
    CSS_R845_1_PRE2025_ED2023_12_31,
    CSS_R845_1_PRE2025_ED2024_01_01,
    CSS_R845_1_PRE2025_ED2024_07_01,
    CSS_R845_1_PRE2025_ED2025_01_01,
    CSS_R845_1_ED2025_02_28,
    CSS_R845_1_ED2025_03_31,
    CSS_R845_1_ED2026_04_01,
    CSS_R845_1_ED2026_06_27)
rule AgriBaseN1(d: Demandeur, revue: Date, b: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "agricole: douzième des bénéfices N-1, primant N-2 (R. 845-1)";
    label en unofficial "farm: twelfth of N-1 profits, overriding N-2 (R. 845-1)";
    when base_n_1_agri(d, revue) and benefices_agri_n_1(d, revue, b)
        and not_known(lecture_ressources_fractions_arrondies());
    then revenu_agri(d, revue, b / 12.0);
}

@source(
    CSS_R845_1_PRE2025_ED2021_01_01,
    CSS_R845_1_PRE2025_ED2021_03_25,
    CSS_R845_1_PRE2025_ED2021_06_01,
    CSS_R845_1_PRE2025_ED2022_03_21,
    CSS_R845_1_PRE2025_ED2023_12_31,
    CSS_R845_1_PRE2025_ED2024_01_01,
    CSS_R845_1_PRE2025_ED2024_07_01,
    CSS_R845_1_PRE2025_ED2025_01_01)
rule AgriFallbackAncienNonImposes(d: Demandeur, revue: Date, r: Money, t: Decimal) strict {
    effective [@2021-01-01, infinity);
    label fr official "ancien, non imposés: tiers du trimestre moins abattement 64bis (R. 845-1; porte NOTA)";
    label en unofficial "old, untaxed: quarter third minus 64bis abatement (R. 845-1; NOTA gate)";
    when benefices_agri_non_imposes(d, revue)
        and dispositions_anciennes_2025(d, revue)
        and recettes_agri_trimestre_precedent(d, revue, r)
        and abattement_64bis(d, revue, t)
        and not_known(lecture_ressources_fractions_arrondies());
    then revenu_agri(d, revue, (r / 3.0) * (1.0 - t));
}

@source(
    CSS_R845_1_PRE2025_ED2021_01_01,
    CSS_R845_1_PRE2025_ED2021_03_25,
    CSS_R845_1_PRE2025_ED2021_06_01,
    CSS_R845_1_PRE2025_ED2022_03_21,
    CSS_R845_1_PRE2025_ED2023_12_31,
    CSS_R845_1_PRE2025_ED2024_01_01,
    CSS_R845_1_PRE2025_ED2024_07_01,
    CSS_R845_1_PRE2025_ED2025_01_01)
rule AgriFallbackAncienIncomplet(d: Demandeur, revue: Date, r: Money, t: Decimal) strict {
    effective [@2021-01-01, infinity);
    label fr official "ancien, année incomplète: tiers du trimestre moins abattement (R. 845-1; porte NOTA)";
    label en unofficial "old, incomplete year: quarter third minus abatement (R. 845-1; NOTA gate)";
    when annee_agri_incomplete(d, revue)
        and not_known(annee_agri_complete(d, revue))
        and dispositions_anciennes_2025(d, revue)
        and recettes_agri_trimestre_precedent(d, revue, r)
        and abattement_64bis(d, revue, t)
        and not_known(lecture_ressources_fractions_arrondies());
    then revenu_agri(d, revue, (r / 3.0) * (1.0 - t));
}

@source(
    CSS_R845_1_ED2025_02_28,
    CSS_R845_1_ED2025_03_31,
    CSS_R845_1_ED2026_04_01,
    CSS_R845_1_ED2026_06_27)
rule AgriFallbackNouveauNonImposes(d: Demandeur, revue: Date, r: Money, t: Decimal) strict {
    effective [@2025-03-01, infinity);
    label fr official "non imposés: tiers M-4..M-2 moins abattement 64bis (R. 845-1; porte NOTA)";
    label en unofficial "untaxed: M-4..M-2 third minus 64bis abatement (R. 845-1; NOTA gate)";
    when benefices_agri_non_imposes(d, revue)
        and dispositions_nouvelles_2025(d, revue)
        and recettes_agri_m_4_m_2(d, revue, r)
        and abattement_64bis(d, revue, t)
        and not_known(lecture_ressources_fractions_arrondies());
    then revenu_agri(d, revue, (r / 3.0) * (1.0 - t));
}

@source(
    CSS_R845_1_ED2025_02_28,
    CSS_R845_1_ED2025_03_31,
    CSS_R845_1_ED2026_04_01,
    CSS_R845_1_ED2026_06_27)
rule AgriFallbackNouveauIncomplet(d: Demandeur, revue: Date, r: Money, t: Decimal) strict {
    effective [@2025-03-01, infinity);
    label fr official "année incomplète: tiers M-4..M-2 moins abattement (R. 845-1; porte NOTA)";
    label en unofficial "incomplete year: M-4..M-2 third minus abatement (R. 845-1; NOTA gate)";
    when annee_agri_incomplete(d, revue)
        and not_known(annee_agri_complete(d, revue))
        and dispositions_nouvelles_2025(d, revue)
        and recettes_agri_m_4_m_2(d, revue, r)
        and abattement_64bis(d, revue, t)
        and not_known(lecture_ressources_fractions_arrondies());
    then revenu_agri(d, revue, (r / 3.0) * (1.0 - t));
}

@source(
    CSS_R845_1_PRE2025_ED2021_01_01,
    CSS_R845_1_PRE2025_ED2021_03_25,
    CSS_R845_1_PRE2025_ED2021_06_01,
    CSS_R845_1_PRE2025_ED2022_03_21,
    CSS_R845_1_PRE2025_ED2023_12_31,
    CSS_R845_1_PRE2025_ED2024_01_01,
    CSS_R845_1_PRE2025_ED2024_07_01,
    CSS_R845_1_PRE2025_ED2025_01_01)
rule AgriOptionAncienne(d: Demandeur, revue: Date, r12: Money, p: Money, rt: Money, rp: Money, t: Decimal) strict {
    effective [@2021-01-01, infinity);
    label fr official "ancienne option: plafonds 69-I, calcul trimestre précédent (R. 845-1; porte NOTA)";
    label en unofficial "old option: 69-I ceilings, preceding-quarter computation (R. 845-1; NOTA gate)";
    when demande_option_agri(d, revue) and recettes_agri_12_mois(d, revue, r12)
        and dispositions_anciennes_2025(d, revue)
        and plafond_69_I(d, revue, p) and r12 <= p
        and recettes_agri_trimestre(d, revue, rt) and rt <= p / 4.0
        and recettes_agri_trimestre_precedent(d, revue, rp)
        and abattement_64bis(d, revue, t)
        and not_known(lecture_ressources_fractions_arrondies());
    then revenu_agri(d, revue, (rp / 3.0) * (1.0 - t));
}

@source(
    CSS_R845_1_ED2025_02_28,
    CSS_R845_1_ED2025_03_31,
    CSS_R845_1_ED2026_04_01,
    CSS_R845_1_ED2026_06_27)
rule AgriOptionNouvelle(d: Demandeur, revue: Date, r12: Money, p: Money, rt: Money, rp: Money, t: Decimal) strict {
    effective [@2025-03-01, infinity);
    label fr official "option: plafonds 69-I, calcul M-4..M-2 (R. 845-1; porte NOTA)";
    label en unofficial "option: 69-I ceilings, M-4..M-2 computation (R. 845-1; NOTA gate)";
    when demande_option_agri(d, revue) and recettes_agri_12_mois(d, revue, r12)
        and dispositions_nouvelles_2025(d, revue)
        and plafond_69_I(d, revue, p) and r12 <= p
        and recettes_agri_trimestre(d, revue, rt) and rt <= p / 4.0
        and recettes_agri_m_4_m_2(d, revue, rp)
        and abattement_64bis(d, revue, t)
        and not_known(lecture_ressources_fractions_arrondies());
    then revenu_agri(d, revue, (rp / 3.0) * (1.0 - t));
}

@source(
    CSS_R845_1_PRE2025_ED2021_01_01,
    CSS_R845_1_PRE2025_ED2021_03_25,
    CSS_R845_1_PRE2025_ED2021_06_01,
    CSS_R845_1_PRE2025_ED2022_03_21,
    CSS_R845_1_PRE2025_ED2023_12_31,
    CSS_R845_1_PRE2025_ED2024_01_01,
    CSS_R845_1_PRE2025_ED2024_07_01,
    CSS_R845_1_PRE2025_ED2025_01_01,
    CSS_R845_1_ED2025_02_28,
    CSS_R845_1_ED2025_03_31,
    CSS_R845_1_ED2026_04_01,
    CSS_R845_1_ED2026_06_27)
rule AgriOptionRSA(d: Demandeur, revue: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "demande RSA conjointe accueillie avec l'accord du président CD (R. 845-1)";
    label en unofficial "joint RSA request granted with council president agreement (R. 845-1)";
    when demande_option_agri(d, revue) and demande_conjointe_rsa(d, revue)
        and accord_president_cd(d, revue);
    then option_rsa_conjointe(d, revue);
}

pub relation benefices_bic_n_2(d: Demandeur, revue: Date, montant: Money) kind empirical {
    key(d, revue);
    label fr official "bénéfices BIC/BNC de l'avant-dernière année (R. 845-2; fait retenu)";
    label en unofficial "BIC/BNC profits of year N-2 (R. 845-2; retained fact)";
}

pub relation n_2_bic_connu(d: Demandeur, revue: Date) kind empirical {
    key(d, revue);
    label fr official "bénéfices BIC/BNC N-2 connus (R. 845-2; fait retenu)";
    label en unofficial "N-2 BIC/BNC profits known (R. 845-2; retained fact)";
}

pub relation benefices_bic_n_1(d: Demandeur, revue: Date, montant: Money) kind empirical {
    key(d, revue);
    label fr official "bénéfices BIC/BNC de la dernière année (R. 845-2; fait retenu)";
    label en unofficial "BIC/BNC profits of year N-1 (R. 845-2; retained fact)";
}

pub relation annee_bic_complete(d: Demandeur, revue: Date) kind empirical {
    key(d, revue);
    label fr official "bénéfices BIC/BNC N-2 d'une année complète d'activité (R. 845-2; fait retenu)";
    label en unofficial "N-2 BIC/BNC profits of a full activity year (R. 845-2; retained fact)";
}

pub relation annee_bic_incomplete(d: Demandeur, revue: Date) kind empirical {
    key(d, revue);
    label fr official "bénéfices BIC/BNC ne correspondant pas à une année complète d'activité (R. 845-2; fait retenu)";
    label en unofficial "BIC/BNC profits not matching a full activity year (R. 845-2; retained fact)";
}

pub relation n_1_bic_connu(d: Demandeur, revue: Date) kind empirical {
    key(d, revue);
    label fr official "bénéfices BIC/BNC N-1 connus (R. 845-2; fait retenu)";
    label en unofficial "N-1 BIC/BNC profits known (R. 845-2; retained fact)";
}

pub relation annee_bic_n_1_complete(d: Demandeur, revue: Date) kind empirical {
    key(d, revue);
    label fr official "bénéfices BIC/BNC N-1 d'une année complète d'activité (R. 845-2; fait retenu)";
    label en unofficial "N-1 BIC/BNC profits of a full activity year (R. 845-2; retained fact)";
}

pub relation base_n_1_bic(d: Demandeur, revue: Date) kind institutional {
    key(d, revue);
    label fr official "base N-1 applicable: dernière année connue et complète, primant N-2 (R. 845-2)";
    label en unofficial "N-1 base applying: known full last year, overriding N-2 (R. 845-2)";
}

pub relation benefices_bic_non_imposes(d: Demandeur, revue: Date) kind empirical {
    key(d, revue);
    label fr official "bénéfices BIC/BNC non imposés (R. 845-2; fait retenu)";
    label en unofficial "untaxed BIC/BNC profits (R. 845-2; retained fact)";
}

pub relation indep_special_bic(d: Demandeur, revue: Date) kind empirical {
    key(d, revue);
    label fr official "indépendant L. 613-7/L. 642-4-2/L. 382-3/L. 382-15 hors TS (R. 845-2; fait retenu)";
    label en unofficial "special independent worker (R. 845-2; retained fact)";
}

pub relation ca_bic_trimestre_precedent(d: Demandeur, revue: Date, montant: Money) kind empirical {
    key(d, revue);
    label fr official "chiffre d'affaires/recettes BIC du trimestre précédant (R. 845-2; fait retenu)";
    label en unofficial "BIC turnover/receipts of the preceding quarter (R. 845-2; retained fact)";
}

pub relation ca_bic_m_4_m_2(d: Demandeur, revue: Date, montant: Money) kind empirical {
    key(d, revue);
    label fr official "chiffre d'affaires/recettes BIC M-4..M-2 (R. 845-2; fait retenu)";
    label en unofficial "BIC turnover/receipts M-4..M-2 (R. 845-2; retained fact)";
}

pub relation abattement_50_0_102ter(d: Demandeur, revue: Date, taux: Decimal) kind empirical {
    key(d, revue);
    label fr official "taux CGI 50-0/102 ter par catégorie (R. 845-2; fait retenu, passerelle CGI)";
    label en unofficial "CGI 50-0/102ter rate per category (R. 845-2; retained fact, CGI bridge)";
}

pub relation demande_option_bic(d: Demandeur, revue: Date) kind empirical {
    key(d, revue);
    label fr official "demande du calcul trimestriel BIC, en cours au réexamen (R. 845-2; fait retenu)";
    label en unofficial "BIC quarterly-computation request standing at review (R. 845-2; retained fact)";
}

pub relation ca_bic_12_mois(d: Demandeur, revue: Date, montant: Money) kind empirical {
    key(d, revue);
    label fr official "chiffre d'affaires BIC des douze derniers mois (R. 845-2; fait retenu)";
    label en unofficial "BIC turnover of the last twelve months (R. 845-2; retained fact)";
}

pub relation plafond_50_0_102ter(d: Demandeur, revue: Date, montant: Money) kind empirical {
    key(d, revue);
    label fr official "montant CGI 50-0/102 ter applicable par nature (R. 845-2; fait retenu, passerelle CGI)";
    label en unofficial "applicable CGI 50-0/102ter amount (R. 845-2; retained fact, CGI bridge)";
}

pub relation ca_bic_trimestre(d: Demandeur, revue: Date, montant: Money) kind empirical {
    key(d, revue);
    label fr official "chiffre d'affaires BIC trimestriel déclaré (R. 845-2; fait retenu)";
    label en unofficial "declared quarterly BIC turnover (R. 845-2; retained fact)";
}

pub relation revenu_bic(d: Demandeur, revue: Date, montant: Money) kind institutional {
    key(d, revue);
    label fr official "revenu professionnel BIC/BNC retenu (R. 845-2)";
    label en unofficial "counted BIC/BNC professional income (R. 845-2)";
}

@source(
    CSS_R845_2_PRE2025_ED2021_01_01,
    CSS_R845_2_PRE2025_ED2021_03_25,
    CSS_R845_2_PRE2025_ED2021_06_01,
    CSS_R845_2_PRE2025_ED2022_03_21,
    CSS_R845_2_PRE2025_ED2023_12_31,
    CSS_R845_2_PRE2025_ED2024_01_01,
    CSS_R845_2_PRE2025_ED2024_07_01,
    CSS_R845_2_PRE2025_ED2025_01_01,
    CSS_R845_2_ED2025_02_28,
    CSS_R845_2_ED2025_03_31,
    CSS_R845_2_ED2026_04_01,
    CSS_R845_2_ED2026_06_27)
rule BicBaseN2(d: Demandeur, revue: Date, b: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "BIC: douzième des bénéfices N-2, année complète, sauf base N-1 (R. 845-2)";
    label en unofficial "BIC: twelfth of N-2 profits, full year, unless N-1 base (R. 845-2)";
    when n_2_bic_connu(d, revue) and benefices_bic_n_2(d, revue, b)
        and annee_bic_complete(d, revue)
        and not_known(base_n_1_bic(d, revue))
        and not_known(lecture_ressources_fractions_arrondies());
    then revenu_bic(d, revue, b / 12.0);
}

