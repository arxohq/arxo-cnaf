rule AgriBaseN2Arrondi(d: Demandeur, revue: Date, b: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "agricole: douzième des bénéfices N-2, année complète, sauf base N-1 (R. 845-1), arrondi au centime (lecture D-82/D-84)";
    label en unofficial "farm: twelfth of N-2 profits, full year, unless N-1 base (R. 845-1), rounded to the centime (reading D-82/D-84)";
    when n_2_agri_connu(d, revue) and benefices_agri_n_2(d, revue, b)
        and annee_agri_complete(d, revue)
        and not_known(base_n_1_agri(d, revue));
    then revenu_agri(d, revue, div_round(b, 12.0, 2, "HALF_UP"));
}

