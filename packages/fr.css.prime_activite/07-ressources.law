    ITEM_17_FRAIS_FUNERAIRES,
    ITEM_18_CAPITAL_DECES,
    ITEM_18BIS_ARE_CONJOINT_DECES,
    ITEM_19_FONDS_SOLIDARITE_ACAFN,
    ITEM_20_AIDE_CONJOINTS_SUPPLETIFS,
    ITEM_21_1999_RECONNAISSANCE,
    ITEM_21_2005_RECONNAISSANCE,
    ITEM_21BIS_ALLOCATION_VIAGERE,
    ITEM_22_ORPHELINS_ANTISEMITISME,
    ITEM_23_ORPHELINS_BARBARIE,
    ITEM_24_RSO,
    ITEM_25_RSA,
    ITEM_26_GRATIFICATIONS_STAGES,
    ITEM_27_DEDOMMAGEMENT_AIDANT,
    ITEM_28_ALLOCATION_L168_8,
    ITEM_29_ALLOCATION_DECES_ENFANT,
    ITEM_30_INDEMNITES_ENTRETIEN_ENFANT,
    ITEM_31_APA,
    ITEM_32_MAJO_TIERCE_PERSONNE_L355_1,
