rule AgriOptionAncienneArrondi(d: Demandeur, revue: Date, r12: Money, p: Money, rt: Money, rp: Money, t: Decimal) strict {
    effective [@2021-01-01, infinity);
    label fr official "ancienne option: plafonds 69-I, calcul trimestre précédent (R. 845-1; porte NOTA), arrondi au centime (lecture D-82/D-84)";
    label en unofficial "old option: 69-I ceilings, preceding-quarter computation (R. 845-1; NOTA gate), rounded to the centime (reading D-82/D-84)";
    when demande_option_agri(d, revue) and recettes_agri_12_mois(d, revue, r12)
        and dispositions_anciennes_2025(d, revue)
        and plafond_69_I(d, revue, p) and r12 <= p
        and recettes_agri_trimestre(d, revue, rt) and rt <= p / 4.0
        and recettes_agri_trimestre_precedent(d, revue, rp)
        and abattement_64bis(d, revue, t);
    then revenu_agri(d, revue, div_round(rp, 3.0, 2, "HALF_UP") * (1.0 - t));
}

