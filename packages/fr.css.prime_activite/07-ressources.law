    CSS_R845_1_PRE2025_ED2024_07_01,
    CSS_R845_1_PRE2025_ED2025_01_01)
rule AgriFallbackAncienNonImposesArrondi(d: Demandeur, revue: Date, r: Money, t: Decimal) strict {
    effective [@2021-01-01, infinity);
    label fr official "ancien, non imposés: tiers du trimestre moins abattement 64bis (R. 845-1; porte NOTA), arrondi au centime (lecture D-82/D-84)";
    label en unofficial "old, untaxed: quarter third minus 64bis abatement (R. 845-1; NOTA gate), rounded to the centime (reading D-82/D-84)";
    when benefices_agri_non_imposes(d, revue)
        and dispositions_anciennes_2025(d, revue)
        and recettes_agri_trimestre_precedent(d, revue, r)
        and abattement_64bis(d, revue, t);
    then revenu_agri(d, revue, div_round(r, 3.0, 2, "HALF_UP") * (1.0 - t));
}

