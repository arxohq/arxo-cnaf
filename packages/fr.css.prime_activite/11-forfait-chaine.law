    CSS_L842_3_ED2026_04_01,
    CSS_L842_3_ED2026_06_27)
rule ForfaitBaseDecret2025(d: Demandeur, mois: Date, f: FormeFoyer) strict {
    effective [@2021-01-01, infinity);
    label fr official "montant forfaitaire personne seule porté à 633,21 euros par le décret 2025-294, applicable au mois d'avril 2025";
    label en unofficial "single-person flat-rate amount set at 633.21 euros by decree 2025-294, applicable from April 2025";
    when forme_foyer_retenue(d, mois, f) and mois >= @2025-04-01 and mois < @2026-04-01 and not_known(forfait_base_saisi(mois));
    then forfait_base_du_mois(mois, 633.21 EUR);
}

@source(
    DEC2025_294_ART1)
rule ForfaitBasePublie2025(d: Demandeur, mois: Date, f: FormeFoyer) strict {
    effective [@2021-01-01, infinity);
    label fr official "montant publié par le décret 2025-294 : 633,21 euros";
    label en unofficial "amount published by decree 2025-294: 633.21 euros";
    when forme_foyer_retenue(d, mois, f) and mois >= @2025-04-01 and mois < @2026-04-01;
    then forfait_base_publie(mois, 633.21 EUR);
}

