rule ForfaitBaseConstruit2025(d: Demandeur, mois: Date, f: FormeFoyer) strict {
    effective [@2021-01-01, infinity);
    label fr official "montant forfaitaire construit au 1er avril 2025 : montant précédent multiplié par le coefficient L. 161-25 (1,017), arrondi au centime (lecture)";
    label en unofficial "flat-rate amount built on 1 April 2025: previous amount times the L. 161-25 coefficient (1.017), rounded to the centime (reading)";
    when forme_foyer_retenue(d, mois, f) and mois >= @2025-04-01 and mois < @2026-04-01;
    then forfait_base_construit(mois, round(622.63 EUR * 1.017, 2, "HALF_UP"));
}

