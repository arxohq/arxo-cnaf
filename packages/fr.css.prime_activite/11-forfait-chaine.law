    CSS_L842_3_ED2025_03_31,
    CSS_L842_3_ED2026_04_01,
    CSS_L842_3_ED2026_06_27)
rule ForfaitBaseConformePublie(mois: Date, p: Money, c: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "le montant forfaitaire construit par la chaîne L. 161-25 est égal au montant publié du décret";
    label en unofficial "the flat-rate amount built by the L. 161-25 chain equals the decree's published amount";
    when forfait_base_publie(mois, p) and forfait_base_construit(mois, c) and p == c;
    then forfait_base_conforme_publie(mois);
}

