    CSS_L842_3_ED2025_03_31,
    CSS_L842_3_ED2026_04_01,
    CSS_L842_3_ED2026_06_27)
rule ForfaitSaisiConformeConstruit(mois: Date, s: Money, c: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "la base fournie pour le mois est égale au montant forfaitaire construit par la chaîne L. 161-25";
    label en unofficial "the base supplied for the month equals the flat-rate amount built by the L. 161-25 chain";
    when forfait_base_retenu(mois, s) and forfait_base_construit(mois, c) and s == c;
    then forfait_saisi_conforme_construit(mois);
}

@source(
    LOI_2022_1158_ART9,
    DSS_SD2B_2020_33_COEFF,
    DSS_2B_2021_65_COEFF,
