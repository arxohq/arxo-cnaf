    CSS_L842_3_ED2026_06_27)
rule ForfaitBaseConstruit2021(d: Demandeur, mois: Date, f: FormeFoyer) strict {
    effective [@2021-01-01, infinity);
    label fr official "montant forfaitaire construit au 1er avril 2021 : montant précédent multiplié par le coefficient L. 161-25 (1,001), arrondi au centime (lecture)";
    label en unofficial "flat-rate amount built on 1 April 2021: previous amount times the L. 161-25 coefficient (1.001), rounded to the centime (reading)";
    when forme_foyer_retenue(d, mois, f) and mois >= @2021-04-01 and mois < @2022-04-01;
    then forfait_base_construit(mois, round(553.16 EUR * 1.001, 2, "HALF_UP"));
}

