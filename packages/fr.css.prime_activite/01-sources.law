@id("urn:fr:corpus:clir:ppa#DEC2026_222_ART2")
pub fragment DEC2026_222_ART2 in DEC2026_222_ART2_ED {
    kind article;
    locator "article/2";
    text fr official """Article 2
Le montant forfaitaire mensuel de la prime d'activité mentionné à l'article L. 842-3 du code de la sécurité sociale applicable à un foyer bénéficiaire composé d'une personne seule est fixé à 638,28 euros.
""";
    content_hash "sha256:b5fbb4830a61ad47ab75d9c1c06e8d839162b796db11881fc20a40970d54aae4";
}

