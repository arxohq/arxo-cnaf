@id("urn:fr:corpus:clir:ppa#CSS_L845_5_ED2021_01_01")
pub fragment CSS_L845_5_ED2021_01_01 in CSS_ED2021_01_01 {
    kind article;
    locator "article/L845-5";
    text fr official """Article L845-5
La prime d'activité est incessible et insaisissable, sauf pour le recouvrement des créances mentionnées aux articles L. 581-1 et L. 581-3, selon les modalités prévues au troisième alinéa de l'article L. 553-2.
""";
    content_hash "sha256:80d77a184d14b6843d3bd49655b2e070ca12a1628978a74cec18546cbfba9793";
}

