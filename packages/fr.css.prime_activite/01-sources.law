@id("urn:fr:corpus:clir:ppa#CSS_D847_2_ED2021_01_01")
pub fragment CSS_D847_2_ED2021_01_01 in CSS_ED2021_01_01 {
    kind article;
    locator "article/D847-2";
    text fr official """Article D847-2
Les organismes chargés du versement de la prime d'activité sont autorisés à abandonner la mise en recouvrement des indus lorsque leur montant est inférieur à une somme égale à 0,68 % du plafond mentionné à l'article L. 241-3, arrondie à l'euro supérieur.
""";
    content_hash "sha256:70b64b9b189344450c37fa8314a7ba4d512e7f4759d56510642a938a9cf04c30";
}

