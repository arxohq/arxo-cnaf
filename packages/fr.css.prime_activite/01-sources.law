@id("urn:fr:corpus:clir:ppa#CSS_L845_6_ED2021_01_01")
pub fragment CSS_L845_6_ED2021_01_01 in CSS_ED2021_01_01 {
    kind article;
    locator "article/L845-6";
    text fr official """Article L845-6
Le fait d'offrir ou de faire offrir ses services à une personne, en qualité d'intermédiaire et moyennant rémunération, en vue de lui faire obtenir la prime d'activité est puni des peines prévues à l'article L. 554-2.
""";
    content_hash "sha256:87214914aadb8bd8f50673595ab240b106a008ad78fded406af9929447b6c942";
}

