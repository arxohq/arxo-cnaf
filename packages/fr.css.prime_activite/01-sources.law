@id("urn:fr:corpus:clir:ppa#CSS_L844_1_ED2021_01_01")
pub fragment CSS_L844_1_ED2021_01_01 in CSS_ED2021_01_01 {
    kind article;
    locator "article/L844-1";
    text fr official """Article L844-1
