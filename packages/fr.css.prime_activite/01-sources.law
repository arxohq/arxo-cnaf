@id("urn:fr:corpus:clir:ppa#CSS_R846_2_ED2021_01_01")
pub fragment CSS_R846_2_ED2021_01_01 in CSS_ED2021_01_01 {
    kind article;
    locator "article/R846-2";
    text fr official """Article R846-2
L'allocation est due à compter du premier jour du mois civil au cours duquel la demande a été déposée conformément à l'article R. 846-1.
""";
    content_hash "sha256:ec89c8d11bfe872672a43bd990e0250ba68683c75f1e2fe38dd2bd64594c3b3f";
}

