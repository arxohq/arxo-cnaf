    language fr;
    officiality official;
    materialization_status PINNED_UNOFFICIAL_COPY;
    in_force [@2021-01-01, infinity);
    label fr official "Décret n° 2026-222, article 3 (montant forfaitaire de la prime d'activité) en vigueur à compter du 2021-01-01";
    label en unofficial "Decree No. 2026-222: article 3 (activity bonus flat-rate amount) as in force from 2021-01-01";
}

