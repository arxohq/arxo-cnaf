@id("urn:fr:corpus:clir:ppa#CSS_R847_3_ED2021_01_01")
pub fragment CSS_R847_3_ED2021_01_01 in CSS_ED2021_01_01 {
    kind article;
    locator "article/R847-3";
    text fr official """Article R847-3
Les décisions relatives à la prime d'activité mentionnent les voies de recours ouvertes aux personnes concernées et précisent les modalités du recours préalable institué par l'article L. 845-2.
""";
    content_hash "sha256:6451653919c01ebd52b8b896d8f682c1d52c220e35f676deccc255dbba2f3f2e";
}

