@id("urn:fr:corpus:clir:ppa#CSS_D846_3_ED2021_01_01")
pub fragment CSS_D846_3_ED2021_01_01 in CSS_ED2021_01_01 {
    kind article;
    locator "article/D846-3";
    text fr official """Article D846-3
Le délai mentionné à l'article L. 843-5, au terme duquel le directeur de l'organisme chargé du service de la prime d'activité procède à la radiation de la liste des bénéficiaires de la prime d'activité, est fixé à vingt-quatre mois.
""";
    content_hash "sha256:6be879cd06d335b4312acd4013f3ce63f232e54b1c2093893f7d3e775aca950e";
}

