@id("urn:fr:corpus:clir:ppa#CNAF_IT_2026_080_MONTANTS")
pub fragment CNAF_IT_2026_080_MONTANTS in CNAF_IT_2026_080_TEXT {
    kind guidance;
    locator "instruction-technique/IT-2026-080/I/montant-bonification";
    text fr official """Le montant de la bonification est fixé à 29,101% du montant forfaitaire de la PPA.
Ce montant est revalorisé au 1er avril 2026 pour atteindre 37,70% du montant forfaitaire de base de
la prime d’activité.

                   Bonification à 29,101%           Bonification à 37,70%

                          184,27€                          240,63€
""";
    content_hash "sha256:d814078fb7dfe501cbe6b33e4e45868145b6d09bb3a3baf2b8ef68928e4d03b6";
}

