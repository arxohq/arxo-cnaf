@id("urn:fr:corpus:clir:ppa#CSS_L841_1_ED2021_01_01")
pub fragment CSS_L841_1_ED2021_01_01 in CSS_ED2021_01_01 {
    kind article;
    locator "article/L841-1";
    text fr official """Article L841-1
La prime d'activité a pour objet d'inciter les travailleurs aux ressources modestes, qu'ils soient salariés ou non salariés, à l'exercice ou à la reprise d'une activité professionnelle et de soutenir leur pouvoir d'achat.
""";
    content_hash "sha256:f948a339c5f487718e02e5f444fcd9d31c45885da82f8e7dc419c4b67bd74bf7";
}

