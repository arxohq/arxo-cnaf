@id("urn:fr:corpus:clir:ppa#CSS_L843_5_ED2021_01_01")
pub fragment CSS_L843_5_ED2021_01_01 in CSS_ED2021_01_01 {
    kind article;
    locator "article/L843-5";
    text fr official """Article L843-5
L'organisme chargé du service de la prime d'activité procède à la radiation de la liste des bénéficiaires de la prime d'activité au terme d'une période, définie par décret, sans versement de la prestation. Lorsqu'un droit au revenu de solidarité active est ouvert, la prestation mentionnée au premier alinéa s'entend de la prime d'activité et du revenu de solidarité active.
""";
    content_hash "sha256:2248b287dbea4e6bbebaa4a7b9b5c3c92ef54967fa0f58e824b3e0dd5785fd42";
}

@id("urn:fr:corpus:clir:ppa#CSS_L843_5_ED2021_03_25")
