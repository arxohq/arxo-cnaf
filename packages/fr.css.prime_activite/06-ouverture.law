@source(
    CSS_R842_2_ED2025_02_28,
    CSS_R842_2_ED2025_03_31,
    CSS_R842_2_ED2026_04_01,
    CSS_R842_2_ED2026_06_27)
rule TimingBeneficiaireNouveau(d: Demandeur, revue: Date, m1: Date, m2: Date, m3: Date, md: Date) strict {
    effective [@2025-03-01, infinity);
    label fr official "I: 1°/2° au mois du droit, 3°/5° M-4..M-2, L. 842-1/4° aux deux (R. 842-2; porte NOTA)";
    label en unofficial "I: 1°/2° month of right, 3°/5° M-4..M-2, L. 842-1/4° both (R. 842-2; NOTA gate)";
    when mois_revue(d, revue) and mois_du_droit(d, md)
        and dispositions_nouvelles_2025(d, revue)
        and revue == add_calendar_period(m1, 4 calendar_month)
        and m2 == add_calendar_period(m1, 1 calendar_month)
        and m3 == add_calendar_period(m1, 2 calendar_month)
        and condition_mensuelle(d, md, BENEFICIAIRE, COND_L8422_1)
        and condition_mensuelle(d, md, BENEFICIAIRE, COND_L8422_2)
        and condition_mensuelle(d, m1, BENEFICIAIRE, COND_L8422_3)
        and condition_mensuelle(d, m2, BENEFICIAIRE, COND_L8422_3)
        and condition_mensuelle(d, m3, BENEFICIAIRE, COND_L8422_3)
        and condition_mensuelle(d, m1, BENEFICIAIRE, COND_L8422_5)
        and condition_mensuelle(d, m2, BENEFICIAIRE, COND_L8422_5)
        and condition_mensuelle(d, m3, BENEFICIAIRE, COND_L8422_5)
        and condition_mensuelle(d, m1, BENEFICIAIRE, COND_L8421)
        and condition_mensuelle(d, m2, BENEFICIAIRE, COND_L8421)
        and condition_mensuelle(d, m3, BENEFICIAIRE, COND_L8421)
        and condition_mensuelle(d, md, BENEFICIAIRE, COND_L8421)
        and condition_mensuelle(d, m1, BENEFICIAIRE, COND_L8422_4)
        and condition_mensuelle(d, m2, BENEFICIAIRE, COND_L8422_4)
        and condition_mensuelle(d, m3, BENEFICIAIRE, COND_L8422_4)
        and condition_mensuelle(d, md, BENEFICIAIRE, COND_L8422_4);
    then conditions_beneficiaire_ok(d, revue);
}

@source(
    CSS_R842_2_ED2025_02_28,
    CSS_R842_2_ED2025_03_31,
    CSS_R842_2_ED2026_04_01,
    CSS_R842_2_ED2026_06_27)
rule TimingConjointNouveau(d: Demandeur, revue: Date, m1: Date, m2: Date, m3: Date, md: Date) strict {
    effective [@2025-03-01, infinity);
    label fr official "II: 2° au mois du droit, 5° M-4..M-2, 4° aux deux (R. 842-2; porte NOTA)";
    label en unofficial "II: 2° month of right, 5° M-4..M-2, 4° both (R. 842-2; NOTA gate)";
    when mois_revue(d, revue) and mois_du_droit(d, md) and conjoint_present(d)
        and dispositions_nouvelles_2025(d, revue)
        and revue == add_calendar_period(m1, 4 calendar_month)
        and m2 == add_calendar_period(m1, 1 calendar_month)
        and m3 == add_calendar_period(m1, 2 calendar_month)
        and condition_mensuelle(d, md, CONJOINT, COND_L8422_2)
        and condition_mensuelle(d, m1, CONJOINT, COND_L8422_5)
        and condition_mensuelle(d, m2, CONJOINT, COND_L8422_5)
        and condition_mensuelle(d, m3, CONJOINT, COND_L8422_5)
        and condition_mensuelle(d, m1, CONJOINT, COND_L8422_4)
        and condition_mensuelle(d, m2, CONJOINT, COND_L8422_4)
        and condition_mensuelle(d, m3, CONJOINT, COND_L8422_4)
        and condition_mensuelle(d, md, CONJOINT, COND_L8422_4);
    then conditions_conjoint_ok(d, revue);
}

@source(
    CSS_R842_2_ED2025_02_28,
    CSS_R842_2_ED2025_03_31,
    CSS_R842_2_ED2026_04_01,
    CSS_R842_2_ED2026_06_27)
rule TimingGlobalNouveauAvecConjoint(d: Demandeur, revue: Date) strict {
    effective [@2025-03-01, infinity);
    label fr official "foyer avec conjoint: branches I et II (R. 842-2; porte NOTA)";
    label en unofficial "household with spouse: branches I and II (R. 842-2; NOTA gate)";
    when conditions_beneficiaire_ok(d, revue) and conditions_conjoint_ok(d, revue)
        and dispositions_nouvelles_2025(d, revue);
    then conditions_temporelles_ok(d, revue);
}

@source(
    CSS_R842_2_ED2025_02_28,
    CSS_R842_2_ED2025_03_31,
    CSS_R842_2_ED2026_04_01,
    CSS_R842_2_ED2026_06_27)
rule TimingGlobalNouveauSansConjoint(d: Demandeur, revue: Date) strict {
    effective [@2025-03-01, infinity);
    label fr official "foyer sans conjoint: branche I seule (R. 842-2; porte NOTA)";
    label en unofficial "household without spouse: branch I alone (R. 842-2; NOTA gate)";
    when conditions_beneficiaire_ok(d, revue) and sans_conjoint(d)
        and not_known(conjoint_present(d))
        and dispositions_nouvelles_2025(d, revue);
    then conditions_temporelles_ok(d, revue);
}

@source(
    CSS_R842_2_PRE2025_ED2021_01_01,
    CSS_R842_2_PRE2025_ED2021_03_25,
    CSS_R842_2_PRE2025_ED2021_06_01,
    CSS_R842_2_PRE2025_ED2022_03_21,
    CSS_R842_2_PRE2025_ED2023_12_31,
    CSS_R842_2_PRE2025_ED2024_01_01,
    CSS_R842_2_PRE2025_ED2024_07_01,
    CSS_R842_2_PRE2025_ED2025_01_01,
    CSS_R842_2_ED2025_02_28,
    CSS_R842_2_ED2025_03_31,
    CSS_R842_2_ED2026_04_01,
    CSS_R842_2_ED2026_06_27)
rule TimingBeneficiaireAncien(d: Demandeur, revue: Date, m1: Date, m2: Date, m3: Date, md: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "ancien: L. 842-1 + 2°/4° chaque mois du trimestre et mois du droit (R. 842-2; porte NOTA)";
    label en unofficial "old: L. 842-1 + 2°/4° each quarter month and month of right (R. 842-2; NOTA gate)";
    when mois_revue(d, revue) and mois_du_droit(d, md)
        and dispositions_anciennes_2025(d, revue)
        and revue == add_calendar_period(m1, 3 calendar_month)
        and m2 == add_calendar_period(m1, 1 calendar_month)
        and m3 == add_calendar_period(m1, 2 calendar_month)
        and condition_mensuelle(d, m1, BENEFICIAIRE, COND_L8421)
        and condition_mensuelle(d, m2, BENEFICIAIRE, COND_L8421)
        and condition_mensuelle(d, m3, BENEFICIAIRE, COND_L8421)
        and condition_mensuelle(d, md, BENEFICIAIRE, COND_L8421)
        and condition_mensuelle(d, m1, BENEFICIAIRE, COND_L8422_2)
        and condition_mensuelle(d, m2, BENEFICIAIRE, COND_L8422_2)
        and condition_mensuelle(d, m3, BENEFICIAIRE, COND_L8422_2)
        and condition_mensuelle(d, md, BENEFICIAIRE, COND_L8422_2)
        and condition_mensuelle(d, m1, BENEFICIAIRE, COND_L8422_4)
        and condition_mensuelle(d, m2, BENEFICIAIRE, COND_L8422_4)
        and condition_mensuelle(d, m3, BENEFICIAIRE, COND_L8422_4)
        and condition_mensuelle(d, md, BENEFICIAIRE, COND_L8422_4);
    then conditions_beneficiaire_ok(d, revue);
}

@source(
    CSS_R842_2_PRE2025_ED2021_01_01,
    CSS_R842_2_PRE2025_ED2021_03_25,
    CSS_R842_2_PRE2025_ED2021_06_01,
    CSS_R842_2_PRE2025_ED2022_03_21,
    CSS_R842_2_PRE2025_ED2023_12_31,
    CSS_R842_2_PRE2025_ED2024_01_01,
    CSS_R842_2_PRE2025_ED2024_07_01,
    CSS_R842_2_PRE2025_ED2025_01_01,
    CSS_R842_2_ED2025_02_28,
    CSS_R842_2_ED2025_03_31,
    CSS_R842_2_ED2026_04_01,
    CSS_R842_2_ED2026_06_27)
rule TimingConjointAncien(d: Demandeur, revue: Date, m1: Date, m2: Date, m3: Date, md: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "ancien, conjoint: L. 842-1 + 2°/4° chaque mois du trimestre et mois du droit (R. 842-2; porte NOTA)";
    label en unofficial "old, spouse: L. 842-1 + 2°/4° each quarter month and month of right (R. 842-2; NOTA gate)";
    when mois_revue(d, revue) and mois_du_droit(d, md) and conjoint_present(d)
        and dispositions_anciennes_2025(d, revue)
        and revue == add_calendar_period(m1, 3 calendar_month)
        and m2 == add_calendar_period(m1, 1 calendar_month)
        and m3 == add_calendar_period(m1, 2 calendar_month)
        and condition_mensuelle(d, m1, CONJOINT, COND_L8421)
        and condition_mensuelle(d, m2, CONJOINT, COND_L8421)
        and condition_mensuelle(d, m3, CONJOINT, COND_L8421)
        and condition_mensuelle(d, md, CONJOINT, COND_L8421)
        and condition_mensuelle(d, m1, CONJOINT, COND_L8422_2)
        and condition_mensuelle(d, m2, CONJOINT, COND_L8422_2)
        and condition_mensuelle(d, m3, CONJOINT, COND_L8422_2)
        and condition_mensuelle(d, md, CONJOINT, COND_L8422_2)
        and condition_mensuelle(d, m1, CONJOINT, COND_L8422_4)
        and condition_mensuelle(d, m2, CONJOINT, COND_L8422_4)
        and condition_mensuelle(d, m3, CONJOINT, COND_L8422_4)
        and condition_mensuelle(d, md, CONJOINT, COND_L8422_4);
    then conditions_conjoint_ok(d, revue);
}

@source(
    CSS_R842_2_PRE2025_ED2021_01_01,
    CSS_R842_2_PRE2025_ED2021_03_25,
    CSS_R842_2_PRE2025_ED2021_06_01,
    CSS_R842_2_PRE2025_ED2022_03_21,
    CSS_R842_2_PRE2025_ED2023_12_31,
    CSS_R842_2_PRE2025_ED2024_01_01,
    CSS_R842_2_PRE2025_ED2024_07_01,
    CSS_R842_2_PRE2025_ED2025_01_01,
    CSS_R842_2_ED2025_02_28,
    CSS_R842_2_ED2025_03_31,
    CSS_R842_2_ED2026_04_01,
    CSS_R842_2_ED2026_06_27)
rule TimingGlobalAncienAvecConjoint(d: Demandeur, revue: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "ancien, foyer avec conjoint (R. 842-2; porte NOTA)";
    label en unofficial "old, household with spouse (R. 842-2; NOTA gate)";
    when conditions_beneficiaire_ok(d, revue) and conditions_conjoint_ok(d, revue)
        and dispositions_anciennes_2025(d, revue);
    then conditions_temporelles_ok(d, revue);
}

@source(
    CSS_R842_2_PRE2025_ED2021_01_01,
    CSS_R842_2_PRE2025_ED2021_03_25,
    CSS_R842_2_PRE2025_ED2021_06_01,
    CSS_R842_2_PRE2025_ED2022_03_21,
    CSS_R842_2_PRE2025_ED2023_12_31,
    CSS_R842_2_PRE2025_ED2024_01_01,
    CSS_R842_2_PRE2025_ED2024_07_01,
    CSS_R842_2_PRE2025_ED2025_01_01,
    CSS_R842_2_ED2025_02_28,
    CSS_R842_2_ED2025_03_31,
    CSS_R842_2_ED2026_04_01,
    CSS_R842_2_ED2026_06_27)
rule TimingGlobalAncienSansConjoint(d: Demandeur, revue: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "ancien, foyer sans conjoint (R. 842-2; porte NOTA)";
    label en unofficial "old, household without spouse (R. 842-2; NOTA gate)";
    when conditions_beneficiaire_ok(d, revue) and sans_conjoint(d)
        and not_known(conjoint_present(d))
        and dispositions_anciennes_2025(d, revue);
    then conditions_temporelles_ok(d, revue);
}

pub relation enfant_ou_charge(d: Demandeur, e: Enfant) kind empirical {
    key(d, e);
    label fr official "enfant ou personne à la charge du bénéficiaire, candidat membre (R. 842-3 3°; fait retenu)";
    label en unofficial "child or person supported by the beneficiary, membership candidate (R. 842-3 3°; retained fact)";
}

pub relation ouvre_droit_pf(e: Enfant) kind empirical {
    key(e);
    label fr official "enfant ouvrant droit aux prestations familiales (R. 842-3 a); fait retenu)";
    label en unofficial "child giving entitlement to family benefits (R. 842-3 a); retained fact)";
}

pub relation naissance(e: Enfant, date: Date) kind empirical {
    key(e);
    label fr official "naissance de l'enfant (R. 842-3/5; fait retenu)";
    label en unofficial "birth of the child (R. 842-3/5; retained fact)";
}

pub relation arrivee_foyer(e: Enfant, date: Date) kind empirical {
    key(e);
    label fr official "arrivée de l'enfant au foyer (R. 842-3 a); fait retenu)";
    label en unofficial "arrival of the child at the household (R. 842-3 a); retained fact)";
}

pub relation lien_parente_4e_degre(e: Enfant, d: Demandeur) kind empirical {
    key(e, d);
    label fr official "lien de parenté avec le bénéficiaire ou son conjoint jusqu'au quatrième degré (R. 842-3 a); fait retenu)";
    label en unofficial "kinship with the beneficiary or spouse up to the fourth degree (R. 842-3 a); retained fact)";
}

pub relation enfant_beneficiaire_pa_annee_droit(e: Enfant) kind empirical {
    key(e);
    label fr official "a bénéficié de la prime au cours de l'année civile de droit, comme bénéficiaire ou conjoint (R. 842-3 b); fait retenu)";
    label en unofficial "received the bonus during the civil year of right, as beneficiary or spouse (R. 842-3 b); retained fact)";
}

pub relation enfant_non_beneficiaire_pa_annee_droit(e: Enfant) kind empirical {
    key(e);
    label fr official "n'a pas bénéficié de la prime au cours de l'année civile de droit, ni comme bénéficiaire ni comme conjoint (R. 842-3 b); fait retenu)";
    label en unofficial "did not receive the bonus during the civil year of right, neither as beneficiary nor as spouse (R. 842-3 b); retained fact)";
}

@source(
    CSS_R842_3_ED2021_01_01,
    CSS_R842_3_ED2021_03_25,
    CSS_R842_3_ED2021_06_01,
    CSS_R842_3_ED2022_03_21,
    CSS_R842_3_ED2023_12_31,
    CSS_R842_3_ED2024_01_01,
    CSS_R842_3_ED2024_07_01,
    CSS_R842_3_ED2025_01_01,
    CSS_R842_3_ED2025_02_28,
    CSS_R842_3_ED2025_03_31,
    CSS_R842_3_ED2026_04_01,
    CSS_R842_3_ED2026_06_27)
pub external judgment relation charge_effective_permanente(d: Demandeur, e: Enfant) {
    authority Organisme;
    label fr official "le bénéficiaire assume la charge effective et permanente de l'enfant (R. 842-3 a); appréciation de l'organisme)";
    label en unofficial "the beneficiary has effective and permanent care of the child (R. 842-3 a); organ assessment)";
}

pub relation enfant_membre_foyer(d: Demandeur, e: Enfant) kind institutional {
    key(d, e);
    label fr official "enfant membre du foyer au sens de R. 842-3";
    label en unofficial "child member of the household within the meaning of R. 842-3";
}

pub relation conjoint_membre_foyer(d: Demandeur) kind institutional {
    key(d);
    label fr official "conjoint membre du foyer (R. 842-3 2°)";
    label en unofficial "spouse member of the household (R. 842-3 2°)";
}

pub relation arrivee_apres_17_ans(e: Enfant) kind institutional {
    key(e);
    label fr official "arrivée au foyer après le dix-septième anniversaire (R. 842-3 a))";
    label en unofficial "arrival at the household after the seventeenth birthday (R. 842-3 a))";
}

pub relation arrivee_avant_17_ans(e: Enfant) kind institutional {
    key(e);
    label fr official "arrivée au foyer au plus tard au dix-septième anniversaire (R. 842-3 a))";
    label en unofficial "arrival at the household no later than the seventeenth birthday (R. 842-3 a))";
}

@source(
    CSS_R842_3_ED2021_01_01,
    CSS_R842_3_ED2021_03_25,
    CSS_R842_3_ED2021_06_01,
    CSS_R842_3_ED2022_03_21,
    CSS_R842_3_ED2023_12_31,
    CSS_R842_3_ED2024_01_01,
    CSS_R842_3_ED2024_07_01,
    CSS_R842_3_ED2025_01_01,
    CSS_R842_3_ED2025_02_28,
    CSS_R842_3_ED2025_03_31,
    CSS_R842_3_ED2026_04_01,
    CSS_R842_3_ED2026_06_27)
rule ConjointMembre(d: Demandeur) strict {
    effective [@2021-01-01, infinity);
    label fr official "conjoint présent: membre du foyer (R. 842-3 2°)";
    label en unofficial "spouse present: household member (R. 842-3 2°)";
    when conjoint_present(d);
    then conjoint_membre_foyer(d);
}

@source(
    CSS_R842_3_ED2021_01_01,
    CSS_R842_3_ED2021_03_25,
    CSS_R842_3_ED2021_06_01,
    CSS_R842_3_ED2022_03_21,
    CSS_R842_3_ED2023_12_31,
    CSS_R842_3_ED2024_01_01,
    CSS_R842_3_ED2024_07_01,
    CSS_R842_3_ED2025_01_01,
    CSS_R842_3_ED2025_02_28,
    CSS_R842_3_ED2025_03_31,
    CSS_R842_3_ED2026_04_01,
    CSS_R842_3_ED2026_06_27)
rule EnfantMembrePF(d: Demandeur, e: Enfant) strict {
    effective [@2021-01-01, infinity);
    label fr official "enfant ouvrant droit aux PF et non bénéficiaire: membre (R. 842-3 a)/b))";
    label en unofficial "child with PF entitlement and no bonus: member (R. 842-3 a)/b))";
    when enfant_ou_charge(d, e) and ouvre_droit_pf(e)
        and enfant_non_beneficiaire_pa_annee_droit(e)
        and not_known(enfant_beneficiaire_pa_annee_droit(e));
    then enfant_membre_foyer(d, e);
}

@source(
    CSS_R842_3_ED2021_01_01,
    CSS_R842_3_ED2021_03_25,
    CSS_R842_3_ED2021_06_01,
    CSS_R842_3_ED2022_03_21,
    CSS_R842_3_ED2023_12_31,
    CSS_R842_3_ED2024_01_01,
    CSS_R842_3_ED2024_07_01,
    CSS_R842_3_ED2025_01_01,
    CSS_R842_3_ED2025_02_28,
    CSS_R842_3_ED2025_03_31,
    CSS_R842_3_ED2026_04_01,
    CSS_R842_3_ED2026_06_27)
rule ArriveeApres17(d: Demandeur, e: Enfant, a: Date, n: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "arrivée au foyer après 17 ans révolus (R. 842-3 a))";
    label en unofficial "arrival at the household after the 17th birthday (R. 842-3 a))";
    when enfant_ou_charge(d, e) and arrivee_foyer(e, a) and naissance(e, n)
        and a > add_calendar_period(n, 204 calendar_month);
    then arrivee_apres_17_ans(e);
}

@source(
    CSS_R842_3_ED2021_01_01,
    CSS_R842_3_ED2021_03_25,
    CSS_R842_3_ED2021_06_01,
    CSS_R842_3_ED2022_03_21,
    CSS_R842_3_ED2023_12_31,
    CSS_R842_3_ED2024_01_01,
    CSS_R842_3_ED2024_07_01,
    CSS_R842_3_ED2025_01_01,
    CSS_R842_3_ED2025_02_28,
    CSS_R842_3_ED2025_03_31,
    CSS_R842_3_ED2026_04_01,
    CSS_R842_3_ED2026_06_27)
rule ArriveeAvant17(d: Demandeur, e: Enfant, a: Date, n: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "arrivée au foyer au plus tard au 17 ans révolus (R. 842-3 a))";
    label en unofficial "arrival at the household no later than the 17th birthday (R. 842-3 a))";
    when enfant_ou_charge(d, e) and arrivee_foyer(e, a) and naissance(e, n)
        and a <= add_calendar_period(n, 204 calendar_month);
    then arrivee_avant_17_ans(e);
}

@source(
    CSS_R842_3_ED2021_01_01,
    CSS_R842_3_ED2021_03_25,
    CSS_R842_3_ED2021_06_01,
    CSS_R842_3_ED2022_03_21,
    CSS_R842_3_ED2023_12_31,
    CSS_R842_3_ED2024_01_01,
    CSS_R842_3_ED2024_07_01,
    CSS_R842_3_ED2025_01_01,
    CSS_R842_3_ED2025_02_28,
    CSS_R842_3_ED2025_03_31,
    CSS_R842_3_ED2026_04_01,
    CSS_R842_3_ED2026_06_27)
rule EnfantMembreChargeAvant17(d: Demandeur, e: Enfant, n: Date, md: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "moins de 25 ans, charge effective, arrivée avant 17 ans, non bénéficiaire: membre (R. 842-3)";
    label en unofficial "under 25, effective care, arrival before 17, no bonus: member (R. 842-3)";
    when enfant_ou_charge(d, e) and naissance(e, n) and mois_du_droit(d, md)
        and md < add_calendar_period(n, 300 calendar_month)
        and charge_effective_permanente(d, e)
        and arrivee_avant_17_ans(e)
        and not_known(arrivee_apres_17_ans(e))
        and enfant_non_beneficiaire_pa_annee_droit(e)
        and not_known(enfant_beneficiaire_pa_annee_droit(e));
    then enfant_membre_foyer(d, e);
}

@source(
    CSS_R842_3_ED2021_01_01,
    CSS_R842_3_ED2021_03_25,
    CSS_R842_3_ED2021_06_01,
    CSS_R842_3_ED2022_03_21,
    CSS_R842_3_ED2023_12_31,
    CSS_R842_3_ED2024_01_01,
    CSS_R842_3_ED2024_07_01,
    CSS_R842_3_ED2025_01_01,
    CSS_R842_3_ED2025_02_28,
    CSS_R842_3_ED2025_03_31,
    CSS_R842_3_ED2026_04_01,
    CSS_R842_3_ED2026_06_27)
rule EnfantMembreChargeApres17(d: Demandeur, e: Enfant, n: Date, md: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "moins de 25 ans, charge effective, arrivée après 17 ans avec parenté, non bénéficiaire: membre (R. 842-3)";
    label en unofficial "under 25, effective care, arrival after 17 with kinship, no bonus: member (R. 842-3)";
    when enfant_ou_charge(d, e) and naissance(e, n) and mois_du_droit(d, md)
        and md < add_calendar_period(n, 300 calendar_month)
        and charge_effective_permanente(d, e)
        and arrivee_apres_17_ans(e) and lien_parente_4e_degre(e, d)
        and enfant_non_beneficiaire_pa_annee_droit(e)
        and not_known(enfant_beneficiaire_pa_annee_droit(e));
    then enfant_membre_foyer(d, e);
}

// D-42: «Ne pas bénéficier ou avoir bénéficié, au cours de l'année
// civile de droit, de la prime d'activité» (R. 842-3 3° b)) is a
// condition of every membership branch; a recorded benefit is the
// affirmative contrary of membership.
@source(
    CSS_R842_3_ED2021_01_01,
    CSS_R842_3_ED2021_03_25,
    CSS_R842_3_ED2021_06_01,
    CSS_R842_3_ED2022_03_21,
    CSS_R842_3_ED2023_12_31,
    CSS_R842_3_ED2024_01_01,
    CSS_R842_3_ED2024_07_01,
    CSS_R842_3_ED2025_01_01,
    CSS_R842_3_ED2025_02_28,
    CSS_R842_3_ED2025_03_31,
    CSS_R842_3_ED2026_04_01,
    CSS_R842_3_ED2026_06_27)
rule EnfantNonMembreBeneficiaire(d: Demandeur, e: Enfant) strict {
    effective [@2021-01-01, infinity);
    label fr official "enfant ayant bénéficié de la prime l'année civile de droit: non membre (R. 842-3 b))";
    label en unofficial "child who received the bonus in the civil year of right: not a member (R. 842-3 b))";
    when enfant_ou_charge(d, e) and enfant_beneficiaire_pa_annee_droit(e);
    then not enfant_membre_foyer(d, e);
}

pub relation conjoint_non_retenu(d: Demandeur) kind empirical {
    key(d);
    label fr official "conjoint (époux) ne remplissant pas une ou plusieurs des conditions L. 842-1/2, non retenu pour le foyer (R. 842-4; fait retenu)";
    label en unofficial "spouse not meeting one or more L. 842-1/2 conditions, not counted for the household (R. 842-4; retained fact)";
}

pub relation concubin_non_retenu(d: Demandeur) kind empirical {
    key(d);
    label fr official "concubin ne remplissant pas une ou plusieurs des conditions L. 842-1/2, non retenu pour le foyer (R. 842-4; fait retenu)";
    label en unofficial "concubin not meeting one or more L. 842-1/2 conditions, not counted for the household (R. 842-4; retained fact)";
}

pub relation partenaire_pacs_non_retenu(d: Demandeur) kind empirical {
    key(d);
    label fr official "partenaire lié par un pacte civil de solidarité ne remplissant pas une ou plusieurs des conditions L. 842-1/2, non retenu pour le foyer (R. 842-4; fait retenu)";
    label en unofficial "PACS partner not meeting one or more L. 842-1/2 conditions, not counted for the household (R. 842-4; retained fact)";
}

pub relation ressources_conjoint_comptees(d: Demandeur) kind institutional {
    key(d);
    label fr official "ressources du conjoint, concubin ou partenaire PACS non retenu prises en compte (R. 842-4)";
    label en unofficial "non-counted spouse, concubin or PACS partner resources taken into account (R. 842-4)";
}

pub relation revenus_conjoint_assimiles_remplacement(d: Demandeur, mois: Date, montant: Money) kind institutional {
    key(d, mois);
    label fr official "revenus professionnels du conjoint, concubin ou partenaire PACS non retenu assimilés aux revenus de remplacement L. 842-4 2° (R. 842-4)";
    label en unofficial "non-counted spouse, concubin or PACS partner professional income treated as L. 842-4 2° replacement income (R. 842-4)";
}

@source(
    CSS_R842_4_ED2021_01_01,
    CSS_R842_4_ED2021_03_25,
    CSS_R842_4_ED2021_06_01,
    CSS_R842_4_ED2022_03_21,
    CSS_R842_4_ED2023_12_31,
    CSS_R842_4_ED2024_01_01,
    CSS_R842_4_ED2024_07_01,
    CSS_R842_4_ED2025_01_01,
    CSS_R842_4_ED2025_02_28,
    CSS_R842_4_ED2025_03_31,
    CSS_R842_4_ED2026_04_01,
    CSS_R842_4_ED2026_06_27)
rule ConjointNonRetenuRessources(d: Demandeur) strict {
    effective [@2021-01-01, infinity);
    label fr official "conjoint non retenu: ses ressources prises en compte (R. 842-4)";
    label en unofficial "non-counted spouse: resources taken into account (R. 842-4)";
    when conjoint_non_retenu(d);
    then ressources_conjoint_comptees(d);
}

