    label en unofficial "non-counted spouse: professional income treated as replacement (R. 842-4)";
    when conjoint_non_retenu(d) and revenus_pro_conjoint(d, mois, r);
    then revenus_conjoint_assimiles_remplacement(d, mois, r);
}

