pub relation evenement_isolement(d: Demandeur, date: Date) kind empirical {
    key(d);
    label fr official "début de la charge du parent isolé, ou déclaration de grossesse (R. 842-5; fait retenu)";
    label en unofficial "start of the isolated parent's care, or pregnancy declaration (R. 842-5; retained fact)";
}

pub relation demande_majoration(d: Demandeur, date: Date) kind empirical {
    key(d);
    label fr official "demande de majoration isolé (R. 842-5; fait retenu)";
    label en unofficial "isolated-major amount request (R. 842-5; retained fact)";
}

pub relation mois_retard_demande(d: Demandeur, n: Integer) kind empirical {
    key(d);
    label fr official "mois de retard de la demande au-delà de six mois, en mois entiers (R. 842-5; fait retenu)";
    label en unofficial "request lateness beyond six months, in whole months (R. 842-5; retained fact)";
}

pub relation plus_jeune_trois_ans(d: Demandeur, date: Date) kind empirical {
    key(d);
    label fr official "troisième anniversaire du plus jeune enfant à charge (R. 842-5; fait retenu: naissance + 36 mois)";
    label en unofficial "third birthday of the youngest dependent child (R. 842-5; retained fact: birth + 36 months)";
}

pub relation isolement_sans_enfant(d: Demandeur) kind empirical {
    key(d);
    label fr official "isolement sans enfant à charge au sens de R. 842-5 (fait retenu)";
    label en unofficial "isolation without a dependent child within the meaning of R. 842-5 (retained fact)";
}

pub relation duree_majoration_mois(d: Demandeur, duree: Integer) kind institutional {
    key(d);
    label fr official "durée de la majoration isolé en mois (R. 842-5)";
    label en unofficial "isolated-major amount duration in months (R. 842-5)";
}

pub relation fin_majoration(d: Demandeur, date: Date) kind institutional {
    key(d);
    label fr official "fin de la majoration isolé (R. 842-5)";
    label en unofficial "end of the isolated-major amount (R. 842-5)";
}

@source(
    CSS_R842_5_ED2021_01_01,
    CSS_R842_5_ED2021_03_25,
    CSS_R842_5_ED2021_06_01,
    CSS_R842_5_ED2022_03_21,
    CSS_R842_5_ED2023_12_31,
    CSS_R842_5_ED2024_01_01,
    CSS_R842_5_ED2024_07_01,
    CSS_R842_5_ED2025_01_01,
    CSS_R842_5_ED2025_02_28,
    CSS_R842_5_ED2025_03_31,
    CSS_R842_5_ED2026_04_01,
    CSS_R842_5_ED2026_06_27)
rule MajorationDureeBase(d: Demandeur, ev: Date, dm: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "demande dans les six mois: douze mois (R. 842-5)";
    label en unofficial "request within six months: twelve months (R. 842-5)";
    when evenement_isolement(d, ev) and demande_majoration(d, dm)
        and dm <= add_calendar_period(ev, 6 calendar_month);
    then duree_majoration_mois(d, 12);
}

@source(
    CSS_R842_5_ED2021_01_01,
    CSS_R842_5_ED2021_03_25,
    CSS_R842_5_ED2021_06_01,
    CSS_R842_5_ED2022_03_21,
    CSS_R842_5_ED2023_12_31,
    CSS_R842_5_ED2024_01_01,
    CSS_R842_5_ED2024_07_01,
    CSS_R842_5_ED2025_01_01,
    CSS_R842_5_ED2025_02_28,
    CSS_R842_5_ED2025_03_31,
    CSS_R842_5_ED2026_04_01,
    CSS_R842_5_ED2026_06_27)
rule MajorationDureeReduite(d: Demandeur, ev: Date, dm: Date, n: Integer) strict {
    effective [@2021-01-01, infinity);
    label fr official "demande tardive: douze mois moins le retard (R. 842-5)";
    label en unofficial "late request: twelve months minus the lateness (R. 842-5)";
    when evenement_isolement(d, ev) and demande_majoration(d, dm)
        and dm > add_calendar_period(ev, 6 calendar_month)
        and mois_retard_demande(d, n) and 12 - n >= 0;
    then duree_majoration_mois(d, 12 - n);
}

@source(
    CSS_R842_5_ED2021_01_01,
    CSS_R842_5_ED2021_03_25,
    CSS_R842_5_ED2021_06_01,
    CSS_R842_5_ED2022_03_21,
    CSS_R842_5_ED2023_12_31,
    CSS_R842_5_ED2024_01_01,
    CSS_R842_5_ED2024_07_01,
    CSS_R842_5_ED2025_01_01,
    CSS_R842_5_ED2025_02_28,
    CSS_R842_5_ED2025_03_31,
    CSS_R842_5_ED2026_04_01,
    CSS_R842_5_ED2026_06_27)
rule MajorationFinBase(d: Demandeur, ev: Date, bday: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "durée pleine, trois ans avant le terme: fin à douze mois (R. 842-5)";
    label en unofficial "full duration, third birthday before the term: end at twelve months (R. 842-5)";
    when evenement_isolement(d, ev) and duree_majoration_mois(d, 12)
        and plus_jeune_trois_ans(d, bday)
        and bday <= add_calendar_period(ev, 12 calendar_month);
    then fin_majoration(d, add_calendar_period(ev, 12 calendar_month));
}

@source(
    CSS_R842_5_ED2021_01_01,
    CSS_R842_5_ED2021_03_25,
    CSS_R842_5_ED2021_06_01,
    CSS_R842_5_ED2022_03_21,
    CSS_R842_5_ED2023_12_31,
    CSS_R842_5_ED2024_01_01,
    CSS_R842_5_ED2024_07_01,
    CSS_R842_5_ED2025_01_01,
    CSS_R842_5_ED2025_02_28,
    CSS_R842_5_ED2025_03_31,
    CSS_R842_5_ED2026_04_01,
    CSS_R842_5_ED2026_06_27)
rule MajorationFinProlongee(d: Demandeur, ev: Date, bday: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "durée pleine, trois ans après le terme: fin aux trois ans (R. 842-5)";
    label en unofficial "full duration, third birthday after the term: end at three years (R. 842-5)";
    when evenement_isolement(d, ev) and duree_majoration_mois(d, 12)
        and plus_jeune_trois_ans(d, bday)
        and bday > add_calendar_period(ev, 12 calendar_month);
    then fin_majoration(d, bday);
}

@source(
    CSS_R842_5_ED2021_01_01,
    CSS_R842_5_ED2021_03_25,
    CSS_R842_5_ED2021_06_01,
    CSS_R842_5_ED2022_03_21,
    CSS_R842_5_ED2023_12_31,
    CSS_R842_5_ED2024_01_01,
    CSS_R842_5_ED2024_07_01,
    CSS_R842_5_ED2025_01_01,
    CSS_R842_5_ED2025_02_28,
    CSS_R842_5_ED2025_03_31,
    CSS_R842_5_ED2026_04_01,
    CSS_R842_5_ED2026_06_27)
rule MajorationFinSansEnfant(d: Demandeur, ev: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "durée pleine sans enfant: fin à douze mois (R. 842-5)";
    label en unofficial "full duration without a child: end at twelve months (R. 842-5)";
    when evenement_isolement(d, ev) and duree_majoration_mois(d, 12)
        and isolement_sans_enfant(d);
    then fin_majoration(d, add_calendar_period(ev, 12 calendar_month));
}

pub relation mois_evenement_l8427(d: Demandeur, mois: Date) kind empirical {
    key(d);
    label fr official "mois civil où une condition L. 842-7 est remplie, au premier jour (R. 843-2; fait retenu)";
    label en unofficial "civil month when an L. 842-7 condition is met, at the first day (R. 843-2; retained fact)";
}

pub relation mois_separation(d: Demandeur, mois: Date) kind empirical {
    key(d);
    label fr official "mois civil de l'interruption de la vie commune, au premier jour (R. 843-2; fait retenu)";
    label en unofficial "civil month of the couple separation, at the first day (R. 843-2; retained fact)";
}

pub relation revision_prend_effet(d: Demandeur, mois: Date) kind institutional {
    key(d);
    label fr official "révision prenant effet au premier jour du mois de l'événement (R. 843-2)";
    label en unofficial "revision taking effect on the first day of the event month (R. 843-2)";
}

@source(
    CSS_R843_2_PRE2025_ED2021_01_01,
    CSS_R843_2_PRE2025_ED2021_03_25,
    CSS_R843_2_PRE2025_ED2021_06_01,
    CSS_R843_2_PRE2025_ED2022_03_21,
    CSS_R843_2_PRE2025_ED2023_12_31,
    CSS_R843_2_PRE2025_ED2024_01_01,
    CSS_R843_2_PRE2025_ED2024_07_01,
    CSS_R843_2_PRE2025_ED2025_01_01,
    CSS_R843_2_ED2025_02_28,
    CSS_R843_2_ED2025_03_31,
    CSS_R843_2_ED2026_04_01,
    CSS_R843_2_ED2026_06_27)
rule RevisionL8427Ancienne(d: Demandeur, mois: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "ancien: révision sur condition L. 842-7 (R. 843-2; porte NOTA)";
    label en unofficial "old: revision on an L. 842-7 condition (R. 843-2; NOTA gate)";
    when mois_evenement_l8427(d, mois) and dispositions_anciennes_2025(d, mois);
    then revision_prend_effet(d, mois);
}

@source(
    CSS_R843_2_ED2025_02_28,
    CSS_R843_2_ED2025_03_31,
    CSS_R843_2_ED2026_04_01,
    CSS_R843_2_ED2026_06_27)
rule RevisionL8427Nouvelle(d: Demandeur, mois: Date) strict {
    effective [@2025-03-01, infinity);
    label fr official "révision sur condition L. 842-7 (R. 843-2; porte NOTA)";
    label en unofficial "revision on an L. 842-7 condition (R. 843-2; NOTA gate)";
    when mois_evenement_l8427(d, mois) and dispositions_nouvelles_2025(d, mois);
    then revision_prend_effet(d, mois);
}

@source(
    CSS_R843_2_ED2025_02_28,
    CSS_R843_2_ED2025_03_31,
    CSS_R843_2_ED2026_04_01,
    CSS_R843_2_ED2026_06_27)
rule RevisionSeparationNouvelle(d: Demandeur, mois: Date) strict {
    effective [@2025-03-01, infinity);
    label fr official "révision sur interruption de la vie commune (R. 843-2; porte NOTA)";
    label en unofficial "revision on couple separation (R. 843-2; NOTA gate)";
    when mois_separation(d, mois) and dispositions_nouvelles_2025(d, mois);
    then revision_prend_effet(d, mois);
}

pub relation reexamen_trimestriel_du(d: Demandeur, date: Date) kind empirical {
    key(d, date);
    label fr official "réexamen trimestriel dû au lendemain de trois mois civils (D. 846-1; fait retenu)";
    label en unofficial "quarterly re-examination due after three civil months (D. 846-1; retained fact)";
}

pub relation ouverture_rsa(d: Demandeur, date: Date) kind empirical {
    key(d, date);
    label fr official "ouverture d'un droit au RSA (CASF L. 262-1; D. 846-1; fait retenu)";
    label en unofficial "opening of an RSA right (CASF L. 262-1; D. 846-1; retained fact)";
}

pub relation ressources_foyer_declarees(d: Demandeur, date: Date) kind empirical {
    key(d, date);
    label fr official "ressources du foyer déclarées au réexamen (D. 846-1; fait retenu)";
    label en unofficial "household resources declared at re-examination (D. 846-1; retained fact)";
}

pub relation reexamen_du(d: Demandeur, date: Date) kind institutional {
    key(d, date);
    label fr official "réexamen périodique dû (D. 846-1)";
    label en unofficial "periodic re-examination due (D. 846-1)";
}

@source(
    CSS_D846_1_ED2021_01_01,
    CSS_D846_1_ED2021_03_25,
    CSS_D846_1_ED2021_06_01,
    CSS_D846_1_ED2022_03_21,
    CSS_D846_1_ED2023_12_31,
    CSS_D846_1_ED2024_01_01,
    CSS_D846_1_ED2024_07_01,
    CSS_D846_1_ED2025_01_01,
    CSS_D846_1_ED2025_02_28,
    CSS_D846_1_ED2025_03_31,
    CSS_D846_1_ED2026_04_01,
    CSS_D846_1_ED2026_06_27)
rule ReexamenTrimestriel(d: Demandeur, date: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "réexamen au lendemain de trois mois civils (D. 846-1)";
    label en unofficial "re-examination after three civil months (D. 846-1)";
    when reexamen_trimestriel_du(d, date);
    then reexamen_du(d, date);
}

@source(
    CSS_D846_1_ED2021_01_01,
    CSS_D846_1_ED2021_03_25,
    CSS_D846_1_ED2021_06_01,
    CSS_D846_1_ED2022_03_21,
    CSS_D846_1_ED2023_12_31,
    CSS_D846_1_ED2024_01_01,
    CSS_D846_1_ED2024_07_01,
    CSS_D846_1_ED2025_01_01,
    CSS_D846_1_ED2025_02_28,
    CSS_D846_1_ED2025_03_31,
    CSS_D846_1_ED2026_04_01,
    CSS_D846_1_ED2026_06_27)
rule ReexamenOuvertureRSA(d: Demandeur, date: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "réexamen à l'ouverture d'un droit au RSA (D. 846-1)";
    label en unofficial "re-examination on RSA right opening (D. 846-1)";
    when ouverture_rsa(d, date);
    then reexamen_du(d, date);
}

@source(
    CSS_D846_1_ED2021_01_01,
    CSS_D846_1_ED2021_03_25,
    CSS_D846_1_ED2021_06_01,
    CSS_D846_1_ED2022_03_21,
    CSS_D846_1_ED2023_12_31,
    CSS_D846_1_ED2024_01_01,
    CSS_D846_1_ED2024_07_01,
    CSS_D846_1_ED2025_01_01,
    CSS_D846_1_ED2025_02_28,
    CSS_D846_1_ED2025_03_31,
    CSS_D846_1_ED2026_04_01,
    CSS_D846_1_ED2026_06_27)
rule DevoirDeclarerRessourcesReexamen(d: Demandeur, o: Organisme, date: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "D3: le bénéficiaire déclare les ressources du foyer au réexamen (D. 846-1)";
    label en unofficial "D3: the payee declares household resources at re-examination (D. 846-1)";
    when reexamen_du(d, date) and organisme_serviteur(o, d);
    then duty DeclarerRessourcesReexamen {
        bearer d;
        beneficiary o;
        maintain ressources_foyer_declarees(d, date) during [@2021-01-01, infinity);
    };
}

pub relation dernier_versement(d: Demandeur, date: Date) kind empirical {
    key(d);
    label fr official "dernier versement de la prime (D. 846-3; fait retenu)";
    label en unofficial "last payment of the bonus (D. 846-3; retained fact)";
}

pub relation date_observation(d: Demandeur, date: Date) kind empirical {
    key(d);
    label fr official "date d'observation du délai de radiation (D. 846-3; fait retenu)";
    label en unofficial "observation date of the radiation delay (D. 846-3; retained fact)";
}

pub relation delai_radiation_24m_ecoule(d: Demandeur) kind institutional {
    key(d);
    label fr official "délai de vingt-quatre mois sans versement écoulé (D. 846-3)";
    label en unofficial "twenty-four month no-payment delay elapsed (D. 846-3)";
}

@source(
    CSS_D846_3_ED2021_01_01,
    CSS_D846_3_ED2021_03_25,
    CSS_D846_3_ED2021_06_01,
    CSS_D846_3_ED2022_03_21,
    CSS_D846_3_ED2023_12_31,
    CSS_D846_3_ED2024_01_01,
    CSS_D846_3_ED2024_07_01,
    CSS_D846_3_ED2025_01_01,
    CSS_D846_3_ED2025_02_28,
    CSS_D846_3_ED2025_03_31,
    CSS_D846_3_ED2026_04_01,
    CSS_D846_3_ED2026_06_27)
rule DelaiRadiationEcoule(d: Demandeur, v: Date, now: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "vingt-quatre mois sans versement écoulés (D. 846-3)";
    label en unofficial "twenty-four months without payment elapsed (D. 846-3)";
    when dernier_versement(d, v) and date_observation(d, now)
        and now >= add_calendar_period(v, 24 calendar_month);
    then delai_radiation_24m_ecoule(d);
}
