pub entity Enfant {
    label fr official "enfant ou personne à charge du foyer (R. 842-3 3°)";
    label en unofficial "child or dependent of the household (R. 842-3 3°)";
}

pub enum RoleFoyer {
    label fr official "bénéficiaire ou conjoint au sens de R. 842-2";
    label en unofficial "beneficiary or spouse within the meaning of R. 842-2";
    BENEFICIAIRE, CONJOINT
}

pub enum SlotCondition {
    label fr official "condition L. 842-1 / L. 842-2 1°..5° suivie au mois (R. 842-2)";
    label en unofficial "L. 842-1 / L. 842-2 1°..5° condition tracked by month (R. 842-2)";
    COND_L8421, COND_L8422_1, COND_L8422_2, COND_L8422_3, COND_L8422_4, COND_L8422_5
}

pub relation sejour_duree(d: Demandeur, sejour: Integer, duree_mois: Integer) kind empirical {
    key(d, sejour);
    label fr official "séjour hors de France n° indexé, durée de date à date en mois entiers (R. 842-1; fait retenu)";
    label en unofficial "indexed stay outside France, date-to-date duration in whole months (R. 842-1; retained fact)";
}

pub relation sejour_insertion(d: Demandeur, sejour: Integer) kind empirical {
    key(d, sejour);
    label fr official "séjour exclu du calcul: contrats L. 262-34/35 CASF ou PPAE L. 5411-6-1 (R. 842-1; fait retenu)";
    label en unofficial "stay excluded from the computation: L. 262-34/35 contracts or PPAE (R. 842-1; retained fact)";
}

pub relation duree_totale_etrangere_annee(d: Demandeur, annee: Integer, total_mois: Integer) kind empirical {
    key(d, annee);
    label fr official "durée totale hors de France par année civile, nette des séjours d'insertion (R. 842-1; fait retenu)";
    label en unofficial "total time outside France per calendar year, net of insertion stays (R. 842-1; retained fact)";
}

pub relation sejour_hors_insertion(d: Demandeur, sejour: Integer) kind empirical {
    key(d, sejour);
    label fr official "séjour hors insertion: ni contrats L. 262-34/35 CASF ni PPAE L. 5411-6-1 (R. 842-1; fait retenu)";
    label en unofficial "non-insertion stay: neither L. 262-34/35 contracts nor PPAE (R. 842-1; retained fact)";
}

pub relation residence_permanente_france(d: Demandeur) kind empirical {
    key(d);
    label fr official "réside en France de façon permanente (R. 842-1; fait retenu)";
    label en unofficial "resides in France permanently (R. 842-1; retained fact)";
}

pub relation historique_sejours_complet(d: Demandeur) kind empirical {
    key(d);
    label fr official "historique des séjours hors de France complet et classé, total annuel net établi (R. 842-1; fait retenu)";
    label en unofficial "complete and classified history of stays outside France, net annual total established (R. 842-1; retained fact)";
}

pub relation sejour_excessif(d: Demandeur) kind institutional {
    key(d);
    label fr official "séjour de plus de trois mois hors insertion (R. 842-1)";
    label en unofficial "stay over three months outside insertion (R. 842-1)";
}

pub relation total_etranger_excessif(d: Demandeur) kind institutional {
    key(d);
    label fr official "total annuel hors de France de plus de trois mois (R. 842-1)";
    label en unofficial "annual total outside France over three months (R. 842-1)";
}

pub relation residence_r842_1(d: Demandeur) kind institutional {
    key(d);
    label fr official "résidence stable et effective au sens de R. 842-1";
    label en unofficial "stable and effective residence within the meaning of R. 842-1";
}

@source(
    CSS_R842_1_ED2021_01_01,
    CSS_R842_1_ED2021_03_25,
    CSS_R842_1_ED2021_06_01,
    CSS_R842_1_ED2022_03_21,
    CSS_R842_1_ED2023_12_31,
    CSS_R842_1_ED2024_01_01,
    CSS_R842_1_ED2024_07_01,
    CSS_R842_1_ED2025_01_01,
    CSS_R842_1_ED2025_02_28,
    CSS_R842_1_ED2025_03_31,
    CSS_R842_1_ED2026_04_01,
    CSS_R842_1_ED2026_06_27)
rule SejourExcessif(d: Demandeur, s: Integer, m: Integer) strict {
    effective [@2021-01-01, infinity);
    label fr official "séjour de plus de trois mois hors insertion (R. 842-1)";
    label en unofficial "stay over three months outside insertion (R. 842-1)";
    when sejour_duree(d, s, m) and m > 3 and sejour_hors_insertion(d, s)
        and not_known(sejour_insertion(d, s));
    then sejour_excessif(d);
}

@source(
    CSS_R842_1_ED2021_01_01,
    CSS_R842_1_ED2021_03_25,
    CSS_R842_1_ED2021_06_01,
    CSS_R842_1_ED2022_03_21,
    CSS_R842_1_ED2023_12_31,
    CSS_R842_1_ED2024_01_01,
    CSS_R842_1_ED2024_07_01,
    CSS_R842_1_ED2025_01_01,
    CSS_R842_1_ED2025_02_28,
    CSS_R842_1_ED2025_03_31,
    CSS_R842_1_ED2026_04_01,
    CSS_R842_1_ED2026_06_27)
rule TotalEtrangerExcessif(d: Demandeur, a: Integer, t: Integer) strict {
    effective [@2021-01-01, infinity);
    label fr official "total annuel hors de France de plus de trois mois (R. 842-1)";
    label en unofficial "annual total outside France over three months (R. 842-1)";
    when duree_totale_etrangere_annee(d, a, t) and t > 3;
    then total_etranger_excessif(d);
}

@source(
    CSS_R842_1_ED2021_01_01,
    CSS_R842_1_ED2021_03_25,
    CSS_R842_1_ED2021_06_01,
    CSS_R842_1_ED2022_03_21,
    CSS_R842_1_ED2023_12_31,
    CSS_R842_1_ED2024_01_01,
    CSS_R842_1_ED2024_07_01,
    CSS_R842_1_ED2025_01_01,
    CSS_R842_1_ED2025_02_28,
    CSS_R842_1_ED2025_03_31,
    CSS_R842_1_ED2026_04_01,
    CSS_R842_1_ED2026_06_27)
rule ResidencePermanenteR8421(d: Demandeur) strict {
    effective [@2021-01-01, infinity);
    label fr official "résidence stable et effective: résidence permanente (R. 842-1)";
    label en unofficial "stable and effective residence: permanent residence (R. 842-1)";
    when residence_permanente_france(d);
    then residence_r842_1(d);
}

@source(
    CSS_R842_1_ED2021_01_01,
    CSS_R842_1_ED2021_03_25,
    CSS_R842_1_ED2021_06_01,
    CSS_R842_1_ED2022_03_21,
    CSS_R842_1_ED2023_12_31,
    CSS_R842_1_ED2024_01_01,
    CSS_R842_1_ED2024_07_01,
    CSS_R842_1_ED2025_01_01,
    CSS_R842_1_ED2025_02_28,
    CSS_R842_1_ED2025_03_31,
    CSS_R842_1_ED2026_04_01,
    CSS_R842_1_ED2026_06_27)
rule ResidenceSansDepassementR8421(d: Demandeur) strict {
    effective [@2021-01-01, infinity);
    label fr official "résidence stable et effective: historique complet sans dépassement (R. 842-1)";
    label en unofficial "stable and effective residence: complete history without excess (R. 842-1)";
    when historique_sejours_complet(d)
        and not_known(sejour_excessif(d)) and not_known(total_etranger_excessif(d));
    then residence_r842_1(d);
}

pub relation condition_mensuelle(d: Demandeur, mois: Date, rf: RoleFoyer, slot: SlotCondition) kind empirical {
    key(d, mois, rf, slot);
    label fr official "condition remplie au mois civil: rôle et rubrique (R. 842-2; fait retenu)";
    label en unofficial "condition met in the civil month: role and slot (R. 842-2; retained fact)";
}

pub relation mois_du_droit(d: Demandeur, mois: Date) kind empirical {
    key(d);
    label fr official "mois du droit (R. 842-2; fait retenu)";
    label en unofficial "month of right (R. 842-2; retained fact)";
}

pub relation conjoint_present(d: Demandeur) kind empirical {
    key(d);
    label fr official "conjoint, concubin ou partenaire au foyer (R. 842-2/3; fait retenu)";
    label en unofficial "spouse, partner at the household (R. 842-2/3; retained fact)";
}

pub relation sans_conjoint(d: Demandeur) kind empirical {
    key(d);
    label fr official "ni conjoint, concubin ni partenaire au foyer (R. 842-2/3; fait retenu)";
    label en unofficial "no spouse or partner at the household (R. 842-2/3; retained fact)";
}

pub relation conditions_beneficiaire_ok(d: Demandeur, revue: Date) kind institutional {
    key(d, revue);
    label fr official "conditions du bénéficiaire remplies aux mois requis (R. 842-2 I)";
    label en unofficial "beneficiary conditions met in the required months (R. 842-2 I)";
}

pub relation conditions_conjoint_ok(d: Demandeur, revue: Date) kind institutional {
    key(d, revue);
    label fr official "conditions du conjoint remplies aux mois requis (R. 842-2 II)";
    label en unofficial "spouse conditions met in the required months (R. 842-2 II)";
}

pub relation conditions_temporelles_ok(d: Demandeur, revue: Date) kind institutional {
    key(d, revue);
    label fr official "conditions remplies aux mois requis, foyer avec ou sans conjoint (R. 842-2)";
    label en unofficial "conditions met in the required months, household with or without spouse (R. 842-2)";
}

pub relation allocataire_msa(d: Demandeur) kind empirical {
    key(d);
    label fr official "allocataire d'une caisse de MSA au sens de la NOTA du décret 2025-185 (R. 842-2/843-2/845-1/2; fait retenu)";
    label en unofficial "MSA fund claimant within the meaning of decree 2025-185 NOTA (R. 842-2/843-2/845-1/2; retained fact)";
}

pub relation arrete_msa_application(date: Date) kind empirical {
    key();
    label fr official "date d'application MSA fixée par arrêté ministériel, au plus tard le 2025-09-01 (NOTA 2025-185; fait retenu)";
    label en unofficial "MSA application date set by ministerial order, no later than 2025-09-01 (NOTA 2025-185; retained fact)";
}

pub relation regime_general(d: Demandeur) kind empirical {
    key(d);
    label fr official "relevé du régime général, hors MSA (NOTA 2025-185; fait retenu)";
    label en unofficial "general-scheme claimant, outside MSA (NOTA 2025-185; retained fact)";
}

pub relation dispositions_nouvelles_2025(d: Demandeur, date: Date) kind institutional {
    key(d, date);
    label fr official "demande/réexamen soumis aux dispositions nouvelles du décret 2025-185 (NOTA R. 842-2/843-2/845-1/2)";
    label en unofficial "request/review under the new 2025-185 provisions (NOTA R. 842-2/843-2/845-1/2)";
}

pub relation dispositions_anciennes_2025(d: Demandeur, date: Date) kind institutional {
    key(d, date);
    label fr official "demande/réexamen soumis aux dispositions antérieures au décret 2025-185 (NOTA R. 842-2/843-2/845-1/2)";
    label en unofficial "request/review under the pre-2025-185 provisions (NOTA R. 842-2/843-2/845-1/2)";
}

// D-42: the NOTA of decree 2025-185 keys the wording on «les demandes
// ou réexamens périodiques effectués à compter du 1er mars 2025»;
// the R. 843-2 revision «prend effet à compter du premier jour du mois
// civil au cours duquel s'est produit l'évènement». The gate date is
// therefore the claim/review month (mois_revue, R. 843-1 I) or, for an
// R. 843-2 revision, the event month; date_porte_nota binds it so the
// gate rules stay range-restricted without requiring a review month
// for an out-of-review revision.
pub relation date_porte_nota(d: Demandeur, date: Date) kind institutional {
    key(d, date);
    label fr official "date de demande, de réexamen ou d'évènement de révision soumise à la porte NOTA 2025-185 (R. 842-2/843-2)";
    label en unofficial "claim, review or revision-event date subject to the NOTA 2025-185 gate (R. 842-2/843-2)";
}

@source(
    CSS_R842_2_PRE2025_ED2021_01_01,
    CSS_R842_2_PRE2025_ED2021_03_25,
    CSS_R842_2_PRE2025_ED2021_06_01,
    CSS_R842_2_PRE2025_ED2022_03_21,
    CSS_R842_2_PRE2025_ED2023_12_31,
    CSS_R842_2_PRE2025_ED2024_01_01,
    CSS_R842_2_PRE2025_ED2024_07_01,
    CSS_R842_2_PRE2025_ED2025_01_01,
    CSS_R842_2_ED2025_02_28,
    CSS_R842_2_ED2025_03_31,
    CSS_R842_2_ED2026_04_01,
    CSS_R842_2_ED2026_06_27,
    CSS_R843_2_PRE2025_ED2021_01_01,
    CSS_R843_2_PRE2025_ED2021_03_25,
    CSS_R843_2_PRE2025_ED2021_06_01,
    CSS_R843_2_PRE2025_ED2022_03_21,
    CSS_R843_2_PRE2025_ED2023_12_31,
    CSS_R843_2_PRE2025_ED2024_01_01,
    CSS_R843_2_PRE2025_ED2024_07_01,
    CSS_R843_2_PRE2025_ED2025_01_01,
    CSS_R843_2_ED2025_02_28,
    CSS_R843_2_ED2025_03_31,
    CSS_R843_2_ED2026_04_01,
    CSS_R843_2_ED2026_06_27)
rule DatePorteRevue(d: Demandeur, date: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "mois de demande ou de réexamen (R. 843-1 I; NOTA 2025-185)";
    label en unofficial "claim or review month (R. 843-1 I; NOTA 2025-185)";
    when mois_revue(d, date);
    then date_porte_nota(d, date);
}

@source(
