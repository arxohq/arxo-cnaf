rule ForfaitLogementCouple(d: Demandeur, mois: Date, base: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "forfait logement : 16 % du montant forfaitaire calculé pour deux personnes, couple (R. 844-3 2°, D. 843-1 al. 1)";
    label en unofficial "housing forfait: 16 % of the flat-rate amount calculated for two persons, couple (R. 844-3 2°, D. 843-1 para. 1)";
    when forme_foyer_retenue(d, mois, COUPLE) and forfait_base_du_mois(mois, base);
    then forfait_logement_du_mois(d, mois, base * 1.5 * 0.16);
}

