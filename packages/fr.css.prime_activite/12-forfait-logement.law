    CSS_R844_4_ED2025_03_31,
    CSS_R844_4_ED2026_04_01,
    CSS_R844_4_ED2026_06_27)
rule LogementAidePlafonnee(d: Demandeur, mois: Date, a: Money, f: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "aide personnelle au logement incluse dans les ressources, dans la limite du forfait : aide supérieure au forfait, le forfait est retenu (R. 844-4 I)";
    label en unofficial "personal housing aid included in the resources up to the forfait: aid above the forfait, the forfait is used (R. 844-4 I)";
    when situation_logement_retenue(d, mois, AIDE) and aide_logement_retenue(d, mois, a) and forfait_logement_du_mois(d, mois, f) and a > f;
    then logement_ressource_mois(d, mois, f);
}

