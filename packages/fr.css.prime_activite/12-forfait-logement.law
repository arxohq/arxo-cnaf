    CSS_R844_3_ED2025_02_28,
    CSS_R844_3_ED2025_03_31,
    CSS_R844_3_ED2026_04_01,
    CSS_R844_3_ED2026_06_27,
    CSS_R844_3_PRE2024_ED2021_01_01,
    CSS_R844_3_PRE2024_ED2021_03_25,
    CSS_R844_3_PRE2024_ED2021_06_01,
    CSS_R844_3_PRE2024_ED2022_03_21,
    CSS_R844_4_ED2021_01_01,
    CSS_R844_4_ED2021_03_25,
    CSS_R844_4_ED2021_06_01,
    CSS_R844_4_ED2022_03_21,
    CSS_R844_4_ED2023_12_31,
    CSS_R844_4_ED2024_01_01,
    CSS_R844_4_ED2024_07_01,
    CSS_R844_4_ED2025_01_01,
    CSS_R844_4_ED2025_02_28,
    CSS_R844_4_ED2025_03_31,
    CSS_R844_4_ED2026_04_01,
    CSS_R844_4_ED2026_06_27,
    Demandeur,
    FormeFoyer,
    forfait_base_du_mois,
    forme_foyer_retenue,
    revenus_mensuels_retenus,
};

pub enum SituationLogement {
    label fr official "situation de logement du foyer pour le mois (R. 844-3, R. 844-4 I)";
    label en unofficial "household housing situation for the month (R. 844-3, R. 844-4 I)";
    AIDE, NATURE, SANS
}

pub relation situation_logement_retenue(d: Demandeur, mois: Date, situation: SituationLogement) kind empirical {
    key(d, mois);
    label fr official "situation de logement du mois : aide personnelle au logement perçue, logement occupé par son propriétaire sans aide ou à titre gratuit, ou aucune (fait retenu)";
    label en unofficial "housing situation of the month: personal housing aid received, owner-occupied without aid or free housing, or none (retained fact)";
}

pub relation aide_logement_retenue(d: Demandeur, mois: Date, montant: Money) kind empirical {
    key(d, mois);
    label fr official "aide personnelle au logement perçue au cours du mois (R. 844-4 I; fait retenu)";
    label en unofficial "personal housing aid received in the month (R. 844-4 I; retained fact)";
}

pub relation ressources_hors_logement_retenues(d: Demandeur, mois: Date, total: Money) kind empirical {
    key(d, mois);
    label fr official "ressources du foyer du mois, catégories L. 842-4, hors élément de logement (fait retenu B-PPA-RESSOURCES-CALCUL)";
    label en unofficial "household resources of the month, L. 842-4 categories, without the housing item (retained fact B-PPA-RESSOURCES-CALCUL)";
}

pub relation forfait_logement_du_mois(d: Demandeur, mois: Date, montant: Money) kind institutional {
    key(d, mois);
    label fr official "forfait logement du mois : 12 %, 16 % ou 16,5 % du montant forfaitaire selon le nombre de personnes (R. 844-3)";
    label en unofficial "housing forfait of the month: 12 %, 16 % or 16.5 % of the flat-rate amount by number of persons (R. 844-3)";
}

pub relation logement_ressource_mois(d: Demandeur, mois: Date, montant: Money) kind institutional {
    key(d, mois);
    label fr official "élément de logement des ressources du mois : aide dans la limite du forfait, avantage en nature forfaitaire, ou zéro (R. 844-3, R. 844-4 I)";
    label en unofficial "housing item of the month's resources: aid up to the forfait, flat-rate benefit in kind, or zero (R. 844-3, R. 844-4 I)";
}

pub relation ressources_foyer_mois(d: Demandeur, mois: Date, total: Money) kind institutional {
    key(d, mois);
    label fr official "ressources du foyer du mois prises en compte avant le plancher L. 842-3 2° (total retenu, ou ressources hors logement et élément de logement)";
    label en unofficial "household resources of the month before the L. 842-3 2 floor (retained total, or resources without housing plus the housing item)";
}

