    CSS_R844_4_ED2021_06_01,
    CSS_R844_4_ED2022_03_21,
    CSS_R844_4_ED2023_12_31,
    CSS_R844_4_ED2024_01_01,
    CSS_R844_4_ED2024_07_01,
    CSS_R844_4_ED2025_01_01,
    CSS_R844_4_ED2025_02_28,
    CSS_R844_4_ED2025_03_31,
    CSS_R844_4_ED2026_04_01,
    CSS_R844_4_ED2026_06_27)
rule LogementAide(d: Demandeur, mois: Date, a: Money, f: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "aide personnelle au logement incluse dans les ressources, dans la limite du forfait : aide inférieure ou égale au forfait (R. 844-4 I)";
    label en unofficial "personal housing aid included in the resources up to the forfait: aid not above the forfait (R. 844-4 I)";
    when situation_logement_retenue(d, mois, AIDE) and aide_logement_retenue(d, mois, a) and forfait_logement_du_mois(d, mois, f) and a <= f;
    then logement_ressource_mois(d, mois, a);
}

