    CSS_R844_3_ED2025_03_31,
    CSS_R844_3_ED2026_04_01,
    CSS_R844_3_ED2026_06_27)
rule LogementSans(d: Demandeur, mois: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "ni aide personnelle au logement ni avantage en nature : aucun élément de logement dans les ressources (R. 844-3, R. 844-4 I)";
    label en unofficial "neither personal housing aid nor benefit in kind: no housing item in the resources (R. 844-3, R. 844-4 I)";
    when situation_logement_retenue(d, mois, SANS);
    then logement_ressource_mois(d, mois, 0 EUR);
}

