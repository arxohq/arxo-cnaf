rule RessourcesFoyerComposees(d: Demandeur, mois: Date, r: Money, l: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "ressources du mois : ressources hors logement augmentées de l'élément de logement (L. 842-4, R. 844-3, R. 844-4 I)";
    label en unofficial "month resources: resources without housing plus the housing item (L. 842-4, R. 844-3, R. 844-4 I)";
    when ressources_hors_logement_retenues(d, mois, r) and logement_ressource_mois(d, mois, l);
    then ressources_foyer_mois(d, mois, r + l);
}
