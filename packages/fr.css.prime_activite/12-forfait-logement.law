rule ForfaitLogementIsole(d: Demandeur, mois: Date, base: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "forfait logement : 12 % du montant forfaitaire d'une seule personne, foyer isolé d'une personne (R. 844-3 1°)";
    label en unofficial "housing forfait: 12 % of the single-person flat-rate amount, isolated one-person household (R. 844-3 1°)";
    when forme_foyer_retenue(d, mois, ISOLE) and forfait_base_du_mois(mois, base);
    then forfait_logement_du_mois(d, mois, base * 0.12);
}

