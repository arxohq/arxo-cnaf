    CSS_R844_3_ED2025_03_31,
    CSS_R844_3_ED2026_04_01,
    CSS_R844_3_ED2026_06_27,
    CSS_D843_1_ED2021_01_01,
    CSS_D843_1_ED2021_03_25,
    CSS_D843_1_ED2021_06_01,
    CSS_D843_1_ED2022_03_21,
    CSS_D843_1_ED2023_12_31,
    CSS_D843_1_ED2024_01_01,
    CSS_D843_1_ED2024_07_01,
    CSS_D843_1_ED2025_01_01,
    CSS_D843_1_ED2025_02_28,
    CSS_D843_1_ED2025_03_31,
    CSS_D843_1_ED2026_04_01,
    CSS_D843_1_ED2026_06_27)
rule ForfaitLogementSeul(d: Demandeur, mois: Date, base: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "forfait logement : 12 % du montant forfaitaire d'une seule personne (R. 844-3 1°)";
    label en unofficial "housing forfait: 12 % of the single-person flat-rate amount (R. 844-3 1°)";
    when forme_foyer_retenue(d, mois, SEUL) and forfait_base_du_mois(mois, base);
    then forfait_logement_du_mois(d, mois, base * 0.12);
}

