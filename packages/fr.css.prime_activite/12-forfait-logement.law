    CSS_L842_4_ED2025_02_28,
    CSS_L842_4_ED2025_03_31,
    CSS_L842_4_ED2026_04_01,
    CSS_L842_4_ED2026_06_27)
rule RessourcesFoyerTotalRetenu(d: Demandeur, mois: Date, r: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "total des ressources du mois déjà retenu, forfait logement inclus, pris tel quel (L. 842-3 2°, L. 842-4)";
    label en unofficial "month resources total already retained, housing forfait included, used as is (L. 842-3 2, L. 842-4)";
    when revenus_mensuels_retenus(d, mois, r);
    then ressources_foyer_mois(d, mois, r);
}

