    CSS_R844_3_ED2025_03_31,
    CSS_R844_3_ED2026_04_01,
    CSS_R844_3_ED2026_06_27)
rule LogementNature(d: Demandeur, mois: Date, f: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "logement occupé par son propriétaire sans aide personnelle ou à titre gratuit : avantage en nature évalué au forfait (R. 844-3)";
    label en unofficial "owner-occupied housing without personal aid, or free housing: benefit in kind valued at the forfait (R. 844-3)";
    when situation_logement_retenue(d, mois, NATURE) and forfait_logement_du_mois(d, mois, f);
    then logement_ressource_mois(d, mois, f);
}

