    CSS_R847_1_1_ED2024_07_01,
    CSS_R847_1_1_ED2025_01_01,
    CSS_R847_1_1_ED2025_02_28,
    CSS_R847_1_1_ED2025_03_31,
    CSS_R847_1_1_ED2026_04_01,
    CSS_R847_1_1_ED2026_06_27)
rule RecouvrementRefuteAvantReception(d: Demandeur, dd: Date, rec: Date) strict {
    effective [@2021-03-25, infinity);
    label fr official "demande avant réception: pas de recouvrement II 2° (R. 847-1-1 II 2°)";
    label en unofficial "pre-receipt request: no II-2° recovery (R. 847-1-1 II 2°)";
    when demande_rectification(d, dd) and reception_notification(d, rec)
        and notification_moyen_date_certaine(d)
        and dd < rec;
    then not recouvrement_apres_demande(d);
}

@source(
    CSS_R847_1_1_ED2021_03_25,
    CSS_R847_1_1_ED2021_06_01,
    CSS_R847_1_1_ED2022_03_21,
    CSS_R847_1_1_ED2023_12_31,
    CSS_R847_1_1_ED2024_01_01,
    CSS_R847_1_1_ED2024_07_01,
    CSS_R847_1_1_ED2025_01_01,
    CSS_R847_1_1_ED2025_02_28,
    CSS_R847_1_1_ED2025_03_31,
    CSS_R847_1_1_ED2026_04_01,
    CSS_R847_1_1_ED2026_06_27)
rule RecouvrementRefuteHorsDelai(d: Demandeur, dd: Date, rec: Date) strict {
    effective [@2021-03-25, infinity);
    label fr official "demande après vingt jours: pas de recouvrement II 2° (R. 847-1-1 II 2°)";
    label en unofficial "post-twenty-day request: no II-2° recovery (R. 847-1-1 II 2°)";
    when demande_rectification(d, dd) and reception_notification(d, rec)
        and notification_moyen_date_certaine(d)
        and dd > add_calendar_period(rec, 20 calendar_day);
    then not recouvrement_apres_demande(d);
}

@source(
    CSS_R847_1_1_ED2021_03_25,
    CSS_R847_1_1_ED2021_06_01,
    CSS_R847_1_1_ED2022_03_21,
    CSS_R847_1_1_ED2023_12_31,
    CSS_R847_1_1_ED2024_01_01,
    CSS_R847_1_1_ED2024_07_01,
    CSS_R847_1_1_ED2025_01_01,
    CSS_R847_1_1_ED2025_02_28,
    CSS_R847_1_1_ED2025_03_31,
    CSS_R847_1_1_ED2026_04_01,
    CSS_R847_1_1_ED2026_06_27)
rule RecouvrementRefuteAvantEcheance(d: Demandeur, dd: Date, rec: Date, now: Date) strict {
    effective [@2021-03-25, infinity);
    label fr official "observation avant deux mois après le mois: pas de recouvrement II 2° (R. 847-1-1 II 2°)";
    label en unofficial "observation before two months after the month: no II-2° recovery (R. 847-1-1 II 2°)";
    when demande_rectification(d, dd) and reception_notification(d, rec)
        and notification_moyen_date_certaine(d)
        and dd >= rec and dd <= add_calendar_period(rec, 20 calendar_day)
        and date_observation_recours(d, now)
        and now < add_calendar_period(add_calendar_period(dd, 1 calendar_month), 2 calendar_month);
    then not recouvrement_apres_demande(d);
}

pub relation demande_rectification_orale(d: Demandeur) kind empirical {
    key(d);
    label fr official "demande de rectification formulée par oral (R. 847-1-1 IV 2°; fait retenu)";
    label en unofficial "oral rectification request (R. 847-1-1 IV 2°; retained fact)";
}

pub relation demande_rectification_ecrite(d: Demandeur) kind empirical {
    key(d);
    label fr official "demande de rectification formulée par écrit (R. 847-1-1 IV 1°; fait retenu)";
    label en unofficial "written rectification request (R. 847-1-1 IV 1°; retained fact)";
}

pub relation demande_documents_rectification(d: Demandeur, date: Date) kind empirical {
    key(d);
    label fr official "SUPERSEDED (PA-M2): délai de production court depuis la demande orale elle-même; retrait demandé à root (R. 847-1-1 IV 2°)";
    label en unofficial "SUPERSEDED (PA-M2): production delay runs from the oral request itself; removal requested to root (R. 847-1-1 IV 2°)";
}

pub relation documents_rectification_produits(d: Demandeur, date: Date) kind empirical {
    key(d, date);
    label fr official "documents rappelant la demande orale et la justifiant, produits par le bénéficiaire (R. 847-1-1 IV 2°; fait retenu)";
    label en unofficial "documents recalling and evidencing the oral request, produced by the beneficiary (R. 847-1-1 IV 2°; retained fact)";
}

pub relation documents_rectification_transmis(d: Demandeur) kind institutional {
    key(d);
    label fr official "pièces de la demande orale produites par le bénéficiaire (R. 847-1-1 IV 2°)";
    label en unofficial "oral-request documents produced by the beneficiary (R. 847-1-1 IV 2°)";
}

pub relation pieces_orales_produites(d: Demandeur) kind institutional {
    key(d);
    label fr official "pièces de la demande orale tardive produites dans les vingt jours (R. 847-1-1 IV 2°)";
    label en unofficial "late oral-request documents produced within twenty days (R. 847-1-1 IV 2°)";
}

pub relation rejet_demande_orale(d: Demandeur) kind institutional {
    key(d);
    label fr official "rejet de la demande orale tardive non documentée dans les vingt jours (R. 847-1-1 IV 2°)";
    label en unofficial "rejection of the late oral request undocumented within twenty days (R. 847-1-1 IV 2°)";
}

pub relation examen_demande_possible(d: Demandeur) kind institutional {
    key(d);
    label fr official "demande orale tardive documentée à temps, examinée comme recours préalable (R. 847-1-1 IV 2°)";
    label en unofficial "late oral request timely documented, examined as a prior appeal (R. 847-1-1 IV 2°)";
}

@source(
    CSS_R847_1_1_ED2021_03_25,
    CSS_R847_1_1_ED2021_06_01,
    CSS_R847_1_1_ED2022_03_21,
    CSS_R847_1_1_ED2023_12_31,
    CSS_R847_1_1_ED2024_01_01,
    CSS_R847_1_1_ED2024_07_01,
    CSS_R847_1_1_ED2025_01_01,
    CSS_R847_1_1_ED2025_02_28,
    CSS_R847_1_1_ED2025_03_31,
    CSS_R847_1_1_ED2026_04_01,
    CSS_R847_1_1_ED2026_06_27)
rule DevoirTransmettrePieces(d: Demandeur, o: Organisme, dd: Date, rec: Date) strict {
    effective [@2021-03-25, infinity);
    label fr official "D8: le bénéficiaire produit les pièces de sa demande orale tardive dans vingt jours (R. 847-1-1 IV 2°)";
    label en unofficial "D8: the beneficiary produces the late oral-request documents within twenty days (R. 847-1-1 IV 2°)";
    when demande_rectification_orale(d) and demande_rectification(d, dd)
        and reception_notification(d, rec)
        and notification_moyen_date_certaine(d)
        and dd > add_calendar_period(rec, 20 calendar_day)
        and delai_recours_cra_en_cours(d)
        and not_known(delai_recours_cra_expire(d))
        and organisme_serviteur(o, d);
    then duty TransmettrePieces {
        bearer d;
        beneficiary o;
        maintain pieces_orales_produites(d) during [@2021-03-25, infinity);
    };
}

@source(
    CSS_R847_1_1_ED2021_03_25,
    CSS_R847_1_1_ED2021_06_01,
    CSS_R847_1_1_ED2022_03_21,
    CSS_R847_1_1_ED2023_12_31,
    CSS_R847_1_1_ED2024_01_01,
    CSS_R847_1_1_ED2024_07_01,
    CSS_R847_1_1_ED2025_01_01,
    CSS_R847_1_1_ED2025_02_28,
    CSS_R847_1_1_ED2025_03_31,
    CSS_R847_1_1_ED2026_04_01,
    CSS_R847_1_1_ED2026_06_27)
rule PiecesTransmisesSiProduites(d: Demandeur, prod: Date) strict {
    effective [@2021-03-25, infinity);
    label fr official "pièces produites valent pièces transmises (R. 847-1-1 IV 2°)";
    label en unofficial "produced documents count as transmitted documents (R. 847-1-1 IV 2°)";
    when documents_rectification_produits(d, prod);
    then documents_rectification_transmis(d);
}

@source(
    CSS_R847_1_1_ED2021_03_25,
    CSS_R847_1_1_ED2021_06_01,
    CSS_R847_1_1_ED2022_03_21,
    CSS_R847_1_1_ED2023_12_31,
    CSS_R847_1_1_ED2024_01_01,
    CSS_R847_1_1_ED2024_07_01,
    CSS_R847_1_1_ED2025_01_01,
    CSS_R847_1_1_ED2025_02_28,
    CSS_R847_1_1_ED2025_03_31,
    CSS_R847_1_1_ED2026_04_01,
    CSS_R847_1_1_ED2026_06_27)
rule PiecesOralesEnDelai(d: Demandeur, dd: Date, prod: Date) strict {
    effective [@2021-03-25, infinity);
    label fr official "pièces produites dans les vingt jours de la demande orale (R. 847-1-1 IV 2°)";
    label en unofficial "documents produced within twenty days of the oral request (R. 847-1-1 IV 2°)";
    when demande_rectification_orale(d) and demande_rectification(d, dd)
        and documents_rectification_produits(d, prod)
        and prod >= dd
        and prod <= add_calendar_period(dd, 20 calendar_day);
    then pieces_orales_produites(d);
}

@source(
    CSS_R847_1_1_ED2021_03_25,
    CSS_R847_1_1_ED2021_06_01,
    CSS_R847_1_1_ED2022_03_21,
    CSS_R847_1_1_ED2023_12_31,
    CSS_R847_1_1_ED2024_01_01,
    CSS_R847_1_1_ED2024_07_01,
    CSS_R847_1_1_ED2025_01_01,
    CSS_R847_1_1_ED2025_02_28,
    CSS_R847_1_1_ED2025_03_31,
    CSS_R847_1_1_ED2026_04_01,
    CSS_R847_1_1_ED2026_06_27)
rule ExamenApresPieces(d: Demandeur, dd: Date, rec: Date) strict {
    effective [@2021-03-25, infinity);
    label fr official "demande orale tardive documentée à temps: examen comme recours préalable (R. 847-1-1 IV 2°)";
    label en unofficial "timely documented late oral request: examination as a prior appeal (R. 847-1-1 IV 2°)";
    when demande_rectification_orale(d) and demande_rectification(d, dd)
        and reception_notification(d, rec)
        and notification_moyen_date_certaine(d)
        and dd > add_calendar_period(rec, 20 calendar_day)
        and delai_recours_cra_en_cours(d)
        and not_known(delai_recours_cra_expire(d))
        and pieces_orales_produites(d)
        and not_known(rejet_demande_orale(d));
    then examen_demande_possible(d);
}

@source(
    CSS_R847_1_1_ED2021_03_25,
    CSS_R847_1_1_ED2021_06_01,
    CSS_R847_1_1_ED2022_03_21,
    CSS_R847_1_1_ED2023_12_31,
    CSS_R847_1_1_ED2024_01_01,
    CSS_R847_1_1_ED2024_07_01,
    CSS_R847_1_1_ED2025_01_01,
    CSS_R847_1_1_ED2025_02_28,
    CSS_R847_1_1_ED2025_03_31,
    CSS_R847_1_1_ED2026_04_01,
    CSS_R847_1_1_ED2026_06_27)
rule RejetDefautProductionOrale(d: Demandeur, dd: Date, rec: Date, now: Date) strict {
    effective [@2021-03-25, infinity);
    label fr official "demande orale tardive non documentée dans les vingt jours: rejet (R. 847-1-1 IV 2°)";
    label en unofficial "late oral request undocumented within twenty days: rejection (R. 847-1-1 IV 2°)";
    when demande_rectification_orale(d) and demande_rectification(d, dd)
        and reception_notification(d, rec)
        and notification_moyen_date_certaine(d)
        and dd > add_calendar_period(rec, 20 calendar_day)
        and delai_recours_cra_en_cours(d)
        and not_known(delai_recours_cra_expire(d))
        and date_observation_recours(d, now)
        and now >= add_calendar_period(dd, 20 calendar_day)
        and pieces_orales_non_produites(d)
        and not_known(pieces_orales_produites(d));
    then rejet_demande_orale(d);
}

// PA-FE10-01: explicit source-grounded refutations of the IV 2°
// same-request oral outcomes. «Le défaut de production de ces
// documents dans le délai imparti entraîne le rejet de la demande»
// refutes examination of that same request; «Si le bénéficiaire
// produit ces documents dans le délai imparti, sa demande est
// réputée être exercée dans les conditions du recours préalable»
// refutes its rejection. Scoped to the same oral request in the
// live CRA route: no claim about unrelated later-review routes.

@source(
    CSS_R847_1_1_ED2021_03_25,
    CSS_R847_1_1_ED2021_06_01,
    CSS_R847_1_1_ED2022_03_21,
    CSS_R847_1_1_ED2023_12_31,
    CSS_R847_1_1_ED2024_01_01,
    CSS_R847_1_1_ED2024_07_01,
    CSS_R847_1_1_ED2025_01_01,
    CSS_R847_1_1_ED2025_02_28,
    CSS_R847_1_1_ED2025_03_31,
    CSS_R847_1_1_ED2026_04_01,
    CSS_R847_1_1_ED2026_06_27)
rule ExamenRefuteParRejetOral(d: Demandeur, dd: Date, rec: Date) strict {
    effective [@2021-03-25, infinity);
    label fr official "demande orale rejetée pour défaut de pièces: pas d'examen (R. 847-1-1 IV 2°)";
    label en unofficial "oral request rejected for missing documents: no examination (R. 847-1-1 IV 2°)";
    when demande_rectification_orale(d) and demande_rectification(d, dd)
        and reception_notification(d, rec)
        and notification_moyen_date_certaine(d)
        and dd > add_calendar_period(rec, 20 calendar_day)
        and delai_recours_cra_en_cours(d)
        and not_known(delai_recours_cra_expire(d))
        and rejet_demande_orale(d);
    then not examen_demande_possible(d);
}

@source(
    CSS_R847_1_1_ED2021_03_25,
    CSS_R847_1_1_ED2021_06_01,
    CSS_R847_1_1_ED2022_03_21,
    CSS_R847_1_1_ED2023_12_31,
    CSS_R847_1_1_ED2024_01_01,
    CSS_R847_1_1_ED2024_07_01,
    CSS_R847_1_1_ED2025_01_01,
    CSS_R847_1_1_ED2025_02_28,
    CSS_R847_1_1_ED2025_03_31,
    CSS_R847_1_1_ED2026_04_01,
    CSS_R847_1_1_ED2026_06_27)
rule RejetOralRefuteParProduction(d: Demandeur, dd: Date, rec: Date) strict {
    effective [@2021-03-25, infinity);
    label fr official "pièces produites à temps: pas de rejet de la demande orale (R. 847-1-1 IV 2°)";
    label en unofficial "timely produced documents: no oral-request rejection (R. 847-1-1 IV 2°)";
    when demande_rectification_orale(d) and demande_rectification(d, dd)
        and reception_notification(d, rec)
        and notification_moyen_date_certaine(d)
        and dd > add_calendar_period(rec, 20 calendar_day)
        and delai_recours_cra_en_cours(d)
        and not_known(delai_recours_cra_expire(d))
        and pieces_orales_produites(d);
    then not rejet_demande_orale(d);
}

pub relation delai_recours_cra_expire(d: Demandeur) kind empirical {
    key(d);
    label fr official "délai de recours préalable R. 142-1 expiré (R. 847-1-1 III/R. 847-2; fait retenu, hors périmètre)";
    label en unofficial "R. 142-1 prior-appeal deadline expired (R. 847-1-1 III/R. 847-2; retained fact, out of scope)";
}

// PA-R4-01/08: affirmative open-window and no-event statuses. A missing
// expiry/event fact never proves the window open or the event absent;
// each head below requires its positive premise (the expiry guards are
// kept so a present contrary still yields FALSE).

pub relation delai_recours_cra_en_cours(d: Demandeur) kind empirical {
    key(d);
    label fr official "délai de saisine CRA R. 142-1 non expiré (R. 847-1-1 IV/R. 847-2; fait retenu, hors périmètre)";
    label en unofficial "R. 142-1 CRA filing deadline not expired (R. 847-1-1 IV/R. 847-2; retained fact, out of scope)";
}

pub relation delai_r421_1_en_cours(d: Demandeur) kind empirical {
    key(d);
    label fr official "délai R. 421-1 CJA non expiré (R. 847-2; fait retenu, hors périmètre)";
    label en unofficial "R. 421-1 CJA deadline not expired (R. 847-2; retained fact, out of scope)";
}

pub relation absence_decision_rectification(d: Demandeur) kind empirical {
    key(d);
    label fr official "dossier complet: aucune décision sur la rectification à la date d'observation (R. 847-1-1 II; fait retenu)";
    label en unofficial "complete file: no decision on rectification at the observation date (R. 847-1-1 II; retained fact)";
}

pub relation pieces_orales_non_produites(d: Demandeur) kind empirical {
    key(d);
    label fr official "défaut constaté de production des pièces de la demande orale dans le délai (R. 847-1-1 IV 2°; fait retenu)";
    label en unofficial "recorded failure to produce the oral-request documents in time (R. 847-1-1 IV 2°; retained fact)";
}

pub relation absence_decision_cra(d: Demandeur) kind empirical {
    key(d);
    label fr official "dossier complet: aucune décision de la CRA au délai R. 142-6 (R. 847-2; fait retenu)";
    label en unofficial "complete file: no CRA decision by the R. 142-6 deadline (R. 847-2; retained fact)";
}

pub relation demande_requalifiee_recours(d: Demandeur) kind institutional {
    key(d);
    label fr official "demande tardive requalifiée en recours préalable (R. 847-1-1 III)";
    label en unofficial "late request requalified as a prior appeal (R. 847-1-1 III)";
}

pub relation demande_irrecevable(d: Demandeur) kind institutional {
    key(d);
    label fr official "demande irrecevable après le délai CRA (R. 847-1-1 III)";
    label en unofficial "request inadmissible after the CRA deadline (R. 847-1-1 III)";
}

@source(
    CSS_R847_1_1_ED2021_03_25,
    CSS_R847_1_1_ED2021_06_01,
    CSS_R847_1_1_ED2022_03_21,
    CSS_R847_1_1_ED2023_12_31,
    CSS_R847_1_1_ED2024_01_01,
    CSS_R847_1_1_ED2024_07_01,
    CSS_R847_1_1_ED2025_01_01,
    CSS_R847_1_1_ED2025_02_28,
    CSS_R847_1_1_ED2025_03_31,
    CSS_R847_1_1_ED2026_04_01,
    CSS_R847_1_1_ED2026_06_27)
rule DemandeEcriteTardiveRequalifiee(d: Demandeur, rec: Date, dd: Date) strict {
    effective [@2021-03-25, infinity);
    label fr official "demande écrite tardive réputée recours préalable (R. 847-1-1 IV 1°)";
    label en unofficial "late written request deemed a prior appeal (R. 847-1-1 IV 1°)";
    when demande_rectification(d, dd) and demande_rectification_ecrite(d)
        and reception_notification(d, rec)
        and notification_moyen_date_certaine(d)
        and dd > add_calendar_period(rec, 20 calendar_day)
        and delai_recours_cra_en_cours(d)
        and not_known(delai_recours_cra_expire(d));
    then demande_requalifiee_recours(d);
}

@source(
    CSS_R847_1_1_ED2021_03_25,
    CSS_R847_1_1_ED2021_06_01,
    CSS_R847_1_1_ED2022_03_21,
    CSS_R847_1_1_ED2023_12_31,
    CSS_R847_1_1_ED2024_01_01,
    CSS_R847_1_1_ED2024_07_01,
    CSS_R847_1_1_ED2025_01_01,
    CSS_R847_1_1_ED2025_02_28,
    CSS_R847_1_1_ED2025_03_31,
    CSS_R847_1_1_ED2026_04_01,
    CSS_R847_1_1_ED2026_06_27)
rule DemandeOraleTardiveRequalifiee(d: Demandeur, rec: Date, dd: Date) strict {
    effective [@2021-03-25, infinity);
    label fr official "demande orale tardive documentée à temps réputée recours préalable (R. 847-1-1 IV 2°)";
    label en unofficial "timely documented late oral request deemed a prior appeal (R. 847-1-1 IV 2°)";
    when demande_rectification(d, dd) and demande_rectification_orale(d)
        and reception_notification(d, rec)
        and notification_moyen_date_certaine(d)
        and dd > add_calendar_period(rec, 20 calendar_day)
        and delai_recours_cra_en_cours(d)
        and not_known(delai_recours_cra_expire(d))
        and pieces_orales_produites(d);
    then demande_requalifiee_recours(d);
}

@source(
    CSS_R847_1_1_ED2021_03_25,
    CSS_R847_1_1_ED2021_06_01,
    CSS_R847_1_1_ED2022_03_21,
    CSS_R847_1_1_ED2023_12_31,
    CSS_R847_1_1_ED2024_01_01,
    CSS_R847_1_1_ED2024_07_01,
    CSS_R847_1_1_ED2025_01_01,
    CSS_R847_1_1_ED2025_02_28,
    CSS_R847_1_1_ED2025_03_31,
    CSS_R847_1_1_ED2026_04_01,
    CSS_R847_1_1_ED2026_06_27)
rule DemandeIrrecevable(d: Demandeur, dd: Date) strict {
    effective [@2021-03-25, infinity);
    label fr official "après le délai de saisine CRA: irrecevable (R. 847-1-1 IV)";
    label en unofficial "after the CRA filing deadline: inadmissible (R. 847-1-1 IV)";
    when demande_rectification(d, dd) and delai_recours_cra_expire(d);
    then demande_irrecevable(d);
}

pub relation decision_refus(d: Demandeur) kind empirical {
    key(d);
    label fr official "refus total ou partiel de la demande (R. 847-2; fait retenu)";
    label en unofficial "total or partial refusal (R. 847-2; retained fact)";
}

pub relation recours_cra_forme(d: Demandeur, date: Date) kind empirical {
    key(d);
    label fr official "recours préalable formé devant la CRA (R. 847-2; fait retenu)";
    label en unofficial "prior appeal filed with the CRA (R. 847-2; retained fact)";
}

pub relation recours_cra_association(d: Demandeur, date: Date) kind empirical {
    key(d);
    label fr official "recours préalable par une association mandataire (R. 847-2; fait retenu)";
    label en unofficial "prior appeal via a mandated association (R. 847-2; retained fact)";
}

pub relation association_anciennete_5_ans(d: Demandeur) kind empirical {
    key(d);
    label fr official "association déclarée depuis au moins cinq ans (R. 847-2; fait retenu)";
    label en unofficial "association registered for five years (R. 847-2; retained fact)";
}

pub relation mandat_association_ecrit(d: Demandeur) kind empirical {
    key(d);
    label fr official "mandat écrit à l'association (R. 847-2; fait retenu)";
    label en unofficial "written mandate to the association (R. 847-2; retained fact)";
}

pub relation association_regulierement_constituee(d: Demandeur) kind empirical {
    key(d);
    label fr official "association régulièrement constituée (R. 847-2; fait retenu)";
    label en unofficial "duly constituted association (R. 847-2; retained fact)";
}

pub relation association_objet_insertion_pro(d: Demandeur) kind empirical {
    key(d);
    label fr official "association constituée pour œuvrer dans l'insertion professionnelle (R. 847-2; fait retenu)";
    label en unofficial "association formed for professional-integration work (R. 847-2; retained fact)";
}

pub relation decision_cra(d: Demandeur) kind empirical {
    key(d);
    label fr official "décision de la CRA (R. 847-2; fait retenu)";
    label en unofficial "CRA decision (R. 847-2; retained fact)";
}

pub relation decision_cra_rejet(d: Demandeur) kind empirical {
    key(d);
    label fr official "rejet explicite de la CRA (R. 847-2; fait retenu)";
    label en unofficial "explicit CRA rejection (R. 847-2; retained fact)";
}

pub relation delai_r142_6_expire(d: Demandeur) kind empirical {
    key(d);
    label fr official "délai R. 142-6 expiré sans décision (R. 847-2; fait retenu, hors périmètre)";
    label en unofficial "R. 142-6 deadline expired (R. 847-2; retained fact, out of scope)";
}

pub relation delai_r421_1_expire(d: Demandeur) kind empirical {
    key(d);
    label fr official "délai R. 421-1 CJA expiré (R. 847-2; fait retenu, hors périmètre)";
    label en unofficial "R. 421-1 CJA deadline expired (R. 847-2; retained fact, out of scope)";
}

pub relation recours_prealaire_recevable(d: Demandeur) kind institutional {
    key(d);
    label fr official "recours préalable recevable devant la CRA (R. 847-2)";
    label en unofficial "prior appeal admissible before the CRA (R. 847-2)";
}

pub relation rejet_implicite_cra(d: Demandeur) kind institutional {
    key(d);
    label fr official "rejet implicite de la CRA (R. 847-2)";
    label en unofficial "implicit CRA rejection (R. 847-2)";
}

pub relation recours_ta_ouvert(d: Demandeur) kind institutional {
    key(d);
    label fr official "recours au tribunal administratif ouvert (R. 847-2)";
    label en unofficial "administrative-court appeal open (R. 847-2)";
}

pub relation represente_etat_ta(c: Directeur, d: Demandeur) kind institutional {
    key(c, d);
    label fr official "le directeur représente l'Etat devant le TA (R. 847-2)";
    label en unofficial "the director represents the State before the court (R. 847-2)";
}

@source(
    CSS_R847_2_ED2021_01_01,
    CSS_R847_2_ED2021_03_25,
    CSS_R847_2_ED2021_06_01,
    CSS_R847_2_ED2022_03_21,
    CSS_R847_2_ED2023_12_31,
    CSS_R847_2_ED2024_01_01,
    CSS_R847_2_ED2024_07_01,
    CSS_R847_2_ED2025_01_01,
    CSS_R847_2_ED2025_02_28,
    CSS_R847_2_ED2025_03_31,
    CSS_R847_2_ED2026_04_01,
    CSS_R847_2_ED2026_06_27)
rule RecoursCRARecevable(d: Demandeur, date: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "refus contesté dans le délai R. 142-1 (R. 847-2)";
    label en unofficial "refusal challenged within the R. 142-1 deadline (R. 847-2)";
    when decision_refus(d) and recours_cra_forme(d, date)
        and delai_recours_cra_en_cours(d)
        and not_known(delai_recours_cra_expire(d));
    then recours_prealaire_recevable(d);
}

@source(
    CSS_R847_2_ED2021_01_01,
    CSS_R847_2_ED2021_03_25,
    CSS_R847_2_ED2021_06_01,
    CSS_R847_2_ED2022_03_21,
    CSS_R847_2_ED2023_12_31,
    CSS_R847_2_ED2024_01_01,
    CSS_R847_2_ED2024_07_01,
    CSS_R847_2_ED2025_01_01,
    CSS_R847_2_ED2025_02_28,
    CSS_R847_2_ED2025_03_31,
    CSS_R847_2_ED2026_04_01,
    CSS_R847_2_ED2026_06_27)
rule RecoursCRAAssociation(d: Demandeur, date: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "recours par association régulière, cinq ans, insertion pro, mandatée (R. 847-2)";
    label en unofficial "appeal via a duly constituted five-year integration mandated association (R. 847-2)";
    when decision_refus(d) and recours_cra_association(d, date)
        and association_regulierement_constituee(d)
        and association_anciennete_5_ans(d) and association_objet_insertion_pro(d)
        and mandat_association_ecrit(d)
        and delai_recours_cra_en_cours(d)
        and not_known(delai_recours_cra_expire(d));
    then recours_prealaire_recevable(d);
}

// D-42: an expired R. 142-1 filing deadline is the affirmative
// contrary of admissibility on either route (R. 847-2); the guard
// not_known(delai_recours_cra_expire) alone only leaves NEITHER.
@source(
    CSS_R847_2_ED2021_01_01,
    CSS_R847_2_ED2021_03_25,
    CSS_R847_2_ED2021_06_01,
    CSS_R847_2_ED2022_03_21,
    CSS_R847_2_ED2023_12_31,
    CSS_R847_2_ED2024_01_01,
    CSS_R847_2_ED2024_07_01,
    CSS_R847_2_ED2025_01_01,
    CSS_R847_2_ED2025_02_28,
    CSS_R847_2_ED2025_03_31,
    CSS_R847_2_ED2026_04_01,
    CSS_R847_2_ED2026_06_27)
rule RecoursCRAIrrecevableDelai(d: Demandeur, date: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "recours formé après expiration du délai R. 142-1: irrecevable (R. 847-2)";
    label en unofficial "appeal filed after the R. 142-1 deadline expired: inadmissible (R. 847-2)";
    when decision_refus(d) and recours_cra_forme(d, date)
        and delai_recours_cra_expire(d);
    then not recours_prealaire_recevable(d);
}

@source(
    CSS_R847_2_ED2021_01_01,
    CSS_R847_2_ED2021_03_25,
    CSS_R847_2_ED2021_06_01,
    CSS_R847_2_ED2022_03_21,
    CSS_R847_2_ED2023_12_31,
    CSS_R847_2_ED2024_01_01,
    CSS_R847_2_ED2024_07_01,
    CSS_R847_2_ED2025_01_01,
    CSS_R847_2_ED2025_02_28,
    CSS_R847_2_ED2025_03_31,
    CSS_R847_2_ED2026_04_01,
    CSS_R847_2_ED2026_06_27)
rule RecoursCRAAssociationIrrecevableDelai(d: Demandeur, date: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "recours associatif après expiration du délai R. 142-1: irrecevable (R. 847-2)";
    label en unofficial "association appeal after the R. 142-1 deadline expired: inadmissible (R. 847-2)";
    when decision_refus(d) and recours_cra_association(d, date)
        and delai_recours_cra_expire(d);
    then not recours_prealaire_recevable(d);
}

@source(
    CSS_R847_2_ED2021_01_01,
    CSS_R847_2_ED2021_03_25,
    CSS_R847_2_ED2021_06_01,
    CSS_R847_2_ED2022_03_21,
    CSS_R847_2_ED2023_12_31,
    CSS_R847_2_ED2024_01_01,
    CSS_R847_2_ED2024_07_01,
    CSS_R847_2_ED2025_01_01,
    CSS_R847_2_ED2025_02_28,
    CSS_R847_2_ED2025_03_31,
    CSS_R847_2_ED2026_04_01,
    CSS_R847_2_ED2026_06_27)
rule RejetImpliciteCRA(d: Demandeur) strict {
    effective [@2021-01-01, infinity);
    label fr official "sans décision au délai R. 142-6: rejet implicite (R. 847-2)";
    label en unofficial "no decision by the R. 142-6 deadline: implicit rejection (R. 847-2)";
    when recours_prealaire_recevable(d) and absence_decision_cra(d)
        and not_known(decision_cra(d))
        and delai_r142_6_expire(d);
    then rejet_implicite_cra(d);
}

@source(
    CSS_R847_2_ED2021_01_01,
    CSS_R847_2_ED2021_03_25,
    CSS_R847_2_ED2021_06_01,
    CSS_R847_2_ED2022_03_21,
    CSS_R847_2_ED2023_12_31,
    CSS_R847_2_ED2024_01_01,
    CSS_R847_2_ED2024_07_01,
    CSS_R847_2_ED2025_01_01,
    CSS_R847_2_ED2025_02_28,
    CSS_R847_2_ED2025_03_31,
    CSS_R847_2_ED2026_04_01,
    CSS_R847_2_ED2026_06_27)
rule RecoursTAImplicite(d: Demandeur) strict {
    effective [@2021-01-01, infinity);
    label fr official "rejet implicite: TA dans le délai R. 421-1 (R. 847-2)";
    label en unofficial "implicit rejection: court within R. 421-1 (R. 847-2)";
    when rejet_implicite_cra(d) and delai_r421_1_en_cours(d)
        and not_known(delai_r421_1_expire(d));
    then recours_ta_ouvert(d);
}

@source(
    CSS_R847_2_ED2021_01_01,
    CSS_R847_2_ED2021_03_25,
    CSS_R847_2_ED2021_06_01,
    CSS_R847_2_ED2022_03_21,
    CSS_R847_2_ED2023_12_31,
    CSS_R847_2_ED2024_01_01,
    CSS_R847_2_ED2024_07_01,
    CSS_R847_2_ED2025_01_01,
    CSS_R847_2_ED2025_02_28,
    CSS_R847_2_ED2025_03_31,
    CSS_R847_2_ED2026_04_01,
    CSS_R847_2_ED2026_06_27)
rule RecoursTAExplicite(d: Demandeur) strict {
    effective [@2021-01-01, infinity);
    label fr official "rejet explicite: TA dans le délai R. 421-1 (R. 847-2)";
    label en unofficial "explicit rejection: court within R. 421-1 (R. 847-2)";
    when decision_cra_rejet(d) and delai_r421_1_en_cours(d)
        and not_known(delai_r421_1_expire(d));
    then recours_ta_ouvert(d);
}

@source(
    CSS_R847_2_ED2021_01_01,
    CSS_R847_2_ED2021_03_25,
    CSS_R847_2_ED2021_06_01,
    CSS_R847_2_ED2022_03_21,
    CSS_R847_2_ED2023_12_31,
    CSS_R847_2_ED2024_01_01,
    CSS_R847_2_ED2024_07_01,
    CSS_R847_2_ED2025_01_01,
    CSS_R847_2_ED2025_02_28,
    CSS_R847_2_ED2025_03_31,
    CSS_R847_2_ED2026_04_01,
    CSS_R847_2_ED2026_06_27)
rule RepresentationEtatTA(c: Directeur, d: Demandeur, o: Organisme) strict {
    effective [@2021-01-01, infinity);
    label fr official "le directeur représente l'Etat devant le TA (R. 847-2)";
    label en unofficial "the director represents the State before the court (R. 847-2)";
    when directeur_de(c, o) and organisme_serviteur(o, d) and recours_ta_ouvert(d);
    then represente_etat_ta(c, d);
}

pub relation decision_individuelle(d: Demandeur, date: Date) kind empirical {
    key(d, date);
    label fr official "décision individuelle prise (R. 847-3; fait retenu)";
    label en unofficial "individual decision taken (R. 847-3; retained fact)";
}

pub relation decisions_mentionnent_recours(d: Demandeur, date: Date) kind empirical {
    key(d, date);
    label fr official "décision mentionnant voies, délais et recours préalable (R. 847-3; fait retenu)";
    label en unofficial "decision mentioning appeals and prior recourse (R. 847-3; retained fact)";
}

@source(
    CSS_R847_3_ED2021_01_01,
    CSS_R847_3_ED2021_03_25,
    CSS_R847_3_ED2021_06_01,
    CSS_R847_3_ED2022_03_21,
    CSS_R847_3_ED2023_12_31,
    CSS_R847_3_ED2024_01_01,
    CSS_R847_3_ED2024_07_01,
    CSS_R847_3_ED2025_01_01,
    CSS_R847_3_ED2025_02_28,
    CSS_R847_3_ED2025_03_31,
    CSS_R847_3_ED2026_04_01,
    CSS_R847_3_ED2026_06_27)
rule DevoirMentionnerRecours(d: Demandeur, o: Organisme, date: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "D9: décisions mentionnant les recours (R. 847-3)";
    label en unofficial "D9: decisions mentioning appeals (R. 847-3)";
    when decision_individuelle(d, date) and organisme_serviteur(o, d);
    then duty MentionnerRecours {
        bearer o;
        beneficiary d;
        maintain decisions_mentionnent_recours(d, date) during [@2021-01-01, infinity);
    };
}
