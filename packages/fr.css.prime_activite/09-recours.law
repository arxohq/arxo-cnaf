    CSS_R847_1_1_ED2025_01_01,
    CSS_R847_1_1_ED2025_02_28,
    CSS_R847_1_1_ED2025_03_31,
    CSS_R847_1_1_ED2026_04_01,
    CSS_R847_1_1_ED2026_06_27)
rule NouvelleNotificationComplete(d: Demandeur, date: Date) strict {
    effective [@2021-03-25, infinity);
    label fr official "nouvelle notification complète: envoi + 1°/2°/3° (R. 847-1-1 III)";
    label en unofficial "complete new notification: sending + 1°/2°/3° (R. 847-1-1 III)";
    when nouvelle_notification_rejet(d, date) and nouvelle_notification_motif(d, date)
        and nouvelle_notification_recouvrement(d, date)
        and nouvelle_notification_voies(d, date);
    then nouvelle_notification_complete(d, date);
}

@source(
    CSS_R847_1_1_ED2021_03_25,
    CSS_R847_1_1_ED2021_06_01,
    CSS_R847_1_1_ED2022_03_21,
    CSS_R847_1_1_ED2023_12_31,
    CSS_R847_1_1_ED2024_01_01,
    CSS_R847_1_1_ED2024_07_01,
    CSS_R847_1_1_ED2025_01_01,
    CSS_R847_1_1_ED2025_02_28,
    CSS_R847_1_1_ED2025_03_31,
    CSS_R847_1_1_ED2026_04_01,
    CSS_R847_1_1_ED2026_06_27)
rule DevoirNotifierRejetRectification(d: Demandeur, o: Organisme, c: Directeur, dd: Date, dec: Date, rec: Date) strict {
    effective [@2021-03-25, infinity);
    label fr official "D7bis: nouvelle notification complète après rejet du directeur avant un mois (R. 847-1-1 III)";
    label en unofficial "D7bis: complete new notification after the director's rejection within a month (R. 847-1-1 III)";
    when demande_rectification(d, dd) and reception_notification(d, rec)
        and notification_moyen_date_certaine(d)
        and dd >= rec
        and dd <= add_calendar_period(rec, 20 calendar_day)
        and decision_rectification_rejet(d, dec)
        and decision_rectification_rejet_directeur(d, dec, c)
        and dec < add_calendar_period(dd, 1 calendar_month)
        and organisme_serviteur(o, d)
        and directeur_de(c, o);
    then duty NotifierRejetRectification {
        bearer o;
        beneficiary d;
        maintain nouvelle_notification_complete(d, dec) during [@2021-01-01, infinity);
    };
}

@source(
    CSS_R847_1_1_ED2021_03_25,
    CSS_R847_1_1_ED2021_06_01,
    CSS_R847_1_1_ED2022_03_21,
    CSS_R847_1_1_ED2023_12_31,
    CSS_R847_1_1_ED2024_01_01,
    CSS_R847_1_1_ED2024_07_01,
    CSS_R847_1_1_ED2025_01_01,
    CSS_R847_1_1_ED2025_02_28,
    CSS_R847_1_1_ED2025_03_31,
    CSS_R847_1_1_ED2026_04_01,
    CSS_R847_1_1_ED2026_06_27)
rule RejetImpliciteRectification(d: Demandeur, dd: Date, rec: Date, now: Date) strict {
    effective [@2021-03-25, infinity);
    label fr official "sans décision à un mois sur la demande dans les vingt jours: rejet implicite (R. 847-1-1 II 1°)";
    label en unofficial "no decision within a month on the twenty-day request: implicit rejection (R. 847-1-1 II 1°)";
    when demande_rectification(d, dd) and reception_notification(d, rec)
        and notification_moyen_date_certaine(d)
        and dd >= rec and dd <= add_calendar_period(rec, 20 calendar_day)
        and absence_decision_rectification(d)
        and not_known(decision_rectification(d))
        and date_observation_recours(d, now)
        and now >= add_calendar_period(dd, 1 calendar_month);
    then rejet_implicite_rectification(d);
}

@source(
    CSS_R847_1_1_ED2021_03_25,
    CSS_R847_1_1_ED2021_06_01,
    CSS_R847_1_1_ED2022_03_21,
    CSS_R847_1_1_ED2023_12_31,
    CSS_R847_1_1_ED2024_01_01,
    CSS_R847_1_1_ED2024_07_01,
    CSS_R847_1_1_ED2025_01_01,
    CSS_R847_1_1_ED2025_02_28,
    CSS_R847_1_1_ED2025_03_31,
    CSS_R847_1_1_ED2026_04_01,
    CSS_R847_1_1_ED2026_06_27)
rule RecouvrementDeuxMois(d: Demandeur, dd: Date, rec: Date, now: Date) strict {
    effective [@2021-03-25, infinity);
    label fr official "sans décision sur la demande dans les vingt jours: recouvrement deux mois après le délai d'un mois (R. 847-1-1 II 2°)";
    label en unofficial "no decision on the twenty-day request: recovery two months after the one-month delay (R. 847-1-1 II 2°)";
    when demande_rectification(d, dd) and reception_notification(d, rec)
        and notification_moyen_date_certaine(d)
        and dd >= rec and dd <= add_calendar_period(rec, 20 calendar_day)
        and absence_decision_rectification(d)
        and not_known(decision_rectification(d))
        and date_observation_recours(d, now)
        and now >= add_calendar_period(add_calendar_period(dd, 1 calendar_month), 2 calendar_month);
    then recouvrement_apres_demande(d);
}

// PA-FE10-02: explicit source-grounded refutations of the II 1°/2°
// heads. A failed positive body leaves NEITHER; each rule below
// derives FALSE_ONLY from an affirmative contrary: a dated
// explicit decision within the month on the timely request
// (PA-FE11-01; II 1° «au terme duquel naît», III al. 2 «avant
// l'expiration du délai» — undated or post-month decisions prove
// nothing), a request outside the I.2.a twenty-day window (II
// governs only «la demande de rectification mentionnée au a du 2°
// du I»), or an observation before the II 2° maturity date («le
// délai à l'issue duquel»). Scoped to the II route only: no claim
// about independent recovery avenues.

@source(
    CSS_R847_1_1_ED2021_03_25,
    CSS_R847_1_1_ED2021_06_01,
    CSS_R847_1_1_ED2022_03_21,
    CSS_R847_1_1_ED2023_12_31,
    CSS_R847_1_1_ED2024_01_01,
    CSS_R847_1_1_ED2024_07_01,
    CSS_R847_1_1_ED2025_01_01,
    CSS_R847_1_1_ED2025_02_28,
    CSS_R847_1_1_ED2025_03_31,
    CSS_R847_1_1_ED2026_04_01,
    CSS_R847_1_1_ED2026_06_27)
rule RejetImpliciteRefuteParRejetDate(d: Demandeur, dd: Date, rec: Date, dec: Date) strict {
    effective [@2021-03-25, infinity);
    label fr official "rejet daté dans le mois sur la demande dans les vingt jours: pas de rejet implicite (R. 847-1-1 II 1°)";
    label en unofficial "dated rejection within the month on the twenty-day request: no implicit rejection (R. 847-1-1 II 1°)";
    when demande_rectification(d, dd) and reception_notification(d, rec)
        and notification_moyen_date_certaine(d)
        and dd >= rec and dd <= add_calendar_period(rec, 20 calendar_day)
        and decision_rectification_rejet(d, dec)
        and dec >= dd
        and dec < add_calendar_period(dd, 1 calendar_month);
    then not rejet_implicite_rectification(d);
}

