    label fr official "rejet daté dans le mois sur la demande dans les vingt jours: pas de recouvrement II 2° (R. 847-1-1 II 2°)";
    label en unofficial "dated rejection within the month on the twenty-day request: no II-2° recovery (R. 847-1-1 II 2°)";
    when demande_rectification(d, dd) and reception_notification(d, rec)
        and notification_moyen_date_certaine(d)
        and dd >= rec and dd <= add_calendar_period(rec, 20 calendar_day)
        and decision_rectification_rejet(d, dec)
        and dec >= dd
        and dec < add_calendar_period(dd, 1 calendar_month);
    then not recouvrement_apres_demande(d);
}

