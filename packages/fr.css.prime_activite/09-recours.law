pub relation recouvrement_d553_applicable(d: Demandeur) kind institutional {
    key(d);
    label fr official "D. 553-1/2/4/5 applicables au recouvrement de l'indu (D. 847-1)";
    label en unofficial "D. 553-1/2/4/5 applying to the undue-payment recovery (D. 847-1)";
}

@source(
    CSS_D847_1_ED2021_01_01,
    CSS_D847_1_ED2021_03_25,
    CSS_D847_1_ED2021_06_01,
    CSS_D847_1_ED2022_03_21,
    CSS_D847_1_ED2023_12_31,
    CSS_D847_1_ED2024_01_01,
    CSS_D847_1_ED2024_07_01,
    CSS_D847_1_ED2025_01_01,
    CSS_D847_1_ED2025_02_28,
    CSS_D847_1_ED2025_03_31,
    CSS_D847_1_ED2026_04_01,
    CSS_D847_1_ED2026_06_27)
rule RecouvrementD553(d: Demandeur, m: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "indu recouvrable: D. 553-1/2/4/5 applicables (D. 847-1)";
    label en unofficial "recoverable undue payment: D. 553 applies (D. 847-1)";
    when indu_recupere(d, m);
    then recouvrement_d553_applicable(d);
}

pub relation plafond_l241_3_applicable(montant: Money) kind empirical {
    key();
    label fr official "plafond L. 241-3 applicable au recouvrement (D. 847-2; fait retenu, hors périmètre)";
    label en unofficial "L. 241-3 ceiling for the recovery (D. 847-2; retained fact, out of scope)";
}

pub relation seuil_abandon_recouvrement(montant: Money) kind institutional {
    key();
    label fr official "seuil d'abandon: 0,68 % du plafond, euro supérieur (D. 847-2)";
    label en unofficial "abandonment threshold: 0.68% of the ceiling, rounded up (D. 847-2)";
}

pub relation abandon_recouvrement_prononce(o: Organisme, d: Demandeur) kind empirical {
    key(o, d);
    label fr official "abandon du recouvrement prononcé (D. 847-2; fait retenu)";
    label en unofficial "recovery abandonment pronounced (D. 847-2; retained fact)";
}

pub relation abandon_prend_effet(o: Organisme, d: Demandeur) kind institutional {
    key(o, d);
    label fr official "l'abandon du recouvrement prend effet (D. 847-2)";
    label en unofficial "the recovery abandonment takes effect (D. 847-2)";
}

@source(
    CSS_D847_2_ED2021_01_01,
    CSS_D847_2_ED2021_03_25,
    CSS_D847_2_ED2021_06_01,
    CSS_D847_2_ED2022_03_21,
    CSS_D847_2_ED2023_12_31,
    CSS_D847_2_ED2024_01_01,
    CSS_D847_2_ED2024_07_01,
    CSS_D847_2_ED2025_01_01,
    CSS_D847_2_ED2025_02_28,
    CSS_D847_2_ED2025_03_31,
    CSS_D847_2_ED2026_04_01,
    CSS_D847_2_ED2026_06_27)
rule SeuilAbandon(p: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "0,68 % du plafond L. 241-3, euro supérieur (D. 847-2)";
    label en unofficial "0.68% of the L. 241-3 ceiling, rounded up (D. 847-2)";
    when plafond_l241_3_applicable(p);
    then seuil_abandon_recouvrement(round(p * 0.0068, 0, "CEILING"));
}

@source(
    CSS_D847_2_ED2021_01_01,
    CSS_D847_2_ED2021_03_25,
    CSS_D847_2_ED2021_06_01,
    CSS_D847_2_ED2022_03_21,
    CSS_D847_2_ED2023_12_31,
    CSS_D847_2_ED2024_01_01,
    CSS_D847_2_ED2024_07_01,
    CSS_D847_2_ED2025_01_01,
    CSS_D847_2_ED2025_02_28,
    CSS_D847_2_ED2025_03_31,
    CSS_D847_2_ED2026_04_01,
    CSS_D847_2_ED2026_06_27)
rule PouvoirAbandonner(o: Organisme, d: Demandeur, m: Money, s: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "P3: abandon sous le seuil (D. 847-2)";
    label en unofficial "P3: abandonment under the threshold (D. 847-2)";
    when organisme_serviteur(o, d) and indu_recupere(d, m)
        and seuil_abandon_recouvrement(s) and m < s;
    then power AbandonRecouvrement {
        holder o;
        exercise abandon_recouvrement_prononce(o, d);
        // D-42: the comparison m < s stays in the creating rule body;
        // valid_when executes only a literal conjunction (§127, E-0190),
        // a comparison there left the effect unmaterialised.
        valid_when (organisme_serviteur(o, d) and indu_recupere(d, m)
            and seuil_abandon_recouvrement(s));
        effect abandon_prend_effet(o, d);
        window [@2021-01-01, infinity);
    };
}

pub relation saisie_prime_mise_en_oeuvre(d: Demandeur) kind empirical {
    key(d);
    label fr official "mise en œuvre de la saisie de la prime prévue à L. 845-5 (D. 847-3; fait retenu)";
    label en unofficial "seizure of the bonus under L. 845-5 being implemented (D. 847-3; retained fact)";
}

pub relation prelevements_saisie_mensuels(d: Demandeur) kind institutional {
    key(d);
    label fr official "prélèvements mensuels en cas de saisie, D. 553-1/2 (D. 847-3)";
    label en unofficial "monthly seizure deductions under D. 553-1/2 (D. 847-3)";
}

@source(
    CSS_D847_3_ED2021_06_01,
    CSS_D847_3_ED2022_03_21,
    CSS_D847_3_ED2023_12_31,
    CSS_D847_3_ED2024_01_01,
    CSS_D847_3_ED2024_07_01,
    CSS_D847_3_ED2025_01_01,
    CSS_D847_3_ED2025_02_28,
    CSS_D847_3_ED2025_03_31,
    CSS_D847_3_ED2026_04_01,
    CSS_D847_3_ED2026_06_27)
rule PrelevementsSaisie(d: Demandeur, m: Money) strict {
    effective [@2021-06-01, infinity);
    label fr official "saisie mise en œuvre: prélèvements mensuels D. 553-1/2 (D. 847-3)";
    label en unofficial "seizure implemented: monthly D. 553-1/2 deductions (D. 847-3)";
    when indu_recupere(d, m) and saisie_prime_mise_en_oeuvre(d);
    then prelevements_saisie_mensuels(d);
}

pub relation mention_verification_possible(d: Demandeur) kind empirical {
    key(d);
    label fr official "téléprocédure/formulaire mentionnant les vérifications (R. 847-1; fait retenu)";
    label en unofficial "channel mentioning verifications (R. 847-1; retained fact)";
}

@source(
    CSS_R847_1_ED2021_01_01,
    CSS_R847_1_ED2021_03_25,
    CSS_R847_1_ED2021_06_01,
    CSS_R847_1_ED2022_03_21,
    CSS_R847_1_ED2023_12_31,
    CSS_R847_1_ED2024_01_01,
    CSS_R847_1_ED2024_07_01,
    CSS_R847_1_ED2025_01_01,
    CSS_R847_1_ED2025_02_28,
    CSS_R847_1_ED2025_03_31,
    CSS_R847_1_ED2026_04_01,
    CSS_R847_1_ED2026_06_27)
rule DevoirMentionnerVerification(d: Demandeur, o: Organisme, date: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "D6: mention des vérifications sur la demande (R. 847-1)";
    label en unofficial "D6: verification mention on the request (R. 847-1)";
    when demande_valide(d, date) and organisme_serviteur(o, d);
    then duty MentionnerVerification {
        bearer o;
        beneficiary d;
        maintain mention_verification_possible(d) during [@2021-01-01, infinity);
    };
}

