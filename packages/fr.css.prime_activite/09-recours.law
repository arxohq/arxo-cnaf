rule RejetImpliciteRefuteAvantReception(d: Demandeur, dd: Date, rec: Date) strict {
    effective [@2021-03-25, infinity);
    label fr official "demande avant réception: pas de rejet implicite II (R. 847-1-1 II 1°)";
    label en unofficial "pre-receipt request: no II implicit rejection (R. 847-1-1 II 1°)";
    when demande_rectification(d, dd) and reception_notification(d, rec)
        and notification_moyen_date_certaine(d)
        and dd < rec;
    then not rejet_implicite_rectification(d);
}

