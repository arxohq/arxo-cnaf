    label fr official "nouvelle notification indiquant les voies et délais de recours (R. 847-1-1 III 3°; fait retenu)";
    label en unofficial "new notification stating appeal routes and deadlines (R. 847-1-1 III 3°; retained fact)";
}

pub relation nouvelle_notification_complete(d: Demandeur, date: Date) kind institutional {
    key(d, date);
    label fr official "nouvelle notification complète: envoi + 1°/2°/3° (R. 847-1-1 III)";
    label en unofficial "complete new notification: sending + 1°/2°/3° (R. 847-1-1 III)";
}

pub relation date_observation_recours(d: Demandeur, date: Date) kind empirical {
    key(d);
    label fr official "date d'observation des délais de recours (R. 847-1-1/2; fait retenu)";
    label en unofficial "appeal-deadline observation date (R. 847-1-1/2; retained fact)";
}

pub relation interruption_delai_cra(d: Demandeur) kind institutional {
    key(d);
    label fr official "délai de recours CRA interrompu par la rectification (R. 847-1-1 III)";
    label en unofficial "CRA appeal deadline interrupted by rectification (R. 847-1-1 III)";
}

pub relation rejet_implicite_rectification(d: Demandeur) kind institutional {
    key(d);
    label fr official "rejet implicite à un mois sans décision (R. 847-1-1 II)";
    label en unofficial "implicit rejection after one month (R. 847-1-1 II)";
}

pub relation recouvrement_apres_demande(d: Demandeur) kind institutional {
    key(d);
    label fr official "recouvrement opérable deux mois après le délai de rejet implicite d'un mois (R. 847-1-1 II 2°)";
    label en unofficial "recovery available two months after the one-month implicit-rejection delay (R. 847-1-1 II 2°)";
}

@source(
    CSS_R847_1_1_ED2021_03_25,
    CSS_R847_1_1_ED2021_06_01,
    CSS_R847_1_1_ED2022_03_21,
    CSS_R847_1_1_ED2023_12_31,
    CSS_R847_1_1_ED2024_01_01,
    CSS_R847_1_1_ED2024_07_01,
    CSS_R847_1_1_ED2025_01_01,
    CSS_R847_1_1_ED2025_02_28,
    CSS_R847_1_1_ED2025_03_31,
    CSS_R847_1_1_ED2026_04_01,
    CSS_R847_1_1_ED2026_06_27)
rule NotificationComplete(d: Demandeur, date: Date) strict {
    effective [@2021-03-25, infinity);
    label fr official "notification complète: envoi + 1° + 2° a)/b)/c) + moyen date certaine (R. 847-1-1 I)";
    label en unofficial "complete notification: sending + 1° + 2° a)/b)/c) + date-certain means (R. 847-1-1 I)";
    when notification_recouvrement(d, date) and notification_contenu_base(d, date)
        and notification_modalites_rectification(d, date)
        and notification_possibilite_recouvrement(d, date)
        and notification_voies_recours(d, date)
        and notification_moyen_date_certaine(d);
    then notification_recouvrement_complete(d, date);
}

@source(
    CSS_R847_1_1_ED2021_03_25,
    CSS_R847_1_1_ED2021_06_01,
    CSS_R847_1_1_ED2022_03_21,
    CSS_R847_1_1_ED2023_12_31,
    CSS_R847_1_1_ED2024_01_01,
    CSS_R847_1_1_ED2024_07_01,
    CSS_R847_1_1_ED2025_01_01,
    CSS_R847_1_1_ED2025_02_28,
    CSS_R847_1_1_ED2025_03_31,
    CSS_R847_1_1_ED2026_04_01,
    CSS_R847_1_1_ED2026_06_27)
rule DevoirNotifierIndu(d: Demandeur, o: Organisme, c: Directeur, m: Money, date: Date) strict {
    effective [@2021-03-25, infinity);
    label fr official "D7: notification préalable avec contenu, par le directeur (R. 847-1-1 I)";
    label en unofficial "D7: prior notification with content, by the director (R. 847-1-1 I)";
    when indu_recupere(d, m) and constat_indu(d, date) and organisme_serviteur(o, d)
        and directeur_de(c, o);
    then duty NotifierIndu {
        bearer c;
        beneficiary d;
        maintain notification_recouvrement_complete(d, date) during [@2021-01-01, infinity);
    };
}

@source(
    CSS_R847_1_1_ED2021_03_25,
    CSS_R847_1_1_ED2021_06_01,
    CSS_R847_1_1_ED2022_03_21,
    CSS_R847_1_1_ED2023_12_31,
    CSS_R847_1_1_ED2024_01_01,
    CSS_R847_1_1_ED2024_07_01,
    CSS_R847_1_1_ED2025_01_01,
    CSS_R847_1_1_ED2025_02_28,
    CSS_R847_1_1_ED2025_03_31,
    CSS_R847_1_1_ED2026_04_01,
    CSS_R847_1_1_ED2026_06_27)
rule PouvoirRectification(d: Demandeur, idx: Date, rec: Date, dd: Date) strict {
    effective [@2021-03-25, infinity);
    label fr official "P2: rectification dans les vingt jours, interruption CRA (R. 847-1-1 III)";
    label en unofficial "P2: rectification within twenty days, CRA interruption (R. 847-1-1 III)";
    when notification_recouvrement(d, idx) and reception_notification(d, rec)
        and demande_rectification(d, dd)
        and notification_moyen_date_certaine(d)
        and dd >= rec
        and dd <= add_calendar_period(rec, 20 calendar_day);
    then power DemandeRectification {
        holder d;
        exercise demande_rectification(d, dd);
        // D-42: the twenty-day window (rec <= dd <= rec + 20 days) is
        // enforced by the creating rule body; valid_when executes only a
        // literal conjunction (§127, E-0190), comparisons there left the
        // CRA interruption unmaterialised.
        valid_when (notification_recouvrement(d, idx)
            and reception_notification(d, rec)
            and notification_moyen_date_certaine(d));
        effect interruption_delai_cra(d);
        window [@2021-03-25, infinity);
    };
}

