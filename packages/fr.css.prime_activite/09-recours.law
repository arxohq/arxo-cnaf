    label fr official "rectification accordée vaut décision sur la rectification (R. 847-1-1 II/III)";
    label en unofficial "granted rectification counts as a decision on rectification (R. 847-1-1 II/III)";
    when decision_rectification_accordee(d);
    then decision_rectification(d);
}

