rule DecisionParRejet(d: Demandeur, date: Date) strict {
    effective [@2021-03-25, infinity);
    label fr official "rejet daté vaut décision sur la rectification (R. 847-1-1 II/III)";
    label en unofficial "dated rejection counts as a decision on rectification (R. 847-1-1 II/III)";
    when decision_rectification_rejet(d, date);
    then decision_rectification(d);
}

