    label fr official "accord daté dans le mois sur la demande dans les vingt jours: pas de rejet implicite (R. 847-1-1 II 1°)";
    label en unofficial "dated grant within the month on the twenty-day request: no implicit rejection (R. 847-1-1 II 1°)";
    when demande_rectification(d, dd) and reception_notification(d, rec)
        and notification_moyen_date_certaine(d)
        and dd >= rec and dd <= add_calendar_period(rec, 20 calendar_day)
        and decision_rectification_accordee_datee(d, dec)
        and dec >= dd
        and dec < add_calendar_period(dd, 1 calendar_month);
    then not rejet_implicite_rectification(d);
}

