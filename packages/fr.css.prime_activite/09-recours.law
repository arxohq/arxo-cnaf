rule RejetImpliciteRefuteHorsDelai(d: Demandeur, dd: Date, rec: Date) strict {
    effective [@2021-03-25, infinity);
    label fr official "demande après vingt jours: pas de rejet implicite II (R. 847-1-1 II 1°)";
    label en unofficial "post-twenty-day request: no II implicit rejection (R. 847-1-1 II 1°)";
    when demande_rectification(d, dd) and reception_notification(d, rec)
        and notification_moyen_date_certaine(d)
        and dd > add_calendar_period(rec, 20 calendar_day);
    then not rejet_implicite_rectification(d);
}

