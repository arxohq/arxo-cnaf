@id("urn:fr:corpus:clir:pf-ars#CSS_D543_2")
pub fragment CSS_D543_2 in CSS_ED2002_08 {
    kind article;
    locator "article/D543-2";
    text fr official """Article D543-2
Lorsque le total des montants d'allocation de rentrée scolaire dû à la personne ou au ménage est inférieur à 15 euros, celui-ci n'est pas versé.
""";
    content_hash "sha256:49cad8d5a7b43cc8fc59cb6a4a25348e85102f239371c14ef62b4cc5a23da555";
}

