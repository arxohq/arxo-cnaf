@id("urn:fr:corpus:clir:pf-ars#CSS_R543_7")
pub fragment CSS_R543_7 in CSS_ED1985_12 {
    kind article;
    locator "article/R543-7";
    text fr official """Article R543-7
L'allocation de rentrée scolaire fait l'objet d'un versement unique qui doit être opéré au plus tard le 31 octobre de l'année considérée.
""";
    content_hash "sha256:0b405472f308b163bb39e35608b9296e236e670cccce3294c926142ab746e289";
}

