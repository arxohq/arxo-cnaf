// Open right: one eligible child, 12000 under the 13000 ceiling
// (10000 nominal + 30 % x 1).
language "law.core" version "0.2";
package fr.pf.ars version "0.1.0";
namespace "urn:fr:corpus:clir:pf-ars";

test "urn:query:fr-pf-ars-droit-ouvert" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2021-09-15T12:00:00Z; knowledge_time @2021-09-15T12:00:00Z; legal_time @2021-09-15; timezone "Europe/Paris"; }
        assert "ado-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-ars:case:droit-ouvert"), entity_ref("urn:fr:pf-ars:case:droit-ouvert-e1")) { origin case_input; }
        assert "ado-02": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-ars:case:droit-ouvert-e1")) { origin case_input; }
        assert "ado-03": date_naissance(entity_ref("urn:fr:pf-ars:case:droit-ouvert-e1"), @2014-06-01) { origin case_input; }
        assert "ado-04": seuil_six_ans(@2022-02-01) { origin case_input; }
        assert "ado-05": seuil_dix_huit_ans(@2021-09-15) { origin case_input; }
        assert "ado-06": inscription_scolaire(entity_ref("urn:fr:pf-ars:case:droit-ouvert-e1")) { origin case_input; }
        assert "ado-07": nb_enfants_ars(entity_ref("urn:fr:pf-ars:case:droit-ouvert"), 1) { origin case_input; }
        assert "ado-08": ressources_menage(entity_ref("urn:fr:pf-ars:case:droit-ouvert"), 12000 EUR) { origin case_input; }
        assert "ado-09": plafond_base_ars(entity_ref("urn:fr:pf-ars:case:droit-ouvert"), 10000 EUR) { origin case_input; }
    }
    evaluate truth(ars_droit_ouvert(entity_ref("urn:fr:pf-ars:case:droit-ouvert")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
