// Young student (L543-1 para. 2): 4 years old, studying, pay within
// the upstream ceiling: eligible on the adopted six-year-line reading.
language "law.core" version "0.2";
package fr.pf.ars version "0.1.0";
namespace "urn:fr:corpus:clir:pf-ars";

test "urn:query:fr-pf-ars-jeune-etudiant" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2021-09-15T12:00:00Z; knowledge_time @2021-09-15T12:00:00Z; legal_time @2021-09-15; timezone "Europe/Paris"; }
        assert "aje-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-ars:case:jeune-etudiant"), entity_ref("urn:fr:pf-ars:case:jeune-etudiant-e1")) { origin case_input; }
        assert "aje-02": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-ars:case:jeune-etudiant-e1")) { origin case_input; }
        assert "aje-03": date_naissance(entity_ref("urn:fr:pf-ars:case:jeune-etudiant-e1"), @2017-06-01) { origin case_input; }
        assert "aje-04": seuil_six_ans(@2022-02-01) { origin case_input; }
        assert "aje-05": etudes_apprentissage(entity_ref("urn:fr:pf-ars:case:jeune-etudiant-e1")) { origin case_input; }
        assert "aje-06": remuneration_bornee(entity_ref("urn:fr:pf-ars:case:jeune-etudiant-e1")) { origin case_input; }
    }
    evaluate truth(ars_enfant_eligible(entity_ref("urn:fr:pf-ars:case:jeune-etudiant-e1")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
