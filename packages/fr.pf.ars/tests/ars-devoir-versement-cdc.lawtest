// Active fund duty for a CDC-routed payment: the placed child's
// 358.88 EUR is due from the fund (channel: CDC pecule) no later than
// 2021-10-31. Position PayerArsDu is ACTIVE.
// D-29(b): the base amount requires ars_droit_ouvert, so the case states
// the resource facts (resources 12000 within the stated base ceiling 10000 +
// per-child increment; illustrative).
language "law.core" version "0.2";
package fr.pf.ars version "0.1.0";
namespace "urn:fr:corpus:clir:pf-ars";

test "urn:query:fr-pf-ars-devoir-versement-cdc" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2021-09-15T12:00:00Z; knowledge_time @2021-09-15T12:00:00Z; legal_time @2021-09-15; timezone "Europe/Paris"; }
        assert "avc-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-ars:case:devoir-versement-cdc"), entity_ref("urn:fr:pf-ars:case:devoir-versement-cdc-e1")) { origin case_input; }
        assert "avc-02": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-ars:case:devoir-versement-cdc-e1")) { origin case_input; }
        assert "avc-03": date_naissance(entity_ref("urn:fr:pf-ars:case:devoir-versement-cdc-e1"), @2014-06-01) { origin case_input; }
        assert "avc-04": seuil_six_ans(@2022-02-01) { origin case_input; }
        assert "avc-05": seuil_dix_huit_ans(@2021-09-15) { origin case_input; }
        assert "avc-06": inscription_scolaire(entity_ref("urn:fr:pf-ars:case:devoir-versement-cdc-e1")) { origin case_input; }
        assert "avc-07": date_reference_taux(@2021-12-31) { origin case_input; }
        assert "avc-08": bmaf_retenu(entity_ref("urn:fr:pf-ars:case:devoir-versement-cdc"), 400.00 EUR) { origin case_input; }
        assert "avc-rg1": nb_enfants_ars(entity_ref("urn:fr:pf-ars:case:devoir-versement-cdc"), 1) { origin case_input; }
        assert "avc-rg2": ressources_menage(entity_ref("urn:fr:pf-ars:case:devoir-versement-cdc"), 12000 EUR) { origin case_input; }
        assert "avc-rg3": plafond_base_ars(entity_ref("urn:fr:pf-ars:case:devoir-versement-cdc"), 10000 EUR) { origin case_input; }
        assert "avc-09": placement_ase(entity_ref("urn:fr:pf-ars:case:devoir-versement-cdc-e1")) { origin case_input; }
        assert "avc-10": date_limite_versement(@2021-10-31) { origin case_input; }
        assert "avc-11": fr.pf.core::organisme_debiteur_pf(entity_ref("urn:fr:pf-ars:org:caisse"), entity_ref("urn:fr:pf-ars:case:devoir-versement-cdc")) { origin case_input; }
    }
    evaluate truth(ars_paiement_cdc(entity_ref("urn:fr:pf-ars:case:devoir-versement-cdc-e1")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(PayerArsDu, ACTIVE);
}
