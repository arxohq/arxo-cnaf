// Eleven-to-fourteen band (born 2009-06-01: eleven reached, fifteen
// not): 0.9467 x 400.00 = 378.68 on the stated base.
// D-29(b): the base amount requires ars_droit_ouvert, so the case states
// the resource facts (resources 12000 within the stated base ceiling 10000 +
// per-child increment; illustrative).
language "law.core" version "0.2";
package fr.pf.ars version "0.1.0";
namespace "urn:fr:corpus:clir:pf-ars";

test "urn:query:fr-pf-ars-montant-11-14" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2021-09-15T12:00:00Z; knowledge_time @2021-09-15T12:00:00Z; legal_time @2021-09-15; timezone "Europe/Paris"; }
        assert "amq-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-ars:case:montant-11-14"), entity_ref("urn:fr:pf-ars:case:montant-11-14-e1")) { origin case_input; }
        assert "amq-02": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-ars:case:montant-11-14-e1")) { origin case_input; }
        assert "amq-03": date_naissance(entity_ref("urn:fr:pf-ars:case:montant-11-14-e1"), @2009-06-01) { origin case_input; }
        assert "amq-04": seuil_six_ans(@2022-02-01) { origin case_input; }
        assert "amq-05": seuil_dix_huit_ans(@2021-09-15) { origin case_input; }
        assert "amq-06": inscription_scolaire(entity_ref("urn:fr:pf-ars:case:montant-11-14-e1")) { origin case_input; }
        assert "amq-07": date_reference_taux(@2021-12-31) { origin case_input; }
        assert "amq-08": bmaf_retenu(entity_ref("urn:fr:pf-ars:case:montant-11-14"), 400.00 EUR) { origin case_input; }
        assert "amq-rg1": nb_enfants_ars(entity_ref("urn:fr:pf-ars:case:montant-11-14"), 1) { origin case_input; }
        assert "amq-rg2": ressources_menage(entity_ref("urn:fr:pf-ars:case:montant-11-14"), 12000 EUR) { origin case_input; }
        assert "amq-rg3": plafond_base_ars(entity_ref("urn:fr:pf-ars:case:montant-11-14"), 10000 EUR) { origin case_input; }
    }
    evaluate truth(ars_montant_du(entity_ref("urn:fr:pf-ars:case:montant-11-14-e1"), 378.68 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
