// Same young student without established capped pay: neither the
// standard band (below six) nor the student track fires (NEITHER).
language "law.core" version "0.2";
package fr.pf.ars version "0.1.0";
namespace "urn:fr:corpus:clir:pf-ars";

test "urn:query:fr-pf-ars-jeune-sans-plafond" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2021-09-15T12:00:00Z; knowledge_time @2021-09-15T12:00:00Z; legal_time @2021-09-15; timezone "Europe/Paris"; }
        assert "ajs-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-ars:case:jeune-sans-plafond"), entity_ref("urn:fr:pf-ars:case:jeune-sans-plafond-e1")) { origin case_input; }
        assert "ajs-02": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-ars:case:jeune-sans-plafond-e1")) { origin case_input; }
        assert "ajs-03": date_naissance(entity_ref("urn:fr:pf-ars:case:jeune-sans-plafond-e1"), @2017-06-01) { origin case_input; }
        assert "ajs-04": seuil_six_ans(@2022-02-01) { origin case_input; }
        assert "ajs-05": etudes_apprentissage(entity_ref("urn:fr:pf-ars:case:jeune-sans-plafond-e1")) { origin case_input; }
    }
    evaluate truth(ars_enfant_eligible(entity_ref("urn:fr:pf-ars:case:jeune-sans-plafond-e1")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
