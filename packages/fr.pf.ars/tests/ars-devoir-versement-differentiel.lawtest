// Active fund duty, differential track: 438.35 EUR per child on the
// standalone chain. Position PayerArsDifferentielDu is ACTIVE.
language "law.core" version "0.2";
package fr.pf.ars version "0.1.0";
namespace "urn:fr:corpus:clir:pf-ars";

test "urn:query:fr-pf-ars-devoir-versement-differentiel" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2021-09-15T12:00:00Z; knowledge_time @2021-09-15T12:00:00Z; legal_time @2021-09-15; timezone "Europe/Paris"; }
        assert "avd-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-ars:case:devoir-versement-differentiel"), entity_ref("urn:fr:pf-ars:case:devoir-versement-differentiel-e1")) { origin case_input; }
        assert "avd-02": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-ars:case:devoir-versement-differentiel"), entity_ref("urn:fr:pf-ars:case:devoir-versement-differentiel-e2")) { origin case_input; }
        assert "avd-03": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-ars:case:devoir-versement-differentiel-e1")) { origin case_input; }
        assert "avd-04": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-ars:case:devoir-versement-differentiel-e2")) { origin case_input; }
        assert "avd-05": date_naissance(entity_ref("urn:fr:pf-ars:case:devoir-versement-differentiel-e1"), @2014-06-01) { origin case_input; }
        assert "avd-06": date_naissance(entity_ref("urn:fr:pf-ars:case:devoir-versement-differentiel-e2"), @2005-06-01) { origin case_input; }
        assert "avd-07": seuil_six_ans(@2022-02-01) { origin case_input; }
        assert "avd-08": seuil_dix_huit_ans(@2021-09-15) { origin case_input; }
        assert "avd-09": inscription_scolaire(entity_ref("urn:fr:pf-ars:case:devoir-versement-differentiel-e1")) { origin case_input; }
        assert "avd-10": inscription_scolaire(entity_ref("urn:fr:pf-ars:case:devoir-versement-differentiel-e2")) { origin case_input; }
        assert "avd-11": nb_enfants_ars(entity_ref("urn:fr:pf-ars:case:devoir-versement-differentiel"), 2) { origin case_input; }
        assert "avd-12": nb_bande(entity_ref("urn:fr:pf-ars:case:devoir-versement-differentiel"), ARS_MOINS_11, 1) { origin case_input; }
        assert "avd-13": nb_bande(entity_ref("urn:fr:pf-ars:case:devoir-versement-differentiel"), ARS_11_14, 0) { origin case_input; }
        assert "avd-14": nb_bande(entity_ref("urn:fr:pf-ars:case:devoir-versement-differentiel"), ARS_15_PLUS, 1) { origin case_input; }
        assert "avd-15": ressources_menage(entity_ref("urn:fr:pf-ars:case:devoir-versement-differentiel"), 17000 EUR) { origin case_input; }
        assert "avd-16": plafond_base_ars(entity_ref("urn:fr:pf-ars:case:devoir-versement-differentiel"), 10000 EUR) { origin case_input; }
        assert "avd-17": bmaf_retenu(entity_ref("urn:fr:pf-ars:case:devoir-versement-differentiel"), 1000.00 EUR) { origin case_input; }
        assert "avd-18": date_limite_versement(@2021-10-31) { origin case_input; }
        assert "avd-19": fr.pf.core::organisme_debiteur_pf(entity_ref("urn:fr:pf-ars:org:caisse"), entity_ref("urn:fr:pf-ars:case:devoir-versement-differentiel")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(PayerArsDifferentielDu, ACTIVE);
}
