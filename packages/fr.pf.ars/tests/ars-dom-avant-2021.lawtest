// Before the program window: at legal_time 2020 the DOM rules are
// silent (effective [@2021-01-01, infinity)) even for a department
// household (both residence facts) with an otherwise eligible child —
// the edition-window pair of the DOM attribution, applicability and
// fund-exclusion scenarios.
language "law.core" version "0.2";
package fr.pf.ars version "0.1.0";
namespace "urn:fr:corpus:clir:pf-ars";

test "urn:query:fr-pf-ars-dom-avant-2021" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2020-09-15T12:00:00Z; knowledge_time @2020-09-15T12:00:00Z; legal_time @2020-09-15; timezone "Europe/Paris"; }
        assert "aav-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-ars:case:dom-avant-2021"), entity_ref("urn:fr:pf-ars:case:dom-avant-2021-e1")) { origin case_input; }
        assert "aav-02": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-ars:case:dom-avant-2021-e1")) { origin case_input; }
        assert "aav-03": date_naissance(entity_ref("urn:fr:pf-ars:case:dom-avant-2021-e1"), @2013-06-01) { origin case_input; }
        assert "aav-04": seuil_six_ans(@2021-02-01) { origin case_input; }
        assert "aav-05": seuil_dix_huit_ans(@2020-09-15) { origin case_input; }
        assert "aav-06": inscription_scolaire(entity_ref("urn:fr:pf-ars:case:dom-avant-2021-e1")) { origin case_input; }
        assert "aav-07": residence_dom(entity_ref("urn:fr:pf-ars:case:dom-avant-2021")) { origin case_input; }
        assert "aav-08": residence_departement_dom(entity_ref("urn:fr:pf-ars:case:dom-avant-2021")) { origin case_input; }
    }
    evaluate truth(ars_r543_applicable_dom(entity_ref("urn:fr:pf-ars:case:dom-avant-2021")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(ars_attribuee_dom(entity_ref("urn:fr:pf-ars:case:dom-avant-2021-e1")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(ars_exclue_ressources_fonds(entity_ref("urn:fr:pf-ars:case:dom-avant-2021-e1")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
