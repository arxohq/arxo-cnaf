// Resources exactly at the 13000 ceiling: the strict under-ceiling
// test fails, and the overrun test fails too, so neither the right
// nor the differential opens (both NEITHER with full inputs stated).
language "law.core" version "0.2";
package fr.pf.ars version "0.1.0";
namespace "urn:fr:corpus:clir:pf-ars";

test "urn:query:fr-pf-ars-droit-plafond-egal" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2021-09-15T12:00:00Z; knowledge_time @2021-09-15T12:00:00Z; legal_time @2021-09-15; timezone "Europe/Paris"; }
        assert "adp-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-ars:case:droit-plafond-egal"), entity_ref("urn:fr:pf-ars:case:droit-plafond-egal-e1")) { origin case_input; }
        assert "adp-02": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-ars:case:droit-plafond-egal-e1")) { origin case_input; }
        assert "adp-03": date_naissance(entity_ref("urn:fr:pf-ars:case:droit-plafond-egal-e1"), @2014-06-01) { origin case_input; }
        assert "adp-04": seuil_six_ans(@2022-02-01) { origin case_input; }
        assert "adp-05": seuil_dix_huit_ans(@2021-09-15) { origin case_input; }
        assert "adp-06": inscription_scolaire(entity_ref("urn:fr:pf-ars:case:droit-plafond-egal-e1")) { origin case_input; }
        assert "adp-07": nb_enfants_ars(entity_ref("urn:fr:pf-ars:case:droit-plafond-egal"), 1) { origin case_input; }
        assert "adp-08": nb_bande(entity_ref("urn:fr:pf-ars:case:droit-plafond-egal"), ARS_MOINS_11, 1) { origin case_input; }
        assert "adp-09": nb_bande(entity_ref("urn:fr:pf-ars:case:droit-plafond-egal"), ARS_11_14, 0) { origin case_input; }
        assert "adp-10": nb_bande(entity_ref("urn:fr:pf-ars:case:droit-plafond-egal"), ARS_15_PLUS, 0) { origin case_input; }
        assert "adp-11": ressources_menage(entity_ref("urn:fr:pf-ars:case:droit-plafond-egal"), 13000 EUR) { origin case_input; }
        assert "adp-12": plafond_base_ars(entity_ref("urn:fr:pf-ars:case:droit-plafond-egal"), 10000 EUR) { origin case_input; }
        assert "adp-13": bmaf_retenu(entity_ref("urn:fr:pf-ars:case:droit-plafond-egal"), 400.00 EUR) { origin case_input; }
    }
    evaluate truth(ars_droit_ouvert(entity_ref("urn:fr:pf-ars:case:droit-plafond-egal")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(ars_differentiel_du(entity_ref("urn:fr:pf-ars:case:droit-plafond-egal-e1"), 0 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
