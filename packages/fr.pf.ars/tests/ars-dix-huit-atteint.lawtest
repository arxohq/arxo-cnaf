// Eighteen reached 2021-09-16, strictly after 2021-09-15: eligible.
language "law.core" version "0.2";
package fr.pf.ars version "0.1.0";
namespace "urn:fr:corpus:clir:pf-ars";

test "urn:query:fr-pf-ars-dix-huit-atteint" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2021-09-15T12:00:00Z; knowledge_time @2021-09-15T12:00:00Z; legal_time @2021-09-15; timezone "Europe/Paris"; }
        assert "ada-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-ars:case:dix-huit-atteint"), entity_ref("urn:fr:pf-ars:case:dix-huit-atteint-e1")) { origin case_input; }
        assert "ada-02": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-ars:case:dix-huit-atteint-e1")) { origin case_input; }
        assert "ada-03": date_naissance(entity_ref("urn:fr:pf-ars:case:dix-huit-atteint-e1"), @2003-09-16) { origin case_input; }
        assert "ada-04": seuil_six_ans(@2022-02-01) { origin case_input; }
        assert "ada-05": seuil_dix_huit_ans(@2021-09-15) { origin case_input; }
        assert "ada-06": inscription_scolaire(entity_ref("urn:fr:pf-ars:case:dix-huit-atteint-e1")) { origin case_input; }
    }
    evaluate truth(ars_enfant_eligible(entity_ref("urn:fr:pf-ars:case:dix-huit-atteint-e1")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
