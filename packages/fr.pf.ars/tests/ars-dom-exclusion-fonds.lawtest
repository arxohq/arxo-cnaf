        assert "aef-21": nb_enfants_ars(entity_ref("urn:fr:pf-ars:case:dom-exclusion-fonds-b"), 2) { origin case_input; }
        assert "aef-22": nb_bande(entity_ref("urn:fr:pf-ars:case:dom-exclusion-fonds-b"), ARS_MOINS_11, 1) { origin case_input; }
