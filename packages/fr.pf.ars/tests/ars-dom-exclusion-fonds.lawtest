        assert "aef-50": ars_verse(entity_ref("urn:fr:pf-ars:case:dom-exclusion-fonds-d"), entity_ref("urn:fr:pf-ars:case:dom-exclusion-fonds-d-e4"), 300.00 EUR) { origin case_input; }
        assert "aef-51": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-ars:case:dom-exclusion-fonds-e"), entity_ref("urn:fr:pf-ars:case:dom-exclusion-fonds-e-e5")) { origin case_input; }
