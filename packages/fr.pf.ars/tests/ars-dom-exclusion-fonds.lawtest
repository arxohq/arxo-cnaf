// Fund exclusion (R. 755-14-1): only ARS actually paid (versées)
// in a department is excluded from the CAF health/social action fund
// resources — on the base amount track (0.8972 x 400.00 = 358.88,
// stated base) with matching ars_verse and department residence, and
// on the standalone differential track (438.35 per child, stated
// figures of the differential suite) with matching ars_verse for each
// child. Due-but-unpaid (department household, no verse), mismatched
// paid value (verse 300.00 against due 358.88), paid-but-not-resident
// and paid collectivity-only (Saint-Martin: matching verse and
// collectivity residence but no department fact) cases stay outside
// the exclusion.
language "law.core" version "0.2";
package fr.pf.ars version "0.1.0";
namespace "urn:fr:corpus:clir:pf-ars";

test "urn:query:fr-pf-ars-dom-exclusion-fonds" {
    given {
        context { deadline_policy AGE_ATTEINT; decision_time @2021-09-15T12:00:00Z; knowledge_time @2021-09-15T12:00:00Z; legal_time @2021-09-15; timezone "Europe/Paris"; }
        assert "aef-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-ars:case:dom-exclusion-fonds-a"), entity_ref("urn:fr:pf-ars:case:dom-exclusion-fonds-a-e1")) { origin case_input; }
        assert "aef-02": fr.pf.core::enfant_ouvre_droit(entity_ref("urn:fr:pf-ars:case:dom-exclusion-fonds-a-e1")) { origin case_input; }
        assert "aef-03": date_naissance(entity_ref("urn:fr:pf-ars:case:dom-exclusion-fonds-a-e1"), @2014-06-01) { origin case_input; }
        assert "aef-04": seuil_six_ans(@2022-02-01) { origin case_input; }
        assert "aef-05": seuil_dix_huit_ans(@2021-09-15) { origin case_input; }
        assert "aef-06": inscription_scolaire(entity_ref("urn:fr:pf-ars:case:dom-exclusion-fonds-a-e1")) { origin case_input; }
        assert "aef-07": date_reference_taux(@2021-12-31) { origin case_input; }
        assert "aef-08": bmaf_retenu(entity_ref("urn:fr:pf-ars:case:dom-exclusion-fonds-a"), 400.00 EUR) { origin case_input; }
        assert "aef-09": nb_enfants_ars(entity_ref("urn:fr:pf-ars:case:dom-exclusion-fonds-a"), 1) { origin case_input; }
        assert "aef-10": ressources_menage(entity_ref("urn:fr:pf-ars:case:dom-exclusion-fonds-a"), 12000 EUR) { origin case_input; }
        assert "aef-11": plafond_base_ars(entity_ref("urn:fr:pf-ars:case:dom-exclusion-fonds-a"), 10000 EUR) { origin case_input; }
        assert "aef-12": residence_dom(entity_ref("urn:fr:pf-ars:case:dom-exclusion-fonds-a")) { origin case_input; }
        assert "aef-13": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-ars:case:dom-exclusion-fonds-b"), entity_ref("urn:fr:pf-ars:case:dom-exclusion-fonds-b-e1")) { origin case_input; }
