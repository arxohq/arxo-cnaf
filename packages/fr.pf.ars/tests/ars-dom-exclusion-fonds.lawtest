        assert "aef-35": ressources_menage(entity_ref("urn:fr:pf-ars:case:dom-exclusion-fonds-c"), 12000 EUR) { origin case_input; }
        assert "aef-36": plafond_base_ars(entity_ref("urn:fr:pf-ars:case:dom-exclusion-fonds-c"), 10000 EUR) { origin case_input; }
        assert "aef-37": ars_verse(entity_ref("urn:fr:pf-ars:case:dom-exclusion-fonds-a"), entity_ref("urn:fr:pf-ars:case:dom-exclusion-fonds-a-e1"), 358.88 EUR) { origin case_input; }
        assert "aef-38": ars_verse(entity_ref("urn:fr:pf-ars:case:dom-exclusion-fonds-b"), entity_ref("urn:fr:pf-ars:case:dom-exclusion-fonds-b-e1"), 438.35 EUR) { origin case_input; }
        assert "aef-39": ars_verse(entity_ref("urn:fr:pf-ars:case:dom-exclusion-fonds-b"), entity_ref("urn:fr:pf-ars:case:dom-exclusion-fonds-b-e2"), 438.35 EUR) { origin case_input; }
        assert "aef-40": residence_dom(entity_ref("urn:fr:pf-ars:case:dom-exclusion-fonds-c")) { origin case_input; }
