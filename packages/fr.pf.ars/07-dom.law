rule ArsExclueFondsDifferentiel(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, montant: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "complément différentiel ARS versé exclu des ressources du fonds d'action sanitaire et social (R. 755-14-1)";
    label en unofficial "paid ARS differential top-up excluded from the health and social action fund resources (R. 755-14-1)";
    when fr.pf.core::parent_charge(p, e) and ars_differentiel_du(e, montant)
        and ars_verse(p, e, montant) and residence_departement_dom(p);
    then ars_exclue_ressources_fonds(e);
}
