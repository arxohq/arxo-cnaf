};

@source(
    CSS_R755_14,
    CSS_R755_14_ED1990_09,
    CSS_R755_14_ED1999_06,
    CSS_R755_14_ED2001_12,
    CSS_R755_14_ED2002_08,
    CSS_R755_14_ED2004_01,
    CSS_R755_14_ED2008_08,
    CSS_R755_14_ED2012_06,
    CSS_R755_14_ED2013_06,
    CSS_R755_14_ED2014_08,
    CSS_R755_14_ED2015_10,
    CSS_R755_14_ED2016_03,
    CSS_R755_14_ED2016_10,
    CSS_R755_14_ED2019_01,
    CSS_R755_14_ED2022_01,
    CSS_R755_14_ED2022_02)
rule ArsR543ApplicableDom(p: fr.pf.core::Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "R. 543-1 à R. 543-7 applicables dans les départements L. 751-1 (R. 755-14)";
    label en unofficial "R. 543-1 to R. 543-7 applicable in L. 751-1 departments (R. 755-14)";
    when residence_departement_dom(p);
    then ars_r543_applicable_dom(p);
}

@source(
    CSS_L755_22,
    CSS_L755_22_ED2016_03,
    CSS_L755_22_ED2016_10,
    CSS_L755_22_ED2019_01,
    CSS_L755_22_ED2022_01,
    CSS_L755_22_ED2022_02)
rule ArsAttribueeDom(p: fr.pf.core::Personne, e: fr.pf.core::Enfant) strict {
    effective [@2021-01-01, infinity);
    label fr official "ARS attribuée dans les collectivités L. 751-1 (L. 755-22)";
    label en unofficial "school-start allowance granted in L. 751-1 collectivities (L. 755-22)";
    when fr.pf.core::parent_charge(p, e) and ars_enfant_eligible(e)
        and residence_dom(p);
    then ars_attribuee_dom(e);
}

@source(
    CSS_R755_14_1,
    CSS_R755_14_1_ED1990_09,
    CSS_R755_14_1_ED1999_06,
