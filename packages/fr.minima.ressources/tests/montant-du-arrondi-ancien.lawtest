// Reading MoyenneArrondieCentime on the amount due (R.262-7_PRE2025, I), old regime.
// No resources; MF 600.00, 600.00, 602.00: the intermediate amounts sum to
// 1802.00, 1802/3 = 600.6666...; the reading rounds half up to 600.67.
language "law.core" version "0.2";
package fr.minima.ressources version "0.1.0";
namespace "urn:fr:corpus:clir:minima-ressources";

test "urn:query:fr-minima-ressources-montant-du-arrondi-ancien" {
    given {
        context { deadline_policy RSA_TRIMESTRE; decision_time @2025-01-15T12:00:00Z; knowledge_time @2025-01-15T12:00:00Z; legal_time @2025-01-15; timezone "Europe/Paris"; interpretation MoyenneArrondieCentime; }
        assert "arr-dua-01": foyer_du_cas(entity_ref("urn:fr:minima-ressources:case:montant-du-arrondi-ancien")) { origin case_input; }
        assert "arr-dua-02": mois_demande(@2025-01-01) { origin case_input; }
        assert "arr-dua-03": mois_reference(@2024-10-01, @2024-11-01, @2024-12-01) { origin case_input; }
        assert "arr-dua-04": mf_mois(entity_ref("urn:fr:minima-ressources:case:montant-du-arrondi-ancien"), @2024-10-01, 600.00 EUR) { origin case_input; }
        assert "arr-dua-05": mf_mois(entity_ref("urn:fr:minima-ressources:case:montant-du-arrondi-ancien"), @2024-11-01, 600.00 EUR) { origin case_input; }
        assert "arr-dua-06": mf_mois(entity_ref("urn:fr:minima-ressources:case:montant-du-arrondi-ancien"), @2024-12-01, 602.00 EUR) { origin case_input; }
        assert "arr-dua-07": declare_total_mois(entity_ref("urn:fr:minima-ressources:case:montant-du-arrondi-ancien"), @2024-10-01, 0.00 EUR) { origin case_input; }
        assert "arr-dua-08": declare_total_mois(entity_ref("urn:fr:minima-ressources:case:montant-du-arrondi-ancien"), @2024-11-01, 0.00 EUR) { origin case_input; }
        assert "arr-dua-09": declare_total_mois(entity_ref("urn:fr:minima-ressources:case:montant-du-arrondi-ancien"), @2024-12-01, 0.00 EUR) { origin case_input; }
        assert "arr-dua-10": prestation_service_mois(entity_ref("urn:fr:minima-ressources:case:montant-du-arrondi-ancien"), @2024-10-01, 0 EUR) { origin case_input; }
        assert "arr-dua-11": prestation_service_mois(entity_ref("urn:fr:minima-ressources:case:montant-du-arrondi-ancien"), @2024-11-01, 0 EUR) { origin case_input; }
        assert "arr-dua-12": prestation_service_mois(entity_ref("urn:fr:minima-ressources:case:montant-du-arrondi-ancien"), @2024-12-01, 0 EUR) { origin case_input; }
    }
    evaluate truth(montant_du_trimestre(entity_ref("urn:fr:minima-ressources:case:montant-du-arrondi-ancien"), 600.67 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
