// Declared professional income, new regime: gross 2000.00 minus 500.00
// contributions = 1500.00 retained (R.262-12, II).
language "law.core" version "0.2";
package fr.minima.ressources version "0.1.0";
namespace "urn:fr:corpus:clir:minima-ressources";

test "urn:query:fr-minima-ressources-pro-net" {
    given {
        context { deadline_policy RSA_TRIMESTRE; decision_time @2025-06-15T12:00:00Z; knowledge_time @2025-06-15T12:00:00Z; legal_time @2025-06-15; timezone "Europe/Paris"; }
        assert "pronet-01": brut_pro_declare_mois(entity_ref("urn:fr:minima-ressources:case:pro-net"), @2025-04-01, 2000.00 EUR) { origin case_input; }
        assert "pronet-02": cotisations_pro_mois(entity_ref("urn:fr:minima-ressources:case:pro-net"), @2025-04-01, 500.00 EUR) { origin case_input; }
    }
    evaluate truth(montant_retenu_mois(entity_ref("urn:fr:minima-ressources:case:pro-net"), @2025-04-01, REVENU_PRO_SALARIE, 1500.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
