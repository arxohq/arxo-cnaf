// Old-regime quarter: claim June 2024, reference March/April/May 2024.
// Declared 200.00 each month + service benefits 50.00 each month, MF 600.00:
// base 250.00, intermediate 350.00, quarterly amount 350.00.
language "law.core" version "0.2";
package fr.minima.ressources version "0.1.0";
namespace "urn:fr:corpus:clir:minima-ressources";

test "urn:query:fr-minima-ressources-trimestre-ancien-moyen" {
    given {
        context { deadline_policy RSA_TRIMESTRE; decision_time @2024-06-15T12:00:00Z; knowledge_time @2024-06-15T12:00:00Z; legal_time @2024-06-15; timezone "Europe/Paris"; }
        assert "trim-anc-01": foyer_du_cas(entity_ref("urn:fr:minima-ressources:case:trimestre-ancien-moyen")) { origin case_input; }
        assert "trim-anc-02": mois_demande(@2024-06-01) { origin case_input; }
        assert "trim-anc-03": mois_reference(@2024-03-01, @2024-04-01, @2024-05-01) { origin case_input; }
        assert "trim-anc-04": mf_mois(entity_ref("urn:fr:minima-ressources:case:trimestre-ancien-moyen"), @2024-03-01, 600.00 EUR) { origin case_input; }
        assert "trim-anc-05": mf_mois(entity_ref("urn:fr:minima-ressources:case:trimestre-ancien-moyen"), @2024-04-01, 600.00 EUR) { origin case_input; }
        assert "trim-anc-06": mf_mois(entity_ref("urn:fr:minima-ressources:case:trimestre-ancien-moyen"), @2024-05-01, 600.00 EUR) { origin case_input; }
        assert "trim-anc-07": declare_total_mois(entity_ref("urn:fr:minima-ressources:case:trimestre-ancien-moyen"), @2024-03-01, 200.00 EUR) { origin case_input; }
        assert "trim-anc-08": declare_total_mois(entity_ref("urn:fr:minima-ressources:case:trimestre-ancien-moyen"), @2024-04-01, 200.00 EUR) { origin case_input; }
        assert "trim-anc-09": declare_total_mois(entity_ref("urn:fr:minima-ressources:case:trimestre-ancien-moyen"), @2024-05-01, 200.00 EUR) { origin case_input; }
        assert "trim-anc-10": prestation_service_mois(entity_ref("urn:fr:minima-ressources:case:trimestre-ancien-moyen"), @2024-03-01, 50.00 EUR) { origin case_input; }
        assert "trim-anc-11": prestation_service_mois(entity_ref("urn:fr:minima-ressources:case:trimestre-ancien-moyen"), @2024-04-01, 50.00 EUR) { origin case_input; }
        assert "trim-anc-12": prestation_service_mois(entity_ref("urn:fr:minima-ressources:case:trimestre-ancien-moyen"), @2024-05-01, 50.00 EUR) { origin case_input; }
    }
    evaluate truth(trimestre_reference(entity_ref("urn:fr:minima-ressources:case:trimestre-ancien-moyen"), @2024-03-01, @2024-04-01, @2024-05-01));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(montant_du_trimestre(entity_ref("urn:fr:minima-ressources:case:trimestre-ancien-moyen"), 350.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
