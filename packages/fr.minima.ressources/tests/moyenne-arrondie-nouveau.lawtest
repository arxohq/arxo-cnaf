// Reading MoyenneArrondieCentime, new regime (R.262-7, I and II 1° and 2°).
// Claim June 2025, reference M-4..M-2 (February/March/April 2025). Professional DSN
// 100.00 + 100.00 + 101.00 -> 100.33; other DSN 50.00 + 50.00 + 51.00 -> 50.33;
// declared 10.00 + 10.00 + 11.00 -> 10.33 (each 1/3 down to the centime).
// MF 600.00: base 160.99 each month, intermediate 439.01, amount due 439.01.
language "law.core" version "0.2";
package fr.minima.ressources version "0.1.0";
namespace "urn:fr:corpus:clir:minima-ressources";

test "urn:query:fr-minima-ressources-moyenne-arrondie-nouveau" {
    given {
        context { deadline_policy RSA_TRIMESTRE; decision_time @2025-06-15T12:00:00Z; knowledge_time @2025-06-15T12:00:00Z; legal_time @2025-06-15; timezone "Europe/Paris"; interpretation MoyenneArrondieCentime; }
        assert "arr-nou-01": foyer_du_cas(entity_ref("urn:fr:minima-ressources:case:moyenne-arrondie-nouveau")) { origin case_input; }
        assert "arr-nou-02": mois_demande(@2025-06-01) { origin case_input; }
        assert "arr-nou-03": mois_reference(@2025-02-01, @2025-03-01, @2025-04-01) { origin case_input; }
        assert "arr-nou-04": mf_mois(entity_ref("urn:fr:minima-ressources:case:moyenne-arrondie-nouveau"), @2025-02-01, 600.00 EUR) { origin case_input; }
        assert "arr-nou-05": mf_mois(entity_ref("urn:fr:minima-ressources:case:moyenne-arrondie-nouveau"), @2025-03-01, 600.00 EUR) { origin case_input; }
        assert "arr-nou-06": mf_mois(entity_ref("urn:fr:minima-ressources:case:moyenne-arrondie-nouveau"), @2025-04-01, 600.00 EUR) { origin case_input; }
        assert "arr-nou-07": dsn_pro_mois(entity_ref("urn:fr:minima-ressources:case:moyenne-arrondie-nouveau"), @2025-02-01, 100.00 EUR) { origin case_input; }
        assert "arr-nou-08": dsn_pro_mois(entity_ref("urn:fr:minima-ressources:case:moyenne-arrondie-nouveau"), @2025-03-01, 100.00 EUR) { origin case_input; }
        assert "arr-nou-09": dsn_pro_mois(entity_ref("urn:fr:minima-ressources:case:moyenne-arrondie-nouveau"), @2025-04-01, 101.00 EUR) { origin case_input; }
        assert "arr-nou-10": dsn_autre_mois(entity_ref("urn:fr:minima-ressources:case:moyenne-arrondie-nouveau"), @2025-02-01, 50.00 EUR) { origin case_input; }
        assert "arr-nou-11": dsn_autre_mois(entity_ref("urn:fr:minima-ressources:case:moyenne-arrondie-nouveau"), @2025-03-01, 50.00 EUR) { origin case_input; }
        assert "arr-nou-12": dsn_autre_mois(entity_ref("urn:fr:minima-ressources:case:moyenne-arrondie-nouveau"), @2025-04-01, 51.00 EUR) { origin case_input; }
        assert "arr-nou-13": declare_total_mois(entity_ref("urn:fr:minima-ressources:case:moyenne-arrondie-nouveau"), @2025-02-01, 10.00 EUR) { origin case_input; }
        assert "arr-nou-14": declare_total_mois(entity_ref("urn:fr:minima-ressources:case:moyenne-arrondie-nouveau"), @2025-03-01, 10.00 EUR) { origin case_input; }
        assert "arr-nou-15": declare_total_mois(entity_ref("urn:fr:minima-ressources:case:moyenne-arrondie-nouveau"), @2025-04-01, 11.00 EUR) { origin case_input; }
        assert "arr-nou-16": prestation_service_mois(entity_ref("urn:fr:minima-ressources:case:moyenne-arrondie-nouveau"), @2025-02-01, 0 EUR) { origin case_input; }
        assert "arr-nou-17": prestation_service_mois(entity_ref("urn:fr:minima-ressources:case:moyenne-arrondie-nouveau"), @2025-03-01, 0 EUR) { origin case_input; }
        assert "arr-nou-18": prestation_service_mois(entity_ref("urn:fr:minima-ressources:case:moyenne-arrondie-nouveau"), @2025-04-01, 0 EUR) { origin case_input; }
    }
    evaluate truth(moyenne_dsn_pro(entity_ref("urn:fr:minima-ressources:case:moyenne-arrondie-nouveau"), 100.33 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(moyenne_dsn_autre(entity_ref("urn:fr:minima-ressources:case:moyenne-arrondie-nouveau"), 50.33 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(moyenne_declaree(entity_ref("urn:fr:minima-ressources:case:moyenne-arrondie-nouveau"), 10.33 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(montant_du_trimestre(entity_ref("urn:fr:minima-ressources:case:moyenne-arrondie-nouveau"), 439.01 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
