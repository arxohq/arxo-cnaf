// Aid below the flat-rate is kept as is: single owner, MF 600.00 ->
// flat 72.00, aid 50.00 retained 50.00 (R.262-10).
language "law.core" version "0.2";
package fr.minima.ressources version "0.1.0";
namespace "urn:fr:corpus:clir:minima-ressources";

test "urn:query:fr-minima-ressources-aide-sous-forfait" {
    given {
        context { deadline_policy RSA_TRIMESTRE; decision_time @2025-06-15T12:00:00Z; knowledge_time @2025-06-15T12:00:00Z; legal_time @2025-06-15; timezone "Europe/Paris"; }
        assert "aidesous-01": nb_personnes_forfait(entity_ref("urn:fr:minima-ressources:case:aide-sous-forfait"), 1) { origin case_input; }
        assert "aidesous-02": logement(entity_ref("urn:fr:minima-ressources:case:aide-sous-forfait"), PROPRIETAIRE_SANS_AIDE) { origin case_input; }
        assert "aidesous-03": mf_composition(entity_ref("urn:fr:minima-ressources:case:aide-sous-forfait"), 1, 600.00 EUR) { origin case_input; }
        assert "aidesous-04": aide_logement_percue(entity_ref("urn:fr:minima-ressources:case:aide-sous-forfait"), @2025-04-01, 50.00 EUR) { origin case_input; }
    }
    evaluate truth(aide_logement_retenue(entity_ref("urn:fr:minima-ressources:case:aide-sous-forfait"), @2025-04-01, 50.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
