@id("urn:fr:corpus:clir:minima-ressources#CASF_R262_22_ED2023_12")
pub fragment CASF_R262_22_ED2023_12 in CASF_ED2023_12 {
    kind article;
    locator "article/R262-22";
    text fr official """Article R262-22
Les revenus professionnels des non-salariés pris en compte autres que ceux mentionnés au dernier alinéa de l'article R. 262-19 sont égaux à 25 % des revenus annuels fixés en application de l'article R. 262-23.
""";
    content_hash "sha256:608285339b829d59620366e6a88530c1d231bfb1f397a8eddaa73edf7c46f82a";
}

