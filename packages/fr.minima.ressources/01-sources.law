@id("urn:fr:corpus:clir:minima-ressources#CASF_R262_24")
pub fragment CASF_R262_24 in CASF_ED2021_01 {
    kind article;
    locator "article/R262-24";
    text fr official """Article R262-24
En l'absence de déclaration ou d'imposition d'une ou plusieurs activités non salariées, le président du conseil départemental évalue le revenu au vu de l'ensemble des éléments d'appréciation fournis par le demandeur.
""";
    content_hash "sha256:ea64ba66d59a13e2b72a1ccf2bc74b68e5e0dcf18aee59eaf23d8b234ac17a56";
}

@id("urn:fr:corpus:clir:minima-ressources#CASF_R262_24_ED2021_03")
