// --- Declared professional income: gross minus contributions (R.262-12, II) ---

@source(
    CASF_R262_12_PRE2026,
    CASF_R262_12_PRE2026_ED2025_02,
    CASF_R262_12_PRE2026_ED2025_06,
    CASF_R262_12)
rule ProDeclareNet(p: Personne, mois: Date, brut: Money, cotis: Money) strict {
    effective [@2023-12-31, infinity);
    label fr official "revenu professionnel déclaré hors TNS : brut moins cotisations (R. 262-12, II)";
    label en unofficial "declared professional income outside TNS: gross minus contributions (R. 262-12, II)";
    when brut_pro_declare_mois(p, mois, brut) and cotisations_pro_mois(p, mois, cotis);
    then montant_retenu_mois(p, mois, REVENU_PRO_SALARIE, brut - cotis);
}

@source(
    CASF_R262_12_PRE2024,
    CASF_R262_12_PRE2024_ED2021_03,
    CASF_R262_12_PRE2024_ED2022_03)
rule ProDeclareAncien(p: Personne, mois: Date, v: Money) strict {
    effective [@2021-01-01, @2023-12-31);
    label fr official "revenu professionnel déclaré avant 2024 : retenu tel qu'établi, sans règle brut-net au texte (R. 262-12_PRE2024 ; B-MINRES-PRO-PRE2024)";
    label en unofficial "pre-2024 declared professional income: retained as established, no gross-net rule in the text (R. 262-12_PRE2024; B-MINRES-PRO-PRE2024)";
    when ressource_declaree_mois(p, mois, REVENU_PRO_SALARIE, v);
    then montant_retenu_mois(p, mois, REVENU_PRO_SALARIE, v);
}

// --- Non-salaried: 25 % of the evaluated annual figure (R.262-22, R.262-23) ---

@source(
    CASF_R262_22,
    CASF_R262_22_ED2021_03,
    CASF_R262_22_ED2022_03,
    CASF_R262_22_ED2023_12,
    CASF_R262_22_ED2025_02,
    CASF_R262_22_ED2025_06,
    CASF_R262_22_ED2026_06,
    CASF_R262_23,
    CASF_R262_23_ED2021_03,
    CASF_R262_23_ED2022_03,
    CASF_R262_23_ED2023_12,
    CASF_R262_23_ED2025_02,
    CASF_R262_23_ED2025_06,
    CASF_R262_23_ED2026_06)
rule TnsTrimestriel(p: Personne, annuel: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "TNS hors dernier alinéa R. 262-19 : 25 % de l'annuel arrêté par le président (R. 262-22, R. 262-23 ; années de référence et IPC : B-MINRES-TNS-REFERENCE)";
    label en unofficial "TNS outside the last paragraph of R. 262-19: 25 % of the president-set annual figure (R. 262-22, R. 262-23; reference years and IPC: B-MINRES-TNS-REFERENCE)";
    when tns_evalue_annuel(p, annuel);
    then tns_trimestre(p, annuel * 0.25);
}

// --- Certain interruption disregards professional and unemployment income (R.262-13 al.1) ---

@source(
    CASF_R262_13_PRE2025,
    CASF_R262_13_PRE2025_ED2021_03,
    CASF_R262_13_PRE2025_ED2022_03,
    CASF_R262_13_PRE2025_ED2023_12,
    CASF_R262_13_PRE202506,
    CASF_R262_13,
    CASF_R262_13_ED2026_06)
rule NeutralisationPro(p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "revenu professionnel certainement interrompu, sans substitut : pas de prise en compte, sauf veto démission (R. 262-13 al. 1 et 5)";
    label en unofficial "certainly interrupted professional income, no substitute: disregarded, save the resignation veto (R. 262-13 paras. 1 and 5)";
    when perception_interrompue(p, REVENU_PRO_SALARIE)
        and not_known(maintien_demission_decide(p));
    then neutralisation_revenu(p, REVENU_PRO_SALARIE);
}

@source(
    CASF_R262_13_PRE2025,
    CASF_R262_13_PRE2025_ED2021_03,
    CASF_R262_13_PRE2025_ED2022_03,
    CASF_R262_13_PRE2025_ED2023_12,
    CASF_R262_13_PRE202506,
    CASF_R262_13,
    CASF_R262_13_ED2026_06)
rule NeutralisationTns(p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "revenu non salarié certainement interrompu, sans substitut : pas de prise en compte, sauf veto démission (R. 262-13 al. 1 et 5)";
    label en unofficial "certainly interrupted non-salaried income, no substitute: disregarded, save the resignation veto (R. 262-13 paras. 1 and 5)";
    when perception_interrompue(p, REVENU_PRO_NON_SALARIE)
        and not_known(maintien_demission_decide(p));
    then neutralisation_revenu(p, REVENU_PRO_NON_SALARIE);
}

@source(
    CASF_R262_13_PRE2025,
    CASF_R262_13_PRE2025_ED2021_03,
    CASF_R262_13_PRE2025_ED2022_03,
    CASF_R262_13_PRE2025_ED2023_12,
    CASF_R262_13_PRE202506,
    CASF_R262_13,
    CASF_R262_13_ED2026_06)
rule NeutralisationChomage(p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "allocation chômage certainement interrompue, sans substitut, hors sanction L. 5412-1 : pas de prise en compte (R. 262-13 al. 1 et 2)";
    label en unofficial "certainly interrupted unemployment benefit, no substitute, outside an L. 5412-1 sanction: disregarded (R. 262-13 paras. 1 and 2)";
    when perception_interrompue(p, ALLOCATION_CHOMAGE)
        and not_known(interruption_sanction_chomage(p));
    then neutralisation_revenu(p, ALLOCATION_CHOMAGE);
}

@source(
    CASF_R262_13,
    CASF_R262_13_ED2026_06)
rule ChomageSanctionMaintenu(p: Personne) strict {
    effective [@2025-06-01, infinity);
    label fr official "interruption chômage issue d'une sanction L. 5412-1 : prise en compte maintenue sauf dispense du président (R. 262-13 al. 2)";
    label en unofficial "unemployment interruption from an L. 5412-1 sanction: counting kept absent presidential dispensation (R. 262-13 para. 2)";
    when interruption_sanction_chomage(p)
        and not_known(dispense_president_interruption(p));
    then chomage_maintenu_sanction(p);
}

@source(
    CASF_R262_13,
    CASF_R262_13_ED2026_06)
rule DispensePresidentChomage(p: Personne) strict {
    effective [@2025-06-01, infinity);
    label fr official "dispense du président au vu de la situation particulière : neutralisation malgré la sanction (R. 262-13 al. 2)";
    label en unofficial "presidential dispensation on the particular situation: disregard despite the sanction (R. 262-13 para. 2)";
    when interruption_sanction_chomage(p)
        and dispense_president_interruption(p);
    then neutralisation_revenu(p, ALLOCATION_CHOMAGE);
}

@source(
    CASF_R262_13_PRE2025,
    CASF_R262_13_PRE2025_ED2021_03,
    CASF_R262_13_PRE2025_ED2022_03,
    CASF_R262_13_PRE2025_ED2023_12,
    CASF_R262_13_PRE202506,
    CASF_R262_13,
    CASF_R262_13_ED2026_06)
rule MaintienApresDemission(p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "décision individuelle après démission en situation exceptionnelle : pas de neutralisation (R. 262-13 al. 5, canal)";
    label en unofficial "individual decision after resignation in an exceptional situation: no disregard (R. 262-13 para. 5, channel)";
    when demission_interruption(p)
        and situation_exceptionnelle_insertion(p)
        and maintien_demission_decide(p);
    then revenu_maintenu_demission(p);
}

@source(
    CASF_R262_13_PRE2025,
    CASF_R262_13_PRE2025_ED2021_03,
    CASF_R262_13_PRE2025_ED2022_03,
    CASF_R262_13_PRE2025_ED2023_12,
    CASF_R262_13_PRE202506,
    CASF_R262_13,
    CASF_R262_13_ED2026_06)
rule NeutralisationAutres(p: Personne, cat: CategorieRessource) strict {
    effective [@2021-01-01, infinity);
    label fr official "autres ressources interrompues dans la limite du MF personne seule : pas de prise en compte, limite établie (R. 262-13 al. 3)";
    label en unofficial "other resources interrupted within the single-person MF limit: disregarded, limit established (R. 262-13 para. 3)";
    when interruption_autres_plafond(p, cat);
    then neutralisation_revenu(p, cat);
}

// --- Individual gift disregard (R.262-14, adjudicated channel) ---

@source(
    CASF_R262_14,
    CASF_R262_14_ED2021_03,
    CASF_R262_14_ED2022_03,
    CASF_R262_14_ED2023_12,
    CASF_R262_14_ED2025_02,
    CASF_R262_14_ED2025_06,
    CASF_R262_14_ED2026_06)
rule LiberalitesEcartees(p: Personne, mois: Date, motif: ItemExclusion, v: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "libéralités écartées sur décision individuelle en situation exceptionnelle (R. 262-14, canal)";
    label en unofficial "gifts set aside by individual decision in an exceptional situation (R. 262-14, channel)";
    when liberalites_foyer(p, mois, v)
        and situation_exceptionnelle_insertion(p)
        and decision_individuelle_liberalites(p);
    then montant_retenu_mois(p, mois, EXCLUE, 0 EUR);
}

// --- Seasonal bar: N-2 above twelve times the January MF (R.262-25) ---

@source(
    CASF_R262_25,
    CASF_R262_25_ED2021_03,
    CASF_R262_25_ED2022_03,
    CASF_R262_25_ED2023_12,
    CASF_R262_25_ED2025_02,
    CASF_R262_25_ED2025_06,
    CASF_R262_25_ED2026_06)
rule SeuilSaisonnier(p: Personne, mf: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "seuil saisonnier : douze fois le MF du 1er janvier N-2 (R. 262-25)";
    label en unofficial "seasonal threshold: twelve times the 1 January N-2 MF (R. 262-25)";
    when mf_reference_annuelle(p, mf);
    then seuil_saisonnier(p, mf * 12.0);
}

@source(
    CASF_R262_25,
    CASF_R262_25_ED2021_03,
    CASF_R262_25_ED2022_03,
    CASF_R262_25_ED2023_12,
    CASF_R262_25_ED2025_02,
    CASF_R262_25_ED2025_06,
    CASF_R262_25_ED2026_06)
rule BarrageSaisonnier(p: Personne, r: Money, seuil: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "saisonnier au-dessus du seuil : pas de droit sauf modification effective justifiée (R. 262-25)";
    label en unofficial "seasonal worker above the threshold: no right absent a justified effective change (R. 262-25)";
    when activite_saisonniere(p)
        and ressources_n_moins_2(p, r)
        and seuil_saisonnier(p, seuil)
        and r > seuil
        and not_known(modification_situation_pro(p));
    then barrage_saisonnier(p);
}

// --- Increased CF and ASF counted up to flat-rates (R.262-10-1) ---

@source(
    CASF_R262_10_1,
    CASF_R262_10_1_ED2021_03,
    CASF_R262_10_1_ED2022_03,
    CASF_R262_10_1_ED2023_12,
    CASF_R262_10_1_ED2025_02,
    CASF_R262_10_1_ED2025_06,
    CASF_R262_10_1_ED2026_06)
rule CfMajoreSousPlafond(p: Personne, mois: Date, percu: Money, bmaf: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "complément familial majoré sous le forfait 41,65 % : compté tel quel (R. 262-10-1, I)";
    label en unofficial "increased CF below the 41.65 % flat-rate: counted as is (R. 262-10-1, I)";
    when ressource_declaree_mois(p, mois, CF_MAJORE, percu)
        and bmaf_retenue(p, bmaf)
        and percu <= bmaf * TauxCfMajoreForfait;
    then montant_retenu_mois(p, mois, CF_MAJORE, percu);
}

@source(
    CASF_R262_10_1,
    CASF_R262_10_1_ED2021_03,
    CASF_R262_10_1_ED2022_03,
    CASF_R262_10_1_ED2023_12,
    CASF_R262_10_1_ED2025_02,
    CASF_R262_10_1_ED2025_06,
    CASF_R262_10_1_ED2026_06)
rule CfMajorePlafonne(p: Personne, mois: Date, percu: Money, bmaf: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "complément familial majoré au-delà du forfait 41,65 % : compté à hauteur du forfait (R. 262-10-1, I)";
    label en unofficial "increased CF above the 41.65 % flat-rate: counted up to the flat-rate (R. 262-10-1, I)";
    when ressource_declaree_mois(p, mois, CF_MAJORE, percu)
        and bmaf_retenue(p, bmaf)
        and percu > bmaf * TauxCfMajoreForfait;
    then montant_retenu_mois(p, mois, CF_MAJORE, bmaf * TauxCfMajoreForfait);
}

@source(
    CASF_R262_10_1,
    CASF_R262_10_1_ED2021_03,
    CASF_R262_10_1_ED2022_03,
    CASF_R262_10_1_ED2023_12,
    CASF_R262_10_1_ED2025_02,
    CASF_R262_10_1_ED2025_06,
    CASF_R262_10_1_ED2026_06)
rule AsfRang1SousPlafond(p: Personne, mois: Date, percu: Money, bmaf: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "ASF rang 1 sous le forfait 30 % : comptée telle quelle (R. 262-10-1, II 1°)";
    label en unofficial "class-1 ASF below the 30 % flat-rate: counted as is (R. 262-10-1, II 1°)";
    when asf_percue(p, mois, RANG_1, percu)
        and bmaf_retenue(p, bmaf)
        and percu <= bmaf * TauxAsfForfaitRang1;
    then asf_retenu_rang(p, mois, RANG_1, percu);
}

