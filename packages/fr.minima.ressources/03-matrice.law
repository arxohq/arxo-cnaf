// --- ASF monthly total: one retained amount per category (key(p, mois,
// cat) on montant_retenu_mois). Both classes together are summed; a lone
// class is kept alone, guarded by the absence of the other class. ---

@source(
    CASF_R262_10_1,
    CASF_R262_10_1_ED2021_03,
    CASF_R262_10_1_ED2022_03,
    CASF_R262_10_1_ED2023_12,
    CASF_R262_10_1_ED2025_02,
    CASF_R262_10_1_ED2025_06,
    CASF_R262_10_1_ED2026_06)
rule AsfRangPresent(p: Personne, mois: Date, classe: ClasseAsf, v: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "classe ASF servie dès qu'un montant est perçu (R. 262-10-1, II)";
    label en unofficial "ASF class served as soon as an amount is received (R. 262-10-1, II)";
    when asf_percue(p, mois, classe, v);
    then asf_rang_present(p, mois, classe);
}

@source(
    CASF_R262_10_1,
    CASF_R262_10_1_ED2021_03,
    CASF_R262_10_1_ED2022_03,
    CASF_R262_10_1_ED2023_12,
    CASF_R262_10_1_ED2025_02,
    CASF_R262_10_1_ED2025_06,
    CASF_R262_10_1_ED2026_06)
rule AsfTotalDeuxRangs(p: Personne, mois: Date, c1: Money, c2: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "ASF deux classes : somme des montants retenus par rang (R. 262-10-1, II)";
    label en unofficial "ASF in both classes: sum of the per-class retained amounts (R. 262-10-1, II)";
    when asf_retenu_rang(p, mois, RANG_1, c1)
        and asf_retenu_rang(p, mois, RANG_2, c2);
    then montant_retenu_mois(p, mois, ASF_PERCUE, c1 + c2);
}

@source(
    CASF_R262_10_1,
    CASF_R262_10_1_ED2021_03,
    CASF_R262_10_1_ED2022_03,
    CASF_R262_10_1_ED2023_12,
    CASF_R262_10_1_ED2025_02,
    CASF_R262_10_1_ED2025_06,
    CASF_R262_10_1_ED2026_06)
rule AsfTotalRang1Seul(p: Personne, mois: Date, c1: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "ASF rang 1 seul : montant retenu du rang 1 (R. 262-10-1, II 1°)";
    label en unofficial "class-1 ASF only: the class-1 retained amount (R. 262-10-1, II 1°)";
    when asf_retenu_rang(p, mois, RANG_1, c1)
        and not_known(asf_rang_present(p, mois, RANG_2));
    then montant_retenu_mois(p, mois, ASF_PERCUE, c1);
}

@source(
    CASF_R262_10_1,
    CASF_R262_10_1_ED2021_03,
    CASF_R262_10_1_ED2022_03,
    CASF_R262_10_1_ED2023_12,
    CASF_R262_10_1_ED2025_02,
    CASF_R262_10_1_ED2025_06,
    CASF_R262_10_1_ED2026_06)
rule AsfTotalRang2Seul(p: Personne, mois: Date, c2: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "ASF rang 2 seul : montant retenu du rang 2 (R. 262-10-1, II 2°)";
    label en unofficial "class-2 ASF only: the class-2 retained amount (R. 262-10-1, II 2°)";
    when asf_retenu_rang(p, mois, RANG_2, c2)
        and not_known(asf_rang_present(p, mois, RANG_1));
    then montant_retenu_mois(p, mois, ASF_PERCUE, c2);
}

// --- R.262-11 exclusions, stable items (editions 2021-01 on) ---
//
// One rule per exclusion group; each concludes a zero retained amount in
// the EXCLUE bucket (idempotent across groups). The @source set covers
// every edition: one fragment per R.262-11 version in force.

@source(
    CASF_R262_11_PRE202103,
    CASF_R262_11_PRE202203,
    CASF_R262_11_PRE2024,
    CASF_R262_11_PRE2025,
    CASF_R262_11,
    CASF_R262_11_ED2025_06,
    CASF_R262_11_ED2026_06)
rule ExclusionPfNaissance(p: Personne, mois: Date, v: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "prime naissance/adoption non comptée (R. 262-11, 1°)";
    label en unofficial "birth/adoption grant not counted (R. 262-11, 1°)";
    when prestation_exclue_mois(p, mois, EXCL_PF_NAISSANCE, v);
    then montant_retenu_mois(p, mois, EXCLUE, 0 EUR);
}

