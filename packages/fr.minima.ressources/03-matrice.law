// Resource matrix (R.262-6, R.262-10-1 to R.262-25).
//
// DEONTIC MAP: computation only, plus three presidential decision
// channels (no must/must-not here):
// - TNS annual evaluation (R.262-23/24): the evaluated figure arrives
//   established (tns_evalue_annuel); the 25 % quarterly take (R.262-22)
//   is built, the reference years (R.262-18/19), the article-62 rule
//   (R.262-20) and the deficit/IPC mechanics (R.262-21) are input
//   contract on that figure (B-MINRES-TNS-REFERENCE: IPC rate from the
//   unpinned PLF report);
// - individual gift disregard (R.262-14): adjudicated channel
//   (decision_individuelle_liberalites);
// - resignation neutralisation veto (R.262-13 al.5): channel
//   (maintien_demission_decide).
//
// DUAL FEED (B-MINRES-DUAL-FEED). The per-category conclusions below
// (montant_retenu_mois) demonstrate the matrix one category at a time;
// the quarterly mechanics (02-trimestre.law) run on fund-established
// block totals. Cases assert both sides under the consistency contract
// (block total = sum of the retained category amounts).

language "law.core" version "0.2";
package fr.minima.ressources version "0.1.0";
namespace "urn:fr:corpus:clir:minima-ressources";

