relation tns_trimestre(p: Personne, montant: Money) kind institutional {
    key(p);
    label fr official "revenu non salarié retenu pour le trimestre : 25 % de l'annuel arrêté (R. 262-22)";
    label en unofficial "non-salaried income retained for the quarter: 25 % of the set annual figure (R. 262-22)";
}

relation revenu_maintenu_demission(p: Personne) kind institutional {
    key(p);
    label fr official "revenu maintenu après démission sur décision individuelle (R. 262-13 al. 5)";
    label en unofficial "income kept after resignation by individual decision (R. 262-13 para. 5)";
}

relation chomage_maintenu_sanction(p: Personne) kind institutional {
    key(p);
    label fr official "allocation chômage maintenue : interruption issue d'une sanction L. 5412-1 (R. 262-13 al. 2)";
    label en unofficial "unemployment benefit kept: interruption from an L. 5412-1 sanction (R. 262-13 para. 2)";
}

relation seuil_saisonnier(p: Personne, montant: Money) kind institutional {
    key(p);
    label fr official "seuil saisonnier : douze fois le MF du 1er janvier N-2 (R. 262-25)";
    label en unofficial "seasonal threshold: twelve times the 1 January N-2 MF (R. 262-25)";
}

// --- All household resources count unless excluded or capped (R.262-6) ---

@source(
    CASF_R262_6,
    CASF_R262_6_ED2021_03,
    CASF_R262_6_ED2022_03,
    CASF_R262_6_ED2023_12,
    CASF_R262_6_ED2025_02,
    CASF_R262_6_ED2025_06,
    CASF_R262_6_ED2026_06)
rule CompteChomage(p: Personne, mois: Date, v: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "allocations chômage comptées (R. 262-6)";
    label en unofficial "unemployment benefits counted (R. 262-6)";
    when ressource_declaree_mois(p, mois, ALLOCATION_CHOMAGE, v);
    then montant_retenu_mois(p, mois, ALLOCATION_CHOMAGE, v);
}

