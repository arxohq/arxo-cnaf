rule RevisionMiTrimestreIsolement(p: Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "révision entre réexamens : entrée en isolement L. 262-9, établie en amont (R. 262-4-1, 3°)";
    label en unofficial "mid-quarter revision: entry into L. 262-9 isolation, established upstream (R. 262-4-1, 3°)";
    when conditions_mois_droit_etablies(p) and conjoint_repute_present(p);
    then revision_mi_trimestre(p);
}

// --- L.262-2/L.262-4 conditions met in the month of right (R.262-4-2, channel) ---

@source(
