    effective [@2021-01-01, infinity);
    label fr official "révision entre réexamens : interruption de la vie commune (R. 262-4-1, 2°)";
    label en unofficial "mid-quarter revision: household breakup (R. 262-4-1, 2°)";
    when ancien_conjoint_sorti(p);
    then revision_mi_trimestre(p);
}

@source(
    CASF_R262_4_1,
    CASF_R262_4_1_ED2021_03,
    CASF_R262_4_1_ED2022_03,
    CASF_R262_4_1_ED2023_12,
