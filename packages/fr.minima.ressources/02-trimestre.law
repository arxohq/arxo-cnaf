    CASF_R262_4_1_ED2025_06,
    CASF_R262_4_1_ED2026_06)
rule RevisionMiTrimestreInterruption(p: Personne, cat: CategorieRessource) strict {
    effective [@2021-01-01, infinity);
    label fr official "révision entre réexamens : perception de ressources interrompue (R. 262-13) (R. 262-4-1, 1°)";
    label en unofficial "mid-quarter revision: resource receipt interrupted (R. 262-13) (R. 262-4-1, 1°)";
    when neutralisation_revenu(p, cat);
    then revision_mi_trimestre(p);
}

@source(
    CASF_R262_4_1,
    CASF_R262_4_1_ED2021_03,
    CASF_R262_4_1_ED2022_03,
