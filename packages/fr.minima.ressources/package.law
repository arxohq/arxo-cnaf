pub relation interruption_autres_plafond(p: Personne, cat: CategorieRessource) kind empirical {
    label fr official "autres ressources interrompues de manière certaine, dans la limite du MF personne seule (R. 262-13 al. 3), établi par la caisse";
    label en unofficial "other resources certainly interrupted, within the single-person MF limit (R. 262-13 para. 3), established by the fund";
