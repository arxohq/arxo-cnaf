pub relation forfait_logement_element_pro(p: Personne) kind empirical {
    label fr official "l'avantage logement constitue un élément des revenus professionnels R. 262-12 (pas de forfait)";
    label en unofficial "the housing benefit is part of R. 262-12 professional income (no flat-rate)";
