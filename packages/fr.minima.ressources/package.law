    label fr official "revenus professionnels déclarés hors DSN, valeur brute (R. 262-12, II)";
    label en unofficial "professional income declared outside the DSN, gross value (R. 262-12, II)";
}

pub relation cotisations_pro_mois(p: Personne, mois: Date, montant: Money) kind empirical {
    key(p, mois);
    label fr official "cotisations et contributions sociales à la charge du bénéficiaire (R. 262-12, II 2°)";
    label en unofficial "employee social contributions and levies (R. 262-12, II 2°)";
}

pub relation mf_reference_annuelle(p: Personne, montant: Money) kind empirical {
    key(p);
    label fr official "montant forfaitaire mensuel applicable au foyer au 1er janvier de l'année N-2 (R. 262-25)";
    label en unofficial "monthly flat-rate amount for the household on 1 January of year N-2 (R. 262-25)";
}

pub relation maintien_demission_decide(p: Personne) kind empirical {
    label fr official "décision individuelle du président : pas de neutralisation après démission (R. 262-13 al. 5, canal)";
    label en unofficial "individual presidential decision: no disregard after resignation (R. 262-13 para. 5, channel)";
}

pub relation mf_composition(p: Personne, taille: Integer, montant: Money) kind empirical {
    key(p, taille);
    label fr official "montant forfaitaire par taille de foyer (R. 262-1), établi par fr.casf.rsa ; contrat d'entrée (1, 2, 3 ou plus)";
    label en unofficial "flat-rate amount by household size (R. 262-1), established by fr.casf.rsa; input contract (1, 2, 3 or more)";
