rule PartsMenage(p: fr.pf.core::Personne, enfants: Integer) strict {
    effective [@2021-01-01, infinity);
    label fr official "Ménage: 2 parts plus 0,5 par enfant";
    label en unofficial "Household: 2 parts plus 0.5 per child";
    when menage(p) and nb_enfants_charge(p, enfants);
    then parts_famille_n(p, parts_menage(enfants));
}

