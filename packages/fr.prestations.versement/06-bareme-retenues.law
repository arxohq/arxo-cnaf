        fr.pf.core::CSS_D553_4_CSS_ED2026_04, fr.pf.core::CSS_D553_4_CSS_ED2026_06)
rule RetenueUniqueIndusMultiples(p: fr.pf.core::Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "Indus multiples: une seule retenue mensuelle sur les prestations servies";
    label en unofficial "Multiple overpayments: a single monthly levy on the benefits served";
    when indus_multiples(p);
    then retenue_unique_indus_multiples(p);
}

@source(fr.pf.core::CSS_D553_4, fr.pf.core::CSS_D553_4_CSS_ED2021_05,
        fr.pf.core::CSS_D553_4_CSS_ED2021_11, fr.pf.core::CSS_D553_4_CSS_ED2021_12,
        fr.pf.core::CSS_D553_4_CSS_ED2022_01, fr.pf.core::CSS_D553_4_CSS_ED2022_02,
        fr.pf.core::CSS_D553_4_CSS_ED2022_03, fr.pf.core::CSS_D553_4_CSS_ED2022_09,
        fr.pf.core::CSS_D553_4_CSS_ED2023_07, fr.pf.core::CSS_D553_4_CSS_ED2024_01,
        fr.pf.core::CSS_D553_4_CSS_ED2025_02, fr.pf.core::CSS_D553_4_CSS_ED2025_09,
        fr.pf.core::CSS_D553_4_CSS_ED2025_12, fr.pf.core::CSS_D553_4_CSS_ED2026_01,
        fr.pf.core::CSS_D553_4_CSS_ED2026_04, fr.pf.core::CSS_D553_4_CSS_ED2026_06)
rule InduOrdreAnciennete(a: Indu, b: Indu, p: fr.pf.core::Personne, da: Date, db: Date, ma: Money, mb: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "Indus multiples: l'indu le plus ancien se recouvre en premier, par ordre d'ancienneté";
    label en unofficial "Multiple overpayments: the oldest overpayment recovers first, by seniority order";
    when indus_multiples(p) and indu_constate_le(a, p, da, ma) and indu_constate_le(b, p, db, mb)
        and da < db;
    then indu_recouvre_avant(a, b, p);
}

