}

const Tranche516: Money = 516.00 EUR {
    label fr official "plafond de 516 euros (D. 553-1 III)";
    label en unofficial "EUR 516 ceiling (D. 553-1 III)";
}

const Tranche517: Money = 517.00 EUR {
    label fr official "plancher de 517 euros (D. 553-1 III)";
    label en unofficial "EUR 517 floor (D. 553-1 III)";
}

const Tranche690: Money = 690.00 EUR {
    label fr official "plafond de 690 euros (D. 553-1 III)";
    label en unofficial "EUR 690 ceiling (D. 553-1 III)";
}

const Tranche691: Money = 691.00 EUR {
    label fr official "seuil de 691 euros (D. 553-1 III)";
    label en unofficial "EUR 691 mark (D. 553-1 III)";
}

const PartsBaseIsole: Decimal = 1.5 {
    label fr official "1,5 part pour la personne seule (D. 553-1 II)";
    label en unofficial "1.5 parts for the single person (D. 553-1 II)";
}

const PartsBaseMenage: Decimal = 2.0 {
    label fr official "2 parts pour le ménage (D. 553-1 II)";
    label en unofficial "2 parts for the household (D. 553-1 II)";
}

const PartsParEnfant: Decimal = 0.5 {
    label fr official "0,5 part par enfant à charge ou assimilé (D. 553-1 II)";
    label en unofficial "0.5 parts per dependent or assimilated child (D. 553-1 II)";
}

function charges_defaut_25(revenus: Money, prestations: Money) -> Money =
    (revenus + prestations) * TauxChargesLogement25;

function revenu_total_r(revenus: Money, prestations: Money, charges: Money) -> Money =
    revenus + prestations - charges;

function parts_isole(enfants: Integer) -> Decimal =
    PartsBaseIsole + PartsParEnfant * enfants;

function parts_menage(enfants: Integer) -> Decimal =
    PartsBaseMenage + PartsParEnfant * enfants;

// PC-A01: no weighting function. The pinned D. 553-1 II exposes R, the
// sentence "Ce revenu est pondéré selon la formule :" and N as separate
// paragraphs with no operator or expression (B-VERS-D5531-PONDERE-FORMULE),
// so no R/N or alternative formula is inferred here.

function prelevement_tranche1(x: Money) -> Money =
    ForfaitPrelevement + (x - Tranche231) * TauxPrelevement25;

function prelevement_tranche2(x: Money) -> Money = ForfaitPrelevement + (Tranche345 - Tranche231) * TauxPrelevement25 + (x - Tranche346) * TauxPrelevement35;

function prelevement_tranche3(x: Money) -> Money = ForfaitPrelevement + (Tranche345 - Tranche231) * TauxPrelevement25 + (Tranche516 - Tranche346) * TauxPrelevement35 + (x - Tranche517) * TauxPrelevement45;

function prelevement_tranche4(x: Money) -> Money = ForfaitPrelevement + (Tranche345 - Tranche231) * TauxPrelevement25 + (Tranche516 - Tranche346) * TauxPrelevement35 + (Tranche690 - Tranche517) * TauxPrelevement45 + (x - Tranche691) * TauxPrelevement60;

function seuil_hausse_20(ancien: Money) -> Money =
    ancien * 1.2;

function seuil_baisse_20(ancien: Money) -> Money =
    ancien * 0.8;

function allocation_indu(retenue: Money, anterieur: Money, solde: Money) -> Money =
    if retenue <= anterieur then 0.00 EUR else if retenue - anterieur <= solde then retenue - anterieur else solde;

@source(fr.pf.core::CSS_D553_1, fr.pf.core::CSS_D553_1_CSS_ED2022_02,
        fr.pf.core::CSS_D553_1_CSS_ED2022_03, fr.pf.core::CSS_D553_1_CSS_ED2022_09,
        fr.pf.core::CSS_D553_1_CSS_ED2023_07, fr.pf.core::CSS_D553_1_CSS_ED2024_01,
        fr.pf.core::CSS_D553_1_CSS_ED2025_02, fr.pf.core::CSS_D553_1_CSS_ED2025_09,
        fr.pf.core::CSS_D553_1_CSS_ED2025_12, fr.pf.core::CSS_D553_1_CSS_ED2026_01,
        fr.pf.core::CSS_D553_1_CSS_ED2026_04, fr.pf.core::CSS_D553_1_CSS_ED2026_06,
        fr.pf.core::CSS_D553_1_PREV)
rule ChargesConnues(p: fr.pf.core::Personne, montant: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "Charges de logement connues retenues";
    label en unofficial "Known housing charges kept";
    when charges_logement_c(p, montant);
    then charges_retenues(p, montant);
}

@source(fr.pf.core::CSS_D553_1, fr.pf.core::CSS_D553_1_CSS_ED2022_02,
        fr.pf.core::CSS_D553_1_CSS_ED2022_03, fr.pf.core::CSS_D553_1_CSS_ED2022_09,
