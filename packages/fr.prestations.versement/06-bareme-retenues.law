        fr.pf.core::CSS_D553_1_CSS_ED2026_04, fr.pf.core::CSS_D553_1_CSS_ED2026_06,
        fr.pf.core::CSS_D553_1_PREV)
rule PrelevementMensuelDeclare(p: fr.pf.core::Personne, montant: Money) strict {
    effective [@2023-01-01, infinity);
    label fr official "Barème revalorisé non épinglé: le prélèvement mensuel est celui appliqué par la caisse";
    label en unofficial "Revalorised scale unpinned: the monthly levy is the one applied by the fund";
    when prelevement_mensuel_declare(p, montant);
    then prelevement_mensuel(p, montant);
}

