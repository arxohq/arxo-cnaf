rule PrelevementsSaisieAlimentaire(p: fr.pf.core::Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "Cas saisissable alimentaire: la saisie L. 553-4 suit le barème D. 553-1/2";
    label en unofficial "Seizable maintenance case: the L. 553-4 seizure follows the D. 553-1/2 scale";
    when fr.pf.core::saisie_alimentaire_possible(p);
    then prelevements_saisie_bareme(p);
