rule PartsIsole(p: fr.pf.core::Personne, enfants: Integer) strict {
    effective [@2021-01-01, infinity);
    label fr official "Personne seule: 1,5 part plus 0,5 par enfant";
    label en unofficial "Single person: 1.5 parts plus 0.5 per child";
    when personne_seule(p) and nb_enfants_charge(p, enfants);
    then parts_famille_n(p, parts_isole(enfants));
}

