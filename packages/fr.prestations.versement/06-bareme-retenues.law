        fr.pf.core::CSS_D553_1_PREV)
rule PrelevementTranche4(p: fr.pf.core::Personne, x: Money) strict {
    effective [@2021-01-01, @2023-01-01);
    label fr official "Pondéré supérieur à 691 euros: 210,85 euros plus 60 % de la tranche";
    label en unofficial "Weighted income above EUR 691: EUR 210.85 plus 60% of the band";
    when revenu_pondere(p, x) and x > Tranche691;
    then prelevement_mensuel(p, prelevement_tranche4(x));
}

// D-42 BOUNDARY (B-VERS-D5531-REVALO): the pinned D. 553-1 III still
// orders a monthly levy after 2022, but its revalorised euro values are
// not pinned; the levy the fund applies is taken as stated. The window
// starts where the pinned tranche rules end, so the two never overlap.

@source(fr.pf.core::CSS_D553_1, fr.pf.core::CSS_D553_1_CSS_ED2022_02,
        fr.pf.core::CSS_D553_1_CSS_ED2022_03, fr.pf.core::CSS_D553_1_CSS_ED2022_09,
        fr.pf.core::CSS_D553_1_CSS_ED2023_07, fr.pf.core::CSS_D553_1_CSS_ED2024_01,
