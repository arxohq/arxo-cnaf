        fr.pf.core::CSS_R553_1_CSS_ED2025_02, fr.pf.core::CSS_R553_1_CSS_ED2025_09,
        fr.pf.core::CSS_R553_1_CSS_ED2025_12, fr.pf.core::CSS_R553_1_CSS_ED2026_01,
        fr.pf.core::CSS_R553_1_CSS_ED2026_04, fr.pf.core::CSS_R553_1_CSS_ED2026_06)
rule ReglementMensuel(p: fr.pf.core::Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "Le règlement des prestations familiales a lieu mensuellement";
    label en unofficial "Family benefits are settled monthly";
    when fr.pf.core::allocataire(p);
    then reglement_mensuel(p);
}

@source(fr.pf.core::CSS_R553_1, fr.pf.core::CSS_R553_1_CSS_ED2021_05,
