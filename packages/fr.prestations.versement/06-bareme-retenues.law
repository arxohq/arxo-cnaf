relation reglement_mensuel(p: fr.pf.core::Personne) kind institutional {
    key(p);
    label fr official "le règlement des prestations a lieu mensuellement (R. 553-1 al. 1)";
    label en unofficial "benefits are settled monthly (R. 553-1 para. 1)";
