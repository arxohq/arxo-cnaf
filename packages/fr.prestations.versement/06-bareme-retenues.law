        fr.pf.core::CSS_D553_1_PREV)
rule PrelevementTranche2(p: fr.pf.core::Personne, x: Money) strict {
    effective [@2021-01-01, @2023-01-01);
    label fr official "Pondéré de 346 à 516 euros: 73,50 euros plus 35 % de la tranche";
    label en unofficial "Weighted income EUR 346-516: EUR 73.50 plus 35% of the band";
    when revenu_pondere(p, x) and x >= Tranche346 and x <= Tranche516;
    then prelevement_mensuel(p, prelevement_tranche2(x));
}

@source(fr.pf.core::CSS_D553_1, fr.pf.core::CSS_D553_1_CSS_ED2022_02,
        fr.pf.core::CSS_D553_1_CSS_ED2022_03, fr.pf.core::CSS_D553_1_CSS_ED2022_09,
        fr.pf.core::CSS_D553_1_CSS_ED2023_07, fr.pf.core::CSS_D553_1_CSS_ED2024_01,
        fr.pf.core::CSS_D553_1_CSS_ED2025_02, fr.pf.core::CSS_D553_1_CSS_ED2025_09,
        fr.pf.core::CSS_D553_1_CSS_ED2025_12, fr.pf.core::CSS_D553_1_CSS_ED2026_01,
        fr.pf.core::CSS_D553_1_CSS_ED2026_04, fr.pf.core::CSS_D553_1_CSS_ED2026_06,
        fr.pf.core::CSS_D553_1_PREV)
rule PrelevementTranche3(p: fr.pf.core::Personne, x: Money) strict {
    effective [@2021-01-01, @2023-01-01);
    label fr official "Pondéré de 517 à 690 euros: 133 euros plus 45 % de la tranche";
    label en unofficial "Weighted income EUR 517-690: EUR 133 plus 45% of the band";
    when revenu_pondere(p, x) and x >= Tranche517 and x <= Tranche690;
    then prelevement_mensuel(p, prelevement_tranche3(x));
}

