        fr.pf.core::CSS_D553_4_CSS_ED2026_04, fr.pf.core::CSS_D553_4_CSS_ED2026_06)
rule PrelevementTiers(o: fr.pf.core::Organisme, p: fr.pf.core::Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "Indu sur prestation en tiers payant toujours à échoir: la retenue peut être opérée prioritairement sur les prestations versées directement à l'allocataire";
    label en unofficial "Overpayment on a still-payable third-party-paid benefit: the levy may be taken first from benefits paid directly to the allocataire";
    when indu_source_tiers_payant_a_echoir(p) and fr.pf.core::organisme_debiteur_pf(o, p);
    then liberty PrioriteDirectSourceTiersPayant {
        holder o;
        action versement_direct_prioritaire_action(o, p);
        window [@2021-01-01, infinity);
    };
}

