rule PrestationsTermeEchu(p: fr.pf.core::Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "Prestations payables à terme échu à la date fixée par arrêté";
    label en unofficial "Benefits payable in arrears on the arrete date";
    when fr.pf.core::allocataire(p);
    then prestations_terme_echu(p);
}

@source(fr.pf.core::CSS_R553_1, fr.pf.core::CSS_R553_1_CSS_ED2021_05,
        fr.pf.core::CSS_R553_1_CSS_ED2021_11, fr.pf.core::CSS_R553_1_CSS_ED2021_12,
