        fr.pf.core::CSS_D553_1_CSS_ED2026_04, fr.pf.core::CSS_D553_1_CSS_ED2026_06,
        fr.pf.core::CSS_D553_1_PREV)
rule Delai4MoisExpireConstate(p: fr.pf.core::Personne, depart: Date, date: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "Délai de quatre mois expiré: appréciation à l'échéance ou après";
    label en unofficial "Four-month period expired: appreciation at or after expiry";
    when delai_4_mois_depart_le(p, depart) and date_appreciation_revenus(p, date)
        and date >= add_calendar_period(depart, 4 calendar_month);
    then delai_4_mois_expire(p);
}

@source(fr.pf.core::CSS_D553_1, fr.pf.core::CSS_D553_1_CSS_ED2022_02,
        fr.pf.core::CSS_D553_1_CSS_ED2022_03, fr.pf.core::CSS_D553_1_CSS_ED2022_09,
