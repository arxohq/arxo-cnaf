        fr.pf.core::CSS_D553_1_CSS_ED2025_12, fr.pf.core::CSS_D553_1_CSS_ED2026_01,
        fr.pf.core::CSS_D553_1_CSS_ED2026_04, fr.pf.core::CSS_D553_1_CSS_ED2026_06,
        fr.pf.core::CSS_D553_1_PREV)
rule PondTrimestrielConnu(p: fr.pf.core::Personne, montant: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "Droit trimestriel, informations trimestrielles toujours inconnues, déclaration non reçue: quatre mois sur les dernières ressources connues";
    label en unofficial "Quarterly right, quarterly information still unknown, declaration not received: four months on the last known resources";
    when droit_trimestriel_ouvert(p) and pond_trimestriel_connu(p, montant)
        and ressources_trimestrielles_inconnues(p) and declaration_montant_revenus_non_recue(p)
        and delai_4_mois_en_cours(p);
    then revenu_pondere(p, montant);
}

@source(fr.pf.core::CSS_D553_1, fr.pf.core::CSS_D553_1_CSS_ED2022_02,
        fr.pf.core::CSS_D553_1_CSS_ED2022_03, fr.pf.core::CSS_D553_1_CSS_ED2022_09,
        fr.pf.core::CSS_D553_1_CSS_ED2023_07, fr.pf.core::CSS_D553_1_CSS_ED2024_01,
        fr.pf.core::CSS_D553_1_CSS_ED2025_02, fr.pf.core::CSS_D553_1_CSS_ED2025_09,
        fr.pf.core::CSS_D553_1_CSS_ED2025_12, fr.pf.core::CSS_D553_1_CSS_ED2026_01,
        fr.pf.core::CSS_D553_1_CSS_ED2026_04, fr.pf.core::CSS_D553_1_CSS_ED2026_06,
        fr.pf.core::CSS_D553_1_PREV)
rule RevenuReputeApres4Mois(p: fr.pf.core::Personne) strict {
    effective [@2021-01-01, @2023-01-01);
    label fr official "Droit trimestriel après quatre mois, informations toujours inconnues, déclaration non reçue: pondéré réputé de 1 096 euros";
    label en unofficial "Quarterly right after four months, information still unknown, declaration not received: deemed weighted income of EUR 1,096";
    when droit_trimestriel_ouvert(p) and delai_4_mois_expire(p)
        and ressources_trimestrielles_inconnues(p) and declaration_montant_revenus_non_recue(p);
    then revenu_pondere(p, RevenuRepute);
}

@source(fr.pf.core::CSS_D553_1, fr.pf.core::CSS_D553_1_CSS_ED2022_02,
        fr.pf.core::CSS_D553_1_CSS_ED2022_03, fr.pf.core::CSS_D553_1_CSS_ED2022_09,
        fr.pf.core::CSS_D553_1_CSS_ED2023_07, fr.pf.core::CSS_D553_1_CSS_ED2024_01,
        fr.pf.core::CSS_D553_1_CSS_ED2025_02, fr.pf.core::CSS_D553_1_CSS_ED2025_09,
        fr.pf.core::CSS_D553_1_CSS_ED2025_12, fr.pf.core::CSS_D553_1_CSS_ED2026_01,
        fr.pf.core::CSS_D553_1_CSS_ED2026_04, fr.pf.core::CSS_D553_1_CSS_ED2026_06,
        fr.pf.core::CSS_D553_1_PREV)
rule InformerBases(o: fr.pf.core::Organisme, p: fr.pf.core::Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "L'allocataire aux ressources inconnues, aux ressources trimestrielles inconnues ou aux charges de logement inconnues (forfait 25 %) est informé des bases du recouvrement";
    label en unofficial "The allocataire with unknown resources, unknown quarterly resources or unknown housing charges (25% allowance) is informed of the recovery bases";
    when (ressources_inconnues(p) or charges_logement_inconnues(p) or ressources_trimestrielles_inconnues(p)) and fr.pf.core::organisme_debiteur_pf(o, p);
    then duty InformerBasesRecouvrement {
        bearer o;
        beneficiary p;
        maintain bases_recouvrement_communiquees(o, p) during [@2021-01-01, infinity);
    };
}

@source(fr.pf.core::CSS_D553_1, fr.pf.core::CSS_D553_1_CSS_ED2022_02,
        fr.pf.core::CSS_D553_1_CSS_ED2022_03, fr.pf.core::CSS_D553_1_CSS_ED2022_09,
        fr.pf.core::CSS_D553_1_CSS_ED2023_07, fr.pf.core::CSS_D553_1_CSS_ED2024_01,
        fr.pf.core::CSS_D553_1_CSS_ED2025_02, fr.pf.core::CSS_D553_1_CSS_ED2025_09,
        fr.pf.core::CSS_D553_1_CSS_ED2025_12, fr.pf.core::CSS_D553_1_CSS_ED2026_01,
        fr.pf.core::CSS_D553_1_CSS_ED2026_04, fr.pf.core::CSS_D553_1_CSS_ED2026_06,
        fr.pf.core::CSS_D553_1_PREV)
rule PrelevementForfait(p: fr.pf.core::Personne, x: Money) strict {
    effective [@2021-01-01, @2023-01-01);
    label fr official "Pondéré inférieur à 231 euros: retenue forfaitaire de 45 euros";
    label en unofficial "Weighted income below EUR 231: EUR 45 flat levy";
    when revenu_pondere(p, x) and x < Tranche231;
    then prelevement_mensuel(p, ForfaitPrelevement);
}

@source(fr.pf.core::CSS_D553_1, fr.pf.core::CSS_D553_1_CSS_ED2022_02,
        fr.pf.core::CSS_D553_1_CSS_ED2022_03, fr.pf.core::CSS_D553_1_CSS_ED2022_09,
        fr.pf.core::CSS_D553_1_CSS_ED2023_07, fr.pf.core::CSS_D553_1_CSS_ED2024_01,
        fr.pf.core::CSS_D553_1_CSS_ED2025_02, fr.pf.core::CSS_D553_1_CSS_ED2025_09,
        fr.pf.core::CSS_D553_1_CSS_ED2025_12, fr.pf.core::CSS_D553_1_CSS_ED2026_01,
        fr.pf.core::CSS_D553_1_CSS_ED2026_04, fr.pf.core::CSS_D553_1_CSS_ED2026_06,
        fr.pf.core::CSS_D553_1_PREV)
rule PrelevementTranche1(p: fr.pf.core::Personne, x: Money) strict {
    effective [@2021-01-01, @2023-01-01);
    label fr official "Pondéré de 231 à 345 euros: 45 euros plus 25 % de la tranche";
    label en unofficial "Weighted income EUR 231-345: EUR 45 plus 25% of the band";
    when revenu_pondere(p, x) and x >= Tranche231 and x <= Tranche345;
    then prelevement_mensuel(p, prelevement_tranche1(x));
}

@source(fr.pf.core::CSS_D553_1, fr.pf.core::CSS_D553_1_CSS_ED2022_02,
