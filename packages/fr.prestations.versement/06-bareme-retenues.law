        fr.pf.core::CSS_D553_2_CSS_ED2026_04, fr.pf.core::CSS_D553_2_CSS_ED2026_06)
rule NouvellesBasesHausse(p: fr.pf.core::Personne, ancien: Money, nouveau: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "Mensualité supérieure d'au moins 20 %: recouvrement sur les nouvelles bases";
    label en unofficial "Instalment at least 20% higher: recovery on the new bases";
    when nouveau_calcul_requis(p) and mensualite_precedente(p, ancien)
        and prelevement_mensuel(p, nouveau) and nouveau >= seuil_hausse_20(ancien);
    then recouvrement_nouvelles_bases(p);
}

