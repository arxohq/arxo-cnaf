        fr.pf.core::CSS_D553_4_CSS_ED2022_01, fr.pf.core::CSS_D553_4_CSS_ED2022_02,
        fr.pf.core::CSS_D553_4_CSS_ED2022_03, fr.pf.core::CSS_D553_4_CSS_ED2022_09,
        fr.pf.core::CSS_D553_4_CSS_ED2023_07, fr.pf.core::CSS_D553_4_CSS_ED2024_01,
        fr.pf.core::CSS_D553_4_CSS_ED2025_02, fr.pf.core::CSS_D553_4_CSS_ED2025_09,
        fr.pf.core::CSS_D553_4_CSS_ED2025_12, fr.pf.core::CSS_D553_4_CSS_ED2026_01,
        fr.pf.core::CSS_D553_4_CSS_ED2026_04, fr.pf.core::CSS_D553_4_CSS_ED2026_06)
rule InduOrdreEgaliteMontant(a: Indu, b: Indu, p: fr.pf.core::Personne, d: Date, ma: Money, mb: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "Indus constatés à la même date: l'indu au montant le plus faible se recouvre en priorité";
    label en unofficial "Overpayments established on the same date: the smallest-amount overpayment recovers first";
    when indus_multiples(p) and indu_constate_le(a, p, d, ma) and indu_constate_le(b, p, d, mb)
        and ma < mb;
    then indu_recouvre_avant(a, b, p);
}

// D-42 (08.10.2026): no transitive closure rule. InduOrdreAnciennete and
// InduOrdreEgaliteMontant compare EVERY pair directly (date, then amount at
// equal dates), so the order is already total and transitive; a recursive
// InduOrdreTransitif made the program non-stratifiable (LDC-E4102, §110/§191).

@source(fr.pf.core::CSS_D553_4, fr.pf.core::CSS_D553_4_CSS_ED2021_05,
        fr.pf.core::CSS_D553_4_CSS_ED2021_11, fr.pf.core::CSS_D553_4_CSS_ED2021_12,
        fr.pf.core::CSS_D553_4_CSS_ED2022_01, fr.pf.core::CSS_D553_4_CSS_ED2022_02,
        fr.pf.core::CSS_D553_4_CSS_ED2022_03, fr.pf.core::CSS_D553_4_CSS_ED2022_09,
        fr.pf.core::CSS_D553_4_CSS_ED2023_07, fr.pf.core::CSS_D553_4_CSS_ED2024_01,
        fr.pf.core::CSS_D553_4_CSS_ED2025_02, fr.pf.core::CSS_D553_4_CSS_ED2025_09,
        fr.pf.core::CSS_D553_4_CSS_ED2025_12, fr.pf.core::CSS_D553_4_CSS_ED2026_01,
        fr.pf.core::CSS_D553_4_CSS_ED2026_04, fr.pf.core::CSS_D553_4_CSS_ED2026_06)
rule InduEgaliteParfaite(a: Indu, b: Indu, p: fr.pf.core::Personne, d: Date, m: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "Indus distincts à même date et même montant: ordre source silencieux";
    label en unofficial "Distinct overpayments on the same date for the same amount: source order silent";
    when indus_multiples(p) and indu_constate_le(a, p, d, m) and indu_constate_le(b, p, d, m)
        and a != b;
    then indu_egalite_parfaite(a, b, p);
}

@source(fr.pf.core::CSS_D553_4, fr.pf.core::CSS_D553_4_CSS_ED2021_05,
        fr.pf.core::CSS_D553_4_CSS_ED2021_11, fr.pf.core::CSS_D553_4_CSS_ED2021_12,
        fr.pf.core::CSS_D553_4_CSS_ED2022_01, fr.pf.core::CSS_D553_4_CSS_ED2022_02,
        fr.pf.core::CSS_D553_4_CSS_ED2022_03, fr.pf.core::CSS_D553_4_CSS_ED2022_09,
        fr.pf.core::CSS_D553_4_CSS_ED2023_07, fr.pf.core::CSS_D553_4_CSS_ED2024_01,
        fr.pf.core::CSS_D553_4_CSS_ED2025_02, fr.pf.core::CSS_D553_4_CSS_ED2025_09,
        fr.pf.core::CSS_D553_4_CSS_ED2025_12, fr.pf.core::CSS_D553_4_CSS_ED2026_01,
        fr.pf.core::CSS_D553_4_CSS_ED2026_04, fr.pf.core::CSS_D553_4_CSS_ED2026_06)
rule InduBloqueParAnterieur(a: Indu, b: Indu, p: fr.pf.core::Personne, sa: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "Indu précédé d'un indu non éteint: il n'est pas premier";
    label en unofficial "Overpayment preceded by a non-extinguished overpayment: it is not first";
    when indu_recouvre_avant(a, b, p) and indu_solde_restant(a, p, sa)
        and sa > ZeroSoldeIndu;
    then indu_bloque_par_anterieur(b, p);
}

@source(fr.pf.core::CSS_D553_4, fr.pf.core::CSS_D553_4_CSS_ED2021_05,
        fr.pf.core::CSS_D553_4_CSS_ED2021_11, fr.pf.core::CSS_D553_4_CSS_ED2021_12,
        fr.pf.core::CSS_D553_4_CSS_ED2022_01, fr.pf.core::CSS_D553_4_CSS_ED2022_02,
        fr.pf.core::CSS_D553_4_CSS_ED2022_03, fr.pf.core::CSS_D553_4_CSS_ED2022_09,
        fr.pf.core::CSS_D553_4_CSS_ED2023_07, fr.pf.core::CSS_D553_4_CSS_ED2024_01,
        fr.pf.core::CSS_D553_4_CSS_ED2025_02, fr.pf.core::CSS_D553_4_CSS_ED2025_09,
        fr.pf.core::CSS_D553_4_CSS_ED2025_12, fr.pf.core::CSS_D553_4_CSS_ED2026_01,
        fr.pf.core::CSS_D553_4_CSS_ED2026_04, fr.pf.core::CSS_D553_4_CSS_ED2026_06)
rule InduConcurrentEgaliteParfaite(i: Indu, j: Indu, p: fr.pf.core::Personne, sj: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "Indu avec concurrent en égalité parfaite non éteint: ordre indéterminé";
    label en unofficial "Overpayment with a non-extinguished perfect-tie competitor: order undetermined";
    when indu_egalite_parfaite(i, j, p) and indu_solde_restant(j, p, sj)
        and sj > ZeroSoldeIndu;
    then indu_concurrent_egalite_parfaite(i, p);
}

@source(fr.pf.core::CSS_D553_4, fr.pf.core::CSS_D553_4_CSS_ED2021_05,
        fr.pf.core::CSS_D553_4_CSS_ED2021_11, fr.pf.core::CSS_D553_4_CSS_ED2021_12,
        fr.pf.core::CSS_D553_4_CSS_ED2022_01, fr.pf.core::CSS_D553_4_CSS_ED2022_02,
        fr.pf.core::CSS_D553_4_CSS_ED2022_03, fr.pf.core::CSS_D553_4_CSS_ED2022_09,
        fr.pf.core::CSS_D553_4_CSS_ED2023_07, fr.pf.core::CSS_D553_4_CSS_ED2024_01,
        fr.pf.core::CSS_D553_4_CSS_ED2025_02, fr.pf.core::CSS_D553_4_CSS_ED2025_09,
        fr.pf.core::CSS_D553_4_CSS_ED2025_12, fr.pf.core::CSS_D553_4_CSS_ED2026_01,
        fr.pf.core::CSS_D553_4_CSS_ED2026_04, fr.pf.core::CSS_D553_4_CSS_ED2026_06)
rule InduPremierNonEteint(i: Indu, p: fr.pf.core::Personne, si: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "Premier indu non éteint du registre complet, sans égalité parfaite";
    label en unofficial "First non-extinguished overpayment of the complete ledger, without perfect tie";
    when indus_multiples(p) and registre_indus_complet(p)
        and indu_solde_restant(i, p, si) and si > ZeroSoldeIndu
        and not_known(indu_bloque_par_anterieur(i, p))
        and not_known(indu_concurrent_egalite_parfaite(i, p));
    then indu_premier_non_eteint(i, p);
}

// D-42 (08.10.2026): the first indu in the order has no predecessor, so
// its anterior total is the empty sum, 0 EUR by D. 553-4 al. 3 itself
// ("par ordre d'ancienneté": nothing is recovered before it). The empty
// policy is explicit (§59); without it the oldest indu got EMPTY_AGGREGATE.

@source(fr.pf.core::CSS_D553_4, fr.pf.core::CSS_D553_4_CSS_ED2021_05,
        fr.pf.core::CSS_D553_4_CSS_ED2021_11, fr.pf.core::CSS_D553_4_CSS_ED2021_12,
        fr.pf.core::CSS_D553_4_CSS_ED2022_01, fr.pf.core::CSS_D553_4_CSS_ED2022_02,
        fr.pf.core::CSS_D553_4_CSS_ED2022_03, fr.pf.core::CSS_D553_4_CSS_ED2022_09,
        fr.pf.core::CSS_D553_4_CSS_ED2023_07, fr.pf.core::CSS_D553_4_CSS_ED2024_01,
        fr.pf.core::CSS_D553_4_CSS_ED2025_02, fr.pf.core::CSS_D553_4_CSS_ED2025_09,
        fr.pf.core::CSS_D553_4_CSS_ED2025_12, fr.pf.core::CSS_D553_4_CSS_ED2026_01,
        fr.pf.core::CSS_D553_4_CSS_ED2026_04, fr.pf.core::CSS_D553_4_CSS_ED2026_06)
rule InduTotalAnterieur(i: Indu, p: fr.pf.core::Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "Total antérieur: somme des soldes des indus précédant i dans l'ordre";
    label en unofficial "Anterior total: sum of the balances of the overpayments preceding i in the order";
    when indus_multiples(p) and registre_indus_complet(p) and indu_solde_restant(i, p, _);
    then indu_total_anterieur(i, p, sum(collect all m: Money, a: Indu where indu_recouvre_avant(a, i, p) and indu_solde_restant(a, p, m), empty: 0.00 EUR));
}

@source(fr.pf.core::CSS_D553_4, fr.pf.core::CSS_D553_4_CSS_ED2021_05,
        fr.pf.core::CSS_D553_4_CSS_ED2021_11, fr.pf.core::CSS_D553_4_CSS_ED2021_12,
        fr.pf.core::CSS_D553_4_CSS_ED2022_01, fr.pf.core::CSS_D553_4_CSS_ED2022_02,
        fr.pf.core::CSS_D553_4_CSS_ED2022_03, fr.pf.core::CSS_D553_4_CSS_ED2022_09,
        fr.pf.core::CSS_D553_4_CSS_ED2023_07, fr.pf.core::CSS_D553_4_CSS_ED2024_01,
        fr.pf.core::CSS_D553_4_CSS_ED2025_02, fr.pf.core::CSS_D553_4_CSS_ED2025_09,
        fr.pf.core::CSS_D553_4_CSS_ED2025_12, fr.pf.core::CSS_D553_4_CSS_ED2026_01,
        fr.pf.core::CSS_D553_4_CSS_ED2026_04, fr.pf.core::CSS_D553_4_CSS_ED2026_06)
rule RetenueAffecteeMontant(i: Indu, p: fr.pf.core::Personne, retenue: Money, anterieur: Money, si: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "Retenue unique répartie dans l'ordre, plafonnée à chaque solde restant, reliquat reporté";
    label en unofficial "Single levy shared in order, capped at each remaining balance, remainder carried";
    when indus_multiples(p) and retenue_unique_indus_multiples(p) and registre_indus_complet(p)
        and prelevement_mensuel(p, retenue) and indu_solde_restant(i, p, si)
        and indu_total_anterieur(i, p, anterieur)
        and not_known(indu_concurrent_egalite_parfaite(i, p));
    then retenue_affectee_montant(i, p, allocation_indu(retenue, anterieur, si));
}

@source(fr.pf.core::CSS_D553_4, fr.pf.core::CSS_D553_4_CSS_ED2021_05,
        fr.pf.core::CSS_D553_4_CSS_ED2021_11, fr.pf.core::CSS_D553_4_CSS_ED2021_12,
        fr.pf.core::CSS_D553_4_CSS_ED2022_01, fr.pf.core::CSS_D553_4_CSS_ED2022_02,
        fr.pf.core::CSS_D553_4_CSS_ED2022_03, fr.pf.core::CSS_D553_4_CSS_ED2022_09,
        fr.pf.core::CSS_D553_4_CSS_ED2023_07, fr.pf.core::CSS_D553_4_CSS_ED2024_01,
        fr.pf.core::CSS_D553_4_CSS_ED2025_02, fr.pf.core::CSS_D553_4_CSS_ED2025_09,
        fr.pf.core::CSS_D553_4_CSS_ED2025_12, fr.pf.core::CSS_D553_4_CSS_ED2026_01,
        fr.pf.core::CSS_D553_4_CSS_ED2026_04, fr.pf.core::CSS_D553_4_CSS_ED2026_06)
rule RetenueAffecteeSiAllocation(i: Indu, p: fr.pf.core::Personne, m: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "Indu destinataire de la retenue unique: part positive allouée";
    label en unofficial "Overpayment receiving the single levy: positive share allocated";
    when retenue_affectee_montant(i, p, m) and m > ZeroSoldeIndu;
    then retenue_affectee_indu(i, p);
}

@source(fr.pf.core::CSS_D553_5, fr.pf.core::CSS_D553_5_CSS_ED2021_05,
        fr.pf.core::CSS_D553_5_CSS_ED2021_11, fr.pf.core::CSS_D553_5_CSS_ED2021_12,
