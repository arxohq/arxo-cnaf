rule NouvellesBasesBaisse(p: fr.pf.core::Personne, ancien: Money, nouveau: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "Mensualité inférieure d'au moins 20 %: recouvrement sur les nouvelles bases";
    label en unofficial "Instalment at least 20% lower: recovery on the new bases";
    when nouveau_calcul_requis(p) and mensualite_precedente(p, ancien)
        and prelevement_mensuel(p, nouveau) and nouveau <= seuil_baisse_20(ancien);
    then recouvrement_nouvelles_bases(p);
}

