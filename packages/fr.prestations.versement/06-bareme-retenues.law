        fr.pf.core::CSS_D553_1_CSS_ED2025_12, fr.pf.core::CSS_D553_1_CSS_ED2026_01,
        fr.pf.core::CSS_D553_1_CSS_ED2026_04, fr.pf.core::CSS_D553_1_CSS_ED2026_06,
        fr.pf.core::CSS_D553_1_PREV)
rule ChargesInconnues25(p: fr.pf.core::Personne, revenus: Money, prestations: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "Charges inconnues: forfait de 25 % des revenus et des prestations";
    label en unofficial "Unknown charges: 25% of income and benefits";
    when charges_logement_inconnues(p) and revenus_mensuels_a(p, revenus)
        and prestations_mensuelles_b(p, prestations);
    then charges_retenues(p, charges_defaut_25(revenus, prestations));
}

@source(fr.pf.core::CSS_D553_1, fr.pf.core::CSS_D553_1_CSS_ED2022_02,
        fr.pf.core::CSS_D553_1_CSS_ED2022_03, fr.pf.core::CSS_D553_1_CSS_ED2022_09,
