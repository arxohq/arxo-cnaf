        fr.pf.core::CSS_D553_1_CSS_ED2026_04, fr.pf.core::CSS_D553_1_CSS_ED2026_06,
        fr.pf.core::CSS_D553_1_PREV)
rule RevenuMensuelR(p: fr.pf.core::Personne, revenus: Money, prestations: Money, charges: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "Revenu mensuel R: revenus et prestations diminués des charges de logement";
    label en unofficial "Monthly income R: income and benefits minus housing charges";
    when revenus_mensuels_a(p, revenus) and prestations_mensuelles_b(p, prestations)
        and charges_retenues(p, charges);
    then revenu_mensuel_r(p, revenu_total_r(revenus, prestations, charges));
}

