        fr.pf.core::CSS_D553_1_PREV)
rule RevenuRepute1096(p: fr.pf.core::Personne) strict {
    effective [@2021-01-01, @2023-01-01);
    label fr official "Ressources inconnues hors droit trimestriel, déclaration non reçue: pondéré réputé de 1 096 euros";
    label en unofficial "Unknown resources outside quarterly rights, declaration not received: deemed weighted income of EUR 1,096";
    when ressources_inconnues(p) and not droit_trimestriel_ouvert(p)
        and declaration_montant_revenus_non_recue(p);
    then revenu_pondere(p, RevenuRepute);
}

// D-42 (08.10.2026): calendar-month step of the four-month clock
// (D. 553-1 III al. 6). add_calendar_period reads the context policy
// (§86, errata E-0029: include_end true, no_roll); scenarios on this
// clock bind BAREME_DELAI_MOIS in their context.
deadline policy BAREME_DELAI_MOIS {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}

@source(fr.pf.core::CSS_D553_1, fr.pf.core::CSS_D553_1_CSS_ED2022_02,
