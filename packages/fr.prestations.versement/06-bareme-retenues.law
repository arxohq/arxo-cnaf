rule RevenuPondereCalculeOrganisme(p: fr.pf.core::Personne, montant: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "Revenu mensuel pondéré retenu tel que calculé par l'organisme (formule du II non épinglée)";
    label en unofficial "Weighted monthly income kept as computed by the body (II formula unpinned)";
    when revenu_pondere_calcule_organisme(p, montant);
    then revenu_pondere(p, montant);
}

@source(fr.pf.core::CSS_D553_1, fr.pf.core::CSS_D553_1_CSS_ED2022_02,
