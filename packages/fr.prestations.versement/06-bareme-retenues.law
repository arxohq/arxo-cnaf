        fr.pf.core::CSS_D553_5_CSS_ED2023_07, fr.pf.core::CSS_D553_5_CSS_ED2024_01,
        fr.pf.core::CSS_D553_5_CSS_ED2025_02, fr.pf.core::CSS_D553_5_CSS_ED2025_09,
        fr.pf.core::CSS_D553_5_CSS_ED2025_12, fr.pf.core::CSS_D553_5_CSS_ED2026_01,
        fr.pf.core::CSS_D553_5_CSS_ED2026_04, fr.pf.core::CSS_D553_5_CSS_ED2026_06)
rule TauxMajorationFixe50(p: fr.pf.core::Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "Indu frauduleux: le taux de majoration est fixé à 50 %";
    label en unofficial "Fraudulent overpayment: the uplift rate is fixed at 50%";
    when fr.pf.core::indu_frauduleux(p);
    then taux_majoration_fraude_fixee(p, TauxMajorationFraude50);
}

@source(fr.pf.core::CSS_R553_1, fr.pf.core::CSS_R553_1_CSS_ED2021_05,
