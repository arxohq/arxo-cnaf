        fr.pf.core::CSS_D553_4_CSS_ED2023_07, fr.pf.core::CSS_D553_4_CSS_ED2024_01,
        fr.pf.core::CSS_D553_4_CSS_ED2025_02, fr.pf.core::CSS_D553_4_CSS_ED2025_09,
        fr.pf.core::CSS_D553_4_CSS_ED2025_12, fr.pf.core::CSS_D553_4_CSS_ED2026_01,
        fr.pf.core::CSS_D553_4_CSS_ED2026_04, fr.pf.core::CSS_D553_4_CSS_ED2026_06)
rule ReportAutresPrestations(p: fr.pf.core::Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "Source épuisée: la retenue est opérée sur les autres prestations servies";
    label en unofficial "Source exhausted: the levy is taken from the other benefits served";
    when prestation_source_cessee_ou_insuffisante(p);
    then retenue_report_autres_prestations(p);
}

@source(fr.pf.core::CSS_D553_4, fr.pf.core::CSS_D553_4_CSS_ED2021_05,
        fr.pf.core::CSS_D553_4_CSS_ED2021_11, fr.pf.core::CSS_D553_4_CSS_ED2021_12,
        fr.pf.core::CSS_D553_4_CSS_ED2022_01, fr.pf.core::CSS_D553_4_CSS_ED2022_02,
        fr.pf.core::CSS_D553_4_CSS_ED2022_03, fr.pf.core::CSS_D553_4_CSS_ED2022_09,
        fr.pf.core::CSS_D553_4_CSS_ED2023_07, fr.pf.core::CSS_D553_4_CSS_ED2024_01,
        fr.pf.core::CSS_D553_4_CSS_ED2025_02, fr.pf.core::CSS_D553_4_CSS_ED2025_09,
        fr.pf.core::CSS_D553_4_CSS_ED2025_12, fr.pf.core::CSS_D553_4_CSS_ED2026_01,
        fr.pf.core::CSS_D553_4_CSS_ED2026_04, fr.pf.core::CSS_D553_4_CSS_ED2026_06)
rule PrioriteDirect(o: fr.pf.core::Organisme, p: fr.pf.core::Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "La retenue reportée peut être opérée prioritairement sur les prestations à versement direct";
    label en unofficial "The carried levy may be taken first from direct-payment benefits";
    when retenue_report_autres_prestations(p) and fr.pf.core::organisme_debiteur_pf(o, p);
    then liberty PrioriteVersementDirect {
        holder o;
        action versement_direct_prioritaire_action(o, p);
        window [@2021-01-01, infinity);
    };
}

@source(fr.pf.core::CSS_D553_4, fr.pf.core::CSS_D553_4_CSS_ED2021_05,
