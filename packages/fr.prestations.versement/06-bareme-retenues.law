        fr.pf.core::CSS_R553_1_CSS_ED2026_04, fr.pf.core::CSS_R553_1_CSS_ED2026_06)
rule CmgPayableDateArrete(p: fr.pf.core::Personne, date: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "Le CMG peut être versé à compter de la date fixée par arrêté";
    label en unofficial "The CMG may be paid from the arrete date";
    when date_paiement_arrete(p, date);
    then cmg_payable_a_compter(p, date);
}

// --- D. 755-2: R. 553-1 and D. 553-1..4 applicable in L. 751-1 departments (D73) ---

relation beneficiaire_departements_l7511(p: fr.pf.core::Personne) kind empirical {
    label fr official "allocataire relevant des départements mentionnés à L. 751-1 (D. 755-2)";
    label en unofficial "allocataire in the L. 751-1 departments (D. 755-2)";
}

relation retenues_dom_applicables(p: fr.pf.core::Personne) kind institutional {
    key(p);
    label fr official "R. 553-1 et D. 553-1 à D. 553-4 applicables dans les départements L. 751-1 (D. 755-2)";
    label en unofficial "R. 553-1 and D. 553-1 to D. 553-4 applicable in the L. 751-1 departments (D. 755-2)";
}

@source(fr.pf.core::CSS_D755_2, fr.pf.core::CSS_D755_2_CSS_ED2021_05,
        fr.pf.core::CSS_D755_2_CSS_ED2021_11, fr.pf.core::CSS_D755_2_CSS_ED2021_12,
        fr.pf.core::CSS_D755_2_CSS_ED2022_01, fr.pf.core::CSS_D755_2_CSS_ED2022_02,
        fr.pf.core::CSS_D755_2_CSS_ED2022_03, fr.pf.core::CSS_D755_2_CSS_ED2022_09,
        fr.pf.core::CSS_D755_2_CSS_ED2023_07, fr.pf.core::CSS_D755_2_CSS_ED2024_01,
        fr.pf.core::CSS_D755_2_CSS_ED2025_02, fr.pf.core::CSS_D755_2_CSS_ED2025_09,
        fr.pf.core::CSS_D755_2_CSS_ED2025_12, fr.pf.core::CSS_D755_2_CSS_ED2026_01,
        fr.pf.core::CSS_D755_2_CSS_ED2026_04, fr.pf.core::CSS_D755_2_CSS_ED2026_06)
rule RetenuesDomApplicables(p: fr.pf.core::Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "DOM L. 751-1: retenues R. 553-1 et barème D. 553-1..4 applicables (D. 755-2)";
    label en unofficial "L. 751-1 DOM: R. 553-1 withholdings and D. 553-1..4 scale applicable (D. 755-2)";
    when beneficiaire_departements_l7511(p);
    then retenues_dom_applicables(p);
}
