// Recovery scale and payment mechanics (D. 553-1 to D. 553-5, R. 553-1):
// the decree bareme behind L. 553-2 withholdings - monthly income R,
// family parts N, organ-stated weighted income, marginal tranches,
// deemed income, 20 % recalculation, seizure referrals, overflow onto
// other benefits, the fixed 50 % fraud uplift, monthly settlement.
//
// Fragments live in fr.pf.core (D-19 pattern: this package holds no
// source rows); all @source anchors below are qualified. Norms stay
// connected: the 50 % fraud uplift (D. 553-5 I) is pinned and
// 04-recouvrement applies it as the fixed x1.50 factor (PC-R07-38; no
// stated uplift input remains). 04 reads this module's
// prelevement_mensuel as the PF levy: pinned tranches up to 2022,
// fund-stated amount from 2023 (D-42, B-VERS-D5531-REVALO).
//
// DEONTIC MAP: computational (institutional statuses) + two organ
// liberties (D. 553-4 direct-payment priority, tiers-payant levy) and
// one organ duty (D. 553-1 information on recovery bases).
//
// INPUT CONTRACTS (extension of the 04 contract):
// - revenus_mensuels_a arrives monthly: the /3 and /12 divisions of
//   I.a are caller-side (the decree names no rounding for them).
// - prestations_mensuelles_b arrives with the I.b exclusions
//   (ARS, birth/adoption premiums and bonuses, moving premiums,
//   removals, loans, back-to-work premiums) already applied.
// - WEIGHTED INCOME (PC-A01, B-VERS-D5531-PONDERE-FORMULE): the pinned
//   D. 553-1 II shows "R", "Ce revenu est pondéré selon la formule :",
//   "N" as separate paragraphs with no operator or expression, so no
//   R/N (or any) weighting formula is computed here. revenu_pondere
//   arrives only as organ-stated (revenu_pondere_calcule_organisme),
//   deemed 1 096 EUR, or last-known quarterly weighted income; R and N
//   stay independently derived and feed no division. The tranche band
//   constructor below applies to that typed retained weighted input.
// - pond_trimestriel_connu arrives as the last-known weighted income;
//   the fund re-runs the same chain on older data.
// - PC-R02-01 gates (D. 553-1 III al. 6): last-known quarterly income
//   and both deemed bases apply only while the current information is
//   still absent (ressources_inconnues / ressources_trimestrielles_
//   inconnues) and the income-amount declaration is not received
//   (declaration_montant_revenus_non_recue); recovery on those bases
//   stops once current information or the declaration arrives. The
//   inform duty covers quarterly-unknown cases too ("Dans ces deux cas,
//   l'organisme ... en informe l'allocataire").
// - PC-R05-02 (D. 553-1 III al. 6): quarterly-right state is explicit
//   (not droit_trimestriel_ouvert for the hors-droit branch, positive
//   for the quarterly branches); the four-month last-known period is a
//   dated clock (delai_4_mois_depart_le + date_appreciation_revenus,
//   en_cours before +4 months, expire at/after). Unknown quarterly state
//   or missing dates yield no weighted income (NEITHER).
// - Tranche values are the pinned 2022 euros; revalorised post-2022
//   values are unpinned (tranches and the 1 096 EUR deeming stop at
//   2023-01-01, boundary B-VERS-D5531-REVALO).
// - The (690, 691] gap is literal: no tranche covers it, no rule fires
//   (boundary B-VERS-D5531-TRANCHE-691, paired scenarios).
// - Multi-indu ordering (PC-R04-03, PC-R05-01): the dated-amount ledger
//   (indu_constate_le + indu_solde_restant) feeds the institutional
//   ordering (oldest first, smallest first on same-date ties, transitive
//   closure); the single monthly retention (prelevement_mensuel) is
//   allocated across indus in that order, capped at each remaining balance
//   with the remainder carried to the next (allocation_indu via
//   indu_total_anterieur). Allocation requires the complete ledger
//   (registre_indus_complet). Same-date same-amount ties have no source
//   order (genuine gap, no allocation for the tied pair).
// - D. 553-5 II (D. 133-2-3 2/3/4) is an external renvoi: no rule.
//
// ENGINE RISK (flagged for reviewer lawref, no-run authoring):
// - parts_isole/parts_menage mix Decimal and Integer (0.5 x count);
//   no corpus precedent for mixed arithmetic was found. If the engine
//   refuses, the fallback is a stated-parts input contract
//   (B-VERS-D5531-PARTS-CALCUL) and these two rules are reworked.
//   (Former Money/Decimal division risk retired with PC-A01: no
//   weighting division is computed anymore.)

language "law.core" version "0.2";
package fr.prestations.versement version "0.1.0";
namespace "urn:fr:corpus:clir:prestations-versement";

use self::{
    Indu,
};

relation revenus_mensuels_a(p: fr.pf.core::Personne, montant: Money) kind empirical {
    key(p);
    label fr official "revenus mensuels du I.a de D. 553-1, divisions par 3 et 12 appliquées (D. 553-1 I.a)";
    label en unofficial "monthly I.a incomes of D. 553-1, /3 and /12 applied (D. 553-1 I.a)";
}

relation prestations_mensuelles_b(p: fr.pf.core::Personne, montant: Money) kind empirical {
    key(p);
    label fr official "prestations du premier mois, exclusions du I.b appliquées (D. 553-1 I.b)";
    label en unofficial "first-month benefits, I.b exclusions applied (D. 553-1 I.b)";
}

relation charges_logement_c(p: fr.pf.core::Personne, montant: Money) kind empirical {
    key(p);
    label fr official "charges de logement retenues du I.c, connues (D. 553-1 I.c)";
    label en unofficial "I.c housing charges kept, known (D. 553-1 I.c)";
}

relation charges_logement_inconnues(p: fr.pf.core::Personne) kind empirical {
    label fr official "charges de logement inconnues: forfait de 25 % (D. 553-1 I.c)";
    label en unofficial "housing charges unknown: 25% allowance (D. 553-1 I.c)";
}

relation charges_retenues(p: fr.pf.core::Personne, montant: Money) kind institutional {
    key(p);
    label fr official "charges de logement retenues (D. 553-1 I.c)";
    label en unofficial "housing charges kept (D. 553-1 I.c)";
}

relation revenu_mensuel_r(p: fr.pf.core::Personne, montant: Money) kind institutional {
    key(p);
    label fr official "revenu mensuel R = a + b - c (D. 553-1 III)";
    label en unofficial "monthly income R = a + b - c (D. 553-1 III)";
}

relation personne_seule(p: fr.pf.core::Personne) kind empirical {
    label fr official "personne seule: 1,5 part (D. 553-1 II)";
    label en unofficial "single person: 1.5 parts (D. 553-1 II)";
}

relation menage(p: fr.pf.core::Personne) kind empirical {
    label fr official "ménage: 2 parts (D. 553-1 II)";
    label en unofficial "household: 2 parts (D. 553-1 II)";
}

relation nb_enfants_charge(p: fr.pf.core::Personne, n: Integer) kind empirical {
    key(p);
    label fr official "nombre d'enfants à charge et assimilés: 0,5 part chacun (D. 553-1 II)";
    label en unofficial "number of dependent and assimilated children: 0.5 parts each (D. 553-1 II)";
}

relation parts_famille_n(p: fr.pf.core::Personne, n: Decimal) kind institutional {
    key(p);
    label fr official "nombre de parts N de la famille (D. 553-1 II)";
    label en unofficial "family parts count N (D. 553-1 II)";
}

relation revenu_pondere(p: fr.pf.core::Personne, montant: Money) kind institutional {
    key(p);
    label fr official "revenu mensuel pondéré du II, formule non épinglée: constaté, réputé ou calculé par l'organisme (D. 553-1 II-III)";
    label en unofficial "weighted monthly income of II, formula unpinned: stated, deemed or organ-computed (D. 553-1 II-III)";
}

relation revenu_pondere_calcule_organisme(p: fr.pf.core::Personne, montant: Money) kind empirical {
    key(p);
    label fr official "revenu mensuel pondéré calculé et attesté par l'organisme débiteur, formule du II non épinglée (entrée constatée — D. 553-1 II)";
    label en unofficial "weighted monthly income computed and stated by the debtor body, II formula unpinned (stated input - D. 553-1 II)";
}

relation ressources_inconnues(p: fr.pf.core::Personne) kind empirical {
    label fr official "ressources inconnues de l'organisme (D. 553-1 III al. 6)";
    label en unofficial "resources unknown to the body (D. 553-1 III para. 6)";
}

relation droit_trimestriel_ouvert(p: fr.pf.core::Personne) kind empirical {
    label fr official "droit trimestriel ouvert (D. 553-1 III al. 6)";
    label en unofficial "quarterly right open (D. 553-1 III para. 6)";
}

relation pond_trimestriel_connu(p: fr.pf.core::Personne, montant: Money) kind empirical {
    key(p);
    label fr official "pondéré des dernières ressources trimestrielles connues (D. 553-1 III al. 6)";
    label en unofficial "weighted income from the last known quarterly resources (D. 553-1 III para. 6)";
}

relation delai_4_mois_depart_le(p: fr.pf.core::Personne, depart: Date) kind empirical {
    key(p);
    label fr official "point de départ du délai de quatre mois sur dernières ressources trimestrielles connues, date attestée (D. 553-1 III al. 6)";
    label en unofficial "start of the four-month last-known-quarterly-resources period, attested date (D. 553-1 III para. 6)";
}

relation date_appreciation_revenus(p: fr.pf.core::Personne, date: Date) kind empirical {
    key(p);
    label fr official "date d'appréciation des revenus pour le calcul du pondéré (D. 553-1 III al. 6)";
    label en unofficial "income appreciation date for the weighted calculation (D. 553-1 III para. 6)";
}

relation delai_4_mois_en_cours(p: fr.pf.core::Personne) kind institutional {
    key(p);
    label fr official "délai de quatre mois sur ressources trimestrielles en cours, date d'appréciation avant échéance (D. 553-1 III al. 6)";
    label en unofficial "four-month quarterly-resources period running, appreciation date before expiry (D. 553-1 III para. 6)";
}

relation delai_4_mois_expire(p: fr.pf.core::Personne) kind institutional {
    key(p);
    label fr official "délai de quatre mois sur ressources trimestrielles expiré, date d'appréciation à échéance ou après (D. 553-1 III al. 6)";
    label en unofficial "four-month last-known-resources period expired, appreciation date at or after expiry (D. 553-1 III para. 6)";
}

relation ressources_trimestrielles_inconnues(p: fr.pf.core::Personne) kind empirical {
    label fr official "informations relatives aux ressources trimestrielles non en possession de l'organisme (D. 553-1 III al. 6)";
    label en unofficial "quarterly resource information not held by the body (D. 553-1 III para. 6)";
}

relation declaration_montant_revenus_non_recue(p: fr.pf.core::Personne) kind empirical {
    label fr official "déclaration du montant des revenus non reçue: le recouvrement est poursuivi sur les bases estimées (D. 553-1 III al. 6)";
    label en unofficial "income-amount declaration not received: recovery continues on the estimated bases (D. 553-1 III para. 6)";
}

relation bases_recouvrement_communiquees(o: fr.pf.core::Organisme, p: fr.pf.core::Personne) kind empirical {
    key(o, p);
    label fr official "l'allocataire est informé des bases du recouvrement (D. 553-1 III al. 6)";
    label en unofficial "the allocataire is informed of the recovery bases (D. 553-1 III para. 6)";
}

relation prelevement_mensuel(p: fr.pf.core::Personne, montant: Money) kind institutional {
    key(p);
    label fr official "montant mensuel du prélèvement sur les prestations (D. 553-1 III)";
    label en unofficial "monthly levy amount on benefits (D. 553-1 III)";
}

// D-42 (08.10.2026), B-VERS-D5531-REVALO input contract: from 2023-01-01
// the revalorised tranche and deeming values are unpinned, so the
// tranche rules stop and the D. 553-1 levy arrives as the Money amount
// the fund applies — the same fund-stated contract as the non-PF levies
// of 04 (retenue_mensuelle_*_declaree, DSS_PENDING). Never a rate: no
// installment x rate product is derived (PC-R07-39).
pub relation prelevement_mensuel_declare(p: fr.pf.core::Personne, montant: Money) kind empirical {
    key(p);
    label fr official "montant mensuel du prélèvement appliqué par la caisse selon le barème D. 553-1 revalorisé (valeurs postérieures à 2022 non épinglées : B-VERS-D5531-REVALO)";
    label en unofficial "monthly levy amount applied by the fund under the revalorised D. 553-1 scale (post-2022 values unpinned: B-VERS-D5531-REVALO)";
}

relation renouvellement_annuel(p: fr.pf.core::Personne) kind empirical {
    label fr official "renouvellement au 1er janvier des droits aux prestations (D. 553-2)";
    label en unofficial "1 January renewal of benefit rights (D. 553-2)";
}

relation changement_situation_ressources(p: fr.pf.core::Personne) kind empirical {
    label fr official "modification de situation ayant une incidence sur les ressources du I.a (D. 553-2)";
    label en unofficial "situation change affecting I.a resources (D. 553-2)";
}

relation changement_droits(p: fr.pf.core::Personne) kind empirical {
    label fr official "modification des droits aux prestations ou de leur montant (D. 553-2)";
    label en unofficial "change in benefit rights or their amount (D. 553-2)";
}

relation nouveau_calcul_requis(p: fr.pf.core::Personne) kind institutional {
    key(p);
    label fr official "nouveau calcul de la mensualité de remboursement requis (D. 553-2)";
    label en unofficial "recalculation of the monthly overpayment instalment required (D. 553-2)";
}

relation mensualite_precedente(p: fr.pf.core::Personne, montant: Money) kind empirical {
    key(p);
    label fr official "mensualité de remboursement précédente (D. 553-2)";
    label en unofficial "previous repayment instalment (D. 553-2)";
}

relation recouvrement_nouvelles_bases(p: fr.pf.core::Personne) kind institutional {
    key(p);
    label fr official "le recouvrement est poursuivi sur les nouvelles bases, écart d'au moins 20 % (D. 553-2)";
    label en unofficial "recovery continues on the new bases, at least 20% apart (D. 553-2)";
}

relation prelevements_saisie_bareme(p: fr.pf.core::Personne) kind institutional {
    key(p);
    label fr official "prélèvements de la saisie L. 553-4 selon D. 553-1/2 (D. 553-3)";
    label en unofficial "L. 553-4 seizure levies under D. 553-1/2 (D. 553-3)";
}

relation prestation_source_cessee_ou_insuffisante(p: fr.pf.core::Personne) kind empirical {
    label fr official "la prestation source de la retenue cesse ou ne suffit plus (D. 553-4)";
    label en unofficial "the levy source benefit ends or no longer covers it (D. 553-4)";
}

relation retenue_report_autres_prestations(p: fr.pf.core::Personne) kind institutional {
    key(p);
    label fr official "la retenue est opérée sur les autres prestations servies (D. 553-4)";
    label en unofficial "the levy is taken from the other benefits served (D. 553-4)";
}

relation versement_direct_prioritaire_action(o: fr.pf.core::Organisme, p: fr.pf.core::Personne) kind empirical {
    key(o, p);
    label fr official "action: opérer prioritairement la retenue sur les prestations à versement direct";
    label en unofficial "action: taking the levy first from direct-payment benefits";
}

relation indu_source_tiers_payant_a_echoir(p: fr.pf.core::Personne) kind empirical {
    key(p);
    label fr official "indu constitué au titre d'une prestation versée en tiers payant et la prestation est toujours à échoir (D. 553-4 al. 2)";
    label en unofficial "overpayment on a third-party-paid benefit that is still payable in future (D. 553-4 para 2)";
}

relation indus_multiples(p: fr.pf.core::Personne) kind empirical {
    label fr official "plusieurs indus en recouvrement (D. 553-4 al. 3)";
    label en unofficial "several overpayments in recovery (D. 553-4 para. 3)";
}

relation retenue_unique_indus_multiples(p: fr.pf.core::Personne) kind institutional {
    key(p);
    label fr official "une seule retenue mensuelle sur les prestations servies (D. 553-4 al. 3)";
    label en unofficial "a single monthly levy on the benefits served (D. 553-4 para. 3)";
}

relation indu_constate_le(i: Indu, p: fr.pf.core::Personne, date: Date, montant: Money) kind empirical {
    key(i);
    label fr official "indu constaté à une date pour un montant, entrée du registre des dettes (D. 553-4 al. 3 « par ordre d'ancienneté », « constatés à la même date », « montant le plus faible »)";
    label en unofficial "overpayment established on a date for an amount, debt-ledger entry (D. 553-4 para. 3 'par ordre d'anciennete', 'constates a la meme date', 'montant le plus faible')";
}

relation indu_solde_restant(i: Indu, p: fr.pf.core::Personne, montant: Money) kind empirical {
    key(i);
    label fr official "solde restant dû sur l'indu, état du registre amont (D. 553-4 al. 3 « jusqu'à l'extinction de chacune des créances »)";
    label en unofficial "remaining balance owed on the overpayment, upstream ledger state (D. 553-4 para. 3 'jusqu'a l'extinction de chacune des creances')";
}

relation indu_recouvre_avant(a: Indu, b: Indu, p: fr.pf.core::Personne) kind institutional {
    key(a, b, p);
    label fr official "l'indu a se recouvre avant l'indu b, ordre d'ancienneté puis montant (D. 553-4 al. 3)";
    label en unofficial "overpayment a recovers before overpayment b, seniority then amount order (D. 553-4 para. 3)";
}

relation registre_indus_complet(p: fr.pf.core::Personne) kind empirical {
    label fr official "le registre des indus est complet pour l'allocataire, aucun indu en recouvrement n'est omis (D. 553-4 al. 3)";
    label en unofficial "the overpayment ledger is complete for the allocataire, no indu in recovery is omitted (D. 553-4 para. 3)";
}

relation indu_egalite_parfaite(a: Indu, b: Indu, p: fr.pf.core::Personne) kind institutional {
    key(a, b, p);
    label fr official "indus distincts constatés à la même date pour le même montant, ordre source silencieux (D. 553-4 al. 3)";
    label en unofficial "distinct overpayments established on the same date for the same amount, source order silent (D. 553-4 para. 3)";
}

relation indu_bloque_par_anterieur(b: Indu, p: fr.pf.core::Personne) kind institutional {
    key(b, p);
    label fr official "l'indu b est précédé d'un indu non éteint, il n'est pas premier (D. 553-4 al. 3)";
    label en unofficial "overpayment b is preceded by a non-extinguished overpayment, it is not first (D. 553-4 para. 3)";
}

relation indu_concurrent_egalite_parfaite(i: Indu, p: fr.pf.core::Personne) kind institutional {
    key(i, p);
    label fr official "l'indu a un concurrent en égalité parfaite non éteint, ordre indéterminé (D. 553-4 al. 3)";
    label en unofficial "the overpayment has a non-extinguished perfect-tie competitor, order undetermined (D. 553-4 para. 3)";
}

relation indu_premier_non_eteint(i: Indu, p: fr.pf.core::Personne) kind institutional {
    key(i, p);
    label fr official "l'indu est le premier non éteint du registre complet, sans égalité parfaite (D. 553-4 al. 3)";
    label en unofficial "the overpayment is the first non-extinguished one of the complete ledger, without perfect tie (D. 553-4 para. 3)";
}

relation indu_total_anterieur(i: Indu, p: fr.pf.core::Personne, total: Money) kind institutional {
    key(i, p);
    label fr official "somme des soldes des indus précédant i dans l'ordre de recouvrement (D. 553-4 al. 3)";
    label en unofficial "sum of the balances of the overpayments preceding i in the recovery order (D. 553-4 para. 3)";
}

relation retenue_affectee_montant(i: Indu, p: fr.pf.core::Personne, montant: Money) kind institutional {
    key(i, p);
    label fr official "part de la retenue mensuelle unique affectée à l'indu, plafonnée au solde restant (D. 553-4 al. 3)";
    label en unofficial "share of the single monthly levy allocated to the overpayment, capped at the remaining balance (D. 553-4 para. 3)";
}

relation retenue_affectee_indu(i: Indu, p: fr.pf.core::Personne) kind institutional {
    key(i, p);
    label fr official "la retenue mensuelle unique est affectée à l'indu, part positive dans l'ordre de recouvrement (D. 553-4 al. 3)";
    label en unofficial "the single monthly levy is allocated to the overpayment, positive share in the recovery order (D. 553-4 para. 3)";
}

const ZeroSoldeIndu: Money = 0.00 EUR {
    label fr official "solde nul: créance éteinte (D. 553-4 al. 3)";
    label en unofficial "zero balance: claim extinguished (D. 553-4 para. 3)";
}

relation taux_majoration_fraude_fixee(p: fr.pf.core::Personne, taux: Decimal) kind institutional {
    key(p);
    label fr official "taux de majoration de la retenue en cas de fraude, fixé à 50 % (D. 553-5 I)";
    label en unofficial "fraud-case levy uplift rate, fixed at 50% (D. 553-5 I)";
