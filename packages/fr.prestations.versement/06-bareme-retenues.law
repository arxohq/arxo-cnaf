rule PrelevementsSaisieFraude(p: fr.pf.core::Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "Indu frauduleux: la saisie autorisée par L. 553-4 I (manoeuvre frauduleuse) suit le barème D. 553-1/2";
    label en unofficial "Fraudulent overpayment: seizure allowed by L. 553-4 I (fraudulent scheme) follows the D. 553-1/2 scale";
    when fr.pf.core::indu_frauduleux(p);
    then prelevements_saisie_bareme(p);
}

