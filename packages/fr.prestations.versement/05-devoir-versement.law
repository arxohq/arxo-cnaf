}

@source(fr.pf.ars::CSS_L543_1, fr.pf.ars::CSS_L543_1_ED2022_01, fr.pf.ars::CSS_L543_1_ED2022_02,
        fr.pf.ars::CSS_L543_3, fr.pf.ars::CSS_L543_3_PRE2022, fr.pf.ars::CSS_L543_3_PRE2022_ED2016_10,
        fr.pf.ars::CSS_L543_3_PRE2022_ED2019_01, fr.pf.ars::CSS_L543_3_PRE2022_ED2022_01,
        fr.pf.ars::CSS_R543_7, fr.pf.ars::CSS_R543_7_ED1990_09, fr.pf.ars::CSS_R543_7_ED1999_06,
        fr.pf.ars::CSS_R543_7_ED2001_12, fr.pf.ars::CSS_R543_7_ED2002_08, fr.pf.ars::CSS_R543_7_ED2004_01,
        fr.pf.ars::CSS_R543_7_ED2008_08, fr.pf.ars::CSS_R543_7_ED2012_06, fr.pf.ars::CSS_R543_7_ED2013_06,
        fr.pf.ars::CSS_R543_7_ED2014_08, fr.pf.ars::CSS_R543_7_ED2016_03, fr.pf.ars::CSS_R543_7_ED2016_10,
        fr.pf.ars::CSS_R543_7_ED2019_01, fr.pf.ars::CSS_R543_7_ED2022_01, fr.pf.ars::CSS_R543_7_ED2022_02,
        fr.apl::ORD9650_ART14_ED2020_01, fr.apl::ORD9650_ART19_ED2020_01)
rule DevoirVerserArsNet(o: fr.pf.core::Organisme, p: fr.pf.core::Personne, e: fr.pf.core::Enfant, montant: Money, limite: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "l'organisme débiteur paie le montant d'allocation net dû au plus tard à la date limite";
    label en unofficial "the debtor fund pays the net allowance amount due no later than the deadline";
    when montant_net_crds_ars(e, montant) and fr.pf.core::organisme_debiteur_pf(o, p)
        and date_limite_versement(limite);
    then duty PayerArsNet {
        bearer o;
        beneficiary p;
        maintain ars_net_verse(p, e, montant) during [@2021-01-01, limite];
    };
}

