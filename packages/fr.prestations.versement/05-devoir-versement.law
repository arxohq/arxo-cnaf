rule DevoirVerserCfNet(o: fr.pf.core::Organisme, p: fr.pf.core::Personne, montant: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "l'organisme débiteur paie au ménage le complément de base net dû";
    label en unofficial "the debtor fund pays the household the net base complement due";
    when montant_net_crds_cf(p, montant) and fr.pf.core::organisme_debiteur_pf(o, p);
    then duty PayerCfNet {
        bearer o;
        beneficiary p;
        maintain cf_net_verse(p, montant) during [@2021-01-01, infinity);
    };
}

