rule DevoirVerserArsSeuil(o: fr.pf.core::Organisme, p: fr.pf.core::Personne, montant: Money, limite: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "l'organisme débiteur paie le total d'ARS net atteignant le seuil au plus tard à la date limite";
    label en unofficial "the debtor fund pays the net ARS total reaching the floor no later than the deadline";
    when montant_net_crds_ars_total(p, montant) and fr.pf.core::organisme_debiteur_pf(o, p)
        and date_limite_versement(limite);
    then duty PayerArsSeuil {
        bearer o;
        beneficiary p;
        maintain ars_floor_verse(p, montant) during [@2021-01-01, limite];
    };
}

@source(fr.pf.core::CSS_L544_3, fr.pf.core::CSS_L544_3_CSS_ED2024_01,
        fr.pf.core::CSS_L544_3_CSS_ED2025_02, fr.pf.core::CSS_L544_3_CSS_ED2025_09,
        fr.pf.core::CSS_L544_3_CSS_ED2025_12, fr.pf.core::CSS_L544_3_CSS_ED2026_01,
        fr.pf.core::CSS_L544_3_CSS_ED2026_04, fr.pf.core::CSS_L544_3_CSS_ED2026_06)
rule DevoirVerserAjppMensuel(o: fr.pf.core::Organisme, p: fr.pf.core::Personne, e: fr.pf.core::Enfant, mois: Date, montant: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "l'organisme débiteur verse mensuellement au bénéficiaire l'AJPP nette calculée pour le mois (brut fr.pf.ajpp via CRDS 02, 310 jours au plus)";
    label en unofficial "the debtor body pays monthly to the beneficiary the net AJPP computed for the month (fr.pf.ajpp brut via 02 CRDS, 310 days max)";
    when montant_net_crds_ajpp(e, mois, montant) and fr.pf.core::organisme_debiteur_pf(o, p);
    then duty PayerAjppMensuel {
        bearer o;
        beneficiary p;
        maintain ajpp_mensuelle_versee(p, e, mois, montant) during [@2021-01-01, infinity);
    };
}

@source(fr.pf.core::CSS_L544_7, fr.pf.core::CSS_L544_7_CSS_ED2021_05,
        fr.pf.core::CSS_L544_7_CSS_ED2021_11, fr.pf.core::CSS_L544_7_CSS_ED2021_12,
        fr.pf.core::CSS_L544_7_CSS_ED2022_01, fr.pf.core::CSS_L544_7_CSS_ED2022_02,
        fr.pf.core::CSS_L544_7_CSS_ED2022_03, fr.pf.core::CSS_L544_7_CSS_ED2022_09,
        fr.pf.core::CSS_L544_7_CSS_ED2023_07, fr.pf.core::CSS_L544_7_CSS_ED2024_01,
        fr.pf.core::CSS_L544_7_CSS_ED2025_02, fr.pf.core::CSS_L544_7_CSS_ED2025_09,
        fr.pf.core::CSS_L544_7_CSS_ED2025_12, fr.pf.core::CSS_L544_7_CSS_ED2026_01,
        fr.pf.core::CSS_L544_7_CSS_ED2026_04, fr.pf.core::CSS_L544_7_CSS_ED2026_06)
rule DevoirVerserAjppComplement(o: fr.pf.core::Organisme, p: fr.pf.core::Personne, e: fr.pf.core::Enfant, montant: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "l'organisme débiteur verse au bénéficiaire le complément AJPP net pour frais calculé (brut fr.pf.ajpp via CRDS 02)";
    label en unofficial "the debtor body pays to the beneficiary the computed net AJPP expense complement (fr.pf.ajpp brut via 02 CRDS)";
    when montant_net_crds_ajpp_complement(e, montant) and fr.pf.core::organisme_debiteur_pf(o, p);
    then duty PayerAjppComplement {
        bearer o;
        beneficiary p;
        maintain ajpp_complement_verse(p, e, montant) during [@2021-01-01, infinity);
    };
}

// --- BOUNDARIES (no duty rules) ------------------------------------------
//
// AJPP (B-PV-AJPP-DEVOIR, closed PC-R07-37). The payment sentence IS
// pinned: L. 544-3 "est versée mensuellement... au plus 310 jours"
// (fr.pf.core fragments) anchors the two duties above; per this
// module's net-duty architecture they compose the 02 CRDS nets, which
// themselves flow the neighbour fr.pf.ajpp brut amounts. L. 544-8
// covers only jobseekers in training and is not used.
// AEEH, AJPA, AAH. 03 SILENCE on rounding and floors: net = brut, and
// the neighbour payment duties (aeeh_versee, ajpa versement, aah_versee)
// already bind the fund. No composition is added here.
// RSA and housing. Payment stage owned by fr.casf.rsa
// (allocation_mensuelle / allocation_non_versee) and fr.apl.versement
// (montant_verse / decision_non_versement); 04 consumes their heads.
// PA prime d'activité. OWNED STAGE (B-PV-PA follow-up 6 closed,
// FINISH-W2, RSA pattern): no CRDS net and no floor net exist for PA,
// so there is nothing to compose — the neighbour DevoirServirPrime
// (L. 843-1, prime_due_trimestre + organisme_serviteur → VerserPrimeDue)
// stands, and 04 consumes prime_due_trimestre as the PA echeance.
// A duty on the 04 net would breach B-PV-DROIT-PAIEMENT (payable vs
// entitlement); a duty on prime_due_trimestre would duplicate the
// neighbour (D-V1). No duty is added, for a stated reason.
// B-PV-LIMITE-UNIQUE. One case deadline (date_limite_versement) serves
// all ARS/ASF/floor duties (sibling convention: one deadline per case).
// Multi-track cases with genuinely distinct deadlines are out of scope.
// B-PV-ASF-DUTY-ASSUMED (F-CH6-01/02). No pinned fragment states a
// general monthly ASF payment duty: L. 523-1 is opening language
// ("Ouvrent droit à…", payment verb only for the I-4° differential)
// and R. 523-6 states QUARTERLY payment of the L. 581-2 differential
// (all editions 1985→2022) — it was wrongly cited here and is now
// removed. The three ASF duties rest on L. 523-1 + the monthly
// frequency both assumed per neighbour convention; referred to the
// pf-asf owner (journal request 7). Deadline labels no longer claim
// "mensuelle".
// CMG tiers-payant (sibling DevoirVerserTiersPayant, [@2024-09-01,
// @2025-02-28)): payment CHANNEL to the structure, same amount and same
// beneficiary position — considered, no rule (amount stage unaffected).
