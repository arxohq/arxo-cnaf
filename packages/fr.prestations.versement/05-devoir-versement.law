rule DevoirVerserCmgDirectAncienNet(o: fr.pf.core::Organisme, p: fr.pf.core::Personne, e: fr.pf.core::Enfant, montant: Money) strict {
    effective [@2021-01-01, @2025-09-01);
    label fr official "l'organisme débiteur paie le complément direct net dû (ancien droit)";
    label en unofficial "the debtor body pays the net direct supplement due (old law)";
    when montant_net_crds_cmg_direct(p, e, montant) and fr.pf.core::organisme_debiteur_pf(o, p);
    then duty PayerCmgDirectAncienNet {
        bearer o;
        beneficiary p;
        maintain cmg_net_verse(p, e, montant) during [@2021-01-01, @2025-09-01);
    };
}

@source(fr.pf.cmg::CSS_L531_5_ED2025_09, fr.pf.cmg::CSS_L531_5_ED2025_12,
        fr.apl::ORD9650_ART14_ED2020_01, fr.apl::ORD9650_ART19_ED2020_01)
// No justification premise on the DIRECT reforme duty (F-CH6-03):
// "sur justification" (D. 531-21 VI) is L. 531-6-scoped (structure)
// and no L. 531-5-side text conditions direct aid on it. The premise
// stays only on the structure twin, where D. 531-21 applies.
rule DevoirVerserCmgDirectReformeNet(o: fr.pf.core::Organisme, p: fr.pf.core::Personne, e: fr.pf.core::Enfant, montant: Money) strict {
    effective [@2025-09-01, infinity);
    label fr official "l'organisme débiteur paie le complément direct net (réforme)";
    label en unofficial "the debtor body pays the net direct supplement (reform)";
    when montant_net_crds_cmg_direct(p, e, montant)
        and fr.pf.core::organisme_debiteur_pf(o, p);
    then duty PayerCmgDirectReformeNet {
        bearer o;
        beneficiary p;
        maintain cmg_net_verse(p, e, montant) during [@2025-09-01, infinity);
    };
}

@source(fr.pf.cmg::CSS_L531_6_ED2020_01, fr.pf.cmg::CSS_L531_6_ED2024_09, fr.pf.cmg::CSS_L531_6_ED2025_01,
        fr.pf.cmg::CSS_L531_6_ED2025_02, fr.pf.cmg::CSS_D531_23_ED2020_01, fr.pf.cmg::CSS_D531_23_ED2021_09,
        fr.apl::ORD9650_ART14_ED2020_01, fr.apl::ORD9650_ART19_ED2020_01)
rule DevoirVerserCmgStructureAncienNet(o: fr.pf.core::Organisme, p: fr.pf.core::Personne, e: fr.pf.core::Enfant, montant: Money) strict {
    effective [@2021-01-01, @2025-09-01);
    label fr official "l'organisme débiteur paie l'aide structure nette due (ancien droit)";
    label en unofficial "the debtor body pays the net structure aid due (old law)";
    when montant_net_crds_cmg_structure(p, e, montant) and fr.pf.core::organisme_debiteur_pf(o, p);
    then duty PayerCmgStructureAncienNet {
        bearer o;
        beneficiary p;
        maintain cmg_net_verse(p, e, montant) during [@2021-01-01, @2025-09-01);
    };
}

@source(fr.pf.cmg::CSS_L531_6_ED2025_09, fr.pf.cmg::CSS_D531_21_ED2025_09,
        fr.apl::ORD9650_ART14_ED2020_01, fr.apl::ORD9650_ART19_ED2020_01)
rule DevoirVerserCmgStructureReformeNet(o: fr.pf.core::Organisme, p: fr.pf.core::Personne, e: fr.pf.core::Enfant, montant: Money, justification: Date) strict {
    effective [@2025-09-01, infinity);
    label fr official "l'organisme débiteur paie l'aide structure nette justifiée (réforme)";
    label en unofficial "the debtor body pays the justified net structure aid (reform)";
    when montant_net_crds_cmg_structure(p, e, montant)
        and fr.pf.cmg::justification_depenses(p, e, justification)
        and fr.pf.core::organisme_debiteur_pf(o, p);
    then duty PayerCmgStructureReformeNet {
        bearer o;
        beneficiary p;
        maintain cmg_net_verse(p, e, montant) during [@2025-09-01, infinity);
    };
}

@source(fr.pf.cmg::JORF_DECR2025_515_ART3,
        fr.apl::ORD9650_ART14_ED2020_01, fr.apl::ORD9650_ART19_ED2020_01)
rule DevoirVerserCmgDifferentielNet(o: fr.pf.core::Organisme, p: fr.pf.core::Personne, e: fr.pf.core::Enfant, montant: Money) strict {
    effective [@2025-09-01, infinity);
    label fr official "l'organisme L. 133-5-10 paie le différentiel transitoire net calculé";
    label en unofficial "the L. 133-5-10 body pays the computed net transitional differential";
    when montant_net_crds_cmg_differentiel(p, e, montant) and fr.pf.cmg::organisme_recouvrement(o, p);
    then duty PayerCmgDifferentielNet {
        bearer o;
        beneficiary p;
        maintain cmg_net_verse(p, e, montant) during [@2025-09-01, infinity);
    };
}

@source(fr.pf.asf::CSS_L523_1, fr.pf.asf::CSS_L523_1_ED2022_11, fr.pf.asf::CSS_L523_1_PRE2019,
        fr.pf.asf::CSS_L523_1_PRE2019_ED2018_07, fr.pf.asf::CSS_L523_1_PRE2019_ED2018_07_27,
        fr.pf.asf::CSS_L523_1_PREV, fr.pf.asf::CSS_D523_3,
        fr.pf.asf::CSS_D523_3_ED2018_07_27, fr.pf.asf::CSS_D523_3_ED2019_12, fr.pf.asf::CSS_D523_3_ED2021_12,
        fr.pf.asf::CSS_D523_3_ED2022_11,
        fr.apl::ORD9650_ART14_ED2020_01, fr.apl::ORD9650_ART19_ED2020_01)
rule DevoirVerserAsfSeuil(o: fr.pf.core::Organisme, p: fr.pf.core::Personne, montant: Money, limite: Date) strict {
    effective [@2021-01-01, infinity);
    label fr official "l'organisme débiteur paie le total d'ASF net atteignant le seuil au plus tard à la date limite";
    label en unofficial "the debtor fund pays the net ASF total reaching the floor no later than the deadline";
    when montant_net_crds_asf_total(p, montant) and fr.pf.core::organisme_debiteur_pf(o, p)
        and date_limite_versement(limite);
    then duty PayerAsfSeuil {
        bearer o;
        beneficiary p;
        maintain asf_floor_verse(p, montant) during [@2021-01-01, limite];
    };
}

