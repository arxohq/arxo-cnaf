@source(fr.pf.paje::CSS_L531_2_ED2020_12,
        fr.apl::ORD9650_ART14_ED2020_01, fr.apl::ORD9650_ART19_ED2020_01)
rule DevoirVerserPrimeNet(o: fr.pf.paje::Organisme, m: fr.pf.paje::Menage, e: fr.pf.paje::Enfant, montant: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "la prime nette attribuée est versée au ménage";
    label en unofficial "the awarded net grant is paid to the household";
    when montant_net_crds_prime(m, e, montant) and fr.pf.paje::organisme_debiteur(o, m);
    then duty VerserPrimeNetteDue {
        bearer o;
        beneficiary m;
        maintain prime_net_versee(m, e, montant) during [@2021-01-01, infinity);
    };
}

