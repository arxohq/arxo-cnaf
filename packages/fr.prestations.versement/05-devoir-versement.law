// Fund duty to pay the NET amounts (post-CRDS, post-floor).
// Module 05-devoir-versement.law of fr.prestations.versement (wave 5).
//
// Each duty composes the neighbour's brut payment duty with the Ord. 96-50
// art. 14 withholding: the fund that owes the brut owes the net. Deadline
// style mirrors the neighbour (per-case limite for ARS/ASF and the two
// floors, open window otherwise). AJPP duties compose the neighbour
// fr.pf.ajpp monthly/complement amounts under the L. 544-3 payment
// sentence (PC-R07-37; B-PV-AJPP-DEVOIR closed).
// Silence benefits (AEEH, AJPA, AAH) and owned stages (RSA, housing, PA)
// keep their neighbour duties; nothing is added for them here (PA:
// neighbour DevoirServirPrime on prime_due_trimestre stands, and 04
// consumes that head as the PA echeance — B-PV-PA follow-up 6 closed,
// FINISH-W2, RSA owned-stage pattern).

language "law.core" version "0.2";
package fr.prestations.versement version "0.1.0";
namespace "urn:fr:corpus:clir:prestations-versement";

use self::{
    montant_net_crds_af,
    montant_net_crds_ajpp,
    montant_net_crds_ajpp_complement,
    montant_net_crds_ars,
    montant_net_crds_ars_differentiel,
    montant_net_crds_ars_total,
    montant_net_crds_asf,
    montant_net_crds_asf_differentiel,
    montant_net_crds_asf_total,
    montant_net_crds_base,
    montant_net_crds_cf,
    montant_net_crds_cf_differentiel,
    montant_net_crds_cf_majore,
    montant_net_crds_cmg_differentiel,
    montant_net_crds_cmg_direct,
    montant_net_crds_cmg_structure,
    montant_net_crds_prepare,
    montant_net_crds_prime,
};

pub relation date_limite_versement(limite: Date) kind empirical {
    label fr official "date limite de paiement du cas pour les versements ARS/ASF";
    label en unofficial "case payment deadline for ARS/ASF payments";
}

pub relation af_net_verse(p: fr.pf.core::Personne, montant: Money) kind institutional {
    key(p);
    label fr official "allocations familiales nettes versées au ménage";
    label en unofficial "net family allowances paid to the household";
}

pub relation cf_net_verse(p: fr.pf.core::Personne, montant: Money) kind institutional {
    key(p);
    label fr official "complément familial net versé au ménage (base, majoré ou différentiel)";
    label en unofficial "net family complement paid to the household (base, increased or differential)";
}

pub relation ars_net_verse(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, montant: Money) kind institutional {
    key(p, e);
    label fr official "allocation de rentrée scolaire nette versée (base ou différentiel)";
    label en unofficial "net school-start allowance paid (base or differential)";
}

pub relation asf_net_verse(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, montant: Money) kind institutional {
    key(p, e);
    label fr official "allocation de soutien familial nette versée (base ou différentiel)";
    label en unofficial "net family support allowance paid (base or differential)";
}

pub relation prime_net_versee(m: fr.pf.paje::Menage, e: fr.pf.paje::Enfant, montant: Money) kind institutional {
    key(m, e);
    label fr official "prime nette versée au ménage";
    label en unofficial "net grant paid to the household";
}

pub relation base_net_versee(m: fr.pf.paje::Menage, e: fr.pf.paje::Enfant, montant: Money) kind institutional {
    key(m, e);
    label fr official "allocation de base nette versée au ménage";
    label en unofficial "net base allowance paid to the household";
}

pub relation prepare_net_versee(b: fr.pf.paje::Beneficiaire, e: fr.pf.paje::Enfant, montant: Money) kind institutional {
    key(b, e);
    label fr official "PreParE nette versée au demandeur";
    label en unofficial "net PreParE paid to the claimant";
}

pub relation cmg_net_verse(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, montant: Money) kind institutional {
    key(p, e);
    label fr official "CMG net versé (direct, structure ou différentiel)";
    label en unofficial "net CMG paid (direct, structure or differential)";
}

pub relation asf_floor_verse(p: fr.pf.core::Personne, montant: Money) kind institutional {
    key(p);
    label fr official "total d'ASF net atteignant le seuil versé (D. 523-3, Ord. 96-50 art. 14)";
    label en unofficial "net ASF total reaching the floor paid (D. 523-3, Ord. 96-50 art. 14)";
}

pub relation ars_floor_verse(p: fr.pf.core::Personne, montant: Money) kind institutional {
    key(p);
    label fr official "total d'ARS net atteignant le seuil versé (D. 543-2, Ord. 96-50 art. 14)";
    label en unofficial "net ARS total reaching the floor paid (D. 543-2, Ord. 96-50 art. 14)";
}

pub relation ajpp_mensuelle_versee(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, mois: Date, montant: Money) kind institutional {
    key(p, e, mois);
    label fr official "AJPP mensuelle versée au bénéficiaire pour le mois (L. 544-3, 310 jours au plus)";
    label en unofficial "monthly AJPP paid to the beneficiary for the month (L. 544-3, 310 days max)";
}

pub relation ajpp_complement_verse(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, montant: Money) kind institutional {
    key(p, e);
    label fr official "complément AJPP pour frais versé au bénéficiaire (L. 544-7)";
    label en unofficial "AJPP expense complement paid to the beneficiary (L. 544-7)";
}

@source(fr.pf.af::CSS_L521_1, fr.pf.af::CSS_L521_1_ED2015_10, fr.pf.af::CSS_L521_1_ED2021_09,
        fr.pf.af::CSS_L521_1_ED2022_01, fr.pf.af::CSS_L521_1_ED2026_03, fr.pf.af::CSS_L521_2,
        fr.pf.af::CSS_L521_2_ED2022_01, fr.pf.af::CSS_L521_2_ED2026_03, fr.pf.af::CSS_L521_2_PRE2021,
        fr.pf.af::CSS_L521_2_PRE2021_ED2015_07, fr.pf.af::CSS_L521_2_PRE2021_ED2015_10,
        fr.apl::ORD9650_ART14_ED2020_01, fr.apl::ORD9650_ART19_ED2020_01)
rule DevoirVerserAfNet(o: fr.pf.core::Organisme, p: fr.pf.core::Personne, montant: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "l'organisme débiteur paie au ménage les allocations nettes dues";
    label en unofficial "the debtor fund pays the household the net allowances due";
    when montant_net_crds_af(p, montant) and fr.pf.core::organisme_debiteur_pf(o, p);
    then duty PayerAfNet {
        bearer o;
        beneficiary p;
        maintain af_net_verse(p, montant) during [@2021-01-01, infinity);
    };
}

@source(fr.pf.cf::CSS_L522_1, fr.pf.cf::CSS_L522_1_ED2011_11, fr.pf.cf::CSS_L522_1_ED2014_01,
