    when montant_net_crds_ars_differentiel(e, montant) and fr.pf.core::organisme_debiteur_pf(o, p)
        and date_limite_versement(limite);
    then duty PayerArsDifferentielNet {
        bearer o;
        beneficiary p;
        maintain ars_net_verse(p, e, montant) during [@2021-01-01, limite];
    };
}

