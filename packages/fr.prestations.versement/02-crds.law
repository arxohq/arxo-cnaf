rule NetApresCRDSPrepare(b: fr.pf.paje::Beneficiaire, e: fr.pf.paje::Enfant, brut: Money, mois: Date, crds: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "la PreParE nette est le brut diminue de la CRDS precomptee";
    label en unofficial "net PreParE is gross minus withheld CRDS";
    when fr.pf.paje::prepare_attribuee(b, e, brut, mois) and crds_precomptee_prepare(b, e, mois, crds);
    then montant_net_crds_prepare(b, e, mois, brut - crds);
}

// --- CMG: direct (L. 531-5), structure (L. 531-6), transitional
// differentiel. Only the three duty-triggering brut totals are
// assiettes; the cumulation intermediates (montant_cumul_5315,
// montant_cumul_total) are not separate assiettes.

pub relation crds_precomptee_cmg_direct(m: fr.pf.core::Personne, e: fr.pf.core::Enfant, montant: Money) kind institutional {
    key(m, e);
    label fr official "CRDS precomptee sur le complement direct du (L. 531-5)";
    label en unofficial "CRDS withheld from the direct supplement due (L. 531-5)";
}

pub relation montant_net_crds_cmg_direct(m: fr.pf.core::Personne, e: fr.pf.core::Enfant, montant: Money) kind institutional {
    key(m, e);
    label fr official "complement direct net de CRDS, avant arrondis et planchers";
    label en unofficial "direct supplement net of CRDS, before rounding and floors";
}

pub relation crds_precomptee_cmg_structure(m: fr.pf.core::Personne, e: fr.pf.core::Enfant, montant: Money) kind institutional {
    key(m, e);
    label fr official "CRDS precomptee sur l'aide structure due (L. 531-6)";
    label en unofficial "CRDS withheld from the structure aid due (L. 531-6)";
}

pub relation montant_net_crds_cmg_structure(m: fr.pf.core::Personne, e: fr.pf.core::Enfant, montant: Money) kind institutional {
    key(m, e);
    label fr official "aide structure nette de CRDS, avant arrondis et planchers";
    label en unofficial "structure aid net of CRDS, before rounding and floors";
}

pub relation crds_precomptee_cmg_differentiel(m: fr.pf.core::Personne, e: fr.pf.core::Enfant, montant: Money) kind institutional {
    key(m, e);
    label fr official "CRDS precomptee sur le differentiel transitoire du (decret 2025-515, art. 3)";
    label en unofficial "CRDS withheld from the transitional differential due (Decree 2025-515, Art. 3)";
}

pub relation montant_net_crds_cmg_differentiel(m: fr.pf.core::Personne, e: fr.pf.core::Enfant, montant: Money) kind institutional {
    key(m, e);
    label fr official "differentiel transitoire net de CRDS, avant arrondis et planchers";
    label en unofficial "transitional differential net of CRDS, before rounding and floors";
}

@source(fr.apl::ORD9650_ART14_ED2020_01, fr.apl::ORD9650_ART19_ED2020_01,
    fr.pf.core::CSS_L511_1, fr.pf.paje::CSS_L531_1_ED2014_08)
rule RetenueCRDSCmgDirect(m: fr.pf.core::Personne, e: fr.pf.core::Enfant, brut: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "la CRDS au taux de 0,5 % est precomptee sur le complement direct du";
    label en unofficial "CRDS at 0.5% is withheld from the direct supplement due";
    when fr.pf.cmg::montant_cmg_du(m, e, brut);
    then crds_precomptee_cmg_direct(m, e, crds_pf_calculee(brut));
}

@source(fr.apl::ORD9650_ART14_ED2020_01)
rule NetApresCRDSCmgDirect(m: fr.pf.core::Personne, e: fr.pf.core::Enfant, brut: Money, crds: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "le complement direct net est le brut diminue de la CRDS precomptee";
    label en unofficial "net direct supplement is gross minus withheld CRDS";
    when fr.pf.cmg::montant_cmg_du(m, e, brut) and crds_precomptee_cmg_direct(m, e, crds);
    then montant_net_crds_cmg_direct(m, e, brut - crds);
}

