// --- AJPP: monthly daily-allowance total and frais complement ---
// AJPP is L. 511-1 9°, so art. 14 II 8° covers the prestation as a
// whole; the text names no component-level exception for the frais
// complement. No AEEH rule: explicit exception in art. 14 II 8°.
// No AJPA rule: L. 168-8 is outside L. 511-1 (see header).

pub relation crds_precomptee_ajpp(e: fr.pf.core::Enfant, mois: Date, montant: Money) kind institutional {
    key(e, mois);
    label fr official "CRDS precomptee sur le total mensuel d'AJPP du";
    label en unofficial "CRDS withheld from the monthly AJPP total due";
}

pub relation montant_net_crds_ajpp(e: fr.pf.core::Enfant, mois: Date, montant: Money) kind institutional {
    key(e, mois);
    label fr official "total mensuel d'AJPP net de CRDS, avant arrondis et planchers";
    label en unofficial "monthly AJPP total net of CRDS, before rounding and floors";
}

pub relation crds_precomptee_ajpp_complement(e: fr.pf.core::Enfant, montant: Money) kind institutional {
    key(e);
    label fr official "CRDS precomptee sur le complement pour frais d'AJPP";
    label en unofficial "CRDS withheld from the AJPP expense top-up";
}

pub relation montant_net_crds_ajpp_complement(e: fr.pf.core::Enfant, montant: Money) kind institutional {
    key(e);
    label fr official "complement pour frais d'AJPP net de CRDS, avant arrondis et planchers";
    label en unofficial "AJPP expense top-up net of CRDS, before rounding and floors";
}

@source(fr.apl::ORD9650_ART14_ED2020_01, fr.apl::ORD9650_ART19_ED2020_01,
    fr.pf.core::CSS_L511_1)
rule RetenueCRDSAjpp(e: fr.pf.core::Enfant, mois: Date, brut: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "la CRDS au taux de 0,5 % est precomptee sur le total mensuel d'AJPP";
    label en unofficial "CRDS at 0.5% is withheld from the monthly AJPP total";
    when fr.pf.ajpp::ajpp_montant_mois(e, mois, brut);
    then crds_precomptee_ajpp(e, mois, crds_pf_calculee(brut));
}

@source(fr.apl::ORD9650_ART14_ED2020_01)
rule NetApresCRDSAjpp(e: fr.pf.core::Enfant, mois: Date, brut: Money, crds: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "le total mensuel net est le brut diminue de la CRDS precomptee";
    label en unofficial "net monthly total is gross minus withheld CRDS";
    when fr.pf.ajpp::ajpp_montant_mois(e, mois, brut) and crds_precomptee_ajpp(e, mois, crds);
    then montant_net_crds_ajpp(e, mois, brut - crds);
}

@source(fr.apl::ORD9650_ART14_ED2020_01, fr.apl::ORD9650_ART19_ED2020_01,
    fr.pf.core::CSS_L511_1)
rule RetenueCRDSAjppComplement(e: fr.pf.core::Enfant, brut: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "la CRDS au taux de 0,5 % est precomptee sur le complement pour frais d'AJPP";
    label en unofficial "CRDS at 0.5% is withheld from the AJPP expense top-up";
    when fr.pf.ajpp::ajpp_montant_complement(e, brut);
    then crds_precomptee_ajpp_complement(e, crds_pf_calculee(brut));
}

@source(fr.apl::ORD9650_ART14_ED2020_01)
rule NetApresCRDSAjppComplement(e: fr.pf.core::Enfant, brut: Money, crds: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "le complement net est le brut diminue de la CRDS precomptee";
    label en unofficial "net top-up is gross minus withheld CRDS";
    when fr.pf.ajpp::ajpp_montant_complement(e, brut) and crds_precomptee_ajpp_complement(e, crds);
    then montant_net_crds_ajpp_complement(e, brut - crds);
}
