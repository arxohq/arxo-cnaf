// --- PAJE: prime (lump sum), base and PreParE (monthly awards) ---
// PAJE keys are package-local entities (Menage, Enfant, Beneficiaire),
// not fr.pf.core concepts.

pub relation crds_precomptee_prime(m: fr.pf.paje::Menage, e: fr.pf.paje::Enfant, montant: Money) kind institutional {
    key(m, e);
    label fr official "CRDS precomptee sur la prime de naissance ou d'adoption attribuee";
    label en unofficial "CRDS withheld from the awarded birth or adoption grant";
}

pub relation montant_net_crds_prime(m: fr.pf.paje::Menage, e: fr.pf.paje::Enfant, montant: Money) kind institutional {
    key(m, e);
    label fr official "prime attribuee nette de CRDS, avant arrondis et planchers";
    label en unofficial "awarded grant net of CRDS, before rounding and floors";
}

pub relation crds_precomptee_base(m: fr.pf.paje::Menage, e: fr.pf.paje::Enfant, mois: Date, montant: Money) kind institutional {
    key(m, e, mois);
    label fr official "CRDS precomptee sur l'allocation de base attribuee au mois";
    label en unofficial "CRDS withheld from the base allowance awarded for the month";
}

pub relation montant_net_crds_base(m: fr.pf.paje::Menage, e: fr.pf.paje::Enfant, mois: Date, montant: Money) kind institutional {
    key(m, e, mois);
    label fr official "allocation de base attribuee nette de CRDS, avant arrondis et planchers";
    label en unofficial "awarded base allowance net of CRDS, before rounding and floors";
}

pub relation crds_precomptee_prepare(b: fr.pf.paje::Beneficiaire, e: fr.pf.paje::Enfant, mois: Date, montant: Money) kind institutional {
    key(b, e, mois);
    label fr official "CRDS precomptee sur la PreParE attribuee au mois";
    label en unofficial "CRDS withheld from the PreParE awarded for the month";
}

pub relation montant_net_crds_prepare(b: fr.pf.paje::Beneficiaire, e: fr.pf.paje::Enfant, mois: Date, montant: Money) kind institutional {
    key(b, e, mois);
    label fr official "PreParE attribuee nette de CRDS, avant arrondis et planchers";
    label en unofficial "awarded PreParE net of CRDS, before rounding and floors";
}

@source(fr.apl::ORD9650_ART14_ED2020_01, fr.apl::ORD9650_ART19_ED2020_01,
    fr.pf.core::CSS_L511_1, fr.pf.paje::CSS_L531_1_ED2014_08)
rule RetenueCRDSPrime(m: fr.pf.paje::Menage, e: fr.pf.paje::Enfant, brut: Money) strict {
    effective [@2021-01-01, infinity);
