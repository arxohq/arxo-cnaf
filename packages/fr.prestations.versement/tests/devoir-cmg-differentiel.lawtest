language "law.core" version "0.2";
package fr.prestations.versement version "0.1.0";
namespace "urn:fr:corpus:clir:prestations-versement";

test "urn:query:fr-pv-devoir-cmg-differentiel" {
    given {
        context { decision_time @2025-10-15T12:00:00Z; knowledge_time @2025-10-15T12:00:00Z; legal_time @2025-10-15; timezone "Europe/Paris"; }
        assert "brut": fr.pf.cmg::montant_differentiel(entity_ref("urn:fr:pv:case:allocataire"), entity_ref("urn:fr:pv:case:enfant"), 80.00 EUR) { origin case_input; }
        assert "org": fr.pf.cmg::organisme_recouvrement(entity_ref("urn:fr:pv:case:caisse"), entity_ref("urn:fr:pv:case:allocataire")) { origin case_input; }
    }
    evaluate positions();
    expect position(PayerCmgDifferentielNet, ACTIVE);
    expect evaluation_status == COMPUTED;
}
