// D553-1 four-month clock running (PC-R05-02): quarterly right, last-known 800 EUR, declaration not received, quarterly unknown; depart 2022-01-15, appreciation 2022-04-10 (before +4 months 2022-05-15); weighted 800 EUR.
language "law.core" version "0.2";
package fr.prestations.versement version "0.1.0";
namespace "urn:fr:corpus:clir:prestations-versement";

test "urn:query:fr-pv-d5531-delai-encours" {
    given {
        context { decision_time @2022-04-10T12:00:00Z; knowledge_time @2022-04-10T12:00:00Z; legal_time @2022-04-10; timezone "Europe/Paris"; deadline_policy BAREME_DELAI_MOIS; }
        assert "d5531-e1": droit_trimestriel_ouvert(entity_ref("urn:fr:pv:case:trimestriel")) { origin case_input; }
        assert "d5531-e2": pond_trimestriel_connu(entity_ref("urn:fr:pv:case:trimestriel"), 800.00 EUR) { origin case_input; }
        assert "d5531-e3": ressources_trimestrielles_inconnues(entity_ref("urn:fr:pv:case:trimestriel")) { origin case_input; }
        assert "d5531-e4": declaration_montant_revenus_non_recue(entity_ref("urn:fr:pv:case:trimestriel")) { origin case_input; }
        assert "d5531-e5": delai_4_mois_depart_le(entity_ref("urn:fr:pv:case:trimestriel"), @2022-01-15) { origin case_input; }
        assert "d5531-e6": date_appreciation_revenus(entity_ref("urn:fr:pv:case:trimestriel"), @2022-04-10) { origin case_input; }
    }
    evaluate truth(revenu_pondere(entity_ref("urn:fr:pv:case:trimestriel"), 800.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
