language "law.core" version "0.2";
package fr.prestations.versement version "0.1.0";
namespace "urn:fr:corpus:clir:prestations-versement";

// CH2-12 as revised by F-CH6-03: the reforme direct duty fires in its
// window WITHOUT a justification premise (no L. 531-5-side text
// conditions direct aid on it; D. 531-21 VI is L. 531-6-scoped).

test "urn:query:fr-pv-devoir-cmg-direct-reforme" {
    given {
        context { decision_time @2025-10-15T12:00:00Z; knowledge_time @2025-10-15T12:00:00Z; legal_time @2025-10-15; timezone "Europe/Paris"; }
        assert "brut": fr.pf.cmg::montant_cmg_du(entity_ref("urn:fr:pv:case:allocataire"), entity_ref("urn:fr:pv:case:enfant"), 300.00 EUR) { origin case_input; }
        assert "org": fr.pf.core::organisme_debiteur_pf(entity_ref("urn:fr:pv:case:caisse"), entity_ref("urn:fr:pv:case:allocataire")) { origin case_input; }
    }
    evaluate positions();
    expect position(PayerCmgDirectReformeNet, ACTIVE);
    expect evaluation_status == COMPUTED;
}
