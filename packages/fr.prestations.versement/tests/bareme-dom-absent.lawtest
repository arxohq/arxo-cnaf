// DOM applicability absent: no L. 751-1 department fact - no DOM extension status (D. 755-2, D73).
language "law.core" version "0.2";
package fr.prestations.versement version "0.1.0";
namespace "urn:fr:corpus:clir:prestations-versement";

test "urn:query:fr-pv-bareme-dom-absent" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "dom-absent-01": fr.pf.core::allocataire(entity_ref("urn:fr:pv:case:metro-allocataire")) { origin case_input; }
    }
    evaluate truth(retenues_dom_applicables(entity_ref("urn:fr:pv:case:metro-allocataire")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
