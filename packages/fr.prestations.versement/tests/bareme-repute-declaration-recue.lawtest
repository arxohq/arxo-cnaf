// Deemed income blocked by a received declaration: resources unknown, no quarterly right, but the declaration arrived - no deemed 1 096 (D. 553-1 III, PC-R02-01).
language "law.core" version "0.2";
package fr.prestations.versement version "0.1.0";
namespace "urn:fr:corpus:clir:prestations-versement";

test "urn:query:fr-pv-bareme-repute-declaration-recue" {
    given {
        context { decision_time @2022-06-15T12:00:00Z; knowledge_time @2022-06-15T12:00:00Z; legal_time @2022-06-15; timezone "Europe/Paris"; }
        assert "r-inc": ressources_inconnues(entity_ref("urn:fr:pv:case:inconnu-decl")) { origin case_input; }
    }
    evaluate truth(revenu_pondere(entity_ref("urn:fr:pv:case:inconnu-decl"), 1096.00 EUR));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
