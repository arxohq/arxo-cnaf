// Seizure scale on maintenance debts: seizable case - seizure levies follow D. 553-1/2 (D. 553-3).
language "law.core" version "0.2";
package fr.prestations.versement version "0.1.0";
namespace "urn:fr:corpus:clir:prestations-versement";

test "urn:query:fr-pv-bareme-saisie-alimentaire" {
    given {
        context { decision_time @2022-06-15T12:00:00Z; knowledge_time @2022-06-15T12:00:00Z; legal_time @2022-06-15; timezone "Europe/Paris"; }
        assert "s-alim": fr.pf.core::saisie_alimentaire_possible(entity_ref("urn:fr:pv:case:saisi-alim")) { origin case_input; }
    }
    evaluate truth(prelevements_saisie_bareme(entity_ref("urn:fr:pv:case:saisi-alim")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
