// Quarterly right where the income-amount declaration has been received: last-known 400 no longer applies without the non-receipt fact - no kept amount (D. 553-1 III, PC-R02-01).
language "law.core" version "0.2";
package fr.prestations.versement version "0.1.0";
namespace "urn:fr:corpus:clir:prestations-versement";

test "urn:query:fr-pv-bareme-trimestriel-declaration-recue" {
    given {
        context { decision_time @2022-06-15T12:00:00Z; knowledge_time @2022-06-15T12:00:00Z; legal_time @2022-06-15; timezone "Europe/Paris"; }
        assert "t-ouv": droit_trimestriel_ouvert(entity_ref("urn:fr:pv:case:trimestriel-decl")) { origin case_input; }
        assert "t-pond": pond_trimestriel_connu(entity_ref("urn:fr:pv:case:trimestriel-decl"), 400.00 EUR) { origin case_input; }
        assert "t-inc": ressources_trimestrielles_inconnues(entity_ref("urn:fr:pv:case:trimestriel-decl")) { origin case_input; }
    }
    evaluate truth(revenu_pondere(entity_ref("urn:fr:pv:case:trimestriel-decl"), 400.00 EUR));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
