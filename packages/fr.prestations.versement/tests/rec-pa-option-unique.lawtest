language "law.core" version "0.2";
package fr.prestations.versement version "0.1.0";
namespace "urn:fr:corpus:clir:prestations-versement";

// Q2 symmetry: the PA single-repayment option (L. 845-3 al. 3)
// bars deduction; the echeance is paid whole via NetSansRetenuePa.

test "urn:query:fr-pv-rec-pa-option-unique" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "due": fr.css.prime_activite::prime_due_trimestre(entity_ref("urn:fr:pv:case:pa"), 600.00 EUR) { origin case_input; }
        assert "indu": fr.css.prime_activite::indu_recupere(entity_ref("urn:fr:pv:case:pa"), 500.00 EUR) { origin case_input; }
        assert "report": rsa_indu_reporte_sur_pa(entity_ref("urn:fr:pv:case:pa"), 0 EUR) { origin case_input; }
        // D-42: the stated scale rate 0.30 is gone (contract (b), PC-R07-39): the levy
        // arrives as the Money amount the fund applies; same case, 0.30 x PA quarterly amount due
        // 600.00 = 180.00 EUR. Carry pairs carry their lawful-carry gate (PC-R07-36).
        assert "levy": retenue_trimestrielle_pa_declaree(entity_ref("urn:fr:pv:case:pa"), 180.00 EUR) { origin case_input; }
        assert "levy-rsa-licite": report_rsa_sur_pa_licite(entity_ref("urn:fr:pv:case:pa")) { origin case_input; }
        assert "opt": fr.css.prime_activite::option_remboursement_unique(entity_ref("urn:fr:pv:case:pa")) { origin case_input; }
    }
    evaluate truth(net_verse_pa(entity_ref("urn:fr:pv:case:pa"), 600.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
