// New bases on a rise: renewal, 100 to 130 - recovery continues on the new bases (D. 553-2).
language "law.core" version "0.2";
package fr.prestations.versement version "0.1.0";
namespace "urn:fr:corpus:clir:prestations-versement";

test "urn:query:fr-pv-bareme-nouvelles-bases-hausse" {
    given {
        context { decision_time @2022-02-15T12:00:00Z; knowledge_time @2022-02-15T12:00:00Z; legal_time @2022-02-15; timezone "Europe/Paris"; }
        assert "n-ren": renouvellement_annuel(entity_ref("urn:fr:pv:case:recalcule")) { origin case_input; }
        assert "n-anc": mensualite_precedente(entity_ref("urn:fr:pv:case:recalcule"), 100.00 EUR) { origin case_input; }
        assert "n-nouv": prelevement_mensuel(entity_ref("urn:fr:pv:case:recalcule"), 130.00 EUR) { origin case_input; }
    }
    evaluate truth(recouvrement_nouvelles_bases(entity_ref("urn:fr:pv:case:recalcule")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
