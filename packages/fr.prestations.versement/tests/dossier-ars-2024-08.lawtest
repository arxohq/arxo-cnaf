language "law.core" version "0.2";
package fr.prestations.versement version "0.1.0";
namespace "urn:fr:corpus:clir:prestations-versement";

test "urn:query:fr-pv-dossier-ars-2024-08" {
    given {
        context { decision_time @2024-08-15T12:00:00Z; knowledge_time @2024-08-15T12:00:00Z; legal_time @2024-08-15; timezone "Europe/Paris"; }
        assert "brut": fr.pf.ars::ars_montant_du(entity_ref("urn:fr:pv:case:dossier-lina"), 400.00 EUR) { origin case_input; }
    }
    evaluate truth(montant_net_crds_ars(entity_ref("urn:fr:pv:case:dossier-lina"), 398.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
