// D553-4 unknown ledger (PC-R05-01): two indus with dates/balances and retention, but registre_indus_complet absent; no premier, no allocation (NEITHER).
language "law.core" version "0.2";
package fr.prestations.versement version "0.1.0";
namespace "urn:fr:corpus:clir:prestations-versement";

test "urn:query:fr-pv-d5534-registre-incomplet-neither" {
    given {
        context { decision_time @2022-06-15T12:00:00Z; knowledge_time @2022-06-15T12:00:00Z; legal_time @2022-06-15; timezone "Europe/Paris"; }
        assert "d5534-ri1": indu_constate_le(entity_ref("urn:fr:pv:case:indu-a"), entity_ref("urn:fr:pv:case:alloc"), @2022-01-10, 60.00 EUR) { origin case_input; }
        assert "d5534-ri2": indu_constate_le(entity_ref("urn:fr:pv:case:indu-b"), entity_ref("urn:fr:pv:case:alloc"), @2022-02-10, 50.00 EUR) { origin case_input; }
        assert "d5534-ri3": indu_solde_restant(entity_ref("urn:fr:pv:case:indu-a"), entity_ref("urn:fr:pv:case:alloc"), 60.00 EUR) { origin case_input; }
        assert "d5534-ri4": indu_solde_restant(entity_ref("urn:fr:pv:case:indu-b"), entity_ref("urn:fr:pv:case:alloc"), 50.00 EUR) { origin case_input; }
        assert "d5534-ri5": indus_multiples(entity_ref("urn:fr:pv:case:alloc")) { origin case_input; }
        assert "d5534-ri6": retenue_unique_indus_multiples(entity_ref("urn:fr:pv:case:alloc")) { origin case_input; }
        assert "d5534-ri7": prelevement_mensuel(entity_ref("urn:fr:pv:case:alloc"), 100.00 EUR) { origin case_input; }
    }
    evaluate truth(indu_premier_non_eteint(entity_ref("urn:fr:pv:case:indu-a"), entity_ref("urn:fr:pv:case:alloc")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
