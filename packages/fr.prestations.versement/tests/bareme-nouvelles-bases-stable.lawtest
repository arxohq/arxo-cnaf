// Bases kept on a small move: renewal, 100 to 110 - within 20 %, no new bases (D. 553-2).
language "law.core" version "0.2";
package fr.prestations.versement version "0.1.0";
namespace "urn:fr:corpus:clir:prestations-versement";

test "urn:query:fr-pv-bareme-nouvelles-bases-stable" {
    given {
        context { decision_time @2022-02-15T12:00:00Z; knowledge_time @2022-02-15T12:00:00Z; legal_time @2022-02-15; timezone "Europe/Paris"; }
        assert "n-ren": renouvellement_annuel(entity_ref("urn:fr:pv:case:stable")) { origin case_input; }
        assert "n-anc": mensualite_precedente(entity_ref("urn:fr:pv:case:stable"), 100.00 EUR) { origin case_input; }
        assert "n-nouv": prelevement_mensuel(entity_ref("urn:fr:pv:case:stable"), 110.00 EUR) { origin case_input; }
    }
    evaluate truth(recouvrement_nouvelles_bases(entity_ref("urn:fr:pv:case:stable")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
