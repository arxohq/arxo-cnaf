language "law.core" version "0.2";
package fr.prestations.versement version "0.1.0";
namespace "urn:fr:corpus:clir:prestations-versement";

// CH2-1: the D-V4 floor-total net is numerically pinned (20.00 →
// CRDS 0.10 → 19.90), not just the floor status.

test "urn:query:fr-pv-seuils-ars-total-net" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "total": total_menage_ars_retenu(entity_ref("urn:fr:pv:case:allocataire"), 20.00 EUR) { origin case_input; }
    }
    evaluate truth(montant_net_crds_ars_total(entity_ref("urn:fr:pv:case:allocataire"), 19.90 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
