// Direct-payment priority: carried levy - the fund may take it first from direct-payment benefits (D. 553-4).
language "law.core" version "0.2";
package fr.prestations.versement version "0.1.0";
namespace "urn:fr:corpus:clir:prestations-versement";

test "urn:query:fr-pv-bareme-priorite-direct" {
    given {
        context { decision_time @2022-06-15T12:00:00Z; knowledge_time @2022-06-15T12:00:00Z; legal_time @2022-06-15; timezone "Europe/Paris"; }
        assert "p-rep": retenue_report_autres_prestations(entity_ref("urn:fr:pv:case:reporte")) { origin case_input; }
        assert "p-org": fr.pf.core::organisme_debiteur_pf(entity_ref("urn:fr:pv:org:caisse"), entity_ref("urn:fr:pv:case:reporte")) { origin case_input; }
    }
    evaluate positions();
    expect position(PrioriteVersementDirect, ACTIVE);
    expect evaluation_status == COMPUTED;
}
