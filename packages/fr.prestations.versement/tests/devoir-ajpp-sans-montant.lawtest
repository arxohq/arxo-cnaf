language "law.core" version "0.2";
package fr.prestations.versement version "0.1.0";
namespace "urn:fr:corpus:clir:prestations-versement";

test "urn:query:fr-pv-devoir-ajpp-sans-montant" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "org": fr.pf.core::organisme_debiteur_pf(entity_ref("urn:fr:pv:case:caisse"), entity_ref("urn:fr:pv:case:allocataire-ajpp-nul")) { origin case_input; }
        assert "nul-mois": not montant_net_crds_ajpp(entity_ref("urn:fr:pv:case:enfant-ajpp-nul"), @2024-03-01, 597.00 EUR) { origin case_input; }
        assert "nul-compl": not montant_net_crds_ajpp_complement(entity_ref("urn:fr:pv:case:enfant-ajpp-nul"), 119.40 EUR) { origin case_input; }
    }
    evaluate positions();
    expect not position(PayerAjppMensuel, ACTIVE);
    expect not position(PayerAjppComplement, ACTIVE);
    expect evaluation_status == COMPUTED;
}
