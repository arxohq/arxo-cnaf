language "law.core" version "0.2";
package fr.prestations.versement version "0.1.0";
namespace "urn:fr:corpus:clir:prestations-versement";

test "urn:query:fr-pv-devoir-ajpp-mensuel" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "brut": fr.pf.ajpp::ajpp_montant_mois(entity_ref("urn:fr:pv:case:enfant-ajpp"), @2024-03-01, 600.00 EUR) { origin case_input; }
        assert "org": fr.pf.core::organisme_debiteur_pf(entity_ref("urn:fr:pv:case:caisse"), entity_ref("urn:fr:pv:case:allocataire-ajpp")) { origin case_input; }
    }
    evaluate positions();
    expect position(PayerAjppMensuel, ACTIVE);
    expect evaluation_status == COMPUTED;
}
