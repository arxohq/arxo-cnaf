language "law.core" version "0.2";
package fr.prestations.versement version "0.1.0";
namespace "urn:fr:corpus:clir:prestations-versement";

test "urn:query:fr-pv-seuils-asf-sous-seuil" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "total": total_menage_asf_retenu(entity_ref("urn:fr:pv:case:allocataire"), 14.99 EUR) { origin case_input; }
    }
    evaluate truth(asf_total_non_verse(entity_ref("urn:fr:pv:case:allocataire")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
