// Perfect tie: same date same amount - no source order between the pair, no allocation (D. 553-4 al. 3 genuine gap, PC-R04-03).
language "law.core" version "0.2";
package fr.prestations.versement version "0.1.0";
namespace "urn:fr:corpus:clir:prestations-versement";

test "urn:query:fr-pv-bareme-indus-egalite-parfaite" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "indus-egalite-01": indus_multiples(entity_ref("urn:fr:pv:case:multi-egaux")) { origin case_input; }
        assert "indus-egalite-02": indu_constate_le(entity_ref("urn:fr:pv:indu:egal-a"), entity_ref("urn:fr:pv:case:multi-egaux"), @2026-02-10, 500.00 EUR) { origin case_input; }
        assert "indus-egalite-03": indu_constate_le(entity_ref("urn:fr:pv:indu:egal-b"), entity_ref("urn:fr:pv:case:multi-egaux"), @2026-02-10, 500.00 EUR) { origin case_input; }
        assert "indus-egalite-04": indu_solde_restant(entity_ref("urn:fr:pv:indu:egal-a"), entity_ref("urn:fr:pv:case:multi-egaux"), 500.00 EUR) { origin case_input; }
        assert "indus-egalite-05": indu_solde_restant(entity_ref("urn:fr:pv:indu:egal-b"), entity_ref("urn:fr:pv:case:multi-egaux"), 500.00 EUR) { origin case_input; }
    }
    evaluate truth(indu_recouvre_avant(entity_ref("urn:fr:pv:indu:egal-a"), entity_ref("urn:fr:pv:indu:egal-b"), entity_ref("urn:fr:pv:case:multi-egaux")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
