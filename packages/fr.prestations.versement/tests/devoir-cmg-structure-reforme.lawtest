language "law.core" version "0.2";
package fr.prestations.versement version "0.1.0";
namespace "urn:fr:corpus:clir:prestations-versement";

// CH2-12: the reforme structure duty fires in its window only with
// the expense justification (D. 531-21, VI).

test "urn:query:fr-pv-devoir-cmg-structure-reforme" {
    given {
        context { deadline_policy fr.pf.cmg::CMG_MOIS_CALENDAIRE; decision_time @2025-10-15T12:00:00Z; knowledge_time @2025-10-15T12:00:00Z; legal_time @2025-10-15; timezone "Europe/Paris"; }
        assert "brut": fr.pf.cmg::montant_structure_du(entity_ref("urn:fr:pv:case:allocataire"), entity_ref("urn:fr:pv:case:enfant"), 500.00 EUR) { origin case_input; }
        assert "justif": fr.pf.cmg::justification_depenses(entity_ref("urn:fr:pv:case:allocataire"), entity_ref("urn:fr:pv:case:enfant"), @2025-09-20) { origin case_input; }
        assert "org": fr.pf.core::organisme_debiteur_pf(entity_ref("urn:fr:pv:case:caisse"), entity_ref("urn:fr:pv:case:allocataire")) { origin case_input; }
    }
    evaluate positions();
    expect position(PayerCmgStructureReformeNet, ACTIVE);
    expect evaluation_status == COMPUTED;
}
