// Third-party-paid source still payable: the fund may take the levy first from direct-payment benefits (D. 553-4 al. 2).
language "law.core" version "0.2";
package fr.prestations.versement version "0.1.0";
namespace "urn:fr:corpus:clir:prestations-versement";

test "urn:query:fr-pv-bareme-priorite-tiers" {
    given {
        context { decision_time @2022-06-15T12:00:00Z; knowledge_time @2022-06-15T12:00:00Z; legal_time @2022-06-15; timezone "Europe/Paris"; }
        assert "p-tiers": indu_source_tiers_payant_a_echoir(entity_ref("urn:fr:pv:case:tiers")) { origin case_input; }
        assert "p-org": fr.pf.core::organisme_debiteur_pf(entity_ref("urn:fr:pv:org:caisse"), entity_ref("urn:fr:pv:case:tiers")) { origin case_input; }
    }
    evaluate positions();
    expect position(PrioriteDirectSourceTiersPayant, ACTIVE);
    expect evaluation_status == COMPUTED;
}
