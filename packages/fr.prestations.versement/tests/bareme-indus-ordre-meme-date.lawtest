// Same-date tie-break: two indus constatés 10 February, 300 and 900 EUR - the smaller recovers first (D. 553-4 al. 3, PC-R04-03).
language "law.core" version "0.2";
package fr.prestations.versement version "0.1.0";
namespace "urn:fr:corpus:clir:prestations-versement";

test "urn:query:fr-pv-bareme-indus-ordre-meme-date" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "indus-meme-date-01": indus_multiples(entity_ref("urn:fr:pv:case:multi-date")) { origin case_input; }
        assert "indus-meme-date-02": indu_constate_le(entity_ref("urn:fr:pv:indu:petit"), entity_ref("urn:fr:pv:case:multi-date"), @2026-02-10, 300.00 EUR) { origin case_input; }
        assert "indus-meme-date-03": indu_constate_le(entity_ref("urn:fr:pv:indu:grand"), entity_ref("urn:fr:pv:case:multi-date"), @2026-02-10, 900.00 EUR) { origin case_input; }
        assert "indus-meme-date-04": indu_solde_restant(entity_ref("urn:fr:pv:indu:petit"), entity_ref("urn:fr:pv:case:multi-date"), 300.00 EUR) { origin case_input; }
        assert "indus-meme-date-05": indu_solde_restant(entity_ref("urn:fr:pv:indu:grand"), entity_ref("urn:fr:pv:case:multi-date"), 900.00 EUR) { origin case_input; }
    }
    evaluate truth(indu_recouvre_avant(entity_ref("urn:fr:pv:indu:petit"), entity_ref("urn:fr:pv:indu:grand"), entity_ref("urn:fr:pv:case:multi-date")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
