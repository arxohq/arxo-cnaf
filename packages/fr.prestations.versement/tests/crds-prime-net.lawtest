language "law.core" version "0.2";
package fr.prestations.versement version "0.1.0";
namespace "urn:fr:corpus:clir:prestations-versement";

test "urn:query:fr-pv-crds-prime-net" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "brut": fr.pf.paje::prime_attribuee(entity_ref("urn:fr:pv:case:menage"), entity_ref("urn:fr:pv:case:enfant"), 1000.00 EUR) { origin case_input; }
    }
    evaluate truth(montant_net_crds_prime(entity_ref("urn:fr:pv:case:menage"), entity_ref("urn:fr:pv:case:enfant"), 995.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
