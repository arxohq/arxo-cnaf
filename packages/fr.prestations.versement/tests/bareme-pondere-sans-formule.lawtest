// Unpinned weighting formula: R 1 200 and N 2.5 derived but no organ-stated, deemed or last-known weighted income - no levy (D. 553-1 II, B-VERS-D5531-PONDERE-FORMULE).
language "law.core" version "0.2";
package fr.prestations.versement version "0.1.0";
namespace "urn:fr:corpus:clir:prestations-versement";

test "urn:query:fr-pv-bareme-pondere-sans-formule" {
    given {
        context { decision_time @2022-06-15T12:00:00Z; knowledge_time @2022-06-15T12:00:00Z; legal_time @2022-06-15; timezone "Europe/Paris"; }
        assert "pf-a": revenus_mensuels_a(entity_ref("urn:fr:pv:case:sans-formule"), 900.00 EUR) { origin case_input; }
        assert "pf-b": prestations_mensuelles_b(entity_ref("urn:fr:pv:case:sans-formule"), 300.00 EUR) { origin case_input; }
        assert "pf-c": charges_logement_c(entity_ref("urn:fr:pv:case:sans-formule"), 0 EUR) { origin case_input; }
        assert "pf-s": personne_seule(entity_ref("urn:fr:pv:case:sans-formule")) { origin case_input; }
        assert "pf-n": nb_enfants_charge(entity_ref("urn:fr:pv:case:sans-formule"), 2) { origin case_input; }
    }
    evaluate truth(prelevement_mensuel(entity_ref("urn:fr:pv:case:sans-formule"), 120.40 EUR));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
