language "law.core" version "0.2";
package fr.prestations.versement version "0.1.0";
namespace "urn:fr:corpus:clir:prestations-versement";

test "urn:query:fr-pv-devoir-prime" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "brut": fr.pf.paje::prime_attribuee(entity_ref("urn:fr:pv:case:menage"), entity_ref("urn:fr:pv:case:enfant"), 1000.00 EUR) { origin case_input; }
        assert "org": fr.pf.paje::organisme_debiteur(entity_ref("urn:fr:pv:case:caisse"), entity_ref("urn:fr:pv:case:menage")) { origin case_input; }
    }
    evaluate positions();
    expect position(VerserPrimeNetteDue, ACTIVE);
    expect evaluation_status == COMPUTED;
}
