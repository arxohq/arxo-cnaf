rule RetenueMontantAjpa(p: fr.pf.core::Personne, a: fr.pf.core::Personne, dette: Money, base: Money, mois: Date, echeance: Money) defeasible {
    effective [@2024-01-01, infinity);
    label fr official "retenue AJPA du mois : prélèvement effectif, plafonné à l'échéance et à la dette";
    label en unofficial "month's AJPA deduction: effective levy, capped at the echeance and the debt";
    when retenue_appliquee_ajpa(p) and dette_recouvrable_ajpa(p, dette)
        and retenue_effective_ajpa(p, base) and fr.css.ajpa::ajpa_montant_mois(p, a, mois, echeance);
    then retenue_mensuelle_ajpa(p, mois, retenue_plafonnee(base, echeance, dette));
}

@source(fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
