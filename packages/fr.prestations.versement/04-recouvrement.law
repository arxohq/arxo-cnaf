        fr.pf.core::CSS_L553_2_CSS_ED2026_06)
rule DetteAsfFraude(p: fr.pf.core::Personne, montant: Money, indemnite: Money) strict {
    effective [@2024-01-01, infinity);
    label fr official "dette ASF en cas de fraude : montant imputé + indemnité 10 % (L. 553-2 al. 1)";
    label en unofficial "ASF debt on fraud: charged amount + 10% indemnity (L. 553-2 para. 1)";
    when dette_chargee_asf(p, montant)
        and fr.pf.core::indu_frauduleux(p) and fr.pf.core::indemnite_frais_gestion(p, indemnite);
    then dette_recouvrable_asf(p, dette_totale2(montant, indemnite));
}

