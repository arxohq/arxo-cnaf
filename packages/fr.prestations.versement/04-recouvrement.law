        fr.pf.core::CSS_D553_5_CSS_ED2025_02, fr.pf.core::CSS_D553_5_CSS_ED2025_09,
        fr.pf.core::CSS_D553_5_CSS_ED2025_12, fr.pf.core::CSS_D553_5_CSS_ED2026_01,
        fr.pf.core::CSS_D553_5_CSS_ED2026_04, fr.pf.core::CSS_D553_5_CSS_ED2026_06)
rule RetenueReiterationCf(p: fr.pf.core::Personne, base: Money) strict {
    effective [@2024-01-01, infinity);
    label fr official "réitération dans les cinq ans : la majoration de 50 % est doublée (x2,00)";
    label en unofficial "repeat within five years: the 50% uplift is doubled (x2.00)";
    when prelevement_mensuel(p, base)
        and fr.pf.core::indu_frauduleux(p) and fr.pf.core::fraude_reiteree(p);
    then retenue_effective_cf(p, retenue_majoree_reiteration(base));
}

@source(fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
        fr.pf.core::CSS_L553_2_CSS_ED2026_01, fr.pf.core::CSS_L553_2_CSS_ED2026_04,
        fr.pf.core::CSS_L553_2_CSS_ED2026_06)
rule RetenueAppliqueeCf(p: fr.pf.core::Personne, dette: Money, base: Money, echeance: Money) defeasible {
    effective [@2024-01-01, infinity);
    label fr official "retenues sur le CF à échoir, sauf remboursement unique (L. 553-2 al. 1)";
    label en unofficial "deductions from future CF, absent single repayment (L. 553-2 para. 1)";
    when dette_recouvrable_cf(p, dette) and retenue_effective_cf(p, base)
        and montant_net_crds_cf(p, echeance) and not_known(fr.pf.core::option_remboursement_unique(p));
    then retenue_appliquee_cf(p);
}

@source(fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
        fr.pf.core::CSS_L553_2_CSS_ED2026_01, fr.pf.core::CSS_L553_2_CSS_ED2026_04,
        fr.pf.core::CSS_L553_2_CSS_ED2026_06)
rule RetenueMontantCf(p: fr.pf.core::Personne, dette: Money, base: Money, echeance: Money) defeasible {
    effective [@2024-01-01, infinity);
    label fr official "retenue CF du mois : prélèvement effectif, plafonné à l'échéance et à la dette";
    label en unofficial "month's CF deduction: effective levy, capped at the echeance and the debt";
    when retenue_appliquee_cf(p) and dette_recouvrable_cf(p, dette)
        and retenue_effective_cf(p, base) and montant_net_crds_cf(p, echeance);
    then retenue_mensuelle_cf(p, retenue_plafonnee(base, echeance, dette));
}

@source(fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
        fr.pf.core::CSS_L553_2_CSS_ED2026_01, fr.pf.core::CSS_L553_2_CSS_ED2026_04,
        fr.pf.core::CSS_L553_2_CSS_ED2026_06)
rule NetVerseCf(p: fr.pf.core::Personne, echeance: Money, retenue: Money) defeasible {
    effective [@2024-01-01, infinity);
    label fr official "CF net après retenue";
    label en unofficial "CF net after deduction";
    when retenue_mensuelle_cf(p, retenue) and montant_net_crds_cf(p, echeance);
    then net_verse_cf(p, net_apres_retenue(echeance, retenue));
}

@source(fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
