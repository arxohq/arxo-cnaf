// --- Y = ARS (L. 553-2 al. 1, PF head, echeance per child) --------------
//
// Annual back-to-school echeance keyed on the child (02 net); same
// monthly-levy mechanics as the other PF heads (single-head-per-case
// contract (d)).

pub relation dette_chargee_ars(p: fr.pf.core::Personne, montant: Money) kind empirical {
    key(p);
    label fr official "dette imputée par la caisse sur l'ARS à échoir, indemnité 10 % incluse en cas de fraude, nette de prescription et d'option unique (L. 553-2 al. 1, contrat d'entrée)";
    label en unofficial "debt charged by the fund to future ARS, 10% indemnity included on fraud, net of prescription and single option (L. 553-2 para. 1, input contract)";
}

pub relation dette_recouvrable_ars(p: fr.pf.core::Personne, montant: Money) kind institutional {
    key(p);
    label fr official "dette recouvrable sur l'ARS (L. 553-2 al. 1)";
    label en unofficial "debt recoverable from ARS (L. 553-2 para. 1)";
}

pub relation retenue_effective_ars(p: fr.pf.core::Personne, montant: Money) kind institutional {
    key(p);
    label fr official "retenue effective sur l'ARS après majoration éventuelle : prélèvement D. 553-1, +50 % fraude, x2 réitération (L. 553-2 al. 3, D. 553-5)";
    label en unofficial "effective ARS retention after any uplift: D. 553-1 levy, +50% fraud, x2 repeat (L. 553-2 para. 3, D. 553-5)";
}

pub relation retenue_appliquee_ars(p: fr.pf.core::Personne) kind institutional {
    label fr official "retenues appliquées sur l'ARS à échoir (L. 553-2 al. 1)";
    label en unofficial "deductions applied to future ARS (L. 553-2 para. 1)";
}

pub relation retenue_mensuelle_ars(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, montant: Money) kind institutional {
    key(p, e);
    label fr official "montant de la retenue sur l'ARS de l'enfant (D. 553-1, L. 553-2 al. 3)";
    label en unofficial "ARS deduction amount for the child (D. 553-1, L. 553-2 para. 3)";
}

pub relation net_verse_ars(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, montant: Money) kind institutional {
    key(p, e);
    label fr official "ARS nette versée après retenue éventuelle";
    label en unofficial "ARS net paid after any deduction";
}

