        fr.pf.core::CSS_D553_5_CSS_ED2021_11, fr.pf.core::CSS_D553_5_CSS_ED2021_12,
        fr.pf.core::CSS_D553_5_CSS_ED2022_01, fr.pf.core::CSS_D553_5_CSS_ED2022_02,
        fr.pf.core::CSS_D553_5_CSS_ED2022_03, fr.pf.core::CSS_D553_5_CSS_ED2022_09,
        fr.pf.core::CSS_D553_5_CSS_ED2023_07, fr.pf.core::CSS_D553_5_CSS_ED2024_01,
        fr.pf.core::CSS_D553_5_CSS_ED2025_02, fr.pf.core::CSS_D553_5_CSS_ED2025_09,
        fr.pf.core::CSS_D553_5_CSS_ED2025_12, fr.pf.core::CSS_D553_5_CSS_ED2026_01,
        fr.pf.core::CSS_D553_5_CSS_ED2026_04, fr.pf.core::CSS_D553_5_CSS_ED2026_06)
rule RetenueReiterationRsa(p: fr.minima.ressources::Personne, base: Money) strict {
    effective [@2024-01-01, infinity);
    label fr official "réitération dans les cinq ans : la majoration de 50 % est doublée (x2,00)";
    label en unofficial "repeat within five years: the 50% uplift is doubled (x2.00)";
    when retenue_mensuelle_rsa_declaree(p, base)
        and fr.casf.rsa::indu_fraude(p) and fraude_repetee_5ans_rsa(p);
    then retenue_effective_rsa(p, retenue_majoree_reiteration(base));
}

@source(fr.casf.rsa::CASF_L262_46, fr.casf.rsa::CASF_L262_46_ED2025_01,
        fr.casf.rsa::CASF_L262_46_ED2025_06, fr.casf.rsa::CASF_L262_46_ED2026_06,
        fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
        fr.pf.core::CSS_L553_2_CSS_ED2026_01, fr.pf.core::CSS_L553_2_CSS_ED2026_04,
        fr.pf.core::CSS_L553_2_CSS_ED2026_06)
rule RetenueAppliqueeRsa(p: fr.minima.ressources::Personne, dette: Money, base: Money, mois: Date, echeance: Money) defeasible {
    effective [@2024-01-01, infinity);
    label fr official "retenues sur le RSA à échoir, sauf remboursement unique (L. 262-46 al. 3)";
    label en unofficial "deductions from future RSA, absent single repayment (L. 262-46 para. 3)";
    when dette_recouvrable_rsa(p, dette) and retenue_effective_rsa(p, base)
        and fr.casf.rsa::allocation_mensuelle(p, mois, echeance)
        and not_known(fr.casf.rsa::remboursement_unique(p));
    then retenue_appliquee_rsa(p);
}

@source(fr.casf.rsa::CASF_L262_46, fr.casf.rsa::CASF_L262_46_ED2025_01,
        fr.casf.rsa::CASF_L262_46_ED2025_06, fr.casf.rsa::CASF_L262_46_ED2026_06,
        fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
        fr.pf.core::CSS_L553_2_CSS_ED2026_01, fr.pf.core::CSS_L553_2_CSS_ED2026_04,
        fr.pf.core::CSS_L553_2_CSS_ED2026_06)
rule RetenueMontantRsa(p: fr.minima.ressources::Personne, dette: Money, base: Money, mois: Date, echeance: Money) defeasible {
    effective [@2024-01-01, infinity);
    label fr official "retenue RSA du mois : prélèvement effectif, plafonné à l'échéance et à la dette";
    label en unofficial "month's RSA deduction: effective levy, capped at the echeance and the debt";
    when retenue_appliquee_rsa(p) and dette_recouvrable_rsa(p, dette)
        and retenue_effective_rsa(p, base) and fr.casf.rsa::allocation_mensuelle(p, mois, echeance);
    then retenue_mensuelle_rsa(p, mois, retenue_plafonnee(base, echeance, dette));
}

@source(fr.casf.rsa::CASF_L262_46, fr.casf.rsa::CASF_L262_46_ED2025_01,
        fr.casf.rsa::CASF_L262_46_ED2025_06, fr.casf.rsa::CASF_L262_46_ED2026_06,
        fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
        fr.pf.core::CSS_L553_2_CSS_ED2026_01, fr.pf.core::CSS_L553_2_CSS_ED2026_04,
        fr.pf.core::CSS_L553_2_CSS_ED2026_06)
rule NetVerseRsa(p: fr.minima.ressources::Personne, mois: Date, echeance: Money, retenue: Money) defeasible {
    effective [@2024-01-01, infinity);
    label fr official "RSA versé : allocation mensuelle moins la retenue";
    label en unofficial "RSA paid: monthly allowance minus the deduction";
    when fr.casf.rsa::allocation_mensuelle(p, mois, echeance) and retenue_mensuelle_rsa(p, mois, retenue);
    then net_verse_rsa(p, mois, net_apres_retenue(echeance, retenue));
}

@source(fr.casf.rsa::CASF_L262_46, fr.casf.rsa::CASF_L262_46_ED2025_01,
        fr.casf.rsa::CASF_L262_46_ED2025_06, fr.casf.rsa::CASF_L262_46_ED2026_06,
        fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
        fr.pf.core::CSS_L553_2_CSS_ED2026_01, fr.pf.core::CSS_L553_2_CSS_ED2026_04,
        fr.pf.core::CSS_L553_2_CSS_ED2026_06)
rule NetSansRetenueRsa(p: fr.minima.ressources::Personne, dette: Money, base: Money, mois: Date, echeance: Money) defeasible {
    effective [@2024-01-01, infinity);
    label fr official "recouvrement écarté : l'échéance de RSA est versée entière";
    label en unofficial "recovery barred: the RSA echeance is paid in full";
    when dette_recouvrable_rsa(p, dette) and retenue_effective_rsa(p, base)
        and fr.casf.rsa::allocation_mensuelle(p, mois, echeance) and not_known(retenue_appliquee_rsa(p));
    then net_verse_rsa(p, mois, echeance);
}

// --- Y = AAH (scale via L. 553-2 scope sentence, pinned) -----------------
// Echeance: imported aah_montant_du (CRDS-exempt; 03 SILENCE, brut
// passes through). Own indu and fraud flag are local inputs: fr.css.aah
// publishes no indu heads yet. NO 10 % indemnity: the sentence sits in
// mirror-only L. 821-5-1 (boundary). NO limitation defeater: L. 821-5
// is pinned but its status is neighbour-owned (session in progress).
// Carried debts: PF (L. 553-2 "titres II et IV du livre VIII"),
// RSA (L. 262-46 "titre II") and PA (L. 845-3 al. 3 "titre II du
// livre VIII") — titre II = AAH per the code hierarchy in ALL
// cases (MIRROR inference, flagged on all three inputs).
// Housing-carried pairs are mirror-only (L. 823-9): reserved.
// The scale MATH below is pinned-grounded: L. 553-2 al. 3 expressly
// covers "les retenues mentionnées à l'article L. 821-5-1". The own-AAH
// recovery permission itself (L. 821-5-1 al. 1) is mirror-only and is
// NOT derived here; the fund asserts it by stating the debt.

pub relation indu_aah_retenu(p: fr.css.aah::Personne, montant: Money) kind empirical {
    key(p);
    label fr official "indu d'AAH imputé sur l'allocation à venir (permission L. 821-5-1 : MIRROR, non épinglé ; la dette reste fund-stated même après épinglage), hors option unique";
    label en unofficial "AAH overpayment charged to the future allowance (L. 821-5-1 permission: MIRROR, unpinned), net of single-repayment option";
}

pub relation indu_aah_frauduleux(p: fr.css.aah::Personne) kind empirical {
    label fr official "l'indu d'AAH résulte d'une fraude du bénéficiaire (fait de l'espèce)";
    label en unofficial "the AAH overpayment results from the beneficiary's fraud (case fact)";
}

pub relation retenue_mensuelle_aah_declaree(p: fr.css.aah::Personne, montant: Money) kind empirical {
    key(p);
    label fr official "montant mensuel du prélèvement appliqué par la caisse selon le barème D. 553-1 (phrase de portée L. 553-2 al. 3, échelle DSS non épinglée : DSS_PENDING)";
    label en unofficial "monthly levy amount applied by the fund under the D. 553-1 scale (L. 553-2 para. 3 scope sentence, DSS scale bytes unpinned: DSS_PENDING)";
}

pub relation fraude_repetee_5ans_aah(p: fr.css.aah::Personne) kind empirical {
    label fr official "réitération de la fraude dans les cinq ans suivant une précédente fraude, fait constaté (L. 553-2 al. 3, phrase de portée)";
    label en unofficial "repeat fraud within five years after a previous fraud, stated fact (L. 553-2 para. 3, scope sentence)";
}

pub relation pf_indu_reporte_sur_aah(p: fr.css.aah::Personne, montant: Money) kind empirical {
    key(p);
    label fr official "indu de prestations familiales imputé sur l'AAH à échoir (L. 553-2 al. 1, titre II : MIRROR, non épinglé), hors option unique";
    label en unofficial "family-benefit overpayment charged to future AAH (L. 553-2 para. 1, title II: MIRROR, unpinned), net of single-repayment option";
}

pub relation rsa_indu_reporte_sur_aah(p: fr.css.aah::Personne, montant: Money) kind empirical {
    key(p);
    label fr official "indu de RSA imputé sur l'AAH à échoir (L. 262-46 al. 4, titre II : MIRROR, non épinglé), hors option unique";
    label en unofficial "RSA overpayment charged to future AAH (L. 262-46 para. 4, title II: MIRROR, unpinned), net of single-repayment option";
}

pub relation pa_indu_reporte_sur_aah(p: fr.css.aah::Personne, montant: Money) kind empirical {
    key(p);
    label fr official "indu de prime d'activité imputé sur l'AAH à échoir (L. 845-3 al. 3, titre II du livre VIII : MIRROR, non épinglé), hors option unique";
    label en unofficial "activity-bonus overpayment charged to future AAH (L. 845-3 para. 3, book VIII title II: MIRROR, unpinned), net of single-repayment option";
}

pub relation report_pf_sur_aah_licite(p: fr.css.aah::Personne) kind empirical {
    label fr official "report PF→AAH licite : aucun report imputé, ou report imputé à défaut de recouvrement sur les prestations familiales et sans option unique PF, fait constaté (L. 553-2 al. 1 « à défaut », destination MIRROR)";
    label en unofficial "lawful PF→AAH carry: no carry charged, or carry charged for want of family-benefit recovery with no PF single option, stated fact (L. 553-2 para. 1 'à défaut', MIRROR destination)";
}

pub relation report_rsa_sur_aah_licite(p: fr.css.aah::Personne) kind empirical {
    label fr official "report RSA→AAH licite : aucun report imputé, ou report imputé à défaut de recouvrement sur le RSA et sans option unique RSA, fait constaté (L. 262-46 al. 4 « à défaut », destination MIRROR)";
    label en unofficial "lawful RSA→AAH carry: no carry charged, or carry charged for want of RSA recovery with no RSA single option, stated fact (L. 262-46 para. 4 'à défaut', MIRROR destination)";
}

pub relation report_pa_sur_aah_licite(p: fr.css.aah::Personne) kind empirical {
    label fr official "report PA→AAH licite : aucun report imputé, ou report imputé à défaut de recouvrement sur la prime et sans option unique PA, fait constaté (L. 845-3 al. 3 « à défaut », destination MIRROR)";
    label en unofficial "lawful PA→AAH carry: no carry charged, or carry charged for want of bonus recovery with no PA single option, stated fact (L. 845-3 para. 3 'à défaut', MIRROR destination)";
}

pub relation dette_recouvrable_aah(p: fr.css.aah::Personne, montant: Money) kind institutional {
    key(p);
    label fr official "dette totale imputée sur l'échéance d'AAH du mois (indu AAH + reports PF, RSA et PA)";
    label en unofficial "total debt charged to the month's AAH echeance (AAH indu + PF, RSA and PA carries)";
}

pub relation retenue_effective_aah(p: fr.css.aah::Personne, montant: Money) kind institutional {
    key(p);
    label fr official "retenue mensuelle effective sur l'AAH après majoration éventuelle : barème D. 553-1, +50 % fraude, x2 réitération (L. 553-2 al. 3, D. 553-5)";
    label en unofficial "effective monthly AAH retention after any uplift: D. 553-1 scale, +50% fraud, x2 repeat (L. 553-2 para. 3, D. 553-5)";
}

pub relation retenue_appliquee_aah(p: fr.css.aah::Personne) kind institutional {
    key(p);
    label fr official "le recouvrement par retenues s'applique à l'échéance d'AAH";
    label en unofficial "recovery by deductions applies to the AAH echeance";
}

pub relation retenue_mensuelle_aah(p: fr.css.aah::Personne, montant: Money) kind institutional {
    key(p);
    label fr official "retenue mensuelle prélevée sur l'échéance d'AAH";
    label en unofficial "monthly deduction taken from the AAH echeance";
}

pub relation net_verse_aah(p: fr.css.aah::Personne, montant: Money) kind institutional {
    key(p);
    label fr official "montant d'AAH versé après retenue";
    label en unofficial "AAH amount paid after deduction";
}

@source(fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
        fr.pf.core::CSS_L553_2_CSS_ED2026_01, fr.pf.core::CSS_L553_2_CSS_ED2026_04,
        fr.pf.core::CSS_L553_2_CSS_ED2026_06, fr.casf.rsa::CASF_L262_46,
        fr.casf.rsa::CASF_L262_46_ED2025_01, fr.casf.rsa::CASF_L262_46_ED2025_06,
        fr.casf.rsa::CASF_L262_46_ED2026_06,
        fr.css.prime_activite::CSS_L845_3_ED2024_01_01,
        fr.css.prime_activite::CSS_L845_3_ED2025_01_01,
        fr.css.prime_activite::CSS_L845_3_ED2025_02_28,
        fr.css.prime_activite::CSS_L845_3_ED2025_03_31,
        fr.css.prime_activite::CSS_L845_3_ED2026_04_01)
rule DetteAah(p: fr.css.aah::Personne, indu: Money, pf: Money, rsa: Money, pa: Money) strict {
    effective [@2024-01-01, infinity);
    label fr official "dette AAH : indu AAH + reports PF, RSA et PA (MIRROR, listes L. 553-2 al. 1, L. 262-46 al. 4, L. 845-3 al. 3)";
    label en unofficial "AAH debt: AAH indu + PF, RSA and PA carries (MIRROR, L. 553-2 para. 1, L. 262-46 para. 4, L. 845-3 para. 3 lists)";
    when indu_aah_retenu(p, indu) and pf_indu_reporte_sur_aah(p, pf)
        and rsa_indu_reporte_sur_aah(p, rsa) and pa_indu_reporte_sur_aah(p, pa)
        and report_pf_sur_aah_licite(p) and report_rsa_sur_aah_licite(p)
        and report_pa_sur_aah_licite(p);
    then dette_recouvrable_aah(p, dette_totale4(indu, pf, rsa, pa));
}

@source(fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
        fr.pf.core::CSS_L553_2_CSS_ED2026_01, fr.pf.core::CSS_L553_2_CSS_ED2026_04,
        fr.pf.core::CSS_L553_2_CSS_ED2026_06)
rule RetenueBaseAah(p: fr.css.aah::Personne, base: Money) strict {
    effective [@2024-01-01, infinity);
    label fr official "hors fraude : le prélèvement mensuel déclaré s'applique sans majoration";
    label en unofficial "without fraud: the stated monthly levy applies without uplift";
    when retenue_mensuelle_aah_declaree(p, base) and not_known(indu_aah_frauduleux(p));
    then retenue_effective_aah(p, base);
}

@source(fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
