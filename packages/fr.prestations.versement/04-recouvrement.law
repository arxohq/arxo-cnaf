        fr.casf.rsa::CASF_L262_46_ED2026_06)
rule RetenueMontantAah(p: fr.css.aah::Personne, dette: Money, base: Money, echeance: Money) defeasible {
    effective [@2024-01-01, infinity);
    label fr official "retenue AAH du mois : prélèvement effectif, plafonné à l'échéance et à la dette";
    label en unofficial "month's AAH deduction: effective levy, capped at the echeance and the debt";
    when retenue_appliquee_aah(p) and dette_recouvrable_aah(p, dette)
        and retenue_effective_aah(p, base) and fr.css.aah::aah_montant_du(p, echeance);
    then retenue_mensuelle_aah(p, retenue_plafonnee(base, echeance, dette));
}

@source(fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
        fr.pf.core::CSS_L553_2_CSS_ED2026_01, fr.pf.core::CSS_L553_2_CSS_ED2026_04,
        fr.pf.core::CSS_L553_2_CSS_ED2026_06, fr.casf.rsa::CASF_L262_46,
        fr.casf.rsa::CASF_L262_46_ED2025_01, fr.casf.rsa::CASF_L262_46_ED2025_06,
        fr.casf.rsa::CASF_L262_46_ED2026_06)
rule NetVerseAah(p: fr.css.aah::Personne, echeance: Money, retenue: Money) defeasible {
    effective [@2024-01-01, infinity);
    label fr official "AAH versée : montant dû moins la retenue";
    label en unofficial "AAH paid: amount due minus the deduction";
    when fr.css.aah::aah_montant_du(p, echeance) and retenue_mensuelle_aah(p, retenue);
    then net_verse_aah(p, net_apres_retenue(echeance, retenue));
}

// NO full-payment witness for AAH (CH2-7): the application rule has
// no negative condition and no defeater exists, so a NetSans rule
// could never fire. Without a stated debt the layer is silent
// (contract (e)); the echeance is paid whole outside this layer,
// as in the RSA suspensif case.

// --- Y = housing (APL/ALF/ALS; scale via L. 553-2, pinned) ---------------
// Echeance: imported fr.apl.versement::montant_verse (final net: CRDS,
// floor and rounding already applied by the neighbour). Own indu and
// fraud flag are local inputs. NO 10 % indemnity: it reaches housing
// only through the mirror-only L. 823-9 renvoi (boundary). NO
// limitation defeater is possible: housing limitation is SILENCE in
// the current CCH (see header). Carried debts: PF (L. 553-2 al. 1
// cites CCH L. 821-1 directly), RSA (L. 262-46 al. 4 cites CCH
// L. 821-1 directly) and PA (L. 845-3 al. 3 cites APL and CCH
// livre VIII housing aid directly, pinned, FINISH-W2 cascade
// follow-up). AAH-carried pairs are mirror-only (L. 821-5-1):
// reserved. The own-housing recovery permission
// (L. 823-9) is mirror-only and NOT derived; the fund asserts it by
// stating the debt. The scale MATH is pinned-grounded (L. 553-2 al. 3
// covers L. 823-9 retenues).

pub relation indu_logement_retenu(m: fr.apl::Menage, montant: Money) kind empirical {
    key(m);
    label fr official "indu d'aide au logement imputé sur l'aide à venir (permission L. 823-9 : MIRROR, non épinglé ; la dette reste fund-stated même après épinglage), hors option unique";
    label en unofficial "housing-aid overpayment charged to future aid (L. 823-9 permission: MIRROR, unpinned), net of single-repayment option";
}

pub relation indu_logement_frauduleux(m: fr.apl::Menage) kind empirical {
    label fr official "l'indu d'aide au logement résulte d'une fraude du bénéficiaire (fait de l'espèce)";
    label en unofficial "the housing-aid overpayment results from the beneficiary's fraud (case fact)";
}

pub relation retenue_mensuelle_logement_declaree(m: fr.apl::Menage, montant: Money) kind empirical {
    key(m);
    label fr official "montant mensuel du prélèvement appliqué par la caisse selon le barème D. 553-1 (phrase de portée L. 553-2 al. 3, CCH L. 823-9, échelle DSS non épinglée : DSS_PENDING)";
    label en unofficial "monthly levy amount applied by the fund under the D. 553-1 scale (L. 553-2 para. 3 scope sentence, CCH L. 823-9, DSS scale bytes unpinned: DSS_PENDING)";
}

pub relation fraude_repetee_5ans_logement(m: fr.apl::Menage) kind empirical {
    label fr official "réitération de la fraude dans les cinq ans suivant une précédente fraude, fait constaté (L. 553-2 al. 3, phrase de portée)";
    label en unofficial "repeat fraud within five years after a previous fraud, stated fact (L. 553-2 para. 3, scope sentence)";
}

pub relation pf_indu_reporte_sur_logement(m: fr.apl::Menage, montant: Money) kind empirical {
    key(m);
    label fr official "indu de prestations familiales imputé sur l'aide au logement à échoir (L. 553-2 al. 1, CCH L. 821-1), hors option unique";
    label en unofficial "family-benefit overpayment charged to future housing aid (L. 553-2 para. 1, CCH L. 821-1), net of single-repayment option";
}

pub relation rsa_indu_reporte_sur_logement(m: fr.apl::Menage, montant: Money) kind empirical {
    key(m);
    label fr official "indu de RSA imputé sur l'aide au logement à échoir (L. 262-46 al. 4, CCH L. 821-1), hors option unique";
    label en unofficial "RSA overpayment charged to future housing aid (L. 262-46 para. 4, CCH L. 821-1), net of single-repayment option";
}

pub relation pa_indu_reporte_sur_logement(m: fr.apl::Menage, montant: Money) kind empirical {
    key(m);
    label fr official "indu de prime d'activité imputé sur l'aide au logement à échoir (L. 845-3 al. 3, APL et allocations de logement CCH livre VIII), hors option unique";
    label en unofficial "activity-bonus overpayment charged to future housing aid (L. 845-3 para. 3, APL and CCH book VIII housing aid), net of single-repayment option";
}

pub relation report_pf_sur_logement_licite(m: fr.apl::Menage) kind empirical {
    label fr official "report PF→logement licite : aucun report imputé, ou report imputé à défaut de recouvrement sur les prestations familiales et sans option unique PF, fait constaté (L. 553-2 al. 1 « à défaut »)";
    label en unofficial "lawful PF→housing carry: no carry charged, or carry charged for want of family-benefit recovery with no PF single option, stated fact (L. 553-2 para. 1 'à défaut')";
}

pub relation report_rsa_sur_logement_licite(m: fr.apl::Menage) kind empirical {
    label fr official "report RSA→logement licite : aucun report imputé, ou report imputé à défaut de recouvrement sur le RSA et sans option unique RSA, fait constaté (L. 262-46 al. 4 « à défaut »)";
    label en unofficial "lawful RSA→housing carry: no carry charged, or carry charged for want of RSA recovery with no RSA single option, stated fact (L. 262-46 para. 4 'à défaut')";
}

pub relation report_pa_sur_logement_licite(m: fr.apl::Menage) kind empirical {
    label fr official "report PA→logement licite : aucun report imputé, ou report imputé à défaut de recouvrement sur la prime et sans option unique PA, fait constaté (L. 845-3 al. 3 « à défaut »)";
    label en unofficial "lawful PA→housing carry: no carry charged, or carry charged for want of bonus recovery with no PA single option, stated fact (L. 845-3 para. 3 'à défaut')";
}

pub relation dette_recouvrable_logement(m: fr.apl::Menage, montant: Money) kind institutional {
    key(m);
    label fr official "dette totale imputée sur l'échéance d'aide au logement du mois (indu logement + reports PF, RSA et PA)";
    label en unofficial "total debt charged to the month's housing-aid echeance (housing indu + PF, RSA and PA carries)";
}

pub relation retenue_effective_logement(m: fr.apl::Menage, montant: Money) kind institutional {
    key(m);
    label fr official "retenue mensuelle effective sur l'aide au logement après majoration éventuelle : barème D. 553-1, +50 % fraude, x2 réitération (L. 553-2 al. 3, D. 553-5)";
    label en unofficial "effective monthly housing-aid retention after any uplift: D. 553-1 scale, +50% fraud, x2 repeat (L. 553-2 para. 3, D. 553-5)";
}

pub relation retenue_appliquee_logement(m: fr.apl::Menage) kind institutional {
    key(m);
    label fr official "le recouvrement par retenues s'applique à l'échéance d'aide au logement";
    label en unofficial "recovery by deductions applies to the housing-aid echeance";
}

pub relation retenue_mensuelle_logement(m: fr.apl::Menage, montant: Money) kind institutional {
    key(m);
    label fr official "retenue mensuelle prélevée sur l'échéance d'aide au logement";
    label en unofficial "monthly deduction taken from the housing-aid echeance";
}

pub relation net_verse_logement(m: fr.apl::Menage, montant: Money) kind institutional {
    key(m);
    label fr official "montant d'aide au logement versé après retenue";
    label en unofficial "housing-aid amount paid after deduction";
}

@source(fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
        fr.pf.core::CSS_L553_2_CSS_ED2026_01, fr.pf.core::CSS_L553_2_CSS_ED2026_04,
        fr.pf.core::CSS_L553_2_CSS_ED2026_06, fr.casf.rsa::CASF_L262_46,
        fr.casf.rsa::CASF_L262_46_ED2025_01, fr.casf.rsa::CASF_L262_46_ED2025_06,
        fr.casf.rsa::CASF_L262_46_ED2026_06,
        fr.css.prime_activite::CSS_L845_3_ED2024_01_01,
        fr.css.prime_activite::CSS_L845_3_ED2025_01_01,
        fr.css.prime_activite::CSS_L845_3_ED2025_02_28,
        fr.css.prime_activite::CSS_L845_3_ED2025_03_31,
        fr.css.prime_activite::CSS_L845_3_ED2026_04_01)
rule DetteLogement(m: fr.apl::Menage, indu: Money, pf: Money, rsa: Money, pa: Money) strict {
    effective [@2024-01-01, infinity);
    label fr official "dette logement : indu logement + reports PF, RSA et PA (listes L. 553-2 al. 1, L. 262-46 al. 4, L. 845-3 al. 3)";
    label en unofficial "housing debt: housing indu + PF, RSA and PA carries (L. 553-2 para. 1, L. 262-46 para. 4, L. 845-3 para. 3 lists)";
    when indu_logement_retenu(m, indu) and pf_indu_reporte_sur_logement(m, pf)
        and rsa_indu_reporte_sur_logement(m, rsa) and pa_indu_reporte_sur_logement(m, pa)
        and report_pf_sur_logement_licite(m) and report_rsa_sur_logement_licite(m)
        and report_pa_sur_logement_licite(m);
    then dette_recouvrable_logement(m, dette_totale4(indu, pf, rsa, pa));
}

@source(fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
        fr.pf.core::CSS_L553_2_CSS_ED2026_01, fr.pf.core::CSS_L553_2_CSS_ED2026_04,
        fr.pf.core::CSS_L553_2_CSS_ED2026_06)
rule RetenueBaseLogement(m: fr.apl::Menage, base: Money) strict {
    effective [@2024-01-01, infinity);
    label fr official "hors fraude : le prélèvement mensuel déclaré s'applique sans majoration";
    label en unofficial "without fraud: the stated monthly levy applies without uplift";
    when retenue_mensuelle_logement_declaree(m, base) and not_known(indu_logement_frauduleux(m));
    then retenue_effective_logement(m, base);
}

@source(fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
        fr.pf.core::CSS_L553_2_CSS_ED2026_01, fr.pf.core::CSS_L553_2_CSS_ED2026_04,
        fr.pf.core::CSS_L553_2_CSS_ED2026_06,
        fr.pf.core::CSS_D553_5, fr.pf.core::CSS_D553_5_CSS_ED2021_05,
        fr.pf.core::CSS_D553_5_CSS_ED2021_11, fr.pf.core::CSS_D553_5_CSS_ED2021_12,
        fr.pf.core::CSS_D553_5_CSS_ED2022_01, fr.pf.core::CSS_D553_5_CSS_ED2022_02,
        fr.pf.core::CSS_D553_5_CSS_ED2022_03, fr.pf.core::CSS_D553_5_CSS_ED2022_09,
        fr.pf.core::CSS_D553_5_CSS_ED2023_07, fr.pf.core::CSS_D553_5_CSS_ED2024_01,
        fr.pf.core::CSS_D553_5_CSS_ED2025_02, fr.pf.core::CSS_D553_5_CSS_ED2025_09,
        fr.pf.core::CSS_D553_5_CSS_ED2025_12, fr.pf.core::CSS_D553_5_CSS_ED2026_01,
        fr.pf.core::CSS_D553_5_CSS_ED2026_04, fr.pf.core::CSS_D553_5_CSS_ED2026_06)
rule RetenueFraudeLogement(m: fr.apl::Menage, base: Money) defeasible {
    effective [@2024-01-01, infinity);
    label fr official "en cas de fraude : majoration fixe de 50 % du prélèvement (pouvoir du directeur, D. 553-5)";
    label en unofficial "on fraud: fixed 50% uplift of the levy (director's power, D. 553-5)";
    when retenue_mensuelle_logement_declaree(m, base)
        and indu_logement_frauduleux(m) and not_known(fraude_repetee_5ans_logement(m));
    then retenue_effective_logement(m, retenue_majoree_fraude(base));
}

@source(fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
        fr.pf.core::CSS_L553_2_CSS_ED2026_01, fr.pf.core::CSS_L553_2_CSS_ED2026_04,
        fr.pf.core::CSS_L553_2_CSS_ED2026_06,
        fr.pf.core::CSS_D553_5, fr.pf.core::CSS_D553_5_CSS_ED2021_05,
        fr.pf.core::CSS_D553_5_CSS_ED2021_11, fr.pf.core::CSS_D553_5_CSS_ED2021_12,
        fr.pf.core::CSS_D553_5_CSS_ED2022_01, fr.pf.core::CSS_D553_5_CSS_ED2022_02,
        fr.pf.core::CSS_D553_5_CSS_ED2022_03, fr.pf.core::CSS_D553_5_CSS_ED2022_09,
        fr.pf.core::CSS_D553_5_CSS_ED2023_07, fr.pf.core::CSS_D553_5_CSS_ED2024_01,
        fr.pf.core::CSS_D553_5_CSS_ED2025_02, fr.pf.core::CSS_D553_5_CSS_ED2025_09,
        fr.pf.core::CSS_D553_5_CSS_ED2025_12, fr.pf.core::CSS_D553_5_CSS_ED2026_01,
        fr.pf.core::CSS_D553_5_CSS_ED2026_04, fr.pf.core::CSS_D553_5_CSS_ED2026_06)
rule RetenueReiterationLogement(m: fr.apl::Menage, base: Money) strict {
    effective [@2024-01-01, infinity);
    label fr official "réitération dans les cinq ans : la majoration de 50 % est doublée (x2,00)";
    label en unofficial "repeat within five years: the 50% uplift is doubled (x2.00)";
    when retenue_mensuelle_logement_declaree(m, base)
        and indu_logement_frauduleux(m) and fraude_repetee_5ans_logement(m);
    then retenue_effective_logement(m, retenue_majoree_reiteration(base));
}

@source(fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
        fr.pf.core::CSS_L553_2_CSS_ED2026_01, fr.pf.core::CSS_L553_2_CSS_ED2026_04,
        fr.pf.core::CSS_L553_2_CSS_ED2026_06, fr.casf.rsa::CASF_L262_46,
        fr.casf.rsa::CASF_L262_46_ED2025_01, fr.casf.rsa::CASF_L262_46_ED2025_06,
        fr.casf.rsa::CASF_L262_46_ED2026_06)
rule RetenueAppliqueeLogement(m: fr.apl::Menage, dette: Money, base: Money, echeance: Money) defeasible {
    effective [@2024-01-01, infinity);
    label fr official "retenues sur l'aide au logement à échoir";
    label en unofficial "deductions from future housing aid";
    when dette_recouvrable_logement(m, dette) and retenue_effective_logement(m, base)
        and fr.apl.versement::montant_verse(m, echeance);
    then retenue_appliquee_logement(m);
}

@source(fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
        fr.pf.core::CSS_L553_2_CSS_ED2026_01, fr.pf.core::CSS_L553_2_CSS_ED2026_04,
        fr.pf.core::CSS_L553_2_CSS_ED2026_06, fr.casf.rsa::CASF_L262_46,
        fr.casf.rsa::CASF_L262_46_ED2025_01, fr.casf.rsa::CASF_L262_46_ED2025_06,
        fr.casf.rsa::CASF_L262_46_ED2026_06)
rule RetenueMontantLogement(m: fr.apl::Menage, dette: Money, base: Money, echeance: Money) defeasible {
    effective [@2024-01-01, infinity);
    label fr official "retenue logement du mois : prélèvement effectif, plafonné à l'échéance et à la dette";
    label en unofficial "month's housing deduction: effective levy, capped at the echeance and the debt";
    when retenue_appliquee_logement(m) and dette_recouvrable_logement(m, dette)
        and retenue_effective_logement(m, base) and fr.apl.versement::montant_verse(m, echeance);
    then retenue_mensuelle_logement(m, retenue_plafonnee(base, echeance, dette));
}

@source(fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
        fr.pf.core::CSS_L553_2_CSS_ED2026_01, fr.pf.core::CSS_L553_2_CSS_ED2026_04,
        fr.pf.core::CSS_L553_2_CSS_ED2026_06, fr.casf.rsa::CASF_L262_46,
        fr.casf.rsa::CASF_L262_46_ED2025_01, fr.casf.rsa::CASF_L262_46_ED2025_06,
        fr.casf.rsa::CASF_L262_46_ED2026_06)
rule NetVerseLogement(m: fr.apl::Menage, echeance: Money, retenue: Money) defeasible {
    effective [@2024-01-01, infinity);
    label fr official "aide au logement versée : montant net moins la retenue";
    label en unofficial "housing aid paid: net amount minus the deduction";
    when fr.apl.versement::montant_verse(m, echeance) and retenue_mensuelle_logement(m, retenue);
    then net_verse_logement(m, net_apres_retenue(echeance, retenue));
}

// NO full-payment witness for housing either (CH2-7): same reason
// as AAH — the application rule is unconditional, so a witness
// could never fire. Silence per contract (e).

// --- Y = PA (prime d'activité; RSA pattern on the served quarter) -----
// Echeance: imported prime_due_trimestre (served quarterly average;
// neighbour applies the minimum-payment floor, L. 842-3 last al.;
// no CRDS net for PA — B-PV-PA-CRDS). Own debt: imported
// indu_recupere — the neighbour's 04 chain (limitation via L. 845-4
// → L. 553-1, no suspensive appeal, decree floor and remise upstream)
// is consumed, never re-derived (D-V1). The 10 % fraud indemnity is
// imported too (fr.css.prime_activite::indemnite_fraude). Carried
// debt: RSA indu only (L. 262-46 al. 4 cites L. 841-1, pinned).
// PF→PA via the L. 553-2 "titre IV" inference is MIRROR (reserved);
// AAH/housing→PA pairs are mirror-only (L. 821-5-1/L. 823-9,
// reserved). PA-source carries onto AF/RSA/AAH/housing are WIRED
// (pa_indu_reporte_sur_* on those echeances, same L. 845-3 al. 3).
// The single-repayment option conditions the
// application rule directly (Q2 symmetry with PF/RSA). No appeal or
// prescription defeater: both arrive pre-encoded in indu_recupere
// (neighbour InduRecupere requires not_known of each).
// GRANULARITY (B-PV-PA-TRIMESTRE): the echeance is the quarterly
// served amount, so retenue/net are keyed (d) like AAH, not (d, mois)
// like RSA; monthly apportionment of the served quarter is
// unmodelled (no neighbour head).

pub relation retenue_trimestrielle_pa_declaree(d: fr.css.prime_activite::Demandeur, montant: Money) kind empirical {
    key(d);
    label fr official "montant du prélèvement sur l'échéance trimestrielle appliqué par la caisse selon le barème D. 553-1 (renvoi L. 845-3, échelle DSS non épinglée : DSS_PENDING)";
    label en unofficial "levy amount on the quarterly echeance applied by the fund under the D. 553-1 scale (L. 845-3 renvoi, DSS scale bytes unpinned: DSS_PENDING)";
}

pub relation fraude_repetee_5ans_pa(d: fr.css.prime_activite::Demandeur) kind empirical {
    label fr official "réitération de la fraude dans les cinq ans suivant une précédente fraude, fait constaté (L. 553-2 al. 3 via renvoi L. 845-3)";
    label en unofficial "repeat fraud within five years after a previous fraud, stated fact (L. 553-2 para. 3 via L. 845-3 renvoi)";
}

pub relation rsa_indu_reporte_sur_pa(d: fr.css.prime_activite::Demandeur, montant: Money) kind empirical {
    key(d);
    label fr official "indu de RSA imputé par la caisse sur la prime à échoir (L. 262-46 al. 4, L. 841-1), hors option unique";
    label en unofficial "RSA overpayment charged by the fund to the future bonus (L. 262-46 para. 4, L. 841-1), net of single-repayment option";
}

pub relation report_rsa_sur_pa_licite(d: fr.css.prime_activite::Demandeur) kind empirical {
    label fr official "report RSA→PA licite : aucun report imputé, ou report imputé à défaut de recouvrement sur le RSA et sans option unique RSA, fait constaté (L. 262-46 al. 4 « à défaut »)";
    label en unofficial "lawful RSA→PA carry: no carry charged, or carry charged for want of RSA recovery with no RSA single option, stated fact (L. 262-46 para. 4 'à défaut')";
}

pub relation dette_recouvrable_pa(d: fr.css.prime_activite::Demandeur, montant: Money) kind institutional {
    key(d);
    label fr official "dette totale imputée sur l'échéance de prime du trimestre (indu PA + report RSA)";
    label en unofficial "total debt charged to the quarter's bonus echeance (PA indu + RSA carry)";
}

pub relation retenue_effective_pa(d: fr.css.prime_activite::Demandeur, montant: Money) kind institutional {
    key(d);
    label fr official "retenue effective sur la prime après majoration éventuelle : barème D. 553-1, +50 % fraude, x2 réitération (L. 845-3, renvoi L. 553-2 al. 3, D. 553-5)";
    label en unofficial "effective bonus retention after any uplift: D. 553-1 scale, +50% fraud, x2 repeat (L. 845-3, renvoi to L. 553-2 para. 3, D. 553-5)";
}

pub relation retenue_appliquee_pa(d: fr.css.prime_activite::Demandeur) kind institutional {
    key(d);
    label fr official "le recouvrement par retenues s'applique à l'échéance de prime (option unique non exercée)";
    label en unofficial "recovery by deductions applies to the bonus echeance (single-repayment option not taken)";
}

pub relation retenue_mensuelle_pa(d: fr.css.prime_activite::Demandeur, montant: Money) kind institutional {
    key(d);
    label fr official "retenue prélevée sur l'échéance de prime servie";
    label en unofficial "deduction taken from the served bonus echeance";
}

pub relation net_verse_pa(d: fr.css.prime_activite::Demandeur, montant: Money) kind institutional {
    key(d);
    label fr official "montant de prime versé après retenue (ou échéance entière si le recouvrement est écarté)";
    label en unofficial "bonus amount paid after deduction (or the full echeance when recovery is barred)";
}

@source(fr.css.prime_activite::CSS_L845_3_ED2024_01_01,
        fr.css.prime_activite::CSS_L845_3_ED2025_01_01,
        fr.css.prime_activite::CSS_L845_3_ED2025_02_28,
        fr.css.prime_activite::CSS_L845_3_ED2025_03_31,
        fr.css.prime_activite::CSS_L845_3_ED2026_04_01,
        fr.casf.rsa::CASF_L262_46, fr.casf.rsa::CASF_L262_46_ED2025_01,
        fr.casf.rsa::CASF_L262_46_ED2025_06, fr.casf.rsa::CASF_L262_46_ED2026_06)
rule DettePaNonFraude(d: fr.css.prime_activite::Demandeur, indu: Money, reporte: Money) strict {
    effective [@2024-01-01, infinity);
    label fr official "dette PA hors fraude : indu recouvré + report RSA (L. 845-3 al. 3, L. 262-46 al. 4)";
    label en unofficial "PA debt without fraud: recovered indu + RSA carry (L. 845-3 para. 3, L. 262-46 para. 4)";
    when fr.css.prime_activite::indu_recupere(d, indu) and rsa_indu_reporte_sur_pa(d, reporte)
        and report_rsa_sur_pa_licite(d)
        and not_known(fr.css.prime_activite::indu_frauduleux(d));
    then dette_recouvrable_pa(d, dette_totale2(indu, reporte));
}

@source(fr.css.prime_activite::CSS_L845_3_ED2024_01_01,
        fr.css.prime_activite::CSS_L845_3_ED2025_01_01,
        fr.css.prime_activite::CSS_L845_3_ED2025_02_28,
        fr.css.prime_activite::CSS_L845_3_ED2025_03_31,
        fr.css.prime_activite::CSS_L845_3_ED2026_04_01,
        fr.casf.rsa::CASF_L262_46, fr.casf.rsa::CASF_L262_46_ED2025_01,
        fr.casf.rsa::CASF_L262_46_ED2025_06, fr.casf.rsa::CASF_L262_46_ED2026_06)
rule DettePaFraude(d: fr.css.prime_activite::Demandeur, indu: Money, reporte: Money, indemnite: Money) strict {
    effective [@2024-01-01, infinity);
    label fr official "dette PA en cas de fraude : indu recouvré + indemnité 10 % + report RSA";
    label en unofficial "PA debt on fraud: recovered indu + 10% indemnity + RSA carry";
    when fr.css.prime_activite::indu_recupere(d, indu) and rsa_indu_reporte_sur_pa(d, reporte)
        and report_rsa_sur_pa_licite(d)
        and fr.css.prime_activite::indu_frauduleux(d) and fr.css.prime_activite::indemnite_fraude(d, indemnite);
    then dette_recouvrable_pa(d, dette_totale3(indu, reporte, indemnite));
}

// Scale mechanics reach PA through the pinned renvoi ("Les retenues
// ... sont déterminées en application des règles prévues au troisième
// alinéa de l'article L. 553-2"), so both fragments ground these rules.

@source(fr.css.prime_activite::CSS_L845_3_ED2024_01_01,
        fr.css.prime_activite::CSS_L845_3_ED2025_01_01,
        fr.css.prime_activite::CSS_L845_3_ED2025_02_28,
        fr.css.prime_activite::CSS_L845_3_ED2025_03_31,
        fr.css.prime_activite::CSS_L845_3_ED2026_04_01,
        fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
        fr.pf.core::CSS_L553_2_CSS_ED2026_01, fr.pf.core::CSS_L553_2_CSS_ED2026_04,
        fr.pf.core::CSS_L553_2_CSS_ED2026_06)
rule RetenueBasePa(d: fr.css.prime_activite::Demandeur, base: Money) strict {
    effective [@2024-01-01, infinity);
    label fr official "hors fraude : le prélèvement déclaré s'applique sans majoration";
    label en unofficial "without fraud: the stated levy applies without uplift";
    when retenue_trimestrielle_pa_declaree(d, base) and not_known(fr.css.prime_activite::indu_frauduleux(d));
    then retenue_effective_pa(d, base);
}

// "Peut majorer" stays defeasible, mirroring the PF rule; the uplift
// is the FIXED 50 % of D. 553-5 (x1.50), repeat doubling governed by
// the stated 5-year repeat status (strict rule below).

@source(fr.css.prime_activite::CSS_L845_3_ED2024_01_01,
