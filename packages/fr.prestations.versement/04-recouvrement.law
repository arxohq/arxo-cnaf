        fr.pf.core::CSS_D553_5, fr.pf.core::CSS_D553_5_CSS_ED2021_05,
        fr.pf.core::CSS_D553_5_CSS_ED2021_11, fr.pf.core::CSS_D553_5_CSS_ED2021_12,
        fr.pf.core::CSS_D553_5_CSS_ED2022_01, fr.pf.core::CSS_D553_5_CSS_ED2022_02,
        fr.pf.core::CSS_D553_5_CSS_ED2022_03, fr.pf.core::CSS_D553_5_CSS_ED2022_09,
        fr.pf.core::CSS_D553_5_CSS_ED2023_07, fr.pf.core::CSS_D553_5_CSS_ED2024_01,
        fr.pf.core::CSS_D553_5_CSS_ED2025_02, fr.pf.core::CSS_D553_5_CSS_ED2025_09,
        fr.pf.core::CSS_D553_5_CSS_ED2025_12, fr.pf.core::CSS_D553_5_CSS_ED2026_01,
        fr.pf.core::CSS_D553_5_CSS_ED2026_04, fr.pf.core::CSS_D553_5_CSS_ED2026_06)
rule RetenueFraudeArs(p: fr.pf.core::Personne, base: Money) defeasible {
    effective [@2024-01-01, infinity);
    label fr official "en cas de fraude : majoration fixe de 50 % du prélèvement (pouvoir du directeur, L. 553-2 al. 3, D. 553-5)";
    label en unofficial "on fraud: fixed 50% uplift of the levy (director's power, L. 553-2 para. 3, D. 553-5)";
    when prelevement_mensuel(p, base)
        and fr.pf.core::indu_frauduleux(p) and not_known(fr.pf.core::fraude_reiteree(p));
    then retenue_effective_ars(p, retenue_majoree_fraude(base));
}

@source(fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
        fr.pf.core::CSS_L553_2_CSS_ED2026_01, fr.pf.core::CSS_L553_2_CSS_ED2026_04,
        fr.pf.core::CSS_L553_2_CSS_ED2026_06,
        fr.pf.core::CSS_D553_5, fr.pf.core::CSS_D553_5_CSS_ED2021_05,
        fr.pf.core::CSS_D553_5_CSS_ED2021_11, fr.pf.core::CSS_D553_5_CSS_ED2021_12,
        fr.pf.core::CSS_D553_5_CSS_ED2022_01, fr.pf.core::CSS_D553_5_CSS_ED2022_02,
        fr.pf.core::CSS_D553_5_CSS_ED2022_03, fr.pf.core::CSS_D553_5_CSS_ED2022_09,
        fr.pf.core::CSS_D553_5_CSS_ED2023_07, fr.pf.core::CSS_D553_5_CSS_ED2024_01,
        fr.pf.core::CSS_D553_5_CSS_ED2025_02, fr.pf.core::CSS_D553_5_CSS_ED2025_09,
        fr.pf.core::CSS_D553_5_CSS_ED2025_12, fr.pf.core::CSS_D553_5_CSS_ED2026_01,
        fr.pf.core::CSS_D553_5_CSS_ED2026_04, fr.pf.core::CSS_D553_5_CSS_ED2026_06)
rule RetenueReiterationArs(p: fr.pf.core::Personne, base: Money) strict {
    effective [@2024-01-01, infinity);
    label fr official "réitération dans les cinq ans : la majoration de 50 % est doublée (x2,00)";
    label en unofficial "repeat within five years: the 50% uplift is doubled (x2.00)";
    when prelevement_mensuel(p, base)
        and fr.pf.core::indu_frauduleux(p) and fr.pf.core::fraude_reiteree(p);
    then retenue_effective_ars(p, retenue_majoree_reiteration(base));
}

@source(fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
        fr.pf.core::CSS_L553_2_CSS_ED2026_01, fr.pf.core::CSS_L553_2_CSS_ED2026_04,
        fr.pf.core::CSS_L553_2_CSS_ED2026_06)
rule RetenueAppliqueeArs(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, dette: Money, base: Money, echeance: Money) defeasible {
    effective [@2024-01-01, infinity);
    label fr official "retenues sur l'ARS à échoir, sauf remboursement unique (L. 553-2 al. 1)";
    label en unofficial "deductions from future ARS, absent single repayment (L. 553-2 para. 1)";
    when dette_recouvrable_ars(p, dette) and retenue_effective_ars(p, base)
        and montant_net_crds_ars(e, echeance) and not_known(fr.pf.core::option_remboursement_unique(p));
    then retenue_appliquee_ars(p);
}

@source(fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
        fr.pf.core::CSS_L553_2_CSS_ED2026_01, fr.pf.core::CSS_L553_2_CSS_ED2026_04,
        fr.pf.core::CSS_L553_2_CSS_ED2026_06)
rule RetenueMontantArs(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, dette: Money, base: Money, echeance: Money) defeasible {
    effective [@2024-01-01, infinity);
    label fr official "retenue ARS : prélèvement effectif, plafonné à l'échéance et à la dette";
    label en unofficial "ARS deduction: effective levy, capped at the echeance and the debt";
    when retenue_appliquee_ars(p) and dette_recouvrable_ars(p, dette)
        and retenue_effective_ars(p, base) and montant_net_crds_ars(e, echeance);
    then retenue_mensuelle_ars(p, e, retenue_plafonnee(base, echeance, dette));
}

@source(fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
        fr.pf.core::CSS_L553_2_CSS_ED2026_01, fr.pf.core::CSS_L553_2_CSS_ED2026_04,
        fr.pf.core::CSS_L553_2_CSS_ED2026_06)
rule NetVerseArs(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, echeance: Money, retenue: Money) defeasible {
    effective [@2024-01-01, infinity);
    label fr official "ARS nette après retenue";
    label en unofficial "ARS net after deduction";
    when retenue_mensuelle_ars(p, e, retenue) and montant_net_crds_ars(e, echeance);
    then net_verse_ars(p, e, net_apres_retenue(echeance, retenue));
}

@source(fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
        fr.pf.core::CSS_L553_2_CSS_ED2026_01, fr.pf.core::CSS_L553_2_CSS_ED2026_04,
        fr.pf.core::CSS_L553_2_CSS_ED2026_06)
rule NetSansRetenueArs(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, dette: Money, base: Money, echeance: Money) defeasible {
    effective [@2024-01-01, infinity);
    label fr official "recouvrement écarté : l'échéance d'ARS est versée entière";
    label en unofficial "recovery barred: the ARS echeance is paid in full";
    when dette_recouvrable_ars(p, dette) and retenue_effective_ars(p, base)
        and montant_net_crds_ars(e, echeance) and not_known(retenue_appliquee_ars(p));
    then net_verse_ars(p, e, echeance);
}

// --- Y = AJPA (L. 553-2 al. 1 « à défaut », destination stream) --------
//
// AJPA is a DESTINATION head here: PF and RSA indus carried onto
// future AJPA echeances (L. 553-2 al. 1 list via L. 168-8; L. 262-46
// list). AJPA-own recovery stays neighbour-owned (fr.css.ajpa).
// The monthly levy is fund-stated on the AJPA payee key (IDENTITY:
// the PF/RSA debtor key cannot join); fraud status of the carried
// debt is stated on the payee key, the 50 %/x2 uplift itself is
// computed in-section (never a stated fraction).

pub relation pf_indu_reporte_sur_ajpa(p: fr.pf.core::Personne, montant: Money) kind empirical {
    key(p);
    label fr official "indu de prestations familiales imputé sur l'AJPA à échoir, indemnité 10 % incluse en cas de fraude, hors option unique PF (L. 553-2 al. 1 « à défaut »)";
    label en unofficial "family-benefit overpayment charged to future AJPA, 10% indemnity included on fraud, net of PF single option (L. 553-2 para. 1 'à défaut')";
}

pub relation rsa_indu_reporte_sur_ajpa(p: fr.pf.core::Personne, montant: Money) kind empirical {
    key(p);
    label fr official "indu de RSA imputé sur l'AJPA à échoir, indemnité incluse en cas de fraude, hors option unique RSA (L. 262-46 al. 4 « à défaut »)";
    label en unofficial "RSA overpayment charged to future AJPA, indemnity included on fraud, net of RSA single option (L. 262-46 para. 4 'à défaut')";
}

pub relation report_pf_sur_ajpa_licite(p: fr.pf.core::Personne) kind empirical {
    label fr official "report PF→AJPA licite : aucun report imputé, ou report imputé à défaut de recouvrement sur les prestations familiales et sans option unique PF, fait constaté (L. 553-2 al. 1 « à défaut »)";
    label en unofficial "lawful PF→AJPA carry: no carry charged, or carry charged for want of family-benefit recovery with no PF single option, stated fact (L. 553-2 para. 1 'à défaut')";
}

pub relation report_rsa_sur_ajpa_licite(p: fr.pf.core::Personne) kind empirical {
    label fr official "report RSA→AJPA licite : aucun report imputé, ou report imputé à défaut de recouvrement sur le RSA et sans option unique RSA, fait constaté (L. 262-46 al. 4 « à défaut »)";
    label en unofficial "lawful RSA→AJPA carry: no carry charged, or carry charged for want of RSA recovery with no RSA single option, stated fact (L. 262-46 para. 4 'à défaut')";
}

pub relation retenue_mensuelle_ajpa_declaree(p: fr.pf.core::Personne, montant: Money) kind empirical {
    key(p);
    label fr official "montant mensuel du prélèvement sur l'AJPA appliqué par la caisse selon le barème D. 553-1 (phrase de portée L. 553-2 al. 3, échelle DSS non épinglée : DSS_PENDING)";
    label en unofficial "monthly AJPA levy amount applied by the fund under the D. 553-1 scale (L. 553-2 para. 3 scope sentence, DSS scale bytes unpinned: DSS_PENDING)";
}

pub relation reporte_ajpa_frauduleux(p: fr.pf.core::Personne) kind empirical {
    label fr official "la dette reportée sur l'AJPA résulte d'une fraude du débiteur, fait constaté sur la clé allocataire (L. 553-2 al. 3)";
    label en unofficial "the debt carried onto AJPA results from the debtor's fraud, stated fact on the payee key (L. 553-2 para. 3)";
}

pub relation fraude_repetee_5ans_ajpa(p: fr.pf.core::Personne) kind empirical {
    label fr official "réitération de la fraude dans les cinq ans suivant une précédente fraude, fait constaté (L. 553-2 al. 3)";
    label en unofficial "repeat fraud within five years after a previous fraud, stated fact (L. 553-2 para. 3)";
}

pub relation dette_recouvrable_ajpa(p: fr.pf.core::Personne, montant: Money) kind institutional {
    key(p);
    label fr official "dette recouvrable sur l'AJPA (reports PF/RSA, L. 553-2 al. 1, L. 262-46 al. 4)";
    label en unofficial "debt recoverable from AJPA (PF/RSA carries, L. 553-2 para. 1, L. 262-46 para. 4)";
}

pub relation retenue_effective_ajpa(p: fr.pf.core::Personne, montant: Money) kind institutional {
    key(p);
    label fr official "retenue mensuelle effective sur l'AJPA après majoration éventuelle : barème D. 553-1, +50 % fraude, x2 réitération (L. 553-2 al. 3, D. 553-5)";
    label en unofficial "effective monthly AJPA retention after any uplift: D. 553-1 scale, +50% fraud, x2 repeat (L. 553-2 para. 3, D. 553-5)";
}

pub relation retenue_appliquee_ajpa(p: fr.pf.core::Personne) kind institutional {
    label fr official "retenues appliquées sur l'AJPA à échoir (L. 553-2 al. 1 « à défaut »)";
    label en unofficial "deductions applied to future AJPA (L. 553-2 para. 1 'à défaut')";
}

pub relation retenue_mensuelle_ajpa(p: fr.pf.core::Personne, mois: Date, montant: Money) kind institutional {
    key(p, mois);
    label fr official "montant de la retenue mensuelle sur l'AJPA (D. 553-1, L. 553-2 al. 3)";
    label en unofficial "monthly AJPA deduction amount (D. 553-1, L. 553-2 para. 3)";
}

pub relation net_verse_ajpa(p: fr.pf.core::Personne, mois: Date, montant: Money) kind institutional {
    key(p, mois);
    label fr official "AJPA nette versée après retenue éventuelle";
    label en unofficial "AJPA net paid after any deduction";
}

@source(fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
        fr.pf.core::CSS_L553_2_CSS_ED2026_01, fr.pf.core::CSS_L553_2_CSS_ED2026_04,
        fr.pf.core::CSS_L553_2_CSS_ED2026_06,
        fr.casf.rsa::CASF_L262_46, fr.casf.rsa::CASF_L262_46_ED2025_01,
        fr.casf.rsa::CASF_L262_46_ED2025_06, fr.casf.rsa::CASF_L262_46_ED2026_06)
rule DetteAjpaReport(p: fr.pf.core::Personne, pf: Money, rsa: Money) strict {
    effective [@2024-01-01, infinity);
    label fr official "dette AJPA : reports PF et RSA licites (L. 553-2 al. 1 et L. 262-46 al. 4 « à défaut »)";
    label en unofficial "AJPA debt: lawful PF and RSA carries (L. 553-2 para. 1 and L. 262-46 para. 4 'à défaut')";
    when pf_indu_reporte_sur_ajpa(p, pf) and rsa_indu_reporte_sur_ajpa(p, rsa)
        and report_pf_sur_ajpa_licite(p) and report_rsa_sur_ajpa_licite(p);
    then dette_recouvrable_ajpa(p, dette_totale2(pf, rsa));
}

@source(fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
        fr.pf.core::CSS_L553_2_CSS_ED2026_01, fr.pf.core::CSS_L553_2_CSS_ED2026_04,
        fr.pf.core::CSS_L553_2_CSS_ED2026_06)
rule RetenueBaseAjpa(p: fr.pf.core::Personne, base: Money) strict {
    effective [@2024-01-01, infinity);
    label fr official "hors fraude : le prélèvement mensuel déclaré s'applique sans majoration";
    label en unofficial "without fraud: the stated monthly levy applies without uplift";
    when retenue_mensuelle_ajpa_declaree(p, base) and not_known(reporte_ajpa_frauduleux(p));
    then retenue_effective_ajpa(p, base);
}

@source(fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
