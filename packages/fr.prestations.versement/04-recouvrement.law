        fr.casf.rsa::CASF_L262_46_ED2026_06)
rule RetenueAppliqueeAah(p: fr.css.aah::Personne, dette: Money, base: Money, echeance: Money) defeasible {
    effective [@2024-01-01, infinity);
    label fr official "retenues sur l'AAH à échoir";
    label en unofficial "deductions from future AAH";
    when dette_recouvrable_aah(p, dette) and retenue_effective_aah(p, base)
        and fr.css.aah::aah_montant_du(p, echeance);
    then retenue_appliquee_aah(p);
}

@source(fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
