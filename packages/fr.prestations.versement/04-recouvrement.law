rule RetenueReiterationAjpa(p: fr.pf.core::Personne, base: Money) strict {
    effective [@2024-01-01, infinity);
    label fr official "réitération dans les cinq ans : la majoration de 50 % est doublée (x2,00)";
    label en unofficial "repeat within five years: the 50% uplift is doubled (x2.00)";
    when retenue_mensuelle_ajpa_declaree(p, base)
        and reporte_ajpa_frauduleux(p) and fraude_repetee_5ans_ajpa(p);
    then retenue_effective_ajpa(p, retenue_majoree_reiteration(base));
}

@source(fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
        fr.pf.core::CSS_L553_2_CSS_ED2026_01, fr.pf.core::CSS_L553_2_CSS_ED2026_04,
        fr.pf.core::CSS_L553_2_CSS_ED2026_06,
        fr.casf.rsa::CASF_L262_46, fr.casf.rsa::CASF_L262_46_ED2025_01,
        fr.casf.rsa::CASF_L262_46_ED2025_06, fr.casf.rsa::CASF_L262_46_ED2026_06)
rule RetenueAppliqueeAjpa(p: fr.pf.core::Personne, a: fr.pf.core::Personne, dette: Money, base: Money, mois: Date, echeance: Money) defeasible {
    effective [@2024-01-01, infinity);
    label fr official "retenues sur l'AJPA à échoir, reports licites (options sources couvertes par les reports, L. 553-2 al. 1 et L. 262-46 al. 4 « à défaut »)";
    label en unofficial "deductions from future AJPA, lawful carries (source options covered by the carries, L. 553-2 para. 1 and L. 262-46 para. 4 'à défaut')";
    when dette_recouvrable_ajpa(p, dette) and retenue_effective_ajpa(p, base)
        and fr.css.ajpa::ajpa_montant_mois(p, a, mois, echeance);
    then retenue_appliquee_ajpa(p);
}

