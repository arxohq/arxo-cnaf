        fr.pf.core::CSS_D553_5_CSS_ED2025_02, fr.pf.core::CSS_D553_5_CSS_ED2025_09,
        fr.pf.core::CSS_D553_5_CSS_ED2025_12, fr.pf.core::CSS_D553_5_CSS_ED2026_01,
        fr.pf.core::CSS_D553_5_CSS_ED2026_04, fr.pf.core::CSS_D553_5_CSS_ED2026_06)
rule RetenueFraudeAjpa(p: fr.pf.core::Personne, base: Money) defeasible {
    effective [@2024-01-01, infinity);
    label fr official "dette reportée frauduleuse : majoration fixe de 50 % du prélèvement (pouvoir du directeur, L. 553-2 al. 3, D. 553-5)";
    label en unofficial "fraudulent carried debt: fixed 50% uplift of the levy (director's power, L. 553-2 para. 3, D. 553-5)";
    when retenue_mensuelle_ajpa_declaree(p, base)
        and reporte_ajpa_frauduleux(p) and not_known(fraude_repetee_5ans_ajpa(p));
    then retenue_effective_ajpa(p, retenue_majoree_fraude(base));
}

