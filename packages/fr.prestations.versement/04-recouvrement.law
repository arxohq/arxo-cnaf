        fr.pf.core::CSS_L553_2_CSS_ED2026_06)
rule NetSansRetenueCf(p: fr.pf.core::Personne, dette: Money, base: Money, echeance: Money) defeasible {
    effective [@2024-01-01, infinity);
    label fr official "recouvrement écarté : l'échéance de CF est versée entière";
    label en unofficial "recovery barred: the CF echeance is paid in full";
    when dette_recouvrable_cf(p, dette) and retenue_effective_cf(p, base)
        and montant_net_crds_cf(p, echeance) and not_known(retenue_appliquee_cf(p));
    then net_verse_cf(p, echeance);
}

// --- Y = ASF (L. 553-2 al. 1, PF head, echeance per child) -------------
//
// Echeance keyed on the child (02 net); retention and debt keyed on
// the debtor, mirroring the 05 ASF duty (no parent/child link,
// single-head-per-case contract (d)).

pub relation dette_chargee_asf(p: fr.pf.core::Personne, montant: Money) kind empirical {
    key(p);
    label fr official "dette imputée par la caisse sur l'ASF à échoir, indemnité 10 % incluse en cas de fraude, nette de prescription et d'option unique (L. 553-2 al. 1, contrat d'entrée)";
    label en unofficial "debt charged by the fund to future ASF, 10% indemnity included on fraud, net of prescription and single option (L. 553-2 para. 1, input contract)";
}

pub relation dette_recouvrable_asf(p: fr.pf.core::Personne, montant: Money) kind institutional {
    key(p);
    label fr official "dette recouvrable sur l'ASF (L. 553-2 al. 1)";
    label en unofficial "debt recoverable from ASF (L. 553-2 para. 1)";
}

pub relation retenue_effective_asf(p: fr.pf.core::Personne, montant: Money) kind institutional {
    key(p);
    label fr official "retenue mensuelle effective sur l'ASF après majoration éventuelle : prélèvement D. 553-1, +50 % fraude, x2 réitération (L. 553-2 al. 3, D. 553-5)";
    label en unofficial "effective monthly ASF retention after any uplift: D. 553-1 levy, +50% fraud, x2 repeat (L. 553-2 para. 3, D. 553-5)";
}

pub relation retenue_appliquee_asf(p: fr.pf.core::Personne) kind institutional {
    label fr official "retenues appliquées sur l'ASF à échoir (L. 553-2 al. 1)";
    label en unofficial "deductions applied to future ASF (L. 553-2 para. 1)";
}

pub relation retenue_mensuelle_asf(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, montant: Money) kind institutional {
    key(p, e);
    label fr official "montant de la retenue mensuelle sur l'ASF de l'enfant (D. 553-1, L. 553-2 al. 3)";
    label en unofficial "monthly ASF deduction amount for the child (D. 553-1, L. 553-2 para. 3)";
}

pub relation net_verse_asf(p: fr.pf.core::Personne, e: fr.pf.core::Enfant, montant: Money) kind institutional {
    key(p, e);
    label fr official "ASF nette versée après retenue éventuelle";
    label en unofficial "ASF net paid after any deduction";
}

@source(fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
        fr.pf.core::CSS_L553_2_CSS_ED2026_01, fr.pf.core::CSS_L553_2_CSS_ED2026_04,
        fr.pf.core::CSS_L553_2_CSS_ED2026_06)
rule DetteAsfNonFraude(p: fr.pf.core::Personne, montant: Money) strict {
    effective [@2024-01-01, infinity);
    label fr official "dette ASF hors fraude : montant imputé par la caisse";
    label en unofficial "ASF debt without fraud: fund-charged amount";
    when dette_chargee_asf(p, montant) and not_known(fr.pf.core::indu_frauduleux(p));
    then dette_recouvrable_asf(p, montant);
}

@source(fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
