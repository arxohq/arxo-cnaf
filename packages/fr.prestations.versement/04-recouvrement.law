rule RetenueReiterationPa(d: fr.css.prime_activite::Demandeur, base: Money) strict {
    effective [@2024-01-01, infinity);
    label fr official "réitération dans les cinq ans : la majoration de 50 % est doublée (x2,00)";
    label en unofficial "repeat within five years: the 50% uplift is doubled (x2.00)";
    when retenue_trimestrielle_pa_declaree(d, base)
        and fr.css.prime_activite::indu_frauduleux(d) and fraude_repetee_5ans_pa(d);
    then retenue_effective_pa(d, retenue_majoree_reiteration(base));
}

