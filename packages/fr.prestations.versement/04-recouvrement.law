        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
        fr.pf.core::CSS_L553_2_CSS_ED2026_01, fr.pf.core::CSS_L553_2_CSS_ED2026_04,
        fr.pf.core::CSS_L553_2_CSS_ED2026_06,
        fr.casf.rsa::CASF_L262_46, fr.casf.rsa::CASF_L262_46_ED2025_01,
        fr.casf.rsa::CASF_L262_46_ED2025_06, fr.casf.rsa::CASF_L262_46_ED2026_06)
rule RetenueAppliqueePa(d: fr.css.prime_activite::Demandeur, dette: Money, base: Money, echeance: Money) defeasible {
    effective [@2024-01-01, infinity);
    label fr official "retenues sur la prime à échoir, sauf remboursement unique (L. 845-3 al. 3)";
    label en unofficial "deductions from the future bonus, absent single repayment (L. 845-3 para. 3)";
    when dette_recouvrable_pa(d, dette) and retenue_effective_pa(d, base)
        and fr.css.prime_activite::prime_due_trimestre(d, echeance)
        and not_known(fr.css.prime_activite::option_remboursement_unique(d));
    then retenue_appliquee_pa(d);
}

@source(fr.css.prime_activite::CSS_L845_3_ED2024_01_01,
        fr.css.prime_activite::CSS_L845_3_ED2025_01_01,
