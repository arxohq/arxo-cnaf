        fr.css.prime_activite::CSS_L845_3_ED2026_04_01,
        fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
        fr.pf.core::CSS_L553_2_CSS_ED2026_01, fr.pf.core::CSS_L553_2_CSS_ED2026_04,
        fr.pf.core::CSS_L553_2_CSS_ED2026_06,
        fr.casf.rsa::CASF_L262_46, fr.casf.rsa::CASF_L262_46_ED2025_01,
        fr.casf.rsa::CASF_L262_46_ED2025_06, fr.casf.rsa::CASF_L262_46_ED2026_06)
rule NetVersePa(d: fr.css.prime_activite::Demandeur, echeance: Money, retenue: Money) defeasible {
    effective [@2024-01-01, infinity);
    label fr official "prime versée : montant dû servi moins la retenue";
    label en unofficial "bonus paid: served due amount minus the deduction";
    when fr.css.prime_activite::prime_due_trimestre(d, echeance) and retenue_mensuelle_pa(d, retenue);
    then net_verse_pa(d, net_apres_retenue(echeance, retenue));
}

@source(fr.css.prime_activite::CSS_L845_3_ED2024_01_01,
        fr.css.prime_activite::CSS_L845_3_ED2025_01_01,
        fr.css.prime_activite::CSS_L845_3_ED2025_02_28,
        fr.css.prime_activite::CSS_L845_3_ED2025_03_31,
        fr.css.prime_activite::CSS_L845_3_ED2026_04_01,
        fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
        fr.pf.core::CSS_L553_2_CSS_ED2026_01, fr.pf.core::CSS_L553_2_CSS_ED2026_04,
        fr.pf.core::CSS_L553_2_CSS_ED2026_06,
        fr.casf.rsa::CASF_L262_46, fr.casf.rsa::CASF_L262_46_ED2025_01,
        fr.casf.rsa::CASF_L262_46_ED2025_06, fr.casf.rsa::CASF_L262_46_ED2026_06)
rule NetSansRetenuePa(d: fr.css.prime_activite::Demandeur, dette: Money, base: Money, echeance: Money) defeasible {
    effective [@2024-01-01, infinity);
    label fr official "recouvrement écarté : l'échéance de prime est versée entière";
    label en unofficial "recovery barred: the bonus echeance is paid in full";
    when dette_recouvrable_pa(d, dette) and retenue_effective_pa(d, base)
        and fr.css.prime_activite::prime_due_trimestre(d, echeance) and not_known(retenue_appliquee_pa(d));
    then net_verse_pa(d, echeance);
}

// --- Y = CF (complément familial, L. 553-2 al. 1, PF head) ---------------
//
// Same-debtor PF head: the D. 553-1 monthly levy (06) is shared with
// AF; only one head is charged per case (contract (d)). The charged
// amount arrives caller-shaped net of prescription and single option
// (contract (a)); the fraud indemnity joins here when the case charges
// the fraud debt to CF.

pub relation dette_chargee_cf(p: fr.pf.core::Personne, montant: Money) kind empirical {
    key(p);
    label fr official "dette imputée par la caisse sur le CF à échoir, indemnité 10 % incluse en cas de fraude, nette de prescription et d'option unique (L. 553-2 al. 1, contrat d'entrée)";
    label en unofficial "debt charged by the fund to future CF, 10% indemnity included on fraud, net of prescription and single option (L. 553-2 para. 1, input contract)";
}

pub relation dette_recouvrable_cf(p: fr.pf.core::Personne, montant: Money) kind institutional {
    key(p);
    label fr official "dette recouvrable sur le CF (L. 553-2 al. 1)";
    label en unofficial "debt recoverable from CF (L. 553-2 para. 1)";
}

pub relation retenue_effective_cf(p: fr.pf.core::Personne, montant: Money) kind institutional {
    key(p);
    label fr official "retenue mensuelle effective sur le CF après majoration éventuelle : prélèvement D. 553-1, +50 % fraude, x2 réitération (L. 553-2 al. 3, D. 553-5)";
    label en unofficial "effective monthly CF retention after any uplift: D. 553-1 levy, +50% fraud, x2 repeat (L. 553-2 para. 3, D. 553-5)";
}

pub relation retenue_appliquee_cf(p: fr.pf.core::Personne) kind institutional {
    label fr official "retenues appliquées sur le CF à échoir (L. 553-2 al. 1)";
    label en unofficial "deductions applied to future CF (L. 553-2 para. 1)";
}

pub relation retenue_mensuelle_cf(p: fr.pf.core::Personne, montant: Money) kind institutional {
    key(p);
    label fr official "montant de la retenue mensuelle sur le CF (D. 553-1, L. 553-2 al. 3)";
    label en unofficial "monthly CF deduction amount (D. 553-1, L. 553-2 para. 3)";
}

pub relation net_verse_cf(p: fr.pf.core::Personne, montant: Money) kind institutional {
    key(p);
    label fr official "CF net versé après retenue éventuelle";
    label en unofficial "CF net paid after any deduction";
}

@source(fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
        fr.pf.core::CSS_L553_2_CSS_ED2026_01, fr.pf.core::CSS_L553_2_CSS_ED2026_04,
        fr.pf.core::CSS_L553_2_CSS_ED2026_06)
rule DetteCfNonFraude(p: fr.pf.core::Personne, montant: Money) strict {
    effective [@2024-01-01, infinity);
    label fr official "dette CF hors fraude : montant imputé par la caisse";
    label en unofficial "CF debt without fraud: fund-charged amount";
    when dette_chargee_cf(p, montant) and not_known(fr.pf.core::indu_frauduleux(p));
    then dette_recouvrable_cf(p, montant);
}

@source(fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
        fr.pf.core::CSS_L553_2_CSS_ED2025_09, fr.pf.core::CSS_L553_2_CSS_ED2025_12,
        fr.pf.core::CSS_L553_2_CSS_ED2026_01, fr.pf.core::CSS_L553_2_CSS_ED2026_04,
        fr.pf.core::CSS_L553_2_CSS_ED2026_06)
rule DetteCfFraude(p: fr.pf.core::Personne, montant: Money, indemnite: Money) strict {
    effective [@2024-01-01, infinity);
    label fr official "dette CF en cas de fraude : montant imputé + indemnité 10 % (L. 553-2 al. 1)";
    label en unofficial "CF debt on fraud: charged amount + 10% indemnity (L. 553-2 para. 1)";
    when dette_chargee_cf(p, montant)
        and fr.pf.core::indu_frauduleux(p) and fr.pf.core::indemnite_frais_gestion(p, indemnite);
    then dette_recouvrable_cf(p, dette_totale2(montant, indemnite));
}

@source(fr.pf.core::CSS_L553_2, fr.pf.core::CSS_L553_2_CSS_ED2025_02,
