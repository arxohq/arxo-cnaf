// No duty without the right (D1 silent): no CDAPH decision, so no computed
// total and no VerserAeehDue position, although the debtor link is stated.
language "law.core" version "0.2";
package fr.pf.aeeh version "0.1.0";
namespace "urn:fr:corpus:clir:pf-aeeh";

test "urn:query:fr-pf-aeeh-devoir-versement-sans-droit" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "aeeh-devsd-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-aeeh:case:parent-devsd"), entity_ref("urn:fr:pf-aeeh:case:enfant-devsd")) { origin case_input; }
        assert "aeeh-devsd-02": bmaf_retenue(entity_ref("urn:fr:pf-aeeh:case:enfant-devsd"), 400.00 EUR) { origin case_input; }
        assert "aeeh-devsd-03": fr.pf.core::organisme_debiteur_pf(entity_ref("urn:fr:pf-aeeh:org:caisse"), entity_ref("urn:fr:pf-aeeh:case:parent-devsd")) { origin case_input; }
    }
    evaluate positions();
    expect not position(VerserAeehDue, ACTIVE);
    expect evaluation_status == COMPUTED;
}
