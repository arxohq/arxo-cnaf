// R. 541-4 IV al. 3 control chain: the body holds the
// ControlerEffectivite liberty; on an ineffectiveness finding it holds
// SaisirCommission, then VerserAvanceComplement for the ascertained
// category-3 supplement (0.92 x 400.00 = 368.00), and the commission
// holds StatuerUrgence.
language "law.core" version "0.2";
package fr.pf.aeeh version "0.1.0";
namespace "urn:fr:corpus:clir:pf-aeeh";

test "urn:query:fr-pf-aeeh-r541-controle-saisine" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "r541-cs-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-aeeh:case:parent-cs"), entity_ref("urn:fr:pf-aeeh:case:enfant-cs")) { origin case_input; }
        assert "r541-cs-02": decision_cdaph_favorable(entity_ref("urn:fr:pf-aeeh:case:enfant-cs")) { origin adjudicated; }
        assert "r541-cs-03": bmaf_retenue(entity_ref("urn:fr:pf-aeeh:case:enfant-cs"), 400.00 EUR) { origin case_input; }
        assert "r541-cs-04": categorie_attribuee(entity_ref("urn:fr:pf-aeeh:case:enfant-cs"), CATEGORIE_3) { origin adjudicated; }
        assert "r541-cs-05": sans_mpi(entity_ref("urn:fr:pf-aeeh:case:enfant-cs")) { origin case_input; }
        assert "r541-cs-06": fr.pf.core::organisme_debiteur_pf(entity_ref("urn:fr:pf-aeeh:org:caisse"), entity_ref("urn:fr:pf-aeeh:case:parent-cs")) { origin case_input; }
        assert "r541-cs-07": commission_competente(entity_ref("urn:fr:pf-aeeh:commission:cdaph-75"), entity_ref("urn:fr:pf-aeeh:case:enfant-cs")) { origin case_input; }
        assert "r541-cs-08": constat_non_effectif(entity_ref("urn:fr:pf-aeeh:org:caisse"), entity_ref("urn:fr:pf-aeeh:case:enfant-cs")) { origin case_input; }
        assert "r541-cs-09": saisine_commission(entity_ref("urn:fr:pf-aeeh:org:caisse"), entity_ref("urn:fr:pf-aeeh:case:enfant-cs")) { origin case_input; }
    }
    evaluate truth(aeeh_montant_complement(entity_ref("urn:fr:pf-aeeh:case:enfant-cs"), 368.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate positions();
    expect position(ControlerEffectivite, ACTIVE);
    expect position(SaisirCommission, ACTIVE);
    expect position(VerserAvanceComplement, ACTIVE);
    expect position(StatuerUrgence, ACTIVE);
    expect evaluation_status == COMPUTED;
}
