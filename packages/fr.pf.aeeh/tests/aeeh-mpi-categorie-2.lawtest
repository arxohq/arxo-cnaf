// MPI via the work-constraint reason (D. 541-3, para. 1): isolated carer,
// supplement granted on work-constraint grounds, category 2. BMAF 400.00:
// base 128.00, supplement 0.65 x 400.00 = 260.00, MPI 0.13 x 400.00 =
// 52.00, total 440.00.
language "law.core" version "0.2";
package fr.pf.aeeh version "0.1.0";
namespace "urn:fr:corpus:clir:pf-aeeh";

test "urn:query:fr-pf-aeeh-mpi-categorie-2" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "aeeh-mpi2-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-aeeh:case:isole-cat2"), entity_ref("urn:fr:pf-aeeh:case:enfant-mpi2")) { origin case_input; }
        assert "aeeh-mpi2-02": decision_cdaph_favorable(entity_ref("urn:fr:pf-aeeh:case:enfant-mpi2")) { origin adjudicated; }
        assert "aeeh-mpi2-03": bmaf_retenue(entity_ref("urn:fr:pf-aeeh:case:enfant-mpi2"), 400.00 EUR) { origin case_input; }
        assert "aeeh-mpi2-04": categorie_attribuee(entity_ref("urn:fr:pf-aeeh:case:enfant-mpi2"), CATEGORIE_2) { origin adjudicated; }
        assert "aeeh-mpi2-05": personne_isolee(entity_ref("urn:fr:pf-aeeh:case:isole-cat2")) { origin case_input; }
        assert "aeeh-mpi2-06": complement_contrainte_activite(entity_ref("urn:fr:pf-aeeh:case:enfant-mpi2")) { origin adjudicated; }
    }
    evaluate truth(mpi_eligible(entity_ref("urn:fr:pf-aeeh:case:enfant-mpi2")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(aeeh_montant_mpi(entity_ref("urn:fr:pf-aeeh:case:enfant-mpi2"), 52.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(aeeh_montant_total(entity_ref("urn:fr:pf-aeeh:case:enfant-mpi2"), 440.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
