// R. 541-4 I-II, duration bounds under the pre-2026 wording
// (legal_time 2024-03, 2022 edition): an 80 % award with an improvement
// prospect, the team proposal and the derogation regime runs three to
// five years from the attribution date; a 50-80 % award filed before
// 2026-04-01 runs two to five years unconditionally (R. 541-4 II,
// no prospect needed — the prospect facts below are inert there).
// Edition witness: under the pre-2026 wording the 50-80 % exclusive
// due-end does not exist yet.
language "law.core" version "0.2";
package fr.pf.aeeh version "0.1.0";
namespace "urn:fr:corpus:clir:pf-aeeh";

test "urn:query:fr-pf-aeeh-r541-bornes-duree" {
    given {
        context { deadline_policy AEEH_DUREES; decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "r541-bd-01": taux_incapacite_retenu(entity_ref("urn:fr:pf-aeeh:case:enfant-80d"), 80.0) { origin adjudicated; }
        assert "r541-bd-02": date_attribution_aeeh(entity_ref("urn:fr:pf-aeeh:case:enfant-80d"), @2024-03-15) { origin case_input; }
        assert "r541-bd-03": perspective_amelioration(entity_ref("urn:fr:pf-aeeh:case:enfant-80d")) { origin case_input; }
        assert "r541-bd-04": proposition_equipe_pluridisciplinaire(entity_ref("urn:fr:pf-aeeh:case:enfant-80d")) { origin adjudicated; }
        assert "r541-bd-10": attribution_derogation_r5414(entity_ref("urn:fr:pf-aeeh:case:enfant-80d")) { origin adjudicated; }
        assert "r541-bd-05": taux_incapacite_retenu(entity_ref("urn:fr:pf-aeeh:case:enfant-60d"), 60.0) { origin adjudicated; }
        assert "r541-bd-06": date_attribution_aeeh(entity_ref("urn:fr:pf-aeeh:case:enfant-60d"), @2024-03-15) { origin case_input; }
        assert "r541-bd-07": perspective_amelioration(entity_ref("urn:fr:pf-aeeh:case:enfant-60d")) { origin case_input; }
        assert "r541-bd-08": proposition_equipe_pluridisciplinaire(entity_ref("urn:fr:pf-aeeh:case:enfant-60d")) { origin adjudicated; }
        assert "r541-bd-09": ouverture_droit_aah(entity_ref("urn:fr:pf-aeeh:case:enfant-60d"), @2026-06-15) { origin case_input; }
        assert "r541-bd-11": demande_attribution_aeeh_deposee(entity_ref("urn:fr:pf-aeeh:case:enfant-60d"), @2024-02-10) { origin case_input; }
    }
    evaluate truth(bornes_duree_attribution(entity_ref("urn:fr:pf-aeeh:case:enfant-80d"), @2027-03-15, @2029-03-15));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(bornes_duree_attribution(entity_ref("urn:fr:pf-aeeh:case:enfant-60d"), @2026-03-15, @2029-03-15));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(fin_exclusive_droit(entity_ref("urn:fr:pf-aeeh:case:enfant-60d"), @2026-06-01));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
