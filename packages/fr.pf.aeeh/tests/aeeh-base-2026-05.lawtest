// Base allowance without supplement under the current 2026 edition
// (legal_time 2026-05-15, CSS_ED2026_04): proves the L/D rules still
// fire with the added _ED2022_01/_ED2026_04 anchors. BMAF 400.00
// stated (B-PFAEEH-BMAF-EURO): base 0.32 x 400.00 = 128.00, total
// 128.00.
language "law.core" version "0.2";
package fr.pf.aeeh version "0.1.0";
namespace "urn:fr:corpus:clir:pf-aeeh";

test "urn:query:fr-pf-aeeh-base-2026-05" {
    given {
        context { decision_time @2026-05-15T12:00:00Z; knowledge_time @2026-05-15T12:00:00Z; legal_time @2026-05-15; timezone "Europe/Paris"; }
        assert "aeeh-b2605-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-aeeh:case:couple-2026-05"), entity_ref("urn:fr:pf-aeeh:case:enfant-2026-05")) { origin case_input; }
        assert "aeeh-b2605-02": decision_cdaph_favorable(entity_ref("urn:fr:pf-aeeh:case:enfant-2026-05")) { origin adjudicated; }
        assert "aeeh-b2605-03": bmaf_retenue(entity_ref("urn:fr:pf-aeeh:case:enfant-2026-05"), 400.00 EUR) { origin case_input; }
        assert "aeeh-b2605-04": sans_complement(entity_ref("urn:fr:pf-aeeh:case:enfant-2026-05")) { origin case_input; }
        assert "aeeh-b2605-05": sans_mpi(entity_ref("urn:fr:pf-aeeh:case:enfant-2026-05")) { origin case_input; }
    }
    evaluate truth(aeeh_droit_calcule(entity_ref("urn:fr:pf-aeeh:case:enfant-2026-05")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(aeeh_montant_base(entity_ref("urn:fr:pf-aeeh:case:enfant-2026-05"), 128.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(aeeh_montant_total(entity_ref("urn:fr:pf-aeeh:case:enfant-2026-05"), 128.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
