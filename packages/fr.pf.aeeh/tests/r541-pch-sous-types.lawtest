// R. 541-9/10, subtype routing: neighbouring-subtype requests never
// stand in for the typed premises. The carer pursuing a third-element
// request holds DeposerDemandePCH; the fully qualified al. 3 renewal
// (L. 245-1 III 1° beneficiary, handicap/factor evolution) triggers
// ReexaminerComplementPCH; the parallel al. 2 PCH request without the
// non-tierce-expense subtype triggers no ReviserDecisionPCH.
language "law.core" version "0.2";
package fr.pf.aeeh version "0.1.0";
namespace "urn:fr:corpus:clir:pf-aeeh";

test "urn:query:fr-pf-aeeh-r541-pch-sous-types" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "r541-pst-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-aeeh:case:parent-pst"), entity_ref("urn:fr:pf-aeeh:case:enfant-pst")) { origin case_input; }
        assert "r541-pst-02": mdph_competente(entity_ref("urn:fr:pf-aeeh:mdph:mdph-75"), entity_ref("urn:fr:pf-aeeh:case:enfant-pst")) { origin case_input; }
        assert "r541-pst-03": commission_competente(entity_ref("urn:fr:pf-aeeh:commission:cdaph-75"), entity_ref("urn:fr:pf-aeeh:case:enfant-pst")) { origin case_input; }
        assert "r541-pst-04": demande_troisieme_element_pch(entity_ref("urn:fr:pf-aeeh:case:enfant-pst")) { origin case_input; }
        assert "r541-pst-05": beneficiaire_complement(entity_ref("urn:fr:pf-aeeh:case:enfant-pst")) { origin case_input; }
        assert "r541-pst-06": demande_pch_complement(entity_ref("urn:fr:pf-aeeh:case:enfant-pst")) { origin case_input; }
        assert "r541-pst-07": demande_renouvellement_pch(entity_ref("urn:fr:pf-aeeh:case:enfant-pst")) { origin case_input; }
        assert "r541-pst-08": beneficiaire_pch_l2451_iii_1(entity_ref("urn:fr:pf-aeeh:case:enfant-pst")) { origin case_input; }
        assert "r541-pst-09": evolution_handicap_charges(entity_ref("urn:fr:pf-aeeh:case:enfant-pst")) { origin adjudicated; }
    }
    evaluate positions();
    expect position(DeposerDemandePCH, ACTIVE);
    expect position(ReexaminerComplementPCH, ACTIVE);
    expect not position(ReviserDecisionPCH, ACTIVE);
    expect evaluation_status == COMPUTED;
}
