// MPI via the PCH reason (L. 541-4 alternative): isolated carer who also
// receives the CASF L. 245-1 PCH, category 4. BMAF 400.00: base 128.00,
// supplement 1.4257 x 400.00 = 570.28, MPI 0.57 x 400.00 = 228.00,
// total 926.28.
language "law.core" version "0.2";
package fr.pf.aeeh version "0.1.0";
namespace "urn:fr:corpus:clir:pf-aeeh";

test "urn:query:fr-pf-aeeh-mpi-pch" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "aeeh-mpipch-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-aeeh:case:isole-pch"), entity_ref("urn:fr:pf-aeeh:case:enfant-mpipch")) { origin case_input; }
        assert "aeeh-mpipch-02": decision_cdaph_favorable(entity_ref("urn:fr:pf-aeeh:case:enfant-mpipch")) { origin adjudicated; }
        assert "aeeh-mpipch-03": bmaf_retenue(entity_ref("urn:fr:pf-aeeh:case:enfant-mpipch"), 400.00 EUR) { origin case_input; }
        assert "aeeh-mpipch-04": categorie_attribuee(entity_ref("urn:fr:pf-aeeh:case:enfant-mpipch"), CATEGORIE_4) { origin adjudicated; }
        assert "aeeh-mpipch-05": personne_isolee(entity_ref("urn:fr:pf-aeeh:case:isole-pch")) { origin case_input; }
        assert "aeeh-mpipch-06": percoit_pch(entity_ref("urn:fr:pf-aeeh:case:isole-pch")) { origin case_input; }
    }
    evaluate truth(mpi_eligible(entity_ref("urn:fr:pf-aeeh:case:enfant-mpipch")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(aeeh_montant_mpi(entity_ref("urn:fr:pf-aeeh:case:enfant-mpipch"), 228.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(aeeh_montant_total(entity_ref("urn:fr:pf-aeeh:case:enfant-mpipch"), 926.28 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
