// R. 541-9 duty and R. 541-10 revision duties ACTIVE: the carer
// pursuing a third-element request holds DeposerDemandePCH; a supplement
// beneficiary (non-tierce expenses) filing for PCH triggers
// ReviserDecisionPCH, and a PCH renewal request by an L. 245-1 III 1°
// beneficiary on handicap/factor evolution triggers
// ReexaminerComplementPCH. Simultaneous AEEH + third-element PCH
// requests exclude the housing/vehicle/transport charges from the
// supplement. Silent and wrong-subtype pairs live in
// r541-pch-silencieux and r541-pch-sous-types.
language "law.core" version "0.2";
package fr.pf.aeeh version "0.1.0";
namespace "urn:fr:corpus:clir:pf-aeeh";

test "urn:query:fr-pf-aeeh-r541-devoirs-pch" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "r541-dpch-01": fr.pf.core::parent_charge(entity_ref("urn:fr:pf-aeeh:case:parent-dpch"), entity_ref("urn:fr:pf-aeeh:case:enfant-dpch")) { origin case_input; }
        assert "r541-dpch-02": mdph_competente(entity_ref("urn:fr:pf-aeeh:mdph:mdph-75"), entity_ref("urn:fr:pf-aeeh:case:enfant-dpch")) { origin case_input; }
        assert "r541-dpch-03": commission_competente(entity_ref("urn:fr:pf-aeeh:commission:cdaph-75"), entity_ref("urn:fr:pf-aeeh:case:enfant-dpch")) { origin case_input; }
        assert "r541-dpch-04": beneficiaire_complement(entity_ref("urn:fr:pf-aeeh:case:enfant-dpch")) { origin case_input; }
        assert "r541-dpch-05": demande_pch_complement(entity_ref("urn:fr:pf-aeeh:case:enfant-dpch")) { origin case_input; }
        assert "r541-dpch-06": demande_renouvellement_pch(entity_ref("urn:fr:pf-aeeh:case:enfant-dpch")) { origin case_input; }
        assert "r541-dpch-07": demande_simultanee_aeeh_pch(entity_ref("urn:fr:pf-aeeh:case:enfant-dpch")) { origin case_input; }
        assert "r541-dpch-08": demande_troisieme_element_pch(entity_ref("urn:fr:pf-aeeh:case:enfant-dpch")) { origin case_input; }
        assert "r541-dpch-09": complement_depenses_non_tierce(entity_ref("urn:fr:pf-aeeh:case:enfant-dpch")) { origin case_input; }
        assert "r541-dpch-10": beneficiaire_pch_l2451_iii_1(entity_ref("urn:fr:pf-aeeh:case:enfant-dpch")) { origin case_input; }
        assert "r541-dpch-11": evolution_handicap_charges(entity_ref("urn:fr:pf-aeeh:case:enfant-dpch")) { origin adjudicated; }
    }
    evaluate truth(charges_pch_exclues_complement(entity_ref("urn:fr:pf-aeeh:case:enfant-dpch")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate positions();
    expect position(DeposerDemandePCH, ACTIVE);
    expect position(ReviserDecisionPCH, ACTIVE);
    expect position(ReexaminerComplementPCH, ACTIVE);
    expect evaluation_status == COMPUTED;
}
