}

// --- Monthly total: base + supplement + MPI --------------------------------

@source(
    CSS_L541_1_ED2012_01,
    CSS_L541_1_ED2021_01,
    CSS_L541_1_ED2022_01,
    CSS_L541_1_ED2026_04,
    CSS_L541_4_ED2021_01,
    CSS_L541_4_ED2022_01,
    CSS_L541_4_ED2026_04)
rule MontantTotal(e: fr.pf.core::Enfant, base: Money, compl: Money, mpi: Money) strict {
    effective [@2009-06-01, infinity);
    label fr official "total mensuel dû : allocation + complément + MPI";
    label en unofficial "monthly total due: allowance + supplement + MPI";
    when aeeh_montant_base(e, base) and aeeh_montant_complement(e, compl)
        and aeeh_montant_mpi(e, mpi);
    then aeeh_montant_total(e, total_montant(base, compl, mpi));
}

@source(
    CSS_L541_1_ED2012_01,
    CSS_L541_1_ED2021_01,
    CSS_L541_1_ED2022_01,
    CSS_L541_1_ED2026_04,
    CSS_L541_4_ED2021_01,
    CSS_L541_4_ED2022_01,
    CSS_L541_4_ED2026_04)
rule MontantServi(e: fr.pf.core::Enfant, total: Money) strict {
    effective [@2026-04-01, infinity);
    label fr official "montant servi : total arrondi au centime le plus proche (annexe DSS/2B/2026/46)";
    label en unofficial "served amount: total rounded to the nearest centime (DSS/2B/2026/46 annex)";
    when aeeh_montant_total(e, total);
    then aeeh_montant_servi(e, round(total, 2, "HALF_UP"));
}
