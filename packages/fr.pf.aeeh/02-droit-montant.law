// AEEH right and amounts (L. 541-1/2, D. 541-1/2/3/4, L. 541-4/5).
//
// DEONTIC MAP: right-conferring computation rules only. The duty to pay
// the computed total lives in 04-devoir-versement.law; the suspension
// liberty in 03-pouvoir-suspension.law. Two evaluative channels arrive as
// established facts and are never recomputed here:
// - decision_cdaph_favorable (L. 541-2, commission decision: §47.3
//   judgment read as an adjudicated fact, as APL R. 822-13);
// - categorie_attribuee + complement_contrainte_activite (R. 541-2/D. 541-3
//   mechanics, inventory PENDING_WAVE: the resulting category and reason
//   are the established facts, B-PFAEEH-CATEGORIE).
//
// MONEY FORMS. All multiplications are Money x Decimal (bareme fractions
// 0.32, never "32 p. 100", APL convention).
//
// WINDOWS. Entitlement and amount rules open at 2006-01-01 (D. 541-1/2
// debut) so the OpenFisca 2012-01 cases run on the same pinned rates;
// MPI rules open at 2009-06-01 (D. 541-3 debut). The entitlement head is
// one rule for all periods (B-PFAEEH-TETE); the 2021 upstream window is a
// parallel filter, not a premise here.

language "law.core" version "0.2";
package fr.pf.aeeh version "0.1.0";
namespace "urn:fr:corpus:clir:pf-aeeh";

use self::{
    CSS_D541_1,
    CSS_D541_1_ED2009_06,
    CSS_D541_1_ED2012_01,
    CSS_D541_1_ED2021_01,
    CSS_D541_1_ED2022_01,
    CSS_D541_1_ED2026_04,
    CSS_D541_2,
    CSS_D541_2_ED2009_06,
    CSS_D541_2_ED2012_01,
    CSS_D541_2_ED2021_01,
    CSS_D541_2_ED2022_01,
    CSS_D541_2_ED2026_04,
    CSS_D541_3,
    CSS_D541_3_ED2012_01,
    CSS_D541_3_ED2021_01,
    CSS_D541_3_ED2022_01,
    CSS_D541_3_ED2026_04,
    CSS_D541_4,
    CSS_D541_4_ED2009_06,
    CSS_D541_4_ED2012_01,
    CSS_D541_4_ED2021_01,
    CSS_D541_4_ED2022_01,
    CSS_D541_4_ED2026_04,
    CSS_L541_1,
    CSS_L541_1_ED2006_01,
    CSS_L541_1_ED2009_06,
    CSS_L541_1_ED2012_01,
    CSS_L541_1_ED2021_01,
    CSS_L541_1_ED2022_01,
    CSS_L541_1_ED2026_04,
    CSS_L541_2_ED2006_01,
    CSS_L541_2_ED2009_06,
    CSS_L541_2_ED2012_01,
    CSS_L541_2_ED2021_01,
    CSS_L541_2_ED2022_01,
    CSS_L541_2_ED2026_04,
    CSS_L541_4,
    CSS_L541_4_ED2021_01,
    CSS_L541_4_ED2022_01,
    CSS_L541_4_ED2026_04,
    CategorieComplement,
    aeeh_droit_calcule,
    aeeh_montant_base,
    aeeh_montant_complement,
    aeeh_montant_mpi,
    aeeh_montant_servi,
    aeeh_montant_total,
    bmaf_retenue,
    categorie_attribuee,
    complement_contrainte_activite,
    decision_cdaph_favorable,
    montant_mtp_retenu,
    mpi_eligible,
    percoit_pch,
    personne_isolee,
    sans_complement,
    sans_mpi,
};

function base_montant(bmaf: Money) -> Money =
    bmaf * TauxAeehBase;

function complement_montant(taux: Decimal, bmaf: Money) -> Money =
    bmaf * taux;

function total_montant(base: Money, compl: Money, mpi: Money) -> Money =
    base + compl + mpi;

// --- L. 541-1/2: computation-level right --------------------------------
//
// «Toute personne qui assume la charge d'un enfant handicapé a droit» (para. 1)
// «attribués au vu de la décision de la commission» (L. 541-2, para. 1).
// One head for all periods on the package's own established fact
// (B-PFAEEH-TETE): the upstream principle-level filters are package-internal
// (§24) and cannot be read here. The L. 541-1 para. 4 internat exclusion is
// period-scoped («sauf pour les périodes») and needs period facts this
// package has not (B-PFAEEH-INTERNAT): it is not modelled here.

@source(
    CSS_L541_1_ED2006_01,
    CSS_L541_1_ED2009_06,
    CSS_L541_1_ED2012_01,
    CSS_L541_1_ED2021_01,
    CSS_L541_1_ED2022_01,
    CSS_L541_1_ED2026_04,
    CSS_L541_2_ED2006_01,
    CSS_L541_2_ED2009_06,
    CSS_L541_2_ED2012_01,
    CSS_L541_2_ED2021_01,
    CSS_L541_2_ED2022_01,
    CSS_L541_2_ED2026_04)
rule DroitAeeh(e: fr.pf.core::Enfant) strict {
    effective [@2006-01-01, infinity);
    label fr official "droit ouvert au vu de la décision CDAPH (taux décret — hors champ)";
    label en unofficial "right opened by the CDAPH decision (rate by decree - out of scope)";
    when decision_cdaph_favorable(e);
    then aeeh_droit_calcule(e);
}

// --- D. 541-1: base amount, 32 p. 100 of the L. 551-1 base ---------------

@source(
    CSS_L541_1,
    CSS_L541_1_ED2006_01,
    CSS_L541_1_ED2009_06,
    CSS_L541_1_ED2012_01,
    CSS_L541_1_ED2021_01,
    CSS_L541_1_ED2022_01,
    CSS_L541_1_ED2026_04,
    CSS_D541_1,
    CSS_D541_1_ED2009_06,
    CSS_D541_1_ED2012_01,
    CSS_D541_1_ED2021_01,
    CSS_D541_1_ED2022_01,
    CSS_D541_1_ED2026_04)
rule MontantBase(e: fr.pf.core::Enfant, bmaf: Money) strict {
    effective [@2006-01-01, infinity);
    label fr official "allocation proprement dite : 32 p. 100 de la base mensuelle L. 551-1, pour chaque enfant ouvrant droit";
    label en unofficial "base allowance: 32% of the L. 551-1 monthly base, for each entitled child";
    when aeeh_droit_calcule(e) and bmaf_retenue(e, bmaf);
    then aeeh_montant_base(e, base_montant(bmaf));
}

// --- D. 541-2: category supplements 1-5 ----------------------------------

@source(
    CSS_L541_1,
    CSS_L541_1_ED2006_01,
    CSS_L541_1_ED2009_06,
    CSS_L541_1_ED2012_01,
    CSS_L541_1_ED2021_01,
    CSS_L541_1_ED2022_01,
