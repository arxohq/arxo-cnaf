// --- D. 541-2, para. 6: sixth category = MTP amount (L. 341-4, external) --

@source(
    CSS_L541_1,
    CSS_L541_1_ED2006_01,
    CSS_L541_1_ED2009_06,
    CSS_L541_1_ED2012_01,
    CSS_L541_1_ED2021_01,
    CSS_L541_1_ED2022_01,
    CSS_L541_1_ED2026_04,
    CSS_D541_2,
    CSS_D541_2_ED2009_06,
    CSS_D541_2_ED2012_01,
    CSS_D541_2_ED2021_01,
    CSS_D541_2_ED2022_01,
    CSS_D541_2_ED2026_04)
rule ComplementCategorie6(e: fr.pf.core::Enfant, mtp: Money) strict {
    effective [@2006-01-01, infinity);
    label fr official "complément de sixième catégorie : montant MTP retenu (L. 341-4 — hors champ)";
    label en unofficial "sixth-category supplement: retained MTP amount (L. 341-4 - out of scope)";
    when aeeh_droit_calcule(e) and categorie_attribuee(e, CATEGORIE_6)
        and montant_mtp_retenu(e, mtp);
    then aeeh_montant_complement(e, mtp);
}

// --- No supplement: zero carried so the total always closes --------------

@source(
    CSS_L541_1_ED2006_01,
    CSS_L541_1_ED2009_06,
    CSS_L541_1_ED2012_01,
    CSS_L541_1_ED2021_01,
    CSS_L541_1_ED2022_01,
    CSS_L541_1_ED2026_04)
rule ComplementZero(e: fr.pf.core::Enfant) strict {
    effective [@2006-01-01, infinity);
    label fr official "sans complément : zéro porté pour clore le total";
    label en unofficial "no supplement: zero carried to close the total";
    when aeeh_droit_calcule(e) and sans_complement(e);
    then aeeh_montant_complement(e, 0 EUR);
}

// --- L. 541-4 + D. 541-3: isolated-parent supplement (MPI) ----------------
//
// «a droit à une majoration spécifique» for the isolated carer of a child
// whose condition requires a third person, where the commission granted a
// supplement because the condition forces work reduction/cessation or paid
// third-person care (D. 541-3, para. 1), or where the carer also receives
// the PCH (L. 541-4 alternative).

@source(
    CSS_L541_4,
    CSS_L541_4_ED2021_01,
    CSS_L541_4_ED2022_01,
    CSS_L541_4_ED2026_04,
    CSS_D541_3,
    CSS_D541_3_ED2012_01,
    CSS_D541_3_ED2021_01,
    CSS_D541_3_ED2022_01,
    CSS_D541_3_ED2026_04)
rule MpiEligibleComplement(e: fr.pf.core::Enfant, p: fr.pf.core::Personne) strict {
    effective [@2009-06-01, infinity);
    label fr official "MPI : personne isolée, complément accordé pour contrainte d'activité ou tierce personne";
    label en unofficial "MPI: isolated person, supplement granted on work-constraint or third-person grounds";
    when aeeh_droit_calcule(e) and personne_isolee(p)
        and complement_contrainte_activite(e);
    then mpi_eligible(e);
}

@source(
    CSS_L541_4,
    CSS_L541_4_ED2021_01,
    CSS_L541_4_ED2022_01,
    CSS_L541_4_ED2026_04,
    CSS_D541_3,
    CSS_D541_3_ED2012_01,
    CSS_D541_3_ED2021_01,
    CSS_D541_3_ED2022_01,
    CSS_D541_3_ED2026_04)
rule MpiEligiblePch(e: fr.pf.core::Enfant, p: fr.pf.core::Personne) strict {
    effective [@2009-06-01, infinity);
    label fr official "MPI : personne isolée cumulant allocation et PCH L. 245-1 CASF";
    label en unofficial "MPI: isolated person combining the allowance with the L. 245-1 CASF PCH";
    when aeeh_droit_calcule(e) and personne_isolee(p) and percoit_pch(p);
    then mpi_eligible(e);
}

