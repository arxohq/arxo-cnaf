    CSS_D541_2_ED2009_06,
    CSS_D541_2_ED2012_01,
    CSS_D541_2_ED2021_01,
    CSS_D541_2_ED2022_01,
    CSS_D541_2_ED2026_04)
rule ComplementCategorie1(e: fr.pf.core::Enfant, bmaf: Money) strict {
    effective [@2006-01-01, infinity);
    label fr official "complément de première catégorie : 24 % de la base mensuelle AF";
    label en unofficial "first-category supplement: 24% of the AF monthly base";
    when aeeh_droit_calcule(e) and categorie_attribuee(e, CATEGORIE_1)
        and bmaf_retenue(e, bmaf);
    then aeeh_montant_complement(e, complement_montant(TauxComplementCategorie1, bmaf));
}

