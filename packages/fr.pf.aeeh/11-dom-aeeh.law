}

@source(
    CSS_L755_20,
    CSS_L755_20_ED2022_01,
    CSS_L755_20_ED2026_04)
rule AttributionDomReunion(e: fr.pf.core::Enfant) strict {
    effective [@2021-01-01, infinity);
    label fr official "AEEH attribuée à La Réunion : enfant ouvrant droit et résident (L. 755-20)";
    label en unofficial "AEEH awarded in La Réunion: entitled and resident child (L. 755-20)";
    when aeeh_droit_calcule(e) and residence_enfant(e, REUNION);
    then aeeh_attribuee_dom(e);
}

@source(
    CSS_L755_20,
    CSS_L755_20_ED2022_01,
    CSS_L755_20_ED2026_04)
rule AttributionDomSaintBarthelemy(e: fr.pf.core::Enfant) strict {
    effective [@2021-01-01, infinity);
    label fr official "AEEH attribuée à Saint-Barthélemy : enfant ouvrant droit et résident (L. 755-20)";
    label en unofficial "AEEH awarded in Saint-Barthélemy: entitled and resident child (L. 755-20)";
    when aeeh_droit_calcule(e) and residence_enfant(e, SAINT_BARTHELEMY);
