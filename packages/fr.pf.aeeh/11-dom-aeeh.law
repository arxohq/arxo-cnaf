    CSS_L755_20,
    CSS_L755_20_ED2022_01,
    CSS_L755_20_ED2026_04)
rule AttributionDomSaintMartin(e: fr.pf.core::Enfant) strict {
    effective [@2021-01-01, infinity);
    label fr official "AEEH attribuée à Saint-Martin : enfant ouvrant droit et résident (L. 755-20)";
    label en unofficial "AEEH awarded in Saint-Martin: entitled and resident child (L. 755-20)";
    when aeeh_droit_calcule(e) and residence_enfant(e, SAINT_MARTIN);
    then aeeh_attribuee_dom(e);
