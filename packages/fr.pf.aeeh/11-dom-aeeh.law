// --- D. 755-11: DOM amount built from the metropolitan total --------------
// «Le montant ... est identique à celui qui est applicable en métropole»:
// the built DOM amount is the computed metropolitan total (allowance +
// supplements + MPI carried as zeros where absent).

@source(
    CSS_D755_11_ED2021_01,
    CSS_D755_11_ED2022_01,
    CSS_D755_11_ED2026_04)
rule MontantDomConstruit(e: fr.pf.core::Enfant, total: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "montant DOM identique au total métropole calculé (D. 755-11, construction)";
    label en unofficial "DOM amount identical to the computed metropolitan total (D. 755-11, build)";
    when aeeh_attribuee_dom(e) and aeeh_montant_total(e, total);
    then montant_aeeh_dom(e, total);
}

// --- D. 755-11: presented DOM amount checked against the built value ------

@source(
    CSS_D755_11_ED2021_01,
    CSS_D755_11_ED2022_01,
    CSS_D755_11_ED2026_04)
rule MontantDomVerifie(e: fr.pf.core::Enfant, construit: Money, presente: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "montant DOM présenté égal au montant construit (D. 755-11, contrôle)";
    label en unofficial "presented DOM amount equal to the built amount (D. 755-11, check)";
    when montant_aeeh_dom(e, construit) and montant_aeeh_dom_presente(e, presente) and presente == construit;
    then montant_aeeh_dom_verifie(e, presente);
}
