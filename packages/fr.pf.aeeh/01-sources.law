@id("urn:fr:corpus:clir:pf-aeeh#CSS_D755_11")
pub fragment CSS_D755_11 in CSS_ED2006_01 {
    kind article;
    locator "article/D755-11";
    text fr official """Article D755-11
Le montant de l'allocation d'éducation de l'enfant handicapé, de ses compléments et de sa majoration éventuels est identique à celui qui est applicable en métropole.
""";
    content_hash "sha256:f34515a1cd313e7302a7e0463543acfb31c455625856ebf3057524a8a84087df";
}

