@id("urn:fr:corpus:clir:pf-aeeh#CSS_L541_5")
pub fragment CSS_L541_5 in CSS_ED2021_01 {
    kind article;
    locator "article/L541-5";
    text fr official """Article L541-5
L'allocation et son complément éventuel mentionnés à l'article L. 541-1 sont servis et contrôlés par les organismes débiteurs des prestations familiales pour le compte de la Caisse nationale de solidarité pour l'autonomie, contre remboursement.
NOTA: Conformément au V de l'article 32 de la loi n° 2020-1576 du 14 décembre 2020, les présentes dispositions entrent en vigueur le 1er janvier 2021.
""";
    content_hash "sha256:584a0c2be85635ab16a9af58ebdc03fab52d6b34b95d7bb52caf596c0797b914";
}

@id("urn:fr:corpus:clir:pf-aeeh#CSS_L541_5_ED2022_01")
