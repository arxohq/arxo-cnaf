@id("urn:fr:corpus:clir:pf-aeeh#CSS_R541_6")
pub fragment CSS_R541_6 in CSS_ED2006_01 {
    kind article;
    locator "article/R541-6";
    text fr official """Article R541-6
Le silence gardé par la commission pendant plus de quatre mois à compter du dépôt de la demande d'allocation d'éducation de l'enfant handicapé vaut décision de rejet de celle-ci.
""";
    content_hash "sha256:259934b01b9f10ae3779cfa315036f2a2ef84f44e1697fdf6c7dad173ef68f9d";
}

