// --- R. 541-2, 4° d): expenses ------------------------------------------------

@source(
    CSS_R541_2_ED2021_01,
    CSS_R541_2_ED2022_01,
    CSS_R541_2_ED2026_04)
rule CritereCategorie4dDepenses(e: fr.pf.core::Enfant, d: Money, s: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "4e catégorie d) : dépenses égales ou supérieures au montant fixé par arrêté (R. 541-2, 4° d))";
    label en unofficial "4th category (d): expenses at or above the arretes-set amount (R. 541-2, 4(d))";
    when depenses_supplementaires(e, d) and seuil_depenses_retenu(CATEGORIE_4, s)
        and d >= s;
    then categorie4d_criteres_remplis(e);
}

// --- R. 541-2, 5°: no activity/full-time plus expenses ------------------------

@source(
    CSS_R541_2_ED2021_01,
    CSS_R541_2_ED2022_01,
    CSS_R541_2_ED2026_04)
rule CritereCategorie5CessationDepenses(e: fr.pf.core::Enfant, d: Money, s: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "5e catégorie : aucune activité et dépenses au montant d'arrêté (R. 541-2, 5°)";
    label en unofficial "5th category: no activity plus expenses at the arretes amount (R. 541-2, 5)";
    when cessation_activite_totale(e)
        and depenses_supplementaires(e, d) and seuil_depenses_retenu(CATEGORIE_5, s)
        and d >= s;
    then categorie5_criteres_remplis(e);
}

@source(
    CSS_R541_2_ED2021_01,
    CSS_R541_2_ED2022_01,
    CSS_R541_2_ED2026_04)
rule CritereCategorie5TierceDepenses(e: fr.pf.core::Enfant, d: Money, s: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "5e catégorie : tierce personne à temps plein et dépenses au montant d'arrêté (R. 541-2, 5°)";
    label en unofficial "5th category: full-time third person plus expenses at the arretes amount (R. 541-2, 5)";
    when tierce_temps_plein(e)
        and depenses_supplementaires(e, d) and seuil_depenses_retenu(CATEGORIE_5, s)
        and d >= s;
    then categorie5_criteres_remplis(e);
}

// --- R. 541-2, 6°: no activity/full-time plus permanent constraints -----------

@source(
    CSS_R541_2_ED2021_01,
    CSS_R541_2_ED2022_01,
    CSS_R541_2_ED2026_04)
rule CritereCategorie6CessationContraintes(e: fr.pf.core::Enfant) strict {
    effective [@2021-01-01, infinity);
    label fr official "6e catégorie : aucune activité et contraintes permanentes de surveillance et de soins (R. 541-2, 6°)";
    label en unofficial "6th category: no activity plus permanent supervision and care constraints (R. 541-2, 6)";
    when cessation_activite_totale(e) and contraintes_permanentes(e);
    then categorie6_criteres_remplis(e);
}

@source(
    CSS_R541_2_ED2021_01,
    CSS_R541_2_ED2022_01,
    CSS_R541_2_ED2026_04)
rule CritereCategorie6TierceContraintes(e: fr.pf.core::Enfant) strict {
    effective [@2021-01-01, infinity);
    label fr official "6e catégorie : tierce personne à temps plein et contraintes permanentes de surveillance et de soins (R. 541-2, 6°)";
    label en unofficial "6th category: full-time third person plus permanent supervision and care constraints (R. 541-2, 6)";
    when tierce_temps_plein(e) and contraintes_permanentes(e);
    then categorie6_criteres_remplis(e);
}
