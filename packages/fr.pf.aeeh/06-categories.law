@source(
    CSS_R541_2_ED2021_01,
    CSS_R541_2_ED2022_01,
    CSS_R541_2_ED2026_04)
rule CritereCategorie4cReductionDepenses(e: fr.pf.core::Enfant, r: Decimal, d: Money, s: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "4e catégorie c) : réduction d'au moins 20 % et dépenses au montant d'arrêté (R. 541-2, 4° c))";
    label en unofficial "4th category (c): reduction of at least 20% plus expenses at the arretes amount (R. 541-2, 4(c))";
    when taux_reduction_activite(e, r) and r >= SeuilReduction20
        and depenses_supplementaires(e, d) and seuil_depenses_retenu(CATEGORIE_4, s)
        and d >= s;
    then categorie4c_criteres_remplis(e);
}

@source(
    CSS_R541_2_ED2021_01,
    CSS_R541_2_ED2022_01,
    CSS_R541_2_ED2026_04)
rule CritereCategorie4cTierceDepenses(e: fr.pf.core::Enfant, h: Decimal, d: Money, s: Money) strict {
    effective [@2021-01-01, infinity);
    label fr official "4e catégorie c) : tierce personne au moins huit heures et dépenses au montant d'arrêté (R. 541-2, 4° c))";
    label en unofficial "4th category (c): third person at least eight hours plus expenses at the arretes amount (R. 541-2, 4(c))";
    when heures_tierce_remuneree(e, h) and h >= SeuilTierce8h
        and depenses_supplementaires(e, d) and seuil_depenses_retenu(CATEGORIE_4, s)
        and d >= s;
    then categorie4c_criteres_remplis(e);
