// --- DOM transfer (11-dom-aeeh: L. 755-20, D. 755-11) -----------------------

pub enum Territoire {
    label fr official "territoire de résidence pour les règles DOM AEEH : six collectivités L. 751-1 en vigueur sur la fenêtre, plus METROPOLE/AUTRE pour les tests d'exclusion (L. 755-20)";
    label en unofficial "residence territory for the AEEH DOM rules: six L. 751-1 collectivities in force over the window, plus METROPOLE/AUTRE for exclusion tests (L. 755-20)";
    GUADELOUPE,
    GUYANE,
    MARTINIQUE,
    REUNION,
    SAINT_BARTHELEMY,
    SAINT_MARTIN,
    METROPOLE,
    AUTRE
}

pub relation residence_enfant(e: fr.pf.core::Enfant, t: Territoire) kind empirical {
    key(e);
    label fr official "l'enfant réside sur le territoire t (L. 755-20 — fait du dossier)";
    label en unofficial "the child resides in territory t (L. 755-20 - case fact)";
}

