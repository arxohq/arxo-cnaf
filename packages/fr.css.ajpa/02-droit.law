// AJPA right (L. 168-8).
//
// The allowance is paid to persons on carer leave (L. 3142-16 travail,
// out of scope) within L. 168-9..16, subject to lawful stay and stable
// residence (L. 512-1, L. 512-2 paras. 1-2, established fact). The 2019
// extended channel (L. 544-8 persons, public agents) predates coverage:
// boundary B-PFAJPA-AVANT2021, not modelled.

language "law.core" version "0.2";
package fr.css.ajpa version "0.1.0";
namespace "urn:fr:corpus:clir:css-ajpa";

use self::{
    CSS_L168_8,
    CSS_L168_8_ED2021_01,
    CSS_L168_8_ED2022_01,
    CSS_L168_8_ED2023_07,
    CSS_L168_8_ED2025_01,
    CSS_L168_8_ED2025_12,
    ajpa_droit_ouvert,
    conge_proche_aidant,
    residence_stable_france,
};

// --- L. 168-8: leave + residence open the right --------------------------

@source(
    CSS_L168_8,
    CSS_L168_8_ED2021_01,
    CSS_L168_8_ED2022_01,
    CSS_L168_8_ED2023_07,
    CSS_L168_8_ED2025_01,
    CSS_L168_8_ED2025_12)
rule DroitAjpaOuvert(p: fr.pf.core::Personne, a: fr.pf.core::Personne) strict {
    effective [@2021-01-01, infinity);
    label fr official "droit ouvert : congé de proche aidant et résidence stable en France";
    label en unofficial "right opened: carer leave and stable residence in France";
    when conge_proche_aidant(p, a) and residence_stable_france(p);
    then ajpa_droit_ouvert(p, a);
}
