@id("urn:fr:corpus:clir:css-ajpa#CSS_L168_11")
pub fragment CSS_L168_11 in CSS_ED2021_01 {
    kind article;
    locator "article/L168-11";
    text fr official """Article L168-11
L'allocation journalière du proche aidant est servie et contrôlée par les organismes débiteurs des prestations familiales pour le compte de la Caisse nationale de solidarité pour l'autonomie contre remboursement, y compris des frais de gestion engagés par ces organismes.
NOTA: Conformément au V de l'article 32 de la loi n° 2020-1576 du 14 décembre 2020, les présentes dispositions entrent en vigueur le 1er janvier 2021.
""";
    content_hash "sha256:83b4f2f4db6d461915b133afbe59d48fd7482c80065b4f80eab23c33e028e25e";
}

