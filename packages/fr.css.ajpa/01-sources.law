@id("urn:fr:corpus:clir:css-ajpa#CSS_L168_12")
pub fragment CSS_L168_12 in CSS_ED2019_12 {
    kind article;
    locator "article/L168-12";
    text fr official """Article L168-12
L'action en paiement de l'allocation mentionnée à l'article L. 168-8 par le bénéficiaire et l'action en recouvrement par l'organisme en cas de versement indu se prescrivent dans les délais prévus à l'article L. 553-1.
""";
    content_hash "sha256:230cf714fa9e344627ecced24a9c96f2999a4e53421495b9a3537703e5e86457";
}

