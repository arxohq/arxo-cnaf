// Subsidiary withholding effected (P2): full grounds — recorded
// non-recoverability, both block-1 reserves and the separately recorded
// single-payment non-option — plus the body's withholding act —
// ajpa_retenue_l5532 is TRUE_ONLY.
language "law.core" version "0.2";
package fr.css.ajpa version "0.1.0";
namespace "urn:fr:corpus:clir:css-ajpa";

test "urn:query:fr-css-ajpa-pouvoir-retenue-l5532-effet" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "ajpa-ple-01": indu_ajpa(entity_ref("urn:fr:css:ajpa:case:aidant-ple"), 300.00 EUR) { origin adjudicated; }
        assert "ajpa-ple-02": indu_notifie_non_recuperable(entity_ref("urn:fr:css:ajpa:case:aidant-ple"), 300.00 EUR) { origin adjudicated; }
        assert "ajpa-ple-03": indu_non_conteste(entity_ref("urn:fr:css:ajpa:case:aidant-ple"), 300.00 EUR) { origin adjudicated; }
        assert "ajpa-ple-04": indu_sans_option_remboursement(entity_ref("urn:fr:css:ajpa:case:aidant-ple"), 300.00 EUR) { origin adjudicated; }
        assert "ajpa-ple-05": indu_sans_option_versement_unique(entity_ref("urn:fr:css:ajpa:case:aidant-ple"), 300.00 EUR) { origin adjudicated; }
        assert "ajpa-ple-06": fr.pf.core::organisme_debiteur_pf(entity_ref("urn:fr:css:ajpa:org:caisse"), entity_ref("urn:fr:css:ajpa:case:aidant-ple")) { origin case_input; }
        assert "ajpa-ple-07": retenue_l5532_exercee(entity_ref("urn:fr:css:ajpa:org:caisse"), entity_ref("urn:fr:css:ajpa:case:aidant-ple"), 300.00 EUR) { origin case_input; }
    }
    evaluate truth(ajpa_retenue_l5532(entity_ref("urn:fr:css:ajpa:case:aidant-ple"), 300.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
