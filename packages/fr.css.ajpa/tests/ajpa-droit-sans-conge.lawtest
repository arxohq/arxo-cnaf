// No leave, no right: residence established but no carer leave
// recorded — the head stays silent.
language "law.core" version "0.2";
package fr.css.ajpa version "0.1.0";
namespace "urn:fr:corpus:clir:css-ajpa";

test "urn:query:fr-css-ajpa-droit-sans-conge" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "ajpa-dsc-01": residence_stable_france(entity_ref("urn:fr:css:ajpa:case:aidant-dsc")) { origin adjudicated; }
    }
    evaluate truth(ajpa_droit_ouvert(entity_ref("urn:fr:css:ajpa:case:aidant-dsc"), entity_ref("urn:fr:css:ajpa:case:aide-dsc")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
