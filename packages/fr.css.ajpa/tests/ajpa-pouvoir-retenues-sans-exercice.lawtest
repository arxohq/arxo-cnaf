// Power waits for its exercise (P1): full grounds with upcoming
// housing-aid instalments as the recorded target but no withholding
// act recorded — ajpa_retenue_prestations is NEITHER.
language "law.core" version "0.2";
package fr.css.ajpa version "0.1.0";
namespace "urn:fr:corpus:clir:css-ajpa";

test "urn:query:fr-css-ajpa-pouvoir-retenues-sans-exercice" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "ajpa-prx-01": indu_ajpa(entity_ref("urn:fr:css:ajpa:case:aidant-prx"), 300.00 EUR) { origin adjudicated; }
        assert "ajpa-prx-02": indu_non_recupere_allocations(entity_ref("urn:fr:css:ajpa:case:aidant-prx"), 300.00 EUR) { origin adjudicated; }
        assert "ajpa-prx-03": indu_non_conteste(entity_ref("urn:fr:css:ajpa:case:aidant-prx"), 300.00 EUR) { origin adjudicated; }
        assert "ajpa-prx-04": indu_sans_option_remboursement(entity_ref("urn:fr:css:ajpa:case:aidant-prx"), 300.00 EUR) { origin adjudicated; }
        assert "ajpa-prx-05": retenue_cible_prestations(entity_ref("urn:fr:css:ajpa:case:aidant-prx"), 300.00 EUR, AIDES_LOGEMENT) { origin case_input; }
        assert "ajpa-prx-06": fr.pf.core::organisme_debiteur_pf(entity_ref("urn:fr:css:ajpa:org:caisse"), entity_ref("urn:fr:css:ajpa:case:aidant-prx")) { origin case_input; }
    }
    evaluate truth(ajpa_retenue_prestations(entity_ref("urn:fr:css:ajpa:case:aidant-prx"), 300.00 EUR, AIDES_LOGEMENT));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
