// Modulated rate for split leave: 10 days at the retained modulated
// rate 40.00 in March 2024 = 400.00.
language "law.core" version "0.2";
package fr.css.ajpa version "0.1.0";
namespace "urn:fr:corpus:clir:css-ajpa";

test "urn:query:fr-css-ajpa-montant-module" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "ajpa-mo-01": conge_proche_aidant(entity_ref("urn:fr:css:ajpa:case:aidant-mo"), entity_ref("urn:fr:css:ajpa:case:aide-mo")) { origin case_input; }
        assert "ajpa-mo-02": residence_stable_france(entity_ref("urn:fr:css:ajpa:case:aidant-mo")) { origin adjudicated; }
        assert "ajpa-mo-03": jours_ajpa_mois(entity_ref("urn:fr:css:ajpa:case:aidant-mo"), entity_ref("urn:fr:css:ajpa:case:aide-mo"), @2024-03-01, 10) { origin case_input; }
        assert "ajpa-mo-04": montant_journalier_module_retenu(entity_ref("urn:fr:css:ajpa:case:aidant-mo"), 40.00 EUR) { origin case_input; }
    }
    evaluate truth(ajpa_montant_mois(entity_ref("urn:fr:css:ajpa:case:aidant-mo"), entity_ref("urn:fr:css:ajpa:case:aide-mo"), @2024-03-01, 400.00 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
