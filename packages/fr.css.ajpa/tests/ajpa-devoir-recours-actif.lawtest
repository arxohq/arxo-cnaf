// Active recourse-information duty (D3): right open with the
// debtor-body link — InformerRecoursAjpa is ACTIVE.
language "law.core" version "0.2";
package fr.css.ajpa version "0.1.0";
namespace "urn:fr:corpus:clir:css-ajpa";

test "urn:query:fr-css-ajpa-devoir-recours-actif" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "ajpa-di-01": conge_proche_aidant(entity_ref("urn:fr:css:ajpa:case:aidant-di"), entity_ref("urn:fr:css:ajpa:case:aide-di")) { origin case_input; }
        assert "ajpa-di-02": residence_stable_france(entity_ref("urn:fr:css:ajpa:case:aidant-di")) { origin adjudicated; }
        assert "ajpa-di-03": fr.pf.core::organisme_debiteur_pf(entity_ref("urn:fr:css:ajpa:org:caisse"), entity_ref("urn:fr:css:ajpa:case:aidant-di")) { origin case_input; }
    }
    evaluate positions();
    expect position(InformerRecoursAjpa, ACTIVE);
    expect evaluation_status == COMPUTED;
}
