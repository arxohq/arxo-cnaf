// Duty silent without the debtor link (D3): right open but no
// debtor body established — no InformerRecoursAjpa position.
language "law.core" version "0.2";
package fr.css.ajpa version "0.1.0";
namespace "urn:fr:corpus:clir:css-ajpa";

test "urn:query:fr-css-ajpa-devoir-recours-sans-debiteur" {
    given {
        context { decision_time @2024-03-15T12:00:00Z; knowledge_time @2024-03-15T12:00:00Z; legal_time @2024-03-15; timezone "Europe/Paris"; }
        assert "ajpa-ds-01": conge_proche_aidant(entity_ref("urn:fr:css:ajpa:case:aidant-ds"), entity_ref("urn:fr:css:ajpa:case:aide-ds")) { origin case_input; }
        assert "ajpa-ds-02": residence_stable_france(entity_ref("urn:fr:css:ajpa:case:aidant-ds")) { origin adjudicated; }
    }
    evaluate positions();
    expect not position(InformerRecoursAjpa, ACTIVE);
    expect evaluation_status == COMPUTED;
}
