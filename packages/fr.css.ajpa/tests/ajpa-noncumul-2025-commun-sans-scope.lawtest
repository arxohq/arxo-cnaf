// D-36 (ajpa-blind-19): job-seeker indemnities (item 4) are in both wordings:
// a 2026 case outside the NOTA scope is still refused cumulation.
language "law.core" version "0.2";
package fr.css.ajpa version "0.1.0";
namespace "urn:fr:corpus:clir:css-ajpa";

test "urn:query:fr-css-ajpa-noncumul-2025-commun-sans-scope" {
    given {
        context { decision_time @2026-03-15T12:00:00Z; knowledge_time @2026-03-15T12:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; }
        assert "ajpa-ns-01": motif_non_cumul_2025(entity_ref("urn:fr:css:ajpa:case:aidant-ns"), CHOMAGE) { origin case_input; }
    }
    evaluate truth(ajpa_cumul_refuse(entity_ref("urn:fr:css:ajpa:case:aidant-ns")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
