{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "arxo.cnaf-canon/0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "asOf": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "semanticsRevision": {
      "type": "string",
      "minLength": 1
    },
    "expectedRootCount": {
      "type": "integer",
      "minimum": 1
    },
    "publications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "namespace": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "root",
              "dependency",
              "excluded"
            ]
          },
          "runtimeKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "packagePath": {
            "type": "string",
            "minLength": 1
          },
          "hashes": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sourceHash": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "contentHash": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "artifactHash": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "semanticHash": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "languageSemantics": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "sourceHash",
              "contentHash",
              "artifactHash",
              "semanticHash",
              "languageSemantics"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "version",
          "namespace",
          "role",
          "hashes"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "role": {
                  "enum": [
                    "root",
                    "dependency"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "runtimeKey",
                "packagePath"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "role": {
                  "const": "excluded"
                }
              }
            },
            "then": {
              "required": [
                "reason"
              ]
            }
          }
        ]
      }
    },
    "fullCorpus": {
      "const": "not_checked"
    },
    "releaseVerified": {
      "const": false
    }
  },
  "required": [
    "format",
    "id",
    "version",
    "sourceCommit",
    "asOf",
    "semanticsRevision",
    "expectedRootCount",
    "publications",
    "fullCorpus",
    "releaseVerified"
  ]
}
