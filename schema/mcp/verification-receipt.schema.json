{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "arxo.mcp-verification-receipt/0.1"
    },
    "treeSha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "files": {
      "type": "integer",
      "minimum": 0
    },
    "result": {
      "const": "pass"
    },
    "fullCorpus": {
      "const": "not_checked"
    },
    "releaseVerified": {
      "const": false
    }
  },
  "required": [
    "format",
    "treeSha256",
    "files",
    "result",
    "fullCorpus",
    "releaseVerified"
  ]
}
