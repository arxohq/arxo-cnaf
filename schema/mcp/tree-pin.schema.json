{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "arxo.mcp-tree-pin/0.1"
    },
    "algorithm": {
      "const": "sha256-canonical-inventory-v1"
    },
    "treeSha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "entries": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "directory"
              },
              "mode": {
                "const": "0755"
              }
            },
            "required": [
              "path",
              "type",
              "mode"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "file"
              },
              "mode": {
                "enum": [
                  "0644",
                  "0755"
                ]
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "type",
              "mode",
              "size",
              "sha256"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "format",
    "algorithm",
    "treeSha256",
    "entries"
  ]
}
