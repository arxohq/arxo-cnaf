{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "arxo.mcp-bundle-receipt/0.1"
    },
    "treeSha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "archiveSha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "fullCorpus": {
      "const": "not_checked"
    },
    "releaseVerified": {
      "const": false
    }
  },
  "required": [
    "format",
    "treeSha256",
    "archiveSha256",
    "fullCorpus",
    "releaseVerified"
  ]
}
